{"type":"tool_call","subtype":"completed","call_id":"tool_8741fdb3-46a4-4752-8012-7bd7947206f","tool_call":{"shellToolCall":{"args":{"command":"cd /Users/user/work/delegate-fixtures && git show origin/main:src/backends/cursor.rs | tail -80","workingDirectory":"","timeout":30000,"toolCallId":"tool_8741fdb3-46a4-4752-8012-7bd7947206f","simpleCommands":["cd","git","tail"],"hasInputRedirect":false,"hasOutputRedirect":false,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"cd","args":[{"type":"word","value":"/Users/user/work/delegate-fixtures"}],"fullText":"cd /Users/user/work/delegate-fixtures"},{"name":"git","args":[{"type":"word","value":"show"},{"type":"word","value":"origin/main:src/backends/cursor.rs"}],"fullText":"git show origin/main:src/backends/cursor.rs"},{"name":"tail","args":[{"type":"number","value":"-80"}],"fullText":"tail -80"}],"hasRedirects":false,"hasCommandSubstitution":false,"redirects":[]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"Cursor backend unit tests on origin/main","closeStdin":true,"conversationId":"7dd612d0-6469-4d8d-870b-f50c14f3831a","adminCommandDenylist":[],"requestId":"13e7813c-8061-40d0-a475-19ebe85b4952"},"result":{"success":{"command":"cd /Users/user/work/delegate-fixtures && git show origin/main:src/backends/cursor.rs | tail -80","workingDirectory":"","exitCode":0,"signal":"","stdout":"    }\n    if parsed.changed {\n        on(Event::Progress(ProgressSnapshotRaw {\n            last_tool: state.last_tool.clone(),\n            tokens_so_far: state.tokens_so_far,\n            last_assistant: state.last_assistant.clone(),\n            files_touched: state.files_touched.clone(),\n            phase: state.phase.clone(),\n        }));\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::sync::Mutex;\n\n    #[test]\n    fn parses_ndjson_emits_progress_resolves_result() {\n        // A tool call line (with newline), then the terminal result WITHOUT a trailing newline.\n        let stdout = concat!(\n            r#\"{\"type\":\"tool_call\",\"subtype\":\"started\",\"tool_call\":{\"shellToolCall\":{}}}\"#,\n            \"\\n\",\n            r#\"{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"all good\",\"session_id\":\"sid\",\"usage\":{\"outputTokens\":7}}\"#,\n        );\n        let progress = Mutex::new(Vec::new());\n        let on = |e: Event| {\n            if let Event::Progress(p) = e {\n                progress.lock().unwrap().push(p);\n            }\n        };\n        let res = drive_streams(stdout.as_bytes(), &b\"\"[..], &on, || true);\n        assert!(res.clean_exit);\n        assert_eq!(res.raw.result.as_deref(), Some(\"all good\"));\n        assert_eq!(res.raw.session_id.as_deref(), Some(\"sid\"));\n        let progress = progress.into_inner().unwrap();\n        assert!(!progress.is_empty());\n        assert_eq!(progress[0].last_tool.as_deref(), Some(\"shell\"));\n    }\n\n    #[test]\n    fn non_zero_exit_is_unclean_and_stderr_is_captured() {\n        let res = drive_streams(&b\"\"[..], &b\"trouble\"[..], &|_| {}, || false);\n        assert!(!res.clean_exit);\n        assert_eq!(res.stderr, \"trouble\");\n    }\n\n    #[test]\n    fn stderr_keeps_only_a_bounded_tail() {\n        let big = vec![b'x'; STDERR_KEEP * 2 + 5];\n        let res = drive_streams(&b\"\"[..], &big[..], &|_| {}, || true);\n        assert_eq!(res.stderr.len(), STDERR_KEEP);\n    }\n\n    #[test]\n    fn spawn_failure_is_an_error_result() {\n        let spec =\n            crate::job_registry::tests::spec_of(|s| s.bin = \"/nonexistent/cursor-agent\".into());\n        let spawned = CursorAdapter.run(&spec);\n        (spawned.kill)();\n        let res = (spawned.drive)(&|_| {});\n        assert!(!res.clean_exit);\n        assert_eq!(res.raw.is_error, Some(true));\n    }\n\n    #[test]\n    fn real_child_runs_and_sigterm_kills_it() {\n        let spec = crate::job_registry::tests::spec_of(|s| {\n            s.bin = \"/bin/sh\".into();\n            s.argv = vec![\"-c\".into(), \"exec sleep 30\".into()];\n        });\n        let spawned = CursorAdapter.run(&spec);\n        let kill = spawned.kill;\n        let t = std::thread::spawn(move || (spawned.drive)(&|_| {}));\n        std::thread::sleep(std::time::Duration::from_millis(100));\n        kill();\n        let res = t.join().unwrap();\n        assert!(!res.clean_exit);\n    }\n}\n","stderr":"","executionTime":396,"interleavedOutput":"    }\n    if parsed.changed {\n        on(Event::Progress(ProgressSnapshotRaw {\n            last_tool: state.last_tool.clone(),\n            tokens_so_far: state.tokens_so_far,\n            last_assistant: state.last_assistant.clone(),\n            files_touched: state.files_touched.clone(),\n            phase: state.phase.clone(),\n        }));\n    }\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use std::sync::Mutex;\n\n    #[test]\n    fn parses_ndjson_emits_progress_resolves_result() {\n        // A tool call line (with newline), then the terminal result WITHOUT a trailing newline.\n        let stdout = concat!(\n            r#\"{\"type\":\"tool_call\",\"subtype\":\"started\",\"tool_call\":{\"shellToolCall\":{}}}\"#,\n            \"\\n\",\n            r#\"{\"type\":\"result\",\"subtype\":\"success\",\"is_error\":false,\"result\":\"all good\",\"session_id\":\"sid\",\"usage\":{\"outputTokens\":7}}\"#,\n        );\n        let progress = Mutex::new(Vec::new());\n        let on = |e: Event| {\n            if let Event::Progress(p) = e {\n                progress.lock().unwrap().push(p);\n            }\n        };\n        let res = drive_streams(stdout.as_bytes(), &b\"\"[..], &on, || true);\n        assert!(res.clean_exit);\n        assert_eq!(res.raw.result.as_deref(), Some(\"all good\"));\n        assert_eq!(res.raw.session_id.as_deref(), Some(\"sid\"));\n        let progress = progress.into_inner().unwrap();\n        assert!(!progress.is_empty());\n        assert_eq!(progress[0].last_tool.as_deref(), Some(\"shell\"));\n    }\n\n    #[test]\n    fn non_zero_exit_is_unclean_and_stderr_is_captured() {\n        let res = drive_streams(&b\"\"[..], &b\"trouble\"[..], &|_| {}, || false);\n        assert!(!res.clean_exit);\n        assert_eq!(res.stderr, \"trouble\");\n    }\n\n    #[test]\n    fn stderr_keeps_only_a_bounded_tail() {\n        let big = vec![b'x'; STDERR_KEEP * 2 + 5];\n        let res = drive_streams(&b\"\"[..], &big[..], &|_| {}, || true);\n        assert_eq!(res.stderr.len(), STDERR_KEEP);\n    }\n\n    #[test]\n    fn spawn_failure_is_an_error_result() {\n        let spec =\n            crate::job_registry::tests::spec_of(|s| s.bin = \"/nonexistent/cursor-agent\".into());\n        let spawned = CursorAdapter.run(&spec);\n        (spawned.kill)();\n        let res = (spawned.drive)(&|_| {});\n        assert!(!res.clean_exit);\n        assert_eq!(res.raw.is_error, Some(true));\n    }\n\n    #[test]\n    fn real_child_runs_and_sigterm_kills_it() {\n        let spec = crate::job_registry::tests::spec_of(|s| {\n            s.bin = \"/bin/sh\".into();\n            s.argv = vec![\"-c\".into(), \"exec sleep 30\".into()];\n        });\n        let spawned = CursorAdapter.run(&spec);\n        let kill = spawned.kill;\n        let t = std::thread::spawn(move || (spawned.drive)(&|_| {}));\n        std::thread::sleep(std::time::Duration::from_millis(100));\n        kill();\n        let res = t.join().unwrap();\n        assert!(!res.clean_exit);\n    }\n}\n","localExecutionTimeMs":179},"isBackground":false},"description":"Cursor backend unit tests on origin/main"},"hookAdditionalContexts":[],"toolCallId":"tool_8741fdb3-46a4-4752-8012-7bd7947206f","startedAtMs":"1790845607371","completedAtMs":"1790845607911"},"model_call_id":"13e7813c-8061-40d0-a475-19ebe85b4952-8-b7mh","session_id":"7dd612d0-6469-4d8d-870b-f50c14f3831a","timestamp_ms":1790845607887}
{"type":"tool_call","subtype":"completed","call_id":"tool_423f5ac5-b1c8-4eaf-a5bc-6004f495784","tool_call":{"shellToolCall":{"args":{"command":"cd /Users/user/work/delegate-fixtures && git show origin/main:src/output.rs | head -50","workingDirectory":"","timeout":30000,"toolCallId":"tool_423f5ac5-b1c8-4eaf-a5bc-6004f495784","simpleCommands":["cd","git","head"],"hasInputRedirect":false,"hasOutputRedirect":false,"parsingResult":{"parsingFailed":false,"executableCommands":[{"name":"cd","args":[{"type":"word","value":"/Users/user/work/delegate-fixtures"}],"fullText":"cd /Users/user/work/delegate-fixtures"},{"name":"git","args":[{"type":"word","value":"show"},{"type":"word","value":"origin/main:src/output.rs"}],"fullText":"git show origin/main:src/output.rs"},{"name":"head","args":[{"type":"number","value":"-50"}],"fullText":"head -50"}],"hasRedirects":false,"hasCommandSubstitution":false,"redirects":[]},"fileOutputThresholdBytes":"40000","isBackground":false,"skipApproval":false,"timeoutBehavior":"TIMEOUT_BEHAVIOR_BACKGROUND","hardTimeout":86400000,"description":"to_run_output normalized path","closeStdin":true,"conversationId":"7dd612d0-6469-4d8d-870b-f50c14f3831a","adminCommandDenylist":[],"requestId":"13e7813c-8061-40d0-a475-19ebe85b4952"},"result":{"success":{"command":"cd /Users/user/work/delegate-fixtures && git show origin/main:src/output.rs | head -50","workingDirectory":"","exitCode":0,"signal":"","stdout":"use crate::backends::types::BackendResult;\nuse crate::types::{RUN_STATUSES, RunOutput, RunStatus, Usage};\n\npub fn derive_status(text: &str, raw_is_error: Option<bool>, clean_exit: bool) -> RunStatus {\n    let lines: Vec<&str> = text\n        .split('\\n')\n        .filter(|line| !line.trim().is_empty())\n        .collect();\n    let last = lines.last().copied().unwrap_or(\"\");\n    // JS split('\\n') keeps `\\r` on CRLF lines; match that, then the regex.\n    let last = last.trim_end_matches('\\r');\n    if let Some(caps) = status_line(last)\n        && RUN_STATUSES.contains(&caps)\n        && let Some(s) = RunStatus::parse(caps)\n    {\n        return s;\n    }\n    if raw_is_error == Some(false) && clean_exit {\n        return RunStatus::Done;\n    }\n    RunStatus::Error\n}\n\nfn status_line(last: &str) -> Option<&str> {\n    // /^STATUS:\\s*([A-Z_]+)\\s*$/\n    let rest = last.strip_prefix(\"STATUS:\")?;\n    let rest = rest.trim_start_matches([' ', '\\t']);\n    let token = rest.trim_end();\n    if token.chars().all(|c| c.is_ascii_uppercase() || c == '_') && !token.is_empty() {\n        Some(token)\n    } else {\n        None\n    }\n}\n\npub fn to_run_output(\n    res: &BackendResult,\n    model: &str,\n    backend: &str,\n    usage: Option<Usage>,\n    cost_usd: Option<f64>,\n) -> RunOutput {\n    let text = res.raw.result.clone().unwrap_or_default();\n    RunOutput {\n        status: derive_status(&text, res.raw.is_error, res.clean_exit),\n        text,\n        session_id: res.raw.session_id.clone(),\n        backend: backend.to_string(),\n        model: model.to_string(),\n        usage,\n","stderr":"","executionTime":407,"interleavedOutput":"use crate::backends::types::BackendResult;\nuse crate::types::{RUN_STATUSES, RunOutput, RunStatus, Usage};\n\npub fn derive_status(text: &str, raw_is_error: Option<bool>, clean_exit: bool) -> RunStatus {\n    let lines: Vec<&str> = text\n        .split('\\n')\n        .filter(|line| !line.trim().is_empty())\n        .collect();\n    let last = lines.last().copied().unwrap_or(\"\");\n    // JS split('\\n') keeps `\\r` on CRLF lines; match that, then the regex.\n    let last = last.trim_end_matches('\\r');\n    if let Some(caps) = status_line(last)\n        && RUN_STATUSES.contains(&caps)\n        && let Some(s) = RunStatus::parse(caps)\n    {\n        return s;\n    }\n    if raw_is_error == Some(false) && clean_exit {\n        return RunStatus::Done;\n    }\n    RunStatus::Error\n}\n\nfn status_line(last: &str) -> Option<&str> {\n    // /^STATUS:\\s*([A-Z_]+)\\s*$/\n    let rest = last.strip_prefix(\"STATUS:\")?;\n    let rest = rest.trim_start_matches([' ', '\\t']);\n    let token = rest.trim_end();\n    if token.chars().all(|c| c.is_ascii_uppercase() || c == '_') && !token.is_empty() {\n        Some(token)\n    } else {\n        None\n    }\n}\n\npub fn to_run_output(\n    res: &BackendResult,\n    model: &str,\n    backend: &str,\n    usage: Option<Usage>,\n    cost_usd: Option<f64>,\n) -> RunOutput {\n    let text = res.raw.result.clone().unwrap_or_default();\n    RunOutput {\n        status: derive_status(&text, res.raw.is_error, res.clean_exit),\n        text,\n        session_id: res.raw.session_id.clone(),\n        backend: backend.to_string(),\n        model: model.to_string(),\n        usage,\n","localExecutionTimeMs":191},"isBackground":false},"description":"to_run_output normalized path"},"hookAdditionalContexts":[],"toolCallId":"tool_423f5ac5-b1c8-4eaf-a5bc-6004f495784","startedAtMs":"1790845607376","completedAtMs":"1790845607934"},"model_call_id":"13e7813c-8061-40d0-a475-19ebe85b4952-8-b7mh","session_id":"7dd612d0-6469-4d8d-870b-f50c14f3831a","timestamp_ms":1790845607932}
