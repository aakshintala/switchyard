tual = open(sys.argv[1]).read().split('\\n')\ndef row(mark, id, label, backend, inp, outp):\n    return f\"{mark} {id:<38}  {label:<26}  {backend:<7}  {inp:>6}  {outp:>7}\"\nexp = [\n  f\"  {'ID':<38}  {'LABEL':<26}  {'BACKEND':<7}  {'$IN/1M':>6}  {'$OUT/1M':>7}\",\n  row(' ', 'claude-fable-5-1', 'Claude Fable 5.1', 'claude', '10.00', '50.00'),\n  row(' ', 'claude-opus-5-5', 'Claude Opus 5.5', 'claude', '4.00', '20.00'),\n  row(' ', 'claude-sonnet-5-5', 'Claude Sonnet 5.5', 'claude', '2.00', '10.00'),\n  row('*', 'composer-2.5', 'Composer 2.5', 'cursor', '0.50', '2.50'),\n  row(' ', 'grok-4.7-high', 'Grok 4.7 High', 'cursor', '2.00', '6.00'),\n  row(' ', 'grok-4.7-xhigh', 'Grok 4.7 Extra High', 'cursor', '2.00', '6.00'),\n  row(' ', 'openai-codex/gpt-6-astra', 'GPT-6 Astra', 'pi', '10.00', '50.00'),\n  row(' ', 'openai-codex/gpt-6-luna', 'GPT-6 Luna', 'pi', '0.10', '0.50'),\n  row(' ', 'openai-codex/gpt-6.1-sol', 'GPT-6.1 Sol', 'pi', '2.00', '10.00'),\n  row(' ', 'opencode-go/deepseek-v4.1-flash', 'DeepSeek V4.1 Flash', 'pi', '0.15', '0.60'),\n  row(' ', 'opencode-go/glm-5.3-flash', 'GLM 5.3 Flash', 'pi', '0.15', '0.50'),\n  row(' ', 'opencode-go/muse-spark-1.3-contributor', 'Muse Spark 1.3 Contributor', 'pi', '0.10', '0.20'),\n]\nok = True\nfor i, (a, e) in enumerate(zip(actual, exp)):\n    if a != e:\n        ok = False\n        print(f\"line {i} DIFF\\n actual:{a!r}\\n expect:{e!r}\")\nprint(\"MATCH\" if ok and len(actual) == len(exp) + 1 else f\"lines actual={len(actual)} exp={len(exp)}\")\nprint(\"composer row:\", repr(exp[4]))\nprint(\"muse row:    \", repr(exp[12]))\nEOF\nrm -rf $D","timeout":60}}],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":999,"output":1677,"cacheRead":152561,"cacheWrite":0,"reasoning":843,"totalTokens":155237,"cost":{"input":0.0000999,"output":0.0003354,"cacheRead":0.000305122,"cacheWrite":0,"total":0.000740422}},"stopReason":"toolUse","timestamp":1790846285490,"responseId":"resp_