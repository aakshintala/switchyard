       price: entry.price,\n    })\n}\n\npub trait ConfigLike {\n    fn default_model(&self) -> &str;\n    fn models(&self) -> &std::collections::HashMap<String, crate::types::ModelEntry>;\n}\n\nimpl ConfigLike for Config {\n    fn default_model(&self) -> &str {\n        &self.default\n    }\n    fn models(&self) -> &std::collections::HashMap<String, crate::types::ModelEntry> {\n        &self.models\n    }\n}\n\n\n[114 more lines in file. Use offset=66 to continue.]"}],"isError":false,"timestamp":1790845939049},{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_6abe23f32b36c04280194dc1:rs_01a0f6bc706d73c3b4a4611a7fe43e9f\",\"type\":\"reasoning\",\"status\":\"completed\",\"encrypted_content\":\"Q-PaDgFpAlV4Rnrhko98urINc_QxBUx2wH7JYsWVkkMCwEkk37PwDPTWC166Egvo3gcFNDNni4PDqmTF5oCOil0o3O4JZQFaNpeLh3j86Ib1QBU7J5mMgwlRtF2oEmzQfw_iZpRE063AF4AAXPF7rhipf5hbJvb0EEEDmfI65rDejUcYjNYKJK9wsC7FK0GGvb0c9JaaMbF2_Wo1LdWx7RZHlFYcCP2nFtgySX3TJDMBGhPTl_eWOdtIIFz_RbDyvDpn42EQQQDh5VBTDVke-c3FxRQZSxh_fQeqc5bijwnhKfo4ZlA9JTSRmfCSzkzXQvlhsZZjTkYgUfAQP_nk-Klj6qpdiAlOxLz_F31xbF9dF7bVWQQwlm4zHPoo-5i4RvmxkIPRDHnIjlqwgYieQv1ZxRZyJ9O3cFELQl1uzqo_ywOjSkJGM8yGFVv3F83X_SnOOkiZ_3bgHCvBUqgTAafpFe5VFYXi8uvewPK3rIxb_7OX0xzMjeYf5a6EHaTzXMwrIRsEQfTjqCJN1vh1-cDOgHGX2CvKtzxaIwKTZQ-saYQ91kpklJATe2nquYS_nrOfa6erEHJBHk9OD3YDJwWfQ71sLMnZ8svGljtj-nl4VfMK6b-aWEKqI7ZPPrdsUQLiDMVWJp9jREIcNIx54t12Qkm0uHIJi6cRquml0Ccq5zt1miwF6ffUbCAggOiV9wE75qU7fgbPlCUioBZQg2VFKni2jTx5eI5DCwHDfEagF1I63trS_Qp_d3nvHcWRyJbbLbN1UF9IeAlepE1oQ1BVSCZjXUSO8cbr6_EhOpucWPJ8iUnYh7QDqdIFPqiDH2ccHcZHDU-_ifSKk69pqVgm2OCsNAkfToYIKzMeHlf58T1UNJzw9UC1zMYdWlZXE3oKRPM9rnctM7dTl1PBCkA-T0ecI4roS5Wqraz8OFVeggaaHyZoEFcDg8WkCd-tg9zsU9767vI2INza-kHHwDKWop49tbzl_DZDx2o8DUm_rRw3xSlKA05VZdMalFdICtdaEFLY0UI1JD4y_AHeIMjuHxmH65CICATQ1r7brknWiJebDalEmov4dl6p1eQkM03sIZJRro5bLIXTN4hLh3vqA7bmOkRh-4qNUTrsQ3fO2N1njzbyDF0Q_tThXDq2meRPSqyCDtvsAE6qxfksCcO14PT5OZVZYPMudWz382Wlz7t0k8IY4wtLs9zYOq-sDSihOekmWdvABFEf54Edu7DNe3nmlhMbcE