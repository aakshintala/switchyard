into_owned()\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n\n    #[test]\n    fn explicit_override_wins() {\n        assert_eq!(\n            resolve_cursor_bin(Some(\"/custom/cursor-agent\")),\n            \"/custom/cursor-agent\"\n        );\n    }\n\n    #[test]\n    fn env_used_when_no_override() {\n        let prev = std::env::var(\"CURSOR_AGENT_BIN\").ok();\n        unsafe { std::env::set_var(\"CURSOR_AGENT_BIN\", \"/env/cursor-agent\") };\n        assert_eq!(resolve_cursor_bin(None), \"/env/cursor-agent\");\n        match prev {\n            Some(v) => unsafe { std::env::set_var(\"CURSOR_AGENT_BIN\", v) },\n            None => unsafe { std::env::remove_var(\"CURSOR_AGENT_BIN\") },\n        }\n    }\n}\n"}],"isError":false,"timestamp":1790845555594},{"role":"toolResult","toolCallId":"call_01a0f6b69150713f808e4987680fc0ab|fc_01a0f6b69150713f808e4987680fc0ab","toolName":"read","content":[{"type":"text","text":"fn main() {\n    std::process::exit(cursor_delegate_mcp::cli::main());\n}\n"}],"isError":false,"timestamp":1790845555594},{"role":"assistant","content":[],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"stopReason":"error","timestamp":1790845555595,"errorMessage":"opencode-go API error (429): {\"code\":\"rate_limit_exceeded\",\"message\":\"Rate limit exceeded. Please retry after a brief wait.\",\"param\":null,\"type\":\"rate_limit_error\"}","thinkingLevel":"high"}],"willRetry":true}
