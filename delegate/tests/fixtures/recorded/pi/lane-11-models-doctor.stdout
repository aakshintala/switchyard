.229\n   Compiling indexmap v2.14.2\n   Compiling cursor-delegate-mcp v0.5.0 (/Users/user/work/delegate-11-models-doctor)\n    Finished `dev` profile [unoptimized + debuginfo] target(s) in 4.86s","truncated":true,"truncatedBy":"bytes","totalLines":34,"totalBytes":187846,"outputLines":20,"outputBytes":48116,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":2000,"maxBytes":51200},"fullOutputPath":"/var/folders/dq/_c83wftd34g281_1002c_gl00000gn/T/pi-bash-610b2bf631296c6b.log"},"structuredContent":{"output":"src/tool_schemas.rs:40:                \"description\": \"When true, hard-reject if the resolved model family is 'claude'. Default false.\",\nsrc/pricing.rs:37:            \"grok-4.5-xhigh\".into(),\nsrc/pricing.rs:46:            \"gpt-5.5-high\".into(),\nsrc/pricing.rs:90:            compute_cost(Some(&usage()), &price_map(), \"grok-4.5-xhigh\"),\nsrc/pricing.rs:98:            compute_cost(Some(&usage()), &price_map(), \"gpt-5.5-high\"),\nsrc/pricing.rs:105:        assert_eq!(compute_cost(Some(&usage()), &price_map(), \"gpt-5.5\"), None);\nsrc/validate.rs:164:            \"model\": \"grok-4.5-xhigh\",\nsrc/validate.rs:169:        assert_eq!(input.model.as_deref(), Some(\"grok-4.5-xhigh\"));\ntests/fixtures/cursor/preflight-7.stdout:33:{\"type\":\"tool_call\",\"subtype\":\"completed\",\"call_id\":\"tool_03fbc267-69b6-45ce-bd6b-8cee6bf2409\",\"tool_call\":{\"readToolCall\":{\"args\":{\"path\":\"/Users/user/work/delegate-7-tracer/src/models.rs\"},\"result\":{\"success\":{\"content\":\"use crate::types::{Config, ResolvedModel};\\n\\n#[derive(Debug)]\\npub struct ModelNotAllowedError {\\n    pub message: String,\\n}\\n\\nimpl std::fmt::Display for ModelNotAllowedError {\\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\\n        f.write_str(&self.message)\\n    }\\n}\\nimpl std::error::Error for ModelNotAllowedError {}\\n\\n#[derive(Debug)]\\npub struct NonClaudeViolationError {\\n    pub message: String,\\n}\\n\\nimpl std::fmt::Display for NonClaudeViolationError {\\n    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {\\n        f.write_str(&self.message)\\n    }\\n}\\nimpl std::error::Error for NonClaudeViolationError {}\\n\\npub fn resolve_model(\\n    model: Option<&str>,\\n    require_non_claude: bool,\\n    config: &impl ConfigLike,\\n) -> Result<ResolvedModel, Box<dyn std::error::Error + Send + Sync>> {\\n    let model = model\\n        .map(|s| s.to_string())\\n        .unwrap_or_else(|| config.default_model().to_string());\\n    let entry = config.models().get(&model).ok_or_else(|| {\\n        Box::new(ModelNotAllowedError {\\n            message: format!(\\\"model \\\\\\\"{model}\\\\\\\" is not in the allow-list\\\"),\\n        }) as Box<dyn std::error::Error + Send + Sync>\\n    })?;\\n    if require_non_claude && entry.family == \\\"claude\\\" {\\n        return Err(Box::new(NonClaudeViolationError {\\n            message: format!(\\\"requireNonClaude is set but model \\\\\\\"{model}\\\\\\\" has family \\\\\\\"claude\\\\\\\"\\\"),\\n        }));\\n    }\\n    Ok(ResolvedModel {\\n        model,\\n        family: entry.family.clone(),\\n        price: entry.price,\\n    })\\n}\\n\\npub trait ConfigLike {\\n    fn default_model(&self) -> &str;\\n    fn models(&self) -> &std::collections::HashMap<String, crate::types::ModelEntry>;\\n}\\n\\nimpl ConfigLike for Config {\\n    fn default_model(&self) -> &str {\\n        &self.default\\n    }\\n    fn models(&self) -> &std::collections::HashMap<String, crate::types::ModelEntry> {\\n        &self.models\\n    }\\n}\\n\\nimpl ConfigLike\\n    for (\\n        &str,\\n        &std::collections::HashMap<String, crate::types::ModelEntry>,\\n    )\\n{\\n    fn default_model(&self) -> &str {\\n        self.0\\n    }\\n    fn models(&self) -> &std::collections::HashMap<String, crate::types::ModelEntry> {\\n        self.1\\n    }\\n}\\n\\n#[cfg(test)]\\nmod tests {\\n    use super::*;\\n    use crate::types::{ModelEntry, Price};\\n    use std::collections::HashMap;\\n\\n    fn price(input: f64, output: f64, cache_read: f64, cache_write: f64) -> Price {\\n        Price {\\n            input,\\n            output,\\n            cache_read,\\n            cache_write,\\n        }\\n    }\\n\\n    fn base() -> (String, HashMap<String, ModelEntry>) {\\n        let mut models = HashMap::new();\\n        models.insert(\\n            \\\"composer-2.5\\\".into(),\\n            ModelEntry {\\n                label: \\\"Composer 2.5\\\".into(),\\n                family: \\\"composer\\\".into(),\\n                price: price(0.5, 2.5, 0.2, 0.0),\\n            },\\n        );\\n        models.insert(\\n            \\\"grok-4.5-xhigh\\\".into(),\\n            ModelEntry {\\n                label: \\\"Grok 4.5\\\".into(),\\n                family: \\\"grok\\\".into(),\\n                price: price(2.0, 6.0, 0.5, 0.0),\\n            },\\n        );\\n        models.insert(\\n            \\\"claude-sonnet-4\\\".into(),\\n            ModelEntry {\\n                label: \\\"Claude Sonnet 4\\\".into(),\\n                family: \\\"claude\\\".into(),\\n                price: price(3.0, 15.0, 0.3, 0.0),\\n            },\\n        );\\n        (\\\"composer-2.5\\\".into(), models)\\n    }\\n\\n    #[test]\\n    fn omitted_model_resolves_to_default() {\\n        let (d, m) = base();\\n        let r = resolve_model(None, false, &(d.as_str(), &m)).unwrap();\\n        assert_eq!(r.model, \\\"composer-2.5\\\");\\n        assert_eq!(r.family, \\\"composer\\\");\\n        assert_eq!(r.price, m[\\\"composer-2.5\\\"].price);\\n    }\\n\\n    #[test]\\n    fn allowed_id_resolves_with_family_and_price() {\\n        let (d, m) = base();\\n        let r = resolve_model(Some(\\\"grok-4.5-xhigh\\\"), false, &(d.as_str(), &m)).unwrap();\\n        assert_eq!(r.model, \\\"grok-4.5-xhigh\\\");\\n        assert_eq!(r.family, \\\"grok\\\");\\n        assert_eq!(r.price, m[\\\"grok-4.5-xhigh\\\"].price);\\n    }\\n\\n    #[test]\\n    fn unknown_id_throws_model_not_allowed() {\\n        let (d, m) = base();\\n        let e = resolve_model(Some(\\\"not-listed\\\"), false, &(d.as_str(), &m)).unwrap_err();\\n        assert!(e.downcast_ref::<ModelNotAllowedError>().is_some());\\n    }\\n\\n    #[test]\\n    fn require_non_claude_rejects_explicit_claude() {\\n        let (d, m) = base();\\n        let e = resolve_model(Some(\\\"claude-sonnet-4\\\"), true, &(d.as_str(), &m)).unwrap_err();\\n        assert!(e.downcast_ref::<NonClaudeViolationError>().is_some());\\n    }\\n\\n    #[test]\\n    fn require_non_claude_rejects_claude_default() {\\n        let (_, m) = base();\\n        let e = resolve_model(None, true, &(\\\"claude-sonnet-4\\\", &m)).unwrap_err();\\n        assert!(e.downcast_ref::<NonClaudeViolationError>().is_some());\\n    }\\n\\n    #[test]\\n    fn require_non_claude_passes_non_claude() {\\n        let (d, m) = base();\\n        let r = resolve_model(Some(\\\"grok-4.5-xhigh\\\"), true, &(d.as_str(), &m)).unwrap();\\n        assert_eq!(r.model, \\\"grok-4.5-xhigh\\\");\\n        assert_eq!(r.family, \\\"grok\\\");\\n    }\\n\\n    #[test]\\n    fn require_non_claude_false_allows_claude() {\\n        let (d, m) = base();\\n        let r = resolve_model(Some(\\\"claude-sonnet-4\\\"), false, &(d.as_str(), &m)).unwrap();\\n        assert_eq!(r.model, \\\"claude-sonnet-4\\\");\\n        assert_eq!(r.family, \\\"claude\\\");\\n    }\\n}\\n\",\"isEmpty\":false,\"exceededLimit\":false,\"totalLines\":179,\"fileSize\":5354,\"path\":\"/Users/user/work/delegate-7-tracer/src/models.rs\",\"readRange\":{\"startLine\":1,\"endLine\":179},\"relatedCursorRulePaths\":[],\"relatedCursorRules\":[]}}},\"hookAdditionalContexts\":[],\"toolCallId\":\"tool_03fbc267-69b6-45ce-bd6b-8cee6bf2409\",\"startedAtMs\":\"1790842905469\",\"completedAtMs\":\"1790842906229\"},\"model_call_id\":\"1980f2fa-bcff-4397-b8a1-23601c4723d6-0-8565\",\"session_id\":\"36627d89-4873-4238-8376-e9782bc73a39\",\"timestamp_ms\":1790842906145}\ntests/fixtures/cursor/preflight-7.stdout:61:{\"type\":\"tool_call\",\"subtype\":\"completed\",\"call_id\":\"tool_dd79c2e2-ff7b-4ab2-9a16-24b3e24e613\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"cd /Users/user/work/delegate-7-tracer && gh issue view 4 --json body,title\",\"workingDirectory\":\"\",\"timeout\":30000,\"toolCallId\":\"tool_dd79c2e2-ff7b-4ab2-9a16-24b3e24e613\",\"simpleCommands\":[\"cd\",\"gh\"],\"hasInputRedirect\":false,\"hasOutputRedirect\":false,\"parsingResult\":{\"parsingFailed\":false,\"executableCommands\":[{\"name\":\"cd\",\"args\":[{\"type\":\"word\",\"value\":\"/Users/user/work/delegate-7-tracer\"}],\"fullText\":\"cd /Users/user/work/delegate-7-tracer\"},{\"name\":\"gh\",\"args\":[{\"type\":\"word\",\"value\":\"issue\"},{\"type\":\"word\",\"value\":\"view\"},{\"type\":\"number\",\"value\":\"4\"},{\"type\":\"word\",\"value\":\"--json\"},{\"type\":\"word\",\"value\":\"body,title\"}],\"fullText\":\"gh issue view 4 --json body,title\"}],\"hasRedirects\":false,\"hasCommandSubstitution\":false,\"redirects\":[]},\"fileOutputThresholdBytes\":\"40000\",\"isBackground\":false,\"skipApproval\":false,\"timeoutBehavior\":\"TIMEOUT_BEHAVIOR_BACKGROUND\",\"hardTimeout\":86400000,\"description\":\"Get issue #4 body text\",\"closeStdin\":true,\"conversationId\":\"36627d89-4873-4238-8376-e9782bc73a39\",\"adminCommandDenylist\":[],\"requestId\":\"1980f2fa-bcff-4397-b8a1-23601c4723d6\"},\"result\":{\"success\":{\"command\":\"cd /Users/user/work/delegate-7-tracer && gh issue view 4 --json body,title\",\"workingDirectory\":\"\",\"exitCode\":0,\"signal\":\"\",\"stdout\":\"{\\\"body\\\":\\\"## Problem Statement\\\\n\\\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\\\n\\\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\\\n\\\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\\\n\\\\n## Solution\\\\n\\\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\\\n\\\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\\\n\\\\n## User Stories\\\\n\\\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\\\n49. As a user, I want the skill to show briefs that say \\\\\\\"do not delegate further\\\\\\\", so that a delegated Claude does not loop back through delegate.\\\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\\\n\\\\n## Implementation Decisions\\\\n\\\\n**Surface.** The MCP server is removed. The CLI is:\\\\n\\\\n```\\\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\\\ndelegate cancel <jobId>\\\\ndelegate watch  <jobId>... [--timeout S]\\\\ndelegate doctor\\\\ndelegate models\\\\n```\\\\n\\\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\\\n\\\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\\\n\\\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\\\n\\\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\\\n\\\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\\\n\\\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\\\n\\\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\\\n\\\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\\\n\\\\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\\\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\\\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\\\n\\\\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\\\\n\\\\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\\\\n\\\\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\\\n\\\\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\\\\n\\\\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \\\\\\\"do not delegate further\\\\\\\" line for briefs. The plan-writer brief points at resume.\\\\n\\\\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\\\\n\\\\n## Testing Decisions\\\\n\\\\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\\\\n\\\\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\\\\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\\\\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\\\\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\\\\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\\\\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\\\\n\\\\n## Out of Scope\\\\n\\\\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\\\\n- Fiber as a backend (waits for `fiber ask`).\\\\n- Sandboxing any backend, or a seatbelt wrapper for pi.\\\\n- Read-only mode for pi.\\\\n- Server-created worktrees; callers create their own and pass `--cwd`.\\\\n- Cleanup of old status records.\\\\n- Reading pi's model catalog at runtime for prices.\\\\n- Tiered (long-context) pricing in the model table.\\\\n- Keeping MCP as a second interface.\\\\n\\\\n## Further Notes\\\\n\\\\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\\\\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\\\\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\\\\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \\\\\\\"do not delegate further\\\\\\\" to stop loops.\\\\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\\\\n\\\\n\\\",\\\"title\\\":\\\"Spec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\\"}\\n\",\"stderr\":\"\",\"executionTime\":1522,\"interleavedOutput\":\"{\\\"body\\\":\\\"## Problem Statement\\\\n\\\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\\\n\\\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\\\n\\\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\\\n\\\\n## Solution\\\\n\\\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\\\n\\\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\\\n\\\\n## User Stories\\\\n\\\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\\\n49. As a user, I want the skill to show briefs that say \\\\\\\"do not delegate further\\\\\\\", so that a delegated Claude does not loop back through delegate.\\\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\\\n\\\\n## Implementation Decisions\\\\n\\\\n**Surface.** The MCP server is removed. The CLI is:\\\\n\\\\n```\\\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\\\ndelegate cancel <jobId>\\\\ndelegate watch  <jobId>... [--timeout S]\\\\ndelegate doctor\\\\ndelegate models\\\\n```\\\\n\\\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\\\n\\\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\\\n\\\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\\\n\\\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\\\n\\\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\\\n\\\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\\\n\\\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\\\n\\\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\\\n\\\\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\\\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\\\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\\\n\\\\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\\\\n\\\\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\\\\n\\\\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\\\n\\\\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\\\\n\\\\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \\\\\\\"do not delegate further\\\\\\\" line for briefs. The plan-writer brief points at resume.\\\\n\\\\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\\\\n\\\\n## Testing Decisions\\\\n\\\\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\\\\n\\\\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\\\\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\\\\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\\\\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\\\\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\\\\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\\\\n\\\\n## Out of Scope\\\\n\\\\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\\\\n- Fiber as a backend (waits for `fiber ask`).\\\\n- Sandboxing any backend, or a seatbelt wrapper for pi.\\\\n- Read-only mode for pi.\\\\n- Server-created worktrees; callers create their own and pass `--cwd`.\\\\n- Cleanup of old status records.\\\\n- Reading pi's model catalog at runtime for prices.\\\\n- Tiered (long-context) pricing in the model table.\\\\n- Keeping MCP as a second interface.\\\\n\\\\n## Further Notes\\\\n\\\\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\\\\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\\\\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\\\\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \\\\\\\"do not delegate further\\\\\\\" to stop loops.\\\\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\\\\n\\\\n\\\",\\\"title\\\":\\\"Spec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\\"}\\n\",\"localExecutionTimeMs\":1259},\"isBackground\":false},\"description\":\"Get issue #4 body text\"},\"hookAdditionalContexts\":[],\"toolCallId\":\"tool_dd79c2e2-ff7b-4ab2-9a16-24b3e24e613\",\"startedAtMs\":\"1790842910213\",\"completedAtMs\":\"1790842911901\"},\"model_call_id\":\"1980f2fa-bcff-4397-b8a1-23601c4723d6-1-i12h\",\"session_id\":\"36627d89-4873-4238-8376-e9782bc73a39\",\"timestamp_ms\":1790842911835}\ntests/fixtures/cursor/preflight-7.stdout:84:{\"type\":\"tool_call\",\"subtype\":\"completed\",\"call_id\":\"tool_5f340cae-40a3-4ac5-9d23-490d2fd1c7b\",\"tool_call\":{\"grepToolCall\":{\"args\":{\"pattern\":\"valid models|list.*model\",\"path\":\"/Users/user/work/delegate-7-tracer/src\",\"caseInsensitive\":true,\"headLimit\":20,\"multiline\":false,\"toolCallId\":\"tool_5f340cae-40a3-4ac5-9d23-490d2fd1c7b\",\"offset\":0},\"result\":{\"success\":{\"pattern\":\"valid models|list.*model\",\"path\":\"/Users/user/work/delegate-7-tracer/src\",\"outputMode\":\"content\",\"workspaceResults\":{\"/Users/user/work/delegate-7-tracer\":{\"content\":{\"matches\":[{\"file\":\"src/tool_schemas.rs\",\"matches\":[{\"lineNumber\":212,\"content\":\"model-menu drift (config/models.json ids vs `cursor-agent models` / `--list-models`). \\\\\",\"contentTruncated\":false,\"isContextLine\":false}]},{\"file\":\"src/doctor_tests.rs\",\"matches\":[{\"lineNumber\":180,\"content\":\"        parse_models_list(MODELS_FIXTURE),\",\"contentTruncated\":false,\"isContextLine\":false},{\"lineNumber\":306,\"content\":\"    t.insert(\\\"--list-models\\\".into(), ok_cmd(\\\"composer-2.5\\\\ngrok-4.5-xhigh\\\\n\\\"));\",\"contentTruncated\":false,\"isContextLine\":false},{\"lineNumber\":324,\"content\":\"    t.insert(\\\"--list-models\\\".into(), fail_cmd(\\\"exit 2\\\"));\",\"contentTruncated\":false,\"isContextLine\":false},{\"lineNumber\":731,\"content\":\"        m.insert(\\\"--list-models\\\".into(), fail_cmd(\\\"exit 2\\\"));\",\"contentTruncated\":false,\"isContextLine\":false}]},{\"file\":\"src/doctor.rs\",\"matches\":[{\"lineNumber\":10,\"content\":\"    \\\"Prices are not checkable via the CLI (about/models/--list-models return ids/labels only).\\\";\",\"contentTruncated\":false,\"isContextLine\":false},{\"lineNumber\":266,\"content\":\"    let mut list = run_command(bin, &[\\\"models\\\".into()]);\",\"contentTruncated\":false,\"isContextLine\":false},{\"lineNumber\":268,\"content\":\"        list = run_command(bin, &[\\\"--list-models\\\".into()]);\",\"contentTruncated\":false,\"isContextLine\":false},{\"lineNumber\":274,\"content\":\"                \\\"cursor-agent models/--list-models failed\\\".into()\",\"contentTruncated\":false,\"isContextLine\":false}]}],\"totalLines\":9,\"totalMatchedLines\":9,\"clientTruncated\":false,\"ripgrepTruncated\":false,\"headLimitApplied\":20}}}}}},\"hookAdditionalContexts\":[],\"toolCallId\":\"tool_5f340cae-40a3-4ac5-9d23-490d2fd1c7b\",\"startedAtMs\":\"1790842915666\",\"completedAtMs\":\"1790842916065\"},\"model_call_id\":\"1980f2fa-bcff-4397-b8a1-23601c4723d6-3-89dp\",\"session_id\":\"36627d89-4873-4238-8376-e9782bc73a39\",\"timestamp_ms\":1790842915999}\ntests/fixtures/cursor/error-bad-model.stderr:1:Cannot use this model: no-such-model. Available models: auto, gpt-5.3-codex-low, gpt-5.3-codex-low-fast, gpt-5.3-codex, gpt-5.3-codex-fast, gpt-5.3-codex-high, gpt-5.3-codex-high-fast, gpt-5.3-codex-xhigh, gpt-5.3-codex-xhigh-fast, gpt-5.2, composer-2.5, claude-opus-5-thinking-high, claude-opus-5-thinking-high-fast, gpt-5.6-sol-high, gpt-5.6-sol-high-fast, gpt-5.6-sol-xhigh, gpt-5.6-sol-xhigh-fast, claude-fable-5-thinking-high, claude-fable-5-thinking-xhigh, cursor-grok-4.5-high, cursor-grok-4.5-high-fast, gemini-3.7-flash-high, claude-sonnet-5-thinking-high, claude-sonnet-5-thinking-xhigh, gpt-5.6-luna-high, grok-4.7-low, grok-4.7-low-fast, grok-4.7-medium, grok-4.7-medium-fast, grok-4.7-high, grok-4.7-high-fast, grok-4.7-xhigh, grok-4.7-xhigh-fast, cursor-grok-4.6-low, cursor-grok-4.6-low-fast, cursor-grok-4.6-medium, cursor-grok-4.6-medium-fast, cursor-grok-4.6-high, cursor-grok-4.6-high-fast, cursor-grok-4.6-xhigh, cursor-grok-4.6-xhigh-fast, composer-2.5-fast, claude-opus-5-5-low, claude-opus-5-5-low-fast, claude-opus-5-5-medium, claude-opus-5-5-medium-fast, claude-opus-5-5-high, claude-opus-5-5-high-fast, claude-opus-5-5-xhigh, claude-opus-5-5-xhigh-fast, claude-opus-5-5-max, claude-opus-5-5-max-fast, claude-opus-5-low, claude-opus-5-low-fast, claude-opus-5-medium, claude-opus-5-medium-fast, claude-opus-5-high, claude-opus-5-high-fast, claude-opus-5-thinking-low, claude-opus-5-thinking-low-fast, claude-opus-5-thinking-medium, claude-opus-5-thinking-medium-fast, claude-opus-5-thinking-xhigh, claude-opus-5-thinking-xhigh-fast, claude-opus-5-thinking-max, claude-opus-5-thinking-max-fast, claude-opus-4-8-low, claude-opus-4-8-low-fast, claude-opus-4-8-medium, claude-opus-4-8-medium-fast, claude-opus-4-8-high, claude-opus-4-8-high-fast, claude-opus-4-8-xhigh, claude-opus-4-8-xhigh-fast, claude-opus-4-8-max, claude-opus-4-8-max-fast, claude-opus-4-8-thinking-low, claude-opus-4-8-thinking-low-fast, claude-opus-4-8-thinking-medium, claude-opus-4-8-thinking-medium-fast, claude-opus-4-8-thinking-high, claude-opus-4-8-thinking-high-fast, claude-opus-4-8-thinking-xhigh, claude-opus-4-8-thinking-xhigh-fast, claude-opus-4-8-thinking-max, claude-opus-4-8-thinking-max-fast, gpt-5.6-sol-none, gpt-5.6-sol-none-fast, gpt-5.6-sol-low, gpt-5.6-sol-low-fast, gpt-5.6-sol-medium, gpt-5.6-sol-medium-fast, gpt-5.6-sol-max, gpt-5.6-sol-max-fast, gpt-5.5-none, gpt-5.5-none-fast, gpt-5.5-low, gpt-5.5-low-fast, gpt-5.5-medium, gpt-5.5-medium-fast, gpt-5.5-high, gpt-5.5-high-fast, gpt-5.5-extra-high, gpt-5.5-extra-high-fast, claude-fable-5-1-low, claude-fable-5-1-medium, claude-fable-5-1-high, claude-fable-5-1-xhigh, claude-fable-5-1-max, claude-fable-5-1-thinking-low, claude-fable-5-1-thinking-medium, claude-fable-5-1-thinking-high, claude-fable-5-1-thinking-xhigh, claude-fable-5-1-thinking-max, claude-fable-5-low, claude-fable-5-medium, claude-fable-5-high, claude-fable-5-xhigh, claude-fable-5-max, claude-fable-5-thinking-low, claude-fable-5-thinking-medium, claude-fable-5-thinking-max, cursor-grok-4.5-low, cursor-grok-4.5-low-fast, cursor-grok-4.5-medium, cursor-grok-4.5-medium-fast, gemini-3.8-flash-low, gemini-3.8-flash-medium, gemini-3.8-flash-high, gemini-3.7-flash-low, gemini-3.7-flash-medium, muse-spark-1.3-minimal, muse-spark-1.3-low, muse-spark-1.3-medium, muse-spark-1.3-high, muse-spark-1.3-xhigh, muse-spark-1.3-max, gpt-5.6-terra-none, gpt-5.6-terra-none-fast, gpt-5.6-terra-low, gpt-5.6-terra-low-fast, gpt-5.6-terra-medium, gpt-5.6-terra-medium-fast, gpt-5.6-terra-high, gpt-5.6-terra-high-fast, gpt-5.6-terra-xhigh, gpt-5.6-terra-xhigh-fast, gpt-5.6-terra-max, gpt-5.6-terra-max-fast, claude-sonnet-5-5-low, claude-sonnet-5-5-medium, claude-sonnet-5-5-high, claude-sonnet-5-5-xhigh, claude-sonnet-5-5-max, claude-sonnet-5-low, claude-sonnet-5-medium, claude-sonnet-5-high, claude-sonnet-5-xhigh, claude-sonnet-5-max, claude-sonnet-5-thinking-low, claude-sonnet-5-thinking-medium, claude-sonnet-5-thinking-max, claude-4.6-sonnet-medium, claude-4.6-sonnet-medium-thinking, claude-opus-4-7-low, claude-opus-4-7-low-fast, claude-opus-4-7-medium, claude-opus-4-7-medium-fast, claude-opus-4-7-high, claude-opus-4-7-high-fast, claude-opus-4-7-xhigh, claude-opus-4-7-xhigh-fast, claude-opus-4-7-max, claude-opus-4-7-max-fast, claude-opus-4-7-thinking-low, claude-opus-4-7-thinking-low-fast, claude-opus-4-7-thinking-medium, claude-opus-4-7-thinking-medium-fast, claude-opus-4-7-thinking-high, claude-opus-4-7-thinking-high-fast, claude-opus-4-7-thinking-xhigh, claude-opus-4-7-thinking-xhigh-fast, claude-opus-4-7-thinking-max, claude-opus-4-7-thinking-max-fast, gpt-5.4-low, gpt-5.4-medium, gpt-5.4-medium-fast, gpt-5.4-high, gpt-5.4-high-fast, gpt-5.4-xhigh, gpt-5.4-xhigh-fast, claude-4.6-opus-high, claude-4.6-opus-max, claude-4.6-opus-high-thinking, claude-4.6-opus-max-thinking, claude-4.5-opus-high, claude-4.5-opus-high-thinking, gpt-5.2-low, gpt-5.2-low-fast, gpt-5.2-fast, gpt-5.2-high, gpt-5.2-high-fast, gpt-5.2-xhigh, gpt-5.2-xhigh-fast, gpt-5.6-luna-none, gpt-5.6-luna-none-fast, gpt-5.6-luna-low, gpt-5.6-luna-low-fast, gpt-5.6-luna-medium, gpt-5.6-luna-medium-fast, gpt-5.6-luna-high-fast, gpt-5.6-luna-xhigh, gpt-5.6-luna-xhigh-fast, gpt-5.6-luna-max, gpt-5.6-luna-max-fast, gemini-3.6-flash-minimal, gemini-3.6-flash-low, gemini-3.6-flash-medium, gemini-3.6-flash-high, gemini-3.1-pro, gpt-5.4-mini-none, gpt-5.4-mini-low, gpt-5.4-mini-medium, gpt-5.4-mini-high, gpt-5.4-mini-xhigh, gpt-5.4-nano-none, gpt-5.4-nano-low, gpt-5.4-nano-medium, gpt-5.4-nano-high, gpt-5.4-nano-xhigh, claude-4.5-sonnet, claude-4.5-sonnet-thinking, gpt-5.1-low, gpt-5.1, gpt-5.1-high, gemini-3-flash, gemini-3.5-flash, claude-4-sonnet, claude-4-sonnet-thinking, gpt-5-mini, kimi-k3-low, kimi-k3-high, kimi-k3-max, kimi-k2.7-code, glm-5.2-high, glm-5.2-max\ntests/fixtures/cursor/lane-8-ci.stdout:22:{\"type\":\"tool_call\",\"subtype\":\"completed\",\"call_id\":\"tool_d453d59d-0908-4eaf-a7ea-bbc839b4071\",\"tool_call\":{\"shellToolCall\":{\"args\":{\"command\":\"cd /Users/user/work/delegate-8-ci && gh issue view 8 && gh issue view 4\",\"workingDirectory\":\"\",\"timeout\":30000,\"toolCallId\":\"tool_d453d59d-0908-4eaf-a7ea-bbc839b4071\",\"simpleCommands\":[\"cd\",\"gh\",\"gh\"],\"hasInputRedirect\":false,\"hasOutputRedirect\":false,\"parsingResult\":{\"parsingFailed\":false,\"executableCommands\":[{\"name\":\"cd\",\"args\":[{\"type\":\"word\",\"value\":\"/Users/user/work/delegate-8-ci\"}],\"fullText\":\"cd /Users/user/work/delegate-8-ci\"},{\"name\":\"gh\",\"args\":[{\"type\":\"word\",\"value\":\"issue\"},{\"type\":\"word\",\"value\":\"view\"},{\"type\":\"number\",\"value\":\"8\"}],\"fullText\":\"gh issue view 8\"},{\"name\":\"gh\",\"args\":[{\"type\":\"word\",\"value\":\"issue\"},{\"type\":\"word\",\"value\":\"view\"},{\"type\":\"number\",\"value\":\"4\"}],\"fullText\":\"gh issue view 4\"}],\"hasRedirects\":false,\"hasCommandSubstitution\":false,\"redirects\":[]},\"fileOutputThresholdBytes\":\"40000\",\"isBackground\":false,\"skipApproval\":false,\"timeoutBehavior\":\"TIMEOUT_BEHAVIOR_BACKGROUND\",\"hardTimeout\":86400000,\"description\":\"View GitHub issues 8 and 4\",\"closeStdin\":true,\"conversationId\":\"57a946cc-91a7-4752-a451-3ee6bfd5841f\",\"adminCommandDenylist\":[],\"requestId\":\"f0d56946-3370-4eed-b1e9-cc2f4630a1e3\"},\"result\":{\"success\":{\"command\":\"cd /Users/user/work/delegate-8-ci && gh issue view 8 && gh issue view 4\",\"workingDirectory\":\"\",\"exitCode\":0,\"signal\":\"\",\"stdout\":\"title:\\tCI on Linux\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\tuser/delegate#6\\nblocking:\\t\\nnumber:\\t8\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nGitHub Actions CI on Linux (`ubuntu-latest`) running the format check, clippy with warnings as errors, and the test suite, on every push and pull request. Live tests stay excluded. macOS is tested locally.\\n\\nDrive this ticket's implementation through the recording script, saving the run as a fixture.\\n\\n## Acceptance criteria\\n\\n- [ ] The workflow runs on pull requests and on pushes to main.\\n- [ ] It passes on the current code, or the Linux-only failures it surfaces are fixed.\\n- [ ] Ignored live tests are not run.\\n\\n## Blocked by\\n\\n- #6 Record headless fixtures (recording script and probes)\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\n\\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n\\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\\n\\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\\n\\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n\\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\\n\\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \\\"do not delegate further\\\" line for briefs. The plan-writer brief points at resume.\\n\\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\\n\\n## Testing Decisions\\n\\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\\n\\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\\n\\n## Out of Scope\\n\\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\\n- Fiber as a backend (waits for `fiber ask`).\\n- Sandboxing any backend, or a seatbelt wrapper for pi.\\n- Read-only mode for pi.\\n- Server-created worktrees; callers create their own and pass `--cwd`.\\n- Cleanup of old status records.\\n- Reading pi's model catalog at runtime for prices.\\n- Tiered (long-context) pricing in the model table.\\n- Keeping MCP as a second interface.\\n\\n## Further Notes\\n\\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \\\"do not delegate further\\\" to stop loops.\\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\\n\\n\\n\",\"stderr\":\"\",\"executionTime\":3926,\"interleavedOutput\":\"title:\\tCI on Linux\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\tuser/delegate#6\\nblocking:\\t\\nnumber:\\t8\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nGitHub Actions CI on Linux (`ubuntu-latest`) running the format check, clippy with warnings as errors, and the test suite, on every push and pull request. Live tests stay excluded. macOS is tested locally.\\n\\nDrive this ticket's implementation through the recording script, saving the run as a fixture.\\n\\n## Acceptance criteria\\n\\n- [ ] The workflow runs on pull requests and on pushes to main.\\n- [ ] It passes on the current code, or the Linux-only failures it surfaces are fixed.\\n- [ ] Ignored live tests are not run.\\n\\n## Blocked by\\n\\n- #6 Record headless fixtures (recording script and probes)\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\n\\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n\\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\\n\\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\\n\\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n\\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\\n\\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \\\"do not delegate further\\\" line for briefs. The plan-writer brief points at resume.\\n\\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\\n\\n## Testing Decisions\\n\\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\\n\\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\\n\\n## Out of Scope\\n\\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\\n- Fiber as a backend (waits for `fiber ask`).\\n- Sandboxing any backend, or a seatbelt wrapper for pi.\\n- Read-only mode for pi.\\n- Server-created worktrees; callers create their own and pass `--cwd`.\\n- Cleanup of old status records.\\n- Reading pi's model catalog at runtime for prices.\\n- Tiered (long-context) pricing in the model table.\\n- Keeping MCP as a second interface.\\n\\n## Further Notes\\n\\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \\\"do not delegate further\\\" to stop loops.\\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\\n\\n\\n\",\"localExecutionTimeMs\":3448},\"isBackground\":false},\"description\":\"View GitHub issues 8 and 4\"},\"hookAdditionalContexts\":[],\"toolCallId\":\"tool_d453d59d-0908-4eaf-a7ea-bbc839b4071\",\"startedAtMs\":\"1790842888934\",\"completedAtMs\":\"1790842893006\"},\"model_call_id\":\"f0d56946-3370-4eed-b1e9-cc2f4630a1e3-0-z0ug\",\"session_id\":\"57a946cc-91a7-4752-a451-3ee6bfd5841f\",\"timestamp_ms\":1790842892934}\ntests/fixtures/claude/review-19.stdout:16:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01CtvwRn678gy36PGvnifeBK\",\"type\":\"tool_result\",\"content\":\"title:\\tci: Linux workflow (fmt, clippy, tests) (#8)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t19\\nurl:\\thttps://github.com/user/delegate/pull/19\\nadditions:\\t23\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #8\\n\\nOne `ci` job on `ubuntu-latest` for pull requests and pushes to `main`: `cargo fmt --check`, `cargo clippy --all-targets -- -D warnings`, `cargo test`. Ignored live tests stay excluded. Every action is pinned by SHA, the token is read-only, and `pull_request_target` is not used.\\n\\nImplemented by composer-2.5 via `scripts/record.sh` (fixture lands with #18).\\n\\nCo-authored with Claude Code.\\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\\nnew file mode 100644\\nindex 0000000..ede11d5\\n--- /dev/null\\n+++ b/.github/workflows/ci.yml\\n@@ -0,0 +1,23 @@\\n+name: CI\\n+\\n+on:\\n+  push:\\n+    branches: [main]\\n+  pull_request:\\n+\\n+permissions:\\n+  contents: read\\n+\\n+jobs:\\n+  ci:\\n+    runs-on: ubuntu-latest\\n+    steps:\\n+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\\n+      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87 # stable\\n+        with:\\n+          toolchain: stable\\n+          components: rustfmt, clippy\\n+      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2\\n+      - run: cargo fmt --check\\n+      - run: cargo clippy --all-targets -- -D warnings\\n+      - run: cargo test\\ntitle:\\tCI on Linux\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\tuser/delegate#6\\nblocking:\\t\\nnumber:\\t8\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nGitHub Actions CI on Linux (`ubuntu-latest`) running the format check, clippy with warnings as errors, and the test suite, on every push and pull request. Live tests stay excluded. macOS is tested locally.\\n\\nDrive this ticket's implementation through the recording script, saving the run as a fixture.\\n\\n## Acceptance criteria\\n\\n- [ ] The workflow runs on pull requests and on pushes to main.\\n- [ ] It passes on the current code, or the Linux-only failures it surfaces are fixed.\\n- [ ] Ignored live tests are not run.\\n\\n## Blocked by\\n\\n- #6 Record headless fixtures (recording script and probes)\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\n\\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n\\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\\n\\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\\n\\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n\\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\\n\\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \\\"do not delegate further\\\" line for briefs. The plan-writer brief points at resume.\\n\\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\\n\\n## Testing Decisions\\n\\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\\n\\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\\n\\n## Out of Scope\\n\\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\\n- Fiber as a backend (waits for `fiber ask`).\\n- Sandboxing any backend, or a seatbelt wrapper for pi.\\n- Read-only mode for pi.\\n- Server-created worktrees; callers create their own and pass `--cwd`.\\n- Cleanup of old status records.\\n- Reading pi's model catalog at runtime for prices.\\n- Tiered (long-context) pricing in the model table.\\n- Keeping MCP as a second interface.\\n\\n## Further Notes\\n\\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \\\"do not delegate further\\\" to stop loops.\\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"26c5e6c8-864e-4d87-8aa1-c1ca5a12b9c9\",\"uuid\":\"4d456178-f0db-42af-a381-5b967990b31d\",\"timestamp\":\"2026-10-01T08:23:07.923Z\",\"tool_use_result\":{\"stdout\":\"title:\\tci: Linux workflow (fmt, clippy, tests) (#8)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t19\\nurl:\\thttps://github.com/user/delegate/pull/19\\nadditions:\\t23\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #8\\n\\nOne `ci` job on `ubuntu-latest` for pull requests and pushes to `main`: `cargo fmt --check`, `cargo clippy --all-targets -- -D warnings`, `cargo test`. Ignored live tests stay excluded. Every action is pinned by SHA, the token is read-only, and `pull_request_target` is not used.\\n\\nImplemented by composer-2.5 via `scripts/record.sh` (fixture lands with #18).\\n\\nCo-authored with Claude Code.\\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\\nnew file mode 100644\\nindex 0000000..ede11d5\\n--- /dev/null\\n+++ b/.github/workflows/ci.yml\\n@@ -0,0 +1,23 @@\\n+name: CI\\n+\\n+on:\\n+  push:\\n+    branches: [main]\\n+  pull_request:\\n+\\n+permissions:\\n+  contents: read\\n+\\n+jobs:\\n+  ci:\\n+    runs-on: ubuntu-latest\\n+    steps:\\n+      - uses: actions/checkout@fbc6f3992d24b796d5a048ff273f7fcc4a7b6c09 # v5\\n+      - uses: dtolnay/rust-toolchain@6bed0761d98439e5a578e2877258200ad565ba87 # stable\\n+        with:\\n+          toolchain: stable\\n+          components: rustfmt, clippy\\n+      - uses: Swatinem/rust-cache@6323deb102c322ba6fcbdcafc7e3dddab59af2b6 # v2.9.2\\n+      - run: cargo fmt --check\\n+      - run: cargo clippy --all-targets -- -D warnings\\n+      - run: cargo test\\ntitle:\\tCI on Linux\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\tuser/delegate#6\\nblocking:\\t\\nnumber:\\t8\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nGitHub Actions CI on Linux (`ubuntu-latest`) running the format check, clippy with warnings as errors, and the test suite, on every push and pull request. Live tests stay excluded. macOS is tested locally.\\n\\nDrive this ticket's implementation through the recording script, saving the run as a fixture.\\n\\n## Acceptance criteria\\n\\n- [ ] The workflow runs on pull requests and on pushes to main.\\n- [ ] It passes on the current code, or the Linux-only failures it surfaces are fixed.\\n- [ ] Ignored live tests are not run.\\n\\n## Blocked by\\n\\n- #6 Record headless fixtures (recording script and probes)\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\n\\n- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n\\n**Model table.** Bundled JSON: `default` plus, per id, `{label, backend, price}`. Prices are kept for every model for display; only cursor uses them to compute cost. Pi model ids use pi's `provider/model` form. Default is `composer-2.5`. Grok 4.7 ids are `grok-4.7-high` / `grok-4.7-xhigh` (no `cursor-` prefix), priced as Grok 4.6.\\n\\n**Prompt composition.** The tool adds only the STATUS-line instruction to the caller's prompt; the result status is parsed from that line.\\n\\n**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n\\n**Rename.** Binary `delegate`; config at `~/.config/delegate/` with `DELEGATE_HOST_PROFILE` override; setup moves the old profile file. The Claude plugin ships the skill only. The Codex plugin manifest is dropped since nothing needs registering. The GitHub repo and local directory were renamed on 2026-10-01. The user's global agent instructions and agent memory are updated to the new names.\\n\\n**Skill.** Rewritten for the CLI: model picks and catalog over the new ids, read-only/read-write, cwd, gates, resume with overrides, the background `delegate watch` as the only documented waiting path, and a \\\"do not delegate further\\\" line for briefs. The plan-writer brief points at resume.\\n\\n**Delivery order.** (1) CLI conversion with all trims and the rename, cursor only, plus CI; (2) backend split behind the interface; (3) pi backend; (4) claude backend.\\n\\n## Testing Decisions\\n\\nA good test drives the `delegate` binary as a real process and asserts on what a caller sees: command output, exit status, and status-file contents. It does not reach into internal modules.\\n\\n- **Primary seam: the CLI against fake agent binaries.** Extends the existing end-to-end tests, which already run the real binary with a shell-script fake cursor-agent selected by an environment variable. Each backend gets a fake that replays a recorded stream. Covers run/detach, BUSY across processes, watchdog kill, gate pass/fail, change-set, NEEDS_CONTEXT, resume with and without overrides, cross-backend override rejection, resume after the original process is gone, cancel killing the process group, watch timeout, doctor, models.\\n- **Parser seam: one per backend, on recorded headless output.** Prior art: the cursor adapter's stream tests. Fixtures are raw stdout captured from real headless runs, not stored session files (pi session files, Claude transcripts and Cursor chat stores are different formats). Use past sessions to choose realistic tasks to record: long tool output, many tool calls, resume, errors.\\n- **Live tests, opt-in.** One real round trip per backend, ignored by default, like the existing live test. They save raw stdout as fresh fixtures. They also settle two open behaviours: whether headless plan mode in Claude answers rather than proposing a plan, and how often auto mode refuses calls.\\n- **Latency budgets.** Every command is timed against fake agents. `run` returning its job id matters most. Budgets are set at about 3x the local measurement so CI noise does not trip them.\\n- **Memory budget.** The supervisor's resident memory is measured while a fake agent runs. Replaces the old idle-server memory gate.\\n- **CI.** GitHub Actions on Linux: format check, clippy with warnings as errors, tests. Live tests excluded. macOS runs locally. The suite currently takes about 5 seconds warm, 5 seconds clean build.\\n\\n## Out of Scope\\n\\n- A separate Codex backend; Codex models are reached through pi's openai-codex provider.\\n- Fiber as a backend (waits for `fiber ask`).\\n- Sandboxing any backend, or a seatbelt wrapper for pi.\\n- Read-only mode for pi.\\n- Server-created worktrees; callers create their own and pass `--cwd`.\\n- Cleanup of old status records.\\n- Reading pi's model catalog at runtime for prices.\\n- Tiered (long-context) pricing in the model table.\\n- Keeping MCP as a second interface.\\n\\n## Further Notes\\n\\n- Usage numbers come from 413 deduplicated `cursor_run` calls in local Claude transcripts.\\n- Headless Claude auto mode cannot prompt, so calls its classifier will not auto-approve are refused. If that proves frequent, revisit.\\n- If headless plan mode misbehaves, fall back to blocking the edit tools for read-only Claude runs.\\n- A delegated Claude or pi loads this skill and the user's global instructions, so briefs must say \\\"do not delegate further\\\" to stop loops.\\n- Superseded design notes: the multi-backend idea doc, which this spec replaces.\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ntests/fixtures/claude/review-18.stdout:15:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HGCobLa7Nx9QjMUKTdjMFz\",\"type\":\"tool_result\",\"content\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"ea4f5f94-4a7a-4d19-b942-97adc57b4168\",\"timestamp\":\"2026-10-01T08:27:01.239Z\",\"tool_use_result\":{\"stdout\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ntests/fixtures/claude/review-18.stdout:29:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":\"Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\",\"is_error\":true,\"tool_use_id\":\"toolu_019cExtXuYqSGwSxpUdYaKTt\"}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"797cfe15-0894-4fe8-8311-9be1f92b1294\",\"timestamp\":\"2026-10-01T08:27:17.686Z\",\"tool_use_result\":\"Error: Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\"}\n=== build ===\n   Compiling proc-macro2 v1.0.107\n   Compiling unicode-ident v1.0.26\n   Compiling serde_core v1.0.229\n   Compiling quote v1.0.47\n   Compiling zmij v1.0.23\n   Compiling libc v0.2.189\n   Compiling hashbrown v0.17.1\n   Compiling equivalent v1.0.2\n   Compiling serde v1.0.229\n   Compiling serde_json v1.0.151\n   Compiling memchr v2.8.3\n   Compiling itoa v1.0.18\n   Compiling syn v3.0.6\n   Compiling serde_derive v1.0.229\n   Compiling indexmap v2.14.2\n   Compiling cursor-delegate-mcp v0.5.0 (/Users/user/work/delegate-11-models-doctor)\n    Finished `dev` profile [unoptimized + debuginfo] target(s) in 4.86s\n","truncated":false,"exit_code":0,"wall_time_seconds":5}},"isError":false}
{"type":"message_start","message":{"role":"toolResult","toolCallId":"call_01a0f6bfd0147049aeaa35209fa54d07|fc_01a0f6bfd0147049aeaa35209fa54d07","toolName":"bash","content":[{"type":"text","text":"tests/fixtures/claude/review-18.stdout:15:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HGCobLa7Nx9QjMUKTdjMFz\",\"type\":\"tool_result\",\"content\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"ea4f5f94-4a7a-4d19-b942-97adc57b4168\",\"timestamp\":\"2026-10-01T08:27:01.239Z\",\"tool_use_result\":{\"stdout\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ntests/fixtures/claude/review-18.stdout:29:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":\"Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\",\"is_error\":true,\"tool_use_id\":\"toolu_019cExtXuYqSGwSxpUdYaKTt\"}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"797cfe15-0894-4fe8-8311-9be1f92b1294\",\"timestamp\":\"2026-10-01T08:27:17.686Z\",\"tool_use_result\":\"Error: Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\"}\n=== build ===\n   Compiling proc-macro2 v1.0.107\n   Compiling unicode-ident v1.0.26\n   Compiling serde_core v1.0.229\n   Compiling quote v1.0.47\n   Compiling zmij v1.0.23\n   Compiling libc v0.2.189\n   Compiling hashbrown v0.17.1\n   Compiling equivalent v1.0.2\n   Compiling serde v1.0.229\n   Compiling serde_json v1.0.151\n   Compiling memchr v2.8.3\n   Compiling itoa v1.0.18\n   Compiling syn v3.0.6\n   Compiling serde_derive v1.0.229\n   Compiling indexmap v2.14.2\n   Compiling cursor-delegate-mcp v0.5.0 (/Users/user/work/delegate-11-models-doctor)\n    Finished `dev` profile [unoptimized + debuginfo] target(s) in 4.86s\n\n[Showing lines 15-34 of 34 (50.0KB limit). Full output: /var/folders/dq/_c83wftd34g281_1002c_gl00000gn/T/pi-bash-610b2bf631296c6b.log]"}],"details":{"truncation":{"content":"tests/fixtures/claude/review-18.stdout:15:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HGCobLa7Nx9QjMUKTdjMFz\",\"type\":\"tool_result\",\"content\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"ea4f5f94-4a7a-4d19-b942-97adc57b4168\",\"timestamp\":\"2026-10-01T08:27:01.239Z\",\"tool_use_result\":{\"stdout\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ntests/fixtures/claude/review-18.stdout:29:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":\"Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\",\"is_error\":true,\"tool_use_id\":\"toolu_019cExtXuYqSGwSxpUdYaKTt\"}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"797cfe15-0894-4fe8-8311-9be1f92b1294\",\"timestamp\":\"2026-10-01T08:27:17.686Z\",\"tool_use_result\":\"Error: Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\"}\n=== build ===\n   Compiling proc-macro2 v1.0.107\n   Compiling unicode-ident v1.0.26\n   Compiling serde_core v1.0.229\n   Compiling quote v1.0.47\n   Compiling zmij v1.0.23\n   Compiling libc v0.2.189\n   Compiling hashbrown v0.17.1\n   Compiling equivalent v1.0.2\n   Compiling serde v1.0.229\n   Compiling serde_json v1.0.151\n   Compiling memchr v2.8.3\n   Compiling itoa v1.0.18\n   Compiling syn v3.0.6\n   Compiling serde_derive v1.0.229\n   Compiling indexmap v2.14.2\n   Compiling cursor-delegate-mcp v0.5.0 (/Users/user/work/delegate-11-models-doctor)\n    Finished `dev` profile [unoptimized + debuginfo] target(s) in 4.86s","truncated":true,"truncatedBy":"bytes","totalLines":34,"totalBytes":187846,"outputLines":20,"outputBytes":48116,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":2000,"maxBytes":51200},"fullOutputPath":"/var/folders/dq/_c83wftd34g281_1002c_gl00000gn/T/pi-bash-610b2bf631296c6b.log"},"isError":false,"timestamp":1790846167445}}
{"type":"message_end","message":{"role":"toolResult","toolCallId":"call_01a0f6bfd0147049aeaa35209fa54d07|fc_01a0f6bfd0147049aeaa35209fa54d07","toolName":"bash","content":[{"type":"text","text":"tests/fixtures/claude/review-18.stdout:15:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HGCobLa7Nx9QjMUKTdjMFz\",\"type\":\"tool_result\",\"content\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"ea4f5f94-4a7a-4d19-b942-97adc57b4168\",\"timestamp\":\"2026-10-01T08:27:01.239Z\",\"tool_use_result\":{\"stdout\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ntests/fixtures/claude/review-18.stdout:29:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":\"Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\",\"is_error\":true,\"tool_use_id\":\"toolu_019cExtXuYqSGwSxpUdYaKTt\"}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"797cfe15-0894-4fe8-8311-9be1f92b1294\",\"timestamp\":\"2026-10-01T08:27:17.686Z\",\"tool_use_result\":\"Error: Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\"}\n=== build ===\n   Compiling proc-macro2 v1.0.107\n   Compiling unicode-ident v1.0.26\n   Compiling serde_core v1.0.229\n   Compiling quote v1.0.47\n   Compiling zmij v1.0.23\n   Compiling libc v0.2.189\n   Compiling hashbrown v0.17.1\n   Compiling equivalent v1.0.2\n   Compiling serde v1.0.229\n   Compiling serde_json v1.0.151\n   Compiling memchr v2.8.3\n   Compiling itoa v1.0.18\n   Compiling syn v3.0.6\n   Compiling serde_derive v1.0.229\n   Compiling indexmap v2.14.2\n   Compiling cursor-delegate-mcp v0.5.0 (/Users/user/work/delegate-11-models-doctor)\n    Finished `dev` profile [unoptimized + debuginfo] target(s) in 4.86s\n\n[Showing lines 15-34 of 34 (50.0KB limit). Full output: /var/folders/dq/_c83wftd34g281_1002c_gl00000gn/T/pi-bash-610b2bf631296c6b.log]"}],"details":{"truncation":{"content":"tests/fixtures/claude/review-18.stdout:15:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HGCobLa7Nx9QjMUKTdjMFz\",\"type\":\"tool_result\",\"content\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"ea4f5f94-4a7a-4d19-b942-97adc57b4168\",\"timestamp\":\"2026-10-01T08:27:01.239Z\",\"tool_use_result\":{\"stdout\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ntests/fixtures/claude/review-18.stdout:29:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":\"Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\",\"is_error\":true,\"tool_use_id\":\"toolu_019cExtXuYqSGwSxpUdYaKTt\"}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"797cfe15-0894-4fe8-8311-9be1f92b1294\",\"timestamp\":\"2026-10-01T08:27:17.686Z\",\"tool_use_result\":\"Error: Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\"}\n=== build ===\n   Compiling proc-macro2 v1.0.107\n   Compiling unicode-ident v1.0.26\n   Compiling serde_core v1.0.229\n   Compiling quote v1.0.47\n   Compiling zmij v1.0.23\n   Compiling libc v0.2.189\n   Compiling hashbrown v0.17.1\n   Compiling equivalent v1.0.2\n   Compiling serde v1.0.229\n   Compiling serde_json v1.0.151\n   Compiling memchr v2.8.3\n   Compiling itoa v1.0.18\n   Compiling syn v3.0.6\n   Compiling serde_derive v1.0.229\n   Compiling indexmap v2.14.2\n   Compiling cursor-delegate-mcp v0.5.0 (/Users/user/work/delegate-11-models-doctor)\n    Finished `dev` profile [unoptimized + debuginfo] target(s) in 4.86s","truncated":true,"truncatedBy":"bytes","totalLines":34,"totalBytes":187846,"outputLines":20,"outputBytes":48116,"lastLinePartial":false,"firstLineExceedsLimit":false,"maxLines":2000,"maxBytes":51200},"fullOutputPath":"/var/folders/dq/_c83wftd34g281_1002c_gl00000gn/T/pi-bash-610b2bf631296c6b.log"},"isError":false,"timestamp":1790846167445}}
{"type":"turn_end","message":{"role":"assistant","content":[{"type":"toolCall","id":"call_01a0f6bfd0147049aeaa35209fa54d07|fc_01a0f6bfd0147049aeaa35209fa54d07","name":"bash","arguments":{"command":"grep -rn \"family\\|grok-4\\.5\\|gemini\\|gpt-5\\|cursor-grok\\|claude-sonnet-4\" src/ tests/ config/ 2>/dev/null | grep -v \"docs/\\|spec.md\\|CODE-REVIEW\" | head -20; echo \"=== build ===\"; cargo build 2>&1 | tail -20","timeout":240}}],"api":"openai-responses","provider":"opencode-go","model":"muse-spark-1.3-contributor","usage":{"input":818,"output":137,"cacheRead":130033,"cacheWrite":0,"reasoning":0,"totalTokens":130988,"cost":{"input":0.00008180000000000001,"output":0.000027400000000000002,"cacheRead":0.00026006600000000004,"cacheWrite":0,"total":0.00036926600000000004}},"stopReason":"toolUse","timestamp":1790846159346,"responseId":"resp_6abe24d032ae539c72374172","rawStopReason":"completed","thinkingLevel":"high"},"toolResults":[{"role":"toolResult","toolCallId":"call_01a0f6bfd0147049aeaa35209fa54d07|fc_01a0f6bfd0147049aeaa35209fa54d07","toolName":"bash","content":[{"type":"text","text":"tests/fixtures/claude/review-18.stdout:15:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HGCobLa7Nx9QjMUKTdjMFz\",\"type\":\"tool_result\",\"content\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"ea4f5f94-4a7a-4d19-b942-97adc57b4168\",\"timestamp\":\"2026-10-01T08:27:01.239Z\",\"tool_use_result\":{\"stdout\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ntests/fixtures/claude/review-18.stdout:29:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":\"Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\",\"is_error\":true,\"tool_use_id\":\"toolu_019cExtXuYqSGwSxpUdYaKTt\"}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"797cfe15-0894-4fe8-8311-9be1f92b1294\",\"timestamp\":\"2026-10-01T08:27:17.686Z\",\"tool_use_result\":\"Error: Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\"}\n=== build ===\n   Compiling proc-macro2 v1.0.107\n   Compiling unicode-ident v1.0.26\n   Compiling serde_core v1.0.229\n   Compiling quote v1.0.47\n   Compiling zmij v1.0.23\n   Compiling libc v0.2.189\n   Compiling hashbrown v0.17.1\n   Compiling equivalent v1.0.2\n   Compiling serde v1.0.229\n   Compiling serde_json v1.0.151\n   Compiling memchr v2.8.3\n   Compiling itoa v1.0.18\n   Compiling syn v3.0.6\n   Compiling serde_derive v1.0.229\n   Compiling indexmap v2.14.2\n   Compiling cursor-delegate-mcp v0.5.0 (/Users/user/work/delegate-11-models-doctor)\n    Finished `dev` profile [unoptimized + debuginfo] target(s) in 4.86s\n\n[Showing lines 15-34 of 34 (50.0KB limit). Full output: /var/folders/dq/_c83wftd34g281_1002c_gl00000gn/T/pi-bash-610b2bf631296c6b.log]"}],"details":{"truncation":{"content":"tests/fixtures/claude/review-18.stdout:15:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HGCobLa7Nx9QjMUKTdjMFz\",\"type\":\"tool_result\",\"content\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"ea4f5f94-4a7a-4d19-b942-97adc57b4168\",\"timestamp\":\"2026-10-01T08:27:01.239Z\",\"tool_use_result\":{\"stdout\":\"title:\\ttest: recording script and redacted headless fixtures (#6)\\nstate:\\tDRAFT\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\t\\nassignees:\\t\\nreviewers:\\t\\nprojects:\\t\\nmilestone:\\t\\nnumber:\\t18\\nurl:\\thttps://github.com/user/delegate/pull/18\\nadditions:\\t1972\\ndeletions:\\t0\\nauto-merge:\\tdisabled\\n--\\nFixes #6\\n\\n- `scripts/record.sh BACKEND MODEL CAPABILITY NAME [CWD] [SESSION] < prompt` runs one prompt through cursor-agent, pi or claude with the flags spec #4 assigns. It writes `tests/fixtures/<backend>/NAME.{stdout,stderr,argv}`. `CANCEL_AFTER=N` records a run cancelled with SIGTERM.\\n- `scripts/redact.jq` strips the recording user's setup (pi system-prompt sections and extension tool schemas; Claude init lists and hook output). The home-directory name is replaced with `user`.\\n- 22 recorded runs across cursor, pi and Claude: plain answer, tool calls, resume, error, NEEDS_CONTEXT and cancelled for each backend, plus Claude plan-mode and auto-mode probes.\\n\\nProbe findings are posted on #4.\\n\\nCo-authored with Claude Code.\\ntitle:\\tRecord headless fixtures (recording script and probes)\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t0\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\tuser/delegate#17, user/delegate#16, user/delegate#8, user/delegate#7\\nnumber:\\t6\\n--\\n## Parent\\n\\n#4\\n\\n## What to build\\n\\nA small recording script that runs one delegated task through a backend's raw headless CLI and saves its stdout as a parser fixture. Input: backend (cursor, pi, claude), model, capability (read-only, read-write), working directory, optional session id to resume, prompt on stdin. It invokes the CLI with the headless flags the spec assigns to that backend and capability, tees stdout to a named fixture file, and keeps stderr beside it.\\n\\nThe script is used to drive the early tickets by hand, so their real runs become the fixtures for the backend parsers. The flags it uses are the working spec for each backend's argument builder.\\n\\nThen run the probes the spec leaves open, and record the findings in a comment on #4:\\n\\n- Does a headless Claude run in plan permission mode answer the prompt, or end by proposing a plan?\\n- How often does headless Claude auto mode refuse a tool call, and what does the refusal look like in the stream?\\n- Does `--session-id` create the session on first use, and does a second run continue it, for pi and for claude?\\n- What does each backend's stream look like for an error, and for a cancelled (SIGTERM) run?\\n\\nWeak point tested: headless behaviour of pi and Claude Code that nobody has observed yet.\\n\\n## Acceptance criteria\\n\\n- [ ] The script runs a prompt through each of cursor, pi and claude and saves stdout and stderr as fixtures.\\n- [ ] It supports resuming a session for each backend.\\n- [ ] At least one fixture per backend for: a plain answer, a run with tool calls, a resumed run, an error.\\n- [ ] Each probe question above is answered with evidence in a comment on #4, including the fallback decision for Claude read-only if plan mode misbehaves.\\n\\n## Blocked by\\n\\nNone (can start immediately).\\ntitle:\\tSpec: delegate, a multi-backend CLI replacing the cursor-delegate MCP server\\nstate:\\tOPEN\\nauthor:\\tuser (Amogh Akshintala)\\nlabels:\\tready-for-agent\\ncomments:\\t1\\nassignees:\\t\\nprojects:\\t\\nmilestone:\\t\\nissue-type:\\t\\nparent:\\t\\nsub-issues:\\t\\nsub-issues-completed:\\t\\nblocked-by:\\t\\nblocking:\\t\\nnumber:\\t4\\n--\\n## Problem Statement\\n\\ncursor-delegate lets a host agent hand work to Cursor's models, but only Cursor's, and only from hosts that load its MCP server. The models I actually use are spread across three harnesses: Cursor (Composer, Grok), pi (ChatGPT-subscription GPT models, opencode-go models) and Claude Code (Claude on the Max plan). None of them can reach the others' models.\\n\\nThe tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n\\nRunning as an MCP server adds its own costs: one resident process per host session, job state that dies with the session, a write lock that cannot see writes from another session, and per-harness registration (Claude plugin, Codex plugin manifest).\\n\\n## Solution\\n\\nReplace the `cursor-delegate` MCP server with a CLI called `delegate`, plus one skill. Any harness with a shell can call it. Every configured model is reachable from every harness, routed to one of three backends: cursor-agent, pi, or Claude Code.\\n\\n`delegate run` starts a job and returns its id immediately. Each job runs under its own detached supervisor that writes a per-job status file. Callers wait with `delegate watch` run in the background and read results from the status file. A finished job can be continued with `delegate resume`. The run surface shrinks to the parameters that real use needs.\\n\\n## User Stories\\n\\n1. As an orchestrating agent, I want to start a delegated job with one shell command, so that I can delegate from any harness that has a shell.\\n2. As an orchestrating agent, I want `delegate run` to print the job id and return at once, so that my turn is never blocked on a model.\\n3. As an orchestrating agent, I want to pass the prompt on stdin or from a file, so that long briefs need no shell quoting.\\n4. As an orchestrating agent, I want to choose a model by id, so that the backend follows from the model without a separate flag.\\n5. As an orchestrating agent, I want a default model when I omit one, so that cheap bulk work needs no extra flag.\\n6. As an orchestrating agent, I want an unknown model id rejected with the list of valid ids, so that a typo fails fast.\\n7. As an orchestrating agent, I want `read-only` and `read-write` capabilities, so that I can say whether a delegate may change files.\\n8. As an orchestrating agent, I want `read-only` to be the default, so that a forgotten flag never grants writes.\\n9. As an orchestrating agent, I want a pi model with `read-only` rejected, so that I never believe a pi run is read-only when pi cannot enforce it.\\n10. As an orchestrating agent, I want to set the delegate's working directory, so that it works in a worktree or scratch directory I prepared.\\n11. As an orchestrating agent, I want the working directory to default to where I ran the command, so that the common case needs no flag.\\n12. As an orchestrating agent, I want a second read-write job in the same directory refused with BUSY, so that two delegates never interleave edits.\\n13. As an orchestrating agent, I want that lock to hold across separate host sessions, so that two Claude sessions cannot collide in one tree.\\n14. As an orchestrating agent, I want to give a gate command the tool runs after the agent, so that I get ground-truth verification instead of the delegate's claim.\\n15. As an orchestrating agent, I want a failing gate to downgrade DONE to DONE_WITH_CONCERNS with the gate's output, so that I see what failed.\\n16. As an orchestrating agent, I want the result to include the git change-set the tool computed, so that I know what actually changed.\\n17. As an orchestrating agent, I want a concern when commits landed but the tree is still dirty, so that half-committed work is visible.\\n18. As an orchestrating agent, I want to widen the tool-call idle window for one job, so that a long build or benchmark is not killed as hung.\\n19. As an orchestrating agent, I want a job that goes silent past its idle window killed and reported, so that hung jobs end on their own.\\n20. As an orchestrating agent, I want to wait on one or many jobs with `delegate watch` in a background shell, so that my turn can end and I get one notification when they finish.\\n21. As an orchestrating agent, I want `delegate watch` to print every job's final record, so that one command both waits and delivers results.\\n22. As an orchestrating agent, I want `delegate watch` to stop at a timeout, so that a missing or never-written record cannot hang it forever.\\n23. As an orchestrating agent, I want to read a job's progress by reading its status file, so that polling needs no tool.\\n24. As an orchestrating agent, I want the status file to carry a heartbeat while running, so that I can tell a dead supervisor from a slow job.\\n25. As an orchestrating agent, I want the final status file to hold the full result (status, text, usage, cost, change-set, gate result, session), so that the file is the whole answer.\\n26. As an orchestrating agent, I want the delegate's final STATUS line to set the result status, including NEEDS_CONTEXT, so that I know when it needs me.\\n27. As an orchestrating agent, I want to resume any finished job with a follow-up prompt, so that I can answer a question or ask for fixes without re-briefing.\\n28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n29. As an orchestrating agent, I want to override capability, gate or model on resume, so that a read-only reviewer can go on to fix what it found.\\n30. As an orchestrating agent, I want a model override that crosses backends rejected, so that I never try to resume a cursor session in pi.\\n31. As an orchestrating agent, I want resume to work after the host session or machine sleep, until reboot, so that follow-ups do not depend on a live server.\\n32. As an orchestrating agent, I want resume to return a new job id, so that each run has its own record.\\n33. As an orchestrating agent, I want to cancel a job by id, so that I can stop a runaway delegate and the commands it started.\\n34. As an orchestrating agent, I want `delegate models` to list ids, labels, backends and prices, so that I can pick a model without reading config.\\n35. As a user, I want to see per-run cost, so that I know what delegation would cost at list prices.\\n36. As a user, I want cursor runs priced from the model table and pi and claude runs to report their own cost, so that no backend's pricing is reimplemented.\\n37. As a user, I want prices for every model in the model table, so that `delegate models` shows them all.\\n38. As a user, I want `delegate doctor` to check each backend's binary, version and login, so that setup problems show before a run fails.\\n39. As a user, I want doctor to check each configured model is available on its backend, so that renamed or retired models (Grok 4.6 to 4.7) show as warnings.\\n40. As a user, I want pi and Claude Code to run with my full configuration (extensions, plugins, skills, context files), so that delegates behave as they do when I run them.\\n41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n42. As a user, I want Claude Code read-write runs in auto permission mode, so that its classifier still screens tool calls.\\n43. As a user, I want Claude Code read-only runs in plan permission mode, so that they cannot edit.\\n44. As a user, I want the model list trimmed to models I use, so that the menu is short.\\n45. As a user, I want Composer 2.5, Grok 4.7 high and xhigh from cursor; muse-spark-1.3-contributor, glm-5.3-flash, deepseek-v4.1-flash from opencode-go via pi; gpt-6-astra, gpt-6-luna, gpt-6.1-sol from openai-codex via pi; and Claude Opus 5.5, Sonnet 5.5, Fable 5.1 via Claude Code.\\n46. As a user, I want the project renamed from cursor-delegate to delegate everywhere (binary, config directory, environment variable, status-file directory, skill, repo), so that the name matches what it does.\\n47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n48. As a user, I want setup to build the binary and put `delegate` on my PATH, so that every harness can call it.\\n49. As a user, I want the skill to show briefs that say \\\"do not delegate further\\\", so that a delegated Claude does not loop back through delegate.\\n50. As a user, I want my global instructions to allow local Opus 5.5 and Sonnet 5.5 subagents and route other delegation through `delegate`, so that the Max plan is used where it fits.\\n51. As a user, I want the skill to make the background watcher the waiting path, so that agents stop holding turns open.\\n52. As a user, I want the skill rewritten for the new surface (catalog, model picks, resume, gates, watcher), so that it stays the single source of usage guidance.\\n53. As a maintainer, I want each backend to own its argument building, capability mapping, output parsing, resume method and doctor checks, so that adding a harness touches one place.\\n54. As a maintainer, I want parsers tested against output recorded from real headless runs, so that a CLI upgrade that changes its stream breaks a test.\\n55. As a maintainer, I want opt-in live tests per backend that also record fresh fixtures, so that fixtures stay current.\\n56. As a maintainer, I want latency budgets on every command, so that performance regressions fail tests.\\n57. As a maintainer, I want a memory budget on the per-job supervisor, so that a job's footprint stays small.\\n58. As a maintainer, I want CI on Linux running format, lint and tests, so that breakage on my other platform is caught; macOS runs locally.\\n59. As a maintainer, I want dead docs (old reproduction spec, July/August plans and specs, code review notes) and the parity snapshot removed, so that the repo describes only what exists.\\n\\n## Implementation Decisions\\n\\n**Surface.** The MCP server is removed. The CLI is:\\n\\n```\\ndelegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\ndelegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\ndelegate cancel <jobId>\\ndelegate watch  <jobId>... [--timeout S]\\ndelegate doctor\\ndelegate models\\n```\\n\\nRemoved with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n\\n**Job model.** `run` validates input, writes the initial status record, spawns a detached supervisor (own session and process group, stdio redirected), prints the job id and exits. The supervisor runs the backend child, the idle watchdog, the gate and the git change-set, and writes the status record at start, on a heartbeat while running, and at the terminal transition. The status record is the source of truth for every command after `run`; there is no in-memory registry.\\n\\n**Status record.** One JSON file per job in `$TMPDIR/delegate-jobs/`. While running: status, heartbeat timestamp, progress snapshot, supervisor pid. When terminal: status and the full result. It also stores what resume needs: backend session id, model, cwd, capability, gate, tool-idle window. Records live until reboot and are not cleaned up.\\n\\n**Write lock.** A lock file per resolved `cwd`, held by the supervisor of a read-write job. A second read-write `run` or `resume` in the same `cwd` returns BUSY with the holder's job id. Works across host sessions.\\n\\n**Resume.** Reads the job's status record, applies overrides, rejects a model override on a different backend, and starts a new job continuing the backend session. Works on any terminal status.\\n\\n**Cancel.** Reads the supervisor pid from the record and signals its process group; the record ends CANCELLED.\\n\\n**Watch.** Blocks until every named record is terminal or the timeout passes, then prints each record. No external dependencies.\\n\\n**Backends.** Selected by a `backend` field on each model in the model table. Each backend provides: binary resolution, argument building from (model, capability, cwd, session), a stream parser that yields the existing progress snapshot and a normalized result (text, session id, usage, optional reported cost, error), a resume method, and doctor checks.\\nscripts/record.sh\\nscripts/redact.jq\\ntests/fixtures/claude/auto-fix.argv\\ntests/fixtures/claude/auto-fix.stderr\\ntests/fixtures/claude/auto-fix.stdout\\ntests/fixtures/claude/auto-refusal-exfil.argv\\ntests/fixtures/claude/auto-refusal-exfil.stderr\\ntests/fixtures/claude/auto-refusal-exfil.stdout\\ntests/fixtures/claude/auto-refusal.argv\\ntests/fixtures/claude/auto-refusal.stderr\\ntests/fixtures/claude/auto-refusal.stdout\\ntests/fixtures/claude/cancelled.argv\\ntests/fixtures/claude/cancelled.stderr\\ntests/fixtures/claude/cancelled.stdout\\ntests/fixtures/claude/error-bad-model.argv\\ntests/fixtures/claude/error-bad-model.stderr\\ntests/fixtures/claude/error-bad-model.stdout\\ntests/fixtures/claude/needs-context.argv\\ntests/fixtures/claude/needs-context.stderr\\ntests/fixtures/claude/needs-context.stdout\\ntests/fixtures/claude/plan-edit-request.argv\\ntests/fixtures/claude/plan-edit-request.stderr\\ntests/fixtures/claude/plan-edit-request.stdout\\ntests/fixtures/claude/plan-plain-answer.argv\\ntests/fixtures/claude/plan-plain-answer.stderr\\ntests/fixtures/claude/plan-plain-answer.stdout\\ntests/fixtures/claude/plan-review.argv\\ntests/fixtures/claude/plan-review.stderr\\ntests/fixtures/claude/plan-review.stdout\\ntests/fixtures/claude/resume-answer.argv\\ntests/fixtures/claude/resume-answer.stderr\\ntests/fixtures/claude/resume-answer.stdout\\ntests/fixtures/claude/review-19.argv\\ntests/fixtures/claude/review-19.stderr\\ntests/fixtures/claude/review-19.stdout\\ntests/fixtures/cursor/cancelled.argv\\ntests/fixtures/cursor/cancelled.stderr\\ntests/fixtures/cursor/cancelled.stdout\\ntests/fixtures/cursor/error-bad-model.argv\\ntests/fixtures/cursor/error-bad-model.stderr\\ntests/fixtures/cursor/error-bad-model.stdout\\ntests/fixtures/cursor/lane-8-ci-repair.argv\\ntests/fixtures/cursor/lane-8-ci-repair.stderr\\ntests/fixtures/cursor/lane-8-ci-repair.stdout\\ntests/fixtures/cursor/lane-8-ci.argv\\ntests/fixtures/cursor/lane-8-ci.stderr\\ntests/fixtures/cursor/lane-8-ci.stdout\\ntests/fixtures/cursor/needs-context.argv\\ntests/fixtures/cursor/needs-context.stderr\\ntests/fixtures/cursor/needs-context.stdout\\ntests/fixtures/cursor/plain-answer.argv\\ntests/fixtures/cursor/plain-answer.stderr\\ntests/fixtures/cursor/plain-answer.stdout\\ntests/fixtures/cursor/ponytail-19.argv\\ntests/fixtures/cursor/ponytail-19.stderr\\ntests/fixtures/cursor/ponytail-19.stdout\\ntests/fixtures/cursor/preflight-7.argv\\ntests/fixtures/cursor/preflight-7.stderr\\ntests/fixtures/cursor/preflight-7.stdout\\ntests/fixtures/cursor/resume-answer.argv\\ntests/fixtures/cursor/resume-answer.stderr\\ntests/fixtures/cursor/resume-answer.stdout\\ntests/fixtures/cursor/tool-calls-fix.argv\\ntests/fixtures/cursor/tool-calls-fix.stderr\\ntests/fixtures/cursor/tool-calls-fix.stdout\\ntests/fixtures/pi/cancelled.argv\\ntests/fixtures/pi/cancelled.stderr\\ntests/fixtures/pi/cancelled.stdout\\ntests/fixtures/pi/error-bad-model.argv\\ntests/fixtures/pi/error-bad-model.stderr\\ntests/fixtures/pi/error-bad-model.stdout\\ntests/fixtures/pi/needs-context.argv\\ntests/fixtures/pi/needs-context.stderr\\ntests/fixtures/pi/needs-context.stdout\\ntests/fixtures/pi/plain-answer.argv\\ntests/fixtures/pi/plain-answer.stderr\\ntests/fixtures/pi/plain-answer.stdout\\ntests/fixtures/pi/resume-answer.argv\\ntests/fixtures/pi/resume-answer.stderr\\ntests/fixtures/pi/resume-answer.stdout\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\ntests/fixtures/claude/review-18.stdout:29:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool_result\",\"content\":\"Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config location by setup, so that my settings survive the rename.\\n98:delegate run    --model M [--capability read-only|read-write] [--cwd D] [--gate CMD] [--tool-idle-ms N] [--prompt-file F | stdin]\\n99:delegate resume <jobId> [--model M] [--capability C] [--gate CMD] [--prompt-file F | stdin]\\n106:Removed with no replacement: `cursor_poll`, `cursor_wait`, `cursor_wait_any`, `cursor_wait_all`, `cursor_answer`; parameters `waitMs`, `background`, `session`, `isolation`, `verifyCommands`, `allowPartialCommit`, `idleMs`, `requireNonClaude`, `allowUnsandboxed`; capabilities `plan` and `write-unsandboxed`; host-profile fields `promptPreamble`, `verifyCommands`, `requiredDeny`, `deadlineMs`; the deny-list check; BackendProvided worktrees; MCP progress notifications; the `family` model field; the doctor plugin-registration and legacy-name checks.\\n122:- **cursor**: `cursor-agent --print --output-format stream-json --trust --approve-mcps --force`. read-only is ask mode; read-write is `--sandbox disabled`. Resume by the session id from the result line. Cost from the model table.\\n123:- **pi**: `pi -p --mode json --model provider/id`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume reuses it. read-only is rejected. Cost is pi's own reported cost.\\n124:- **claude**: `claude -p --output-format stream-json --verbose --model ...`, full user configuration loaded. Session id chosen before launch with `--session-id`; resume with `--resume`. read-only is `--permission-mode plan`; read-write is `--permission-mode auto`. Cost is the result line's `total_cost_usd`. The stream closely matches cursor's, so the parser should share most of cursor's.\\n130:**Doctor.** Plugin/binary version; per backend: binary found, version, login (cursor `about`, pi `auth check`, claude equivalent); per model: available on its backend (cursor `--list-models`, pi `auth check --model`). Missing models are warnings.\\n153:- Sandboxing any backend, or a seatbelt wrapper for pi.\\ncursor/lane-8-ci-repair.stdout\\ncursor/ponytail-19.stdout\\ncursor/lane-8-ci-repair.argv\\ncursor/preflight-7.stdout\\ncursor/preflight-7.argv\\ncursor/ponytail-19.argv\\ncursor/ponytail-18.argv\\ncursor/lane-8-ci.stdout\\ncursor/ponytail-18.stdout\\nclaude/review-19.stdout\\n  35 /Users/user\\n 186 /Users/user\\nclaude/review-18.stdout\\n1.7M\\t.\\n  431970 cursor/ponytail-18.stdout\\n  175819 cursor/preflight-7.stdout\\n  174974 pi/cancelled.stdout\\n  782763 total\",\"is_error\":true,\"tool_use_id\":\"toolu_019cExtXuYqSGwSxpUdYaKTt\"}]},\"parent_tool_use_id\":null,\"session_id\":\"3dfd18ba-a3ed-4a44-bd90-c4ca03e8efdd\",\"uuid\":\"797cfe15-0894-4fe8-8311-9be1f92b1294\",\"timestamp\":\"2026-10-01T08:27:17.686Z\",\"tool_use_result\":\"Error: Exit code 1\\n21:The tool has also grown more surface than it uses. Across 413 real `cursor_run` calls, every one ran in the background, `plan` capability was never used, `allowPartialCommit` and `idleMs` were never set, `cursor_wait_any` ran twice, and several parameters (`verifyCommands`, `promptPreamble`, `requireNonClaude`, the `allowUnsandboxed` second signal) only add prompt text or guard against cases that never happen. Eight MCP tools and fourteen run parameters cost schema tokens in every session and make the skill long.\\n60:28. As an orchestrating agent, I want resume to reuse the job's model, directory, capability and gate, so that I cannot forget a setting on the follow-up.\\n73:41. As a user, I want cursor read-write runs unsandboxed, so that delegates can clone, push and open PRs.\\n79:47. As a user, I want my existing host profile moved to the new config loca