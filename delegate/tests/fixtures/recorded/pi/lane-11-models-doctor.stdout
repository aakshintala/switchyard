to(),\ndoctor_tests.rs:130:             family: \"other\".into(),\nmodels.rs:16: pub struct NonClaudeViolationError {\nmodels.rs:20: impl std::fmt::Display for NonClaudeViolationError {\nmodels.rs:25: impl std::error::Error for NonClaudeViolationError {}\nmodels.rs:29:     require_non_claude: bool,\nmodels.rs:40:     if require_non_claude && entry.family == \"claude\" {\nmodels.rs:41:         return Err(Box::new(NonClaudeViolationError {\nmodels.rs:42:             message: format!(\"requireNonClaude is set but model \\\"{model}\\\" has family \\\"claude\\\"\"),\nmodels.rs:47:         family: entry.family.clone(),\nmodels.rs:101:                 family: \"composer\".into(),\nmodels.rs:109:                 family: \"grok\".into(),\nmodels.rs:117:                 family: \"claude\".into(),\nmodels.rs:129:         assert_eq!(r.family, \"composer\");\nmodels.rs:134:     fn allowed_id_resolves_with_family_and_price() {\nmodels.rs:138:         assert_eq!(r.family, \"grok\");\nmodels.rs:150:     fn require_non_claude_rejects_explicit_claude() {\nmodels.rs:153:         assert!(e.downcast_ref::<NonClaudeViolationError>().is_some());\nmodels.rs:157:     fn require_non_claude_rejects_claude_default() {\nmodels.rs:160:         assert!(e.downcast_ref::<NonClaudeViolationError>().is_some());\nmodels.rs:164:     fn require_non_claude_passes_non_claude() {\nmodels.rs:168:         assert_eq!(r.family, \"grok\");\nmodels.rs:172:     fn require_non_claude_false_allows_claude() {\nmodels.rs:176:         assert_eq!(r.family, \"claude\");\nrunner.rs:60:         input.require_non_claude.unwrap_or(false),\nrunner.rs:125:         require_non_claude: None,\nrunner.rs:133:     if input.require_non_claude.is_some() {\nrunner.rs:134:         resume_context.require_non_claude = input.require_non_claude;\nrunner.rs:198:                     require_non_claude: resume_context.require_non_claude,\ntool_schemas.rs:38:             \"requireNonClaude\": {\ntool_schemas.rs:40:                 \"descripti