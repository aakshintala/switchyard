price_map[\"openai-codex/gpt-6-luna\"].output, 0.5);\n        assert_eq!(\n            cfg.profile.required_deny.as_ref().unwrap(),\n            &[\"rm -rf /\".to_string()]\n        );\n        assert_eq!(cfg.profile.deadline_ms, Some(5000.0));\n    }\n\n    #[test]\n    fn missing_host_profile_is_empty() {\n        let mut files = HashMap::new();\n        files.insert(\"/models.json\".into(), MODELS_DEFAULT.into());\n        let cfg = load_config(LoadConfigOpts {\n            models_path: \"/models.json\".into(),\n\n[117 more lines in file. Use offset=430 to continue.]"}],"isError":false,"timestamp":1790846234397},{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"{\"id\":\"rs_6abe251cc262c025f1474cbb:rs_01a0f6c0f581754a9fc9978fabca727a\",\"type\":\"reasoning\",\"status\":\"completed\",\"encrypted_content\":\"Q-PaDgFePYFTfgu97npAqIfMzfSYXxQhdFFEVIj19471TvGoD-1e2vXFN0VviATMVewbti_awHrkdF7KxIHNfSNHoaMignkkRM41JGj28M3mHpxoDjfHxWqVfrkJYmw-dLjt4kN0Z1rayrxmvORArVHpUSkgwBFc-XkaxtA3IbLTsxoPzaeH_OEGNs_4_YUYGghTqXoRWeErxx5LVJeUfnjhuv5-hsr1u-guJBcrEajtdCl4UeWUpTs4t-VSS0r9US1_1sitAT2Org54OKK6Y6mLr9Drr1CGigwozvX7CRlCiU0QeOWETdEQng9geF0nx6IAp2ZTcLjpb7C4xNAYUpt7TzSqSzocCmT0i6CbK8wvJQcQb3rZGme1FaMDKIKTPKQX7nNdSPqmD2dXlBbke9THyYBigkr4g8KFxXvPEncjl46txFRg92B-NgvP9H92SZD3-WG9EOaJEsB8-WyVjR6_arTugHJACjvBBfMlI_gE-303G6jTlDBZHJ4k0fzNq8qAW-Y-Zg7ueO4KGNUFoPTZJayCAqE6g705W9cj6UzZsSqmJHynFZrXp4iA-wDKKYTamWV0Y04dmP-MAkcn6obVJG-FNYK8LUJVevAxSarbRRb5DTkFPm_R889TEqrqjcWR11VMa7OijFfkvJqaK3-D-soedGLDhcatZrWpBBtz_3ZsFJ-W_PN1AK05iQh7mms9ptckjPBwm9a9ZpNIujhiplf5AGGsquIz3yOBfdz3A0fDSHPqZbsUT1iY2YD1zyIwyvHgvSEkWFXyyC1AlnNw__TZwES-qa3oByXh_vExIPiMS5PTdFwzdkfzyIcEH0wIIrbz05kl1vS82Uw2BTeiRD9zIw_C1Uk1Ly1tTz9OZerD4_DvvQJoaQwloUE5xJNAtTaBcAEQgSVkH0AzRpn54Esbmk5ykI6EUFM7aVO_vFsHVnLeCjegTJ5HGUPcHBijv_lZipgdqFZjxmuW4gQNR2Dj00d4oIXl6oISAkPsCLBUhyF60sFsh1YKvZlj8hwn-i4e_FyvRv_9vLCP5d8YARVO0n2wsJrCO_mUMM8vt0tPsIE-FRCm97Q3UHQ9LyUscviZxs41rVQmzUSVgls2JhdDQtMxAdD345t9dvRkRfXppWOgRC0O