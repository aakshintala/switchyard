#!/usr/bin/env bash
# plan-sweep: write one read-once context pack per ticket: symbol sites, outlines,
# doc sections and the paths outside a plan's Files.
# Usage: plan-sweep --cwd DIR --base REV (--plan FILE | --symbols LIST [--files LIST] | --files LIST)
#                   [--docs FILE#HEADING] [--lang rust] [--max-bytes N] --out FILE
#        DIR is a git clone of the repo, REV the base commit, LIST a comma list.
#        In --plan mode the tokens in `## Files`, `## Interfaces` and `## Tasks`
#        resolve by plan-check's rules (`--plan` reuses its new/removed
#        exemptions); in `--symbols`/`--files` mode every token that resolves to
#        nothing exits 1, with no exemptions. `--docs` prints a section verbatim
#        from `git show REV:FILE`. Reads never touch the worktree.
#        Per symbol at REV (`git grep -n -w`): definition sites; callers grouped
#        by file (at most 40 lines per symbol, with the total count); `pub use`
#        re-exports; `<Name>::` sites grouped by file (`--lang rust`, only for a
#        name with an `enum` definition); test files and `*.snap` files naming it.
#        The sweep runs one full-tree `git grep` pass over all names (a second
#        `<Name>::` pass only for `--lang rust` with an `enum` name), however
#        many symbols the plan holds. Progress prints on stderr only: one
#        `resolving N symbols` line, then one `symbol I/M NAME` line per section.
#        Per file: an outline of `fn`, `struct`, `enum`, `impl`, `mod` and
#        `#[path]` lines with line numbers, never a body. Outside Files lists
#        every path a Symbol section names that the Files do not cover, one per
#        line, with reasons in the order definition,caller,re-export,match,pin.
#        Doc files and outlined files are never listed there.
#        Over the `--max-bytes` cap (default 122880) the pack is rebuilt in
#        compact form: the header, every per-symbol head, the full Outside Files
#        list and a `## Cut` section saying what was cut. Outside Files is never
#        cut. Exit 0 writes the pack and prints one PACK line; 1 lists each
#        unresolved token and writes nothing; 2 is a usage error.
#        The token reader, path resolver and Files cover rules live in
#        lib/plan-tokens.sh, sourced below.
set -euo pipefail

lib="$(cd "$(dirname "$0")" && pwd)/lib/plan-tokens.sh"
if [ ! -r "$lib" ]; then
  echo "plan-sweep: cannot read shared lib: $lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$lib"

usage() {
  echo "usage: plan-sweep --cwd DIR --base REV (--plan FILE | --symbols LIST [--files LIST] | --files LIST) [--docs FILE#HEADING] [--lang rust] [--max-bytes N] --out FILE" >&2
  exit 2
}

# trim S: drop leading and trailing spaces and tabs
trim() {
  local s="$1"
  s="${s#"${s%%[![:blank:]]*}"}"
  s="${s%"${s##*[![:blank:]]}"}"
  printf '%s' "$s"
}

# nlines FILE: the number of lines in FILE
nlines() {
  local n
  n="$(wc -l <"$1")"
  n="${n//[[:space:]]/}"
  printf '%s' "${n:-0}"
}

UNRESOLVED=""
SEEN_UNRESOLVED="|"

# add_unresolved KIND VALUE SUFFIX: one `unresolved ...` line, once per token
add_unresolved() {
  local key="$1:$2"
  case "$SEEN_UNRESOLVED" in *"|$key|"*) return 0 ;; esac
  SEEN_UNRESOLVED="$SEEN_UNRESOLVED$key|"
  UNRESOLVED="${UNRESOLVED}unresolved $1: $2$3"$'\n'
}

SYMS=""
SEEN_SYMS="|"

# add_symbol NAME TITLE: one symbol section per grep name, first title wins
add_symbol() {
  case "$SEEN_SYMS" in *"|$1|"*) return 0 ;; esac
  SEEN_SYMS="$SEEN_SYMS$1|"
  SYMS="$SYMS$1"$'\t'"$2"$'\n'
}

# strip_quals LINE: trim, then drop leading pub, pub(...), async, unsafe, extern words
strip_quals() {
  local c="$1" rest
  c="${c#"${c%%[![:blank:]]*}"}"
  while :; do
    case "$c" in
      pub" "*|pub"	"*) c="${c#pub}" ;;
      pub\(*)
        rest="${c#pub\(}"
        case "$rest" in *\)*) rest="${rest#*\)}" ;; *) break ;; esac
        c="$rest" ;;
      async" "*|async"	"*|unsafe" "*|unsafe"	"*|extern" "*|extern"	"*) c="${c#*[[:blank:]]}" ;;
      *) break ;;
    esac
    c="${c#"${c%%[![:blank:]]*}"}"
  done
  printf '%s' "$c"
}

# is_reexport LINE: the code starts with `pub use` or `pub(...) use`
is_reexport() {
  local c="$1" rest
  c="${c#"${c%%[![:blank:]]*}"}"
  case "$c" in
    "pub use"*)
      rest="${c#pub use}"
      case "$rest" in ""|[[:blank:]]*) return 0 ;; esac
      return 1 ;;
    pub\(*)
      rest="${c#pub\(}"
      case "$rest" in *\)*) rest="${rest#*\)}" ;; *) return 1 ;; esac
      rest="${rest#"${rest%%[![:blank:]]*}"}"
      case "$rest" in use|use[[:blank:]]*) return 0 ;; esac
      return 1 ;;
  esac
  return 1
}

# def_keyword LINE NAME: print the declaring keyword when LINE declares NAME, else nothing
def_keyword() {
  local c="$1" name="$2" first rest decl
  c="$(strip_quals "$c")"
  case "$c" in [A-Za-z_]*) ;; *) return 0 ;; esac
  first="${c%%[^A-Za-z0-9_]*}"
  case "$first" in fn|struct|enum|trait|type|const|mod) ;; *) return 0 ;; esac
  rest="${c#$first}"
  rest="${rest#"${rest%%[![:blank:]]*}"}"
  if [ "$first" = const ]; then
    case "$rest" in fn[[:blank:]]*|fn) rest="${rest#fn}"; rest="${rest#"${rest%%[![:blank:]]*}"}" ;; esac
  fi
  decl="${rest%%[^A-Za-z0-9_]*}"
  [ -n "$decl" ] || return 0
  [ "$decl" = "$name" ] || return 0
  printf '%s' "$first"
}

# is_pin PATH: print the pin kind (snap or test) when PATH is a pin file, else nothing
is_pin() {
  local p="$1" b
  case "$p" in *.snap) printf 'snap'; return 0 ;; esac
  case "/$p/" in */test/*|*/tests/*) printf 'test'; return 0 ;; esac
  b="${p##*/}"
  case "$b" in test_*|*_test.*) printf 'test'; return 0 ;; esac
  return 0
}

# outline_lines PATH: outline lines with numbers for the blob at REV:PATH
outline_lines() {
  git -C "$dir" show "$rev:$1" | awk '
    {
      line = $0
      c = line; sub(/^[[:blank:]]+/, "", c)
      if (c ~ /^#\[path/) { printf "%d: %s\n", NR, line; next }
      do {
        n = c
        sub(/^pub\([^)]*\)[[:blank:]]+/, "", c)
        sub(/^pub[[:blank:]]+/, "", c)
        sub(/^(async|unsafe|extern)[[:blank:]]+/, "", c)
      } while (c != n)
      if (c ~ /^(fn|struct|enum|impl|mod)([^A-Za-z0-9_]|$)/) printf "%d: %s\n", NR, line
    }'
}

# doc_section FILE HEADING: print the section verbatim; exit 1 when it misses
doc_section() {
  git -C "$dir" show "$rev:$1" 2>/dev/null | awk -v h="$2" '
    /^[[:space:]]*```/ { if (insec) print; infence = !infence; next }
    infence { if (insec) print; next }
    /^#+[[:blank:]]/ {
      text = $0; sub(/^#+/, "", text); sub(/^[[:blank:]]/, "", text); sub(/[[:blank:]]+$/, "", text)
      lvl = 0; tmp = $0
      while (substr(tmp, lvl + 1, 1) == "#") lvl++
      if (!insec) {
        if (text == h) { insec = 1; mylvl = lvl; print }
        next
      }
      if (lvl <= mylvl) exit 0
      print; next
    }
    { if (insec) print }
    END { exit (insec ? 0 : 1) }'
}

plan=""
symbols=""
files=""
docs=""
lang=""
maxbytes="122880"
out=""
plan_given=0
symbols_given=0
files_given=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    --cwd) [ $# -ge 2 ] && [ -n "$2" ] || usage; dir="$2"; shift 2 ;;
    --base) [ $# -ge 2 ] && [ -n "$2" ] || usage; rev="$2"; shift 2 ;;
    --plan) [ $# -ge 2 ] && [ -n "$2" ] || usage; plan="$2"; plan_given=1; shift 2 ;;
    --symbols) [ $# -ge 2 ] && [ -n "$2" ] || usage; symbols="$2"; symbols_given=1; shift 2 ;;
    --files) [ $# -ge 2 ] && [ -n "$2" ] || usage; files="$2"; files_given=1; shift 2 ;;
    --docs) [ $# -ge 2 ] && [ -n "$2" ] || usage; docs="$docs$2"$'\n'; shift 2 ;;
    --lang) [ $# -ge 2 ] && [ -n "$2" ] || usage; lang="$2"; shift 2 ;;
    --max-bytes) [ $# -ge 2 ] && [ -n "$2" ] || usage; maxbytes="$2"; shift 2 ;;
    --out) [ $# -ge 2 ] && [ -n "$2" ] || usage; out="$2"; shift 2 ;;
    -*) usage ;;
    *) usage ;;
  esac
done
[ -n "${dir:-}" ] || usage
[ -n "${rev:-}" ] || usage
[ -n "$out" ] || usage
case "$out" in /*) ;; *) usage ;; esac
if [ "$plan_given" = 1 ]; then
  { [ "$symbols_given" = 0 ] && [ "$files_given" = 0 ]; } || usage
else
  { [ "$symbols_given" = 1 ] || [ "$files_given" = 1 ]; } || usage
fi
case "$lang" in ""|rust) ;; *) usage ;; esac
case "$maxbytes" in ''|*[!0-9]*) usage ;; esac
if [ "$maxbytes" -le 0 ]; then usage; fi
if [ "$plan_given" = 1 ] && [ ! -r "$plan" ]; then usage; fi
if ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then usage; fi
if ! git -C "$dir" rev-parse -q --verify "$rev^{commit}" >/dev/null 2>&1; then usage; fi

fullsha="$(git -C "$dir" rev-parse --verify "$rev^{commit}")"
tree="$(git -C "$dir" ls-tree -r --name-only "$rev")"
TOPLIST="|$(git -C "$dir" ls-tree --name-only "$rev" | tr '\n' '|')"
FILES="|"
GLOBS=""
AMBIG=""

work="$(mktemp -d "${TMPDIR:-/tmp}/plan-sweep.XXXXXX")"
tmpfile=""
cleanup() {
  [ -n "$tmpfile" ] && rm -f "$tmpfile"
  rm -rf "$work"
  return 0
}
trap cleanup EXIT

# note_candidate NAME: record a candidate last-component name for the one
# batched resolution pass. Names are deduplicated when the pattern file is built.
note_candidate() {
  printf '%s\n' "$1" >>"$work/cand-all"
}

# strip_port TOKEN: drop a trailing :port suffix per plan-check's rule
strip_port() {
  local t="$1"
  if [[ $t =~ $portre ]]; then t="${t%"${BASH_REMATCH[0]}"}"; fi
  printf '%s' "$t"
}

# bare_last TOKEN: print the candidate last name for a port-stripped bare
# Interfaces token, or nothing when it has no symbol shape
bare_last() {
  local t="$1" s last
  case "$t" in
    *"<"*|*">"*|*" "*|*"*"*|*"{"*|*"}"*) return 0 ;;
    /|.|..) return 0 ;;
  esac
  case "$t" in .*) case "$t" in */*) ;; *) return 0 ;; esac ;; esac
  if is_path "$t"; then return 0; fi
  s="$t"
  case "$s" in *"()") s="${s%??}" ;; esac
  last="${s##*::}"
  [ -n "$last" ] || return 0
  printf '%s\n' "$last"
  return 0
}

# resolved_lookup NAME: true when NAME has at least one attributed hit in the
# batched pass. Never runs git.
resolved_lookup() {
  grep -qxF -- "$1" "$work/resolved" 2>/dev/null
}

# pat_idx NAME: the 1-based line number of NAME in the pattern file
pat_idx() {
  grep -nxF -- "$1" "$work/patterns" 2>/dev/null | cut -d: -f1 | head -n 1
}

# split_word_hits PATFILE HITS OUTDIR: attribute each hit line to every name
# with a whole-word occurrence (a non-word character or a string edge on both
# sides; a failed occurrence does not stop the search for a later one), writing
# `idx<TAB>hit` rows, then sorting by idx into one file per name in git's order.
split_word_hits() {
  PATFILE="$1" OUTDIR="$3" REV="$rev" LC_ALL=C awk '
    BEGIN {
      n = 0
      while ((getline line < ENVIRON["PATFILE"]) > 0) { names[++n] = line }
    }
    {
      hit = $0
      rest = substr(hit, length(ENVIRON["REV"]) + 2)
      c = index(rest, ":")
      tail = substr(rest, c + 1)
      c = index(tail, ":")
      text = substr(tail, c + 1)
      for (i = 1; i <= n; i++) {
        name = names[i]
        if (word_hit(text, name)) printf "%d\t%s\n", i, hit
      }
    }
    function isword(c) {
      return (c >= "A" && c <= "Z") || (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || c == "_"
    }
    function word_hit(text, name,   nl, rest2, pos, before, after) {
      nl = length(name)
      if (nl == 0) return 0
      rest2 = text
      while ((pos = index(rest2, name)) > 0) {
        if (pos == 1) before = ""
        else before = substr(rest2, pos - 1, 1)
        after = substr(rest2, pos + nl, 1)
        if ((before == "" || !isword(before)) && (after == "" || !isword(after))) return 1
        rest2 = substr(rest2, pos + 1)
      }
      return 0
    }' "$2" >"$work/batch-idx"
  LC_ALL=C sort -s -n -k1,1 "$work/batch-idx" >"$work/batch-sorted"
  OUTDIR="$3" LC_ALL=C awk '
    {
      line = $0
      t = index(line, "\t")
      idx = substr(line, 1, t - 1)
      rest = substr(line, t + 1)
      if (idx != prev) {
        if (prev != "") close(out)
        out = ENVIRON["OUTDIR"] "/" idx
        prev = idx
      }
      print rest > out
    }' "$work/batch-sorted"
}

# split_qual_hits PATFILE HITS OUTDIR: attribute each hit line to every
# `Name::` pattern whose first occurrence has a non-identifier character or a
# line start before it. Later occurrences are never retried.
split_qual_hits() {
  PATFILE="$1" OUTDIR="$3" REV="$rev" LC_ALL=C awk '
    BEGIN {
      n = 0
      while ((getline line < ENVIRON["PATFILE"]) > 0) { names[++n] = line }
    }
    {
      hit = $0
      rest = substr(hit, length(ENVIRON["REV"]) + 2)
      c = index(rest, ":")
      tail = substr(rest, c + 1)
      c = index(tail, ":")
      text = substr(tail, c + 1)
      for (i = 1; i <= n; i++) {
        name = names[i]
        if (qual_hit(text, name)) printf "%d\t%s\n", i, hit
      }
    }
    function isword(c) {
      return (c >= "A" && c <= "Z") || (c >= "a" && c <= "z") || (c >= "0" && c <= "9") || c == "_"
    }
    function qual_hit(text, pat,   pos, pre) {
      if (length(pat) == 0) return 0
      pos = index(text, pat)
      if (pos == 0) return 0
      if (pos == 1) return 1
      pre = substr(text, pos - 1, 1)
      if (isword(pre)) return 0
      return 1
    }' "$2" >"$work/batch-idx"
  LC_ALL=C sort -s -n -k1,1 "$work/batch-idx" >"$work/batch-sorted"
  OUTDIR="$3" LC_ALL=C awk '
    {
      line = $0
      t = index(line, "\t")
      idx = substr(line, 1, t - 1)
      rest = substr(line, t + 1)
      if (idx != prev) {
        if (prev != "") close(out)
        out = ENVIRON["OUTDIR"] "/" idx
        prev = idx
      }
      print rest > out
    }' "$work/batch-sorted"
}

# batch_hits PATFILE OUTDIR MODE: one full-tree `git grep -n -I -F -f` over
# every name in PATFILE (MODE word adds -w; MODE qual does not), then one file
# OUTDIR/N per pattern-file line holding git's hit lines for that name in
# git's order. A failing grep leaves empty hit files, so every name then reads
# unresolved. Never called with an empty PATFILE.
batch_hits() {
  local pat="$1" outdir="$2" mode="$3" total i
  mkdir -p "$outdir"
  total="$(nlines "$pat")"
  i=1
  while [ "$i" -le "$total" ]; do
    : >"$outdir/$i"
    i=$((i + 1))
  done
  if [ "$mode" = word ]; then
    git -C "$dir" grep -n -I -F -w -f "$pat" "$rev" >"$work/batch-word" 2>/dev/null || true
    split_word_hits "$pat" "$work/batch-word" "$outdir"
  else
    git -C "$dir" grep -n -I -F -f "$pat" "$rev" >"$work/batch-qual" 2>/dev/null || true
    split_qual_hits "$pat" "$work/batch-qual" "$outdir"
  fi
  return 0
}

# collect_plan_token KIND VALUE: the pass-1 collector for --plan mode. Records
# the candidate last-component name without running git or changing state.
collect_plan_token() {
  local kind="$1" val="$2" s last
  CALLED=1
  case "$kind" in glob) return 0 ;; esac
  case "$kind" in
    path) return 0 ;;
    symbol)
      s="$val"
      case "$s" in *"()") s="${s%??}" ;; esac
      last="${s##*::}"
      [ -n "$last" ] || return 0
      note_candidate "$last"
      return 0 ;;
  esac
  return 0
}

# collect_bare_word TOKEN: the pass-1 collector for bare Interfaces tokens.
collect_bare_word() {
  local t last
  t="$(strip_port "$1")"
  last="$(bare_last "$t")"
  [ -n "$last" ] || return 0
  note_candidate "$last"
  return 0
}

# resolve_candidates: dedupe $work/cand-all into $work/patterns, run the one
# batched word pass and write $work/resolved, one resolved name per line.
resolve_candidates() {
  local i name sym_cands
  LC_ALL=C awk '!seen[$0]++' "$work/cand-all" >"$work/patterns"
  sym_cands="$(nlines "$work/patterns")"
  : >"$work/resolved"
  if [ "$sym_cands" -gt 0 ]; then
    printf 'plan-sweep: resolving %s symbols\n' "$sym_cands" >&2
    batch_hits "$work/patterns" "$work/whits" word
    i=0
    while IFS= read -r name; do
      i=$((i + 1))
      if [ -s "$work/whits/$i" ]; then printf '%s\n' "$name" >>"$work/resolved"; fi
    done <"$work/patterns"
  fi
  return 0
}

# sweep_plan_token KIND VALUE: the expand_token callback for --plan mode.
# Files-section paths build the cover set; anything resolving to nothing that
# is not new-marked (paths) or new/example-marked (symbols) is unresolved.
# A symbol in Tasks is never reported, but a resolved one still gets a section.
# CALLED is set so the records loop can spot tokens expand_token dropped.
sweep_plan_token() {
  local kind="$1" val="$2" s last seg
  CALLED=1
  case "$kind" in glob) return 0 ;; esac
  case "$kind" in
    path)
      resolve_path "$val"
      case "$RES_KIND" in
        ambiguous) return 0 ;;
        found)
          case "$CUR_SEC" in files) FILES="$FILES$RES|" ;; esac
          return 0 ;;
      esac
      if [ "$CUR_NEW" = 1 ]; then
        case "$CUR_SEC" in files) FILES="$FILES$val|" ;; esac
        return 0
      fi
      seg="${val%%/*}"
      case "$TOPLIST" in *"|$seg|"*) ;; *) return 0 ;; esac
      add_unresolved "path" "$val" " (line $CUR_LN)"
      return 0 ;;
    symbol)
      s="$val"
      case "$s" in *"()") s="${s%??}" ;; esac
      last="${s##*::}"
      if resolved_lookup "$last"; then
        add_symbol "$last" "$val"
        return 0
      fi
      [ "$CUR_SEC" != tasks ] || return 0
      if exempt_new "$last"; then return 0; fi
      add_unresolved "symbol" "$val" " (line $CUR_LN)"
      return 0 ;;
  esac
  return 0
}

# sweep_bare_word TOKEN: an Interfaces token expand_token dropped (no path or
# symbol shape, like `Shape`) is still a symbol candidate whatever its case:
# a hit earns a section, a miss is silent (plan-check would report neither).
sweep_bare_word() {
  local t last
  t="$(strip_port "$1")"
  last="$(bare_last "$t")"
  [ -n "$last" ] || return 0
  if resolved_lookup "$last"; then
    add_symbol "$last" "$t"
  fi
  return 0
}

if [ "$plan_given" = 1 ]; then
  records="$(plan_records "$plan")"
  : >"$work/cand-all"
  while IFS=$'\t' read -r CUR_SEC CUR_LN CUR_NEW CUR_READ tok; do
    [ -n "$tok" ] || continue
    case "$CUR_SEC" in files|interfaces|tasks) ;; *) continue ;; esac
    CALLED=0
    expand_token "$tok" collect_plan_token
    if [ "$CALLED" = 0 ] && [ "$CUR_SEC" = interfaces ]; then
      collect_bare_word "$tok"
    fi
  done <<<"$records"
  resolve_candidates
  GLOBS=""
  while IFS=$'\t' read -r CUR_SEC CUR_LN CUR_NEW CUR_READ tok; do
    [ -n "$tok" ] || continue
    case "$CUR_SEC" in files|interfaces|tasks) ;; *) continue ;; esac
    CALLED=0
    expand_token "$tok" sweep_plan_token
    if [ "$CALLED" = 0 ] && [ "$CUR_SEC" = interfaces ]; then
      sweep_bare_word "$tok"
    fi
  done <<<"$records"
  case "$plan" in
    /*) mode="plan $plan" ;;
    *) mode="plan $(cd "$(dirname "$plan")" && pwd)/$(basename "$plan")" ;;
  esac
else
  printf '%s\n' "$symbols" | tr ',' '\n' >"$work/items"
  : >"$work/cand-all"
  while IFS= read -r item; do
    item="$(trim "$item")"
    [ -n "$item" ] || continue
    s="$item"
    case "$s" in *"()") s="${s%??}" ;; esac
    last="${s##*::}"
    [ -n "$last" ] || continue
    note_candidate "$last"
  done <"$work/items"
  resolve_candidates
  while IFS= read -r item; do
    item="$(trim "$item")"
    [ -n "$item" ] || continue
    s="$item"
    case "$s" in *"()") s="${s%??}" ;; esac
    last="${s##*::}"
    [ -n "$last" ] || continue
    if resolved_lookup "$last"; then
      add_symbol "$last" "$item"
    else
      add_unresolved "symbol" "$item" ""
    fi
  done <"$work/items"
  printf '%s\n' "$files" | tr ',' '\n' >"$work/items"
  while IFS= read -r item; do
    item="$(trim "$item")"
    [ -n "$item" ] || continue
    resolve_path "$item"
    case "$RES_KIND" in
      found) FILES="$FILES$RES|" ;;
      ambiguous) AMBIG="${AMBIG}ambiguous: $item"$'\n' ;;
      none) add_unresolved "path" "$item" "" ;;
    esac
  done <"$work/items"
  mode="symbols"
fi

# docs, in argument order, read through git show at the base
doccount=0
DOC_SPECS=""
DOC_PATHS="|"
while IFS= read -r spec; do
  [ -n "$spec" ] || continue
  case "$spec" in *\#*) ;; *) usage ;; esac
  f="${spec%%\#*}"
  h="${spec#*\#}"
  if ! doc_section "$f" "$h" >"$work/doc-$doccount.md" 2>/dev/null; then
    rm -f "$work/doc-$doccount.md"
    add_unresolved "doc" "$spec" ""
    continue
  fi
  DOC_SPECS="$DOC_SPECS$spec"$'\n'
  DOC_PATHS="$DOC_PATHS$f|"
  doccount=$((doccount + 1))
done <<<"$docs"

if [ -n "$UNRESOLVED" ]; then
  printf '%s' "$UNRESOLVED"
  exit 1
fi

fullpack="$work/full.md"
symblocks=""
symheads=""
outlineblocks=""
docblocks=""
sym_n=0
file_n=0
: >"$work/outside-raw"

sym_total="$(printf '%s' "$SYMS" | grep -c . || true)"
while IFS=$'\t' read -r name title; do
  [ -n "$name" ] || continue
  sym_n=$((sym_n + 1))
  printf 'plan-sweep: symbol %s/%s %s\n' "$sym_n" "$sym_total" "$name" >&2
  printf '%s\n' "$name" >"$work/symname-$sym_n"
  printf '%s\n' "$title" >"$work/symtitle-$sym_n"
  sec="$work/sec-$sym_n.md"
  head="$work/head-$sym_n.md"
  : >"$sec"; : >"$head"
  : >"$work/matches-raw-$sym_n"
  idx="$(pat_idx "$name" || true)"
  : >"$work/defs-$sym_n"; : >"$work/callers-$sym_n"; : >"$work/reex-$sym_n"; : >"$work/pins-$sym_n"
  has_enum=0
  if [ -n "$idx" ]; then
    while IFS= read -r g; do
      [ -n "$g" ] || continue
      rest="${g:${#rev}+1}"
      path="${rest%%:*}"
      tail="${rest#*:}"
      lineno="${tail%%:*}"
      text="${tail#*:}"
      kind="$(is_pin "$path")"
      if [ -n "$kind" ]; then
        printf '%s %s\n' "$path" "$kind" >>"$work/pins-$sym_n"
        printf '%s\tpin\n' "$path" >>"$work/outside-raw"
        continue
      fi
      if is_reexport "$text"; then
        printf '%s:%s: %s\n' "$path" "$lineno" "$text" >>"$work/reex-$sym_n"
        printf '%s\tre-export\n' "$path" >>"$work/outside-raw"
        continue
      fi
      kw="$(def_keyword "$text" "$name")"
      if [ -n "$kw" ]; then
        printf '%s:%s: %s\n' "$path" "$lineno" "$text" >>"$work/defs-$sym_n"
        printf '%s\tdefinition\n' "$path" >>"$work/outside-raw"
        if [ "$kw" = enum ]; then has_enum=1; fi
        continue
      fi
      printf '%s:%s: %s\n' "$path" "$lineno" "$text" >>"$work/callers-$sym_n"
      printf '%s\tcaller\n' "$path" >>"$work/outside-raw"
    done <"$work/whits/$idx"
  fi
  if [ "$has_enum" = 1 ]; then
    : >"$work/enum-$sym_n"
  fi
done <<<"$SYMS"

if [ "$lang" = rust ]; then
  : >"$work/qualpatterns"
  : >"$work/qualmap"
  i=1
  while [ "$i" -le "$sym_n" ]; do
    if [ -e "$work/enum-$i" ]; then
      printf '%s::\n' "$(cat "$work/symname-$i")" >>"$work/qualpatterns"
      printf '%s\n' "$i" >>"$work/qualmap"
    fi
    i=$((i + 1))
  done
  if [ -s "$work/qualpatterns" ]; then
    batch_hits "$work/qualpatterns" "$work/qhits" qual
    j=0
    while IFS= read -r symidx; do
      j=$((j + 1))
      : >"$work/matches-raw-$symidx"
      if [ -s "$work/qhits/$j" ]; then
        while IFS= read -r g; do
          [ -n "$g" ] || continue
          printf '%s\n' "$g" >>"$work/matches-raw-$symidx"
          rest="${g:${#rev}+1}"
          mpath="${rest%%:*}"
          printf '%s\tmatch\n' "$mpath" >>"$work/outside-raw"
        done <"$work/qhits/$j"
      fi
    done <"$work/qualmap"
  fi
fi

i=1
while [ "$i" -le "$sym_n" ]; do
  name="$(cat "$work/symname-$i")"
  title="$(cat "$work/symtitle-$i")"
  sec="$work/sec-$i.md"
  head="$work/head-$i.md"
  defs_n="$(nlines "$work/defs-$i")"
  callers_n="$(nlines "$work/callers-$i")"
  if [ "$callers_n" -gt 0 ]; then
    caller_files="$(cut -d: -f1 "$work/callers-$i" | sort -u | wc -l)"
    caller_files="${caller_files//[[:space:]]/}"
  else
    caller_files=0
  fi
  if [ "$callers_n" -gt 40 ]; then shown=40; else shown="$callers_n"; fi
  reex_n="$(nlines "$work/reex-$i")"
  pins_n="$(nlines "$work/pins-$i")"
  sort -t: -k1,1 -k2,2n "$work/defs-$i" >"$work/defs-s-$i"
  sort -t: -k1,1 -k2,2n "$work/reex-$i" >"$work/reex-s-$i"
  sort "$work/pins-$i" >"$work/pins-s-$i"
  sort -t: -k1,1 -k2,2n "$work/callers-$i" >"$work/callers-sorted-$i"
  head -n 40 "$work/callers-sorted-$i" >"$work/callers-s-$i"
  {
    printf '## Symbol %s\n' "$title"
    printf 'definitions: %s\n' "$defs_n"
    cat "$work/defs-s-$i"
  } | tee -a "$sec" >>"$head"
  {
    printf 'callers: %s lines in %s files (shown %s)\n' "$callers_n" "$caller_files" "$shown"
    cat "$work/callers-s-$i"
  } >>"$sec"
  printf 'callers: %s lines in %s files (shown %s)\n' "$callers_n" "$caller_files" "$shown" >>"$head"
  {
    printf 're-exports: %s\n' "$reex_n"
    cat "$work/reex-s-$i"
  } >>"$sec"
  printf 're-exports: %s\n' "$reex_n" >>"$head"
  if [ "$lang" = rust ] && [ -e "$work/enum-$i" ]; then
    : >"$work/matches-$i"
    while IFS= read -r g; do
      [ -n "$g" ] || continue
      rest="${g:${#rev}+1}"
      mpath="${rest%%:*}"
      tail="${rest#*:}"
      mlineno="${tail%%:*}"
      mtext="${tail#*:}"
      printf '%s:%s: %s\n' "$mpath" "$mlineno" "$mtext" >>"$work/matches-$i"
    done <"$work/matches-raw-$i"
    match_n="$(nlines "$work/matches-$i")"
    if [ "$match_n" -gt 0 ]; then
      match_files="$(cut -d: -f1 "$work/matches-$i" | sort -u | wc -l)"
      match_files="${match_files//[[:space:]]/}"
    else
      match_files=0
    fi
    sort -t: -k1,1 -k2,2n "$work/matches-$i" >"$work/matches-s-$i"
    {
      printf 'matches: %s lines in %s files\n' "$match_n" "$match_files"
      cat "$work/matches-s-$i"
    } >>"$sec"
    printf 'matches: %s lines in %s files\n' "$match_n" "$match_files" >>"$head"
  fi
  {
    printf 'pins: %s files\n' "$pins_n"
    cat "$work/pins-s-$i"
  } >>"$sec"
  printf 'pins: %s files\n' "$pins_n" >>"$head"
  symblocks="$symblocks$sec"$'\n'
  symheads="$symheads$head"$'\n'
  i=$((i + 1))
done

# outlines, in Files order; only blobs resolve to an outline
OUTLINED="|"
while IFS= read -r e; do
  [ -n "$e" ] || continue
  case "$e" in *\**) continue ;; esac
  case "$OUTLINED" in *"|$e|"*) continue ;; esac
  [ "$(git -C "$dir" cat-file -t "$rev:$e" 2>/dev/null || true)" = blob ] || continue
  OUTLINED="$OUTLINED$e|"
  file_n=$((file_n + 1))
  ob="$work/outline-$file_n.md"
  {
    printf '## Outline %s\n' "$e"
    outline_lines "$e"
  } >"$ob"
  outlineblocks="$outlineblocks$ob"$'\n'
done <<<"$(printf '%s' "${FILES#|}" | tr '|' '\n')"

# docs, in argument order
docidx=0
while IFS= read -r spec; do
  [ -n "$spec" ] || continue
  db="$work/docblock-$docidx.md"
  {
    printf '## Doc %s\n' "$spec"
    cat "$work/doc-$docidx.md"
  } >"$db"
  docblocks="$docblocks$db"$'\n'
  docidx=$((docidx + 1))
done <<<"$DOC_SPECS"

# Outside Files: every Symbol-section path the Files do not cover
sort -u "$work/outside-raw" >"$work/outside-pairs" 2>/dev/null || : >"$work/outside-pairs"
cut -f1 "$work/outside-pairs" 2>/dev/null | sort -u >"$work/outside-paths" || : >"$work/outside-paths"
ob="$work/outside.md"
{
  printf '## Outside Files\n'
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if covered "$p"; then continue; fi
    case "$OUTLINED" in *"|$p|"*) continue ;; esac
    case "$DOC_PATHS" in *"|$p|"*) continue ;; esac
    reasons=""
    for r in definition caller re-export match pin; do
      pair="$(printf '%s\t%s' "$p" "$r")"
      if grep -qxF -- "$pair" "$work/outside-pairs" 2>/dev/null; then
        [ -n "$reasons" ] && reasons="$reasons,$r" || reasons="$r"
      fi
    done
    [ -n "$reasons" ] || continue
    printf '%s %s\n' "$p" "$reasons"
  done <"$work/outside-paths"
} >"$ob"
outside_n="$(($(nlines "$ob") - 1))"
[ "$outside_n" -ge 0 ] || outside_n=0

{
  printf '# Pack\n'
  printf 'Base: %s\n' "$fullsha"
  printf 'Mode: %s\n' "$mode"
  if [ -n "$AMBIG" ]; then printf '%s' "$AMBIG"; fi
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    printf '\n'
    cat "$b"
  done <<<"$symblocks"
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    printf '\n'
    cat "$b"
  done <<<"$outlineblocks"
  while IFS= read -r b; do
    [ -n "$b" ] || continue
    printf '\n'
    cat "$b"
  done <<<"$docblocks"
  printf '\n'
  cat "$ob"
} >"$fullpack"

fullbytes="$(wc -c <"$fullpack")"
fullbytes="${fullbytes//[[:space:]]/}"
if [ "$fullbytes" -gt "$maxbytes" ]; then
  cutb="$work/cut.md"
  {
    printf '# Pack\n'
    printf 'Base: %s\n' "$fullsha"
    printf 'Mode: %s\n' "$mode"
    if [ -n "$AMBIG" ]; then printf '%s' "$AMBIG"; fi
    while IFS= read -r b; do
      [ -n "$b" ] || continue
      printf '\n'
      cat "$b"
    done <<<"$symheads"
    printf '\n'
    cat "$ob"
    printf '\n## Cut\n'
    printf 'callers, re-export, match and pin lines, outlines, docs: pack was %s bytes, cap %s' "$fullbytes" "$maxbytes"
  } >"$work/compact.md"
  compactbytes="$(wc -c <"$work/compact.md")"
  compactbytes="${compactbytes//[[:space:]]/}"
  if [ "$compactbytes" -gt "$maxbytes" ]; then
    printf ' Compact form is %s bytes, still over the cap.\n' "$compactbytes" >>"$work/compact.md"
  else
    printf '\n' >>"$work/compact.md"
  fi
  final="$work/compact.md"
else
  final="$fullpack"
fi

parent="${out%/*}"
mkdir -p "$parent"
tmpfile="$(mktemp "$parent/.plan-sweep.XXXXXX")"
cat "$final" >"$tmpfile"
mv "$tmpfile" "$out"
tmpfile=""
trap - EXIT
rm -rf "$work"

printf 'PACK %s symbols=%s files=%s outside=%s\n' "$out" "$sym_n" "$file_n" "$outside_n"
