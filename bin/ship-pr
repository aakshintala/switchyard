#!/usr/bin/env bash
# ship-pr: run a reviewed PR's merge tail in one command.
# Usage: ship-pr <pr> --repo OWNER/NAME --reviewed <sha> --worktree <path> [--gate '<cmd>'] [--timeout <s>] [--body-has <prefix>]... [--unverified-fixes <findings file>] [--allow-commit-closes]
#        Run it after review-loop has a verdict on <sha>. In order: check the PR is
#        open and its head branch is checked out clean in --worktree, waiting up to
#        60 s for GitHub's head to match the local HEAD; require each --body-has
#        line and run pr-closes (see below); run --gate in the worktree on that head,
#        once, before any rebase or push; rebase onto
#        origin/main (see below); compare the PR diff's `git patch-id --stable` with
#        <sha>'s (with --unverified-fixes, a mismatch posts a comment and goes on, see
#        below); push a rebased branch with --force-with-lease; mark a draft
#        ready (once, before the first CI wait); `gh-ci wait` (--timeout, default
#        7200), rerunning failed jobs once when the failure is outside the diff
#        (see below); on a non-strict base with --gate, gate the PR merged
#        with current origin/main in a throwaway merge commit (step 7); squash-merge
#        pinned to the checked head, retrying once on a base race or GraphQL error
#        and polling MERGED even after a failed retry; wait for MERGED; remove the worktree and the
#        local and remote branch (the worktree and local branch stay when the
#        caller's directory is inside it).
#        The CI wait trusts the repo's required checks: one green on the exact
#        head counts whenever it ran, so marking ready need not start a new run,
#        and a run that starts after the wait passed does not hold the merge. An
#        absent required check is pending. To keep a draft run from satisfying
#        the wait, give its check a name other than the required one (fiber's
#        draft run reports `CI (draft)`; the required check is `CI`).
#        Each --body-has <prefix> (repeatable) requires a PR body line that starts
#        with <prefix>, literally and case-sensitively; it is checked after step 1,
#        before the rebase, and each missing one prints `missing body line: <prefix>`.
#        Step 2 runs pr-closes just after the --body-has check, before any gate,
#        rebase, push or CI wait. With --allow-commit-closes, a stray match whose
#        report's second field is `commit <sha>` is printed to stderr as a warning
#        and does not fail; a title or body match still exits 5. Without the flag
#        every stray match exits 5. Both repos that use ship-pr squash with the PR
#        title and body as the commit message, so a commit message keyword never
#        reaches main.
#        When `gh-ci wait` fails on the pinned head, ship-pr reads `gh-ci failures
#        --pr <pr>` and, only when the failure is outside the diff, reruns each failed
#        or cancelled run on the pinned head with `gh run rerun <run id> --failed`,
#        once per invocation, then waits again with the same --timeout. Outside the
#        diff means every failed or cancelled job was cancelled (a job that hits its
#        timeout-minutes reports as cancelled), or every failed job logged a
#        `panicked at <path>:<line>` location and none of those paths is in
#        `git diff --name-only origin/main...<pin>`. A failed job with no panic
#        location counts as inside the diff and is never rerun. A failed rerun exits 1
#        naming the run. After rerunning, ship-pr polls each rerun run until its
#        attempt passes the pre-rerun one before waiting again; no new attempt
#        within 120 s exits 1 naming the run.
#        Prints `merged <squash sha>` on success. A `gh pr merge` error containing
#        `GraphQL` retries once like `Base branch was modified`, sleeping 5 s first.
#        After a failed retry of either kind ship-pr still polls for MERGED, since
#        GitHub sometimes merges despite the error, and exits 1 saying the merge
#        command failed only when the poll never sees MERGED.
#        Progress goes to stderr, and so do
#        gh-ci's check counts while CI runs.
#        After marking a draft PR ready, each later failure before `gh pr merge` says
#        that nothing merged and the PR is still marked ready. If MERGED is not confirmed
#        after the merge attempt, the error says the merge status could not be confirmed.
#        Exit 0 merged, 1 gate/CI/push/merge failure (a gate run on the PR merged
#        with current origin/main counts as a gate failure), 2 bad usage or a failed
#        precondition, 3 rebase conflict (aborted), a conflict `gh-ci wait` found after the push,
#        or a conflict merging current origin/main on a non-strict base, 4 patch-id mismatch (needs a new
#        verdict; with --unverified-fixes, no exit 4), 5 PR text needs a fix (missing --body-has lines, or stray closing keywords from pr-closes), 124 CI wait timeout.
#        Rebase rule, by whether main's required-status-checks rule is strict (a
#        ruleset's strict_required_status_checks_policy, or classic branch
#        protection's required_status_checks.strict; strict if either says so; a
#        failed lookup, other than a classic 404, falls back to strict). The mode is
#        printed once.
#        Strict: rebase onto origin/main when it moved. When origin/main moves during
#        the CI wait, ship-pr goes back to the rebase (rebase, patch-id check, push
#        and CI wait again; no gate), at most 3 times; the 4th move exits 1.
#        Not strict: after the gate, read the PR's mergeable and mergeStateStatus;
#        rebase (after refetching origin/main) only on CONFLICTING or DIRTY. One CI
#        wait, no retry when origin/main moves; a conflict found after CI exits 3.
#        On every invocation, before step 3, delete only regular xcrun_db-* files directly under
#        ${TMPDIR:-/tmp} when they are over a day old; ignore deletion errors. With --gate,
#        require at least 20 GB free on the volumes holding --worktree and ${TMPDIR:-/tmp}.
#        Both gate runs set NEXTEST_RETRIES=1, retrying failed nextest tests once.
#        Report each FLAKY result and its failed-attempt panic text; retries do not
#        change the gate's exit status.
#        With --gate, step 7 refetches origin/main after step 2: when it is not
#        an ancestor of the pinned head, merge it into the pinned head in a throwaway
#        commit in --worktree, run the gate there, and restore the pinned head whatever
#        happens (nothing is pushed). A merge conflict exits 3; a failing gate exits 1
#        after printing its last 20 lines, panic context outside that tail, and the path
#        to the full output saved under ${TMPDIR:-/tmp}/ship-pr-<pr>-gate.*. Passing gates
#        leave no log file. Without --gate the check is skipped.
#        --unverified-fixes <file> is for a fix round that answers no real bug (review-loop
#        step 3), so it ships with no re-review. The file must be readable and hold a
#        non-blank line, else exit 2 before anything else. On a patch-id mismatch, once per
#        run and before the first push or CI wait, ship-pr posts a PR comment: a first line
#        naming the reviewed short sha, the file under `Findings:`, and `git diff --stat`
#        from the reviewed sha to the pinned head under `Changed since review:`. A failed
#        post exits 1 before any push. A match posts nothing. The gate and CI run as usual.
#        --timeout bounds each CI wait, so a run can take one gate and up to 4 CI waits.
#        SHIP_PR_INTERVAL: seconds between MERGED polls (default 5, at most 12 polls).
set -euo pipefail

usage() {
  echo "usage: ship-pr <pr> --repo OWNER/NAME --reviewed <sha> --worktree <path> [--gate '<cmd>'] [--timeout <s>] [--body-has <prefix>]... [--unverified-fixes <findings file>] [--allow-commit-closes]" >&2
  exit 2
}
say() { echo "ship-pr: $*" >&2; }
die() { local code="$1"; shift; say "$*"; exit "$code"; }
pr_ready=0 merge_attempted=0
die_after_ready() {
  local code="$1"; shift
  if [ "$pr_ready" = 1 ] && [ "$merge_attempted" = 0 ]; then
    die "$code" "$*; nothing merged, PR $pr is still marked ready"
  fi
  die "$code" "$@"
}
exit_after_ready() {
  local code="$1"; shift
  if [ "$pr_ready" = 1 ] && [ "$merge_attempted" = 0 ]; then
    say "$*; nothing merged, PR $pr is still marked ready"
  fi
  exit "$code"
}

report_flakes() {
  local output_file="$1" flaky_tests test_name
  flaky_tests="$(awk '
    {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      if (line !~ /^FLAKY[[:space:]]/) next
      marker = index(line, ") ")
      if (marker) print substr(line, marker + 2)
    }
  ' "$output_file")"
  [ -n "$flaky_tests" ] || return 1
  while IFS= read -r test_name; do
    [ -n "$test_name" ] && say "FLAKY $test_name"
  done <<<"$flaky_tests"
  return 0
}

check_free_space() {
  local path="$1" disk_info available mount min_free_kb=20971520
  if ! disk_info="$(df -Pk "$path" 2>/dev/null | awk 'NR > 1 { print $4 "\t" $NF; exit }')"; then
    die 1 "cannot check free space on $path"
  fi
  IFS=$'\t' read -r available mount <<<"$disk_info" || true
  case "$available" in ''|*[!0-9]*) die 1 "cannot check free space on $path" ;; esac
  if [ "$available" -lt "$min_free_kb" ]; then
    say "only $((available / 1048576)) GB free on $mount; a gate needs 20 GB. Free space, then rerun."
    exit 1
  fi
}

gate_preflight() {
  local tmpdir="${TMPDIR:-/tmp}"
  check_free_space "$worktree"
  check_free_space "$tmpdir"
}

run_gate() {
  local output_file
  output_file="$(mktemp "${TMPDIR:-/tmp}/ship-pr-${pr}-gate.XXXXXX")"
  if (cd "$worktree" && NEXTEST_RETRIES=1 bash -c "$gate" </dev/null) >"$output_file" 2>&1; then
    if report_flakes "$output_file"; then
      GH_CI_LOG_LINES=0 bash "$here/gh-ci" panics <"$output_file" >&2
    fi
    rm -f "$output_file"
    return 0
  fi
  report_flakes "$output_file" || true
  tail -n 20 "$output_file" || true
  GH_CI_LOG_LINES=20 bash "$here/gh-ci" panics <"$output_file"
  printf 'full gate output: %s\n' "$output_file"
  return 1
}

[ $# -ge 1 ] || usage
pr="$1"; shift
case "$pr" in ''|*[!0-9]*) usage ;; esac
repo="" reviewed="" worktree="" gate="" timeout=7200 body_has=() unverified="" allow_commit_closes=""
while [ $# -gt 0 ]; do
  case "$1" in
    --allow-commit-closes) allow_commit_closes=1; shift; continue ;;
  esac
  [ $# -ge 2 ] || usage
  case "$1" in
    --repo) repo="$2" ;;
    --reviewed) reviewed="$2" ;;
    --worktree) worktree="$2" ;;
    --gate) gate="$2" ;;
    --timeout) timeout="$2" ;;
    --body-has) case "$2" in ''|*$'\n'*) usage ;; esac; body_has+=("$2") ;;
    --unverified-fixes) [ -n "$2" ] || usage; unverified="$2" ;;
    *) usage ;;
  esac
  shift 2
done
[ -n "$repo" ] && [ -n "$reviewed" ] && [ -n "$worktree" ] || usage
case "$timeout" in ''|*[!0-9]*) usage ;; esac
if [ -n "$unverified" ]; then
  [ -f "$unverified" ] && [ -r "$unverified" ] || die 2 "cannot read --unverified-fixes $unverified"
  grep -q '[^[:space:]]' "$unverified" || die 2 "--unverified-fixes $unverified has no findings"
fi

tmpdir="${TMPDIR:-/tmp}"
find -H "$tmpdir" -maxdepth 1 -type f -name 'xcrun_db-*' -mmin +1440 -delete >/dev/null 2>&1 || true

here="$(cd "$(dirname "$0")" && pwd)"

# Step 1: the PR is open, its branch is checked out clean at the PR head.
info="$(gh pr view "$pr" --repo "$repo" --json state,headRefName,headRefOid,isDraft \
  --jq '[.state, .headRefName, .headRefOid, .isDraft] | @tsv')" \
  || die 2 "cannot read PR $pr in $repo"
IFS=$'\t' read -r state branch head0 draft <<<"$info"
[ "$state" = "OPEN" ] || die 2 "PR $pr is $state, not OPEN"
worktree="$(cd "$worktree" 2>/dev/null && pwd -P)" || die 2 "no such worktree: $worktree"
start_dir="$(pwd -P)"
git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 2 "$worktree is not a git checkout"
[ "$(git -C "$worktree" symbolic-ref --short -q HEAD || true)" = "$branch" ] \
  || die 2 "$worktree does not have $branch checked out"
[ -z "$(git -C "$worktree" status --porcelain)" ] || die 2 "$worktree has uncommitted changes"
git -C "$worktree" fetch -q origin >&2 || die 1 "git fetch origin failed"
local_head="$(git -C "$worktree" rev-parse HEAD)"
if [ "$local_head" != "$head0" ]; then
  for _wait in $(seq 1 30); do
    sleep 2
    head0="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid 2>/dev/null)" \
      || die 2 "cannot read PR $pr in $repo"
    [ "$local_head" = "$head0" ] && break
  done
fi
[ "$local_head" = "$head0" ] \
  || die 2 "$worktree HEAD is not the PR head $head0; pull or push first"
git -C "$worktree" rev-parse --verify -q "$reviewed^{commit}" >/dev/null \
  || die 2 "--reviewed $reviewed is not a commit in $worktree"

# Required PR body lines: checked now so a PR with wrong text costs no push and no CI wait.
if [ "${#body_has[@]}" -gt 0 ]; then
  body="$(gh pr view "$pr" --repo "$repo" --json body --jq '.body // ""')" \
    || die 2 "cannot read PR $pr body"
  missing=0
  for prefix in "${body_has[@]}"; do
    found=""
    while IFS= read -r line || [ -n "$line" ]; do
      case "${line%$'\r'}" in "$prefix"*) found=1; break ;; esac
    done <<<"$body"
    [ -n "$found" ] || { echo "missing body line: $prefix"; missing=1; }
  done
  [ "$missing" = 0 ] || die 5 "PR body lacks required lines; edit the PR body, then rerun"
fi

# Step 2: no stray closing keywords, before any gate, rebase, push or CI wait.
rc=0
closes_out="$(bash "$here/pr-closes" "$pr" --repo "$repo" 2>/dev/null)" || rc=$?
case "$rc" in
  0) ;;
  1)
    if [ -n "$allow_commit_closes" ]; then
      stray_text=""
      while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        case "$line" in
          *" commit "*) say "warning: allowing $line" ;;
          *) stray_text="${stray_text}${line}
" ;;
        esac
      done <<<"$closes_out"
      if [ -n "$stray_text" ]; then
        printf '%s' "$stray_text"
        exit_after_ready 5 "pr-closes found stray closing keywords"
      fi
    else
      printf '%s\n' "$closes_out"
      exit_after_ready 5 "pr-closes found stray closing keywords"
    fi
    ;;
  *) die_after_ready 1 "pr-closes failed (exit $rc)" ;;
esac

# Posts the unverified-fixes comment (step 5). Nothing is pushed if it fails.
post_unverified() {
  local pin="$1" short stat body rc=0
  short="$(git -C "$worktree" rev-parse --short "$reviewed")" || die_after_ready 1 "cannot name $reviewed"
  stat="$(git -C "$worktree" diff --stat "$reviewed..$pin")" || die_after_ready 1 "cannot diff $reviewed..$pin"
  body="$(mktemp "${TMPDIR:-/tmp}/ship-pr-comment.XXXXXX")"
  {
    printf 'Fixes since %s shipped without re-review (review-loop step 3: no real bug in round one).\n\n' "$short"
    printf 'Findings:\n'
    cat "$unverified"
    printf '\n\nChanged since review:\n%s\n' "$stat"
  } >"$body"
  gh pr comment "$pr" --repo "$repo" --body-file "$body" >&2 || rc=$?
  rm -f "$body"
  [ "$rc" = 0 ] || die_after_ready 1 "cannot post the unverified-fixes comment on PR $pr; nothing pushed"
  say "posted the unverified-fixes comment on PR $pr"
}

patch_id() {
  local id
  id="$(git -C "$worktree" diff "origin/main...$1" | git patch-id --stable | awk '{print $1}')"
  echo "${id:-none}"
}

# Whether main's required checks are strict. Any lookup error other than a classic
# rule's 404 (no classic rule) counts as strict: the old behaviour, costing only CI time.
strict_checks() {
  local out
  if ! out="$(gh api "repos/$repo/rules/branches/main" \
    --jq '[.[] | select(.type == "required_status_checks") | .parameters.strict_required_status_checks_policy] | any' 2>/dev/null)"; then
    say "cannot read whether required checks on main are strict; assuming strict"; return 0
  fi
  [ "$out" != "true" ] || return 0
  if ! out="$(gh api "repos/$repo/branches/main/protection/required_status_checks" --jq .strict 2>&1)"; then
    case "$out" in *"HTTP 404"*) return 1 ;; esac
    say "cannot read whether required checks on main are strict; assuming strict"; return 0
  fi
  [ "$out" = "true" ]
}
if strict_checks; then
  strict=1; say "required checks on main are strict: rebasing when origin/main moves"
else
  strict=0; say "required checks on main are not strict: rebasing only on a conflict"
fi

rebase_main() {
  say "rebasing $branch onto origin/main"
  if ! git -C "$worktree" rebase origin/main >&2; then
    git -C "$worktree" rebase --abort >&2 || true
    die_after_ready 3 "rebase onto origin/main conflicts; resolve it, then rerun"
  fi
}

# Rerun CI once when the failure is outside the diff (step 6). Shared across the
# strict-mode retry loop: at most one rerun per invocation.
ci_rerun_done=""
ci_outside_reason() {
  local failures headers failed_headers cancelled_headers cancelled_names panic_paths diff_files
  failures="$(GH_CI_REPO="$repo" bash "$here/gh-ci" failures --pr "$pr" 2>/dev/null)" || return 1
  [ -n "$failures" ] || return 1
  headers="$(printf '%s\n' "$failures" | grep '^=== ' || true)"
  [ -n "$headers" ] || return 1
  failed_headers="$(printf '%s\n' "$headers" | grep ': failure' || true)"
  cancelled_headers="$(printf '%s\n' "$headers" | grep ': cancelled' || true)"
  if [ -z "$failed_headers" ]; then
    [ -n "$cancelled_headers" ] || return 1
    cancelled_names="$(printf '%s\n' "$cancelled_headers" | sed -E 's/^=== .* \/ (.*): cancelled$/\1/' | sort -u | paste -sd ',' - | sed 's/,/, /g')"
    [ -n "$cancelled_names" ] || return 1
    printf 'cancelled jobs: %s' "$cancelled_names"
    return 0
  fi
  if ! printf '%s\n' "$failures" | awk '
    /^=== / {
      if (in_failed && !saw_panic) exit 1
      in_failed = ($0 ~ /: failure$/)
      saw_panic = 0
      next
    }
    in_failed && /panicked at [^[:space:]:]+:[0-9]+/ { saw_panic = 1 }
    END { if (in_failed && !saw_panic) exit 1 }
  '; then
    return 1
  fi
  panic_paths="$(printf '%s\n' "$failures" | grep -oE 'panicked at [^[:space:]:]+:[0-9]+' | sed -E 's/^panicked at //; s/:[0-9]+$//' | sort -u || true)"
  [ -n "$panic_paths" ] || return 1
  diff_files="$(git -C "$worktree" diff --name-only "origin/main...$pin" 2>/dev/null)" || return 1
  while IFS= read -r p || [ -n "$p" ]; do
    [ -n "$p" ] || continue
    if printf '%s\n' "$diff_files" | grep -qxF "$p"; then
      return 1
    fi
  done <<<"$panic_paths"
  printf 'panics at %s' "$(printf '%s\n' "$panic_paths" | paste -sd ',' - | sed 's/,/, /g')"
  return 0
}
ci_failed_run_ids() {
  local list ids
  list="$(gh run list --repo "$repo" --commit "$pin" --limit 100 --json databaseId,conclusion,workflowName,name,event 2>/dev/null)" || return 1
  ids="$(printf '%s' "$list" | jq -r '. as $all | ([.[] | {k: "\(.workflowName // .name // "")\u001f\(.event // "")" , id: .databaseId}] | group_by(.k) | map(max_by(.id).id)) as $newest | $all[] | select(.conclusion=="failure" or .conclusion=="cancelled") | select(.databaseId as $id | $newest | index($id)) | "\(.databaseId)"' 2>/dev/null)" || return 1
  [ -n "$ids" ] || return 1
  printf '%s\n' "$ids"
}

# Step 3: the gate runs once, on the PR head, before any rebase or push. It checks
# code; it never changes what was reviewed. CI covers the rebased head.
if [ -n "$gate" ]; then
  gate_preflight
  say "running gate"
  run_gate || die 1 "gate failed"
  [ "$(git -C "$worktree" rev-parse HEAD)" = "$head0" ] && [ -z "$(git -C "$worktree" status --porcelain)" ] \
    || die 1 "the gate changed the worktree; commit nothing from a gate"
fi

# Not strict: ask GitHub for a conflict now, after the gate (which takes minutes).
# main may have gained the conflicting commit meanwhile, so refetch before the rebase.
conflict=""
if [ "$strict" = 0 ]; then
  probe="$(gh pr view "$pr" --repo "$repo" --json mergeable,mergeStateStatus \
    --jq '[.mergeable, .mergeStateStatus] | @tsv' 2>/dev/null)" || probe=""
  [ -n "$probe" ] || say "cannot read PR $pr mergeability; not rebasing"
  case "$probe" in CONFLICTING*|*DIRTY) conflict=1 ;; esac
  if [ -n "$conflict" ]; then
    git -C "$worktree" fetch -q origin +refs/heads/main:refs/remotes/origin/main >&2 || die 1 "git fetch origin main failed"
  fi
fi

# Steps 4-6 repeat when origin/main moves during the CI wait (strict only), at most 3 times.
# lease is the branch SHA last known on the remote: head0, then each pushed pin.
lease="$head0" retries=0 unverified_posted=""
while :; do
  # Step 4: rebase onto origin/main when it moved (strict) or on a reported conflict.
  if [ "$strict" = 1 ]; then
    git -C "$worktree" merge-base --is-ancestor origin/main HEAD || rebase_main
  elif [ -n "$conflict" ]; then
    rebase_main
  fi
  pin="$(git -C "$worktree" rev-parse HEAD)"

  # Step 5: the patch under review is the patch about to merge (review-loop's Identity rule).
  if [ "$(patch_id "$reviewed")" != "$(patch_id "$pin")" ]; then
    [ -n "$unverified" ] || die_after_ready 4 "patch-id of the PR differs from --reviewed $reviewed; the change needs a new verdict"
    if [ -z "$unverified_posted" ]; then
      post_unverified "$pin"
      unverified_posted=1
    fi
  fi

  # Step 6: push a rebased branch, then wait for CI on exactly that head.
  if [ "$pin" != "$lease" ]; then
    say "pushing rebased $branch"
    git -C "$worktree" push -q --force-with-lease="$branch:$lease" origin "HEAD:refs/heads/$branch" >&2 \
      || die_after_ready 1 "push of rebased $branch failed"
    lease="$pin"
  fi
  if [ "$draft" = "true" ]; then
    say "marking PR $pr ready"
    gh pr ready "$pr" --repo "$repo" >&2 || die 1 "gh pr ready failed"
    draft=false
    pr_ready=1
  fi
  say "waiting for CI"
  rc=0
  ci_out="$(GH_CI_REPO="$repo" bash "$here/gh-ci" wait "$pr" --timeout "$timeout")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$ci_out"
    case "$rc" in
      124) exit_after_ready 124 "CI timed out" ;;
      3) die_after_ready 3 "PR conflicts with origin/main after the push; rebase again, then rerun" ;;
      *)
        if [ -z "$ci_rerun_done" ]; then
          if reason="$(ci_outside_reason 2>/dev/null)"; then
            if run_ids="$(ci_failed_run_ids 2>/dev/null)"; then
              say "CI failure outside the diff ($reason); rerunning failed jobs once — file the flake"
              pre_attempts=""
              while IFS= read -r rid || [ -n "$rid" ]; do
                [ -n "$rid" ] || continue
                pre="$(gh run view "$rid" --repo "$repo" --json attempt,status --jq '[.attempt, .status] | @tsv' 2>/dev/null)" \
                  || die_after_ready 1 "cannot read attempt of run $rid before rerun"
                IFS=$'\t' read -r pre_attempt _ <<<"$pre" || true
                pre_attempts="${pre_attempts}${rid} ${pre_attempt:-0}
"
              done <<<"$run_ids"
              while IFS= read -r rid || [ -n "$rid" ]; do
                [ -n "$rid" ] || continue
                gh run rerun "$rid" --failed --repo "$repo" >&2 || die_after_ready 1 "gh run rerun $rid --failed failed"
              done <<<"$run_ids"
              ci_rerun_done=1
              elapsed=0
              while :; do
                waiting=""
                while IFS= read -r rid || [ -n "$rid" ]; do
                  [ -n "$rid" ] || continue
                  pre_one="$(awk -v r="$rid" '$1 == r { print $2; exit }' <<<"$pre_attempts")"
                  cur="$(gh run view "$rid" --repo "$repo" --json attempt,status --jq '[.attempt, .status] | @tsv' 2>/dev/null)" \
                    || { waiting="${waiting}${rid} "; continue; }
                  IFS=$'\t' read -r cur_attempt cur_status <<<"$cur" || true
                  [ "${cur_status:-}" != "completed" ] && continue
                  case "${cur_attempt:-}" in ''|*[!0-9]*) waiting="${waiting}${rid} "; continue ;; esac
                  case "${pre_one:-}" in ''|*[!0-9]*) pre_one=0 ;; esac
                  [ "$cur_attempt" -gt "$pre_one" ] || waiting="${waiting}${rid} "
                done <<<"$run_ids"
                [ -z "$waiting" ] && break
                [ "$elapsed" -ge 120 ] && die_after_ready 1 "run ${waiting%% *} shows no new attempt 120 s after rerun"
                sleep 5
                elapsed=$((elapsed + 5))
              done
              say "waiting for CI"
              rc=0
              ci_out="$(GH_CI_REPO="$repo" bash "$here/gh-ci" wait "$pr" --timeout "$timeout")" || rc=$?
              if [ "$rc" -ne 0 ]; then
                printf '%s\n' "$ci_out"
                case "$rc" in
                  124) exit_after_ready 124 "CI timed out" ;;
                  3) die_after_ready 3 "PR conflicts with origin/main after the push; rebase again, then rerun" ;;
                  *) die_after_ready 1 "CI failed" ;;
                esac
              fi
            fi
          fi
        fi
        [ "$rc" -eq 0 ] || die_after_ready 1 "CI failed"
        ;;
    esac
  fi
  grep -q "^head: ${pin:0:8} " <<<"$ci_out" || { printf '%s\n' "$ci_out"; die_after_ready 1 "CI passed on a head other than ${pin:0:8}"; }

  [ "$strict" = 1 ] || break

  # Up to date at merge: CI "must pass on a head up to date with main".
  git -C "$worktree" fetch -q origin +refs/heads/main:refs/remotes/origin/main >&2 || die_after_ready 1 "git fetch origin main failed"
  git -C "$worktree" merge-base --is-ancestor origin/main "$pin" && break
  [ "$retries" -lt 3 ] || die_after_ready 1 "origin/main moved during CI after 3 retries; rerun ship-pr"
  retries=$((retries + 1))
  say "origin/main moved during CI; rebasing again (retry $retries of 3)"
done

# Step 7: on a non-strict base with --gate, gate the PR merged with current
# origin/main. The merge is a throwaway commit in --worktree; nothing is pushed,
# and the worktree goes back to the pinned head on every path.
if [ "$strict" = 0 ] && [ -n "$gate" ]; then
  git -C "$worktree" fetch -q origin +refs/heads/main:refs/remotes/origin/main >&2 || die_after_ready 1 "git fetch origin main failed"
  if ! git -C "$worktree" merge-base --is-ancestor origin/main "$pin"; then
    say "gating the PR merged with current origin/main"
    guard_restore() {
      git -C "$worktree" reset -q --hard "$pin" >&2 || die_after_ready 1 "failed to restore pinned head ${pin:0:8}"
    }
    trap 'guard_rc=$?; trap - EXIT INT TERM; guard_restore; if [ "$guard_rc" -ne 0 ]; then exit_after_ready "$guard_rc" "gate aborted"; else exit "$guard_rc"; fi' EXIT
    trap 'trap - EXIT INT TERM; guard_restore; exit_after_ready 143 "gate interrupted"' TERM
    trap 'trap - EXIT INT TERM; guard_restore; exit_after_ready 130 "gate interrupted"' INT
    if ! git -C "$worktree" -c user.name=ship-pr -c user.email=ship-pr@localhost merge --no-ff --no-edit origin/main >&2; then
      guard_restore
      trap - EXIT INT TERM
      die_after_ready 3 "PR conflicts with current origin/main; rebase, then rerun"
    fi
    if ! run_gate; then
      guard_restore
      trap - EXIT INT TERM
      die_after_ready 1 "the PR merged with current origin/main fails the gate"
    fi
    guard_restore
    trap - EXIT INT TERM
    say "gate passes on the PR merged with current origin/main"
  fi
fi

# Step 8: merge pinned to the checked head, then wait for GitHub to say MERGED.
say "merging PR $pr at ${pin:0:8}"
merge_attempted=1
merge_err=""
merge_failed=""
if ! merge_err="$(gh pr merge "$pr" --repo "$repo" --squash --match-head-commit "$pin" 2>&1)"; then
  printf '%s\n' "$merge_err" >&2
  case "$merge_err" in
    *"Base branch was modified"*|*"GraphQL"*)
      case "$merge_err" in
        *"GraphQL"*) say "GraphQL error during merge; retrying once after 5 s" ;;
        *) say "base branch was modified during merge; retrying once after 5 s" ;;
      esac
      sleep 5
      if ! merge_err="$(gh pr merge "$pr" --repo "$repo" --squash --match-head-commit "$pin" 2>&1)"; then
        printf '%s\n' "$merge_err" >&2
        merge_failed=1
      else
        [ -z "$merge_err" ] || printf '%s\n' "$merge_err" >&2
      fi
      ;;
    *) die_after_ready 1 "gh pr merge failed" ;;
  esac
else
  [ -z "$merge_err" ] || printf '%s\n' "$merge_err" >&2
fi
merged="" sha=""
for i in $(seq 1 12); do
  IFS=$'\t' read -r state sha < <(gh pr view "$pr" --repo "$repo" --json state,mergeCommit \
    --jq '[.state, (.mergeCommit.oid // "-")] | @tsv' 2>/dev/null || true) || true
  if [ "${state:-}" = "MERGED" ]; then merged=1; break; fi
  [ "$i" -lt 12 ] && sleep "${SHIP_PR_INTERVAL:-5}"
done
[ -n "$merged" ] || { [ -n "$merge_failed" ] && die 1 "gh pr merge failed"; die 1 "merge status could not be confirmed after 12 polls; worktree left in place"; }

# Step 9: clean up from the common git dir, never from inside the worktree being removed.
common="$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)"
cd "$common"
# When the caller's shell started inside the worktree, removing it would break
# that shell (getcwd fails), so keep the worktree and its branch and say how
# to remove them by hand. The remote branch is still deleted.
case "$start_dir/" in
  "$worktree"/*)
    say "worktree kept: your shell is inside it; remove it with: $(printf 'git -C %q worktree remove %q && git -C %q branch -D %q' "$common" "$worktree" "$common" "$branch")" ;;
  *)
    git --git-dir="$common" worktree remove "$worktree" >&2 || say "cleanup: worktree remove failed for $worktree"
    git --git-dir="$common" branch -D "$branch" >&2 || say "cleanup: branch -D $branch failed" ;;
esac
# A missing remote ref counts as done, whatever the push error says: GitHub's
# auto-delete on merge makes the push fail with "cannot lock ref".
if ! del_out="$(git --git-dir="$common" push origin --delete "$branch" 2>&1)"; then
  ls_rc=0
  git --git-dir="$common" ls-remote --exit-code --heads origin "refs/heads/$branch" >/dev/null 2>&1 || ls_rc=$?
  [ "$ls_rc" -eq 2 ] || say "cleanup: push origin --delete $branch failed: $del_out"
fi

# Step 10
echo "merged $sha"
