#!/usr/bin/env bash
# ship-pr: run a reviewed PR's merge tail in one command.
# Usage: ship-pr <pr> --repo OWNER/NAME --reviewed <sha> --worktree <path> [--gate '<cmd>'] [--merge-check '<cmd>'] [--timeout <s>] [--body-has <prefix>]... [--body-ends <text>] [--outside-plan <path>]... [--known-flake <ticket>...] [--by <who>] [--unverified-fixes <findings file>] [--allow-commit-closes] [--keep-branch] [--no-mutants-label <reason>] [--mutants-gate]
#        Run it after review-loop has a verdict on <sha>. In order: check the PR is
#        open and its head branch is checked out clean in --worktree, waiting up to
#        60 s for GitHub's head to match the local HEAD; require a matching
#        review-pr verdict for --reviewed (the head the last verdict covers;
#        APPROVE on every axis, FIX-OK from a scoped verify, or FIX-INCOMPLETE
#        with readable, non-empty P3-only findings; each P3 is filed or matched
#        to an open issue and linked from the PR immediately before merge;
#        --unverified-fixes permits a no-real-bug
#        fix round after either CHANGES or FIX-INCOMPLETE); require each --body-has
#        line and run pr-closes (see below); run --gate in the worktree on that head,
#        once, before any merge or push; merge origin/main when required (see below);
#        compare the reviewed patch with the new head's diff against origin/main by
#        `git patch-id --stable`, ignoring context lines (with --unverified-fixes, a
#        mismatch posts a comment and goes on, see below); push the merge commit with
#        a plain fast-forward push. For drafts, snapshot run ids on the pinned
#        head before `gh pr ready`; after ready, wait up to 120 s for a new
#        `pull_request` run on that head. If none appears, assume no ready workflow
#        is configured and continue (a later BLOCKED merge then most likely means
#        the ready run was dispatched late: rerun ship-pr rather than triage). Once
#        one appears, list every 5 s until 15 s pass with no new run (inside the
#        same 120 s) and wait for every new run to complete (one deadline, bounded by
#        --timeout) before `gh-ci wait`, so an older
#        green run cannot satisfy the wait. `gh-ci wait` (--timeout, default 7200),
#        rerunning failed jobs once when the failure is outside the diff (see below);
#        on a non-strict base with --gate, or --merge-check when --gate is absent,
#        check the PR merged with current origin/main in a throwaway merge commit
#        (step 7); squash-merge pinned to the checked head, retrying once on a base
#        race or GraphQL error
#        and re-entering the merge once after the merge lost the race to origin/main
#        in strict mode (no extra sleep, sharing the 3 retries);
#        polling MERGED even after a failed retry; wait for MERGED; by default
#        remove the worktree and local branch by default after a merge when
#        clean and no process has its cwd inside. Keep them when --keep-branch
#        is set, the body says Refs #N without a closing line, the caller's cwd
#        is inside the worktree, it is dirty, or lsof is unavailable, errors,
#        or finds a process inside. The remote branch is still deleted.
#        After a confirmed merge of aakshintala/switchyard, fast-forward ~/.agents
#        only when it is on main with no tracked changes or local commits; untracked
#        files are allowed. If skipped, print its lag and leave the merge successful.
#        The CI wait trusts the repo's required checks: one green on the exact
#        head counts after the ready_for_review run has completed (when one appeared),
#        and a run that starts after the wait passed does not hold the merge. An
#        absent required check is pending. To keep a draft run from satisfying
#        the wait, give its check a name other than the required one (fiber's
#        draft run reports `CI (draft)`; the required check is `CI`).
#        Each --body-has <prefix> (repeatable) requires a PR body line that starts
#        with <prefix>, literally and case-sensitively; it is checked after step 1,
#        before the merge, and each missing one prints `missing body line: <prefix>`.
#        When the prefix is exactly `Implemented by:`, every such line must hold
#        model ids (comma-separated items, none empty after trimming, none
#        `unknown` in any letter case); each bad line prints `bad body line: <line>`.
#        --body-ends <text> requires the body's last non-blank line to equal
#        <text> exactly, literally and case-sensitively. A blank line is empty
#        or whitespace-only (after stripping a trailing CR), so trailing blank
#        lines are ignored; a body with no non-blank line fails. It is checked
#        in the same block and prints `body does not end with (--body-ends): <text>`.
#        --outside-plan <path> (repeatable) requires each recorded path in the
#        body's `Outside-plan files` section as `- <path> — <reason>`; it also
#        accepts `- <path> - <reason>` and `- \`<path>\`: <reason>`. A path may
#        have one pair of surrounding backticks. The reason must be non-blank
#        and on that same line. This check is opt-in; an empty recorded list
#        needs no section.
#        Always, the PR body and each PR comment whose first line starts with
#        `Review round closed` (the review record; other comments are not read) are
#        scanned for authority claims: a line with
#        `per the ruling`, `owner ruled`, `approved by` or similar, outside code spans,
#        fenced blocks and `>` quotes, must cite #<n>, a URL or <doc>:<line> on the same line,
#        or in the same bullet, as the claim, else it prints `uncited authority: <line>` and exits 5.
#        When the repo defines a `mutants` label (`gh label list`), a draft PR
#        must carry it before ship-pr marks it ready, so mutants run on the
#        draft from the first push; a repo without the label is not checked,
#        and neither is a PR that is already ready. A draft without the label
#        exits 5. --no-mutants-label <reason> skips this legacy check and prints
#        the reason; --mutants-gate still requires its label or completed-run proof.
#        --mutants-gate opts in to requiring a draft's `mutants` label or a
#        completed run on the pinned head whose Selection job log contains
#        `mutants in the diff: 0`; an in-progress or absent run fails before ready.
#        Step 2 runs pr-closes just after the --body-has check, before any gate,
#        merge, push or CI wait. With --allow-commit-closes, a stray match whose
#        report's second field is `commit <sha>` is printed to stderr as a warning
#        and does not fail; a title or body match still exits 5. Without the flag
#        every stray match exits 5. Both repos that use ship-pr squash with the PR
#        title and body as the commit message, so a commit message keyword never
#        reaches main.
#        When `gh-ci wait` fails on the pinned head, ship-pr reads `gh-ci failures
#        --pr <pr>` and, only when the failure is outside the diff, reruns each failed
#        or cancelled run on the pinned head with `gh run rerun <run id> --failed`,
#        once per invocation, then waits again with the same --timeout. Outside the
#        diff means every failed or cancelled job was cancelled (a job that hits its
#        timeout-minutes reports as cancelled), or every failed job logged a
#        `panicked at <path>:<line>` location and none of those paths is in
#        `git diff --name-only origin/main...<pin>`. A failed job with no panic
#        location counts as inside the diff and is never rerun. A failed read of a
#        run's attempt before the rerun exits 1 naming the run with gh's exit code
#        and stderr; a failed rerun exits 1 naming the run. After rerunning,
#        ship-pr polls each rerun run until its
#        attempt passes the pre-rerun one before waiting again; no new attempt
#        within 120 s exits 1 naming the run.
#        Prints `merged <squash sha>` on success. A `gh pr merge` error containing
#        `GraphQL` retries once like `Base branch was modified`, sleeping 5 s first.
#        ship-pr prints gh's merge output without any sentence that mentions
#        `--auto` or `--admin`, keeping the rest of the line; it never relays gh's
#        merge hints. If a failed merge reports `mergeStateStatus` BLOCKED, ship-pr
#        also names pending or failing workflow runs on the pinned head, with each
#        run's name, id, status and conclusion when available.
#        An error saying the head branch is not up to date with the base branch
#        re-enters the merge, push and CI-wait steps once in strict mode (counted
#        against the 3 retries), after checking `gh pr view` for MERGED; a second
#        loss, an unmoved main, or no retries left exits 1 with `lost the race to
#        origin/main` and the rerun command. After a failed retry of any kind ship-pr
#        still polls for MERGED, since GitHub sometimes merges despite the error,
#        and exits 1 saying the merge command failed only when the poll never sees MERGED.
#        Progress goes to stderr, and so do
#        gh-ci's check counts while CI runs.
#        After marking a draft PR ready, each later failure before `gh pr merge` says
#        that nothing merged and the PR is still marked ready. If MERGED is not confirmed
#        after the merge attempt, the error says the merge status could not be confirmed.
#        --known-flake <ticket>... is opt-in only with --by flywheel. If the gate
#        is red, CI must be green on the exact pinned head; each test name must be
#        named in a supplied open ticket's body or a comment, bare or behind its own
#        crate as `<crate>::<test>`; no file in its Cargo crate
#        directory may be in the PR diff; and a fresh gate must have failed
#        only on parsed test failures. The gate must be fail-fast and end in a
#        nextest run: its raw exit status must be 100, and the final Summary's
#        failed, timed-out and leak-failed count must match distinct failing tests.
#        The keyword scan also rejects leaked-process and other non-test output.
#        Only `FAIL`, `TIMEOUT`, `SIG*`, and `LEAK*` statuses open test-output
#        blocks; `PASS`, `SKIP`, `START`, `FLAKY`, and `SLOW` close them. After
#        the final `Summary [`, only failing-test recaps, `error: test run failed`,
#        `== leak scan`, orphan-process warnings, scripts/check's full-output line,
#        and its `FAIL (exit 100)` line are allowed. Any other output refuses
#        known-flake; it is safe to use the normal merge path for other gates.
#        A known-flake refusal exits 5 as KNOWN-FLAKE. Nextest statuses `FAIL`, `TIMEOUT`, `SIGSEGV`, `SIGABRT`,
#        `LEAK`, and `LEAK-FAIL` name tests as `<crate>::<binary> <test>` and
#        resolve `<crate>` through Cargo metadata.
#        Once merged, the PR and each used ticket get an audit/sighting comment;
#        the failed gate output is retained for that acceptance.
#        Exit 0 merged, 1 gate/CI/push/merge failure (including `gh-ci wait` exit 4
#        when a required check never started, which needs a bound (`GH_CI_NO_JOBS_AFTER`);
#        ship-pr sets none. A gate run on the PR merged with current
#        origin/main counts as a gate failure unless --known-flake passes the same
#        acceptance checks on that output; a merge that lost the race
#        and cannot recover counts as a merge failure), 2 bad usage or a failed
#        precondition, 3 merge conflict (aborted), a conflict `gh-ci wait` found after the push,
#        or a conflict merging current origin/main on a non-strict base, 4 patch-id mismatch (needs a new
#        verdict; with --unverified-fixes, no exit 4), 5 PR text or review state needs a fix (missing --body-has lines, a bad --body-ends ending, a bad `Implemented by:` value, a draft missing the mutants label, an uncited authority claim in the body or a comment, stray closing keywords from pr-closes, or no approved review verdict: CHANGES needs a scoped verify; FIX-INCOMPLETE needs readable, non-empty P3-only findings or --unverified-fixes for a no-real-bug fix round), 124 CI wait timeout.
#        Merge rule, by whether main's required-status-checks rule is strict (a
#        ruleset's strict_required_status_checks_policy, or classic branch
#        protection's required_status_checks.strict; strict if either says so; a
#        failed lookup, other than a classic 404, falls back to strict). The mode is
#        printed once.
#        Strict: merge origin/main when it moved. When origin/main moves during the
#        CI wait, ship-pr goes back to the merge (merge, patch-id check, push and CI
#        wait again; no gate), at most 3 times; the 4th move exits 1. A merge that
#        lost the race re-enters the same steps, sharing the 3 retries.
#        Not strict: after the gate, read the PR's mergeable and mergeStateStatus;
#        merge origin/main (after refetching it) only on CONFLICTING or DIRTY. One CI
#        wait, no retry when origin/main moves; a conflict found after CI exits 3.
#        On every invocation, before step 3, delete only regular xcrun_db-* files directly under
#        ${TMPDIR:-/tmp} when they are over a day old; ignore deletion errors. With --gate,
#        require at least 20 GB free on the volumes holding --worktree and ${TMPDIR:-/tmp}.
#        Both gate runs set NEXTEST_RETRIES=1, retrying failed nextest tests once, unless
#        --worktree's .config/nextest.toml sets retries: then they unset NEXTEST_RETRIES
#        and leave the repo's own retry policy in charge.
#        Report each FLAKY result and its failed-attempt panic text; retries do not
#        change the gate's exit status.
#        With --gate or --merge-check, step 7 refetches origin/main after step 2: when it is not
#        an ancestor of the pinned head, merge it into the pinned head in a throwaway
#        commit in --worktree, run the selected check there, and restore the pinned head
#        whatever happens (nothing is pushed). A merge conflict exits 3; a failing check exits 1
#        after printing its last 20 lines, panic context outside that tail, and the path
#        to the full output saved under ${TMPDIR:-/tmp}/ship-pr-<pr>-gate.*. Passing checks
#        leave no log file. If origin/main moves during a passing --merge-check, rerun it
#        on the new tip up to three times; the fourth move exits 1. With --gate,
#        --merge-check is ignored. Without either flag the check is skipped.
#        --unverified-fixes <file> is for a fix round that answers no real bug (review-loop
#        step 3), so CHANGES or FIX-INCOMPLETE ships without a re-review. The file must be readable and hold a
#        non-blank line, else exit 2 before anything else. On a patch-id mismatch, once per
#        run and before the first push or CI wait, ship-pr posts a PR comment: a first line
#        naming the reviewed short sha, the file under `Findings:`, and `git diff --stat`
#        from the reviewed sha to the pinned head, limited to the files the repair commits
#        touch (a merge of main adds no base files), under `Changed since review:`. A failed
#        post exits 1 before any push. A match posts nothing. The gate and CI run as usual.
#        --timeout bounds each CI wait and the ready runs' completion wait (one
#        deadline shared by all of them). A draft may spend up to 120 s locating the
#        ready runs, plus up to 5 CI waits (the first,
#        three strict-mode retries and the one rerun); the 3 retries are one budget
#        shared with a merge that lost the race.
#        SHIP_PR_INTERVAL: seconds between MERGED polls (default 5, at most 12 polls).
set -euo pipefail

usage() {
  echo "usage: ship-pr <pr> --repo OWNER/NAME --reviewed <sha> --worktree <path> [--gate '<cmd>'] [--merge-check '<cmd>'] [--timeout <s>] [--body-has <prefix>]... [--body-ends <text>] [--outside-plan <path>]... [--known-flake <ticket>...] [--by <who>] [--unverified-fixes <findings file>] [--allow-commit-closes] [--keep-branch] [--no-mutants-label <reason>] [--mutants-gate]" >&2
  echo "       --known-flake requires a fail-fast gate ending in nextest (exit 100 for test failures)" >&2
  echo "       only FAIL/TIMEOUT/SIG*/LEAK* open output blocks; other statuses close them" >&2
  echo "       after the final Summary, only Fiber's scripts/check tail is accepted; other output refuses" >&2
  echo "       longest wait: 120 s to find the ready runs, their completion up to <timeout> s, 5 CI waits x <timeout> s, plus the gate; run it in the background with no shell timeout" >&2
  exit 2
}
say() { echo "ship-pr: $*" >&2; }
die() { local code="$1"; shift; say "$*"; exit "$code"; }
redact_body_file() {
  local source="$1" redacted
  redacted="$(mktemp "${TMPDIR:-/tmp}/ship-pr-redacted.XXXXXX")" || return 1
  if ! "$here/lib/redact-paths" <"$source" >"$redacted"; then
    rm -f "$redacted"
    return 1
  fi
  printf '%s' "$redacted"
}
refuse() {
  local family="$1" message="$2" mode="${3:-always}"
  if [ "$mode" = "ready-only" ]; then
    if [ "$pr_ready" = 1 ] && [ "$merge_attempted" = 0 ]; then
      say "$message; nothing merged, PR $pr is still marked ready"
    fi
  else
    say "$message"
  fi
  say "refused $family"
  refusal_in_progress=1
  exit 5
}
pr_ready=0 merge_attempted=0 refusal_in_progress=0
# worktree_clean: no tracked changes and no untracked files except the
# proptest-regressions/ seeds a gate run wrote (untracked, but not dirt).
worktree_clean() {
  [ -z "$(git -C "$worktree" status --porcelain | grep -v '^?? .*proptest-regressions/')" ]
}
fast_forward_agents() {
  local checkout="${HOME:-~}/.agents" branch behind reason old new
  if [ "$(git -C "$checkout" rev-parse --is-inside-work-tree 2>/dev/null)" != true ]; then
    say "$checkout: not fast-forwarded (behind unknown; not a git checkout)"
    return 0
  fi
  if ! git -C "$checkout" fetch -q origin refs/heads/main:refs/remotes/origin/main >/dev/null 2>&1; then
    say "$checkout: not fast-forwarded (behind unknown; fetch failed)"
    return 0
  fi
  behind="$(git -C "$checkout" rev-list --count HEAD..origin/main 2>/dev/null)" || behind=unknown
  branch="$(git -C "$checkout" branch --show-current 2>/dev/null)" || branch=""
  old="$(git -C "$checkout" rev-parse --short HEAD 2>/dev/null)" || old=unknown
  if [ "$branch" != main ]; then
    reason="branch=${branch:-detached}"
  elif [ -n "$(git -C "$checkout" status --porcelain --untracked-files=no 2>/dev/null)" ]; then
    reason="tracked changes"
  elif ! git -C "$checkout" merge-base --is-ancestor HEAD origin/main 2>/dev/null; then
    reason="local commits"
  elif ! git -C "$checkout" merge --ff-only origin/main >/dev/null 2>&1; then
    reason="fast-forward failed"
  else
    new="$(git -C "$checkout" rev-parse --short HEAD 2>/dev/null)" || new=unknown
    if [ "$new" != "$old" ]; then
      say "$checkout: fast-forwarded $old -> $new ($behind commits)"
    fi
    return 0
  fi
  case "$behind" in
    1) behind="1 commit" ;;
    unknown) ;;
    *) behind="$behind commits" ;;
  esac
  say "$checkout: not fast-forwarded (behind $behind; $reason)"
}
# fetch_retry: one bounded retry for a `git fetch` lost to a transient ref
# lock (another session pushing at the same time). 3 tries, 1 s apart.
fetch_retry() {
  local tries=0
  while :; do
    if git -C "$worktree" fetch -q "$@" >&2; then
      return 0
    fi
    tries=$((tries + 1))
    [ "$tries" -ge 3 ] && return 1
    sleep 1
  done
}
die_after_ready() {
  local code="$1"; shift
  if [ "$pr_ready" = 1 ] && [ "$merge_attempted" = 0 ]; then
    die "$code" "$*; nothing merged, PR $pr is still marked ready"
  fi
  die "$code" "$@"
}
exit_after_ready() {
  local code="$1"; shift
  if [ "$pr_ready" = 1 ] && [ "$merge_attempted" = 0 ]; then
    say "$*; nothing merged, PR $pr is still marked ready"
  fi
  exit "$code"
}

# authority_scan: read PR text on stdin and print `uncited authority: <line>` for
# each line that claims an authority (a ruling, an owner's call, an approval)
# with no citation in its unit. A unit is one line, or a bullet (`-`, `*`, `+`,
# `N.`) with the more indented non-bullet lines after it. Fenced blocks, `>`
# quotes and code spans are not scanned for claims. A record starting with 0x1e
# names a comment's URL, which is appended to the units below it; it resets the
# fence state. Sets authority_bad=1 on any hit.
auth_add() {
  local tick='`' s c
  s="$(printf '%s' "$1" | sed "s/${tick}[^${tick}]*${tick}//g")"
  c="$(printf '%s' "$1" | sed -E 's/[Pp][0-9] ?#[0-9]+//g')"
  auth_claim="$auth_claim $s"
  auth_cite="$auth_cite $c"
}
auth_has_pr_test_cite() {
  local raw="$1" candidate
  [ "${#pr_test_paths[@]}" -gt 0 ] || return 1
  while IFS= read -r candidate; do
    candidate="${candidate:1:${#candidate}-2}"
    [ -n "$candidate" ] || continue
    git -C "$worktree" grep -Fq -e "$candidate" "$head0" -- "${pr_test_paths[@]}" && return 0
  done < <(printf '%s\n' "$raw" | grep -oE '`[^`]+`' || true)
  return 1
}
# auth_flush: judge the open unit, then clear it.
auth_flush() {
  local lower asserts=0 negative=0 test_cite=0 cite='#[0-9]+|https?://|[A-Za-z0-9_./-]+:[0-9]+'
  [ -n "$auth_first" ] || return 0
  lower="$(printf '%s' "$auth_claim" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    *"per the ruling"*|*"per ruling"*|*"per the owner"*|*"owner ruled"*|*"owner-side ruling"*) asserts=1 ;;
    *"as ruled"*|*"approved by"*|*"accepted gap per"*|*"out of scope per"*) asserts=1 ;;
  esac
  case "$lower" in
    *"accepted gap per"*|*"out of scope per"*|*"ruled out"*|*"ruled-out"*|*"not in scope"*|*"not supported"*|*"excluded"*|*"rejected"*) negative=1 ;;
  esac
  if [ "$asserts" = 1 ] && ! [[ "$auth_cite" =~ $cite ]]; then
    if [ "$negative" = 1 ] && auth_has_pr_test_cite "$auth_unit_raw"; then
      test_cite=1
    fi
    if [ "$test_cite" = 0 ]; then
      echo "uncited authority: $auth_first$auth_src"
      authority_bad=1
    fi
  fi
  auth_first="" auth_first_raw="" auth_unit_raw="" auth_claim="" auth_cite="" auth_open=0
}
authority_scan() {
  local line text trimmed lead fenced=0 bullet='^[[:space:]]*([-*+]|[0-9]+\.)[[:space:]]'
  auth_first="" auth_first_raw="" auth_unit_raw="" auth_claim="" auth_cite="" auth_open=0 auth_indent=0 auth_src=""
  while IFS= read -r line || [ -n "$line" ]; do
    text="${line%$'\r'}"
    if [[ "$text" == $'\036'* ]]; then
      auth_flush
      auth_src=" (comment ${text#$'\036'})"
      fenced=0
      continue
    fi
    trimmed="${text#"${text%%[![:space:]]*}"}"
    case "$trimmed" in
      '```'*) auth_flush; fenced=$((1 - fenced)); continue ;;
      '>'*) auth_flush; continue ;;
    esac
    [ "$fenced" = 0 ] || continue
    if [ -z "$trimmed" ]; then
      # A blank line keeps an open bullet: a loose item's continuation may follow it.
      [ "$auth_open" = 1 ] || auth_flush
      continue
    fi
    lead="${text%%[![:space:]]*}"
    if [ "$auth_open" = 1 ] && [ "${#lead}" -gt "$auth_indent" ] && ! [[ "$text" =~ $bullet ]]; then
      auth_add "$text"
      auth_unit_raw+=$'\n'$text
      continue
    fi
    auth_flush
    auth_first="$text"
    auth_first_raw="$text"
    auth_unit_raw="$text"
    auth_add "$text"
    if [[ "$text" =~ $bullet ]]; then
      auth_open=1
      auth_indent="${#lead}"
    else
      auth_flush
    fi
  done
  auth_flush
}

report_flakes() {
  local output_file="$1" flaky_tests test_name
  flaky_tests="$(awk '
    {
      line = $0
      sub(/^[[:space:]]*/, "", line)
      if (line !~ /^FLAKY[[:space:]]/) next
      marker = index(line, ") ")
      if (marker) print substr(line, marker + 2)
    }
  ' "$output_file")"
  [ -n "$flaky_tests" ] || return 1
  while IFS= read -r test_name; do
    [ -n "$test_name" ] && say "FLAKY $test_name"
  done <<<"$flaky_tests"
  return 0
}

check_free_space() {
  local path="$1" disk_info available mount min_free_kb=20971520
  if ! disk_info="$(df -Pk "$path" 2>/dev/null | awk 'NR > 1 { print $4 "\t" $NF; exit }')"; then
    die 1 "cannot check free space on $path"
  fi
  IFS=$'\t' read -r available mount <<<"$disk_info" || true
  case "$available" in ''|*[!0-9]*) die 1 "cannot check free space on $path" ;; esac
  if [ "$available" -lt "$min_free_kb" ]; then
    say "only $((available / 1048576)) GB free on $mount; a gate needs 20 GB. Free space, then rerun."
    exit 1
  fi
}

gate_preflight() {
  local tmpdir="${TMPDIR:-/tmp}"
  check_free_space "$worktree"
  check_free_space "$tmpdir"
}

run_gate() {
  local output_file cargo_slot_dir check_cmd="${1:-$gate}" check_label="${2:-gate}" check_file_label
  check_file_label="${check_label// /-}"
  output_file="$(mktemp "${TMPDIR:-/tmp}/ship-pr-${pr}-${check_file_label}.XXXXXX")"
  cargo_slot_dir="$(mktemp -d "${TMPDIR:-/tmp}/ship-pr-cargo-slot.XXXXXX")"
  ln -s "$here/cargo-slot" "$cargo_slot_dir/cargo"
  if (cd "$worktree" || exit
    if grep -Eq '^[[:space:]]*retries[[:space:]]*=' .config/nextest.toml 2>/dev/null; then
      unset NEXTEST_RETRIES
    else
      export NEXTEST_RETRIES=1
    fi
    PATH="$cargo_slot_dir:$PATH" bash -c "$check_cmd" </dev/null) >"$output_file" 2>&1; then
    gate_raw_exit=0
    rm -rf "$cargo_slot_dir"
    gate_output_path=""
    if report_flakes "$output_file"; then
      GH_CI_LOG_LINES=0 bash "$here/gh-ci" panics <"$output_file" >&2
    fi
    rm -f "$output_file"
    return 0
  else
    gate_raw_exit=$?
  fi
  rm -rf "$cargo_slot_dir"
  gate_output_path="$output_file"
  report_flakes "$output_file" || true
  tail -n 20 "$output_file" || true
  GH_CI_LOG_LINES=20 bash "$here/gh-ci" panics <"$output_file"
  printf 'full %s output: %s\n' "$check_label" "$output_file"
  if [ "${#known_flakes[@]}" -gt 0 ]; then return 2; fi
  return 1
}

known_metadata_package_root() {
  local want="${1//-/_}" count manifest root
  count="$(jq -r --arg want "$want" '[.packages[]? | select((.name | gsub("-"; "_")) == $want)] | length' <<<"$known_cargo_metadata" 2>/dev/null)" \
    || return 1
  [ "$count" = 1 ] || return 1
  manifest="$(jq -r --arg want "$want" '.packages[]? | select((.name | gsub("-"; "_")) == $want) | .manifest_path' <<<"$known_cargo_metadata" 2>/dev/null)" \
    || return 1
  case "$manifest" in
    "$worktree"/Cargo.toml) root="." ;;
    "$worktree"/*/Cargo.toml) root="${manifest#"$worktree"/}"; root="${root%/Cargo.toml}" ;;
    *) return 1 ;;
  esac
  printf '%s\n' "$root"
}

known_nextest_failure_fields() {
  local line="$1" status identifier name
  if [[ "$line" =~ ^[[:space:]]*TRY[[:space:]]+[0-9]+[[:space:]]+(.*)$ ]]; then
    line="${BASH_REMATCH[1]}"
  fi
  if [[ "$line" =~ ^[[:space:]]*(FAIL|TIMEOUT|SIGSEGV|SIGABRT|LEAK)[[:space:]]+\[[^]]+\]([[:space:]]+\([[:space:]]*[0-9]+/[0-9]+\))?[[:space:]]+([^[:space:]]+)[[:space:]]+(.+)$ ]]; then
    status="${BASH_REMATCH[1]}"
    identifier="${BASH_REMATCH[3]}"
    name="${BASH_REMATCH[4]}"
  elif [[ "$line" =~ ^[[:space:]]*LEAK-FAIL([[:space:]]+\[[^]]+\])?([[:space:]]+\([[:space:]]*[0-9]+/[0-9]+\))?[[:space:]]+([^[:space:]]+)[[:space:]]+(.+)$ ]]; then
    status="LEAK-FAIL"
    identifier="${BASH_REMATCH[3]}"
    name="${BASH_REMATCH[4]}"
  else
    return 1
  fi
  [ -n "$identifier" ] && [ -n "$name" ] || return 1
  printf '%s\t%s\t%s\n' "$status" "$identifier" "$name"
}

known_is_nextest_failure_line() {
  [[ "$1" =~ ^[[:space:]]*(TRY[[:space:]]+[0-9]+[[:space:]]+)?(FAIL|TIMEOUT|SIGSEGV|SIGABRT|LEAK|LEAK-FAIL)[[:space:]]+\[ ]]
}

known_add_test() {
  local binary="$1" name="$2" package="$3" i
  [ -n "$name" ] || return 0
  for i in "${!known_red_tests[@]}"; do
    [ "${known_red_tests[$i]}" = "$name" ] \
      && [ "${known_red_binaries[$i]}" = "$binary" ] \
      && [ "${known_red_packages[$i]}" = "$package" ] && return 0
  done
  known_red_tests+=("$name")
  known_red_binaries+=("$binary")
  known_red_packages+=("$package")
}

known_parse_gate() {
  local output_file="$1" line binary name package identifier fields status
  known_red_tests=() known_red_binaries=() known_red_packages=()
  known_unnamed_failures=0
  while IFS= read -r line || [ -n "$line" ]; do
    if known_is_nextest_failure_line "$line"; then
      if fields="$(known_nextest_failure_fields "$line")"; then
        IFS=$'\t' read -r status identifier name <<<"$fields"
        binary="$identifier"
        package=""
        if [[ "$identifier" == *::* ]]; then
          package="${identifier%%::*}"
          binary="${identifier#*::}"
        else
          package="$identifier"
          binary=""
        fi
        known_add_test "$binary" "$name" "$package"
      else
        known_unnamed_failures=$((known_unnamed_failures + 1))
      fi
    fi
  done <"$output_file"
}

known_load_metadata() {
  local metadata
  if metadata="$(cd "$worktree" && cargo metadata --format-version 1 --no-deps 2>/dev/null)" \
    && jq -e '.packages | type == "array"' >/dev/null 2>&1 <<<"$metadata"; then
    known_cargo_metadata="$metadata"
    return 0
  fi
  if [ -n "${HOME:-}" ] && [ -x "$HOME/.cargo/bin/cargo" ] \
    && metadata="$(cd "$worktree" && "$HOME/.cargo/bin/cargo" metadata --format-version 1 --no-deps 2>/dev/null)" \
    && jq -e '.packages | type == "array"' >/dev/null 2>&1 <<<"$metadata"; then
    known_cargo_metadata="$metadata"
    return 0
  fi
  return 1
}

known_is_nextest_output_header() {
  [[ "$1" =~ ^[[:space:]]*(stdout|stderr)[[:space:]]+───[[:space:]]*$ ]] \
    || [[ "$1" =~ ^[[:space:]]*---[[:space:]]+(STDOUT|STDERR): ]]
}

known_is_nextest_status_line() {
  [[ "$1" =~ ^[[:space:]]*(TRY[[:space:]]+[0-9]+[[:space:]]+)?(PASS|SKIP|START|FLAKY|SLOW)([[:space:]]|$) ]]
}

known_is_nextest_summary_line() {
  [[ "$1" =~ ^[[:space:]]*Summary[[:space:]]+\[ ]]
}

known_is_nextest_summary_boundary() {
  [[ "$1" =~ ^[[:space:]]*FAIL[[:space:]]*$ ]] \
    || [[ "$1" =~ ^[[:space:]]*Summary([[:space:]]|$) ]] \
    || [[ "$1" =~ ^[[:space:]]*-{4,}[[:space:]]*$ ]] \
    || [[ "$1" =~ ^[[:space:]]*─{4,}[[:space:]]*$ ]]
}

known_is_cargo_libtest_line() {
  [[ "$1" =~ ^[[:space:]]*test[[:space:]]+.+[[:space:]]+[.][.][.][[:space:]]+FAILED$ ]] \
    || [[ "$1" =~ ^[[:space:]]*----[[:space:]].+[[:space:]]+(stdout|stderr)[[:space:]]+----$ ]] \
    || [[ "$1" =~ ^[[:space:]]*test[[:space:]]+result:[[:space:]]+FAILED ]]
}

known_gate_summary_failure_count() {
  local output_file="$1" line count found="" summary_seen=0
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^[[:space:]]*Summary[[:space:]] ]]; then
      summary_seen=1
      count=0
      if [[ "$line" =~ ([0-9]+)[[:space:]]+failed([,[:space:]]|$) ]]; then count=$((count + BASH_REMATCH[1])); fi
      if [[ "$line" =~ ([0-9]+)[[:space:]]+timed[[:space:]]+out([,[:space:]]|$) ]]; then count=$((count + BASH_REMATCH[1])); fi
      if [[ "$line" =~ ([0-9]+)[[:space:]]+leak-fail([,[:space:]]|$) ]]; then count=$((count + BASH_REMATCH[1])); fi
      found="$count"
    fi
  done <"$output_file"
  [ "$summary_seen" = 1 ] || return 1
  printf '%s\n' "$found"
}

known_gate_has_libtest_output() {
  local output_file="$1" line in_test_block=0 after_summary=0
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$after_summary" = 1 ] && known_is_nextest_failure_line "$line"; then
      continue
    fi
    if known_is_nextest_failure_line "$line"; then
      in_test_block=1
      continue
    fi
    if known_is_nextest_status_line "$line"; then
      in_test_block=0
      continue
    fi
    if known_is_nextest_summary_boundary "$line"; then
      in_test_block=0
      if known_is_nextest_summary_line "$line"; then after_summary=1; fi
      continue
    fi
    if [ "$in_test_block" = 1 ] && known_is_nextest_output_header "$line"; then
      continue
    fi
    [ "$in_test_block" = 1 ] && continue
    known_is_cargo_libtest_line "$line" && return 0
  done <"$output_file"
  return 1
}

known_gate_has_other_failure() {
  local output_file="$1" line trimmed lower fields status identifier test_name line_no=0 last_summary_line=0 i matched
  local in_test_block=0
  local -a parsed_before_summary=()
  [ "${known_unnamed_failures:-0}" -eq 0 ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    line_no=$((line_no + 1))
    known_is_nextest_summary_line "$line" && last_summary_line="$line_no"
  done <"$output_file"
  [ "$last_summary_line" -gt 0 ] || return 0

  line_no=0
  while IFS= read -r line || [ -n "$line" ]; do
    line_no=$((line_no + 1))
    trimmed="${line#"${line%%[![:space:]]*}"}"
    trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"
    if [ "$line_no" -gt "$last_summary_line" ]; then
      [ -z "$trimmed" ] && continue
      [[ "$trimmed" =~ ^─+$ ]] && continue
      if known_is_nextest_failure_line "$trimmed"; then
        fields="$(known_nextest_failure_fields "$trimmed")" || return 0
        IFS=$'\t' read -r status identifier test_name <<<"$fields"
        matched=0
        for i in "${!parsed_before_summary[@]}"; do
          if [ "${parsed_before_summary[$i]}" = "$test_name" ]; then matched=1; break; fi
        done
        [ "$matched" = 1 ] || return 0
        continue
      fi
      case "$trimmed" in
        'error: test run failed'|'== leak scan'|'scripts/check: FAIL (exit 100)') continue ;;
        'warning: orphan process '*|'scripts/check: full output in '*) continue ;;
        *) return 0 ;;
      esac
    fi

    if known_is_nextest_failure_line "$line"; then
      fields="$(known_nextest_failure_fields "$line")" || return 0
      IFS=$'\t' read -r status identifier test_name <<<"$fields"
      parsed_before_summary+=("$test_name")
      in_test_block=1
      continue
    fi
    if known_is_nextest_status_line "$line"; then
      in_test_block=0
      continue
    fi
    if known_is_nextest_summary_boundary "$line"; then
      in_test_block=0
      continue
    fi
    if [ "$in_test_block" = 1 ] && known_is_nextest_output_header "$line"; then
      continue
    fi
    if [ "$in_test_block" = 1 ]; then
      lower="$(printf '%s' "$trimmed" | tr '[:upper:]' '[:lower:]')"
      case "$lower" in
        'diff in '*|*' leaked process'*|*'process leak'*|*'leaked child process'*|*'unreaped process'*|*'leftover process'*|*'processes remain'*|*'process remained'*|*'process still running'*|*'processes still running'*|*'child process still running'*|*'doctest failed'*|*'doc test failed'*|*'documentation check failed'*|*'rustdoc error'*) return 0 ;;
      esac
      continue
    fi
    known_is_cargo_libtest_line "$line" && return 0
    lower="$(printf '%s' "$line" | tr '[:upper:]' '[:lower:]')"
    case "$lower" in
      'diff in '*|*' leaked process'*|*'process leak'*|*'leaked child process'*|*'unreaped process'*|*'leftover process'*|*'processes remain'*|*'process remained'*|*'process still running'*|*'processes still running'*|*'child process still running'*|*'doctest failed'*|*'doc test failed'*|*'documentation check failed'*|*'rustdoc error'*) return 0 ;;
      *'error: test failed'*|*'error: test run failed'*|summary*test*fail*|fail) continue ;;
    esac
    case "$lower" in
      *'panicked at'*|*'assertion failed'*|*'assertion left'*) return 0 ;;
    esac
    if [[ "$lower" == *error* || "$lower" == *fail* || "$lower" == *failure* ]]; then
      return 0
    fi
  done <"$output_file"
  return 1
}

known_ci_run_id() {
  local runs
  runs="$(gh run list --repo "$repo" --commit "$pin" --limit 100 \
    --json databaseId,headSha,status,conclusion,workflowName,name,createdAt 2>/dev/null)" || return 1
  jq -r --arg head "$pin" '[.[] | select(.headSha == $head and .status == "completed" and (.conclusion == "success" or .conclusion == "skipped" or .conclusion == "neutral"))] | sort_by(.createdAt // "") | last | .databaseId // empty' <<<"$runs" 2>/dev/null
}

known_flake_accept() {
  local output_file="$1" gate_exit="$2" gate_head="$3" expected_gate_head="$4" pin="$5" ci_run="$6"
  local actual_head test crate ticket_data ticket_state name_found closed_ticket chosen
  local base diff_paths gate_base i j found=0 package package_root diff_path red_test_names summary_failures distinct_failures
  local -a chosen_tickets=()

  actual_head="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq '.headRefOid' 2>/dev/null)" \
    || refuse KNOWN-FLAKE "known-flake check 1 failed: cannot confirm CI on pinned head $pin"
  [ "$actual_head" = "$pin" ] \
    || refuse KNOWN-FLAKE "known-flake check 1 failed: CI was not confirmed on exact pinned head $pin (PR head is $actual_head)"
  [ -n "$ci_run" ] || ci_run="$(known_ci_run_id)"
  [ -n "$ci_run" ] \
    || refuse KNOWN-FLAKE "known-flake check 1 failed: CI is not green on exact pinned head $pin or its run id is unavailable"
  known_ci_run="$ci_run"

  if known_gate_has_libtest_output "$output_file"; then
    refuse KNOWN-FLAKE "known-flake: gate output is cargo libtest; only nextest gates are supported"
  fi
  if [ "$gate_exit" -gt 128 ] && [ "$gate_exit" -lt 256 ]; then
    refuse KNOWN-FLAKE "known-flake check 4 failed: gate was terminated by signal (exit $gate_exit)"
  fi
  [ "$gate_exit" -eq 100 ] \
    || refuse KNOWN-FLAKE "known-flake check 4 failed: gate exit status was $gate_exit, not nextest's test-failure status 100"
  known_parse_gate "$output_file"
  summary_failures="$(known_gate_summary_failure_count "$output_file")" \
    || refuse KNOWN-FLAKE "known-flake check 4 failed: gate has no final nextest Summary with a failure count"
  distinct_failures=0
  for i in "${!known_red_tests[@]}"; do
    found=0
    for j in "${!known_red_tests[@]}"; do
      [ "$j" -ge "$i" ] && break
      [ "${known_red_tests[$j]}" = "${known_red_tests[$i]}" ] && found=1 && break
    done
    [ "$found" = 1 ] || distinct_failures=$((distinct_failures + 1))
  done
  [ "$summary_failures" -eq "$distinct_failures" ] \
    || refuse KNOWN-FLAKE "known-flake check 4 failed: final nextest Summary reports $summary_failures failing tests but $distinct_failures distinct failures were parsed"

  # Check 2: require an exact name on an open ticket in the PR's repository.
  # The name may carry the red test's own crate as a `<crate>::` prefix
  # (`-` read as `_`, as in a Rust path); no other prefix widens the match.
  for i in "${!known_red_tests[@]}"; do
    test="${known_red_tests[$i]}"
    crate="${known_red_packages[$i]}"
    name_found=0 closed_ticket="" chosen=""
    for ticket in "${known_flakes[@]}"; do
      ticket_data="$(gh issue view "$ticket" --repo "$repo" --json state,body,comments 2>/dev/null)" \
        || refuse KNOWN-FLAKE "known-flake check 2 failed: cannot read ticket #$ticket for red test '$test'"
      ticket_state="$(jq -r '.state // ""' <<<"$ticket_data")"
      if [ "$(jq -r --arg test "$test" --arg crate "$crate" '
        def has_test_name($text; $name):
          ($name | length) as $n
          | [range(0; ($text | length)) as $i
             | select($text[$i:($i + $n)] == $name)
             | select($i == 0 or (($text[($i - 1):$i] | test("[A-Za-z0-9_:]")) | not))
             | select(($i + $n) >= ($text | length) or (($text[($i + $n):($i + $n + 1)] | test("[A-Za-z0-9_:]")) | not))
            ] | length > 0;
        def has_any_name($text):
          has_test_name($text; $test)
          or ($crate != "" and (has_test_name($text; $crate + "::" + $test)
            or has_test_name($text; ($crate | gsub("-"; "_")) + "::" + $test)));
        has_any_name(.body // "") or any(.comments[]?; has_any_name(.body // ""))
      ' <<<"$ticket_data")" = true ]; then
        name_found=1
        if [ "$ticket_state" = OPEN ]; then chosen="$ticket"; break; else closed_ticket="$ticket"; fi
      fi
    done
    if [ -z "$chosen" ]; then
      [ "$name_found" = 1 ] \
        || refuse KNOWN-FLAKE "known-flake check 2 failed: red test '$test' is not named in any supplied ticket"
      if [ -n "$closed_ticket" ]; then
        refuse KNOWN-FLAKE "known-flake check 2 failed: red test '$test' is named by closed ticket #$closed_ticket"
      fi
      refuse KNOWN-FLAKE "known-flake check 2 failed: no supplied ticket naming red test '$test' is OPEN"
    fi
    chosen_tickets+=("$chosen")
  done

  # Check 3: resolve each test's Cargo package directory and reject any diff path inside it.
  base="$(git -C "$worktree" merge-base origin/main "$pin" 2>/dev/null)" \
    || refuse KNOWN-FLAKE "known-flake check 3 failed: cannot find the PR diff base for pinned head $pin"
  diff_paths="$(git -C "$worktree" diff --name-only --no-renames "$base...$pin" 2>/dev/null)" \
    || refuse KNOWN-FLAKE "known-flake check 3 failed: cannot read the PR diff for pinned head $pin"
  if [ "${#known_red_tests[@]}" -gt 0 ]; then
    red_test_names="${known_red_tests[*]}"
    known_load_metadata \
      || refuse KNOWN-FLAKE "known-flake check 3 failed: cannot run cargo metadata in the worktree to resolve red tests: $red_test_names"
  fi
  for i in "${!known_red_tests[@]}"; do
    package="${known_red_packages[$i]}"
    [ -n "$package" ] \
      || refuse KNOWN-FLAKE "known-flake check 3 failed: red test '${known_red_tests[$i]}' could not be resolved to a crate by cargo metadata"
    package_root="$(known_metadata_package_root "$package" 2>/dev/null)" \
      || refuse KNOWN-FLAKE "known-flake check 3 failed: red test '${known_red_tests[$i]}' could not be resolved to a crate by cargo metadata"
    while IFS= read -r diff_path || [ -n "$diff_path" ]; do
      [ -n "$diff_path" ] || continue
      if [ "$package_root" = . ] || [[ "$diff_path" == "$package_root" || "$diff_path" == "$package_root/"* ]]; then
        refuse KNOWN-FLAKE "known-flake check 3 failed: red test '${known_red_tests[$i]}' maps to crate directory $package_root, which contains diff path $diff_path"
      fi
    done <<<"$diff_paths"
  done

  # Check 4: the ship's failed gate must be the fresh run on the checked-out head,
  # and every failure in its saved output must be a parsed test failure.
  [ -f "$output_file" ] && [ "$gate_head" = "$expected_gate_head" ] \
    || refuse KNOWN-FLAKE "known-flake check 4 failed: gate did not run fresh on checked head $expected_gate_head"
  [ "${#known_red_tests[@]}" -gt 0 ] \
    || refuse KNOWN-FLAKE "known-flake check 4 failed: gate had no parsed test failures (build or non-test failure)"
  if known_gate_has_other_failure "$output_file"; then
    refuse KNOWN-FLAKE "known-flake check 4 failed: gate output contains a build or other non-test failure"
  fi

  gate_base="$(git -C "$worktree" merge-base origin/main "$gate_head" 2>/dev/null)" \
    || refuse KNOWN-FLAKE "known-flake check 4 failed: cannot verify the fresh gate head $gate_head"
  [ -n "$gate_base" ] || refuse KNOWN-FLAKE "known-flake check 4 failed: cannot verify the fresh gate head $gate_head"
  if [ "$known_acceptance_used" = 1 ] && [ "$known_report_pin" != "$pin" ]; then
    known_report_tests=() known_report_binaries=() known_report_tickets=() known_report_outputs=() known_ticket_ids=()
  fi
  known_acceptance_used=1
  known_report_pin="$pin"
  known_diff_paths="$diff_paths"
  for i in "${!known_red_tests[@]}"; do
    known_report_tests+=("${known_red_tests[$i]}")
    known_report_binaries+=("${known_red_binaries[$i]}")
    known_report_tickets+=("${chosen_tickets[$i]}")
    known_report_outputs+=("$output_file")
    ticket="${chosen_tickets[$i]}"
    found=0
    for j in "${!known_ticket_ids[@]}"; do
      if [ "${known_ticket_ids[$j]}" = "$ticket" ]; then found=1; break; fi
    done
    [ "$found" = 1 ] || known_ticket_ids+=("$ticket")
  done
}

post_known_flake_comments() {
  local pr_body ticket_body redacted_body ticket path i rc=0
  local -a paths=()
  [ "$known_acceptance_used" = 1 ] || return 0
  while IFS= read -r path || [ -n "$path" ]; do [ -n "$path" ] && paths+=("$path"); done <<<"$known_diff_paths"
  pr_body="$(mktemp "${TMPDIR:-/tmp}/ship-pr-${pr}-known-flake-pr.XXXXXX")" \
    || die 1 "cannot create known-flake PR comment"
  {
    printf 'Known-flake merge accepted with --by flywheel.\n\nHead SHA: %s\nCI run id: %s\n\nRed tests:\n' "$pin" "$known_ci_run"
    for i in "${!known_report_tests[@]}"; do
      printf -- '- %s — ticket #%s — gate output: %s — CI run id: %s' "${known_report_tests[$i]}" "${known_report_tickets[$i]}" "${known_report_outputs[$i]}" "$known_ci_run"
      [ -z "${known_report_binaries[$i]}" ] || printf ' (binary %s)' "${known_report_binaries[$i]}"
      printf '\n'
    done
    printf '\nDiff paths:\n'
    if [ "${#paths[@]}" -eq 0 ]; then printf -- '- (none)\n'; else printf -- '- %s\n' "${paths[@]}"; fi
    printf "\nThe script checked the red tests' crate directories against the diff; flywheel judged that the PR touches nothing the tests exercise.\n"
  } >"$pr_body"
  redacted_body="$(redact_body_file "$pr_body")" \
    || die 1 "cannot redact known-flake PR comment"
  gh pr comment "$pr" --repo "$repo" --body-file "$redacted_body" >&2 || rc=$?
  rm -f "$pr_body" "$redacted_body"
  [ "$rc" = 0 ] || die 1 "cannot post the known-flake audit comment on PR $pr after merge"

  for ticket in "${known_ticket_ids[@]}"; do
    ticket_body="$(mktemp "${TMPDIR:-/tmp}/ship-pr-${pr}-known-flake-ticket.XXXXXX")" \
      || die 1 "cannot create known-flake ticket comment"
    {
      printf 'Sighting from PR #%s.\n\nHead SHA: %s\nCI run id: %s\n\n' "$pr" "$pin" "$known_ci_run"
      for i in "${!known_report_tests[@]}"; do
        [ "${known_report_tickets[$i]}" = "$ticket" ] || continue
        printf -- '- Red test %s — gate output: %s' "${known_report_tests[$i]}" "${known_report_outputs[$i]}"
        [ -z "${known_report_binaries[$i]}" ] || printf ' (binary %s)' "${known_report_binaries[$i]}"
        printf '\n'
      done
    } >"$ticket_body"
    redacted_body="$(redact_body_file "$ticket_body")" \
      || die 1 "cannot redact known-flake ticket comment"
    rc=0
    gh issue comment "$ticket" --repo "$repo" --body-file "$redacted_body" >&2 || rc=$?
    rm -f "$ticket_body" "$redacted_body"
    [ "$rc" = 0 ] || die 1 "cannot post the known-flake sighting on ticket #$ticket after merge"
  done
}

[ $# -ge 1 ] || usage
ship_args=("$@")
pr="$1"; shift
case "$pr" in ''|*[!0-9]*) usage ;; esac
repo="" reviewed="" worktree="" gate="" merge_check="" timeout=7200 body_has=() body_ends="" outside_plan=() known_flakes=() known_by="" known_by_seen="" unverified="" allow_commit_closes="" keep_branch="" no_mutants_label="" mutants_gate=""
while [ $# -gt 0 ]; do
  case "$1" in
    --known-flake)
      shift
      count=0
      while [ $# -gt 0 ] && [[ "$1" != --* ]]; do
        case "$1" in ''|*[!0-9]*) usage ;; esac
        known_flakes+=("$1")
        count=$((count + 1))
        shift
      done
      [ "$count" -gt 0 ] || usage
      continue ;;
    --by)
      [ "$#" -ge 2 ] && [ -z "$known_by_seen" ] || usage
      [ -n "$2" ] && [[ "$2" != *$'\n'* ]] || usage
      known_by="$2"
      known_by_seen=1
      shift 2
      continue ;;
  esac
  case "$1" in
    --allow-commit-closes) allow_commit_closes=1; shift; continue ;;
    --keep-branch) keep_branch="requested by --keep-branch"; shift; continue ;;
    --mutants-gate) mutants_gate=1; shift; continue ;;
  esac
  [ $# -ge 2 ] || usage
  case "$1" in
    --repo) repo="$2" ;;
    --reviewed) reviewed="$2" ;;
    --worktree) worktree="$2" ;;
    --gate) gate="$2" ;;
    --merge-check) merge_check="$2" ;;
    --timeout) timeout="$2" ;;
    --body-has) case "$2" in ''|*$'\n'*) usage ;; esac; body_has+=("$2") ;;
    --body-ends) case "$2" in ''|*$'\n'*) usage ;; esac; body_ends="$2" ;;
    --outside-plan) case "$2" in ''|*$'\n'*) usage ;; esac; outside_plan+=("$2") ;;
    --unverified-fixes) [ -n "$2" ] || usage; unverified="$2" ;;
    --no-mutants-label) [ -n "$2" ] || usage; no_mutants_label="$2" ;;
    *) usage ;;
  esac
  shift 2
done
[ -n "$repo" ] && [ -n "$reviewed" ] && [ -n "$worktree" ] || usage
case "$timeout" in ''|*[!0-9]*) usage ;; esac
if [ "${#known_flakes[@]}" -gt 0 ] && [ "$known_by" != flywheel ]; then
  refuse KNOWN-FLAKE "--known-flake requires --by flywheel"
fi
gate_output_path="" gate_red_output="" gate_red_head="" gate_raw_exit=0 known_acceptance_used=0 known_ci_run="" known_diff_paths="" known_report_pin=""
declare -a known_report_tests=() known_report_binaries=() known_report_tickets=() known_report_outputs=() known_ticket_ids=()
if [ -n "$unverified" ]; then
  [ -f "$unverified" ] && [ -r "$unverified" ] || die 2 "cannot read --unverified-fixes $unverified"
  grep -q '[^[:space:]]' "$unverified" || die 2 "--unverified-fixes $unverified has no findings"
fi

effective_timeout=$((10#$timeout))
if [ -n "${CLAUDECODE:-}" ] && [ "$effective_timeout" -lt 600 ]; then
  effective_timeout=7200
fi
longest_wait=$((5 * effective_timeout))
longest_hours=$((longest_wait / 3600))
say "no shell timeout: waits are bounded at ${longest_wait} s (${longest_hours} h), worst case; a clean run takes minutes"

tmpdir="${TMPDIR:-/tmp}"
find -H "$tmpdir" -maxdepth 1 -type f -name 'xcrun_db-*' -mmin +1440 -delete >/dev/null 2>&1 || true

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
here="$(cd "$(dirname "$script_path")" && pwd)"
. "$here/lib/verify-section.sh"
# rerun_cmd rebuilds this invocation against this file for the lost-race diagnostic.
rerun_cmd="$(printf '%q ' bash "$here/$(basename "$0")" ${ship_args[@]+"${ship_args[@]}"})"
rerun_cmd="${rerun_cmd% }"

# Step 1: the PR is open, its branch is checked out clean at the PR head.
info="$(gh pr view "$pr" --repo "$repo" --json state,headRefName,headRefOid,isDraft \
  --jq '[.state, .headRefName, .headRefOid, .isDraft] | @tsv')" \
  || die 2 "cannot read PR $pr in $repo"
IFS=$'\t' read -r state branch head0 draft <<<"$info"
[ "$state" = "OPEN" ] || die 2 "PR $pr is $state, not OPEN"
worktree="$(cd "$worktree" 2>/dev/null && pwd -P)" || die 2 "no such worktree: $worktree"
start_dir="$(pwd -P)"
git -C "$worktree" rev-parse --is-inside-work-tree >/dev/null 2>&1 || die 2 "$worktree is not a git checkout"
[ "$(git -C "$worktree" symbolic-ref --short -q HEAD || true)" = "$branch" ] \
  || die 2 "$worktree does not have $branch checked out"
worktree_clean || die 2 "$worktree has uncommitted changes"
fetch_retry origin || die 1 "git fetch origin failed"
local_head="$(git -C "$worktree" rev-parse HEAD)"
if [ "$local_head" != "$head0" ]; then
  for _wait in $(seq 1 30); do
    sleep 2
    head0="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid 2>/dev/null)" \
      || die 2 "cannot read PR $pr in $repo"
    [ "$local_head" = "$head0" ] && break
  done
fi
[ "$local_head" = "$head0" ] \
  || die 2 "$worktree HEAD is not the PR head $head0; pull or push first"
git -C "$worktree" rev-parse --verify -q "$reviewed^{commit}" >/dev/null \
  || die 2 "--reviewed $reviewed is not a commit in $worktree"

# Required PR body lines: checked now so a PR with wrong text costs no push and no CI wait.
if [ "${#body_has[@]}" -gt 0 ] || [ -n "$body_ends" ] || [ "${#outside_plan[@]}" -gt 0 ]; then
  body="$(gh pr view "$pr" --repo "$repo" --json body --jq '.body // ""')" \
    || die 2 "cannot read PR $pr body"
  missing=0
  for prefix in ${body_has[@]+"${body_has[@]}"}; do
    found=""
    while IFS= read -r line || [ -n "$line" ]; do
      case "${line%$'\r'}" in "$prefix"*) found=1; break ;; esac
    done <<<"$body"
    [ -n "$found" ] || { echo "missing body line: $prefix"; missing=1; }
  done
  # An `Implemented by:` line must hold model ids: every comma-separated item
  # is non-empty after trimming whitespace, and no item is `unknown` in any
  # letter case. Every such line is checked; a bad one prints its text.
  bad=0
  for prefix in ${body_has[@]+"${body_has[@]}"}; do
    [ "$prefix" = "Implemented by:" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
      text="${line%$'\r'}"
      case "$text" in "Implemented by:"*) ;; *) continue ;; esac
      rest="${text#Implemented by:},"
      while [ -n "$rest" ]; do
        item="${rest%%,*}"
        rest="${rest#*,}"
        trimmed="$(printf '%s' "$item" | tr -d '[:space:]')"
        lowered="$(printf '%s' "$trimmed" | tr '[:upper:]' '[:lower:]')"
        if [ -z "$trimmed" ] || [ "$lowered" = "unknown" ]; then
          echo "bad body line: $text"
          bad=1
          break
        fi
      done
    done <<<"$body"
  done
  # The body's last non-blank line must equal --body-ends exactly. Blank
  # means empty or whitespace-only after stripping a trailing CR; the
  # compare is a literal string compare, so glob and case syntax in the
  # text stays literal.
  if [ -n "$body_ends" ]; then
    last=""
    while IFS= read -r line || [ -n "$line" ]; do
      text="${line%$'\r'}"
      stripped="${text//[[:space:]]/}"
      [ -z "$stripped" ] && continue
      last="$text"
    done <<<"$body"
    [ "$last" = "$body_ends" ] || { echo "body does not end with (--body-ends): $body_ends"; missing=1; }
  fi
  if [ "${#outside_plan[@]}" -gt 0 ]; then
    for path in "${outside_plan[@]}"; do
      found=0 reason=0 missing_reason=0 in_section=0
      while IFS= read -r line || [ -n "$line" ]; do
        text="${line%$'\r'}"
        if [[ "$text" =~ ^[[:space:]]*#{1,6}[[:space:]]+Outside-plan[[:space:]]+files[[:space:]]*$ ]]; then
          in_section=1
          continue
        fi
        if [[ "$text" =~ ^[[:space:]]*#{1,6}[[:space:]]+ ]]; then
          in_section=0
          continue
        fi
        [ "$in_section" -eq 1 ] || continue
        entry="${text#"${text%%[![:space:]]*}"}"
        case "$entry" in
          '- '*) entry="${entry#- }" ;;
          '* '*) entry="${entry#\* }" ;;
          *) continue ;;
        esac
        matched=0
        for candidate in "$path" "\`$path\`"; do
          if [ "$entry" = "$candidate" ]; then
            found=1
            missing_reason=1
            matched=1
            break
          fi
          for separator in ' — ' ' - ' ': '; do
            prefix="$candidate$separator"
            case "$entry" in
              "$prefix"*)
                found=1
                matched=1
                detail="${entry#"$prefix"}"
                if [ -n "${detail//[[:space:]]/}" ]; then reason=1; else missing_reason=1; fi
                break 2
                ;;
            esac
          done
        done
        if [ "$matched" -eq 0 ]; then
          for candidate in "$path" "\`$path\`"; do
            case "$entry" in
              "$candidate "*|"$candidate"$'\t'*) found=1; missing_reason=1 ;;
            esac
          done
        fi
      done <<<"$body"
      if [ "$found" -eq 0 ]; then
        echo "missing outside-plan path: $path"
        missing=1
      elif [ "$reason" -eq 0 ] || [ "$missing_reason" -eq 1 ]; then
        echo "outside-plan path has no one-line reason: $path"
        missing=1
      fi
    done
  fi
  [ "$missing" = 0 ] && [ "$bad" = 0 ] || refuse BODY "PR body lacks required lines; edit the PR body, then rerun"
fi

# Authority claims in the body and in the round-closed comments, checked on every
# run. Only a comment whose first line starts with `Review round closed` is the
# review record; other comments are not scanned. Comment records start with a
# record separator (0x1e) and the URL.
body_text="$(gh pr view "$pr" --repo "$repo" --json body --jq '.body // ""')" \
  || die 2 "cannot read PR $pr body"
if grep -Eiq '^[[:space:]]*([-*][[:space:]]*)?refs[[:space:]]+#[0-9]+([[:space:]]|$)' <<<"$body_text" \
  && ! grep -Eiq '^[[:space:]]*([-*][[:space:]]*)?(close[sd]?|fix(e[sd])?|resolve[sd]?):?[[:space:]]+([[:alnum:]_.-]+/)?#[0-9]+([[:space:]]|$)' <<<"$body_text"; then
  [ -n "$keep_branch" ] || keep_branch="PR body references an issue without a closing line"
fi
pr_test_list="$(mktemp)" || die 1 "cannot create a temp file"
git -C "$worktree" diff --name-only -z --diff-filter=ACMRT "origin/main...$head0" -- 'test/**' 'tests/**' '**/test/**' '**/tests/**' '*.test.*' '*.spec.*' '*_test.*' >"$pr_test_list" \
  || { rm -f "$pr_test_list"; die 1 "cannot inspect test paths on PR head $head0"; }
# One literal pathspec per changed test file, NUL-delimited end to end, so a
# path with spaces, glob or control characters names exactly that file.
pr_test_paths=()
while IFS= read -r -d '' p; do pr_test_paths+=(":(literal)$p"); done <"$pr_test_list"
rm -f "$pr_test_list"
authority_bad=0
authority_scan <<<"$body_text"
comments_text="$(gh api --paginate "repos/$repo/issues/$pr/comments" \
  --jq '.[] | select(((.body // "") | sub("^ +"; "") | split("\n") | .[0] | ascii_downcase | startswith("review round closed"))) | "\u001e" + .html_url + "\n" + (.body // "")')" \
  || die 2 "cannot read comments on PR $pr in $repo"
authority_scan <<<"$comments_text"
[ "$authority_bad" = 0 ] || refuse BODY "PR text claims authority without a citation on the same line or in the same bullet; cite it there (#<n>, comment URL or <doc>:<line>) or drop the claim, then rerun"

# A draft carries the mutants label when the repo defines one, so mutants
# run on the draft from the first push. Checked here, beside --body-has, so
# a draft with no map costs no push and no CI wait. A repo without the label
# is not checked.
if [ -z "$mutants_gate" ]; then
  if [ -n "$no_mutants_label" ]; then
    say "skipping the mutants-label check: $no_mutants_label"
  elif [ "$draft" = "true" ]; then
    repo_labels="$(gh api --paginate "repos/$repo/labels?per_page=100" --jq '.[].name')" \
      || die 2 "cannot read labels in $repo"
    if grep -qx 'mutants' <<<"$repo_labels"; then
      pr_labels="$(gh pr view "$pr" --repo "$repo" --json labels --jq '.labels[].name')" \
        || die 2 "cannot read PR $pr labels"
      grep -qx 'mutants' <<<"$pr_labels" \
        || refuse LABEL "PR lacks the mutants label; open it with --label mutants or pass --no-mutants-label <reason>"
    fi
  fi
fi

# Step 2: no stray closing keywords, before any gate, merge, push or CI wait.
rc=0
closes_out="$(bash "$here/pr-closes" "$pr" --repo "$repo" 2>/dev/null)" || rc=$?
case "$rc" in
  0) ;;
  1)
    if [ -n "$allow_commit_closes" ]; then
      stray_text=""
      while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        case "$line" in
          *" commit "*) say "warning: allowing $line" ;;
          *) stray_text="${stray_text}${line}
" ;;
        esac
      done <<<"$closes_out"
      if [ -n "$stray_text" ]; then
        printf '%s' "$stray_text"
        refuse BODY "pr-closes found stray closing keywords" ready-only
      fi
    else
      printf '%s\n' "$closes_out"
      refuse BODY "pr-closes found stray closing keywords" ready-only
    fi
    ;;
  *) die_after_ready 1 "pr-closes failed (exit $rc)" ;;
esac

# Posts the unverified-fixes comment (step 5). Nothing is pushed if it fails.
post_unverified() {
  local pin="$1" short stat body redacted_body rc=0 f
  local files=()
  short="$(git -C "$worktree" rev-parse --short "$reviewed")" || die_after_ready 1 "cannot name $reviewed"
  # The stat covers the repair commits' files only: a merge of main would list the base's changes.
  while IFS= read -r -d '' f; do
    if [ -n "$f" ]; then files+=("$f"); fi
  done < <(git -C "$worktree" log --first-parent --no-merges --name-only -z --format= "$reviewed..$pin" | sort -zu)
  stat=""
  # Never an empty pathspec: that would stat every file. Only merge commits leave stat empty.
  if [ "${#files[@]}" -gt 0 ]; then
    stat="$(git -C "$worktree" diff --stat "$reviewed..$pin" -- "${files[@]}")" || die_after_ready 1 "cannot diff $reviewed..$pin"
  fi
  body="$(mktemp "${TMPDIR:-/tmp}/ship-pr-comment.XXXXXX")"
  {
    printf 'Fixes since %s shipped without re-review (review-loop step 3: no real bug in round one).\n\n' "$short"
    printf 'Findings:\n'
    cat "$unverified"
    printf '\n\nChanged since review:\n%s\n' "$stat"
  } >"$body"
  redacted_body="$(redact_body_file "$body")" \
    || die_after_ready 1 "cannot redact the unverified-fixes comment"
  gh pr comment "$pr" --repo "$repo" --body-file "$redacted_body" >&2 || rc=$?
  rm -f "$body" "$redacted_body"
  [ "$rc" = 0 ] || die_after_ready 1 "cannot post the unverified-fixes comment on PR $pr; nothing pushed"
  say "posted the unverified-fixes comment on PR $pr"
}

patch_id() {
  local id
  id="$(git -C "$worktree" diff -U0 "origin/main...$1" | git patch-id --stable | awk '{print $1}')"
  echo "${id:-none}"
}

review_patch_id() {
  local id
  id="$(git -C "$worktree" diff "origin/main...$1" | git patch-id --stable | awk '{print $1}')"
  echo "${id:-none}"
}

# review_verdict REPO PR PATCH_ID: print approved, unverified, changes,
# incomplete, incomplete-p3, missing or invalid for the newest review-pr comment.
# On FIX-INCOMPLETE, return the readable P3 findings from that posted verify comment.
review_verdict() {
  local repo="$1" pr="$2" reviewed_pid="$3" rows tab last created id header verdicts axes axis body64 findings_file
  local -a axis_list=()
  rows="$(gh api --paginate "repos/$repo/issues/$pr/comments" --jq '
    .[] | select((.body // "") | startswith("review-pr: patch-id")) |
    . as $comment |
    ($comment.body | split("\n")) as $lines |
    ($lines[1:] | reduce .[] as $raw (
      {section:"", axes:[], verdicts:[]};
      ($raw | gsub("[*`]"; "") | gsub("^\\s+|\\s+$"; "")) as $line |
      if ($line | test("^## (standards|spec|overbuild|verify)([[:space:]]|$)")) then
        ($line | capture("^## (?<section>standards|spec|overbuild|verify)").section) as $section |
        .section = $section |
        if ($section == "standards" or $section == "spec" or $section == "overbuild") then .axes += [$section] else . end
      elif $line == "VERDICT standards: APPROVE" then .verdicts += ["standards:APPROVE"]
      elif $line == "VERDICT standards: CHANGES" then .verdicts += ["standards:CHANGES"]
      elif $line == "VERDICT spec: APPROVE" then .verdicts += ["spec:APPROVE"]
      elif $line == "VERDICT spec: CHANGES" then .verdicts += ["spec:CHANGES"]
      elif $line == "VERDICT overbuild: APPROVE" then .verdicts += ["overbuild:APPROVE"]
      elif $line == "VERDICT overbuild: CHANGES" then .verdicts += ["overbuild:CHANGES"]
      elif .section == "overbuild" and $line == "VERDICT: APPROVE" then .verdicts += ["overbuild:APPROVE"]
      elif .section == "overbuild" and $line == "VERDICT: CHANGES" then .verdicts += ["overbuild:CHANGES"]
      elif .section == "verify" and ($line | test("^FIX-OK($|\\s)")) then .verdicts += ["verify:FIX-OK"]
      elif .section == "verify" and ($line | test("^FIX-INCOMPLETE($|\\s)")) then .verdicts += ["verify:FIX-INCOMPLETE"]
      elif ($line | test("^(VERDICT|FIX-)")) then .verdicts += ["INVALID"]
      else . end
    )) as $parsed |
    [$comment.created_at, ($comment.id | tostring), $lines[0],
      ($parsed.verdicts | if length == 0 then "-" else join(",") end),
      ($parsed.axes | unique | if length == 0 then "-" else join(",") end),
      ($comment.body | @base64)] | @tsv
  ' )" || return 1
  tab="$(printf '\t')"
  last="$(printf '%s\n' "$rows" | sort -t "$tab" -k1,1 -k2,2n \
    | { grep -E "^.*${tab}review-pr: patch-id ${reviewed_pid}, head [0-9a-f]{40}(,.*)?${tab}" || true; } | tail -n 1)"
  [ -n "$last" ] || { printf 'missing'; return 0; }
  IFS=$'\t' read -r created id header verdicts axes body64 <<<"$last"
  case ",$verdicts," in *,INVALID,*) printf 'invalid'; return 0 ;; esac
  if [[ ",$verdicts," == *,verify:FIX-OK,* ]]; then
    [ "$verdicts" = "verify:FIX-OK" ] && printf 'approved' || printf 'invalid'
    return 0
  fi
  case ",$verdicts," in *,verify:FIX-INCOMPLETE,*)
    if [ -n "$unverified" ]; then
      printf 'unverified'
    else
      findings_file="$(mktemp "${TMPDIR:-/tmp}/ship-pr-${pr}-findings.XXXXXX")" || { printf 'incomplete'; return 0; }
      if parse_p3_verify_findings "$body64" "$findings_file"; then
        printf 'incomplete-p3\n'
        cat "$findings_file"
      else
        printf 'incomplete'
      fi
      rm -f "$findings_file"
    fi
    return 0 ;;
  esac
  [ "$axes" != "-" ] || { printf 'missing'; return 0; }
  IFS=',' read -r -a axis_list <<<"$axes"
  for axis in "${axis_list[@]}"; do
    case ",$verdicts," in *",$axis:APPROVE,"*|*",$axis:CHANGES,"*) ;; *) printf 'invalid'; return 0 ;; esac
  done
  case ",$verdicts," in
    *":CHANGES,"*)
      # The documented no-real-bug path ships a reviewed CHANGES round without
      # re-review, but only when the caller supplies --unverified-fixes.
      [ -n "$unverified" ] && printf 'unverified' || printf 'changes';;
    *":APPROVE,"*) printf 'approved';;
    *) printf 'missing';;
  esac
}

parse_p3_verify_findings() {
  local encoded="$1" output="$2" decoded="${2}.comment" line count=0 decoded_ok=1 valid=1 result=1
  if ! printf '%s' "$encoded" | base64 -D >"$decoded" 2>/dev/null; then
    if ! printf '%s' "$encoded" | base64 -d >"$decoded" 2>/dev/null; then
      decoded_ok=0
    fi
  fi
  if [ "$decoded_ok" = 1 ]; then
    : >"$output"
    while IFS= read -r line || [ -n "$line" ]; do
      # A finding is a line that starts with a priority token once markup and any
      # list marker are gone; prose that mentions a fixed P1 or P2 is not one.
      line="$(printf '%s' "$line" | tr -d '*`' | sed -E -e 's/^[[:space:]]*//' -e 's/^([-+]|[0-9]+[.)])[[:space:]]+//' -e 's/[[:space:]]*$//')"
      if [[ "$line" =~ ^P[0-9]([^[:alnum:]_]|$) ]]; then
        if [[ "$line" =~ ^P3[[:space:]]+[^[:space:]] ]]; then
          printf '%s\n' "$line" >>"$output"
          count=$((count + 1))
        else
          valid=0
          break
        fi
      fi
    done < <(verify_section_lines <"$decoded")
    [ "$valid" = 1 ] && [ "$count" -gt 0 ] && result=0
  fi
  rm -f "$decoded"
  [ "$result" = 0 ]
}

reviewed_patch_id="$(review_patch_id "$reviewed")"
review_result="$(review_verdict "$repo" "$pr" "$reviewed_patch_id")" \
  || die 1 "cannot read review-pr comments on PR $pr in $repo"
review_state="${review_result%%$'\n'*}"
review_findings=""
[ "$review_state" != "incomplete-p3" ] || review_findings="${review_result#*$'\n'}"
case "$review_state" in
  approved|unverified) ;;
  missing) refuse REVIEW "no review-pr verdict for --reviewed patch-id $reviewed_patch_id" ;;
  changes) refuse REVIEW "last review-pr verdict for --reviewed patch-id $reviewed_patch_id is CHANGES; complete a scoped verify, or use --unverified-fixes <findings file> only for a no-real-bug fix round" ;;
  incomplete) refuse REVIEW "last scoped verify for --reviewed patch-id $reviewed_patch_id is FIX-INCOMPLETE with unreadable, empty, or non-P3-only findings; complete a scoped verify, or use --unverified-fixes <findings file> only for a no-real-bug fix round" ;;
  incomplete-p3) ;;
  *) refuse REVIEW "invalid or incomplete review-pr verdict for --reviewed patch-id $reviewed_patch_id" ;;
esac

file_p3_findings() {
  local body_file links_file redacted_body finding detail issue_json issue_number issue_url title i
  local -a seen_findings=() seen_issues=()
  body_file="$(mktemp "${TMPDIR:-/tmp}/ship-pr-${pr}-issue.XXXXXX")" \
    || die_after_ready 1 "cannot create an issue body for P3 findings"
  links_file="$(mktemp "${TMPDIR:-/tmp}/ship-pr-${pr}-links.XXXXXX")" \
    || die_after_ready 1 "cannot create a PR comment for P3 findings"
  : >"$links_file"
  while IFS= read -r finding || [ -n "$finding" ]; do
    [ -n "$finding" ] || continue
    # Redact once, so the title, the search query, the dedup match and the
    # posted body all see the same text.
    finding="$(printf '%s\n' "$finding" | "$here/lib/redact-paths")" \
      || die_after_ready 1 "cannot redact P3 finding"
    detail="${finding#P3 }"
    title="$detail"
    if [ "${#title}" -gt 220 ]; then title="${title:0:217}..."; fi
    title="P3: $title"
    issue_number=""
    for i in "${!seen_findings[@]}"; do
      if [ "${seen_findings[$i]}" = "$finding" ]; then
        issue_number="${seen_issues[$i]}"
        break
      fi
    done
    if [ -z "$issue_number" ]; then
      issue_json="$(gh issue list --repo "$repo" --state open --search "$finding" --json number,title,body --limit 100)" \
        || die_after_ready 1 "cannot search open issues for P3 finding: $finding"
      issue_number="$(jq -r --arg finding "$finding" --arg title "$title" '[.[] | select(((.body // "" | split("\n") | index($finding)) != null) or .title == $finding or .title == $title) | .number] | first // empty' <<<"$issue_json")" \
        || die_after_ready 1 "cannot read open issues matching P3 finding: $finding"
      if [ -z "$issue_number" ]; then
        {
          printf 'Open P3 finding from scoped verify for PR #%s.\n\n' "$pr"
          printf '%s\n' "$finding"
        } >"$body_file"
        redacted_body="$(redact_body_file "$body_file")" \
          || die_after_ready 1 "cannot redact P3 finding issue body"
        issue_url="$(gh issue create --repo "$repo" --title "$title" --body-file "$redacted_body")" \
          || { rm -f "$redacted_body"; die_after_ready 1 "cannot file P3 finding as an issue: $finding"; }
        rm -f "$redacted_body"
        issue_number="${issue_url##*/}"
      fi
      case "$issue_number" in ''|*[!0-9]*) die_after_ready 1 "no valid issue number for P3 finding: $finding" ;; esac
      seen_findings+=("$finding")
      seen_issues+=("$issue_number")
    fi
    issue_url="https://github.com/$repo/issues/$issue_number"
    printf -- '- [#%s](%s): %s\n' "$issue_number" "$issue_url" "$finding" >>"$links_file"
  done <<<"$review_findings"
  {
    printf 'Open P3 findings from the scoped verify are tracked as issues:\n\n'
    cat "$links_file"
  } >"$body_file"
  redacted_body="$(redact_body_file "$body_file")" \
    || die_after_ready 1 "cannot redact P3 issue links comment"
  if ! gh pr comment "$pr" --repo "$repo" --body-file "$redacted_body" >&2; then
    rm -f "$body_file" "$links_file" "$redacted_body"
    die_after_ready 1 "cannot link P3 finding issues from PR $pr"
  fi
  rm -f "$body_file" "$links_file" "$redacted_body"
}

p3_issues_filed=0

# Whether main's required checks are strict. Any lookup error other than a classic
# rule's 404 (no classic rule) counts as strict: the old behaviour, costing only CI time.
strict_checks() {
  local out
  if ! out="$(gh api "repos/$repo/rules/branches/main" \
    --jq '[.[] | select(.type == "required_status_checks") | .parameters.strict_required_status_checks_policy] | any' 2>/dev/null)"; then
    say "cannot read whether required checks on main are strict; assuming strict"; return 0
  fi
  [ "$out" != "true" ] || return 0
  if ! out="$(gh api "repos/$repo/branches/main/protection/required_status_checks" --jq .strict 2>&1)"; then
    case "$out" in *"HTTP 404"*) return 1 ;; esac
    say "cannot read whether required checks on main are strict; assuming strict"; return 0
  fi
  [ "$out" = "true" ]
}
if strict_checks; then
  strict=1; say "required checks on main are strict: merging origin/main when it moved"
else
  strict=0; say "required checks on main are not strict: merging only on a conflict"
fi

merge_main() {
  say "merging $branch with origin/main"
  if ! git -C "$worktree" merge --no-ff --no-edit origin/main >&2; then
    git -C "$worktree" merge --abort >&2 || true
    die_after_ready 3 "merge of origin/main conflicts; resolve it, then rerun"
  fi
}

# Rerun CI once when the failure is outside the diff (step 6). Shared across the
# strict-mode retry loop: at most one rerun per invocation.
ci_rerun_done=""
ci_outside_reason() {
  local failures headers failed_headers cancelled_headers cancelled_names panic_paths diff_files
  failures="$(GH_CI_REPO="$repo" bash "$here/gh-ci" failures --pr "$pr" 2>/dev/null)" || return 1
  [ -n "$failures" ] || return 1
  headers="$(printf '%s\n' "$failures" | grep '^=== ' || true)"
  [ -n "$headers" ] || return 1
  failed_headers="$(printf '%s\n' "$headers" | grep ': failure' || true)"
  cancelled_headers="$(printf '%s\n' "$headers" | grep ': cancelled' || true)"
  if [ -z "$failed_headers" ]; then
    [ -n "$cancelled_headers" ] || return 1
    cancelled_names="$(printf '%s\n' "$cancelled_headers" | sed -E 's/^=== .* \/ (.*): cancelled$/\1/' | sort -u | paste -sd ',' - | sed 's/,/, /g')"
    [ -n "$cancelled_names" ] || return 1
    printf 'cancelled jobs: %s' "$cancelled_names"
    return 0
  fi
  if ! printf '%s\n' "$failures" | awk '
    /^=== / {
      if (in_failed && !saw_panic) exit 1
      in_failed = ($0 ~ /: failure$/)
      saw_panic = 0
      next
    }
    in_failed && /panicked at [^[:space:]:]+:[0-9]+/ { saw_panic = 1 }
    END { if (in_failed && !saw_panic) exit 1 }
  '; then
    return 1
  fi
  panic_paths="$(printf '%s\n' "$failures" | grep -oE 'panicked at [^[:space:]:]+:[0-9]+' | sed -E 's/^panicked at //; s/:[0-9]+$//' | sort -u || true)"
  [ -n "$panic_paths" ] || return 1
  diff_files="$(git -C "$worktree" diff --name-only "origin/main...$pin" 2>/dev/null)" || return 1
  while IFS= read -r p || [ -n "$p" ]; do
    [ -n "$p" ] || continue
    if printf '%s\n' "$diff_files" | grep -qxF "$p"; then
      return 1
    fi
  done <<<"$panic_paths"
  printf 'panics at %s' "$(printf '%s\n' "$panic_paths" | paste -sd ',' - | sed 's/,/, /g')"
  return 0
}
ci_failed_run_ids() {
  local list ids
  list="$(gh run list --repo "$repo" --commit "$pin" --limit 100 --json databaseId,conclusion,workflowName,name,event 2>/dev/null)" || return 1
  ids="$(printf '%s' "$list" | jq -r '. as $all | ([.[] | {k: "\(.workflowName // .name // "")\u001f\(.event // "")" , id: .databaseId}] | group_by(.k) | map(max_by(.id).id)) as $newest | $all[] | select(.conclusion=="failure" or .conclusion=="cancelled") | select(.databaseId as $id | $newest | index($id)) | "\(.databaseId)"' 2>/dev/null)" || return 1
  [ -n "$ids" ] || return 1
  printf '%s\n' "$ids"
}

# Print the ids of `pull_request` runs on <head>, one per line.
pull_request_run_ids() {
  local run_list
  run_list="$(gh run list --repo "$repo" --commit "$1" --limit 100 --json databaseId,headSha,event 2>/dev/null)" || return 1
  jq -r --arg head "$1" '.[] | select(.headSha == $head and .event == "pull_request") | .databaseId | select(. != null) | tostring' <<<"$run_list" 2>/dev/null
}

# gh_err_text FILE: gh's stderr for a message. The first 400 bytes stay on
# one line; blank stderr reads (no stderr).
gh_err_text() {
  local text
  text="$(head -c 400 <"$1" | tr '\n\r' '  ')"
  case "$text" in *[![:space:]]*) ;; *) text="(no stderr)" ;; esac
  printf '%s' "$text"
}

# Wait for every workflow dispatched by ready_for_review, rather than trusting a
# green check from a run that already existed when the draft was marked ready.
# Ready can start several pull_request runs that are listed seconds apart, so
# after the first new run appears, list every 5 s until 15 s pass with none
# added, then wait on each new id.
wait_ready_for_review_run() {
  local head="$1" before_ids="$2" elapsed=0 run_ids id new_ids="" status
  while :; do
    run_ids="$(pull_request_run_ids "$head")" \
      || die_after_ready 1 "cannot read workflow runs after marking PR $pr ready"
    new_ids="$(grep -vxF -f <(printf '%s\n' "$before_ids") <<<"$run_ids" | grep -v '^$' || true)"
    [ -n "$new_ids" ] && break
    if [ "$elapsed" -ge 120 ]; then
      say "no new pull_request run on head ${head:0:8} appeared within 120 s after ready; proceeding to required-check wait. If the merge is later BLOCKED, the ready run was most likely dispatched late: rerun ship-pr rather than triage"
      return 0
    fi
    sleep 5
    elapsed=$((elapsed + 5))
  done
  # Listing continues until three quiet passes, up to 120 s from ready or
  # 15 s after the first sighting, whichever is later. A later run shows as
  # a BLOCKED merge, which names it.
  local more_ids quiet=0 settle_deadline
  settle_deadline=$(( elapsed + 15 > 120 ? elapsed + 15 : 120 ))
  while [ "$elapsed" -lt "$settle_deadline" ] && [ "$quiet" -lt 3 ]; do
    sleep 5
    elapsed=$((elapsed + 5))
    run_ids="$(pull_request_run_ids "$head")" \
      || die_after_ready 1 "cannot read workflow runs after marking PR $pr ready"
    more_ids="$(grep -vxF -f <(printf '%s\n' "$before_ids") <<<"$run_ids" | grep -v '^$' || true)"
    if [ "$more_ids" = "$new_ids" ]; then quiet=$((quiet + 1)); else quiet=0; new_ids="$more_ids"; fi
  done

  say "waiting for ready_for_review runs to finish: $(paste -sd ' ' - <<<"$new_ids")"
  elapsed=0
  for id in $new_ids; do
    local view_failures=0 view_err view_error view_rc
    view_err="$(mktemp "${TMPDIR:-/tmp}/ship-pr-${pr}-ready-run.XXXXXX")" \
      || die_after_ready 1 "cannot create a temp file for gh stderr"
    while :; do
      view_rc=0
      status="$(gh run view "$id" --repo "$repo" --json status --jq '.status' 2>"$view_err")" || view_rc=$?
      if [ "$view_rc" -eq 0 ]; then
        view_failures=0
      else
        status=""
        view_failures=$((view_failures + 1))
        if [ "$view_failures" -ge 3 ]; then
          view_error="$(gh_err_text "$view_err")"
          rm -f "$view_err"
          die_after_ready 1 "cannot read status of ready_for_review run $id after 3 attempts: gh exit $view_rc: $view_error"
        fi
      fi
      [ "$status" = "completed" ] && break
      if [ "$view_rc" -eq 0 ] && [ "$elapsed" -ge "$effective_timeout" ]; then
        rm -f "$view_err"
        die_after_ready 1 "ready_for_review run $id did not finish within the CI timeout (${effective_timeout} s)"
      fi
      sleep 5
      elapsed=$((elapsed + 5))
    done
    rm -f "$view_err"
    say "ready_for_review run $id finished"
  done
}

# gh's merge hint is not a ship-pr instruction. Drop each sentence that
# mentions `--auto` or `--admin`, keep the rest of its line (gh's reason),
# and drop a line left empty.
print_merge_error() {
  printf '%s\n' "$1" | awk '{ gsub(/[^.]*--(auto|admin)[^.]*\.?/, ""); sub(/[ \t]+$/, "") } $0 != ""' >&2
}

report_blocked_runs() {
  local runs details
  runs="$(gh run list --repo "$repo" --commit "$pin" --limit 100 --json databaseId,workflowName,name,headSha,status,conclusion,event 2>/dev/null)" \
    || { say "could not read workflow runs on pinned head ${pin:0:8}"; return 0; }
  details="$(jq -r --arg head "$pin" '
    .[] | select(.headSha == $head) |
    select((.status != "completed") or ((.conclusion // "") != "" and (.conclusion != "success" and .conclusion != "skipped" and .conclusion != "neutral"))) |
    "\(.workflowName // .name // "workflow") (run \(.databaseId // "unknown")): status=\(.status // "unknown"), conclusion=\(.conclusion // "unknown")"
  ' <<<"$runs" 2>/dev/null)" || { say "could not parse workflow runs on pinned head ${pin:0:8}"; return 0; }
  if [ -z "$details" ]; then
    say "no pending or failing workflow runs found on pinned head ${pin:0:8}"
    return 0
  fi
  while IFS= read -r detail || [ -n "$detail" ]; do
    [ -n "$detail" ] && say "blocking run: $detail"
  done <<<"$details"
}

show_merge_failure() {
  local error="$1" merge_state
  merge_state="$(gh pr view "$pr" --repo "$repo" --json mergeStateStatus --jq '.mergeStateStatus' 2>/dev/null)" || merge_state=""
  print_merge_error "$error"
  if [ "$merge_state" = "BLOCKED" ]; then
    say "merge is BLOCKED on pinned head ${pin:0:8}; pending or failing workflow runs:"
    report_blocked_runs
  fi
}

check_mutants_gate() {
  local pr_labels run_list latest run_id run_status job_id
  pr_labels="$(gh pr view "$pr" --repo "$repo" --json labels --jq '.labels[].name' 2>/dev/null)" \
    || refuse MUTANTS "mutants gate failed: cannot read PR labels"
  grep -qx 'mutants' <<<"$pr_labels" && return 0

  run_list="$(gh run list --repo "$repo" --commit "$pin" --limit 100 --json databaseId,status,conclusion,headSha,createdAt 2>/dev/null)" \
    || refuse MUTANTS "mutants gate failed: cannot read runs on PR head $pin"
  latest="$(jq -r --arg head "$pin" '[.[] | select(.headSha == $head)] | sort_by([.createdAt // "", .databaseId]) | last // empty | [.databaseId // "", .status // ""] | @tsv' <<<"$run_list" 2>/dev/null)" \
    || refuse MUTANTS "mutants gate failed: cannot read runs on PR head $pin"
  [ -n "$latest" ] || refuse MUTANTS "mutants gate failed: no completed Selection log on PR head $pin proves mutants in the diff: 0"
  IFS=$'\t' read -r run_id run_status <<<"$latest"
  [ "$run_status" = "completed" ] \
    || refuse MUTANTS "mutants gate failed: latest run on PR head $pin is not completed"

  job_id="$(gh run view "$run_id" --repo "$repo" --json jobs --jq '[.jobs[] | select(.name == "Selection") | .databaseId] | last // empty' 2>/dev/null)" \
    || refuse MUTANTS "mutants gate failed: cannot read Selection job from run $run_id"
  [ -n "$job_id" ] \
    || refuse MUTANTS "mutants gate failed: run $run_id has no Selection job"
  if gh run view "$run_id" --repo "$repo" --job "$job_id" --log 2>/dev/null \
    | grep -Eq '(^|[[:space:]])mutants in the diff: 0'$'\r''?$'; then
    return 0
  fi
  refuse MUTANTS "mutants gate failed: Selection log on run $run_id does not prove mutants in the diff: 0"
}

# Step 3: the gate runs once, on the PR head, before any merge or push. It checks
# code; it never changes what was reviewed. CI covers the merged head.
if [ -n "$gate" ]; then
  gate_preflight
  say "running gate"
  gate_rc=0
  run_gate || gate_rc=$?
  if [ "$gate_rc" -eq 2 ] && [ "${#known_flakes[@]}" -gt 0 ]; then
    gate_red_output="$gate_output_path"
    gate_red_head="$head0"
  elif [ "$gate_rc" -ne 0 ]; then
    die 1 "gate failed"
  fi
  [ "$(git -C "$worktree" rev-parse HEAD)" = "$head0" ] && worktree_clean \
    || die 1 "the gate changed the worktree; commit nothing from a gate"
fi

# Not strict: ask GitHub for a conflict now, after the gate (which takes minutes).
# main may have gained the conflicting commit meanwhile, so refetch before merging.
conflict=""
if [ "$strict" = 0 ]; then
  probe="$(gh pr view "$pr" --repo "$repo" --json mergeable,mergeStateStatus \
    --jq '[.mergeable, .mergeStateStatus] | @tsv' 2>/dev/null)" || probe=""
  [ -n "$probe" ] || say "cannot read PR $pr mergeability; not merging"
  case "$probe" in CONFLICTING*|*DIRTY) conflict=1 ;; esac
  if [ -n "$conflict" ]; then
    fetch_retry origin +refs/heads/main:refs/remotes/origin/main || die 1 "git fetch origin main failed"
  fi
fi

# Steps 4-6 repeat when origin/main moves during the CI wait (strict only), at most 3 times.
retries=0 unverified_posted="" lost_race_done=""
# lost_race_die exits 1 naming the lost race and the command that reruns it.
lost_race_die() {
  die_after_ready 1 "gh pr merge failed: lost the race to origin/main ($1); rerun: $rerun_cmd"
}
# The outer loop re-enters the merge when it loses the race to origin/main,
# sharing the 3 retries; every other path breaks out of it.
while :; do
  while :; do
    # Step 4: merge origin/main when it moved (strict) or on a reported conflict.
    if [ "$strict" = 1 ]; then
      git -C "$worktree" merge-base --is-ancestor origin/main HEAD || merge_main
    elif [ -n "$conflict" ]; then
      merge_main
    fi
    pin="$(git -C "$worktree" rev-parse HEAD)"
    if [ "$known_acceptance_used" = 1 ] && [ "$known_report_pin" != "$pin" ]; then
      known_report_tests=() known_report_binaries=() known_report_tickets=() known_report_outputs=() known_ticket_ids=()
      known_acceptance_used=0 known_report_pin="" known_ci_run="" known_diff_paths=""
    fi
    if [ "${#known_flakes[@]}" -gt 0 ] && [ -n "$gate_red_output" ] && [ "$gate_red_head" != "$pin" ]; then
      say "running gate on the pinned head after merging origin/main"
      gate_rc=0
      run_gate || gate_rc=$?
      if [ "$gate_rc" -eq 0 ]; then
        gate_red_output="" gate_red_head=""
      elif [ "$gate_rc" -eq 2 ]; then
        gate_red_output="$gate_output_path"
        gate_red_head="$pin"
      else
        die_after_ready 1 "gate failed on pinned head $pin"
      fi
      if [ "$(git -C "$worktree" rev-parse HEAD)" != "$pin" ] || ! worktree_clean; then
        die_after_ready 1 "the gate changed the worktree; commit nothing from a gate"
      fi
    fi
  
    # Step 5: the reviewed patch-id must match the new head's diff against origin/main (review-loop's Identity rule).
    if [ "$(patch_id "$reviewed")" != "$(patch_id "$pin")" ]; then
      [ -n "$unverified" ] || die_after_ready 4 "the new head's diff against origin/main has a different patch-id from --reviewed $reviewed; the change needs a new verdict: when the findings were answered by a recorded ruling with no code change, rerun with --unverified-fixes <findings file>; otherwise run a scoped verify (review-pr run --verify <findings file> --since $reviewed)"
      if [ -z "$unverified_posted" ]; then
        post_unverified "$pin"
        unverified_posted=1
      fi
    fi
  
    # Step 6: push the merged branch with a fast-forward push, then wait for CI on that head.
    if [ "$pin" != "$head0" ]; then
      say "pushing merged $branch"
      git -C "$worktree" push origin "HEAD:refs/heads/$branch" >&2 \
        || die_after_ready 1 "push of merged $branch failed"
    fi
    if [ "$draft" = "true" ]; then
      [ -z "$mutants_gate" ] || check_mutants_gate
      ready_runs_before="$(pull_request_run_ids "$pin")" \
        || die 1 "cannot read workflow runs before marking PR $pr ready"
      say "marking PR $pr ready"
      gh pr ready "$pr" --repo "$repo" >&2 || die 1 "gh pr ready failed"
      draft=false
      pr_ready=1
      wait_ready_for_review_run "$pin" "$ready_runs_before"
    fi
    say "waiting for CI"
    rc=0
    ci_out="$(GH_CI_REPO="$repo" bash "$here/gh-ci" wait "$pr" --timeout "$timeout")" || rc=$?
    if [ "$rc" -ne 0 ]; then
      printf '%s\n' "$ci_out"
      case "$rc" in
        124) [ -z "$gate_red_output" ] || refuse KNOWN-FLAKE "known-flake check 1 failed: CI is not green on exact pinned head $pin"; exit_after_ready 124 "CI timed out" ;;
        3) [ -z "$gate_red_output" ] || refuse KNOWN-FLAKE "known-flake check 1 failed: CI is not green on exact pinned head $pin"; die_after_ready 3 "PR conflicts with origin/main after the push; merge origin/main again, then rerun" ;;
        4) [ -z "$gate_red_output" ] || refuse KNOWN-FLAKE "known-flake check 1 failed: CI never started on exact pinned head $pin"; die_after_ready 1 "CI never started: a required check has no check run" ;;
        *)
          if [ -z "$ci_rerun_done" ]; then
            if reason="$(ci_outside_reason 2>/dev/null)"; then
              if run_ids="$(ci_failed_run_ids 2>/dev/null)"; then
                say "CI failure outside the diff ($reason); rerunning failed jobs once — file the flake"
                pre_attempts=""
                # gh's stderr goes to one temp file for the loop, not one per run
                attempt_err="$(mktemp "${TMPDIR:-/tmp}/ship-pr-${pr}-attempt.XXXXXX")" \
                  || die_after_ready 1 "cannot create a temp file for gh stderr"
                while IFS= read -r rid || [ -n "$rid" ]; do
                  [ -n "$rid" ] || continue
                  rc=0
                  pre="$(gh run view "$rid" --repo "$repo" --json attempt,status --jq '[.attempt, .status] | @tsv' 2>"$attempt_err")" || rc=$?
                  if [ "$rc" -ne 0 ]; then
                    text="$(gh_err_text "$attempt_err")"
                    rm -f "$attempt_err"
                    die_after_ready 1 "cannot read attempt of run $rid before rerun: gh exit $rc: $text"
                  fi
                  IFS=$'\t' read -r pre_attempt _ <<<"$pre" || true
                  pre_attempts="${pre_attempts}${rid} ${pre_attempt:-0}
  "
                done <<<"$run_ids"
                rm -f "$attempt_err"
                while IFS= read -r rid || [ -n "$rid" ]; do
                  [ -n "$rid" ] || continue
                  gh run rerun "$rid" --failed --repo "$repo" >&2 || die_after_ready 1 "gh run rerun $rid --failed failed"
                done <<<"$run_ids"
                ci_rerun_done=1
                elapsed=0
                while :; do
                  waiting=""
                  while IFS= read -r rid || [ -n "$rid" ]; do
                    [ -n "$rid" ] || continue
                    pre_one="$(awk -v r="$rid" '$1 == r { print $2; exit }' <<<"$pre_attempts")"
                    cur="$(gh run view "$rid" --repo "$repo" --json attempt,status --jq '[.attempt, .status] | @tsv' 2>/dev/null)" \
                      || { waiting="${waiting}${rid} "; continue; }
                    IFS=$'\t' read -r cur_attempt cur_status <<<"$cur" || true
                    [ "${cur_status:-}" != "completed" ] && continue
                    case "${cur_attempt:-}" in ''|*[!0-9]*) waiting="${waiting}${rid} "; continue ;; esac
                    case "${pre_one:-}" in ''|*[!0-9]*) pre_one=0 ;; esac
                    [ "$cur_attempt" -gt "$pre_one" ] || waiting="${waiting}${rid} "
                  done <<<"$run_ids"
                  [ -z "$waiting" ] && break
                  [ "$elapsed" -ge 120 ] && die_after_ready 1 "run ${waiting%% *} shows no new attempt 120 s after rerun"
                  sleep 5
                  elapsed=$((elapsed + 5))
                done
                say "waiting for CI"
                rc=0
                ci_out="$(GH_CI_REPO="$repo" bash "$here/gh-ci" wait "$pr" --timeout "$timeout")" || rc=$?
                if [ "$rc" -ne 0 ]; then
                  printf '%s\n' "$ci_out"
                  case "$rc" in
                    124) [ -z "$gate_red_output" ] || refuse KNOWN-FLAKE "known-flake check 1 failed: CI is not green on exact pinned head $pin"; exit_after_ready 124 "CI timed out" ;;
                    3) [ -z "$gate_red_output" ] || refuse KNOWN-FLAKE "known-flake check 1 failed: CI is not green on exact pinned head $pin"; die_after_ready 3 "PR conflicts with origin/main after the push; merge origin/main again, then rerun" ;;
                    4) [ -z "$gate_red_output" ] || refuse KNOWN-FLAKE "known-flake check 1 failed: CI never started on exact pinned head $pin"; die_after_ready 1 "CI never started: a required check has no check run" ;;
                    *) [ -z "$gate_red_output" ] || refuse KNOWN-FLAKE "known-flake check 1 failed: CI is not green on exact pinned head $pin"; die_after_ready 1 "CI failed" ;;
                  esac
                fi
              fi
            fi
          fi
          [ "$rc" -eq 0 ] || { [ -z "$gate_red_output" ] || refuse KNOWN-FLAKE "known-flake check 1 failed: CI is not green on exact pinned head $pin"; die_after_ready 1 "CI failed"; }
          ;;
      esac
    fi
    grep -q "^head: ${pin:0:8} " <<<"$ci_out" || { printf '%s\n' "$ci_out"; die_after_ready 1 "CI passed on a head other than ${pin:0:8}"; }
  
    [ "$strict" = 1 ] || break
  
    # Up to date at merge: CI "must pass on a head up to date with main".
    git -C "$worktree" fetch -q origin +refs/heads/main:refs/remotes/origin/main >&2 || die_after_ready 1 "git fetch origin main failed"
    git -C "$worktree" merge-base --is-ancestor origin/main "$pin" && break
    [ "$retries" -lt 3 ] || die_after_ready 1 "origin/main moved during CI after 3 retries; rerun ship-pr"
    retries=$((retries + 1))
    say "origin/main moved during CI; merging again (retry $retries of 3)"
  done

  if [ "${#known_flakes[@]}" -gt 0 ] && [ -n "$gate_red_output" ]; then
    known_ci_run="$(known_ci_run_id)" \
      || refuse KNOWN-FLAKE "known-flake check 1 failed: CI is green on exact pinned head $pin but its run id could not be read"
    [ -n "$known_ci_run" ] \
      || refuse KNOWN-FLAKE "known-flake check 1 failed: CI is green on exact pinned head $pin but no successful CI run id was found"
    known_flake_accept "$gate_red_output" "$gate_raw_exit" "$gate_red_head" "$pin" "$pin" "$known_ci_run"
  fi

  # Step 7: on a non-strict base, check the PR merged with current origin/main.
  # The merge is a throwaway commit in --worktree; nothing is pushed, and the
  # worktree goes back to the pinned head on every path.
  if [ "$strict" = 0 ] && { [ -n "$gate" ] || [ -n "$merge_check" ]; }; then
    step7_check="gate" step7_cmd="$gate"
    if [ -z "$gate" ]; then
      step7_cmd="$merge_check"
      step7_check="merge check"
    fi
    git -C "$worktree" fetch -q origin +refs/heads/main:refs/remotes/origin/main >&2 || die_after_ready 1 "git fetch origin main failed"
    if ! git -C "$worktree" merge-base --is-ancestor origin/main "$pin"; then
      say "$step7_check the PR merged with current origin/main"
      guard_restore() {
        git -C "$worktree" reset -q --hard "$pin" >&2 || die_after_ready 1 "failed to restore pinned head ${pin:0:8}"
      }
      trap 'guard_rc=$?; trap - EXIT INT TERM; guard_restore; if [ "$guard_rc" -ne 0 ] && [ "$refusal_in_progress" != 1 ]; then exit_after_ready "$guard_rc" "gate aborted"; else exit "$guard_rc"; fi' EXIT
      trap 'trap - EXIT INT TERM; guard_restore; exit_after_ready 143 "gate interrupted"' TERM
      trap 'trap - EXIT INT TERM; guard_restore; exit_after_ready 130 "gate interrupted"' INT
      merge_check_moves=0
      while :; do
        checked_main="$(git -C "$worktree" rev-parse origin/main)"
        if ! git -C "$worktree" -c user.name=ship-pr -c user.email=ship-pr@localhost merge --no-ff --no-edit origin/main >&2; then
          guard_restore
          trap - EXIT INT TERM
          die_after_ready 3 "PR conflicts with current origin/main; merge origin/main, then rerun"
        fi
        step7_gate_head="$(git -C "$worktree" rev-parse HEAD)"
        step7_gate_rc=0
        run_gate "$step7_cmd" "$step7_check" || step7_gate_rc=$?
        if [ "${#known_flakes[@]}" -gt 0 ] \
          && { [ "$(git -C "$worktree" rev-parse HEAD)" != "$step7_gate_head" ] || ! worktree_clean; }; then
          guard_restore
          trap - EXIT INT TERM
          refuse KNOWN-FLAKE "known-flake check 4 failed: gate changed the merged-tree checkout instead of testing fresh head $step7_gate_head"
        fi
        if [ "$step7_gate_rc" -ne 0 ]; then
          if [ "$step7_check" = gate ] && [ "$step7_gate_rc" -eq 2 ] && [ "${#known_flakes[@]}" -gt 0 ]; then
            known_flake_accept "$gate_output_path" "$gate_raw_exit" "$step7_gate_head" "$step7_gate_head" "$pin" "$known_ci_run"
          else
            guard_restore
            trap - EXIT INT TERM
            die_after_ready 1 "the PR merged with current origin/main fails the $step7_check"
          fi
        fi
        if [ "$step7_check" = gate ]; then
          guard_restore
          trap - EXIT INT TERM
          if [ "$step7_gate_rc" -eq 2 ]; then
            say "gate on the PR merged with current origin/main failed only on ticketed known flakes"
          else
            say "gate passes on the PR merged with current origin/main"
          fi
          break
        fi
        git -C "$worktree" fetch -q origin +refs/heads/main:refs/remotes/origin/main >&2 || die_after_ready 1 "git fetch origin main failed"
        if [ "$(git -C "$worktree" rev-parse origin/main)" = "$checked_main" ]; then
          guard_restore
          trap - EXIT INT TERM
          say "$step7_check passes on the PR merged with current origin/main"
          break
        fi
        guard_restore
        merge_check_moves=$((merge_check_moves + 1))
        if [ "$merge_check_moves" -gt 3 ]; then
          trap - EXIT INT TERM
          die_after_ready 1 "origin/main moved during the merge check; rerun ship-pr"
        fi
        say "origin/main moved during the merge check; rerunning on the new tip (retry $merge_check_moves of 3)"
      done
    fi
  fi
  
  # File non-blocking P3s only after every refusal check has passed, immediately
  # before the merge attempt. A retry after a base race reuses these issue links.
  if [ "$review_state" = "incomplete-p3" ] && [ "$p3_issues_filed" = 0 ]; then
    file_p3_findings
    p3_issues_filed=1
  fi

  # Step 8: merge pinned to the checked head, then wait for GitHub to say MERGED.
  say "merging PR $pr at ${pin:0:8}"
  merge_attempted=1
  merge_err=""
  merge_failed=""
  if ! merge_err="$(gh pr merge "$pr" --repo "$repo" --squash --match-head-commit "$pin" 2>&1)"; then
    show_merge_failure "$merge_err"
    lost_race=""
    case "$merge_err" in
      *"the head branch is not up to date with the base branch"*)
        [ "$strict" = 1 ] && lost_race=1 ;;
    esac
    if [ -n "$lost_race" ]; then
      state="$(gh pr view "$pr" --repo "$repo" --json state --jq '.state' 2>/dev/null)" || state=""
      if [ "$state" != "MERGED" ]; then
        fetch_retry origin +refs/heads/main:refs/remotes/origin/main || die_after_ready 1 "git fetch origin main failed"
        if git -C "$worktree" merge-base --is-ancestor origin/main "$pin"; then
          lost_race_die "origin/main has not moved past ${pin:0:8}"
        fi
        [ -z "$lost_race_done" ] || lost_race_die "the merged head lost the race again"
        [ "$retries" -lt 3 ] || lost_race_die "no retries left"
        lost_race_done=1
        retries=$((retries + 1))
        merge_attempted=0
        say "origin/main moved before the merge; merging again (retry $retries of 3)"
        continue
      fi
    else
      case "$merge_err" in
        *"Base branch was modified"*|*"GraphQL"*)
          case "$merge_err" in
            *"GraphQL"*) say "GraphQL error during merge; retrying once after 5 s" ;;
            *) say "base branch was modified during merge; retrying once after 5 s" ;;
          esac
          sleep 5
          if ! merge_err="$(gh pr merge "$pr" --repo "$repo" --squash --match-head-commit "$pin" 2>&1)"; then
            show_merge_failure "$merge_err"
            lost_race2=""
            case "$merge_err" in
              *"the head branch is not up to date with the base branch"*)
                [ "$strict" = 1 ] && lost_race2=1 ;;
            esac
            if [ -n "$lost_race2" ]; then
              state="$(gh pr view "$pr" --repo "$repo" --json state --jq '.state' 2>/dev/null)" || state=""
              if [ "$state" != "MERGED" ]; then
                fetch_retry origin +refs/heads/main:refs/remotes/origin/main || die_after_ready 1 "git fetch origin main failed"
                if git -C "$worktree" merge-base --is-ancestor origin/main "$pin"; then
                  lost_race_die "origin/main has not moved past ${pin:0:8}"
                fi
                [ -z "$lost_race_done" ] || lost_race_die "the merged head lost the race again"
                [ "$retries" -lt 3 ] || lost_race_die "no retries left"
                lost_race_done=1
                retries=$((retries + 1))
                merge_attempted=0
                say "origin/main moved before the merge; merging again (retry $retries of 3)"
                continue
              fi
            else
              merge_failed=1
            fi
          else
            [ -z "$merge_err" ] || print_merge_error "$merge_err"
          fi
          ;;
        *) die_after_ready 1 "gh pr merge failed" ;;
      esac
    fi
  else
    [ -z "$merge_err" ] || print_merge_error "$merge_err"
  fi
  break
done
merged="" sha=""
for i in $(seq 1 12); do
  IFS=$'\t' read -r state sha < <(gh pr view "$pr" --repo "$repo" --json state,mergeCommit \
    --jq '[.state, (.mergeCommit.oid // "-")] | @tsv' 2>/dev/null || true) || true
  if [ "${state:-}" = "MERGED" ]; then merged=1; break; fi
  [ "$i" -lt 12 ] && sleep "${SHIP_PR_INTERVAL:-5}"
done
[ -n "$merged" ] || { [ -n "$merge_failed" ] && die 1 "gh pr merge failed"; die 1 "merge status could not be confirmed after 12 polls; worktree left in place"; }

if [ "$repo" = "aakshintala/switchyard" ]; then fast_forward_agents; fi

if [ "$known_acceptance_used" = 1 ]; then post_known_flake_comments; fi

# Step 9: clean up from the common git dir, never from inside the worktree being removed.
common="$(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir)"
cd "$common"
if [ -n "$keep_branch" ]; then
  say "worktree kept: $keep_branch"
else
  case "$start_dir/" in
    "$worktree"/*)
      say "worktree kept: your shell is inside it; remove it with: $(printf 'git -C %q worktree remove %q && git -C %q branch -D %q' "$common" "$worktree" "$common" "$branch")" ;;
    *)
      if ! worktree_clean; then
        say "worktree kept: it is not clean after merge"
      elif ! command -v lsof >/dev/null 2>&1; then
        say "worktree kept: cannot check for active processes because lsof is unavailable"
      else
        lsof_output=""
        if lsof_output="$(lsof -t -a -d cwd +D "$worktree" 2>&1)"; then
          say "worktree kept: a process has its cwd inside it"
        elif [ -n "$lsof_output" ]; then
          say "worktree kept: could not check for a process inside it: $lsof_output"
        elif git --git-dir="$common" worktree remove "$worktree" >&2; then
          if git --git-dir="$common" branch -D "$branch" >&2; then
            say "worktree removed: $worktree; local branch deleted: $branch"
          else
            say "worktree removed: $worktree; local branch cleanup failed: $branch"
          fi
        else
          say "worktree kept: removal failed for $worktree"
        fi
      fi ;;
  esac
fi
# A missing remote ref counts as done, whatever the push error says: GitHub's
# auto-delete on merge makes the push fail with "cannot lock ref".
if ! del_out="$(git --git-dir="$common" push origin --delete "$branch" 2>&1)"; then
  ls_rc=0
  git --git-dir="$common" ls-remote --exit-code --heads origin "refs/heads/$branch" >/dev/null 2>&1 || ls_rc=$?
  [ "$ls_rc" -eq 2 ] || say "cleanup: push origin --delete $branch failed: $del_out"
fi

# Step 10
echo "merged $sha"
