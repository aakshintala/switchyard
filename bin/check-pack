#!/usr/bin/env bash
# check-pack: lint every skills/**/*.md for dangling skill/file references and
# bad fill-brief placeholders. Prints one path:line: problem per failure
# (paths relative to ROOT), silent exit 0 when clean.
# Usage: check-pack [ROOT]   (default: the repo this script lives in)
set -euo pipefail

# Backticked /names that look like slash commands but are in-tree paths/routes.
SLASH_DENY="tmp settings bin boot dev etc home lib mnt opt proc root run sbin srv sys usr var"

usage() {
  echo "usage: check-pack [ROOT]" >&2
  exit 2
}

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
default_root="$(dirname "$script_dir")"
[ $# -le 1 ] || usage
root="${1:-$default_root}"
[ -d "$root" ] || usage
root="$(cd "$root" && pwd)"
[ -d "$root/skills" ] || usage

failures=0
fail() {
  printf '%s:%s: %s\n' "$1" "$2" "$3"
  failures=$((failures + 1))
}

is_denied_slash() {
  local n="$1" x
  for x in $SLASH_DENY; do
    if [ "$x" = "$n" ]; then return 0; fi
  done
  return 1
}

check_skill_name() {
  local rel="$1" line="$2" name="$3"
  if [ ! -f "$root/skills/$name/SKILL.md" ]; then
    fail "$rel" "$line" "missing skill \`$name\`"
  fi
}

files="$(find "$root/skills" -name '*.md' | sort)"
while IFS= read -r f; do
  [ -n "$f" ] || continue
  rel="${f#$root/}"
  dir="$(dirname "$f")"

  # --- skill references ---

  # `name` skill — e.g. `code-review` skill, the `retro` skill.
  hits="$(grep -onE '`[A-Za-z0-9][A-Za-z0-9_-]*` +[Ss]kills?' "$f" 2>/dev/null || true)"
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    line="${hit%%:*}"; m="${hit#*:}"
    m="${m#\`}"; name="${m%%\`*}"
    check_skill_name "$rel" "$line" "$name"
  done <<<"$hits"

  # Skill tool with "name" or `name`.
  sq="'"
  hits="$(grep -onE "Skill tool with [\"\`$sq][A-Za-z0-9][A-Za-z0-9_.-]*[\"\`$sq]" "$f" 2>/dev/null || true)"
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    line="${hit%%:*}"; m="${hit#*:}"
    m="${m#*with }"
    m="${m#?}"; name="${m%?}"
    check_skill_name "$rel" "$line" "$name"
  done <<<"$hits"

  # `/name` or `/name args` slash commands.
  hits="$(grep -onE '`/[^`]*`' "$f" 2>/dev/null || true)"
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    line="${hit%%:*}"; m="${hit#*:}"
    inner="${m#\`}"; inner="${inner%\`}"
    rest="${inner#/}"
    name="${rest%% *}"
    case "$inner" in
      "/$name"|"/$name "*) ;;
      *) continue;;
    esac
    case "$name" in [a-z]* ) ;; *) continue;; esac
    case "$name" in *[!a-z0-9-]*) continue;; esac
    if is_denied_slash "$name"; then continue; fi
    check_skill_name "$rel" "$line" "$name"
  done <<<"$hits"

  # --- file references ---

  # Relative markdown links ](path), outside fenced code blocks (examples).
  fenced="|$(awk '/^ *```/{f=!f;next} f{printf "%d|",NR}' "$f")"
  hits="$(grep -onE '\[[^]]*\]\([^)]*\)' "$f" 2>/dev/null || true)"
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    line="${hit%%:*}"; m="${hit#*:}"
    case "$fenced" in *"|$line|"*) continue;; esac
    text="${m%%\]*}"; text="${text#[}"
    rest="${m#*\](}"; target="${rest%)}"
    case "$target" in
      ""|\#*) continue;;
      /*) continue;;
    esac
    case "$target" in
      [A-Za-z][A-Za-z0-9+.-]*:*) continue;;
    esac
    case "$target" in
      *[\<\>\ ]*|*__*) continue;;
    esac
    case "$text" in
      *\<*\>*) continue;;
    esac
    if [ ! -e "$dir/$target" ]; then
      fail "$rel" "$line" "missing file: $target"
    fi
  done <<<"$hits"

  # Backticked __SKILLS__/path (against ROOT/skills) and ~/.agents/path (ROOT).
  hits="$(grep -onE '`(__SKILLS__/[^`[:space:]]*|~/\.agents/[^`[:space:]]*)`' "$f" 2>/dev/null || true)"
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    line="${hit%%:*}"; m="${hit#*:}"
    inner="${m#\`}"; inner="${inner%\`}"
    case "$inner" in
      __SKILLS__/*)
        rest="${inner#__SKILLS__/}"
        if [ ! -e "$root/skills/$rest" ]; then
          fail "$rel" "$line" "missing file: $inner"
        fi
        ;;
      \~/.agents/*)
        rest="${inner#\~/.agents}"
        if [ ! -e "$root$rest" ]; then
          fail "$rel" "$line" "missing file: $inner"
        fi
        ;;
    esac
  done <<<"$hits"

  # --- bad template tokens (skills/*/briefs/ only) ---
  tail="${rel#skills/}"
  case "$tail" in
    */briefs/*)
      skill="${tail%%/*}"
      rest="${tail#*/briefs/}"
      is_brief=0
      case "$skill" in */*) ;; *) case "$rest" in */*) ;; *) is_brief=1;; esac;; esac
      if [ "$is_brief" -eq 1 ]; then
        stripped="$(sed -e 's/__[A-Z][A-Z0-9_]*__//g' "$f")"
        hits="$(printf '%s' "$stripped" | grep -onE '__[A-Za-z0-9][A-Za-z0-9_ ./-]*__' || true)"
        while IFS= read -r hit; do
          [ -n "$hit" ] || continue
          line="${hit%%:*}"; m="${hit#*:}"
          fail "$rel" "$line" "bad placeholder: $m"
        done <<<"$hits"
        hits="$(grep -onE '{{[^}]*}}' "$f" 2>/dev/null || true)"
        while IFS= read -r hit; do
          [ -n "$hit" ] || continue
          line="${hit%%:*}"; m="${hit#*:}"
          fail "$rel" "$line" "bad template token: $m"
        done <<<"$hits"
      fi
      ;;
  esac
done <<<"$files"

# Script sibling paths must use the resolved script path, not a symlink's directory.
bin_files="$(find "$root/bin" -type f 2>/dev/null | sort || true)"
while IFS= read -r f; do
  [ -n "$f" ] || continue
  rel="${f#$root/}"
  hits="$(grep -nE '^[[:space:]]*(here|lib|root|[A-Za-z_][A-Za-z0-9_]*_(dir|lib|root))=.*dirname.*\$0|^[[:space:]]*(here|lib|root|[A-Za-z_][A-Za-z0-9_]*_(dir|lib|root))=.*dirname.*BASH_SOURCE|^[[:space:]]*(\.|source)[[:space:]].*dirname.*(\$0|BASH_SOURCE)' "$f" 2>/dev/null || true)"
  while IFS= read -r hit; do
    [ -n "$hit" ] || continue
    line="${hit%%:*}"
    fail "$rel" "$line" "resolve symlinks before setting a script directory"
  done <<<"$hits"
done <<<"$bin_files"

planner_skill="$root/skills/implement/SKILL.md"
if [ -f "$planner_skill" ] && ! grep -Fq 'tkt-job <state> --slot planner --brief <filled planner brief>' "$planner_skill"; then
  hit="$(grep -nF 'When a worker writes the plan' "$planner_skill" | head -n 1 || true)"
  line="${hit%%:*}"
  [ -n "$line" ] || line=1
  fail "skills/implement/SKILL.md" "$line" "planner dispatch must name --slot planner"
fi

if [ -f "$root/test/tkt-verdicts.sh" ] \
  && ! bash "$root/test/tkt-verdicts.sh" "$root" >/dev/null 2>&1; then
  fail "bin/check-pack" 1 "tkt verdict words must be listed in skills/implement/SKILL.md's Commands table"
fi

if [ "$failures" -gt 0 ]; then exit 1; fi
exit 0
