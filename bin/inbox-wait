#!/usr/bin/env bash
# inbox-wait: block until a file inbox holds an unread message, then list it.
# Usage: inbox-wait <inbox-dir>
#        Prints the path of every regular *.md file directly in <inbox-dir>,
#        one per line, and exits 0. Files moved to <inbox-dir>/read/ do not
#        count. Returns at once when a file is already waiting; otherwise
#        blocks until one arrives, rechecking at least every 2 seconds:
#        `inotifywait -q -t 2` when it is on PATH, `sleep 2` otherwise.
#        (No unbounded native wait: a file landing between the last check
#        and the watcher's start would otherwise be missed until a later event.)
set -euo pipefail

usage() {
  echo "usage: inbox-wait <inbox-dir>" >&2
  exit 2
}

[ $# -eq 1 ] || usage
dir="$1"

# waiting: print every regular *.md file directly in the inbox, one per line.
# Exits 0 when at least one was printed, 1 when none was. Dotfiles (such as
# inbox-send's .tmp.* staging files) never match *.md, so they are never printed.
waiting() {
  local f found=1
  for f in "$dir"/*.md; do
    [ -e "$f" ] || continue
    [ -f "$f" ] || continue
    printf '%s\n' "$f"
    found=0
  done
  return "$found"
}

mkdir -p -- "$dir"

if waiting; then exit 0; fi

if command -v inotifywait >/dev/null 2>&1; then
  while ! waiting; do
    inotifywait -q -t 2 -e create -e moved_to -- "$dir" >/dev/null 2>&1 || true
  done
else
  while ! waiting; do
    sleep 2
  done
fi
exit 0
