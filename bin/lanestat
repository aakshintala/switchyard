#!/bin/sh
# lanestat [--all] [--inbox <dir>] <run-dir>: live pi lanes and recent delegate run jobs.
# With --inbox, print the open-ruling count when nonzero.
# It stays POSIX so lanewatch can send it to `ssh bash -s` without a remote copy.
# LANESTAT_SETTLED_MAX (seconds, default 7200) marks older SETTLED lanes
# as SETTLED-OLD. lanewatch does not forward the variable over ssh, so remote
# runs use the default unless it is set in the remote environment.
# LANESTAT_DELEGATE_MAX_AGE (seconds, default 86400) limits terminal delegate
# jobs by endedAtMs (record mtime for older records); RUNNING jobs always show.
# Delegate rows resolve through per-user locators; only an explicit
# DELEGATE_JOBS_DIR supplies locator-less records. A resumed predecessor is
# suppressed, leaving the current successor as the row for the chain.
#
# State pairs tool starts and ends by toolCallId within the last 20 MB of the
# jsonl, never from its last line. A prompt sent during a running tool call gets
# an immediate `queued` response while the tool keeps running, so the last line
# can be a response even when the lane is still in that call. The most recent
# unmatched start is IN-TOOL. A matched end removes its start; an unmatched
# end has no effect. agent_settled clears every open start, and SETTLED applies
# only when it is the last relevant event with no later open start. Without an
# open tool or final settle, no write for more than five minutes means STALL. A
# start outside the 20 MB tail is ignored; the operator checks the tool by hand.
# Zero live rows prints `lanestat: no live lanes in <run-dir>`.
# IN-TOOL says pi has a tool call active, not that the tool is making progress.
# WEDGED means a settled lane received a successful non-queued prompt and no
# tool event or message_start followed it; abort, then resend with flywheel's
# `pisend.sh wake` (not shipped here). A queued prompt means pi has an active
# run and is not lost. DEAD-PROVIDER <provider>/<model>: <message> means the
# last agent_end assistant message had stopReason=error and
# usage.totalTokens=0; its first-line reason falls back from errorMessage to the
# turn's last failed auto_retry_end finalError, then no output, capped at 200
# characters; do not re-wake.
# `last=<tool>` accompanies WEDGED, PARK and LOOP;
# its whitespace is replaced with underscores. PARK means the lane needs an
# answer, LOOP leaves the decision to the orchestrator, and DONE-UNREAD <ids>
# names completed jobs the lane has not read. Answer PARK with a ruling or
# fence-grant file. Let the orchestrator decide LOOP. Abort and resend WEDGED.
# Do not re-wake DEAD-PROVIDER. Message the lane naming the jobs in
# DONE-UNREAD <ids>. `lanewatch` prints dated event rows once per settle minute
# and sends PARK, LOOP, WEDGED, DEAD-PROVIDER and DONE-UNREAD to
# LANEWATCH_INBOX when it is set; plain SETTLED and STALL stay on stdout.
# The watcher never stops a lane. Set DELEGATE_JOBS_DIR on the watcher only for
# locator-less delegate records; lanewatch forwards that fallback to remote
# targets. TMPDIR, JOB_RECORD_SYSTEM_DIR and LANESTAT_SETTLED_MAX are not
# forwarded over ssh; only DELEGATE_JOBS_DIR is.
#
# A pi lane's TMPDIR may be `~/.cache/tmp`, not `/tmp`; this does not affect
# delegate rows, which resolve records through per-user locators. Use
# DELEGATE_JOBS_DIR only when a delegate record has no locator.
#
# A pid file outlives its lane and the host can reuse its number. Keep a row only
# when `ps -o comm=` still names pi. Use `ps -g` on the saved pgid for a
# `jobs wait` process.
#
# Dead pid files accumulate; --all includes them. Never `cat` a lane's
# fiber-<n>-pi.in: it is a FIFO and reading it blocks the lane.
set -u

usage() {
  printf 'usage: lanestat [--all] [--inbox <dir>] <run-dir>\n' >&2
  exit 2
}

all=
inbox=
run=
while [ "$#" -gt 0 ]; do
  case $1 in
    --all)
      [ -z "$all" ] || usage
      all=--all
      ;;
    --inbox)
      [ -z "$inbox" ] && [ "$#" -ge 2 ] || usage
      inbox=$2
      shift
      ;;
    *)
      [ -z "$run" ] || usage
      run=$1
      ;;
  esac
  shift
done
[ -n "$run" ] || usage
[ -d "$run" ] || { printf 'no such run dir: %s\n' "$run" >&2; exit 2; }

settled_max=${LANESTAT_SETTLED_MAX:-}
case $settled_max in
  ''|*[!0-9]*) settled_max=7200 ;;
esac

now=$(date +%s)
fallback_dir=
if [ -n "${DELEGATE_JOBS_DIR:-}" ]; then
  case $DELEGATE_JOBS_DIR in
    /*) fallback_dir=$DELEGATE_JOBS_DIR ;;
    *) fallback_dir=$PWD/$DELEGATE_JOBS_DIR ;;
  esac
fi
rows=0

delegate_max_age=${LANESTAT_DELEGATE_MAX_AGE:-}
case $delegate_max_age in
  ''|*[!0-9]*) delegate_max_age=86400 ;;
esac
cache_root=
case ${XDG_CACHE_HOME:-} in
  /*) cache_root=$XDG_CACHE_HOME ;;
esac
if [ -z "$cache_root" ]; then
  case ${HOME:-} in
    /*) cache_root=$HOME/.cache ;;
  esac
fi
locator_dir=
read_dir=
if [ -n "$cache_root" ]; then
  locator_dir=$cache_root/delegate/locators
  read_dir=$cache_root/delegate/read
fi
if { [ -n "$locator_dir" ] && [ -d "$locator_dir" ]; } || \
   { [ -n "$fallback_dir" ] && [ -d "$fallback_dir" ]; }; then
  delegate_output=$(LS_LOCATORS="$locator_dir" LS_FALLBACK="$fallback_dir" \
    LS_READ="$read_dir" LS_NOW="$now" \
    LS_MAX_AGE="$delegate_max_age" perl -e '
      eval { require JSON::PP; 1 } or exit 0;
      require Scalar::Util;
      sub read_file {
        my ($path) = @_;
        open my $fh, "<", $path or return;
        local $/;
        return <$fh>;
      }
      sub one_line {
        my ($text) = @_;
        $text = "" unless defined $text && !ref $text;
        $text =~ s/[\x00-\x1f\x7f]/ /g;
        $text =~ s/\s+/ /g;
        $text =~ s/^\s+|\s+$//g;
        return $text;
      }
      sub valid_id {
        return defined $_[0] && $_[0] =~ /\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/;
      }
      sub load_record {
        my ($id, $path, $records) = @_;
        return unless -f $path;
        my @stat = stat $path;
        return unless @stat;
        my $json = read_file($path);
        return unless defined $json;
        my $record = eval { JSON::PP::decode_json($json) };
        return if $@ || ref($record) ne "HASH";
        $records->{$id} = { record => $record, mtime => $stat[9] };
      }
      my $locator_dir = $ENV{LS_LOCATORS} || "";
      my $fallback_dir = $ENV{LS_FALLBACK} || "";
      my $read_dir = $ENV{LS_READ} || "";
      my $now = $ENV{LS_NOW};
      my $max_age = $ENV{LS_MAX_AGE};
      my %records;
      if (length $locator_dir && opendir my $dir, $locator_dir) {
        my @ids = grep { valid_id($_) } readdir $dir;
        closedir $dir;
        for my $id (@ids) {
          my $locator = read_file("$locator_dir/$id");
          next unless defined $locator;
          $locator =~ s/\n\z//;
          next if $locator !~ m{\A/} || $locator =~ /[\r\n]/;
          load_record($id, $locator, \%records);
        }
      }
      if (length $fallback_dir && opendir my $dir, $fallback_dir) {
        my @names = readdir $dir;
        closedir $dir;
        for my $name (@names) {
          next unless $name =~ /\A([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.json\z/;
          my $id = $1;
          next if exists $records{$id};
          next if length($locator_dir) && -e "$locator_dir/$id";
          load_record($id, "$fallback_dir/$name", \%records);
        }
      }
      my %superseded;
      for my $id (keys %records) {
        my $record = $records{$id}{record};
        my $next = $record->{supersededBy};
        my $previous = $record->{resumedFrom};
        $superseded{$id} = 1 if valid_id($next);
        $superseded{$previous} = 1 if valid_id($previous);
      }
      for my $id (sort keys %records) {
        next if $superseded{$id};
        my $entry = $records{$id};
        my $record = $entry->{record};
        my $status = $record->{status};
        next unless defined $status && !ref $status && length $status;
        if ($status ne "RUNNING") {
          my $ended_at = $record->{endedAtMs};
          my $finished_at = defined $ended_at && !ref($ended_at) && Scalar::Util::looks_like_number($ended_at)
            ? $ended_at / 1000
            : $entry->{mtime};
          my $age = $now - $finished_at;
          next if $age < 0 || $age > $max_age;
        }
        my $result = ref($record->{result}) eq "HASH" ? $record->{result} : {};
        my $resume = ref($record->{resume}) eq "HASH" ? $record->{resume} : {};
        my $model = one_line($result->{model} || $resume->{model} || "unknown");
        my $cwd = one_line($resume->{cwd} || $record->{cwd} || "");
        my $line = "DELEGATE id=$id model=$model cwd=$cwd status=" . one_line($status);
        if ($status eq "ERROR") {
          my $backend = one_line($result->{backend} || "unknown");
          my $provider_model = one_line($result->{model} || "unknown");
          my $message = $result->{stderrTail};
          $message = "" unless defined $message && !ref $message;
          ($message) = split /\r\n|\n|\r/, $message, 2;
          $message = one_line($message);
          $message = "no output" unless length $message;
          $message = substr($message, 0, 200);
          $line .= " DEAD-PROVIDER $backend/$provider_model: $message";
        }
        if ($status ne "RUNNING") {
          my $read_marker = length($read_dir) && -f "$read_dir/$id";
          $line .= $read_marker ? " READ" : " DONE-UNREAD";
        }
        print "$line\n";
      }
    ')
  if [ -n "$delegate_output" ]; then
    printf '%s\n' "$delegate_output"
    rows=$(printf '%s\n' "$delegate_output" | wc -l | tr -d ' ')
  fi
fi

for pidfile in "$run"/fiber-*-pi.pid; do
  [ -f "$pidfile" ] || continue
  n=${pidfile##*/}
  n=${n#fiber-}
  n=${n%-pi.pid}
  pid=$(cat "$pidfile" 2>/dev/null)
  [ -n "${pid:-}" ] || continue

  comm=$(ps -o comm= -p "$pid" 2>/dev/null | head -1)
  case ${comm##*/} in
    pi) ;;
    *) comm= ;;
  esac
  info=
  [ -n "$comm" ] && info=$(ps -o stat=,etime= -p "$pid" 2>/dev/null | head -1 | tr -s ' ')
  if [ -z "$info" ]; then
    [ "$all" = --all ] && printf '%-6s %-8s %s\n' "$n" "$pid" DEAD
    continue
  fi

  jsonl=$run/fiber-$n-pi.jsonl
  age=99999
  if [ -f "$jsonl" ]; then
    mtime=$(perl -e 'print ((stat $ARGV[0])[9])' "$jsonl" 2>/dev/null)
    [ -n "${mtime:-}" ] && age=$((now - mtime))
  fi
  ruling_time=0
  for ruling_file in "$run"/*-"$n"-ruling-*.md "$run/fiber-$n-fence-grant-"*.md; do
    [ -f "$ruling_file" ] || continue
    ruling_mtime=$(perl -e 'my @s = stat $ARGV[0]; print $s[9] if @s' "$ruling_file" 2>/dev/null)
    case $ruling_mtime in
      ''|*[!0-9]*) ;;
      *) [ "$ruling_mtime" -gt "$ruling_time" ] && ruling_time=$ruling_mtime ;;
    esac
  done
  ruling_ms=$((ruling_time * 1000))
  event_output=$(tail -c 20000000 "$jsonl" 2>/dev/null | \
    LS_LOCATORS="$locator_dir" LS_FALLBACK="$fallback_dir" LS_READ="$read_dir" \
    LS_RULING_MS="$ruling_ms" perl -ne '
    our @open;
    our $settled;
    our $after_prompt;
    our $dead;
    our $final_error;
    our $last_tool;
    our $question_line;
    our $settle_cut;
    our $settles;
    our $ruling_ms;
    our @job_ids;
    our %seen_job_ids;
    sub read_file {
      my ($path) = @_;
      open my $fh, "<", $path or return;
      local $/;
      return <$fh>;
    }
    sub unescape_json_string {
      my ($raw_error) = @_;
      my $message = "";
      while (length $raw_error) {
        if ($raw_error =~ s/^([^\\]+)//) {
          $message .= $1;
        } elsif ($raw_error =~ s/^\\(?:n|r|u000a|u000d).*$//i) {
          last;
        } elsif ($raw_error =~ s/^\\\\//) {
          $message .= "\\";
        } elsif ($raw_error =~ s/^\\"//) {
          $message .= "\"";
        } elsif ($raw_error =~ s/^\\t//) {
          $message .= "\t";
        } elsif ($raw_error =~ s/^\\(?:b|f)//) {
          $message .= " ";
        } elsif ($raw_error =~ s/^\\u000([0-9a-f])//i) {
          $message .= chr(hex($1));
        } elsif ($raw_error =~ s/^\\u[0-9a-f]{4}//i) {
          next;
        } elsif ($raw_error =~ s/^\\.//s) {
          next;
        }
      }
      $message =~ s/[\x00-\x1f\x7f]/ /g;
      $message =~ s/\s+$//;
      return $message;
    }
    $final_error = "" unless defined $final_error;
    $last_tool = "none" unless defined $last_tool;
    $settle_cut = 0 unless defined $settle_cut;
    $settles = 0 unless defined $settles;
    $ruling_ms = $ENV{LS_RULING_MS} unless defined $ruling_ms;
    if (/"type":"tool_execution_start","toolCallId":"([^"]*)","toolName":"([^"]*)"/) {
      push @open, [$1, $2];
      $last_tool = $2;
      $settled = 0;
      $after_prompt = 0;
      $dead = undef;
    } elsif (/"type":"tool_execution_end","toolCallId":"([^"]*)"/) {
      $after_prompt = 0;
      $dead = undef;
      for (my $i = $#open; $i >= 0; $i--) {
        if ($open[$i]->[0] eq $1) {
          splice @open, $i, 1;
          $settled = 0;
          last;
        }
      }
    } elsif (/"type":"agent_settled"/) {
      @open = ();
      $settled = 1;
      $after_prompt = 0;
    } elsif (/"type":"agent_start"/ || /"type":"auto_retry_start"/) {
      $dead = undef;
      $final_error = "";
    } elsif (/(?<!\\)"type"\s*:\s*"auto_retry_end"/) {
      my ($raw_final_error) = /(?<!\\)"finalError"\s*:\s*"((?:[^"\\]|\\.)*)"/;
      if (/(?<!\\)"success"\s*:\s*false/ || (defined $raw_final_error && length $raw_final_error)) {
        $raw_final_error = "" unless defined $raw_final_error;
        $final_error = unescape_json_string($raw_final_error);
      }
    } elsif (/"type"\s*:\s*"agent_end"/) {
      $dead = undef;
      my $assistant_start = -1;
      while (/(?<!\\)"role"\s*:\s*"assistant"/g) {
        $assistant_start = $-[0];
      }
      pos($_) = 0;
      if ($assistant_start >= 0) {
        my $assistant = substr($_, $assistant_start);
        my ($provider) = $assistant =~ /(?<!\\)"provider"\s*:\s*"((?:[^"\\]|\\.)*)"/;
        my ($model) = $assistant =~ /(?<!\\)"model"\s*:\s*"((?:[^"\\]|\\.)*)"/;
        my ($tokens) = $assistant =~ /(?<!\\)"usage"\s*:\s*\{[^}]*?"totalTokens"\s*:\s*(\d+)/;
        my ($stop_reason) = $assistant =~ /(?<!\\)"stopReason"\s*:\s*"([^"\\]*)"/;
        if (defined $tokens && $tokens == 0 && defined $stop_reason && $stop_reason eq "error") {
          my ($raw_error) = $assistant =~ /(?<!\\)"errorMessage"\s*:\s*"((?:[^"\\]|\\.)*)"/;
          $raw_error = "" unless defined $raw_error;
          my $message = unescape_json_string($raw_error);
          $provider = "unknown" unless defined $provider && length $provider;
          $model = "unknown" unless defined $model && length $model;
          $dead = [$provider, $model, $message];
        }
      }
    } elsif (/"type"\s*:\s*"response"/ && /"command"\s*:\s*"prompt"/ && /"success"\s*:\s*true/ && !/"(?:disposition|status)"\s*:\s*"queued"/) {
      $after_prompt = 1;
      $dead = undef;
    } elsif (/"type":"message_start"/) {
      $dead = undef;
      if ($after_prompt) {
        $settled = 0;
        $after_prompt = 0;
      }
    }
    if (/"type":"message_end","message":{"role":"assistant"/) {
      if (/"type":"text"/) {
        $question_line = $_;
      } elsif (/"type":"toolCall"/) {
        $question_line = undef;
      }
    }
    if ($ruling_ms > 0 && /"type":"message_end"/) {
      my @timestamps = /"timestamp":(\d+)/g;
      $settle_cut = 1 if @timestamps && $timestamps[-1] > $ruling_ms;
    }
    $settles++ if $settle_cut && /"type":"agent_settled"/;
    if (/"type":"(?:tool_execution_end|message_end)"/) {
      while (/\b([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\b/g) {
        push @job_ids, $1 unless $seen_job_ids{$1}++;
      }
    }
    END {
      if (@open) {
        print "STATE IN-TOOL " . $open[-1]->[1] . chr(10);
      } elsif ($settled && defined $dead) {
        my ($provider, $model, $message) = @$dead;
        my $reason = length($message) ? $message : length($final_error) ? $final_error : "no output";
        utf8::decode($reason);
        $reason = substr($reason, 0, 200);
        utf8::encode($reason);
        print "STATE DEAD $provider/$model: $reason" . chr(10);
      } elsif ($settled && $after_prompt) {
        print "STATE WEDGED" . chr(10);
      } elsif ($settled) {
        print "STATE SETTLED" . chr(10);
      }
      print "LAST $last_tool" . chr(10);
      print "SETTLES $settles" . chr(10);
      if (defined $question_line && eval { require JSON::PP; 1 }) {
        my $candidate = eval { JSON::PP::decode_json($question_line) };
        if (!$@ && ref($candidate) eq "HASH" && ref($candidate->{message}) eq "HASH") {
          my $message = $candidate->{message};
          my $timestamp = $message->{timestamp};
          if (defined $timestamp && !ref($timestamp) && $timestamp =~ /\A[0-9]+\z/) {
            my @texts;
            if (ref($message->{content}) eq "ARRAY") {
              for my $block (@{$message->{content}}) {
                if (ref($block) eq "HASH" && defined $block->{type} && $block->{type} eq "text" && defined $block->{text} && !ref($block->{text})) {
                  push @texts, $block->{text};
                }
              }
            }
            if (@texts) {
              my $text = join("\n", @texts);
              my $final_line;
              for my $line (reverse split /\n/, $text, -1) {
                $line =~ s/\s+\z//;
                if ($line =~ /\S/) {
                  $final_line = $line;
                  last;
                }
              }
              if (defined $final_line && (substr($final_line, -1, 1) eq "?" || index($final_line, "BLOCKED") >= 0)) {
                print "Q $timestamp" . chr(10);
              }
            }
          }
        }
      }
      if (@job_ids && eval { require JSON::PP; 1 }) {
        my $locator_dir = $ENV{LS_LOCATORS} || "";
        my $fallback_dir = $ENV{LS_FALLBACK} || "";
        my $read_dir = $ENV{LS_READ} || "";
        my @finished_ids;
        my $resolved = 0;
        my $all_finished = 1;
        for my $printed_id (@job_ids) {
          my $id = $printed_id;
          my %visited;
          my $found_initial = 0;
          my $latest_id = $id;
          my $invalid = 0;
          my $finished = 0;
          while (1) {
            if ($visited{$id}++) {
              $invalid = 1;
              last;
            }
            my $path;
            my $locator_file = length($locator_dir) ? "$locator_dir/$id" : "";
            if (length($locator_file) && -e $locator_file) {
              my $locator = read_file($locator_file);
              if (defined $locator) {
                $locator =~ s/\n\z//;
                $path = $locator
                  if $locator =~ m{\A/} && $locator !~ /[\r\n]/ && -f $locator;
              }
            } elsif (length($fallback_dir)) {
              my $candidate = "$fallback_dir/$id.json";
              $path = $candidate if -f $candidate;
            }
            if (!defined $path) {
              if (!$found_initial) {
                last;
              }
              $invalid = 1;
              last;
            }
            if (!$found_initial) {
              $found_initial = 1;
              $resolved++;
            }
            my $record_fh;
            if (!open($record_fh, "<", $path)) {
              $invalid = 1;
              last;
            }
            local $/;
            my $record_json = <$record_fh>;
            close $record_fh;
            my $record = eval { JSON::PP::decode_json($record_json) };
            if ($@ || ref($record) ne "HASH") {
              $invalid = 1;
              last;
            }
            my $successor = $record->{supersededBy};
            if (defined $successor && !ref($successor) && length $successor) {
              if ($successor !~ /\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/) {
                $invalid = 1;
                last;
              }
              $id = $successor;
              $latest_id = $id;
              next;
            }
            my $status = $record->{status};
            $finished = 1 if defined $status && !ref($status) && length($status) && $status ne "RUNNING";
            last;
          }
          next unless $found_initial;
          if ($invalid || !$finished) {
            $all_finished = 0;
          } elsif (!length($read_dir) || !-f "$read_dir/$latest_id") {
            push @finished_ids, $latest_id;
          }
        }
        if ($resolved && $all_finished) {
          print "IDS " . join(" ", @finished_ids) . chr(10);
        }
      }
    }
  ')
  event_state=$(printf '%s\n' "$event_output" | awk 'substr($0, 1, 6) == "STATE " { print substr($0, 7); exit }')
  event_last=$(printf '%s\n' "$event_output" | awk 'substr($0, 1, 5) == "LAST " { print substr($0, 6); exit }')
  event_last=$(printf '%s' "${event_last:-none}" | perl -pe 's/\s/_/g')
  event_ids=$(printf '%s\n' "$event_output" | awk 'substr($0, 1, 4) == "IDS " { print substr($0, 5); exit }')
  event_question=$(printf '%s\n' "$event_output" | awk 'substr($0, 1, 2) == "Q " { print substr($0, 3); exit }')
  event_settles=$(printf '%s\n' "$event_output" | awk 'substr($0, 1, 8) == "SETTLES " { print substr($0, 9); exit }')
  case $event_settles in
    ''|*[!0-9]*) event_settles=0 ;;
  esac
  case $event_state in
    'IN-TOOL '*) state=$event_state ;;
    SETTLED|WEDGED)
      if [ "$event_state" = WEDGED ]; then
        state=WEDGED
      elif [ "$age" -gt "$settled_max" ]; then
        state=SETTLED-OLD
      else
        state=SETTLED
      fi
      ;;
    'DEAD '* ) state="DEAD-PROVIDER ${event_state#DEAD }" ;;
    *)
      if [ "$age" -gt 300 ]; then
        state='STALL no tool, not settled'
      else
        state=RUNNING
      fi
      ;;
  esac
  park=no
  loop=no
  case $state in
    SETTLED|SETTLED-OLD)
      case $event_question in
        ''|*[!0-9]*) ;;
        *) [ "$ruling_ms" -le "$event_question" ] && park=yes ;;
      esac
      if [ "$ruling_time" -gt 0 ] && [ "$event_settles" -ge 2 ]; then
        worktree=
        for lane_state in "$run"/*-"$n.state"; do
          [ -f "$lane_state" ] || continue
          lane_worktree=$(awk 'index($0, "worktree=") == 1 { print substr($0, 10); exit }' "$lane_state")
          if [ -n "$lane_worktree" ]; then
            worktree=$lane_worktree
            break
          fi
        done
        if [ -n "$worktree" ]; then
          if commit_time=$(git -C "$worktree" log -1 --format=%ct </dev/null 2>/dev/null); then
            case $commit_time in
              ''|*[!0-9]*) ;;
              *) [ "$commit_time" -le "$ruling_time" ] && loop=yes ;;
            esac
          fi
        fi
      fi
      [ "$park" = no ] || state="$state PARK"
      [ "$loop" = no ] || state="$state LOOP"
      if [ "$park" = yes ] || [ "$loop" = yes ]; then
        state="$state last=$event_last"
      fi
      [ -z "$event_ids" ] || state="$state DONE-UNREAD $event_ids"
      ;;
    WEDGED) state="$state last=$event_last" ;;
  esac
  printf '%-6s %-8s %-18s age=%-6s %s\n' "$n" "$pid" "$info" "$age" "$state"
  rows=$((rows + 1))
done
[ "$rows" -gt 0 ] || printf 'lanestat: no live lanes in %s\n' "$run"
if [ -n "$inbox" ]; then
  open_ruling_count=0
  for ruling_file in "$inbox"/open/*.md; do
    [ -f "$ruling_file" ] || continue
    open_ruling_count=$((open_ruling_count + 1))
  done
  if [ "$open_ruling_count" -gt 0 ]; then
    printf 'open rulings: %s\n' "$open_ruling_count"
  fi
fi
