#!/bin/sh
# lanestat [--all] <run-dir>: one row per live pi lane in this host's run dir.
# It stays POSIX so lanewatch can send it to `ssh bash -s` without a remote copy.
# LANESTAT_SETTLED_MAX (seconds, default 7200) marks older SETTLED lanes
# as SETTLED-OLD. lanewatch does not forward the variable over ssh, so remote
# runs use the default unless it is set in the remote environment.
#
# State pairs tool starts and ends by toolCallId within the last 20 MB of the
# jsonl, never from its last line. A prompt sent during a running tool call gets
# an immediate `queued` response while the tool keeps running, so the last line
# can be a response even when the lane is still in that call. The most recent
# unmatched start is IN-TOOL. A matched end removes its start; an unmatched
# end has no effect. agent_settled clears every open start, and SETTLED applies
# only when it is the last relevant event with no later open start. Without an
# open tool or final settle, no write for more than five minutes means STALL. A
# start outside the 20 MB tail is ignored; the operator checks the tool by hand.
# Zero live rows prints `lanestat: no live lanes in <run-dir>`.
# IN-TOOL says pi has a tool call active, not that the tool is making progress.
# WEDGED means a settled lane received a successful non-queued prompt and no
# tool event or message_start followed it; abort, then resend with flywheel's
# `pisend.sh wake` (not shipped here). A queued prompt means pi has an active
# run and is not lost. DEAD-PROVIDER <provider>/<model>: <message> means the
# last assistant message ended with an error and used no tokens; do not re-wake.
# `last=<tool>` accompanies WEDGED, PARK and LOOP;
# its whitespace is replaced with underscores. PARK means the lane needs an
# answer, LOOP leaves the decision to the orchestrator, and DONE-UNREAD <ids>
# names completed jobs the lane has not read. Answer PARK with a ruling or
# fence-grant file. Let the orchestrator decide LOOP. Abort and resend WEDGED.
# Do not re-wake DEAD-PROVIDER. Message the lane naming the jobs in
# DONE-UNREAD <ids>. `lanewatch` prints dated event rows once per settle minute
# and sends PARK, LOOP, WEDGED, DEAD-PROVIDER and DONE-UNREAD to
# LANEWATCH_INBOX when it is set; plain SETTLED and STALL stay on stdout. The
# watcher never stops a lane. Set DELEGATE_JOBS_DIR on the watcher when a
# lane's jobs live under a non-`/tmp` TMPDIR, or DONE-UNREAD stays silent.
# DELEGATE_JOBS_DIR, TMPDIR, JOB_RECORD_SYSTEM_DIR and LANESTAT_SETTLED_MAX are
# not forwarded over ssh; remote values come from the remote environment.
#
# A pid file outlives its lane and the host can reuse its number. Keep a row only
# when `ps -o comm=` still names pi. A lane's TMPDIR is `~/.cache/tmp`, not
# `/tmp`: `jobs wait` records live there, and `DELEGATE_JOBS_DIR` must point to
# that same directory when checking a delegate job. Use `ps -g` on the saved
# pgid for a `jobs wait` process.
#
# Dead pid files accumulate; --all includes them. Never `cat` a lane's
# fiber-<n>-pi.in: it is a FIFO and reading it blocks the lane.
set -u

usage() {
  printf 'usage: lanestat [--all] <run-dir>\n' >&2
  exit 2
}

all=
run=
while [ "$#" -gt 0 ]; do
  case $1 in
    --all)
      [ -z "$all" ] || usage
      all=--all
      ;;
    *)
      [ -z "$run" ] || usage
      run=$1
      ;;
  esac
  shift
done
[ -n "$run" ] || usage
[ -d "$run" ] || { printf 'no such run dir: %s\n' "$run" >&2; exit 2; }

settled_max=${LANESTAT_SETTLED_MAX:-}
case $settled_max in
  ''|*[!0-9]*) settled_max=7200 ;;
esac

now=$(date +%s)
job_dirs=
add_job_dir() {
  job_dir=$1
  [ -n "$job_dir" ] || return
  if [ -n "$job_dirs" ] && printf '%s\n' "$job_dirs" | grep -Fqx -- "$job_dir"; then
    return
  fi
  job_dirs="${job_dirs}${job_dirs:+
}$job_dir"
}
if [ -n "${DELEGATE_JOBS_DIR:-}" ]; then
  case $DELEGATE_JOBS_DIR in
    /*) add_job_dir "$DELEGATE_JOBS_DIR" ;;
    *) add_job_dir "$PWD/$DELEGATE_JOBS_DIR" ;;
  esac
fi
add_job_dir "${TMPDIR:-/tmp}/delegate-jobs"
add_job_dir "${JOB_RECORD_SYSTEM_DIR:-/tmp/delegate-jobs}"
rows=0
for pidfile in "$run"/fiber-*-pi.pid; do
  [ -f "$pidfile" ] || continue
  n=${pidfile##*/}
  n=${n#fiber-}
  n=${n%-pi.pid}
  pid=$(cat "$pidfile" 2>/dev/null)
  [ -n "${pid:-}" ] || continue

  comm=$(ps -o comm= -p "$pid" 2>/dev/null | head -1)
  case ${comm##*/} in
    pi) ;;
    *) comm= ;;
  esac
  info=
  [ -n "$comm" ] && info=$(ps -o stat=,etime= -p "$pid" 2>/dev/null | head -1 | tr -s ' ')
  if [ -z "$info" ]; then
    [ "$all" = --all ] && printf '%-6s %-8s %s\n' "$n" "$pid" DEAD
    continue
  fi

  jsonl=$run/fiber-$n-pi.jsonl
  age=99999
  if [ -f "$jsonl" ]; then
    mtime=$(perl -e 'print ((stat $ARGV[0])[9])' "$jsonl" 2>/dev/null)
    [ -n "${mtime:-}" ] && age=$((now - mtime))
  fi
  ruling_time=0
  for ruling_file in "$run"/*-"$n"-ruling-*.md "$run/fiber-$n-fence-grant-"*.md; do
    [ -f "$ruling_file" ] || continue
    ruling_mtime=$(perl -e 'my @s = stat $ARGV[0]; print $s[9] if @s' "$ruling_file" 2>/dev/null)
    case $ruling_mtime in
      ''|*[!0-9]*) ;;
      *) [ "$ruling_mtime" -gt "$ruling_time" ] && ruling_time=$ruling_mtime ;;
    esac
  done
  ruling_ms=$((ruling_time * 1000))
  event_output=$(tail -c 20000000 "$jsonl" 2>/dev/null | LS_JOB_DIRS="$job_dirs" LS_RULING_MS="$ruling_ms" perl -ne '
    our @open;
    our $settled;
    our $after_prompt;
    our $dead_pending;
    our $dead;
    our $last_tool;
    our $question_line;
    our $settle_cut;
    our $settles;
    our $ruling_ms;
    our @job_ids;
    our %seen_job_ids;
    $last_tool = "none" unless defined $last_tool;
    $settle_cut = 0 unless defined $settle_cut;
    $settles = 0 unless defined $settles;
    $ruling_ms = $ENV{LS_RULING_MS} unless defined $ruling_ms;
    if (/"type":"tool_execution_start","toolCallId":"([^"]*)","toolName":"([^"]*)"/) {
      push @open, [$1, $2];
      $last_tool = $2;
      $settled = 0;
      $after_prompt = 0;
      $dead = undef;
    } elsif (/"type":"tool_execution_end","toolCallId":"([^"]*)"/) {
      $after_prompt = 0;
      $dead = undef;
      for (my $i = $#open; $i >= 0; $i--) {
        if ($open[$i]->[0] eq $1) {
          splice @open, $i, 1;
          $settled = 0;
          last;
        }
      }
    } elsif (/"type":"agent_settled"/) {
      @open = ();
      $settled = 1;
      $after_prompt = 0;
      $dead = $dead_pending;
      $dead_pending = undef;
    } elsif (/"type":"agent_start"/ || /"type":"auto_retry_start"/) {
      $dead_pending = undef;
      $dead = undef;
    } elsif (/"type":"auto_retry_end"/) {
      if (/"success":true/) {
        $dead_pending = undef;
        $dead = undef;
      } elsif (/"success":false/ && /"finalError":"((?:[^"\\]|\\.)*)"/) {
        my $raw_error = $1;
        my $message = "";
        while (length $raw_error) {
          if ($raw_error =~ s/^([^\\]+)//) {
            $message .= $1;
          } elsif ($raw_error =~ s/^\\(?:n|r|u000a|u000d).*$//i) {
            last;
          } elsif ($raw_error =~ s/^\\\\//) {
            $message .= "\\";
          } elsif ($raw_error =~ s/^\\"//) {
            $message .= "\"";
          } elsif ($raw_error =~ s/^\\t//) {
            $message .= "\t";
          } elsif ($raw_error =~ s/^\\(?:b|f)//) {
            $message .= " ";
          } elsif ($raw_error =~ s/^\\u000([0-9a-f])//i) {
            $message .= chr(hex($1));
          } elsif ($raw_error =~ s/^\\u[0-9a-f]{4}//i) {
            next;
          } elsif ($raw_error =~ s/^\\.//s) {
            next;
          }
        }
        $message =~ s/[\x00-\x1f\x7f]/ /g;
        $message =~ s/\s+$//;
        $message = substr($message, 0, 200);
        $dead_pending = length($message) ? $message : "unknown";
      }
    } elsif (/"type":"response"/ && /"command":"prompt"/ && /"success":true/ && !/"(?:disposition|status)":"queued"/) {
      $after_prompt = 1;
      $dead_pending = undef;
      $dead = undef;
    } elsif (/"type":"message_start"/) {
      $dead = undef;
      if ($after_prompt) {
        $settled = 0;
        $after_prompt = 0;
      }
    }
    if (/"type":"message_end","message":{"role":"assistant"/ && /"type":"text"/) {
      $question_line = $_;
    }
    if ($ruling_ms > 0 && /"type":"message_end"/) {
      my @timestamps = /"timestamp":(\d+)/g;
      $settle_cut = 1 if @timestamps && $timestamps[-1] > $ruling_ms;
    }
    $settles++ if $settle_cut && /"type":"agent_settled"/;
    if (/"type":"(?:tool_execution_end|message_end)"/) {
      while (/\b([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\b/g) {
        push @job_ids, $1 unless $seen_job_ids{$1}++;
      }
    }
    END {
      if (@open) {
        print "STATE IN-TOOL " . $open[-1]->[1] . chr(10);
      } elsif ($settled && defined $dead) {
        print "STATE DEAD $dead" . chr(10);
      } elsif ($settled && $after_prompt) {
        print "STATE WEDGED" . chr(10);
      } elsif ($settled) {
        print "STATE SETTLED" . chr(10);
      }
      print "LAST $last_tool" . chr(10);
      print "SETTLES $settles" . chr(10);
      if (defined $question_line && eval { require JSON::PP; 1 }) {
        my $candidate = eval { JSON::PP::decode_json($question_line) };
        if (!$@ && ref($candidate) eq "HASH" && ref($candidate->{message}) eq "HASH") {
          my $message = $candidate->{message};
          my $timestamp = $message->{timestamp};
          if (defined $timestamp && !ref($timestamp) && $timestamp =~ /\A[0-9]+\z/) {
            my @texts;
            if (ref($message->{content}) eq "ARRAY") {
              for my $block (@{$message->{content}}) {
                if (ref($block) eq "HASH" && defined $block->{type} && $block->{type} eq "text" && defined $block->{text} && !ref($block->{text})) {
                  push @texts, $block->{text};
                }
              }
            }
            if (@texts) {
              my $text = join("\n", @texts);
              my $final_line;
              for my $line (reverse split /\n/, $text, -1) {
                $line =~ s/\s+\z//;
                if ($line =~ /\S/) {
                  $final_line = $line;
                  last;
                }
              }
              if (defined $final_line && (substr($final_line, -1, 1) eq "?" || index($final_line, "BLOCKED") >= 0)) {
                print "Q $timestamp" . chr(10);
              }
            }
          }
        }
      }
      if (@job_ids && eval { require JSON::PP; 1 }) {
        my @dirs = split /\n/, defined $ENV{LS_JOB_DIRS} ? $ENV{LS_JOB_DIRS} : "";
        my @finished_ids;
        my $resolved = 0;
        my $all_finished = 1;
        for my $printed_id (@job_ids) {
          my $id = $printed_id;
          my %visited;
          my $found_initial = 0;
          my $invalid = 0;
          my $finished = 0;
          while (1) {
            if ($visited{$id}++) {
              $invalid = 1;
              last;
            }
            my $path;
            for my $dir (@dirs) {
              next unless length $dir;
              my $candidate = "$dir/$id.json";
              if (-f $candidate) {
                $path = $candidate;
                last;
              }
            }
            if (!defined $path) {
              if (!$found_initial) {
                last;
              }
              $invalid = 1;
              last;
            }
            if (!$found_initial) {
              $found_initial = 1;
              $resolved++;
            }
            my $record_fh;
            if (!open($record_fh, "<", $path)) {
              $invalid = 1;
              last;
            }
            local $/;
            my $record_json = <$record_fh>;
            close $record_fh;
            my $record = eval { JSON::PP::decode_json($record_json) };
            if ($@ || ref($record) ne "HASH") {
              $invalid = 1;
              last;
            }
            my $successor = $record->{supersededBy};
            if (defined $successor && !ref($successor) && length $successor) {
              if ($successor !~ /\A[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\z/) {
                $invalid = 1;
                last;
              }
              $id = $successor;
              next;
            }
            my $status;
            if (ref($record->{result}) eq "HASH" && exists $record->{result}{status} && defined $record->{result}{status}) {
              $status = $record->{result}{status};
            } else {
              $status = $record->{status};
            }
            $finished = 1 if defined $status && !ref($status) && ($status eq "DONE" || $status eq "DONE_WITH_CONCERNS");
            last;
          }
          next unless $found_initial;
          if ($invalid || !$finished) {
            $all_finished = 0;
          } else {
            push @finished_ids, $printed_id;
          }
        }
        if ($resolved && $all_finished) {
          print "IDS " . join(" ", @finished_ids) . chr(10);
        }
      }
    }
  ')
  event_state=$(printf '%s\n' "$event_output" | awk 'substr($0, 1, 6) == "STATE " { print substr($0, 7); exit }')
  event_last=$(printf '%s\n' "$event_output" | awk 'substr($0, 1, 5) == "LAST " { print substr($0, 6); exit }')
  event_last=$(printf '%s' "${event_last:-none}" | perl -pe 's/\s/_/g')
  event_ids=$(printf '%s\n' "$event_output" | awk 'substr($0, 1, 4) == "IDS " { print substr($0, 5); exit }')
  event_question=$(printf '%s\n' "$event_output" | awk 'substr($0, 1, 2) == "Q " { print substr($0, 3); exit }')
  event_settles=$(printf '%s\n' "$event_output" | awk 'substr($0, 1, 8) == "SETTLES " { print substr($0, 9); exit }')
  case $event_settles in
    ''|*[!0-9]*) event_settles=0 ;;
  esac
  case $event_state in
    'IN-TOOL '*) state=$event_state ;;
    SETTLED|WEDGED)
      if [ "$event_state" = WEDGED ]; then
        state=WEDGED
      elif [ "$age" -gt "$settled_max" ]; then
        state=SETTLED-OLD
      else
        state=SETTLED
      fi
      ;;
    'DEAD '* ) state="DEAD-PROVIDER ${event_state#DEAD }" ;;
    *)
      if [ "$age" -gt 300 ]; then
        state='STALL no tool, not settled'
      else
        state=RUNNING
      fi
      ;;
  esac
  park=no
  loop=no
  case $state in
    SETTLED|SETTLED-OLD)
      case $event_question in
        ''|*[!0-9]*) ;;
        *) [ "$ruling_ms" -le "$event_question" ] && park=yes ;;
      esac
      if [ "$ruling_time" -gt 0 ] && [ "$event_settles" -ge 2 ]; then
        worktree=
        for lane_state in "$run"/*-"$n.state"; do
          [ -f "$lane_state" ] || continue
          lane_worktree=$(awk 'index($0, "worktree=") == 1 { print substr($0, 10); exit }' "$lane_state")
          if [ -n "$lane_worktree" ]; then
            worktree=$lane_worktree
            break
          fi
        done
        if [ -n "$worktree" ]; then
          if commit_time=$(git -C "$worktree" log -1 --format=%ct </dev/null 2>/dev/null); then
            case $commit_time in
              ''|*[!0-9]*) ;;
              *) [ "$commit_time" -le "$ruling_time" ] && loop=yes ;;
            esac
          fi
        fi
      fi
      [ "$park" = no ] || state="$state PARK"
      [ "$loop" = no ] || state="$state LOOP"
      if [ "$park" = yes ] || [ "$loop" = yes ]; then
        state="$state last=$event_last"
      fi
      [ -z "$event_ids" ] || state="$state DONE-UNREAD $event_ids"
      ;;
    WEDGED) state="$state last=$event_last" ;;
  esac
  printf '%-6s %-8s %-18s age=%-6s %s\n' "$n" "$pid" "$info" "$age" "$state"
  rows=$((rows + 1))
done
[ "$rows" -gt 0 ] || printf 'lanestat: no live lanes in %s\n' "$run"
