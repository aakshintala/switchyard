#!/usr/bin/env bash
# tkt-fix: one review-loop fix round: fix job, push when the job left it
# unpushed, pre-push checks, then a scoped verify or a no-verify close.
# Slot fix<round+1> keeps rounds apart: tkt-job re-prints a terminal slot's
# digest, so a second round under one slot would read the first round's.
# Usage: tkt-fix <state> (--verify | --no-verify) [--findings <file>]
#   [--resume <job id> --prompt <file>] [--fix-model <id>] [--verify-model <id>]
set -euo pipefail

usage() {
  echo "usage: tkt-fix <state> (--verify | --no-verify) [--findings <file>] [--resume <job id> --prompt <file>] [--fix-model <id>] [--verify-model <id>]" >&2
  exit 2
}

[ $# -ge 2 ] || usage
state="$1"; shift
verify=0; noverify=0; findings=""; resume=""; prompt=""; fixmodel=""; verifymodel=""
while [ $# -gt 0 ]; do
  case "$1" in
    --verify) verify=1; shift ;;
    --no-verify) noverify=1; shift ;;
    --findings) [ $# -ge 2 ] && [ -n "$2" ] || usage; findings="$2"; shift 2 ;;
    --resume) [ $# -ge 2 ] && [ -n "$2" ] || usage; resume="$2"; shift 2 ;;
    --prompt) [ $# -ge 2 ] && [ -n "$2" ] || usage; prompt="$2"; shift 2 ;;
    --fix-model) [ $# -ge 2 ] && [ -n "$2" ] || usage; fixmodel="$2"; shift 2 ;;
    --verify-model) [ $# -ge 2 ] && [ -n "$2" ] || usage; verifymodel="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ "$verify" -ne "$noverify" ] || usage
[ -z "$resume$prompt" ] || { [ -n "$resume" ] && [ -n "$prompt" ]; } || usage

script_dir="$(cd "$(dirname "$0")" && pwd)"; tkt_state="$script_dir/tkt-state"; bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
tktjob="$bin_dir/tkt-job"; tktgate="$bin_dir/tkt-gate"; ghci="$bin_dir/gh-ci"; reviewpr="$bin_dir/review-pr"
fbrief="$HOME/.agents/skills/review-loop/briefs/fix.md"
t() { "$tkt_state" "$state" "$@"; }

lockdir="$state.lock"
if mkdir "$lockdir" 2>/dev/null; then rmdir "$lockdir"
else pid="$(cat "$lockdir/pid" 2>/dev/null || true)"; echo "tkt-fix: state locked${pid:+ by pid $pid}" >&2; exit 2; fi

t require repo issue branch worktree run pr
repo="$(t get repo)"; issue="$(t get issue)"; branch="$(t get branch)"
worktree="$(t get worktree)"; run="$(t get run)"; pr="$(t get pr)"
mkdir -p "$run"
if stored="$(t get head 2>/dev/null)"; then
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || { echo "tkt-fix: cannot read worktree HEAD: $worktree" >&2; exit 2; }
  [ "$stored" = "$actual" ] || { echo "tkt-fix: head drift: state $state head=$stored worktree $worktree HEAD=$actual" >&2; exit 3; }
fi
[ -n "$findings" ] || findings="$(t get findings 2>/dev/null)" || { echo "tkt-fix: missing key: findings (no --findings and no state findings)" >&2; exit 2; }
[ -r "$findings" ] || { echo "tkt-fix: cannot read findings: $findings" >&2; exit 2; }
round="$(t get round 2>/dev/null || printf '0')"; case "$round" in ''|*[!0-9]*) round=0;; esac
slot="fix$((round + 1))"

tmp="$(mktemp "${TMPDIR:-/tmp}/tkt-fix.XXXXXX")"; rm -f "$tmp"; mkdir "$tmp"
trap 'rm -rf "$tmp"' EXIT

emit() {
  verdict="$1"; ec="$2"; shift 2
  logpath="$run/$repo-$issue-tkt-fix-$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')-$(date +%H%M%S).log"
  { printf 'TKT tkt-fix %s log=%s\n' "$verdict" "$logpath"; [ $# -eq 0 ] || printf '%s\n' "$@" | head -n 40; } >"$logpath"
  cat "$logpath"; t journal "tkt-fix $verdict"; exit "$ec"
}

pass() {
  first="$(head -n 1 "$2")"; rest="$(tail -n +2 "$2")"
  case "$first" in "TKT tkt-"*)
    v="${first#TKT }"; v="${v#* }"; v="${v% log=*}"; emit "$v" "$3" "$rest" ;;
  *) emit "UNKNOWN tool=$1" 3 "$first" "$rest" ;; esac
}

write_findings() {
  fr="$run/$repo-$issue-findings-r$round.md"
  if grep -q '^P[123] ' "$1" 2>/dev/null; then grep '^P[123] ' "$1" >"$fr"
  else printf 'no open findings\n' >"$fr"; fi
  t set findings "$fr"
}

if [ -n "$resume" ]; then args=(--slot "$slot" --resume "$resume" --prompt "$prompt")
else
  [ -n "$fixmodel" ] || fixmodel="$(t get model.fix 2>/dev/null)" || { echo "tkt-fix: missing key: model.fix (no --fix-model and no state model.fix)" >&2; exit 2; }
  args=(--slot "$slot" --model "$fixmodel" --template "$fbrief" "FINDINGS=@$findings" --gate-from-plan --expect-commits)
fi
jrc=0; "$tktjob" "$state" "${args[@]}" >"$tmp/job.out" 2>"$tmp/job.err" || jrc=$?
if [ -s "$tmp/job.err" ]; then cat "$tmp/job.err" >&2; fi
[ "$jrc" -eq 0 ] || pass tkt-job "$tmp/job.out" "$jrc"

git -C "$worktree" fetch origin >/dev/null 2>&1 || { echo "tkt-fix: fetch failed in $worktree" >&2; exit 2; }
new_head="$(git -C "$worktree" rev-parse HEAD)" || { echo "tkt-fix: cannot read worktree HEAD: $worktree" >&2; exit 2; }
remote_head="$(git -C "$worktree" rev-parse --verify "origin/$branch" 2>/dev/null || true)"
ci_note=""
if [ "$remote_head" != "$new_head" ] && { [ -z "$remote_head" ] || git -C "$worktree" merge-base --is-ancestor "$remote_head" "$new_head" 2>/dev/null; }; then
  crc=0; "$ghci" wait "$pr" >"$tmp/ci.out" 2>&1 || crc=$?
  [ "$crc" = "0" ] || [ "$crc" = "1" ] || emit "CI-WAIT rc=$crc" 1 "$(cat "$tmp/ci.out")"
  [ "$crc" = "0" ] || ci_note="$(grep . "$tmp/ci.out" | head -n 10)"
  if ! push_out="$(git -C "$worktree" push origin "$branch" 2>&1)"; then emit "PUSH-FAIL" 1 "$push_out"; fi
fi

grc=0; t set head "$new_head"
# Head moves before the gate: the fix job's commits already drifted it,
# and the gate refuses drift. A failed gate leaves head set; the round
# still counts only on PASS below.
"$tktgate" "$state" --checks-only --expect-head "$new_head" >"$tmp/gate.out" 2>"$tmp/gate.err" || grc=$?
if [ -s "$tmp/gate.err" ]; then cat "$tmp/gate.err" >&2; fi
[ "$grc" -eq 0 ] || pass tkt-gate "$tmp/gate.out" "$grc"
round=$((round + 1)); t set round "$round"

if [ "$noverify" -eq 1 ]; then
  t set unverified "$findings"
  if [ -n "$ci_note" ]; then emit "PUSHED unverified" 0 "head=$new_head" "round=$round" "$ci_note"; fi
  emit "PUSHED unverified" 0 "head=$new_head" "round=$round"
fi
[ -n "$verifymodel" ] || verifymodel="$(t get model.verify 2>/dev/null)" || { echo "tkt-fix: missing key: model.verify (no --verify-model and no state model.verify)" >&2; exit 2; }
reviewed="$(t get reviewed 2>/dev/null)" || { echo "tkt-fix: missing key: reviewed" >&2; exit 2; }
vrc=0; "$reviewpr" run "$pr" --repo "$repo" --cwd "$worktree" --head "$new_head" --model "$verifymodel" --verify "$findings" --since "$reviewed" >"$tmp/verify.out" 2>"$tmp/verify.err" || vrc=$?
if [ -s "$tmp/verify.err" ]; then cat "$tmp/verify.err" >&2; fi
[ "$vrc" -eq 0 ] || emit "VERIFY-FAIL rc=$vrc" 1 "$(cat "$tmp/verify.out")"
fixline="$(grep -m 1 '^FIX-' "$tmp/verify.out" || true)"
case "$fixline" in
  FIX-OK*) t set reviewed "$new_head"; write_findings "$tmp/verify.out"
    if [ -n "$ci_note" ]; then emit "FIX-OK reviewed=$new_head" 0 "head=$new_head" "round=$round" "$ci_note"; fi
    emit "FIX-OK reviewed=$new_head" 0 "head=$new_head" "round=$round" ;;
  FIX-INCOMPLETE*) write_findings "$tmp/verify.out"; open="$(grep '^P[123] ' "$tmp/verify.out" | head -n 30 || true)"
    if [ "$round" -ge 2 ]; then emit "FIX-INCOMPLETE round=$round STOP-AT-TWO" 1 "$open" "$ci_note"; fi
    emit "FIX-INCOMPLETE round=$round" 1 "$open" "$ci_note" ;;
  *) emit "VERIFY-FAIL" 1 "$(head -n 40 "$tmp/verify.out")" ;;
esac
