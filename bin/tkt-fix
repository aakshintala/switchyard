#!/usr/bin/env bash
# tkt-fix: one review-loop fix round; slot fix<max(round,fixslot)+1> keeps
# rounds apart: tkt-job re-prints a terminal slot's digest.
# A lane blocked before its PR resumes with tkt-job --resume <job.lane> followed by tkt-build --from gate, or with tkt-build --from lane when no lane ran.
# Usage: tkt-fix <state> (--verify [--since <sha>] | --no-verify) [--findings <file>]
#   [--resume <job id> --prompt <file>] [--fix-model <id>] [--verify-model <id>]
set -euo pipefail

usage() {
  echo "usage: tkt-fix <state> (--verify [--since <sha>] | --no-verify) [--findings <file>] [--resume <job id> --prompt <file>] [--fix-model <id>] [--verify-model <id>]" >&2
  exit 2
}

[ $# -ge 2 ] || usage
state="$1"; shift
verify=0; noverify=0; findings=""; since=""; resume=""; prompt=""; fixmodel=""; verifymodel=""
while [ $# -gt 0 ]; do
  case "$1" in
    --verify) verify=1; shift ;;
    --no-verify) noverify=1; shift ;;
    --findings) [ $# -ge 2 ] && [ -n "$2" ] || usage; findings="$2"; shift 2 ;;
    --since) [ $# -ge 2 ] && [ -n "$2" ] || usage; since="$2"; shift 2 ;;
    --resume) [ $# -ge 2 ] && [ -n "$2" ] || usage; resume="$2"; shift 2 ;;
    --prompt) [ $# -ge 2 ] && [ -n "$2" ] || usage; prompt="$2"; shift 2 ;;
    --fix-model) [ $# -ge 2 ] && [ -n "$2" ] || usage; fixmodel="$2"; shift 2 ;;
    --verify-model) [ $# -ge 2 ] && [ -n "$2" ] || usage; verifymodel="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ "$verify" -ne "$noverify" ] || usage
[ -z "$since" ] || [ "$verify" -eq 1 ] || usage
[ -z "$resume$prompt" ] || { [ -n "$resume" ] && [ -n "$prompt" ]; } || usage

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
tkt_state="$script_dir/tkt-state"; bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then echo "tkt-fix: cannot read shared lib: $namebase_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$namebase_lib"
plan_gate_lib="$script_dir/lib/plan-gate-args.sh"
if [ ! -r "$plan_gate_lib" ]; then echo "tkt-fix: cannot read shared lib: $plan_gate_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$plan_gate_lib"
gate_lib="$script_dir/lib/gate-script.sh"
if [ ! -r "$gate_lib" ]; then echo "tkt-fix: cannot read shared lib: $gate_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$gate_lib"
tktjob="$bin_dir/tkt-job"; tktgate="$bin_dir/tkt-gate"; ghci="$bin_dir/gh-ci"; reviewpr="$bin_dir/review-pr"
plangate="$bin_dir/plan-gate"
fbrief="$HOME/.agents/skills/review-loop/briefs/fix.md"
t() { "$tkt_state" "$state" "$@"; }

# close_slot K: record slot fix<K> closed; the highest closed slot never drops.
close_slot() {
  cur="$(t get fixslot 2>/dev/null || printf '0')"; case "$cur" in ''|*[!0-9]*) cur=0;; esac
  if [ "$1" -gt "$cur" ]; then t set fixslot "$1"; fi
}

# slot_owner ID: print the slot whose stored job id the walk from ID reaches
# (itself, then supersededBy links); print nothing when none is reached.
slot_owner() {
  walk="$1"; seen=" $walk "; first=1
  while [ -n "$walk" ]; do
    k=1
    while [ "$k" -le "$n" ]; do
      if cand="$(t get "job.fix$k" 2>/dev/null || true)" && [ -n "$cand" ] && [ "$cand" = "$walk" ]; then printf 'fix%s\n' "$k"; return 0; fi
      k=$((k + 1))
    done
    rec="$(bash "$script_dir/job-record" "$walk" 2>/dev/null || true)"
    if [ -z "$rec" ]; then
      if [ "$first" -eq 1 ]; then
        k=1; have=0
        while [ "$k" -le "$n" ]; do
          if cand="$(t get "job.fix$k" 2>/dev/null || true)" && [ -n "$cand" ]; then have=1; break; fi
          k=$((k + 1))
        done
        [ "$have" -eq 0 ] || return 2
      fi
      return 0
    fi
    first=0
    walk="$(jq -r '.supersededBy // empty' "$rec" 2>/dev/null || true)"
    [ -n "$walk" ] || return 0
    case "$seen" in *" $walk "*) return 0;; esac
    seen="$seen$walk "
  done
  return 0
}

# stale_locator_target ID: success only when a well-formed per-user locator
# names a record file that no longer exists. Used to distinguish a lost resume
# record from other delegate failures without changing the owning-slot guard.
stale_locator_target() {
  local id="$1" cache_root locator target
  case "$id" in ""|*/*) return 1 ;; esac
  cache_root="${XDG_CACHE_HOME:-}"
  case "$cache_root" in
    /*) ;;
    *)
      case "${HOME:-}" in
        /*) cache_root="$HOME/.cache" ;;
        *) return 1 ;;
      esac
      ;;
  esac
  locator="$cache_root/delegate/locators/$id"
  [ -f "$locator" ] || return 1
  target=""
  IFS= read -r target <"$locator" || [ -n "$target" ] || return 1
  case "$target" in /*) ;; *) return 1 ;; esac
  local extra=""
  if IFS= read -r extra < <(tail -n +2 "$locator") || [ -n "$extra" ]; then
    return 1
  fi
  [ ! -f "$target" ]
}

lockdir="$state.lock"
if mkdir "$lockdir" 2>/dev/null; then rmdir "$lockdir"
else pid="$(cat "$lockdir/pid" 2>/dev/null || true)"; echo "tkt-fix: state locked${pid:+ by pid $pid}" >&2; exit 2; fi

t require repo issue branch worktree run
repo="$(t get repo)"; issue="$(t get issue)"; set_namebase "$repo" "$issue"; branch="$(t get branch)"
worktree="$(t get worktree)"; run="$(t get run)"
reviewed="$(t get reviewed 2>/dev/null || true)"
verify_since="$reviewed"
if [ -n "$since" ]; then
  since_full="$(git -C "$worktree" rev-parse --verify "${since}^{commit}" 2>/dev/null)" || {
    echo "tkt-fix: --since does not resolve to a commit in worktree: $since" >&2
    exit 2
  }
  if [ -n "$reviewed" ]; then
    reviewed_commit="$(git -C "$worktree" rev-parse --verify "${reviewed}^{commit}" 2>/dev/null || true)"
    [ -n "$reviewed_commit" ] || reviewed_commit="$reviewed"
    if [ "$reviewed_commit" != "$since_full" ]; then
      echo "tkt-fix: --since $since_full conflicts with reviewed $reviewed_commit" >&2
      exit 2
    fi
  fi
  verify_since="$since_full"
fi
if [ "$verify" -eq 1 ] && [ -z "$verify_since" ]; then
  echo "tkt-fix: missing key: reviewed; pass --since <sha of the head the reviews covered>" >&2
  exit 2
fi
mkdir -p "$run"
round="$(t get round 2>/dev/null || printf '0')"; case "$round" in ''|*[!0-9]*) round=0;; esac
fixslot="$(t get fixslot 2>/dev/null || printf '0')"; case "$fixslot" in ''|*[!0-9]*) fixslot=0;; esac
part_suffix="$(part_findings_suffix "$(t get part 2>/dev/null || true)")"
if [ "$round" -gt "$fixslot" ]; then n=$((round + 1)); else n=$((fixslot + 1)); fi
slot="fix$n"
if [ -n "$resume" ]; then
  # A resume reuses the slot that owns its id; an id no walk reaches falls
  # back to the fresh slot. An id with no record at all is refused only
  # when some slot already owns a job, so a first resume still dispatches.
  if owned="$(slot_owner "$resume")"; then [ -z "$owned" ] || slot="$owned"
  else echo "tkt-fix: unknown job id: $resume" >&2; exit 2
  fi
fi
knum="${slot#fix}"
history_file="$run/$namebase$part_suffix-findings-history-r$knum.md"
tmp="$(mktemp "${TMPDIR:-/tmp}/tkt-fix.XXXXXX")"; rm -f "$tmp"; mkdir "$tmp"
trap 'rm -rf "$tmp"' EXIT

emit() {
  verdict="$1"; ec="$2"; shift 2
  logpath="$run/$namebase-tkt-fix-$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')-$(date +%H%M%S).log"
  { printf 'TKT tkt-fix %s log=%s\n' "$verdict" "$logpath"; [ $# -eq 0 ] || printf '%s\n' "$@" | head -n 40; } >"$logpath"
  cat "$logpath"; t journal "tkt-fix $verdict"; exit "$ec"
}
# Two rounds have run: a --resume may continue without an open slot.
[ "$round" -lt 2 ] || [ -n "$resume" ] || emit "ROUND-LIMIT round=$round" 1 "resume a job with: tkt-fix $state --verify --resume <job id> --prompt <file> (works with no open slot); otherwise send the open findings to triage"
# Fill missing PR identity before checking entry drift or dispatching a fix.
# pre_pr_resume_hint names the pre-PR resume on the no-PR refusals below.
pre_pr_resume_hint() {
  lane="$(t get job.lane 2>/dev/null || true)"
  if [ -n "$lane" ]; then
    echo "tkt-fix: a lane blocked before its PR resumes with: tkt-job $state --slot lane --resume $lane --prompt <answer file> --gate-from-plan --expect-commits; then tkt-build $state --from gate" >&2
  else
    echo "tkt-fix: a lane blocked before its PR resumes with: tkt-build $state --from lane" >&2
  fi
}
pr="$(t get pr 2>/dev/null || true)"
stored="$(t get head 2>/dev/null || true)"
if [ -z "$pr" ] || [ -z "$stored" ]; then
  if ! pr_list="$(gh pr list --head "$branch" --repo "$repo" --state open --json number,headRefOid 2>/dev/null)"; then
    echo "tkt-fix: PRECONDITION missing=pr: cannot list PRs for branch $branch" >&2
    exit 2
  fi
  if ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$pr_list"; then
    echo "tkt-fix: PRECONDITION missing=pr: cannot list PRs for branch $branch" >&2
    exit 2
  fi
  if [ -n "$pr" ]; then
    entry="$(jq -c --arg pr "$pr" '[.[] | select((.number | tostring) == $pr)][0] // empty' <<<"$pr_list" 2>/dev/null || true)"
  else
    entry="$(jq -c '.[0] // empty' <<<"$pr_list" 2>/dev/null || true)"
  fi
  if [ -z "$entry" ]; then
    echo "tkt-fix: PRECONDITION missing=pr: no open PR for branch $branch in $repo" >&2
    pre_pr_resume_hint
    exit 2
  fi
  if [ -z "$pr" ]; then
    pr="$(jq -r 'if .number == null then "" else (.number | tostring) end' <<<"$entry" 2>/dev/null || true)"
    if [ -z "$pr" ]; then
      echo "tkt-fix: PRECONDITION missing=pr: no open PR for branch $branch in $repo" >&2
      pre_pr_resume_hint
      exit 2
    fi
  fi
  if [ -z "$stored" ]; then
    stored="$(jq -r 'if .headRefOid == null then "" else (.headRefOid | tostring) end' <<<"$entry" 2>/dev/null || true)"
    if [ -z "$stored" ]; then
      echo "tkt-fix: PRECONDITION missing=head: open PR for branch $branch has no headRefOid" >&2
      exit 2
    fi
  fi
  [ -n "$(t get pr 2>/dev/null || true)" ] || t set pr "$pr"
  [ -n "$(t get head 2>/dev/null || true)" ] || t set head "$stored"
fi
# Entry: state head, PR head and worktree HEAD must agree exactly.
if stored="$(t get head 2>/dev/null || true)" && [ -n "$stored" ]; then
  prhead="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid)" || { echo "tkt-fix: cannot read PR head" >&2; exit 2; }
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || { echo "tkt-fix: cannot read worktree HEAD: $worktree" >&2; exit 2; }
  if [ "$stored" = "$prhead" ] && [ "$prhead" = "$actual" ]; then :; else
    # Drift the open fix job's own push caused is accepted: the PR head
    # descends from the state head and the worktree matches the PR head,
    # so the state head moves forward to the PR head.
    openk="$(t get fixopen 2>/dev/null || printf '0')"; case "$openk" in ''|*[!0-9]*) openk=0;; esac
    keep=0
    recover_unpushed=0
    wt_status="$(git -C "$worktree" status --porcelain 2>/dev/null || printf '?')"
    clean=0; [ -z "$wt_status" ] && clean=1
    if [ "$openk" -gt 0 ]; then
      if fjob="$(t get "job.fix$openk" 2>/dev/null || true)" && [ -n "$fjob" ] \
        && git -C "$worktree" merge-base --is-ancestor "$stored" "$prhead" 2>/dev/null \
        && [ "$actual" = "$prhead" ] && [ "$clean" -eq 1 ]; then
        t set head "$prhead"
        t set fixopen 0
        keep=1
      elif [ -n "$fjob" ] && [ "$prhead" != "$actual" ] \
        && [ "$clean" -eq 1 ] \
        && { [ "$stored" = "$prhead" ] || [ "$stored" = "$actual" ]; } \
        && git -C "$worktree" merge-base --is-ancestor "$prhead" "$actual" 2>/dev/null; then
        # Ownership: the ahead commits must be the open job's own. Its
        # delegate record carries changeSet.headAfter, located the same way
        # tkt-job locates it; only an exact match with the worktree HEAD
        # proves no outside commit landed on top.
        rec="$(bash "$script_dir/job-record" "$fjob" 2>/dev/null || true)"
        owned=""
        if [ -n "$rec" ] && [ -f "$rec" ]; then
          owned="$(jq -r '.result.changeSet.headAfter // ""' "$rec" 2>/dev/null || true)"
        fi
        if [ -n "$owned" ] && [ "$owned" = "$actual" ]; then
          # Carry the validated recovery through tkt-job's head-drift guard
          # the same way a normal job end does. fixopen stays on the open
          # slot: its commits are still unpushed, and the dispatch below
          # re-marks it to the slot that runs next.
          t set head "$actual"
          echo "tkt-fix: worktree is ahead of the PR head by open fix job fix$openk's unpushed commits" >&2
          keep=1
        fi
      fi
    fi
    # Closed slots may use this broader recovery; open slots still need the
    # exact job-record ownership proved above.
    if [ "$keep" -eq 0 ] && [ "$openk" -eq 0 ] && [ "$clean" -eq 1 ] && [ "$prhead" != "$actual" ] \
      && git -C "$worktree" merge-base --is-ancestor "$stored" "$prhead" 2>/dev/null \
      && git -C "$worktree" merge-base --is-ancestor "$prhead" "$actual" 2>/dev/null; then
      recovery_slot="$fixslot"
      [ "$openk" -le 0 ] || recovery_slot="$openk"
      [ "$recovery_slot" -gt 0 ] || recovery_slot="$n"
      slot="fix$recovery_slot"
      knum="$recovery_slot"
      recover_unpushed=1
      recover_old_head="$prhead"
      recover_new_head="$actual"
      keep=1
    fi
    if [ "$keep" -eq 0 ]; then
      # A pushed rebase or main merge leaves PR head == worktree HEAD on a
      # clean tree, descended from the state head. Name the supported route;
      # the head never moves here.
      route=""
      if [ "$prhead" = "$actual" ] && [ "$clean" -eq 1 ] \
        && git -C "$worktree" merge-base --is-ancestor "$stored" "$actual" 2>/dev/null; then
        route="after a rebase or main merge, run: tkt-state $state set head $actual"
      fi
      emit "DRIFT" 3 "state head=$stored" "PR head=$prhead" "worktree HEAD=$actual" ${route:+"$route"}
    fi
  fi
fi
recover_unpushed="${recover_unpushed:-0}"
if [ "$recover_unpushed" -eq 0 ] && [ -z "$resume" ] && job="$(t get "job.$slot" 2>/dev/null || true)" && [ -n "$job" ]; then emit "RECOVER" 3 "job=$job" "slot=$slot"; fi
[ -n "$findings" ] || findings="$(t get findings 2>/dev/null)" || { echo "tkt-fix: missing key: findings (no --findings and no state findings)" >&2; exit 2; }
[ -r "$findings" ] || { echo "tkt-fix: cannot read findings: $findings" >&2; exit 2; }

pass() {
  tool="$1"; output="$2"; ec="$3"; stderr_file="${4:-}"
  first="$(head -n 1 "$output")"; rest="$(tail -n +2 "$output")"
  case "$first" in "TKT tkt-"*)
    v="${first#TKT }"; v="${v#* }"; v="${v% log=*}"; emit "$v" "$ec" "$rest" ;;
  *)
    details=()
    [ -z "$first" ] || details+=("$first")
    [ -z "$rest" ] || details+=("$rest")
    if [ -n "$stderr_file" ] && [ -s "$stderr_file" ]; then
      details+=("$(cat "$stderr_file")")
    fi
    [ "${#details[@]}" -gt 0 ] || details+=("$tool wrote no output")
    emit "UNKNOWN tool=$tool" 3 "${details[@]}" ;;
  esac
}

write_findings() {
  fr="$run/$namebase$part_suffix-findings-r$round.md"
  if ! findings_write_allowed "$state" "$fr"; then
    echo "tkt-fix: refusing to overwrite $fr: $namebase$part_suffix-findings-r$round.md names are reserved for this ticket's own findings output; write hand-kept notes to $namebase$part_suffix-dispositions-r$round.md instead" >&2
    exit 2
  fi
  if grep -q '^P[123] ' "$1" 2>/dev/null; then grep '^P[123] ' "$1" >"$fr"
  else printf 'no open findings\n' >"$fr"; fi
  t journal "findings write $fr"
  t set findings "$fr"
}

record_round_findings() {
  local key="fix_round.$knum.findings" path state_arg path_arg
  path="$(t get "$key" 2>/dev/null || true)"
  if [ -n "$path" ]; then
    [ -r "$path" ] || { echo "tkt-fix: recorded round findings are missing: $key=$path" >&2; exit 2; }
    return 0
  fi
  path="$run/$namebase$part_suffix-fix-round-$knum-findings.md"
  if [ -e "$path" ]; then
    state_arg="$(printf '%q' "$state")"; path_arg="$(printf '%q' "$path")"
    echo "tkt-fix: refusing to overwrite unrecorded round findings: $path" >&2
    echo "re-record with: tkt-state $state_arg set $key $path_arg" >&2
    exit 2
  fi
  cp "$findings" "$path" || { echo "tkt-fix: cannot record round findings: $path" >&2; exit 2; }
  t journal "fix round findings write $path"
  t set "fix_round.$knum.findings" "$path"
}

record_round_start() {
  local key="fix_round.$knum.start" path="$1" recorded
  recorded="$(t get "$key" 2>/dev/null || true)"
  if [ -n "$recorded" ]; then
    git -C "$worktree" rev-parse --verify "${recorded}^{commit}" >/dev/null 2>&1 || {
      echo "tkt-fix: recorded round start is not a commit: $key=$recorded" >&2
      exit 2
    }
    return 0
  fi
  path="$(git -C "$worktree" rev-parse --verify "${path}^{commit}" 2>/dev/null)" || {
    echo "tkt-fix: cannot record round start: $path" >&2
    exit 2
  }
  t set "$key" "$path"
  t journal "fix round start write fix$knum $path"
}

record_round_head() {
  local path="$1"
  t set "fix_round.$knum.head" "$path"
  t journal "fix round head write fix$knum $path"
}

verify_round_coverage() {
  local round_list_file="$1" unaccounted_file="$2" commits commit owner limit n round_start round_head round_findings
  local sha_list missing_rounds repair_command state_arg since_arg path_arg first_round_start first_round_commit concrete_start any_round_start
  : >"$round_list_file"; : >"$unaccounted_file"
  if ! git -C "$worktree" merge-base --is-ancestor "$verify_since" "$new_head" 2>/dev/null; then
    emit "SINCE-NOT-ANCESTOR since=$verify_since head=$new_head" 1 \
      "branch history was rewritten after the review, so scoped-verify rounds cannot be mapped" \
      "route: re-review the head, or record reviewed as the rebased equivalent of the reviewed commit"
  fi
  # First parent only: a merge of main into the branch needs an owning round,
  # but the main commits it brings in were never this branch's fix work.
  commits="$(git -C "$worktree" rev-list --first-parent --reverse "$verify_since..$new_head")" || emit "FINDINGS-SCOPE-ERROR" 1 "cannot enumerate commits in $verify_since..$new_head"
  limit="$fixslot"; [ "$knum" -le "$limit" ] || limit="$knum"
  for commit in $commits; do
    owner=""
    n=1
    while [ "$n" -le "$limit" ]; do
      round_start="$(t get "fix_round.$n.start" 2>/dev/null || true)"
      round_head="$(t get "fix_round.$n.head" 2>/dev/null || true)"
      if [ -n "$round_start" ] && [ -n "$round_head" ] && [ "$commit" != "$round_start" ] \
        && git -C "$worktree" merge-base --is-ancestor "$round_start" "$commit" 2>/dev/null \
        && git -C "$worktree" merge-base --is-ancestor "$commit" "$round_head" 2>/dev/null; then owner="$n"; break; fi
      n=$((n + 1))
    done
    if [ -n "$owner" ]; then
      round_findings="$(t get "fix_round.$owner.findings" 2>/dev/null || true)"
      if [ -z "$round_findings" ]; then
        round_findings="$run/$namebase$part_suffix-fix-round-$owner-findings.md"
        if [ -r "$round_findings" ]; then
          t journal "fix round findings write $round_findings"
          t set "fix_round.$owner.findings" "$round_findings"
        fi
      fi
      if [ -n "$round_findings" ] && [ -r "$round_findings" ] && grep -q '^P[123] ' "$round_findings"; then
        grep -qx "$owner" "$round_list_file" || printf '%s\n' "$owner" >>"$round_list_file"
      else
        printf '%s %s\n' "$commit" "$owner" >>"$unaccounted_file"
      fi
    else
      printf '%s unknown\n' "$commit" >>"$unaccounted_file"
    fi
  done
  if [ -s "$unaccounted_file" ]; then
    sha_list="$(awk '{print $1}' "$unaccounted_file" | paste -sd, -)"
    missing_rounds="$(awk '$2 != "unknown" {print $2}' "$unaccounted_file" | sort -nu | paste -sd, -)"
    state_arg="$(printf '%q' "$state")"; since_arg="$(printf '%q' "$verify_since")"
    if [ -n "$missing_rounds" ]; then
      repair_command=""
      for n in $(tr ',' ' ' <<<"$missing_rounds"); do
        round_findings="$(t get "fix_round.$n.findings" 2>/dev/null || true)"
        [ -n "$round_findings" ] || round_findings="$run/$namebase$part_suffix-fix-round-$n-findings.md"
        path_arg="$(printf '%q' "$round_findings")"
        repair_command="${repair_command}${repair_command:+ && }tkt-state $state_arg set fix_round.$n.findings $path_arg"
      done
      repair_command="restore the named round findings file(s), then run: $repair_command && tkt-fix $state_arg --verify --since $since_arg"
    else
      first_round_start="$(t get fix_round.1.start 2>/dev/null || true)"
      concrete_start=0
      if [ -z "$first_round_start" ]; then
        any_round_start=0
        n=1
        while [ "$n" -le "$limit" ]; do
          if [ -n "$(t get "fix_round.$n.start" 2>/dev/null || true)" ]; then
            any_round_start=1
            break
          fi
          n=$((n + 1))
        done
        [ "$any_round_start" -eq 0 ] && concrete_start=1
      else
        first_round_commit="$(git -C "$worktree" rev-parse --verify "${first_round_start}^{commit}" 2>/dev/null || true)"
        if [ -n "$first_round_commit" ]; then
          concrete_start=1
          while IFS= read -r commit; do
            [ -n "$commit" ] || continue
            if ! git -C "$worktree" merge-base --is-ancestor "$commit" "$first_round_commit" 2>/dev/null; then
              concrete_start=0
              break
            fi
          done < <(awk '$2 == "unknown" {print $1}' "$unaccounted_file")
        fi
      fi
      if [ "$concrete_start" -eq 1 ]; then
        repair_command="tkt-state $state_arg set fix_round.1.start $since_arg && tkt-fix $state_arg --verify --since $since_arg"
      else
        repair_command="record the owning round with tkt-state $state_arg set fix_round.<n>.start <round start> && tkt-state $state_arg set fix_round.<n>.head <round head> && tkt-state $state_arg set fix_round.<n>.findings <round findings file>, then run tkt-fix $state_arg --verify --since $since_arg"
      fi
    fi
    emit "FINDINGS-UNACCOUNTED commits=$sha_list" 1 \
      "rounds missing findings=${missing_rounds:-unknown}" \
      "repair command: $repair_command"
  fi
}

# Store every finding supplied to a scoped verify, with its origin and later
# closure, separately from the open-only file the next fix job consumes.
write_findings_history() {
  local action="$1" verify_output="${2:-}" round_list_file="${3:-}" history_source row base meta raised status unverified round_path round_no
  local rounds_csv="" rounds_seen="" earlier=0 label
  local i found new_raised
  local -a history_base=() history_raised=() history_status=() history_unverified=() verify_open=()
  history_add_row() {
    local mode="$1" default_raised="$2" row="$3" base meta parsed_raised parsed_status parsed_unverified raised status unverified i
    case "$row" in P1\ *|P2\ *|P3\ *) ;; *) return 0;; esac
    base="$row"; meta=""
    case "$row" in
      *" [tkt-history:"*)
        base="${row%% [tkt-history:*}"
        meta="${row#* [tkt-history: }"; meta="${meta%]}" ;;
    esac
    parsed_raised="$(sed -n 's/.*raised=\([^;]*\).*/\1/p' <<<"$meta")"
    parsed_status="$(sed -n 's/.*status=\([^;]*\).*/\1/p' <<<"$meta")"
    parsed_unverified="$(sed -n 's/.*unverified=\([^;]*\).*/\1/p' <<<"$meta")"
    case "$mode" in
      history)
        raised="${parsed_raised:-$default_raised}"
        status="${parsed_status:-open}"
        unverified="$parsed_unverified" ;;
      current)
        raised="$default_raised"; status=open; unverified="" ;;
      round)
        raised="$default_raised"
        status="${parsed_status:-open}"
        unverified="$parsed_unverified" ;;
    esac
    for i in "${!history_base[@]}"; do [ "${history_base[$i]}" = "$base" ] && return 0; done
    history_base+=("$base"); history_raised+=("$raised"); history_status+=("$status"); history_unverified+=("$unverified")
  }
  history_source="$(t get findings_history 2>/dev/null || true)"
  if [ -n "$history_source" ] && [ -r "$history_source" ]; then
    while IFS= read -r row; do history_add_row history unknown "$row"; done <"$history_source"
  fi
  # The first findings file is round 0's posted review. Later untracked input
  # is labelled unknown rather than being assigned a round without evidence.
  if [ "${#history_base[@]}" -eq 0 ] && { [ -z "$history_source" ] || [ ! -r "$history_source" ]; }; then new_raised="raised in review round 0"; else new_raised="raised in unknown round"; fi
  while IFS= read -r row; do history_add_row current "$new_raised" "$row"; done <"$findings"
  if [ -n "$round_list_file" ] && [ -r "$round_list_file" ]; then
    while IFS= read -r round_no; do
      case "$round_no" in ''|*[!0-9]*) continue;; esac
      if [ "$round_no" -lt "$knum" ]; then earlier=$((earlier + 1)); fi
      round_path="$(t get "fix_round.$round_no.findings" 2>/dev/null || true)"
      [ -n "$round_path" ] && [ -r "$round_path" ] || continue
      if [ "$round_no" -eq 1 ]; then raised="raised in review round 0"; else raised="raised in fix round $((round_no - 1))"; fi
      while IFS= read -r row; do history_add_row round "$raised" "$row"; done <"$round_path"
    done <"$round_list_file"
  fi
  if [ -n "$verify_output" ] && [ -r "$verify_output" ]; then
    while IFS= read -r row; do
      case "$row" in P1\ *|P2\ *|P3\ *) verify_open+=("$row");; esac
    done <"$verify_output"
  fi
  for i in "${!history_base[@]}"; do
    base="${history_base[$i]}"; status="${history_status[$i]}"; unverified="${history_unverified[$i]}"
    if [ "$action" = verified ] && [ "$status" = open ]; then
      found=0
      for row in "${verify_open[@]+${verify_open[@]}}"; do [ "$row" = "$base" ] && found=1 && break; done
      [ "$found" -eq 1 ] || history_status[$i]="closed in fix round $knum"
    elif [ "$action" = unverified ] && [ "$status" = open ]; then
      case ",$unverified," in *",fix round $knum,"*) ;; *) unverified="${unverified:+$unverified,}fix round $knum";; esac
      history_unverified[$i]="$unverified"
    fi
  done
  if [ "$action" = verified ]; then
    for row in "${verify_open[@]+${verify_open[@]}}"; do
      found=0
      for base in "${history_base[@]+${history_base[@]}}"; do [ "$base" = "$row" ] && found=1 && break; done
      if [ "$found" -eq 0 ]; then
        history_base+=("$row"); history_raised+=("raised in fix round $knum"); history_status+=(open); history_unverified+=("")
      fi
    done
  fi
  for raised in "${history_raised[@]+${history_raised[@]}}"; do
    case "$raised" in "raised in review round "*|"raised in fix round "*)
      label="${raised#raised in }"
      case ";$rounds_seen;" in *";$label;"*) ;; *) rounds_seen="${rounds_seen:+$rounds_seen; }$label";; esac ;;
    esac
  done
  if [ -n "$rounds_seen" ]; then rounds_csv="$rounds_seen"; else rounds_csv=unknown; fi
  if ! findings_write_allowed "$state" "$history_file"; then
    echo "tkt-fix: refusing to overwrite $history_file: history path is not owned by this ticket state" >&2
    exit 2
  fi
  {
    printf '# Findings history for scoped verification\n'
    printf 'Finding rounds held: %s.\n' "$rounds_csv"
    printf 'Earlier fix rounds in this diff: %s.\n' "$earlier"
    printf 'Current fix round: %s.\n\n' "$knum"
    if [ "${#history_base[@]}" -eq 0 ]; then printf 'no open findings\n'; fi
    for i in "${!history_base[@]}"; do
      printf '%s [tkt-history: raised=%s; status=%s; unverified=%s]\n' \
        "${history_base[$i]}" "${history_raised[$i]}" "${history_status[$i]}" "${history_unverified[$i]:-none}"
    done
  } >"$history_file"
  t journal "findings history write $history_file"
  t set findings_history "$history_file"
  t set "fix_round.$knum.history" "$history_file"
}

# A resume checks the plan's Gate line too, and passes --gate-from-plan so the
# resumed job runs the current plan's gate, not the one it was created with.
plan="$(t get plan 2>/dev/null || true)"
if [ -z "$plan" ]; then
  echo "tkt-fix: missing key: plan (the gate comes from the plan Gate section); set it with: tkt-plan $state set <plan file>" >&2
  exit 2
fi
plan_gate_args t
gate_cmd="$("$plangate" ${plan_gate_argv[@]+"${plan_gate_argv[@]}"} "$plan")" || {
  echo "tkt-fix: missing gate: no Gate command in plan $plan (key: plan); set it with: tkt-plan $state set <plan file>" >&2
  exit 2
}
concerns_file=""
no_commits=0
round_start="$(git -C "$worktree" rev-parse HEAD)"
if [ "$recover_unpushed" -eq 1 ]; then
  round_start="$recover_old_head"
elif [ -n "$resume" ]; then
  previous_round=$((knum - 1))
  previous_head="$(t get "fix_round.$previous_round.head" 2>/dev/null || true)"
  if [ -n "$previous_head" ]; then
    round_start="$previous_head"
  elif [ "$knum" -eq 1 ] && [ -n "$reviewed" ]; then
    round_start="$reviewed"
  fi
fi
record_round_start "$round_start"
record_round_findings
if [ "$recover_unpushed" -eq 1 ]; then
  # Re-run the plan gate before publishing a commit left by a closed job.
  env_prefix=""
  if e="$(t get env 2>/dev/null)" && [ -n "$e" ]; then env_prefix="$e "; fi
  cargo_slot_dir="$tmp/cargo"; mkdir -p "$cargo_slot_dir"
  ln -s "$script_dir/cargo-slot" "$cargo_slot_dir/cargo"
  env_prefix="${env_prefix}PATH=$(printf '%q' "$cargo_slot_dir"):\$PATH "
  recovery_script="$(mktemp "$run/$namebase-tkt-gate-XXXXXX")"; mv "$recovery_script" "$recovery_script.sh"
  recovery_script="$recovery_script.sh"
  recovery_log="$(mktemp "$run/$namebase-tkt-gate-XXXXXX")"; mv "$recovery_log" "$recovery_log.log"
  recovery_log="$recovery_log.log"
  write_gate_script "$recovery_script" "$recovery_log" "$env_prefix" "$gate_cmd" "tkt-fix: gate before pushing a closed fix job"
  gate_rc=0; (cd "$worktree" && bash "$recovery_script") >"$tmp/recovery-gate.out" 2>"$tmp/recovery-gate.err" || gate_rc=$?
  if [ "$gate_rc" -ne 0 ]; then
    record_round_head "$recover_new_head"
    commits="$(git -C "$worktree" rev-list --count "origin/main..HEAD" 2>/dev/null || echo 0)"
    merges="$(git -C "$worktree" rev-list --count --merges "origin/main..HEAD" 2>/dev/null || echo 0)"
    gate_digest="commits=$commits merges=$merges"$'\n'"gatelog=$recovery_log"
    gate_digest="$gate_digest"$'\n'"$(gate_failure_blocks "$recovery_log")"
    gate_digest="$gate_digest"$'\n'"$(tail -n 20 "$recovery_log")"
    gerr="$(grep -i -m 5 -E 'error|panick' "$recovery_log" || true)"
    if [ -n "$gerr" ]; then gate_digest="$gate_digest"$'\n'"$gerr"; fi
    printf 'TKT tkt-gate FAIL rc=%s log=%s\n%s\n' "$gate_rc" "$recovery_log" "$gate_digest" >"$tmp/gate.out"
    round=$((round + 1)); t set round "$round"; close_slot "$knum"
    pass tkt-gate "$tmp/gate.out" 1 "$tmp/recovery-gate.err"
  fi
  if ! push_out="$(git -C "$worktree" push origin "$branch" 2>&1)"; then emit "PUSH-FAIL" 1 "$push_out"; fi
  t set head "$recover_new_head"
  t set fixopen 0
  echo "tkt-fix: pushed unpushed fix job head $recover_old_head -> $recover_new_head" >&2
else
  if [ -n "$resume" ]; then args=(--slot "$slot" --resume "$resume" --prompt "$prompt" --gate-from-plan)
  else
    [ -n "$fixmodel" ] || fixmodel="$(t get model.fix 2>/dev/null)" || { echo "tkt-fix: missing key: model.fix (no --fix-model and no state model.fix)" >&2; exit 2; }
    args=(--slot "$slot" --model "$fixmodel" --template "$fbrief" "FINDINGS=@$findings" "GATE=$gate_cmd" --gate-from-plan --expect-commits)
    if ! t get extra >/dev/null 2>&1; then args+=(EXTRA=""); fi
  fi
  t set fixopen "$knum" # this job's commits may land ahead of head
  jrc=0; "$tktjob" "$state" "${args[@]}" >"$tmp/job.out" 2>"$tmp/job.err" || jrc=$?
  if [ "$jrc" -ne 0 ] && [ -n "$resume" ] \
    && grep -Fq -- "unknown job $resume" "$tmp/job.err" \
    && stale_locator_target "$resume"; then
    emit "UNKNOWN tool=tkt-job" 3 \
      "delegate reports that resumed job $resume has no record and its locator target is gone." \
      "Recovery: triage owning slot $slot before deciding whether it may start a fresh job; the slot remains owned by $resume."
  fi
  if [ -s "$tmp/job.err" ]; then cat "$tmp/job.err" >&2; fi
  if [ "$jrc" -ne 0 ]; then
    aborted_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
    [ -z "$aborted_head" ] || record_round_head "$aborted_head"
    if [ "$jrc" -eq 1 ]; then # an abnormal end closes the slot without a round
      close_slot "$knum"
      shead="$(t get head 2>/dev/null || true)"
      whead="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
      if [ -n "$shead" ] && [ "$shead" = "$whead" ]; then t set fixopen 0; fi
    fi
    # CONCERNS continues like a lane's CONCERNS in tkt-build. NO-COMMITS also
    # continues because its gate passed and the scoped verify checks the head.
    # Every other non-zero verdict stops here.
    case "$(head -n 1 "$tmp/job.out")" in
      "TKT tkt-job CONCERNS "*) concerns_file="$(t get "concerns.$slot" 2>/dev/null || true)" ;;
      "TKT tkt-job NO-COMMITS "*)
        no_commits=1
        t journal "tkt-fix round=$((round + 1)) no commits" ;;
      *) pass tkt-job "$tmp/job.out" "$jrc" "$tmp/job.err" ;;
    esac
  fi
fi

git -C "$worktree" fetch origin >/dev/null 2>&1 || { echo "tkt-fix: fetch failed in $worktree" >&2; exit 2; }
new_head="$(git -C "$worktree" rev-parse HEAD)" || { echo "tkt-fix: cannot read worktree HEAD: $worktree" >&2; exit 2; }
record_round_head "$new_head"
t set head "$new_head" # persisted before the wait and push
t set fixopen 0 # head now covers the open job's commits
remote_head="$(git -C "$worktree" rev-parse --verify "origin/$branch" 2>/dev/null || true)"
ci_note=""
if [ "$remote_head" != "$new_head" ] && { [ -z "$remote_head" ] || git -C "$worktree" merge-base --is-ancestor "$remote_head" "$new_head" 2>/dev/null; }; then
  crc=0; "$ghci" wait "$pr" --repo "$repo" >"$tmp/ci.out" 2>&1 || crc=$?
  [ "$crc" = "0" ] || [ "$crc" = "1" ] || emit "CI-WAIT rc=$crc" 1 "$(cat "$tmp/ci.out")"
  [ "$crc" = "0" ] || ci_note="$(grep . "$tmp/ci.out" | head -n 10)"
  if ! push_out="$(git -C "$worktree" push origin "$branch" 2>&1)"; then emit "PUSH-FAIL" 1 "$push_out"; fi
fi

grc=0
"$tktgate" "$state" --checks-only --expect-head "$new_head" >"$tmp/gate.out" 2>"$tmp/gate.err" || grc=$?
if [ -s "$tmp/gate.err" ]; then cat "$tmp/gate.err" >&2; fi
[ "$grc" -eq 1 ] && { round=$((round + 1)); t set round "$round"; close_slot "$knum"; } # a gate-failed round counts
if [ "$grc" -ne 0 ]; then
  if [ "$no_commits" -eq 1 ]; then printf 'no commits\n' >>"$tmp/gate.out"; fi
  pass tkt-gate "$tmp/gate.out" "$grc" "$tmp/gate.err"
fi
round=$((round + 1)); t set round "$round"; close_slot "$knum"

# Digest lines after the verdict: the CI notes, and the concerns file the
# orchestrator reads before it accepts the verdict.
notes=()
if [ -n "$ci_note" ]; then notes+=("$ci_note"); fi
if [ -n "$concerns_file" ]; then notes+=("concerns=$concerns_file"); fi
if [ "$no_commits" -eq 1 ]; then notes+=("no commits"); fi
if [ "$noverify" -eq 1 ]; then
  write_findings_history unverified
  t set unverified "$findings"
  emit "PUSHED unverified" 0 "head=$new_head" "round=$round" ${notes[@]+"${notes[@]}"}
fi
[ -n "$verifymodel" ] || verifymodel="$(t get model.verify 2>/dev/null)" || { echo "tkt-fix: missing key: model.verify (no --verify-model and no state model.verify)" >&2; exit 2; }
verify_round_coverage "$tmp/verify-rounds" "$tmp/unaccounted"
write_findings_history prepare "" "$tmp/verify-rounds"
vargs=(run "$pr" --repo "$repo" --cwd "$worktree" --head "$new_head" --model "$verifymodel" --verify "$history_file" --since "$verify_since")
if [ -n "$concerns_file" ]; then vargs+=(--context "$concerns_file"); fi
vrc=0; "$reviewpr" "${vargs[@]}" >"$tmp/verify.out" 2>"$tmp/verify.err" || vrc=$?
if [ -s "$tmp/verify.err" ]; then cat "$tmp/verify.err" >&2; fi
[ "$vrc" -eq 0 ] || emit "VERIFY-FAIL rc=$vrc" 1 "$(cat "$tmp/verify.out")" ${notes[@]+"${notes[@]}"}
fixline="$(grep -m 1 '^FIX-' "$tmp/verify.out" || true)"
case "$fixline" in
  FIX-OK*) t set reviewed "$new_head"; write_findings_history verified "$tmp/verify.out" "$tmp/verify-rounds"; write_findings "$tmp/verify.out"
    emit "FIX-OK reviewed=$new_head" 0 "head=$new_head" "round=$round" ${notes[@]+"${notes[@]}"} ;;
  FIX-INCOMPLETE*) write_findings_history verified "$tmp/verify.out" "$tmp/verify-rounds"; write_findings "$tmp/verify.out"; open="$(grep '^P[123] ' "$tmp/verify.out" | head -n 30 || true)"
    if [ "$round" -ge 2 ]; then emit "FIX-INCOMPLETE round=$round STOP-AT-TWO" 1 "$open" ${notes[@]+"${notes[@]}"}; fi
    emit "FIX-INCOMPLETE round=$round" 1 "$open" ${notes[@]+"${notes[@]}"} ;;
  *) emit "VERIFY-FAIL" 1 "$(head -n 40 "$tmp/verify.out")" ;;
esac
