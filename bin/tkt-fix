#!/usr/bin/env bash
# tkt-fix: one review-loop fix round; slot fix<max(round,fixslot)+1> keeps
# rounds apart: tkt-job re-prints a terminal slot's digest.
# A lane blocked before its PR resumes with tkt-job --resume <job.lane>; the resumed lane must finish its brief's push step (which opens the PR) before tkt-build --from gate. When no lane ran, use tkt-build --from lane.
# Usage: tkt-fix <state> (--verify [--since <sha>] | --no-verify) [--collect-fix <job id>] [--findings <file>]
#   [--ruling <comment id>]... [--prompt <file>] [--resume <job id> --prompt <file>]
#   [--fix-model <id>] [--verify-model <id>] [--collect-verify <job id>]
#   --prompt appends orchestrator context to a fresh fix job; --resume requires --prompt except for adoption below.
#   --collect-fix watches the stored job in the open fix slot and records its round.
#   --collect-fix and --verify --resume can adopt a BLOCKED passed-gate complete tree after its hand commit is pushed.
#   An abnormal end (ASK, BLOCKED, ERROR, STALLED, CANCELLED) closes the slot without a round.
#   --resume is how such a job continues.
#   --collect-verify recollects the verify recorded for the latest tkt-fix round without adding a round.
#   --fix-model overrides the stored model on --resume (same backend only; else start a fresh fix job); omit it to keep the stored model.
set -euo pipefail

usage() {
  echo "usage: tkt-fix <state> (--verify [--since <sha>] | --no-verify | --collect-verify <job id> | --verify [--since <sha>] --collect-fix <job id> | --no-verify --collect-fix <job id>) [--findings <file>] [--ruling <comment id>]... [--prompt <file>] [--resume <job id> --prompt <file>] [--fix-model <id>] [--verify-model <id>]" >&2
  echo "  --collect-fix <job id> recollects the stored job in the open fix slot and continues the normal round; it does not dispatch another job." >&2
  echo "  A BLOCKED passed-gate complete tree can be adopted after its hand commit is pushed; --verify --resume does not resume it." >&2
  echo "  An abnormal end (ASK, BLOCKED, ERROR, STALLED, CANCELLED) closes the slot without a round." >&2
  echo "  --resume continues an abnormal job except when adopting a BLOCKED complete tree." >&2
  echo "  --collect-verify <job id> recollects only the verify recorded for the latest tkt-fix round; it does not add a round." >&2
  echo "  --fix-model <id> overrides the stored model on --resume (same backend only; else start a fresh fix job); omit it to keep the stored model." >&2
  exit 2
}

[ $# -ge 2 ] || usage
state="$1"; shift
verify=0; noverify=0; findings=""; since=""; resume=""; prompt=""; fixmodel=""; verifymodel=""; collect_verify_job=""; collect_fix_job=""
ruling_requested=()
while [ $# -gt 0 ]; do
  case "$1" in
    --verify) verify=1; shift ;;
    --no-verify) noverify=1; shift ;;
    --findings) [ $# -ge 2 ] && [ -n "$2" ] || usage; findings="$2"; shift 2 ;;
    --ruling) [ $# -ge 2 ] && [ -n "$2" ] || usage; ruling_requested+=("$2"); shift 2 ;;
    --since) [ $# -ge 2 ] && [ -n "$2" ] || usage; since="$2"; shift 2 ;;
    --resume) [ $# -ge 2 ] && [ -n "$2" ] || usage; resume="$2"; shift 2 ;;
    --prompt) [ $# -ge 2 ] && [ -n "$2" ] || usage; prompt="$2"; shift 2 ;;
    --fix-model) [ $# -ge 2 ] && [ -n "$2" ] || usage; fixmodel="$2"; shift 2 ;;
    --verify-model) [ $# -ge 2 ] && [ -n "$2" ] || usage; verifymodel="$2"; shift 2 ;;
    --collect-verify) [ $# -ge 2 ] && [ -n "$2" ] && [ -z "$collect_verify_job" ] || usage; collect_verify_job="$2"; shift 2 ;;
    --collect-fix) [ $# -ge 2 ] && [ -n "$2" ] && [ -z "$collect_fix_job" ] || usage; collect_fix_job="$2"; shift 2 ;;
    *) usage ;;
  esac
done
if [ -n "$collect_verify_job" ]; then
  [ -z "$collect_fix_job" ] && [ "$verify" -eq 0 ] && [ "$noverify" -eq 0 ] && [ -z "$findings" ] \
    && [ "${#ruling_requested[@]}" -eq 0 ] && [ -z "$since" ] \
    && [ -z "$resume" ] && [ -z "$prompt" ] && [ -z "$fixmodel" ] \
    && [ -z "$verifymodel" ] || usage
elif [ -n "$collect_fix_job" ]; then
  [ -z "$resume" ] && [ -z "$prompt" ] && [ -z "$fixmodel" ] && [ -z "$findings" ] || usage
  [ "$verify" -ne "$noverify" ] || usage
  [ -z "$since" ] || [ "$verify" -eq 1 ] || usage
else
  [ "$verify" -ne "$noverify" ] || usage
  [ -z "$since" ] || [ "$verify" -eq 1 ] || usage
  [ -z "$resume" ] || [ -n "$prompt" ] || [ "$verify" -eq 1 ] || usage
fi

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
# shellcheck disable=SC1090
. "$script_dir/lib/job-refusal.sh"
tkt_refuse_inside_delegate tkt-fix
verify_section_lib="$script_dir/lib/verify-section.sh"
if [ ! -r "$verify_section_lib" ]; then echo "tkt-fix: cannot read shared lib: $verify_section_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$verify_section_lib"
review_verdict_lib="$script_dir/lib/review-verdict.sh"
if [ ! -r "$review_verdict_lib" ]; then echo "tkt-fix: cannot read shared lib: $review_verdict_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$review_verdict_lib"
job_walk_lib="$script_dir/lib/job-walk.sh"
if [ ! -r "$job_walk_lib" ]; then echo "tkt-fix: cannot read shared lib: $job_walk_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$job_walk_lib"
gate_credit_lib="$script_dir/lib/gate-credit.sh"
if [ ! -r "$gate_credit_lib" ]; then echo "tkt-fix: cannot read shared lib: $gate_credit_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$gate_credit_lib"
tkt_state="$script_dir/tkt-state"; bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then echo "tkt-fix: cannot read shared lib: $namebase_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$namebase_lib"
ruling_comment_lib="$script_dir/lib/ruling-comment.sh"
if [ ! -r "$ruling_comment_lib" ]; then echo "tkt-fix: cannot read shared lib: $ruling_comment_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$ruling_comment_lib"
history_lib="$script_dir/lib/findings-history.sh"
# shellcheck disable=SC1090
. "$history_lib"
ruling_refutes_lib="$script_dir/lib/ruling-refutes.sh"
if [ ! -r "$ruling_refutes_lib" ]; then echo "tkt-fix: cannot read shared lib: $ruling_refutes_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$ruling_refutes_lib"
plan_gate_lib="$script_dir/lib/plan-gate-args.sh"
if [ ! -r "$plan_gate_lib" ]; then echo "tkt-fix: cannot read shared lib: $plan_gate_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$plan_gate_lib"
claim_lib="$script_dir/lib/tkt-claims.sh"
if [ ! -r "$claim_lib" ]; then echo "tkt-fix: cannot read shared lib: $claim_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$claim_lib"
takeover_lib="$script_dir/lib/takeover-plan-gate.sh"
if [ ! -r "$takeover_lib" ]; then echo "tkt-fix: cannot read shared lib: $takeover_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$takeover_lib"
gate_lib="$script_dir/lib/gate-script.sh"
if [ ! -r "$gate_lib" ]; then echo "tkt-fix: cannot read shared lib: $gate_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$gate_lib"
pr_body_lib="$script_dir/lib/pr-body.sh"
if [ ! -r "$pr_body_lib" ]; then
  echo "tkt-fix: cannot read shared lib: $pr_body_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$pr_body_lib"
tktjob="$bin_dir/tkt-job"; tktgate="$bin_dir/tkt-gate"; ghci="$bin_dir/gh-ci"; reviewpr="$bin_dir/review-pr"
plangate="$bin_dir/plan-gate"
fbrief="$HOME/.agents/skills/review-loop/briefs/fix.md"
t() { "$tkt_state" "$state" "$@"; }

# close_slot K: record slot fix<K> closed; the highest closed slot never drops.
close_slot() {
  cur="$(t get fixslot 2>/dev/null || printf '0')"; case "$cur" in ''|*[!0-9]*) cur=0;; esac
  if [ "$1" -gt "$cur" ]; then t set fixslot "$1"; fi
}

# chain_owned K PRHEAD ACTUAL: prove that fix<K>..fix1 records account for
# every head transition back to the PR head. Superseded records resolve each
# slot's current id; resumedFrom links preserve earlier attempts in that slot.
# Successful headBefore values are exposed to the open-slot stored-head check.
chain_owned() {
  local k="$1" prhead="$2" actual="$3" want="$3"
  local job walk walk_id walk_record newest_id id record before after resumed
  local seen='|' count=0
  chain_bounds=()
  while [ "$k" -ge 1 ]; do
    job="$(t get "job.fix$k" 2>/dev/null || true)"
    [ -n "$job" ] || return 1
    walk="$(job_walk_superseded "$job")" || return 1
    [ -n "$walk" ] || return 1
    newest_id=""
    while IFS=$'\t' read -r walk_id walk_record; do
      [ -n "$walk_id" ] && [ -f "$walk_record" ] || return 1
      newest_id="$walk_id"
    done <<<"$walk"
    [ -n "$newest_id" ] || return 1
    id="$newest_id"
    while [ -n "$id" ]; do
      case "$seen" in *"|$id|"*) return 1 ;; esac
      seen="$seen$id|"
      count=$((count + 1))
      [ "$count" -le 64 ] || return 1
      record="$(bash "$script_dir/job-record" "$id" 2>/dev/null || true)"
      [ -n "$record" ] && [ -f "$record" ] || return 1
      before="$(jq -r '.result.changeSet.headBefore // ""' "$record" 2>/dev/null || true)"
      after="$(jq -r '.result.changeSet.headAfter // ""' "$record" 2>/dev/null || true)"
      [ -n "$before" ] && [ -n "$after" ] || return 1
      [ "$after" = "$want" ] || return 1
      git -C "$worktree" merge-base --is-ancestor "$before" "$after" 2>/dev/null || return 1
      chain_bounds+=("$before")
      if [ "$before" = "$prhead" ]; then return 0; fi
      want="$before"
      # A resumedFrom id no slot walk reached belongs to a fresh slot. Following
      # a link across slots can trip the seen or head check and fail closed on
      # purpose; that refusal is safe, but can be false.
      resumed="$(jq -r '.resumedFrom // empty' "$record" 2>/dev/null || true)"
      case "$resumed" in
        '') id="" ;;
        */*|.|..) return 1 ;;
        *) id="$resumed" ;;
      esac
    done
    k=$((k - 1))
  done
  return 1
}

# slot_owner ID: print the slot whose stored job id the walk from ID reaches
# (itself, then supersededBy links); print nothing when none is reached.
slot_owner() {
  walk="$1"; seen=" $walk "; first=1
  while [ -n "$walk" ]; do
    k=1
    while [ "$k" -le "$n" ]; do
      if cand="$(t get "job.fix$k" 2>/dev/null || true)" && [ -n "$cand" ] && [ "$cand" = "$walk" ]; then printf 'fix%s\n' "$k"; return 0; fi
      k=$((k + 1))
    done
    rec="$(bash "$script_dir/job-record" "$walk" 2>/dev/null || true)"
    if [ -z "$rec" ]; then
      if [ "$first" -eq 1 ]; then
        k=1; have=0
        while [ "$k" -le "$n" ]; do
          if cand="$(t get "job.fix$k" 2>/dev/null || true)" && [ -n "$cand" ]; then have=1; break; fi
          k=$((k + 1))
        done
        [ "$have" -eq 0 ] || return 2
      fi
      return 0
    fi
    first=0
    walk="$(jq -r '.supersededBy // empty' "$rec" 2>/dev/null || true)"
    [ -n "$walk" ] || return 0
    case "$seen" in *" $walk "*) return 0;; esac
    seen="$seen$walk "
  done
  return 0
}

# blocked_tree_adoptable ID: prove a BLOCKED complete-tree job owns a closed
# slot and that its exact pushed diff is the tree recorded by the job.
blocked_tree_adoptable() {
  local id="$1" owner owner_num open_slot walked walk_id walk_record latest_record
  local head_before files expected_paths actual_paths worktree_status state_head pr prhead actual
  adopt_slot=""; adopt_before=""; adopt_head=""
  owner="$(slot_owner "$id" 2>/dev/null || true)"
  case "$owner" in fix[1-9]|fix[1-9][0-9]*) owner_num="${owner#fix}" ;; *) return 1 ;; esac
  [ "$owner_num" -le "$fixslot" ] || return 1
  open_slot="$(t get fixopen 2>/dev/null || printf '0')"
  case "$open_slot" in ''|*[!0-9]*) open_slot=0 ;; *) open_slot=$((10#$open_slot)) ;; esac
  [ "$open_slot" -eq 0 ] || [ "$open_slot" -ne "$owner_num" ] || return 1

  pr="$(t get pr 2>/dev/null || true)"
  state_head="$(t get head 2>/dev/null || true)"
  [ -n "$pr" ] && [ -n "$state_head" ] || return 1
  prhead="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid 2>/dev/null)" || return 1
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || return 1

  walked="$(job_walk_superseded "$id" 2>/dev/null)" || return 1
  latest_record=""
  while IFS=$'\t' read -r walk_id walk_record; do
    [ -n "$walk_id" ] || continue
    latest_record="$walk_record"
  done <<<"$walked"
  [ -n "$latest_record" ] && [ -r "$latest_record" ] || return 1
  jq -e '
    (.result.status // .status) == "BLOCKED" and
    .result.gateResult.passed == true and
    (.result.changeSet.newCommits | (type == "array" and length == 0)) and
    (.result.changeSet.filesChanged | (type == "array" and length > 0)) and
    (.result.changeSet.headBefore | (type == "string" and length > 0))
  ' "$latest_record" >/dev/null 2>&1 || return 1
  head_before="$(jq -r '.result.changeSet.headBefore' "$latest_record" 2>/dev/null || true)"
  [ -n "$head_before" ] && [ "$state_head" = "$head_before" ] || return 1
  [ -n "$prhead" ] && [ "$prhead" = "$actual" ] || return 1
  worktree_status="$(git -C "$worktree" status --porcelain --untracked-files=all 2>/dev/null)" || return 1
  [ -z "$worktree_status" ] || return 1
  [ "$head_before" != "$actual" ] || return 1
  git -C "$worktree" merge-base --is-ancestor "$head_before" "$actual" 2>/dev/null || return 1

  files="$(jq -er '
    .result.changeSet.filesChanged
    | map(if type == "string" and length > 0 then .
          elif type == "object" and (.path | type) == "string" and (.path | length) > 0 then .path
          else error("invalid filesChanged path") end)
    | .[]
  ' "$latest_record" 2>/dev/null | LC_ALL=C sort -u)" || return 1
  expected_paths="$files"
  actual_paths="$(git -C "$worktree" diff --name-only "$head_before" "$actual" 2>/dev/null | LC_ALL=C sort -u)" || return 1
  [ "$expected_paths" = "$actual_paths" ] || return 1

  adopt_slot="$owner"; adopt_before="$head_before"; adopt_head="$actual"
  return 0
}

# stale_locator_target ID: success only when a well-formed per-user locator
# names a record file that no longer exists. Used to distinguish a lost resume
# record from other delegate failures without changing the owning-slot guard.
stale_locator_target() {
  local id="$1" cache_root locator target
  case "$id" in ""|*/*) return 1 ;; esac
  cache_root="${XDG_CACHE_HOME:-}"
  case "$cache_root" in
    /*) ;;
    *)
      case "${HOME:-}" in
        /*) cache_root="$HOME/.cache" ;;
        *) return 1 ;;
      esac
      ;;
  esac
  locator="$cache_root/delegate/locators/$id"
  [ -f "$locator" ] || return 1
  target=""
  IFS= read -r target <"$locator" || [ -n "$target" ] || return 1
  case "$target" in /*) ;; *) return 1 ;; esac
  local extra=""
  if IFS= read -r extra < <(tail -n +2 "$locator") || [ -n "$extra" ]; then
    return 1
  fi
  [ ! -f "$target" ]
}

lockdir="$state.lock"
require_state_file tkt-fix "$state"
take_state_lock tkt-fix "$lockdir"
rmdir "$lockdir"

t require repo issue branch worktree run
repo="$(t get repo)"; issue="$(t get issue)"; set_namebase "$repo" "$issue"; branch="$(t get branch)"
worktree="$(t get worktree)"; run="$(t get run)"
reviewed="$(t get reviewed 2>/dev/null || true)"
verify_since="$reviewed"
if [ -n "$since" ]; then
  since_full="$(git -C "$worktree" rev-parse --verify "${since}^{commit}" 2>/dev/null)" || {
    echo "tkt-fix: --since does not resolve to a commit in worktree: $since" >&2
    exit 2
  }
  if [ -n "$reviewed" ]; then
    reviewed_commit="$(git -C "$worktree" rev-parse --verify "${reviewed}^{commit}" 2>/dev/null || true)"
    [ -n "$reviewed_commit" ] || reviewed_commit="$reviewed"
    if [ "$reviewed_commit" != "$since_full" ]; then
      echo "tkt-fix: --since $since_full conflicts with reviewed $reviewed_commit" >&2
      exit 2
    fi
  fi
  verify_since="$since_full"
fi
if [ "$verify" -eq 1 ] && [ -z "$verify_since" ]; then
  echo "tkt-fix: missing key: reviewed; pass --since <sha of the head the reviews covered>" >&2
  exit 2
fi
mkdir -p "$run"
round="$(t get round 2>/dev/null || printf '0')"; case "$round" in ''|*[!0-9]*) round=0;; esac
fixslot="$(t get fixslot 2>/dev/null || printf '0')"; case "$fixslot" in ''|*[!0-9]*) fixslot=0;; esac
part_suffix="$(part_findings_suffix "$(t get part 2>/dev/null || true)")"
if [ "$round" -gt "$fixslot" ]; then n=$((round + 1)); else n=$((fixslot + 1)); fi
slot="fix$n"
adopt_pending=0
adopt_job=""
resume_owner=""
if [ -n "$collect_fix_job" ]; then
  openfix="$(t get fixopen 2>/dev/null || printf '0')"
  case "$openfix" in ''|*[!0-9]*) openfix=0 ;; *) openfix=$((10#$openfix)) ;; esac
  if [ "$openfix" -gt 0 ] && open_job="$(t get "job.fix$openfix" 2>/dev/null || true)" && [ -n "$open_job" ]; then
    slot="fix$openfix"
  fi
fi
if [ -n "$resume" ]; then
  # A resume reuses the slot that owns its id; an id no walk reaches falls
  # back to the fresh slot. An id with no record at all is refused only
  # when some slot already owns a job, so a first resume still dispatches.
  if owned="$(slot_owner "$resume")"; then [ -z "$owned" ] || slot="$owned"; resume_owner="$owned"
  else echo "tkt-fix: unknown job id: $resume" >&2; exit 2
  fi
  if [ "$verify" -eq 1 ] && blocked_tree_adoptable "$resume"; then
    slot="$adopt_slot"
    collect_fix_job="$resume"
    stored_collect_job="$resume"
    adopt_job="$resume"
    adopt_pending=1
    resume=""
  fi
fi
if [ -n "$resume" ] && [ -z "$prompt" ]; then usage; fi
knum="${slot#fix}"
if [ -n "$collect_fix_job" ]; then
  stored_collect_job="$(t get "job.$slot" 2>/dev/null || true)"
  if [ "$collect_fix_job" != "$stored_collect_job" ] && blocked_tree_adoptable "$collect_fix_job"; then
    slot="$adopt_slot"
    knum="${slot#fix}"
    stored_collect_job="$collect_fix_job"
    adopt_job="$collect_fix_job"
    adopt_pending=1
  fi
  if [ "$collect_fix_job" != "$stored_collect_job" ]; then
    echo "tkt-fix: --collect-fix $collect_fix_job is not the job of open slot $slot (job.$slot=$stored_collect_job)" >&2
    closed_owner="$(slot_owner "$collect_fix_job" 2>/dev/null || true)"
    closed_slot_number="${closed_owner#fix}"
    case "$closed_slot_number" in ''|*[!0-9]*) closed_slot_number="" ;; esac
    if [ -n "$closed_slot_number" ] && [ "$closed_slot_number" -le "$fixslot" ]; then
      collect_record="$(bash "$script_dir/job-record" "$collect_fix_job" 2>/dev/null || true)"
      if [ -n "$collect_record" ] && [ -r "$collect_record" ]; then
        collect_status="$(jq -r '.result.status // .status // ""' "$collect_record" 2>/dev/null || true)"
        case "$collect_status" in
          NEEDS_CONTEXT)
            printf 'tkt-fix: job %s belongs to closed slot %s (NEEDS_CONTEXT); resume it with: tkt-fix %s --resume %s --prompt <answer file>\n' \
              "$collect_fix_job" "$closed_owner" "$state" "$collect_fix_job" >&2
            ;;
          ASK|BLOCKED|ERROR|STALLED|CANCELLED)
            printf 'Recovery: triage owning slot %s before deciding whether it may start a fresh job; the slot remains owned by %s.\n' \
              "$closed_owner" "$collect_fix_job" >&2
            ;;
        esac
      fi
    fi
    exit 2
  fi
  # A hand-set job.fix<n> alone does not prove a dispatch passed ROUND-LIMIT.
  # record_round_findings records this key on the dispatch path after ROUND-LIMIT.
  findings="$(t get "fix_round.$knum.findings" 2>/dev/null || true)"
  [ -n "$findings" ] || { echo "tkt-fix: missing recorded round findings: fix_round.$knum.findings" >&2; exit 2; }
  [ -r "$findings" ] || { echo "tkt-fix: cannot read recorded round findings: fix_round.$knum.findings=$findings" >&2; exit 2; }
fi
fix_body_file="$run/$namebase$part_suffix-fix-round-$knum-pr-body.md"
history_file="$(history_path "$knum")"
tmp="$(mktemp "${TMPDIR:-/tmp}/tkt-fix.XXXXXX")"; rm -f "$tmp"; mkdir "$tmp"
trap 'rm -rf "$tmp"' EXIT
limited=0
if [ "$round" -ge 2 ] && [ -z "$collect_verify_job" ] && [ -z "$collect_fix_job" ]; then
  if [ -z "$resume" ]; then
    limited=1
  else
    resume_record="$(bash "$script_dir/job-record" "$resume" 2>/dev/null || true)"
    resume_status=""
    if [ -n "$resume_record" ] && [ -r "$resume_record" ]; then
      resume_status="$(jq -r '.result.status // .status // ""' "$resume_record" 2>/dev/null || true)"
    fi
    # Only a NEEDS_CONTEXT job owned by a slot of this state skips the limit (#2000).
    [ "$resume_status" = NEEDS_CONTEXT ] && [ -n "$resume_owner" ] || limited=1
  fi
fi

ruling_ids=(); ruling_urls=(); ruling_bodies=(); ruling_notes=()
ruling_refute_ids=(); ruling_refute_urls=(); ruling_refute_prefixes=(); ruling_refute_bases=()
ruling_grant_ids=()
grant_comment_count=0; grant_accepted=0; grant_id=""; grant_url=""; grant_round=""
if [ "${#ruling_requested[@]}" -gt 0 ] && [ -z "$findings" ]; then
  findings="$(t get findings 2>/dev/null || true)"
fi

emit() {
  verdict="$1"; ec="$2"; shift 2
  logpath="$run/$namebase-tkt-fix-$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')-$(date +%H%M%S).log"
  { printf 'TKT tkt-fix %s log=%s\n' "$verdict" "$logpath"
    for ruling_note in ${ruling_notes[@]+"${ruling_notes[@]}"}; do printf '%s\n' "$ruling_note"; done
    [ $# -eq 0 ] || printf '%s\n' "$@" | head -n 40
  } >"$logpath"
  cat "$logpath"; t journal "tkt-fix $verdict"; exit "$ec"
}

collect_verify_refuse() {
  emit "VERIFY-FAIL reason=collect-verify" 1 "$@"
}

collect_verify_precheck() {
  local latest_round recorded_job recorded_head recorded_slot slot_number slot_head state_head
  local review_state role rec cwd prhead actual legacy
  local review_head delegate_head
  local has_job_key has_head_key has_slot_key started_at_ms journal_path journal_stamp journal_epoch recorded_at_ms
  case "$collect_verify_job" in ''|-*|*/*|.|..) collect_verify_refuse "unsafe or empty job id: $collect_verify_job";; esac
  latest_round="$round"
  [ "$latest_round" -ge 1 ] || collect_verify_refuse "no completed tkt-fix round has a verify"

  has_job_key=0; has_head_key=0; has_slot_key=0
  t get "fix_round.$latest_round.verify_job" >/dev/null 2>&1 && has_job_key=1
  t get "fix_round.$latest_round.verify_head" >/dev/null 2>&1 && has_head_key=1
  t get "fix_round.$latest_round.verify_slot" >/dev/null 2>&1 && has_slot_key=1
  legacy=0
  if [ "$has_job_key" -eq 0 ] && [ "$has_head_key" -eq 0 ] && [ "$has_slot_key" -eq 0 ]; then
    legacy=1
    slot_number="$fixslot"
    [[ "$slot_number" =~ ^[1-9][0-9]*$ ]] || \
      collect_verify_refuse "latest tkt-fix round $latest_round has no recorded fixslot"
    recorded_slot="fix$slot_number"
    slot_head="$(t get "fix_round.$slot_number.head" 2>/dev/null || true)"
    [ -n "$slot_head" ] || collect_verify_refuse "legacy verify slot $recorded_slot has no recorded produced head"
  else
    recorded_job="$(t get "fix_round.$latest_round.verify_job" 2>/dev/null || true)"
    [ "$recorded_job" = "$collect_verify_job" ] || \
      collect_verify_refuse "job $collect_verify_job is not the verify recorded for latest tkt-fix round $latest_round"
    recorded_head="$(t get "fix_round.$latest_round.verify_head" 2>/dev/null || true)"
    recorded_slot="$(t get "fix_round.$latest_round.verify_slot" 2>/dev/null || true)"
    [[ "$recorded_slot" =~ ^fix[1-9][0-9]*$ ]] || \
      collect_verify_refuse "latest tkt-fix round $latest_round has no recorded verify slot"
    slot_number="${recorded_slot#fix}"
    slot_head="$(t get "fix_round.$slot_number.head" 2>/dev/null || true)"
    [ -n "$recorded_head" ] && [ "$recorded_head" = "$slot_head" ] || \
      collect_verify_refuse "verify head does not match slot $recorded_slot produced head"
  fi

  review_state="${TMPDIR:-/tmp}/review-pr/$collect_verify_job"
  rec=""
  if [ ! -f "$review_state" ] || [ "$legacy" -eq 1 ]; then
    rec="$(bash "$script_dir/job-record" "$collect_verify_job" 2>/dev/null || true)"
  fi
  if [ -f "$review_state" ]; then
    role="$(sed -n 's/^role=//p' "$review_state" | head -1)"
    [ "$role" = verify ] || collect_verify_refuse "job $collect_verify_job is not a verify (role=$role)"
  else
    [ -n "$rec" ] && [ -f "$rec" ] || collect_verify_refuse "job $collect_verify_job has no review-pr state or job record"
    cwd="$(jq -r '.resume.cwd // .cwd // empty' "$rec" 2>/dev/null || true)"
    case "$cwd" in */wt-verify) ;; *) collect_verify_refuse "job $collect_verify_job is not a verify (cwd=$cwd)";; esac
  fi

  if [ "$legacy" -eq 1 ]; then
    [ -n "$rec" ] && [ -f "$rec" ] || \
      collect_verify_refuse "cannot prove when verify $collect_verify_job started: no delegate job record"
    started_at_ms="$(jq -r 'if (.startedAtMs | type) == "number" and .startedAtMs >= 0 then (.startedAtMs | floor | tostring) else empty end' "$rec" 2>/dev/null || true)"
    case "$started_at_ms" in ''|*[!0-9]*) collect_verify_refuse "cannot prove when verify $collect_verify_job started: delegate record has no startedAtMs";; esac

    journal_path="${state%.state}.journal"
    journal_stamp="$(awk -v slot="$recorded_slot" -v head="$slot_head" \
      '$2 == "fix" && $3 == "round" && $4 == "head" && $5 == "write" && $6 == slot && $7 == head { stamp = $1 } END { if (stamp != "") print stamp }' \
      "$journal_path" 2>/dev/null || true)"
    [[ "$journal_stamp" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] || \
      collect_verify_refuse "cannot prove when fix_round.$slot_number.head was recorded: no matching journal entry"
    if ! journal_epoch="$(date -u -j -f '%Y-%m-%dT%H:%M:%SZ' "$journal_stamp" +%s 2>/dev/null)"; then
      journal_epoch="$(date -u -d "$journal_stamp" +%s 2>/dev/null || true)"
    fi
    case "$journal_epoch" in ''|*[!0-9]*) collect_verify_refuse "cannot parse journal time for fix_round.$slot_number.head";; esac
    recorded_at_ms="$(((journal_epoch + 1) * 1000))"
    if ! awk -v started="$started_at_ms" -v recorded="$recorded_at_ms" 'BEGIN { exit !(started >= recorded) }'; then
      collect_verify_refuse "verify $collect_verify_job started before fix slot head was recorded"
    fi

    review_head=""
    if [ -f "$review_state" ]; then review_head="$(sed -n 's/^sha=//p' "$review_state" | head -1)"; fi
    delegate_head="$(jq -r '.result.changeSet.headBefore // empty' "$rec" 2>/dev/null || true)"
    if [ -n "$review_head" ] && [ -n "$delegate_head" ] && [ "$review_head" != "$delegate_head" ]; then
      collect_verify_refuse "review-pr state head does not match delegate job head: review-pr=$review_head delegate=$delegate_head"
    fi
    if [[ "$review_head" =~ ^[0-9a-fA-F]{40}$ ]]; then
      recorded_head="$review_head"
    elif [[ "$delegate_head" =~ ^[0-9a-fA-F]{40}$ ]]; then
      recorded_head="$delegate_head"
    else
      collect_verify_refuse "cannot prove the head the verify ran at from review-pr state or delegate job record"
    fi
    [ "$recorded_head" = "$slot_head" ] || \
      collect_verify_refuse "verify head does not match slot $recorded_slot produced head"
  fi

  state_head="$(t get head 2>/dev/null || true)"
  [ "$state_head" = "$recorded_head" ] || \
    collect_verify_refuse "state head $state_head does not match verify head $recorded_head"
  pr="$(t get pr 2>/dev/null || true)"
  [ -n "$pr" ] || collect_verify_refuse "state has no PR number"
  prhead="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid 2>/dev/null)" || \
    collect_verify_refuse "cannot read PR head for verify $collect_verify_job"
  [ "$prhead" = "$recorded_head" ] || \
    collect_verify_refuse "PR head does not match verify head: PR=$prhead verify=$recorded_head"
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
  [ "$actual" = "$recorded_head" ] || \
    collect_verify_refuse "worktree HEAD does not match verify head: worktree=$actual verify=$recorded_head"

  if [ "$legacy" -eq 1 ]; then
    t set "fix_round.$latest_round.verify_job" "$collect_verify_job"
    t set "fix_round.$latest_round.verify_head" "$recorded_head"
    t set "fix_round.$latest_round.verify_slot" "$recorded_slot"
  fi
}

if [ -n "$collect_verify_job" ]; then collect_verify_precheck; fi

ruling_refuse() {
  local reason="$1" comment="$2" hint="${3:-}"
  if [ -n "$hint" ]; then emit "RULING-REFUSED reason=$reason comment=$comment" 2 "$hint"; fi
  emit "RULING-REFUSED reason=$reason comment=$comment" 2
}

if [ "${#ruling_requested[@]}" -gt 0 ]; then
  ruling_history_source="$(t get findings_history 2>/dev/null || true)"
  ruling_alt_pr="$(t get pr 2>/dev/null || true)"
  for ruling_id in ${ruling_requested[@]+"${ruling_requested[@]}"}; do
    case "$ruling_id" in
      ''|*[!0-9]*) ruling_refuse bad-id "$ruling_id" ;;
    esac
    ruling_json="$tmp/ruling-$ruling_id.json"
    ruling_error="$tmp/ruling-$ruling_id.err"
    if ! fetch_issue_comment "$ruling_id" "$ruling_json" "$ruling_error" "$ruling_alt_pr"; then
      ruling_refuse "$ruling_comment_failure" "$ruling_id"
    fi
    ruling_body="$tmp/ruling-$ruling_id.md"
    jq -r '.body' "$ruling_json" >"$ruling_body" || ruling_refuse fetch "$ruling_id"
    ruling_url="$(jq -r '.html_url // ""' "$ruling_json")"
    ruling_ids+=("$ruling_id"); ruling_urls+=("$ruling_url"); ruling_bodies+=("$ruling_body")
    ruling_refutes_file="$tmp/ruling-$ruling_id.refutes"
    ruling_grants_file="$tmp/ruling-$ruling_id.grants"
    grep '^refutes:' "$ruling_body" >"$ruling_refutes_file" || true
    grep '^grants:' "$ruling_body" >"$ruling_grants_file" || true
    if [ -s "$ruling_refutes_file" ]; then
      if ! jq -e --arg repo "$repo" --arg issue "$issue" '
        (.issue_url | endswith("/repos/" + $repo + "/issues/" + $issue))
      ' "$ruling_json" >/dev/null 2>&1; then
        ruling_refuse issue "$ruling_id"
      fi
      [ "$noverify" -eq 0 ] || ruling_refuse refutes-need-verify "$ruling_id"
    fi
    if [ -s "$ruling_grants_file" ]; then
      if [ -n "$collect_fix_job" ]; then
        emit "RULING-REFUSED reason=bad-grant comment=$ruling_id" 2 \
          "a collect needs no grant because the collected dispatch already passed the round limit"
      fi
      ruling_grant_ids+=("$ruling_id")
      grant_comment_count=$((grant_comment_count + 1))
    elif [ ! -s "$ruling_refutes_file" ]; then
      ruling_refuse no-refutes "$ruling_id"
    fi
  done

  round_grant_limited="$limited"
  for grant_id in ${ruling_grant_ids[@]+"${ruling_grant_ids[@]}"}; do
    grant_json="$tmp/ruling-$grant_id.json"
    if ! check_round_grant "$grant_json" "$grant_id" "$round" t; then
      if [ -n "$ruling_comment_hint" ]; then
        emit "RULING-REFUSED reason=$ruling_comment_failure comment=$grant_id" 2 "$ruling_comment_hint"
      fi
      ruling_refuse "$ruling_comment_failure" "$grant_id"
    fi
    grant_accepted=1
  done

  for ruling_index in "${!ruling_ids[@]}"; do
    if ! ruling_refutes_validate_file \
      "${ruling_ids[$ruling_index]}" \
      "${ruling_urls[$ruling_index]}" \
      "$tmp/ruling-${ruling_ids[$ruling_index]}.refutes" \
      history "$ruling_history_source" current "$findings"; then
      ruling_refuse "$ruling_refutes_failure" "$ruling_refutes_failure_id" \
        "$ruling_refutes_hint"
    fi
  done
  if [ "$grant_accepted" -eq 1 ]; then
    record_round_grant "$grant_id" "$grant_url" "$grant_round" t
    limited=0
    ruling_notes+=("Recorded ruling: $grant_url" "add this line to the PR body")
  fi
  for ruling_index in "${!ruling_refute_ids[@]}"; do
    t journal "ruling ${ruling_refute_urls[$ruling_index]} refutes ${ruling_refute_prefixes[$ruling_index]}"
  done
  for ruling_index in "${!ruling_ids[@]}"; do
    ruling_notes+=("ruling: ${ruling_urls[$ruling_index]}")
  done
fi

round_limit() {
  emit "ROUND-LIMIT round=$round" 1 "only a NEEDS_CONTEXT job may resume without a grant: tkt-fix $state --verify --resume <job id> --prompt <file>; otherwise post an owner ruling with grants: round $((round + 1)) and pass --ruling <comment id>, or send the open findings to triage"
}
# Only a round-2 closed-slot recovery without --resume may pass without a grant.
if [ "$limited" -eq 1 ]; then
  limit_pr="$(t get pr 2>/dev/null || true)"
  limit_head="$(t get head 2>/dev/null || true)"
  if [ "$round" -ne 2 ] || [ -z "$limit_pr" ] || [ -z "$limit_head" ] || [ -n "$resume" ]; then round_limit; fi
fi
# Fill missing PR identity before checking entry drift or dispatching a fix.
# pre_pr_resume_hint names the pre-PR resume on the no-PR refusals below.
pre_pr_resume_hint() {
  lane="$(t get job.lane 2>/dev/null || true)"
  if [ -n "$lane" ]; then
    echo "tkt-fix: a lane blocked before its PR resumes with: tkt-job $state --slot lane --resume $lane --prompt <answer file> --gate-from-plan --expect-commits; then tkt-build $state --from gate" >&2
  else
    echo "tkt-fix: a lane blocked before its PR resumes with: tkt-build $state --from lane" >&2
  fi
}
pr="$(t get pr 2>/dev/null || true)"
stored="$(t get head 2>/dev/null || true)"
if [ -z "$pr" ] || [ -z "$stored" ]; then
  if ! pr_list="$(gh pr list --head "$branch" --repo "$repo" --state open --json number,headRefOid 2>/dev/null)"; then
    echo "tkt-fix: PRECONDITION missing=pr: cannot list PRs for branch $branch" >&2
    exit 2
  fi
  if ! jq -e 'type == "array"' >/dev/null 2>&1 <<<"$pr_list"; then
    echo "tkt-fix: PRECONDITION missing=pr: cannot list PRs for branch $branch" >&2
    exit 2
  fi
  if [ -n "$pr" ]; then
    entry="$(jq -c --arg pr "$pr" '[.[] | select((.number | tostring) == $pr)][0] // empty' <<<"$pr_list" 2>/dev/null || true)"
  else
    entry="$(jq -c '.[0] // empty' <<<"$pr_list" 2>/dev/null || true)"
  fi
  if [ -z "$entry" ]; then
    echo "tkt-fix: PRECONDITION missing=pr: no open PR for branch $branch in $repo" >&2
    pre_pr_resume_hint
    exit 2
  fi
  if [ -z "$pr" ]; then
    pr="$(jq -r 'if .number == null then "" else (.number | tostring) end' <<<"$entry" 2>/dev/null || true)"
    if [ -z "$pr" ]; then
      echo "tkt-fix: PRECONDITION missing=pr: no open PR for branch $branch in $repo" >&2
      pre_pr_resume_hint
      exit 2
    fi
  fi
  if [ -z "$stored" ]; then
    stored="$(jq -r 'if .headRefOid == null then "" else (.headRefOid | tostring) end' <<<"$entry" 2>/dev/null || true)"
    if [ -z "$stored" ]; then
      echo "tkt-fix: PRECONDITION missing=head: open PR for branch $branch has no headRefOid" >&2
      exit 2
    fi
  fi
  [ -n "$(t get pr 2>/dev/null || true)" ] || t set pr "$pr"
  [ -n "$(t get head 2>/dev/null || true)" ] || t set head "$stored"
fi
# Entry: state head, PR head and worktree HEAD must agree exactly.
if stored="$(t get head 2>/dev/null || true)" && [ -n "$stored" ]; then
  prhead="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid)" || { echo "tkt-fix: cannot read PR head" >&2; exit 2; }
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || { echo "tkt-fix: cannot read worktree HEAD: $worktree" >&2; exit 2; }
  if [ "$adopt_pending" -eq 1 ]; then
    if [ "$prhead" = "$adopt_head" ] && [ "$actual" = "$adopt_head" ]; then
      t set head "$adopt_head"
      t journal "tkt-fix ADOPT $slot job=$adopt_job head=$adopt_before..$adopt_head"
      stored="$adopt_head"
    else
      adopt_pending=0
    fi
  fi
  if [ "$stored" = "$prhead" ] && [ "$prhead" = "$actual" ]; then :; else
    # Drift the open fix job's own push caused is accepted: the PR head
    # descends from the state head and the worktree matches the PR head,
    # so the state head moves forward to the PR head.
    openk="$(t get fixopen 2>/dev/null || printf '0')"; case "$openk" in ''|*[!0-9]*) openk=0;; esac
    keep=0
    recover_unpushed=0
    wt_status="$(git -C "$worktree" status --porcelain 2>/dev/null || printf '?')"
    clean=0; [ -z "$wt_status" ] && clean=1
    if [ "$limited" -eq 1 ] && [ "$openk" -gt 0 ]; then round_limit; fi
    if [ "$openk" -gt 0 ]; then
      if fjob="$(t get "job.fix$openk" 2>/dev/null || true)" && [ -n "$fjob" ] \
        && git -C "$worktree" merge-base --is-ancestor "$stored" "$prhead" 2>/dev/null \
        && [ "$actual" = "$prhead" ] && [ "$clean" -eq 1 ]; then
        t set head "$prhead"
        t set fixopen 0
        keep=1
      elif [ -n "$fjob" ] && [ "$prhead" != "$actual" ] \
        && [ "$clean" -eq 1 ] \
        && git -C "$worktree" merge-base --is-ancestor "$prhead" "$actual" 2>/dev/null; then
        # Ownership: every unpushed transition must be accounted for by the
        # open slot and its earlier fix slots, back to the PR head. A stored
        # intermediate head is safe only when it is a boundary in that chain.
        if chain_owned "$openk" "$prhead" "$actual" \
          && { [ "$stored" = "$prhead" ] || [ "$stored" = "$actual" ] \
            || [[ " ${chain_bounds[*]} " == *" $stored "* ]]; }; then
          # Carry the validated recovery through tkt-job's head-drift guard
          # the same way a normal job end does. fixopen stays on the open
          # slot: its commits are still unpushed, and the dispatch below
          # re-marks it to the slot that runs next.
          t set head "$actual"
          echo "tkt-fix: worktree is ahead of the PR head by open fix job fix$openk's unpushed commits" >&2
          keep=1
        fi
      fi
    fi
    # Closed slots may be ahead of fixslot when a round skipped a slot.
    # Start at this run's fresh slot and recover the highest recorded fix job.
    newest="$fixslot"
    scan="$n"
    while [ "$scan" -gt "$fixslot" ]; do
      newest_job="$(t get "job.fix$scan" 2>/dev/null || true)"
      if [ -n "$newest_job" ]; then newest="$scan"; break; fi
      scan=$((scan - 1))
    done
    # Closed slots recover unpushed commits on a clean tree whose HEAD
    # descends from the PR head, in either stored-head arm. Every round now
    # requires the same complete fix-slot ownership chain back to the PR head;
    # open slots use that proof above. ROUND-LIMIT still gates recovery pushes.
    if [ "$keep" -eq 0 ] && [ "$openk" -eq 0 ] && [ "$clean" -eq 1 ] && [ "$prhead" != "$actual" ] \
      && { git -C "$worktree" merge-base --is-ancestor "$stored" "$prhead" 2>/dev/null || [ "$stored" = "$actual" ]; } \
      && git -C "$worktree" merge-base --is-ancestor "$prhead" "$actual" 2>/dev/null; then
      closed_owned=0
      if chain_owned "$newest" "$prhead" "$actual"; then closed_owned=1; fi
      if [ "$closed_owned" -eq 1 ]; then
        recovery_slot="$newest"
        [ "$openk" -le 0 ] || recovery_slot="$openk"
        slot="fix$recovery_slot"
        knum="$recovery_slot"
        history_file="$(history_path "$knum")"
        recover_unpushed=1
        recover_old_head="$prhead"
        recover_new_head="$actual"
        keep=1
      fi
    fi
    if [ "$keep" -eq 0 ] && [ "$limited" -eq 1 ]; then round_limit; fi
    if [ "$keep" -eq 0 ]; then
      # A pushed rebase or main merge leaves PR head == worktree HEAD on a
      # clean tree, descended from the state head. If an unpushed main merge
      # leaves the worktree ahead of the PR head, name the hand-push route,
      # but only while the state head agrees with the PR head: a PR head
      # rewound behind the state head is someone else's force-push, and a
      # push route would quietly undo it. Both routes are hints only; the
      # head never moves here.
      route=""
      if [ "$prhead" = "$actual" ] && [ "$clean" -eq 1 ] \
        && git -C "$worktree" merge-base --is-ancestor "$stored" "$actual" 2>/dev/null; then
        route="after a rebase or main merge, run: tkt-state $state set head $actual"
      elif [ "$prhead" != "$actual" ] && [ "$stored" = "$prhead" ] && [ "$clean" -eq 1 ] \
        && git -C "$worktree" merge-base --is-ancestor "$prhead" "$actual" 2>/dev/null; then
        route="after an unpushed main merge, run: git -C $worktree push origin $branch, then: tkt-state $state set head $actual"
      fi
      emit "DRIFT" 3 "state head=$stored" "PR head=$prhead" "worktree HEAD=$actual" ${route:+"$route"}
    fi
  fi
fi
if [ "$limited" -eq 1 ] && [ "${recover_unpushed:-0}" -ne 1 ]; then round_limit; fi
recover_unpushed="${recover_unpushed:-0}"
if [ "$recover_unpushed" -eq 0 ] && [ -z "$resume" ] && [ -z "$collect_fix_job" ] && job="$(t get "job.$slot" 2>/dev/null || true)" && [ -n "$job" ]; then
  recovery_cmd="tkt-fix $(printf '%q' "$state") [--verify|--no-verify] --collect-fix $(printf '%q' "$job")"
  emit "RECOVER" 3 "job=$job" "slot=$slot" "recovery: $recovery_cmd" \
    "choose --verify or --no-verify to match the mode used for this round"
fi
[ -n "$findings" ] || findings="$(t get findings 2>/dev/null)" || { echo "tkt-fix: missing key: findings (no --findings and no state findings)" >&2; exit 2; }
[ -r "$findings" ] || { echo "tkt-fix: cannot read findings: $findings" >&2; exit 2; }
if [ "${#ruling_refute_ids[@]}" -gt 0 ] && [ -z "$resume" ] \
  && [ -z "$collect_verify_job" ] && [ -z "$collect_fix_job" ] \
  && [ "${recover_unpushed:-0}" -ne 1 ] \
  && ruling_refutes_all_open_rows "$findings" "$ruling_history_source"; then
  verify_command="tkt-verify $(printf '%q' "$state") --findings $(printf '%q' "$findings")"
  for ruling_id in ${ruling_ids[@]+"${ruling_ids[@]}"}; do
    verify_command="$verify_command --ruling $(printf '%q' "$ruling_id")"
  done
  ruling_refuse all-refuted "${ruling_ids[0]}" "$verify_command"
fi
# A fresh dispatch needs a finding to fix (#1879); nothing before this point
# writes fix_round.*, job.* or fixslot. Rows match the way tkt-verify and
# the round-findings checks read them: column-0 `P[123] `.
if [ -z "$resume" ] && [ -z "$collect_verify_job" ] && [ -z "$collect_fix_job" ] && [ "$recover_unpushed" -ne 1 ]; then
  finding_rows input "$findings" >/dev/null || emit "FINDINGS-EMPTY file=$findings" 2 \
    "no column-0 P1-P3 finding rows in $findings" \
    "for a verify-only run, use: tkt-verify $state --findings $findings"
fi

pass() {
  tool="$1"; output="$2"; ec="$3"; stderr_file="${4:-}"
  first="$(head -n 1 "$output")"; rest="$(tail -n +2 "$output")"
  case "$first" in "TKT tkt-"*)
    v="${first#TKT }"; v="${v#* }"; v="${v% log=*}"; emit "$v" "$ec" "$rest" ;;
  *)
    details=()
    [ -z "$first" ] || details+=("$first")
    [ -z "$rest" ] || details+=("$rest")
    if [ -n "$stderr_file" ] && [ -s "$stderr_file" ]; then
      details+=("$(cat "$stderr_file")")
    fi
    [ "${#details[@]}" -gt 0 ] || details+=("$tool wrote no output")
    emit "UNKNOWN tool=$tool" 3 "${details[@]}" ;;
  esac
}

write_findings() {
  fr="$run/$namebase$part_suffix-findings-r$round.md"
  if ! findings_write_allowed "$state" "$fr"; then
    echo "tkt-fix: refusing to overwrite $fr: $namebase$part_suffix-findings-r$round.md names are reserved for this ticket's own findings output; write hand-kept notes to $namebase$part_suffix-dispositions-r$round.md instead" >&2
    exit 2
  fi
  local rows
  rows="$(finding_rows verify-output "$1" 2>/dev/null || true)"
  if [ -n "$rows" ]; then
    printf '%s\n' "$rows" >"$fr"
  else
    printf 'no open findings\n' >"$fr"
  fi
  t journal "findings write $fr"
  t set findings "$fr"
}

verify_result_head_guard() {
  local expected_head="$1" expected_slot="$2" slot_number slot_head state_head prhead actual
  slot_number="${expected_slot#fix}"
  slot_head="$(t get "fix_round.$slot_number.head" 2>/dev/null || true)"
  state_head="$(t get head 2>/dev/null || true)"
  prhead="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq .headRefOid 2>/dev/null)" || \
    emit "VERIFY-FAIL reason=head-moved" 1 "cannot read PR head before recording verify result"
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
  if [ "$slot_head" != "$expected_head" ] || [ "$state_head" != "$expected_head" ] \
    || [ "$prhead" != "$expected_head" ] || [ "$actual" != "$expected_head" ]; then
    emit "VERIFY-FAIL reason=head-moved" 1 \
      "verify head=$expected_head slot=$expected_slot produced=$slot_head state=$state_head PR=$prhead worktree=$actual"
  fi
}

handle_verify_result() {
  local verify_output="$1" verify_head="$2" verify_slot="$3" verify_rounds="$4"
  local fixline open
  fixline="$(grep -m 1 '^FIX-' "$verify_output" || true)"
  case "$fixline" in
    FIX-OK*)
      t set reviewed "$verify_head"
      stamp_verdict_at t
      write_findings_history verified "$verify_output" "$verify_rounds"
      write_findings "$verify_output"
      emit "FIX-OK reviewed=$verify_head" 0 "head=$verify_head" "round=$round" ${notes[@]+"${notes[@]}"} ;;
    FIX-INCOMPLETE*)
      if ! review_incomplete_rows "$verify_output"; then
        emit "VERIFY-FAIL reason=no-finding-rows" 1 \
          "FIX-INCOMPLETE verify output contains no bare P0/P1/P2/P3 finding rows; rerun verification with finding rows"
      fi
      open="$REVIEW_INCOMPLETE_ROWS"
      stamp_verdict_at t
      write_findings_history verified "$verify_output" "$verify_rounds"
      write_findings "$verify_output"
      if [ "$REVIEW_INCOMPLETE_HAS_OPEN_P12" = 0 ]; then t set reviewed "$verify_head"; fi
      if [ "$round" -ge 2 ]; then emit "FIX-INCOMPLETE round=$round STOP-AT-TWO" 1 "$open" ${notes[@]+"${notes[@]}"}; fi
      emit "FIX-INCOMPLETE round=$round" 1 "$open" ${notes[@]+"${notes[@]}"} ;;
    *) emit "VERIFY-FAIL" 1 "$(head -n 40 "$verify_output")" ;;
  esac
}

record_round_findings() {
  local key="fix_round.$knum.findings" path state_arg path_arg
  path="$(t get "$key" 2>/dev/null || true)"
  if [ -n "$path" ]; then
    [ -r "$path" ] || { echo "tkt-fix: recorded round findings are missing: $key=$path" >&2; exit 2; }
    return 0
  fi
  path="$run/$namebase$part_suffix-fix-round-$knum-findings.md"
  if [ -e "$path" ]; then
    state_arg="$(printf '%q' "$state")"; path_arg="$(printf '%q' "$path")"
    echo "tkt-fix: refusing to overwrite unrecorded round findings: $path" >&2
    echo "re-record with: tkt-state $state_arg set $key $path_arg" >&2
    exit 2
  fi
  cp "$findings" "$path" || { echo "tkt-fix: cannot record round findings: $path" >&2; exit 2; }
  t journal "fix round findings write $path"
  t set "fix_round.$knum.findings" "$path"
}

record_round_start() {
  local key="fix_round.$knum.start" path="$1" recorded
  recorded="$(t get "$key" 2>/dev/null || true)"
  if [ -n "$recorded" ]; then
    git -C "$worktree" rev-parse --verify "${recorded}^{commit}" >/dev/null 2>&1 || {
      echo "tkt-fix: recorded round start is not a commit: $key=$recorded" >&2
      exit 2
    }
    return 0
  fi
  path="$(git -C "$worktree" rev-parse --verify "${path}^{commit}" 2>/dev/null)" || {
    echo "tkt-fix: cannot record round start: $path" >&2
    exit 2
  }
  t set "$key" "$path"
  t journal "fix round start write fix$knum $path"
}

record_round_head() {
  local path="$1"
  t set "fix_round.$knum.head" "$path"
  t journal "fix round head write fix$knum $path"
}

is_clean_main_merge() {
  local commit="$1" parents merge_commit parent1 parent2 extra automatic_tree commit_tree
  parents="$(git -C "$worktree" rev-list --parents -n 1 "$commit" 2>/dev/null)" || return 1
  read -r merge_commit parent1 parent2 extra <<<"$parents"
  [ -n "$parent1" ] && [ -n "$parent2" ] && [ -z "$extra" ] || return 1
  git -C "$worktree" merge-base --is-ancestor "$parent2" origin/main 2>/dev/null || return 1
  # merge-tree --write-tree (Git 2.38+) fails on conflicts; those merges stay unaccounted.
  automatic_tree="$(git -C "$worktree" merge-tree --write-tree "$parent1" "$parent2" 2>/dev/null)" || return 1
  commit_tree="$(git -C "$worktree" rev-parse --verify "${commit}^{tree}" 2>/dev/null)" || return 1
  [ "$automatic_tree" = "$commit_tree" ]
}

verify_round_coverage() {
  local round_list_file="$1" unaccounted_file="$2" commits commit owner limit n round_start round_head round_findings
  local sha_list missing_rounds repair_command state_arg since_arg path_arg first_round_start first_round_commit concrete_start any_round_start
  local replacement_path replacement_index repair_resume repair_prompt repair_prompt_arg repair_resume_arg repair_resume_args verify_command repair_note_rounds ruling_id
  local -a repair_notes=()
  repair_note_rounds="," # comma-delimited round numbers
  : >"$round_list_file"; : >"$unaccounted_file"
  if ! git -C "$worktree" merge-base --is-ancestor "$verify_since" "$new_head" 2>/dev/null; then
    emit "SINCE-NOT-ANCESTOR since=$verify_since head=$new_head" 1 \
      "branch history was rewritten after the review, so scoped-verify rounds cannot be mapped" \
      "route: no tool re-reviews a rewritten history yet (#1781); stop and ask the steward. Never set reviewed by hand"
  fi
  # First parent only: main's commits are not branch fix work. Clean automatic
  # merges from origin/main need no round ownership; manual merges do.
  commits="$(git -C "$worktree" rev-list --first-parent --reverse "$verify_since..$new_head")" || emit "FINDINGS-SCOPE-ERROR" 1 "cannot enumerate commits in $verify_since..$new_head"
  limit="$fixslot"; [ "$knum" -le "$limit" ] || limit="$knum"
  for commit in $commits; do
    owner=""
    n=1
    while [ "$n" -le "$limit" ]; do
      round_start="$(t get "fix_round.$n.start" 2>/dev/null || true)"
      round_head="$(t get "fix_round.$n.head" 2>/dev/null || true)"
      if [ -n "$round_start" ] && [ -n "$round_head" ] && [ "$commit" != "$round_start" ] \
        && git -C "$worktree" merge-base --is-ancestor "$round_start" "$commit" 2>/dev/null \
        && git -C "$worktree" merge-base --is-ancestor "$commit" "$round_head" 2>/dev/null; then owner="$n"; break; fi
      n=$((n + 1))
    done
    if [ -n "$owner" ]; then
      round_findings="$(t get "fix_round.$owner.findings" 2>/dev/null || true)"
      if [ -z "$round_findings" ]; then
        round_findings="$run/$namebase$part_suffix-fix-round-$owner-findings.md"
        if [ -r "$round_findings" ]; then
          t journal "fix round findings write $round_findings"
          t set "fix_round.$owner.findings" "$round_findings"
        fi
      fi
      if [ -n "$round_findings" ] && [ -r "$round_findings" ] && finding_rows input "$round_findings" >/dev/null; then
        grep -qx "$owner" "$round_list_file" || printf '%s\n' "$owner" >>"$round_list_file"
      else
        printf '%s %s\n' "$commit" "$owner" >>"$unaccounted_file"
        if [ -n "$round_findings" ] && [ -r "$round_findings" ] && ! finding_rows input "$round_findings" >/dev/null; then
          case "$repair_note_rounds" in
            *",$owner,"*) ;;
            *)
              repair_note_rounds="${repair_note_rounds}${owner},"
              repair_notes+=("round $owner findings file has no column-0 P1/P2/P3 lines: $round_findings")
              repair_notes+=("round $owner findings must be written as column-0 P<n> <path>:<line> — ... lines")
              ;;
          esac
        fi
      fi
    elif is_clean_main_merge "$commit"; then
      :
    else
      printf '%s unknown\n' "$commit" >>"$unaccounted_file"
    fi
  done
  if [ -s "$unaccounted_file" ]; then
    sha_list="$(awk '{print $1}' "$unaccounted_file" | paste -sd, -)"
    missing_rounds="$(awk '$2 != "unknown" {print $2}' "$unaccounted_file" | sort -nu | paste -sd, -)"
    state_arg="$(printf '%q' "$state")"; since_arg="$(printf '%q' "$verify_since")"
    repair_resume_args=""
    if [ "$round" -ge 2 ]; then
      repair_resume="$resume"
      repair_prompt=""
      # A fresh-job context prompt does not scope a suggested resume repair.
      if [ -n "$resume" ]; then repair_prompt="$prompt"; fi
      if [ -z "$repair_resume" ]; then
        repair_resume="$(t get "job.$slot" 2>/dev/null || true)"
        [ -n "$repair_resume" ] || repair_resume="$(t get "job.fix$knum" 2>/dev/null || true)"
      fi
      if [ -z "$repair_resume" ]; then
        emit "FINDINGS-SCOPE-ERROR" 1 \
          "unaccounted commits=$sha_list" \
          "cannot print a round-$round repair command: no recorded fix job for slot $slot"
      fi
      if [ -z "$repair_prompt" ]; then
        repair_prompt_arg="<file>"
        repair_notes+=("write a prompt scoping the verify to the round's delta")
      else
        repair_prompt_arg="$(printf '%q' "$repair_prompt")"
      fi
      repair_resume_arg="$(printf '%q' "$repair_resume")"
      repair_resume_args=" --resume $repair_resume_arg --prompt $repair_prompt_arg"
    fi
    verify_command="tkt-fix $state_arg --verify --since $since_arg$repair_resume_args"
    for ruling_id in ${ruling_ids[@]+"${ruling_ids[@]}"}; do
      verify_command="$verify_command --ruling $(printf '%q' "$ruling_id")"
    done
    if [ -n "$missing_rounds" ]; then
      repair_command=""
      for n in $(tr ',' ' ' <<<"$missing_rounds"); do
        round_findings="$(t get "fix_round.$n.findings" 2>/dev/null || true)"
        [ -n "$round_findings" ] || round_findings="$run/$namebase$part_suffix-fix-round-$n-findings.md"
        if [ -r "$round_findings" ] && ! finding_rows input "$round_findings" >/dev/null; then
          replacement_path="$run/$namebase$part_suffix-fix-round-$n-findings-replacement.md"
          replacement_index=2
          while [ -e "$replacement_path" ]; do
            replacement_path="$run/$namebase$part_suffix-fix-round-$n-findings-replacement-$replacement_index.md"
            replacement_index=$((replacement_index + 1))
          done
          path_arg="$(printf '%q' "$replacement_path")"
          repair_notes+=("write a NEW findings file for round $n (originals are append-only; do not edit): $replacement_path")
        else
          path_arg="$(printf '%q' "$round_findings")"
          repair_notes+=("restore the named round findings file(s)")
        fi
        repair_command="${repair_command}${repair_command:+ && }tkt-state $state_arg set fix_round.$n.findings $path_arg"
      done
      repair_command="$repair_command && $verify_command"
    else
      first_round_start="$(t get fix_round.1.start 2>/dev/null || true)"
      concrete_start=0
      if [ -z "$first_round_start" ]; then
        any_round_start=0
        n=1
        while [ "$n" -le "$limit" ]; do
          if [ -n "$(t get "fix_round.$n.start" 2>/dev/null || true)" ]; then
            any_round_start=1
            break
          fi
          n=$((n + 1))
        done
        [ "$any_round_start" -eq 0 ] && concrete_start=1
      else
        first_round_commit="$(git -C "$worktree" rev-parse --verify "${first_round_start}^{commit}" 2>/dev/null || true)"
        if [ -n "$first_round_commit" ]; then
          concrete_start=1
          while IFS= read -r commit; do
            [ -n "$commit" ] || continue
            if ! git -C "$worktree" merge-base --is-ancestor "$commit" "$first_round_commit" 2>/dev/null; then
              concrete_start=0
              break
            fi
          done < <(awk '$2 == "unknown" {print $1}' "$unaccounted_file")
        fi
      fi
      if [ "$concrete_start" -eq 1 ]; then
        repair_command="tkt-state $state_arg set fix_round.1.start $since_arg && $verify_command"
      else
        repair_notes+=("record the owning round with tkt-state $state_arg set fix_round.<n>.start <round start> && tkt-state $state_arg set fix_round.<n>.head <round head> && tkt-state $state_arg set fix_round.<n>.findings <round findings file>")
        repair_command="$verify_command"
      fi
    fi
    emit "FINDINGS-UNACCOUNTED commits=$sha_list" 1 \
      "rounds missing findings=${missing_rounds:-unknown}" \
      ${repair_notes[@]+"${repair_notes[@]}"} \
      "repair command: $repair_command"
  fi
}

if [ -n "$collect_verify_job" ]; then
  notes=()
  slot="$(t get "fix_round.$round.verify_slot")"
  knum="${slot#fix}"
  history_file="$(history_path "$knum")"
  verify_head="$(t get "fix_round.$round.verify_head")"
  new_head="$verify_head"
  verify_job_id="$collect_verify_job"
  verify_round_coverage "$tmp/verify-rounds" "$tmp/unaccounted"
  write_findings_history prepare "" "$tmp/verify-rounds"
  vrc=0; "$reviewpr" collect "$collect_verify_job" >"$tmp/verify.out" 2>"$tmp/verify.err" || vrc=$?
  if [ -s "$tmp/verify.err" ]; then cat "$tmp/verify.err" >&2; fi
  [ "$vrc" -eq 0 ] || emit "VERIFY-FAIL reason=collect-verify" 1 \
    "review-pr collect $collect_verify_job exited $vrc" "$(cat "$tmp/verify.out")"
  verify_result_head_guard "$verify_head" "$slot"
  handle_verify_result "$tmp/verify.out" "$verify_head" "$slot" "$tmp/verify-rounds"
fi

# A fix job, fresh or resumed, uses the optional plan Fix gate when present;
# otherwise the job reads the plan Gate line. A takeover has no plan file, so its recorded state
# gate is passed directly.
plan="$(t get plan 2>/dev/null || true)"
takeover=0
takeover_gate=""
gate_cmd=""
takeover_gate_arg=""
fix_gate_cmd=""
fix_gate_arg=""
fix_gate_rc=3
if [ -z "$plan" ]; then
  echo "tkt-fix: missing key: plan (the gate comes from the plan Gate section); set it with: tkt-plan $state set <plan file>" >&2
  exit 2
elif ! takeover_plan_gate tkt-fix "$plan" t; then
  exit 2
elif [ "$takeover" -eq 1 ]; then
  gate_cmd="$takeover_gate"
  takeover_gate_arg="$gate_cmd"
  if e="$(t get env 2>/dev/null)" && [ -n "$e" ]; then takeover_gate_arg="$e $gate_cmd"; fi
else
  plan_gate_args t
  gate_cmd="$("$plangate" ${plan_gate_argv[@]+"${plan_gate_argv[@]}"} "$plan")" || {
    echo "tkt-fix: missing gate: no Gate command in plan $plan (key: plan); set it with: tkt-plan $state set <plan file>" >&2
    exit 2
  }
  # A missing Fix gate (exit 3) is the normal fallback: keep plan-gate's note off stderr.
  if fix_gate_cmd="$("$plangate" --fix ${plan_gate_argv[@]+"${plan_gate_argv[@]}"} "$plan" 2>"$tmp/fix-gate.err")"; then
    fix_gate_rc=0
  else
    fix_gate_rc=$?
    if [ "$fix_gate_rc" -ne 3 ]; then
      cat "$tmp/fix-gate.err" >&2
      echo "tkt-fix: invalid Fix gate in plan $plan (key: plan); set it with: tkt-plan $state set <plan file>" >&2
      exit 2
    fi
    fix_gate_cmd=""
  fi
fi
brief_gate_cmd="$gate_cmd"
concerns_file=""
no_commits=0
retry_collect_gate=0
gate_retry_credited=0
gate_retry_note=""
round_start="$(git -C "$worktree" rev-parse HEAD)"
if [ "$recover_unpushed" -eq 1 ]; then
  round_start="$recover_old_head"
elif [ -n "$resume" ]; then
  previous_round=$((knum - 1))
  previous_head="$(t get "fix_round.$previous_round.head" 2>/dev/null || true)"
  if [ -n "$previous_head" ]; then
    round_start="$previous_head"
  elif [ "$knum" -eq 1 ] && [ -n "$reviewed" ]; then
    round_start="$reviewed"
  fi
fi
record_round_start "$round_start"
if [ "$fix_gate_rc" -eq 0 ]; then
  round_start="$(t get "fix_round.$knum.start" 2>/dev/null)" || {
    echo "tkt-fix: cannot read recorded round start: fix_round.$knum.start" >&2
    exit 2
  }
  round_start="$(git -C "$worktree" rev-parse --verify "${round_start}^{commit}")" || {
    echo "tkt-fix: cannot resolve recorded round start: $round_start" >&2
    exit 2
  }
  fix_gate_cmd="${fix_gate_cmd//<since>/$round_start}"
  fix_gate_arg="$fix_gate_cmd"
  if e="$(t get env 2>/dev/null)" && [ -n "$e" ]; then fix_gate_arg="$e $fix_gate_cmd"; fi
  brief_gate_cmd="$fix_gate_cmd"
fi
record_round_findings
fix_handoff_instruction="$(printf '%s\n' \
  'Commit only; do not push, do not run `gh-ci wait`, and report `ready, not pushed`. tkt-fix waits on CI and pushes the fix head.' \
  'Do not run `gh pr edit`.' \
  'When this round changes what the PR does:' \
  "Write the full new PR body to: \`$fix_body_file\`" \
  'Report the body file path to tkt-fix.' \
  'Leave the file absent or empty when no body change is needed.')"
if [ "$recover_unpushed" -eq 1 ]; then
  # Recovery replaces this run's dispatch, so a --resume on it never runs.
  if [ -n "$resume" ]; then
    rerun_mode="--no-verify"
    if [ "$verify" -eq 1 ]; then
      rerun_mode="--verify"
      [ -z "$since" ] || rerun_mode="$rerun_mode --since $(printf '%q' "$since")"
    fi
    printf 'tkt-fix: warning: --resume %s was not run: this run pushes the unpushed commits of closed slot %s instead; to deliver it, rerun: tkt-fix %s %s --resume %s --prompt <file>\n' \
      "$resume" "$slot" "$(printf '%q' "$state")" "$rerun_mode" "$(printf '%q' "$resume")" >&2
  fi
  # Re-run the plan gate before publishing a commit left by a closed job.
  env_prefix=""
  if e="$(t get env 2>/dev/null)" && [ -n "$e" ]; then env_prefix="$e "; fi
  cargo_slot_dir="$tmp/cargo"; mkdir -p "$cargo_slot_dir"
  ln -s "$script_dir/cargo-slot" "$cargo_slot_dir/cargo"
  env_prefix="${env_prefix}PATH=$(printf '%q' "$cargo_slot_dir"):\$PATH "
  recovery_script="$(mktemp "$run/$namebase-tkt-gate-XXXXXX")"; mv "$recovery_script" "$recovery_script.sh"
  recovery_script="$recovery_script.sh"
  recovery_log="$(mktemp "$run/$namebase-tkt-gate-XXXXXX")"; mv "$recovery_log" "$recovery_log.log"
  recovery_log="$recovery_log.log"
  write_gate_script "$recovery_script" "$recovery_log" "$env_prefix" "$gate_cmd" "tkt-fix: gate before pushing a closed fix job"
  gate_rc=0; (cd "$worktree" && bash "$recovery_script") >"$tmp/recovery-gate.out" 2>"$tmp/recovery-gate.err" || gate_rc=$?
  if [ "$gate_rc" -ne 0 ]; then
    record_round_head "$recover_new_head"
    commits="$(git -C "$worktree" rev-list --count "origin/main..HEAD" 2>/dev/null || echo 0)"
    merges="$(git -C "$worktree" rev-list --count --merges "origin/main..HEAD" 2>/dev/null || echo 0)"
    gate_digest="commits=$commits merges=$merges"$'\n'"gatelog=$recovery_log"
    gate_digest="$gate_digest"$'\n'"$(gate_failure_blocks "$recovery_log")"
    gate_digest="$gate_digest"$'\n'"$(tail -n 20 "$recovery_log")"
    gerr="$(grep -i -m 5 -E 'error|panick' "$recovery_log" || true)"
    if [ -n "$gerr" ]; then gate_digest="$gate_digest"$'\n'"$gerr"; fi
    printf 'TKT tkt-gate FAIL rc=%s log=%s\n%s\n' "$gate_rc" "$recovery_log" "$gate_digest" >"$tmp/gate.out"
    round=$((round + 1)); t set round "$round"; stamp_verdict_at t; close_slot "$knum"
    pass tkt-gate "$tmp/gate.out" 1 "$tmp/recovery-gate.err"
  fi
  if ! push_out="$(git -C "$worktree" push origin "$branch" 2>&1)"; then emit "PUSH-FAIL" 1 "$push_out"; fi
  tkt_claim_pushed_hunks "$issue" "$worktree" "$repo"
  t set head "$recover_new_head"
  t set fixopen 0
  echo "tkt-fix: pushed unpushed fix job head $recover_old_head -> $recover_new_head" >&2
else
  if [ -n "$collect_fix_job" ]; then
    args=(--slot "$slot" --expect-commits)
  elif [ -n "$resume" ]; then
    resume_prompt="$tmp/resume-prompt.md"
    if [ -n "$prompt" ] && [ ! -r "$prompt" ]; then
      echo "tkt-fix: cannot read prompt: $prompt" >&2
      exit 2
    fi
    if ! {
      if [ -n "$prompt" ]; then
        cat "$prompt" \
          && { [ ! -s "$prompt" ] || [ "$(tail -c 1 "$prompt" | wc -l)" -gt 0 ] || printf '\n'; } \
          || exit 1
      fi
      for ruling_index in "${!ruling_ids[@]}"; do
        printf '\n## Recorded rulings (%s)\n\n' "${ruling_urls[$ruling_index]}" \
          && cat "${ruling_bodies[$ruling_index]}" || exit 1
      done
      printf '\n## tkt-fix dispatch instructions\n\n%s\n' "$fix_handoff_instruction"
    } >"$resume_prompt"; then
      echo "tkt-fix: cannot build combined resume prompt: $resume_prompt" >&2
      exit 2
    fi
    args=(--slot "$slot" --resume "$resume" --prompt "$resume_prompt")
    [ -z "$fixmodel" ] || args+=(--model "$fixmodel")
    if [ "$takeover" -eq 1 ]; then
      args+=(--gate "$takeover_gate_arg")
    elif [ "$fix_gate_rc" -eq 0 ]; then
      args+=(--gate "$fix_gate_arg")
    else
      args+=(--gate-from-plan)
    fi
  else
    [ -n "$fixmodel" ] || fixmodel="$(t get model.fix 2>/dev/null)" || { echo "tkt-fix: missing key: model.fix (no --fix-model and no state model.fix)" >&2; exit 2; }
    dispatch_findings="$findings"
    if [ -n "$prompt" ] || [ "${#ruling_ids[@]}" -gt 0 ]; then
      if [ -n "$prompt" ]; then
        [ -r "$prompt" ] || { echo "tkt-fix: cannot read prompt: $prompt" >&2; exit 2; }
      fi
      dispatch_findings="$(mktemp "$run/$namebase$part_suffix-fix-round-$knum-findings-context-XXXXXX")"
      if ! {
        cat "$findings" \
          && { [ ! -s "$findings" ] || [ "$(tail -c 1 "$findings" | wc -l)" -gt 0 ] || printf '\n'; } \
          && {
            if [ -n "$prompt" ]; then
              printf '\n## Context from the orchestrator\n\nContext, not findings: do not fix or report these lines as findings.\n\n' \
                && cat "$prompt" || exit 1
            fi
            for ruling_index in "${!ruling_ids[@]}"; do
              printf '\n## Recorded rulings (%s)\n\n' "${ruling_urls[$ruling_index]}" \
                && cat "${ruling_bodies[$ruling_index]}" || exit 1
            done
          }
      } >"$dispatch_findings"; then
        rm -f "$dispatch_findings"
        echo "tkt-fix: cannot build combined findings and prompt: $dispatch_findings" >&2
        exit 2
      fi
    fi
    args=(--slot "$slot" --model "$fixmodel" --template "$fbrief" "FINDINGS=@$dispatch_findings" "GATE=$brief_gate_cmd")
    if [ "$takeover" -eq 1 ]; then
      args+=(--gate "$takeover_gate_arg")
    elif [ "$fix_gate_rc" -eq 0 ]; then
      args+=(--gate "$fix_gate_arg")
    else
      args+=(--gate-from-plan)
    fi
    args+=(--expect-commits)
    fix_extra_file="$(mktemp "$run/$namebase$part_suffix-fix-round-$knum-extra-XXXXXX")"
    if state_extra="$(t get extra 2>/dev/null)"; then
      case "$state_extra" in
        @*) cat "${state_extra#@}" >"$fix_extra_file" || exit 2;;
        *) printf '%s' "$state_extra" >"$fix_extra_file";;
      esac
    fi
    if [ -s "$fix_extra_file" ]; then
      [ "$(tail -c 1 "$fix_extra_file" | wc -l)" -gt 0 ] || printf '\n' >>"$fix_extra_file"
      printf '\n' >>"$fix_extra_file"
    fi
    printf '%s\n' "$fix_handoff_instruction" >>"$fix_extra_file"
    args+=("EXTRA=@$fix_extra_file")
  fi
  t set fixopen "$knum" # this job's commits may land ahead of head
  if [ "$adopt_pending" -eq 0 ]; then
  jrc=0; TKT_FIX_DISPATCH=1 "$tktjob" "$state" "${args[@]}" >"$tmp/job.out" 2>"$tmp/job.err" || jrc=$?
  gate_retry_note="$(sed -n '/^gateRetry=/p' "$tmp/job.out" | head -n 1)"
  if [[ "$gate_retry_note" == gateRetry=exit=0\ * ]]; then gate_retry_credited=1; fi
  if [ "$jrc" -ne 0 ] && [ -n "$resume" ] \
    && grep -Fq -- "unknown job $resume" "$tmp/job.err" \
    && stale_locator_target "$resume"; then
    emit "UNKNOWN tool=tkt-job" 3 \
      "delegate reports that resumed job $resume has no record and its locator target is gone." \
      "Recovery: triage owning slot $slot before deciding whether it may start a fresh job; the slot remains owned by $resume."
  fi
  if [ -s "$tmp/job.err" ]; then cat "$tmp/job.err" >&2; fi
  if [ "$jrc" -ne 0 ] && [ -n "$resume" ] && [ -n "$fixmodel" ] \
    && grep -Fq -- " uses backend " "$tmp/job.err"; then
    printf 'tkt-fix: start a fresh fix job (drop --resume) with --fix-model %s\n' "$fixmodel" >&2
  fi
  if [ "$jrc" -ne 0 ]; then
    aborted_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
    [ -z "$aborted_head" ] || record_round_head "$aborted_head"
    if [ "$jrc" -eq 1 ]; then # an abnormal end closes the slot without a round
      # ...except a failed gate rerun on a collected fix: that judges the round.
      if [[ "$gate_retry_note" == gateRetry=exit=[1-9]* ]]; then
        round=$((round + 1)); t set round "$round"; stamp_verdict_at t
      fi
      close_slot "$knum"
      shead="$(t get head 2>/dev/null || true)"
      whead="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
      if [ -n "$shead" ] && [ "$shead" = "$whead" ]; then t set fixopen 0; fi
    fi
    # CONCERNS continues like a lane's CONCERNS in tkt-build. NO-COMMITS also
    # continues because its gate passed and the scoped verify checks the head.
    # Every other non-zero verdict stops here.
    case "$(head -n 1 "$tmp/job.out")" in
      "TKT tkt-job CONCERNS "*) concerns_file="$(t get "concerns.$slot" 2>/dev/null || true)" ;;
      "TKT tkt-job NO-COMMITS "*)
        no_commits=1
        t journal "tkt-fix round=$((round + 1)) no commits" ;;
      "TKT tkt-job GATE-RETRY-PENDING "*)
        retry_collect_gate=1
        concerns_file="$(t get "concerns.$slot" 2>/dev/null || true)" ;;
      *) pass tkt-job "$tmp/job.out" "$jrc" "$tmp/job.err" ;;
    esac
  fi
  fi # the accepted BLOCKED job is already terminal and was validated above
fi

git -C "$worktree" fetch origin >/dev/null 2>&1 || { echo "tkt-fix: fetch failed in $worktree" >&2; exit 2; }
new_head="$(git -C "$worktree" rev-parse HEAD)" || { echo "tkt-fix: cannot read worktree HEAD: $worktree" >&2; exit 2; }
record_round_head "$new_head"
t set head "$new_head" # persisted before the wait and push
t set fixopen 0 # head now covers the open job's commits
remote_head="$(git -C "$worktree" rev-parse --verify "origin/$branch" 2>/dev/null || true)"
ci_note=""
if [ "$remote_head" != "$new_head" ] && { [ -z "$remote_head" ] || git -C "$worktree" merge-base --is-ancestor "$remote_head" "$new_head" 2>/dev/null; }; then
  crc=0; "$ghci" wait "$pr" --repo "$repo" >"$tmp/ci.out" 2>&1 || crc=$?
  [ "$crc" = "0" ] || [ "$crc" = "1" ] || emit "CI-WAIT rc=$crc" 1 "$(cat "$tmp/ci.out")"
  [ "$crc" = "0" ] || ci_note="$(grep . "$tmp/ci.out" | head -n 10)"
  if ! push_out="$(git -C "$worktree" push origin "$branch" 2>&1)"; then emit "PUSH-FAIL" 1 "$push_out"; fi
  tkt_claim_pushed_hunks "$issue" "$worktree" "$repo"
fi
tkt_publish_pr_body_file "$fix_body_file" "$pr" "$repo" tkt-fix || true

grc=0
if [ "$retry_collect_gate" -eq 1 ]; then
  "$tktgate" "$state" --expect-head "$new_head" >"$tmp/gate.out" 2>"$tmp/gate.err" || grc=$?
  retry_gate_log="$(sed -n '1s/.* log=//p' "$tmp/gate.out")"
  [ -n "$retry_gate_log" ] || retry_gate_log="$tmp/gate.out"
  gate_retry_note="gateRetry=exit=$grc log=$retry_gate_log"
  printf '%s\n' "$gate_retry_note" >>"$tmp/gate.out"
  if [ "$grc" -eq 0 ]; then gate_retry_credited=1; fi
else
  "$tktgate" "$state" --checks-only --expect-head "$new_head" >"$tmp/gate.out" 2>"$tmp/gate.err" || grc=$?
fi
if [ -s "$tmp/gate.err" ]; then cat "$tmp/gate.err" >&2; fi
if [ "$grc" -eq 1 ]; then
  case "$(head -n 1 "$tmp/gate.out")" in
    "TKT tkt-gate STOP-LIST "*) close_slot "$knum" ;;
    *) round=$((round + 1)); t set round "$round"; stamp_verdict_at t; close_slot "$knum" ;;
  esac
fi
if [ "$grc" -ne 0 ]; then
  if [ "$no_commits" -eq 1 ]; then printf 'no commits\n' >>"$tmp/gate.out"; fi
  pass tkt-gate "$tmp/gate.out" "$grc" "$tmp/gate.err"
fi

# A checks-only PASS proves only the local checks. Credit a job-end full gate
# separately, and only when its record covers this exact pushed PR head.
if [ "$recover_unpushed" -ne 1 ] && [ "$gate_retry_credited" -ne 1 ]; then
  credit_reason=""
  credit_job="$(t get "job.$slot" 2>/dev/null || true)"
  if [ -z "$gate_cmd" ]; then
    credit_reason="expected gate command is empty"
  elif [ -z "$credit_job" ]; then
    credit_reason="job id is missing for slot $slot"
  else
    credit_walk=""
    if ! credit_walk="$(job_walk_superseded "$credit_job" 2>/dev/null)"; then
      credit_reason="job record supersededBy chain is invalid: $credit_job"
    else
      credit_job_id=""
      credit_chain_ids=()
      while IFS=$'\t' read -r walk_id walk_record; do
        [ -n "$walk_id" ] || continue
        credit_job_id="$walk_id"
        credit_chain_ids+=("$walk_id")
      done <<<"$credit_walk"
      credit_job_chain="$(printf '%s\n' "${credit_chain_ids[@]}")"
      if [ -z "$credit_job_id" ]; then
        credit_reason="job record is missing for slot $slot"
      else
        credit_record="$(bash "$script_dir/job-record" "$credit_job_id" 2>/dev/null || true)"
        if [ -z "$credit_record" ] || [ ! -f "$credit_record" ]; then
          credit_reason="job record is not found for id=$credit_job_id"
        else
          credit_local_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
          credit_remote_head="$(git -C "$worktree" rev-parse --verify "origin/$branch" 2>/dev/null || true)"
          if [ "$credit_local_head" != "$new_head" ] || [ "$credit_remote_head" != "$new_head" ]; then
            credit_reason="pushed branch, worktree and fix head do not match: worktree=$credit_local_head origin/$branch=$credit_remote_head fix=$new_head"
          else
            credit_journal="${state%.state}.journal"
            credit_env="$(t get env 2>/dev/null || true)"
            if ! credit_reason="$(gate_credit_check "$credit_record" "$credit_journal" "$credit_job_chain" "$gate_cmd" "$credit_env" "$new_head" 2>&1)"; then
              :
            else
              if credit_hash="$(gate_credit_hash "$credit_env" "$gate_cmd" 2>/dev/null)" && [ -n "$credit_hash" ]; then
                if ! t journal "tkt-fix gate PASS head=$new_head cmd=$credit_hash" >/dev/null 2>&1; then
                  credit_reason="cannot write the gate credit journal line"
                fi
              else
                credit_reason="cannot hash the gate command"
              fi
            fi
          fi
        fi
      fi
    fi
  fi
  if [ -n "$credit_reason" ]; then
    printf 'tkt-fix: gate not credited: %s\n' "$credit_reason" >&2
  fi
fi

# A successful gate counts the round even when verification is disabled.
round=$((round + 1)); t set round "$round"; stamp_verdict_at t; close_slot "$knum"

# Digest lines after the verdict: the CI notes, and the concerns file the
# orchestrator reads before it accepts the verdict.
notes=()
if [ -n "$gate_retry_note" ]; then notes+=("$gate_retry_note"); fi
if [ -n "$ci_note" ]; then notes+=("$ci_note"); fi
if [ -n "$concerns_file" ]; then notes+=("concerns=$concerns_file"); fi
if [ "$no_commits" -eq 1 ]; then notes+=("no commits"); fi
if [ "$noverify" -eq 1 ]; then
  write_findings_history unverified
  t set unverified "$findings"
  emit "PUSHED unverified" 0 "head=$new_head" "round=$round" ${notes[@]+"${notes[@]}"}
fi
[ -n "$verifymodel" ] || verifymodel="$(t get model.verify 2>/dev/null)" || { echo "tkt-fix: missing key: model.verify (no --verify-model and no state model.verify)" >&2; exit 2; }
verify_round_coverage "$tmp/verify-rounds" "$tmp/unaccounted"
write_findings_history prepare "" "$tmp/verify-rounds"
verify_history="$history_file"
if [ "${#ruling_refute_ids[@]}" -gt 0 ]; then
  verify_history="$tmp/verify-history.md"
  if ! ruling_refutes_prepare "$history_file" "$verify_history" "$tmp/verify-history-with-rulings.md"; then
    case "$ruling_refutes_prepare_failure" in
      drift)
        emit "VERIFY-FAIL reason=ruling-drift" 1 \
          "comment=$ruling_refutes_drift_id" \
          "refutes=$ruling_refutes_drift_prefix" ;;
      copy) emit "VERIFY-FAIL reason=ruling-drift" 1 "cannot copy findings history for recorded rulings" ;;
      prepare) emit "VERIFY-FAIL reason=ruling-drift" 1 "cannot prepare findings history for recorded rulings" ;;
    esac
  fi
fi
vargs=(run "$pr" --repo "$repo" --cwd "$worktree" --head "$new_head" --model "$verifymodel" --verify "$verify_history" --since "$verify_since")
verify_ruling="$(t get ruling.verify 2>/dev/null || true)"
if [ -n "$verify_ruling" ]; then vargs+=(--model-ruling "$verify_ruling"); fi
if [ -n "$concerns_file" ]; then vargs+=(--context "$concerns_file"); fi
for ruling_index in "${!ruling_ids[@]}"; do vargs+=(--context "${ruling_bodies[$ruling_index]}"); done
vrc=0; "$reviewpr" "${vargs[@]}" >"$tmp/verify.out" 2>"$tmp/verify.err" || vrc=$?
verify_job_id="$(awk '$1 == "verify" && NF == 2 { print $2; exit }' "$tmp/verify.out")"
case "$verify_job_id" in ''|*/*|.|..) verify_job_id="";; esac
t set "fix_round.$round.verify_head" "$new_head"
t set "fix_round.$round.verify_slot" "$slot"
t journal "tkt-fix verify round=$round slot=$slot head=$new_head${verify_job_id:+ job=$verify_job_id}"
if [ -n "$verify_job_id" ]; then t set "fix_round.$round.verify_job" "$verify_job_id"; fi
if [ -s "$tmp/verify.err" ]; then cat "$tmp/verify.err" >&2; fi
if [ "$vrc" -ne 0 ]; then
  if [ -n "$verify_job_id" ] && grep -q '^BAD-VERDICT verify ' "$tmp/verify.out"; then
    recovery_cmd="tkt-fix $(printf '%q' "$state") --collect-verify $(printf '%q' "$verify_job_id")"
    emit "VERIFY-FAIL rc=$vrc" 1 "$(cat "$tmp/verify.out")" \
      "recovery: $recovery_cmd" ${notes[@]+"${notes[@]}"}
  fi
  emit "VERIFY-FAIL rc=$vrc" 1 "$(cat "$tmp/verify.out")" ${notes[@]+"${notes[@]}"}
fi
handle_verify_result "$tmp/verify.out" "$new_head" "$slot" "$tmp/verify-rounds"
