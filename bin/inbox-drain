#!/usr/bin/env bash
# inbox-drain: print every unread message in an inbox and archive each to read/.
# Usage: inbox-drain <inbox-dir> [--count]
#        Prints `INBOX n=<count>` first, then each message oldest first: a
#        header with the sender and UTC time taken from the filename
#        `inbox-send` writes, then the body bytes exactly as stored. Each
#        printed message is moved to <inbox-dir>/read/. A first line starting
#        `RULING? RULING-<ticket>-<k>` copies the message to open/<id>.md; a
#        later first line starting `RULING-<ticket>-<k>` moves that copy to
#        open/done/. Print `open rulings: <n>` when any remain. With --count,
#        nothing is moved and read/ is not created. The listing is taken once
#        at start, so a file arriving during the drain stays for the next
#        drain. A missing inbox dir prints INBOX n=0. A failed move exits 1
#        with the rest still unread.
set -euo pipefail

usage() {
  echo "usage: inbox-drain <inbox-dir> [--count]" >&2
  exit 2
}

if [ $# -eq 1 ]; then
  count_only=0
elif [ $# -eq 2 ] && [ "$2" = "--count" ]; then
  count_only=1
else
  usage
fi
dir="$1"

# The listing is taken once here at start: files created later are never
# printed and never moved.
list="$(mktemp "${TMPDIR:-/tmp}/inbox-drain.XXXXXX")"
trap 'rm -f "$list"' EXIT
count=0
for f in "$dir"/*.md; do
  [ -e "$f" ] || continue
  [ -f "$f" ] || continue
  # inbox-send names files <sender>-<ts>-<pid>-<rand>.md, and the sender
  # may itself hold - and .; the last three dash fields are the timestamp,
  # pid and rand, everything before them is the sender.
  base="${f##*/}"
  rest="${base%.md}"
  rest="${rest%-*}"
  rest="${rest%-*}"
  ts="${rest##*-}"
  sender="${rest%-*}"
  case "$ts" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z)
      time="$ts"
      ;;
    *)
      # Not the shape inbox-send writes: still an unread message, drained
      # with the whole name as sender and an unknown time.
      time="unknown"
      sender="${base%.md}"
      ts=""
      ;;
  esac
  printf '%s\t%s\t%s\t%s\t%s\n' "$ts" "$base" "$f" "$sender" "$time" >>"$list"
  count=$((count + 1))
done

printf 'INBOX n=%s\n' "$count"

print_open_rulings() {
  open_count=0
  for ruling_file in "$dir"/open/*.md; do
    [ -f "$ruling_file" ] || continue
    open_count=$((open_count + 1))
  done
  if [ "$open_count" -gt 0 ]; then
    printf 'open rulings: %s\n' "$open_count"
  fi
}

if [ "$count_only" -eq 1 ]; then
  print_open_rulings
  exit 0
fi

# Oldest first: the timestamp field, then the filename. The sender charset
# inbox-send allows holds no tabs, so tab-separated fields stay intact.
while IFS=$'\t' read -r _ts _base f sender time; do
  printf 'FROM %s AT %s\n' "$sender" "$time"
  # The body goes through unchanged: cat, never command substitution.
  cat <"$f"
  # A body with no trailing newline still ends on its own line.
  if [ -s "$f" ] && [ -n "$(tail -c 1 <"$f")" ]; then
    printf '\n'
  fi
  first_line=
  IFS= read -r first_line <"$f" || true
  if [[ "$first_line" =~ ^RULING\?\ (RULING-[A-Za-z0-9._-]+-[A-Za-z0-9._-]+)([[:space:]]|$) ]]; then
    ruling_id=${BASH_REMATCH[1]}
    mkdir -p -- "$dir/open"
    cp -- "$f" "$dir/open/$ruling_id.md"
  elif [[ "$first_line" =~ ^(RULING-[A-Za-z0-9._-]+-[A-Za-z0-9._-]+)([[:space:]]|$) ]]; then
    ruling_id=${BASH_REMATCH[1]}
    if [ -f "$dir/open/$ruling_id.md" ]; then
      mkdir -p -- "$dir/open/done"
      mv -- "$dir/open/$ruling_id.md" "$dir/open/done/$ruling_id.md"
    fi
  fi
  # read/ appears on the first move; a failed move exits 1 with the rest
  # of the listing still in the inbox.
  mkdir -p -- "$dir/read"
  mv -- "$f" "$dir/read/" || exit 1
done < <(LC_ALL=C sort -t $'\t' -k1,1 -k2,2 "$list")
print_open_rulings
exit 0
