#!/usr/bin/env bash
# tkt-plan: planning steps 3-5, one Verifier round, post or plan-path set per call.
set -euo pipefail
# A verify after a recorded stale-plan revision is exempt from the round
# limit; the exemption is derived from recorded state below.

usage() {
  printf 'usage: tkt-plan <state> verify [--extra <file>] [--model <id>]\n       tkt-plan <state> confirm --edits <file>\n       tkt-plan <state> grant-round --by <who> --comment <id>\n       tkt-plan <state> post [--part <label>]\n       tkt-plan <state> set <plan file>\n       tkt-plan <state> replan\n' >&2
  exit 2
}

[ $# -ge 2 ] || usage
state="$1" sub="$2"; shift 2

script_dir="$(cd "$(dirname "$0")" && pwd)"; tkt_state="$script_dir/tkt-state"; bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then echo "tkt-plan: cannot read shared lib: $namebase_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$namebase_lib"
tokens_lib="$script_dir/lib/plan-tokens.sh"
if [ ! -r "$tokens_lib" ]; then echo "tkt-plan: cannot read shared lib: $tokens_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$tokens_lib"
tktjob="$bin_dir/tkt-job"; plancheck="$bin_dir/plan-check"; plangate="$bin_dir/plan-gate"
postplan="$bin_dir/post-plan"; plansweep="$bin_dir/plan-sweep"
vbrief="$HOME/.agents/skills/planning/briefs/verifier.md"; cbrief="$HOME/.agents/skills/planning/briefs/confirm.md"
REPORT_LINES=38

t() { "$tkt_state" "$state" "$@"; }

lockdir="$state.lock"
if mkdir "$lockdir" 2>/dev/null; then rmdir "$lockdir"
else pid="$(cat "$lockdir/pid" 2>/dev/null || true)"; echo "tkt-plan: state locked${pid:+ by pid $pid}" >&2; exit 2; fi

t require repo issue run worktree
repo="$(t get repo)"; issue="$(t get issue)"; set_namebase "$repo" "$issue"; run="$(t get run)"; worktree="$(t get worktree)"
mkdir -p "$run"

if stored="$(t get head 2>/dev/null)"; then actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || { echo "tkt-plan: cannot read worktree HEAD: $worktree" >&2; exit 2; }; [ "$stored" = "$actual" ] || { echo "tkt-plan: head drift: state $state head=$stored worktree $worktree HEAD=$actual (after a rebase or main merge, run: tkt-state $state set head $actual)" >&2; exit 3; }; fi

tmp="$(mktemp "${TMPDIR:-/tmp}/tkt-plan.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

emit() {
  verdict="$1"; ec="$2"; shift 2
  logpath="$run/$namebase-tkt-plan-$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')-$(date +%H%M%S).log"
  { printf 'TKT tkt-plan %s log=%s\n' "$verdict" "$logpath"; [ $# -eq 0 ] || printf '%s\n' "$@"; } >"$logpath"
  cat "$logpath"; t journal "tkt-plan $verdict"; exit "$ec"
}

base_of() {
  b="$(plan_base "$1")"; [ -n "$b" ] || { echo "tkt-plan: no Base line in $1" >&2; exit 2; }
  printf '%s\n' "$b"
}

load_plan() {
  t require plan; plan="$(t get plan)"
  [ -r "$plan" ] || { echo "tkt-plan: cannot read plan file: $plan" >&2; exit 2; }
  base="$(base_of "$plan")"
}

ronum() { n="$(t get verifier_round 2>/dev/null || printf '0')"; case "$n" in ''|*[!0-9]*) n=0;; esac; printf '%s\n' "$n"; }

open_lines() {
  local report round
  report="$(t get last_report 2>/dev/null || true)"
  round="$(ronum)"
  if [ -z "$report" ] || [ ! -f "$report" ]; then
    printf 'none (no report: round %s ended without one)\n' "$round"
  elif [ ! -s "$report" ] || [ "$(head -n 1 "$report")" = "PLAN OK" ]; then
    printf 'none\n'
  else
    head -n "$REPORT_LINES" "$report"
  fi
}

grant_pending() {
  local granted_by granted_used
  granted_by="$(t get granted_by 2>/dev/null || true)"
  granted_used="$(t get granted_used 2>/dev/null || true)"
  [ -n "$granted_by" ] && [ -z "$granted_used" ]
}

vmodel() {
  [ -n "${1:-}" ] && { printf '%s\n' "$1"; return; }
  t get model.verifier 2>/dev/null || { echo "tkt-plan: missing key: model.verifier" >&2; exit 2; }
}

ticket_fail() {
  echo "tkt-plan: cannot read ticket text for $repo#$issue" >&2
  if [ -s "$tmp" ]; then head -n 1 "$tmp" >&2; fi
  exit 2
}

# ticket_extra OUT CALLER: writes the ticket (body, then comments) to OUT, then
# CALLER's bytes when set. One leading @ on CALLER is stripped. A blank body or
# a failed read exits 2 before OUT is touched; OUT is built aside and moved in.
ticket_extra() {
  local out="$1" caller="${2#@}" body comments tf
  if [ -n "$caller" ] && [ ! -r "$caller" ]; then echo "tkt-plan: cannot read extra file: $caller" >&2; exit 2; fi
  if ! body="$(gh issue view "$issue" --repo "$repo" 2>"$tmp")" || [ -z "${body//[[:space:]]/}" ]; then ticket_fail; fi
  if ! comments="$(gh issue view "$issue" --repo "$repo" --comments 2>"$tmp")"; then ticket_fail; fi
  tf="$(mktemp "${TMPDIR:-/tmp}/tkt-ticket.XXXXXX")"
  {
    printf '## Ticket %s#%s\n%s\n' "$repo" "$issue" "$body"
    [ -z "$comments" ] || printf '## Ticket comments\n%s\n' "$comments"
    [ -z "$caller" ] || { printf '## Extra\n'; cat "$caller"; }
  } >"$tf" || { rm -f "$tf"; exit 2; }
  mv "$tf" "$out"
}

runjob() {
  slot="$1"; tmpl="$2"; rep="$3"; shift 3
  job_out="$("$tktjob" "$state" --slot "$slot" --template "$tmpl" --out-file "$rep" "$@" 2>&1)" || {
    jrc=$?; line="$(grep -m1 '^TKT tkt-job ' <<<"$job_out" || head -n 1 <<<"$job_out")"
    # DONE_WITH_CONCERNS exits 1 with its report on disk: the report is the product.
    if [ "$jrc" -ne 1 ] || [ ! -f "$rep" ] || [ "${line#"TKT tkt-job CONCERNS "}" = "$line" ]; then
      case "$line" in
        "TKT tkt-job ASK "*)
          # An asking Verifier still spent its round: count it unless the
          # verify is drift-exempt, where the retry stays exempt.
          if [ "${drift:-0}" -eq 0 ] && [ -n "${round:-}" ]; then
            t set verifier_round "$((round + 1))"
          fi
          ;;
      esac
      w="${line#TKT tkt-job }"; emit "${w% log=*}" "$jrc" "$(head -n "$REPORT_LINES" <<<"$job_out")"
    fi
  }
  [ -r "$rep" ] || { echo "tkt-plan: tkt-job wrote no report: $rep" >&2; exit 3; }
  [ "$(head -n 1 "$rep")" = "PLAN OK" ] && { RV="PLAN-OK out=$rep"; REC=0; } || { RV="LINES n=$(wc -l <"$rep" | tr -d ' ') out=$rep"; REC=1; }
}

# task_pathspec KIND VALUE: expand_token's callback for task records. Resolve
# paths at the plan base so unique basename tokens become root-relative paths.
task_pathspec() {
  case "$1" in
    glob) printf '%s\n' "$2"; return 0 ;;
    path) ;;
    *) return 0 ;;
  esac
  resolve_path "$2"
  [ "$RES_KIND" = found ] || return 0
  printf '%s\n' "$RES"
}

# plan_task_pathspecs PLAN: resolved paths from backticked tokens on ## Tasks
# lines. The shared reader skips fences and non-Tasks sections; expand_token
# handles ports, symbols and brace alternatives before resolve_path applies the
# plan's path rules. A task path outside Files is still listed.
plan_task_pathspecs() {
  local tok
  local dir="$worktree" rev="$base" tree CUR_SEC=tasks
  tree="$(git -C "$dir" ls-tree -r --name-only "$rev")"
  while IFS= read -r tok; do
    [ -n "$tok" ] || continue
    expand_token "$tok" task_pathspec
  done < <(plan_records "$1" | awk -F '\t' '$1 == "tasks" { print $5 }')
  return 0
}

do_verify() {
  extra=""; model=""
  while [ $# -gt 0 ]; do case "$1" in
    --extra) [ $# -ge 2 ] || usage; extra="$2"; shift 2;;
    --model) [ $# -ge 2 ] || usage; model="$2"; shift 2;; *) usage;; esac; done
  load_plan
  files=()
  while IFS= read -r p; do files+=("$p"); done < <(plan_files_pathspecs "$plan")
  if [ "${#files[@]}" -gt 0 ]; then
    stat="$(git -C "$worktree" diff --stat "$base...origin/main" -- "${files[@]}" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
    if [ -n "$stat" ]; then n="$(git -C "$worktree" diff --name-only "$base...origin/main" -- "${files[@]}" | wc -l | tr -d ' ')"; emit "STALE n=$n base=$base" 1 "$({ plan_bare_dirs "$plan" "$worktree"; head -n "$REPORT_LINES" <<<"$stat"; })"; fi
  fi
  pc_out="$("$plancheck" "$plan" --base "$base" --cwd "$worktree" 2>"$tmp")" && prc=0 || prc=$?
  [ "$prc" -ne 2 ] || { cat "$tmp" >&2; exit 2; }
  [ "$prc" -ne 1 ] || emit "PLAN-CHECK n=$(grep -c . <<<"$pc_out" || true)" 1 "$(head -n "$REPORT_LINES" <<<"$pc_out")"
  round="$(ronum)"
  # The drift exemption is derived from recorded state, not a caller flag: a
  # verify is exempt only when a previous round recorded a base and main
  # changed a task path between that base and the current one. A Files
  # change no task names is not drift, so the round limit applies.
  drift=0
  vbase="$(t get verified_base 2>/dev/null || true)"
  if [ -n "$vbase" ]; then
    tpaths=()
    while IFS= read -r p; do tpaths+=("$p"); done < <(plan_task_pathspecs "$plan")
    if [ "${#tpaths[@]}" -gt 0 ]; then
      if dstat="$(git -C "$worktree" diff --stat "$vbase...$base" -- "${tpaths[@]}" 2>/dev/null)"; then
        [ -n "$dstat" ] && drift=1 || drift=0
      else
        drift=0
      fi
    fi
  fi
  if [ "$drift" -eq 0 ]; then
    [ -z "$(t get confirmed_for 2>/dev/null || true)" ] || emit "ROUND-LIMIT round=$round confirm=done" 1 "the confirm round is used; send the open lines to triage" "$(open_lines)"
    [ "$round" -lt 2 ] || emit "ROUND-LIMIT round=$round" 1 "two Verifier rounds ran with no confirm; run tkt-plan confirm --edits <file>, or send the open lines to triage" "$(open_lines)"
  fi
  model="$(vmodel "$model")" || exit 2
  args=(PLAN="$plan" BASE="$base" --model "$model")
  if [ "$drift" -eq 1 ]; then
    slot="verifier-r$((round + 1))-drift"
    rep="$run/$namebase-verifier-out-r$((round + 1))-drift.md"
    xfile="$run/$namebase-verifier-extra-r$((round + 1))-drift.md"
  else
    slot="verifier-r$((round + 1))"
    rep="$run/$namebase-verifier-out-r$((round + 1)).md"
    xfile="$run/$namebase-verifier-extra-r$((round + 1)).md"
  fi
  # --extra wins over state extra; the ticket text goes before either.
  [ -n "$extra" ] || extra="$(t get extra 2>/dev/null || true)"
  ticket_extra "$xfile" "$extra"
  args+=(EXTRA="@$xfile")
  # A failed round leaves its job id behind while the round counter stays
  # put; without this reset the next verify would only re-watch the old job.
  t set "job.$slot" ""
  runjob "$slot" "$vbrief" "$rep" "${args[@]}"
  # A verify that reaches a report records its base; a failed or asking job
  # leaves the old base so the retry stays exempt. An exempt run never writes
  # the round counters.
  t set verified_base "$base"
  if [ "$drift" -eq 0 ]; then
    t set verifier_round "$((round + 1))"
  fi
  t set last_report "$rep"
  emit "$RV" "$REC" "$(head -n "$REPORT_LINES" "$rep")"
}

do_confirm() {
  edits=""
  while [ $# -gt 0 ]; do case "$1" in
    --edits) [ $# -ge 2 ] || usage; edits="$2"; shift 2;; *) usage;; esac; done
  [ -n "$edits" ] || usage; [ -r "$edits" ] || { echo "tkt-plan: cannot read edits file: $edits" >&2; exit 2; }
  confirmed_for="$(t get confirmed_for 2>/dev/null || true)"
  granted=0
  if [ -n "$confirmed_for" ]; then
    if grant_pending; then
      granted=1
    else
      emit "ROUND-LIMIT confirm=done" 1 "the confirm round is used; send the open lines to triage" "$(open_lines)"
    fi
  fi
  load_plan
  cmodel="$(vmodel)" || exit 2
  rep="$run/$namebase-confirm-out.md"
  xfile="$run/$namebase-confirm-extra.md"
  # Confirm has no --extra flag: the state extra, if any, follows the ticket text.
  ticket_extra "$xfile" "$(t get extra 2>/dev/null || true)"
  if [ "$granted" -eq 1 ]; then t set job.confirm ""; fi
  runjob confirm "$cbrief" "$rep" PLAN="$plan" BASE="$base" EDITS="@$edits" EXTRA="@$xfile" --model "$cmodel"
  if [ "$granted" -eq 1 ]; then t set granted_used 1; fi
  t set last_report "$rep"
  t set confirmed_for "$(ronum)"
  emit "$RV" "$REC" "$(head -n "$REPORT_LINES" "$rep")"
}

do_grant() {
  who=""; comment=""
  while [ $# -gt 0 ]; do case "$1" in
    --by) [ $# -ge 2 ] || usage; who="$2"; shift 2;;
    --comment) [ $# -ge 2 ] || usage; comment="$2"; shift 2;;
    *) usage;; esac; done
  [ -n "$who" ] && [ -n "$comment" ] || usage
  case "$who$comment" in *[[:space:]]*) usage;; esac
  confirmed_for="$(t get confirmed_for 2>/dev/null || true)"
  [ -n "$confirmed_for" ] || { echo "tkt-plan: no limit reached: the confirm round is still open" >&2; exit 2; }
  if grant_pending; then
    pending_by="$(t get granted_by 2>/dev/null || true)"
    pending_comment="$(t get granted_comment 2>/dev/null || true)"
    echo "tkt-plan: grant already pending: $pending_by:$pending_comment" >&2
    exit 2
  fi
  recorded_by="$(t get granted_by 2>/dev/null || true)"
  if [ -n "$recorded_by" ]; then
    recorded_comment="$(t get granted_comment 2>/dev/null || true)"
    echo "tkt-plan: grant already recorded: $recorded_by:$recorded_comment: a second grant needs the owner: use --owner-approved <comment id>" >&2
    exit 2
  fi
  t set granted_by "$who"
  t set granted_comment "$comment"
  t set granted_used ""
  emit "SET grant=$who:$comment" 0
}

do_post() {
  part=""
  while [ $# -gt 0 ]; do case "$1" in
    --part) [ $# -ge 2 ] || usage; part="$2"; shift 2;; *) usage;; esac; done
  load_plan
  "$plangate" "$plan" >"$tmp" 2>&1 || emit "POST-FAIL reason=gate" 1 "$(head -n 10 "$tmp")"
  pargs=(); [ -z "$part" ] || pargs=(--part "$part")
  urls="$("$postplan" "$issue" "$plan" --repo "$repo" ${pargs[@]+"${pargs[@]}"} 2>"$tmp")" || emit "POST-FAIL reason=post" "$?" "$(head -n 10 "$tmp")"
  emit "POSTED urls=$(tr '\n' ',' <<<"$urls" | sed 's/,$//')" 0 "$urls"
}

do_set() {
  [ $# -eq 1 ] || usage
  case "$1" in /*) plan="$1" ;; *) plan="$PWD/$1" ;; esac
  [ -r "$plan" ] || { echo "tkt-plan: cannot read plan file: $plan" >&2; exit 2; }
  base="$(base_of "$plan")"
  pack_out="$run/$namebase-pack.md"
  sweep_out="$("$plansweep" --cwd "$worktree" --base "$base" --plan "$plan" --out "$pack_out")" || { printf '%s\n' "$sweep_out" >&2; exit 2; }
  pack="$(awk '/^PACK /{print $2; exit}' <<<"$sweep_out")"; [ -n "$pack" ] || { echo "tkt-plan: plan-sweep printed no PACK line" >&2; exit 2; }
  old_plan="$(t get plan 2>/dev/null || true)"
  t set plan "$plan"; t set pack "$pack"
  # Re-setting the same plan keeps the round counts and job slots; a new path starts over.
  if [ "$old_plan" != "$plan" ]; then
    t set verifier_round 0; t set confirmed_for ""; t set verified_base ""
    t set granted_by ""; t set granted_comment ""; t set granted_used ""; t set last_report ""
    for s in verifier-r1 verifier-r2 confirm lane fix1 fix2 fix3; do t set "job.$s" ""; done
  fi
  emit "SET plan=$plan" 0 "plan=$plan" "pack=$pack"
}

do_replan() {
  [ $# -eq 0 ] || usage
  # A re-plan has a plan, so a missing key is a usage error before any write.
  plan_key="$(t get plan 2>/dev/null || true)"
  if [ -z "$plan_key" ]; then echo "tkt-plan: missing key: plan" >&2; exit 2; fi
  # Job slots and findings first, round last: a half-done replan leaves
  # round non-empty and tkt-build refuses loudly instead of reusing a stale slot.
  t set job.lane ""
  t set job.fix1 ""
  t set job.fix2 ""
  t set job.fix3 ""
  t set job.preflight ""
  t set findings ""
  t set round ""
  emit "REPLAN cleared=round,job.lane,job.fix1,job.fix2,job.fix3,job.preflight,findings" 0
}

case "$sub" in
  verify) do_verify "$@";; confirm) do_confirm "$@";; grant-round) do_grant "$@";; post) do_post "$@";; set) do_set "$@";; replan) do_replan "$@";; *) usage;; esac
