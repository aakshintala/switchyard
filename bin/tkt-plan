#!/usr/bin/env bash
# tkt-plan: planning steps 3-5, one Verifier round, post or plan-path set per call.
set -euo pipefail
# A verify after a recorded stale-plan revision is exempt from the round
# limit; the exemption is derived from recorded state below.

usage() {
  printf 'usage: tkt-plan <state> verify [--extra <file>] [--model <id>]\n       tkt-plan <state> confirm --edits <file>\n       tkt-plan <state> grant-round --by <who> --comment <id> [--ruling <id>]
         (--owner-approved <id> is an alias for --ruling <id>)\n       tkt-plan <state> post [--part <label>] [--no-verifier]\n       tkt-plan <state> set <plan file> [--no-verifier]\n       tkt-plan <state> replan\n' >&2
  printf '       tkt-plan <state> triaged --comment <id>\n' >&2
  exit 2
}

[ $# -ge 2 ] || usage
state="$1" sub="$2"; shift 2

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
tkt_state="$script_dir/tkt-state"; bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then echo "tkt-plan: cannot read shared lib: $namebase_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$namebase_lib"
tokens_lib="$script_dir/lib/plan-tokens.sh"
if [ ! -r "$tokens_lib" ]; then echo "tkt-plan: cannot read shared lib: $tokens_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$tokens_lib"
verdict_lib="$script_dir/lib/plan-verdict.sh"
if [ ! -r "$verdict_lib" ]; then echo "tkt-plan: cannot read shared lib: $verdict_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$verdict_lib"
tktjob="$bin_dir/tkt-job"; plancheck="$bin_dir/plan-check"; plangate="$bin_dir/plan-gate"
postplan="$bin_dir/post-plan"; plansweep="$bin_dir/plan-sweep"
vbrief="$HOME/.agents/skills/planning/briefs/verifier.md"; cbrief="$HOME/.agents/skills/planning/briefs/confirm.md"
REPORT_LINES=38

t() { "$tkt_state" "$state" "$@"; }

lockdir="$state.lock"
if mkdir "$lockdir" 2>/dev/null; then rmdir "$lockdir"
else pid="$(cat "$lockdir/pid" 2>/dev/null || true)"; echo "tkt-plan: state locked${pid:+ by pid $pid}" >&2; exit 2; fi

t require repo issue run worktree
repo="$(t get repo)"; issue="$(t get issue)"; set_namebase "$repo" "$issue"; run="$(t get run)"; worktree="$(t get worktree)"
mkdir -p "$run"

if stored="$(t get head 2>/dev/null)"; then actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || { echo "tkt-plan: cannot read worktree HEAD: $worktree" >&2; exit 2; }; [ "$stored" = "$actual" ] || { echo "tkt-plan: head drift: state $state head=$stored worktree $worktree HEAD=$actual (after a rebase or main merge, run: tkt-state $state set head $actual)" >&2; exit 3; }; fi

tmp="$(mktemp "${TMPDIR:-/tmp}/tkt-plan.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

emit() {
  verdict="$1"; ec="$2"; shift 2
  logpath="$run/$namebase-tkt-plan-$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')-$(date +%H%M%S).log"
  { printf 'TKT tkt-plan %s log=%s\n' "$verdict" "$logpath"; [ $# -eq 0 ] || printf '%s\n' "$@"; } >"$logpath"
  cat "$logpath"; t journal "tkt-plan $verdict"; exit "$ec"
}

base_of() {
  b="$(plan_base "$1")"; [ -n "$b" ] || { echo "tkt-plan: no Base line in $1" >&2; exit 2; }
  printf '%s\n' "$b"
}

load_plan() {
  t require plan; plan="$(t get plan)"
  [ -r "$plan" ] || { echo "tkt-plan: cannot read plan file: $plan" >&2; exit 2; }
  base="$(base_of "$plan")"
}

# gate.script, when set, is the gate script every Gate line must run; plan-gate gets it as --script.
gate_script="$(t get gate.script 2>/dev/null || true)"
gate_args=()
[ -z "$gate_script" ] || gate_args=(--script "$gate_script")

ronum() { n="$(t get verifier_round 2>/dev/null || printf '0')"; case "$n" in ''|*[!0-9]*) n=0;; esac; printf '%s\n' "$n"; }

# free_path PATH: reserve and print PATH when no file exists there, else the
# first <stem>-2.md, <stem>-3.md, ... that is free. A report is evidence, so a
# round never writes over one. The reservation is an empty file created with
# noclobber (O_EXCL), so two rounds on one state cannot pick the same name. A
# reserved file that stays empty means its job wrote no report.
free_path() {
  local p="$1" stem n=2 cand
  stem="${p%.md}"
  cand="$p"
  until ( set -C; : >"$cand" ) 2>/dev/null; do
    [ -e "$cand" ] || { echo "tkt-plan: cannot reserve report: $cand" >&2; return 1; }
    cand="$stem-$n.md"; n=$((n + 1))
  done
  printf '%s\n' "$cand"
}

# report_passed REPORT: true when REPORT is a clean pass. Line 1 that is exactly
# `PLAN OK` passes as it always has. Otherwise the verdict may sit on any line:
# it passes when at least one line is exactly `PLAN OK` and no line carries
# `PLAN OK` with other text (the brief says that records a fail).
report_passed() {
  local rep="$1" any exact
  [ "$(head -n 1 "$rep")" = "PLAN OK" ] && return 0
  any="$(grep -Fc 'PLAN OK' "$rep" || true)"
  exact="$(grep -c '^PLAN OK$' "$rep" || true)"
  [ "$exact" -ge 1 ] && [ "$any" -eq "$exact" ]
}

open_lines() {
  local report round
  report="$(t get last_report 2>/dev/null || true)"
  round="$(ronum)"
  if [ -z "$report" ] || [ ! -f "$report" ]; then
    printf 'none (no report: round %s ended without one)\n' "$round"
  elif [ ! -s "$report" ] || report_passed "$report"; then
    printf 'none\n'
  else
    head -n "$REPORT_LINES" "$report"
  fi
}

grant_pending() {
  local granted_by granted_used
  granted_by="$(t get granted_by 2>/dev/null || true)"
  granted_used="$(t get granted_used 2>/dev/null || true)"
  [ -n "$granted_by" ] && [ -z "$granted_used" ]
}

vmodel() {
  [ -n "${1:-}" ] && { printf '%s\n' "$1"; return; }
  t get model.verifier 2>/dev/null || { echo "tkt-plan: missing key: model.verifier" >&2; exit 2; }
}

ticket_fail() {
  echo "tkt-plan: cannot read ticket text for $repo#$issue" >&2
  if [ -s "$tmp" ]; then head -n 1 "$tmp" >&2; fi
  exit 2
}

# ticket_extra OUT CALLER: writes the ticket (body, then comments) to OUT, then
# CALLER's bytes when set. One leading @ on CALLER is stripped. A blank body or
# a failed read exits 2 before OUT is touched; OUT is built aside and moved in.
ticket_extra() {
  local out="$1" caller="${2#@}" body comments tf
  if [ -n "$caller" ] && [ ! -r "$caller" ]; then echo "tkt-plan: cannot read extra file: $caller" >&2; exit 2; fi
  if ! body="$(gh issue view "$issue" --repo "$repo" 2>"$tmp")" || [ -z "${body//[[:space:]]/}" ]; then ticket_fail; fi
  if ! comments="$(gh issue view "$issue" --repo "$repo" --comments 2>"$tmp")"; then ticket_fail; fi
  tf="$(mktemp "${TMPDIR:-/tmp}/tkt-ticket.XXXXXX")"
  {
    printf '## Ticket %s#%s\n%s\n' "$repo" "$issue" "$body"
    [ -z "$comments" ] || printf '## Ticket comments\n%s\n' "$comments"
    [ -z "$caller" ] || { printf '## Extra\n'; cat "$caller"; }
  } >"$tf" || { rm -f "$tf"; exit 2; }
  mv "$tf" "$out"
}

runjob() {
  slot="$1"; tmpl="$2"; rep="$3"; shift 3
  job_out="$("$tktjob" "$state" --slot "$slot" --template "$tmpl" --out-file "$rep" "$@" 2>&1)" || {
    jrc=$?; line="$(grep -m1 '^TKT tkt-job ' <<<"$job_out" || head -n 1 <<<"$job_out")"
    # DONE_WITH_CONCERNS exits 1 with its report on disk: the report is the product.
    if [ "$jrc" -ne 1 ] || [ ! -s "$rep" ] || [ "${line#"TKT tkt-job CONCERNS "}" = "$line" ]; then
      case "$line" in
        "TKT tkt-job ASK "*)
          # An asking Verifier still spent its round: count it unless the
          # verify is drift-exempt, where the retry stays exempt.
          if [ "${drift:-0}" -eq 0 ] && [ -n "${round:-}" ]; then
            t set verifier_round "$((round + 1))"
          fi
          ;;
      esac
      w="${line#TKT tkt-job }"; emit "${w% log=*}" "$jrc" "$(head -n "$REPORT_LINES" <<<"$job_out")"
    fi
  }
  [ -s "$rep" ] || { echo "tkt-plan: tkt-job wrote no report: $rep" >&2; exit 3; }
  report_passed "$rep" && { RV="PLAN-OK out=$rep"; REC=0; } || { RV="LINES report_lines=$(wc -l <"$rep" | tr -d ' ') out=$rep"; REC=1; }
}

# task_pathspec KIND VALUE: expand_token's callback for task records. Resolve
# paths at the plan base so unique basename tokens become root-relative paths.
task_pathspec() {
  case "$1" in
    glob) printf '%s\n' "$2"; return 0 ;;
    path) ;;
    *) return 0 ;;
  esac
  resolve_path "$2"
  [ "$RES_KIND" = found ] || return 0
  printf '%s\n' "$RES"
}

# plan_task_pathspecs PLAN: resolved paths from backticked tokens on ## Tasks
# lines. The shared reader skips fences and non-Tasks sections; expand_token
# handles ports, symbols and brace alternatives before resolve_path applies the
# plan's path rules. A task path outside Files is still listed.
plan_task_pathspecs() {
  local tok
  local dir="$worktree" rev="$base" tree CUR_SEC=tasks
  tree="$(git -C "$dir" ls-tree -r --name-only "$rev")"
  while IFS= read -r tok; do
    [ -n "$tok" ] || continue
    expand_token "$tok" task_pathspec
  done < <(plan_records "$1" | awk -F '\t' '$1 == "tasks" { print $5 }')
  return 0
}

do_verify() {
  extra=""; model=""
  while [ $# -gt 0 ]; do case "$1" in
    --extra) [ $# -ge 2 ] || usage; extra="$2"; shift 2;;
    --model) [ $# -ge 2 ] || usage; model="$2"; shift 2;; *) usage;; esac; done
  t set plan_verdict ""
  t set plan_verdict_base ""
  t set plan_verdict_hash ""
  t set plan_triage_comment ""
  load_plan
  files=()
  while IFS= read -r p; do files+=("$p"); done < <(plan_files_pathspecs "$plan")
  if [ "${#files[@]}" -gt 0 ]; then
    stat="$(git -C "$worktree" diff --stat "$base...origin/main" -- "${files[@]}" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
    if [ -n "$stat" ]; then n="$(git -C "$worktree" diff --name-only "$base...origin/main" -- "${files[@]}" | wc -l | tr -d ' ')"; emit "STALE n=$n base=$base" 1 "$({ plan_bare_dirs "$plan" "$worktree"; head -n "$REPORT_LINES" <<<"$stat"; })"; fi
  fi
  pc_out="$("$plancheck" "$plan" --base "$base" --cwd "$worktree" 2>"$tmp")" && prc=0 || prc=$?
  [ "$prc" -ne 2 ] || { cat "$tmp" >&2; exit 2; }
  [ "$prc" -ne 1 ] || emit "PLAN-CHECK report_lines=$(grep -c . <<<"$pc_out" || true)" 1 "$(head -n "$REPORT_LINES" <<<"$pc_out")"
  round="$(ronum)"
  # The drift exemption is derived from recorded state, not a caller flag: a
  # verify is exempt only when a previous round recorded a base and main
  # changed a task path between that base and the current one. A Files
  # change no task names is not drift, so the round limit applies.
  drift=0
  vbase="$(t get verified_base 2>/dev/null || true)"
  if [ -n "$vbase" ]; then
    tpaths=()
    while IFS= read -r p; do tpaths+=("$p"); done < <(plan_task_pathspecs "$plan")
    if [ "${#tpaths[@]}" -gt 0 ]; then
      if dstat="$(git -C "$worktree" diff --stat "$vbase...$base" -- "${tpaths[@]}" 2>/dev/null)"; then
        [ -n "$dstat" ] && drift=1 || drift=0
      else
        drift=0
      fi
    fi
  fi
  if [ "$drift" -eq 0 ]; then
    [ -z "$(t get confirmed_for 2>/dev/null || true)" ] || emit "ROUND-LIMIT round=$round confirm=done" 1 "if no grant is recorded, run tkt-plan $state grant-round --by <who> --comment <id>, then tkt-plan $state confirm --edits <file>; after triage answers every open line, run tkt-plan $state triaged --comment <id>" "$(open_lines)"
    [ "$round" -lt 2 ] || emit "ROUND-LIMIT round=$round" 1 "two Verifier rounds ran with no confirm; run tkt-plan $state confirm --edits <file>, or after triage answers every open line run tkt-plan $state triaged --comment <id>" "$(open_lines)"
  fi
  model="$(vmodel "$model")" || exit 2
  args=(PLAN="$plan" BASE="$base" --model "$model")
  if [ "$drift" -eq 1 ]; then
    slot="verifier-r$((round + 1))-drift"
    rep="$(free_path "$run/$namebase-verifier-out-r$((round + 1))-drift.md")" || exit 3
    xfile="$run/$namebase-verifier-extra-r$((round + 1))-drift.md"
  else
    slot="verifier-r$((round + 1))"
    rep="$(free_path "$run/$namebase-verifier-out-r$((round + 1)).md")" || exit 3
    xfile="$run/$namebase-verifier-extra-r$((round + 1)).md"
  fi
  # --extra wins over state extra; the ticket text goes before either.
  [ -n "$extra" ] || extra="$(t get extra 2>/dev/null || true)"
  ticket_extra "$xfile" "$extra"
  printf '\nWhen the plan passes, the report must start with this exact first line, with nothing before or after it on that line:\n\nPLAN OK\n' >>"$xfile"
  args+=(EXTRA="@$xfile")
  # A failed round leaves its job id behind while the round counter stays
  # put; without this reset the next verify would only re-watch the old job.
  t set "job.$slot" ""
  runjob "$slot" "$vbrief" "$rep" "${args[@]}"
  if [ "$REC" -eq 0 ]; then verdict=ok; else verdict=lines; fi
  plan_verdict_write "$tkt_state" "$state" "$verdict" "$base" "$plan" "$worktree"
  verified_plan_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
  # A verify that reaches a report records its base and plan snapshot; a failed
  # or asking job leaves the prior state so the retry stays exempt.
  t set verified_base "$base"
  t set verified_plan_hash "$verified_plan_hash"
  if [ "$drift" -eq 0 ]; then
    t set verifier_round "$((round + 1))"
  fi
  t set last_report "$rep"
  emit "$RV" "$REC" "$(head -n "$REPORT_LINES" "$rep")"
}

do_confirm() {
  edits=""
  while [ $# -gt 0 ]; do case "$1" in
    --edits) [ $# -ge 2 ] || usage; edits="$2"; shift 2;; *) usage;; esac; done
  [ -n "$edits" ] || usage; [ -r "$edits" ] || { echo "tkt-plan: cannot read edits file: $edits" >&2; exit 2; }
  load_plan
  latest_edits=""
  for candidate in "$run/$namebase"-confirm-edits*.md; do
    [ -f "$candidate" ] || continue
    if [ -z "$latest_edits" ] || [ "$candidate" -nt "$latest_edits" ]; then latest_edits="$candidate"; fi
  done
  staleness_check="none (no confirm-edits file)"
  if [ -n "$latest_edits" ]; then
    verified_plan_hash="$(t get verified_plan_hash 2>/dev/null || true)"
    stale_confirm=0
    if [ -n "$verified_plan_hash" ]; then
      staleness_check=hash
      plan_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
      [ "$plan_hash" = "$verified_plan_hash" ] && stale_confirm=1
    else
      staleness_check="skipped (no verified_plan_hash)"
    fi
    if [ "$stale_confirm" -eq 1 ]; then
      emit "STALE-CONFIRM edits=$latest_edits plan=$plan" 1 "staleness-check: $staleness_check" "apply edits from $latest_edits to $plan, then rerun: tkt-plan $state confirm --edits $latest_edits"
    fi
  fi
  confirmed_for="$(t get confirmed_for 2>/dev/null || true)"
  granted=0
  reconfirm_free=0
  if [ -n "$confirmed_for" ]; then
    if grant_pending; then
      granted=1
    else
      reconfirm_used="$(t get confirm_reconfirm_used 2>/dev/null || true)"
      last_confirm_report="$(t get last_confirm_report 2>/dev/null || true)"
      if [ -z "$last_confirm_report" ]; then
        last_confirm_report="$(t get last_report 2>/dev/null || true)"
        case "$last_confirm_report" in *-confirm-out*.md) ;; *) last_confirm_report="";; esac
      fi
      if [ "$reconfirm_used" != 1 ] && [ -n "$latest_edits" ] && [ -n "$last_confirm_report" ] && [ -f "$last_confirm_report" ] && [ "$latest_edits" -nt "$last_confirm_report" ]; then
        reconfirm_free=1
      else
        emit "ROUND-LIMIT confirm=done" 1 "staleness-check: $staleness_check" "if no grant is recorded, run tkt-plan $state grant-round --by <who> --comment <id>, then tkt-plan $state confirm --edits <file>; after triage answers every open line, run tkt-plan $state triaged --comment <id>" "$(open_lines)"
      fi
    fi
  fi
  pc_out="$("$plancheck" "$plan" --base "$base" --cwd "$worktree" 2>"$tmp")" && prc=0 || prc=$?
  [ "$prc" -ne 2 ] || { cat "$tmp" >&2; exit 2; }
  [ "$prc" -ne 1 ] || emit "PLAN-CHECK report_lines=$(grep -c . <<<"$pc_out" || true)" 1 "staleness-check: $staleness_check" "$(head -n "$REPORT_LINES" <<<"$pc_out")"
  cmodel="$(vmodel)" || exit 2
  rep="$(free_path "$run/$namebase-confirm-out.md")" || exit 3
  xfile="$run/$namebase-confirm-extra.md"
  # Confirm has no --extra flag: the state extra, if any, follows the ticket text.
  ticket_extra "$xfile" "$(t get extra 2>/dev/null || true)"
  if [ "$granted" -eq 1 ]; then
    t set job.confirm ""
  else
    confirm_job="$(t get job.confirm 2>/dev/null || true)"
    if [ -n "$confirm_job" ]; then
      confirm_record="$(bash "$script_dir/job-record" "$confirm_job" 2>/dev/null || true)"
      if [ -n "$confirm_record" ]; then
        confirm_status="$(jq -r '.result.status // .status // ""' "$confirm_record" 2>/dev/null || true)"
        if [ -n "$confirm_status" ] && [ "$confirm_status" != RUNNING ]; then
          t set job.confirm ""
        fi
      fi
    fi
  fi
  runjob confirm "$cbrief" "$rep" PLAN="$plan" BASE="$base" EDITS="@$edits" EXTRA="@$xfile" --model "$cmodel"
  if [ "$REC" -eq 0 ]; then verdict=ok; else verdict=lines; fi
  plan_verdict_write "$tkt_state" "$state" "$verdict" "$base" "$plan" "$worktree"
  t set plan_triage_comment ""
  if [ "$granted" -eq 1 ]; then t set granted_used 1; fi
  if [ "$reconfirm_free" -eq 1 ]; then t set confirm_reconfirm_used 1; fi
  t set last_report "$rep"
  t set last_confirm_report "$rep"
  t set confirmed_for "$(ronum)"
  emit "$RV" "$REC" "staleness-check: $staleness_check" "$(head -n "$REPORT_LINES" "$rep")"
}

do_grant() {
  who=""; comment=""; ruling=""; via=""
  while [ $# -gt 0 ]; do case "$1" in
    --by) [ $# -ge 2 ] || usage; who="$2"; shift 2;;
    --comment) [ $# -ge 2 ] || usage; comment="$2"; shift 2;;
    --ruling) [ $# -ge 2 ] && [ -n "$2" ] || usage; ruling="$2"; via="ruling"; shift 2;;
    --owner-approved) [ $# -ge 2 ] && [ -n "$2" ] || usage; ruling="$2"; via="owner-approved"; shift 2;;
    *) usage;; esac; done
  [ -n "$who" ] && [ -n "$comment" ] || usage
  case "$who$comment$ruling" in *[[:space:]]*) usage;; esac
  confirmed_for="$(t get confirmed_for 2>/dev/null || true)"
  [ -n "$confirmed_for" ] || { echo "tkt-plan: no limit reached: the confirm round is still open; rerun: tkt-plan $state confirm --edits <file>" >&2; exit 2; }
  granted_by="$(t get granted_by 2>/dev/null || true)"
  granted_used="$(t get granted_used 2>/dev/null || true)"
  if [ -n "$granted_by" ] && [ -z "$granted_used" ]; then
    pending_comment="$(t get granted_comment 2>/dev/null || true)"
    echo "tkt-plan: grant already pending: $granted_by:$pending_comment" >&2
    exit 2
  fi
  if [ -n "$granted_by" ] && [ -z "$ruling" ]; then
    recorded_comment="$(t get granted_comment 2>/dev/null || true)"
    echo "tkt-plan: grant already recorded: $granted_by:$recorded_comment: a later grant needs a ruling: use --ruling <comment id>" >&2
    exit 2
  fi
  grant_count="$(t list grant 2>/dev/null | grep -c . || true)"
  case "$grant_count" in ''|*[!0-9]*) grant_count=0;; esac
  case "$confirmed_for" in ''|*[!0-9]*) confirmed_for=0;; esac
  grant_round=$((confirmed_for + grant_count + 1))
  t set granted_by "$who"
  t set granted_comment "$comment"
  t set granted_used ""
  t add grant "round=$grant_round by=$who via=$via comment=$comment ruling=$ruling"
  emit "SET grant=$who:$comment" 0 "next: tkt-plan $state confirm --edits <file>"
}

do_triaged() {
  comment=""
  while [ $# -gt 0 ]; do case "$1" in
    --comment) [ $# -ge 2 ] || usage; comment="$2"; shift 2;;
    *) usage;; esac; done
  case "$comment" in
    ""|*[!0-9]*) echo "tkt-plan: comment id must contain only digits" >&2; exit 2;;
  esac
  load_plan
  round="$(ronum)"
  confirmed_for="$(t get confirmed_for 2>/dev/null || true)"
  if [ -z "$confirmed_for" ] && [ "$round" -lt 2 ]; then
    plan_verdict_read "$tkt_state" "$state" "$plan" "$worktree"
    [ "$plan_verdict" = lines ] || emit "TRIAGED-REFUSED reason=rounds-open" 1
  fi
  plan_verdict_write "$tkt_state" "$state" triaged "$base" "$plan" "$worktree"
  t set plan_triage_comment "$comment"
  emit "SET triaged=$comment" 0
}

do_post() {
  part=""; no_verifier=0
  while [ $# -gt 0 ]; do case "$1" in
    --part) [ $# -ge 2 ] || usage; part="$2"; shift 2;;
    --no-verifier) no_verifier=1; shift;;
    *) usage;; esac; done
  load_plan
  # Default the label from the state. An unlabelled post reuses this script's
  # own unlabelled comments oldest-first and deletes each leftover, so running
  # `post` on a part-2 state without --part overwrites part 1's posted plan in
  # place — and deletes a comment if part 1 was longer. fiber #4078 hit exactly
  # that: part=2 in the state, post without the flag, and comment 6605844496
  # stopped holding the Part 1 plan. The state knows the part; use it.
  if [ -z "$part" ]; then
    sp="$(t get part 2>/dev/null || true)"
    case "$sp" in
      ''|1) ;;
      *[!0-9]*) echo "tkt-plan: state part='$sp' is not a number; pass --part <label> explicitly" >&2; exit 2 ;;
      *) part="P$sp"; echo "tkt-plan: --part not given; using P$sp from the state's part=$sp" >&2 ;;
    esac
  fi
  files=()
  while IFS= read -r p; do files+=("$p"); done < <(plan_files_pathspecs "$plan")
  if ! plan_verdict_check build "$tkt_state" "$state" "$no_verifier" "$plan" "$base" "$worktree" ${files[@]+"${files[@]}"}; then emit "POST-FAIL reason=verdict verdict=$verdict_refusal" 1 "$verdict_digest"; fi
  "$plangate" ${gate_args[@]+"${gate_args[@]}"} "$plan" >"$tmp" 2>&1 || emit "POST-FAIL reason=gate" 1 "$(head -n 10 "$tmp")"
  pargs=(); [ -z "$part" ] || pargs=(--part "$part")
  urls="$("$postplan" "$issue" "$plan" --repo "$repo" ${pargs[@]+"${pargs[@]}"} 2>"$tmp")" || emit "POST-FAIL reason=post" "$?" "$(head -n 10 "$tmp")"
  emit "POSTED urls=$(tr '\n' ',' <<<"$urls" | sed 's/,$//')" 0 "$urls"
}

do_set() {
  [ $# -ge 1 ] || usage
  plan_arg="$1"; shift; no_verifier=0
  if [ $# -gt 0 ]; then [ "$#" -eq 1 ] && [ "$1" = --no-verifier ] || usage; no_verifier=1; fi
  case "$plan_arg" in /*) plan="$plan_arg" ;; *) plan="$PWD/$plan_arg" ;; esac
  [ -r "$plan" ] || { echo "tkt-plan: cannot read plan file: $plan" >&2; exit 2; }
  base="$(base_of "$plan")"
  # A set with gate.script checks the Gate line before any state write.
  if [ -n "$gate_script" ]; then
    "$plangate" ${gate_args[@]+"${gate_args[@]}"} "$plan" >"$tmp" 2>&1 || emit "SET-FAIL reason=gate" 1 "$(head -n 10 "$tmp")"
  fi
  pack_out="$run/$namebase-pack.md"
  old_plan="$(t get plan 2>/dev/null || true)"
  plan_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
  stored_pack_plan_hash="$(t get pack_plan_hash 2>/dev/null || true)"
  stored_pack="$(t get pack 2>/dev/null || true)"
  if [ "$old_plan" = "$plan" ] && [ "$stored_pack_plan_hash" = "$plan_hash" ] && [ "$stored_pack" = "$pack_out" ] && [ -f "$stored_pack" ] && [ -s "$stored_pack" ]; then
    pack="$stored_pack"
  else
    sweep_out="$("$plansweep" --cwd "$worktree" --base "$base" --plan "$plan" --out "$pack_out")" || { printf '%s\n' "$sweep_out" >&2; exit 2; }
    pack="$(awk '/^PACK /{print $2; exit}' <<<"$sweep_out")"; [ -n "$pack" ] || { echo "tkt-plan: plan-sweep printed no PACK line" >&2; exit 2; }
  fi
  t set plan "$plan"; t set pack "$pack"
  # Re-setting the same plan keeps the round counts and job slots; a new path starts over.
  if [ "$old_plan" != "$plan" ]; then
    t set plan_verdict ""; t set plan_verdict_base ""; t set plan_verdict_hash ""; t set plan_triage_comment ""
    t set verified_base ""; t set verified_plan_hash ""
    t set pack_plan_hash ""; t set last_report ""
    for s in verifier-r1 verifier-r2 confirm lane fix1 fix2 fix3; do t set "job.$s" ""; done
  fi
  t set pack_plan_hash "$plan_hash"
  plan_verdict_read "$tkt_state" "$state" "$plan" "$worktree"
  if [ "$old_plan" = "$plan" ] && [ "$no_verifier" -eq 0 ] && [ "$plan_verdict" = skipped ]; then
    t set plan_verdict ""; t set plan_verdict_base ""; t set plan_verdict_hash ""; t set plan_triage_comment ""
  fi
  if [ "$no_verifier" -eq 1 ] && { [ -z "$plan_verdict" ] || [ "$plan_verdict" = skipped ]; }; then
    plan_verdict_write "$tkt_state" "$state" skipped "$base" "$plan" "$worktree"
  fi
  emit "SET plan=$plan" 0 "plan=$plan" "pack=$pack"
}

do_replan() {
  [ $# -eq 0 ] || usage
  # A re-plan has a plan, so a missing key is a usage error before any write.
  plan_key="$(t get plan 2>/dev/null || true)"
  if [ -z "$plan_key" ]; then echo "tkt-plan: missing key: plan" >&2; exit 2; fi
  # Job slots and findings first, round last: a half-done replan leaves
  # round non-empty and tkt-build refuses loudly instead of reusing a stale slot.
  t set plan_verdict ""
  t set plan_verdict_base ""
  t set plan_verdict_hash ""
  t set verified_plan_hash ""
  t set pack_plan_hash ""
  t set plan_triage_comment ""
  t set job.lane ""
  t set job.fix1 ""
  t set job.fix2 ""
  t set job.fix3 ""
  t set job.preflight ""
  t set findings ""
  t set round ""
  emit "REPLAN cleared=round,job.lane,job.fix1,job.fix2,job.fix3,job.preflight,findings" 0
}

case "$sub" in
  verify) do_verify "$@";; confirm) do_confirm "$@";; grant-round) do_grant "$@";; triaged) do_triaged "$@";; post) do_post "$@";; set) do_set "$@";; replan) do_replan "$@";; *) usage;; esac
