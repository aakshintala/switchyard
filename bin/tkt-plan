#!/usr/bin/env bash
# tkt-plan: planning steps 3-5, one Verifier round, post or plan-path set per call.
set -euo pipefail

usage() {
  printf 'usage: tkt-plan <state> verify [--extra <file>] [--model <id>]\n       tkt-plan <state> confirm --edits <file>\n       tkt-plan <state> post [--part <label>]\n       tkt-plan <state> set <plan file>\n' >&2
  exit 2
}

[ $# -ge 2 ] || usage
state="$1" sub="$2"; shift 2

script_dir="$(cd "$(dirname "$0")" && pwd)"; tkt_state="$script_dir/tkt-state"; bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
tktjob="$bin_dir/tkt-job"; plancheck="$bin_dir/plan-check"; plangate="$bin_dir/plan-gate"
postplan="$bin_dir/post-plan"; plansweep="$bin_dir/plan-sweep"
vbrief="$HOME/.agents/skills/planning/briefs/verifier.md"; cbrief="$HOME/.agents/skills/planning/briefs/confirm.md"

t() { "$tkt_state" "$state" "$@"; }

lockdir="$state.lock"
if mkdir "$lockdir" 2>/dev/null; then rmdir "$lockdir"
else pid="$(cat "$lockdir/pid" 2>/dev/null || true)"; echo "tkt-plan: state locked${pid:+ by pid $pid}" >&2; exit 2; fi

t require repo issue run worktree
repo="$(t get repo)"; issue="$(t get issue)"; run="$(t get run)"; worktree="$(t get worktree)"
mkdir -p "$run"

if stored="$(t get head 2>/dev/null)"; then actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || { echo "tkt-plan: cannot read worktree HEAD: $worktree" >&2; exit 2; }; [ "$stored" = "$actual" ] || { echo "tkt-plan: head drift: state $state head=$stored worktree $worktree HEAD=$actual" >&2; exit 3; }; fi

tmp="$(mktemp "${TMPDIR:-/tmp}/tkt-plan.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

emit() {
  verdict="$1"; ec="$2"; shift 2
  logpath="$run/$repo-$issue-tkt-plan-$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')-$(date +%H%M%S).log"
  { printf 'TKT tkt-plan %s log=%s\n' "$verdict" "$logpath"; [ $# -eq 0 ] || printf '%s\n' "$@"; } >"$logpath"
  cat "$logpath"; t journal "tkt-plan $verdict"; exit "$ec"
}

base_of() {
  b="$(awk '/^Base:[[:space:]]/ { print $2; exit }' "$1")"; [ -n "$b" ] || { echo "tkt-plan: no Base line in $1" >&2; exit 2; }
  printf '%s\n' "$b"
}

load_plan() {
  t require plan; plan="$(t get plan)"
  [ -r "$plan" ] || { echo "tkt-plan: cannot read plan file: $plan" >&2; exit 2; }
  base="$(base_of "$plan")"
}

ronum() { n="$(t get verifier_round 2>/dev/null || printf '0')"; case "$n" in ''|*[!0-9]*) n=0;; esac; printf '%s\n' "$n"; }

vmodel() {
  [ -n "${1:-}" ] && { printf '%s\n' "$1"; return; }
  t get model.verifier 2>/dev/null || { echo "tkt-plan: missing key: model.verifier" >&2; exit 2; }
}

runjob() {
  slot="$1"; tmpl="$2"; rep="$3"; shift 3
  job_out="$("$tktjob" "$state" --slot "$slot" --template "$tmpl" --out-file "$rep" "$@" 2>&1)" || { jrc=$?; line="$(head -n 1 <<<"$job_out")"; w="${line#TKT tkt-job }"; emit "${w% log=*}" "$jrc" "$(head -n 38 <<<"$job_out")"; }
  [ -r "$rep" ] || { echo "tkt-plan: tkt-job wrote no report: $rep" >&2; exit 3; }
  [ "$(head -n 1 "$rep")" = "PLAN OK" ] && { RV="PLAN-OK out=$rep"; REC=0; } || { RV="LINES n=$(wc -l <"$rep" | tr -d ' ') out=$rep"; REC=1; }
}

do_verify() {
  extra=""; model=""
  while [ $# -gt 0 ]; do case "$1" in
    --extra) [ $# -ge 2 ] || usage; extra="$2"; shift 2;;
    --model) [ $# -ge 2 ] || usage; model="$2"; shift 2;; *) usage;; esac; done
  load_plan
  files=()
  while IFS= read -r p; do [ -n "$p" ] || continue; files+=("$p"); done < <(awk '/^## Files([[:space:]]|$)/{f=1;next} f&&/^## /{exit} f' "$plan" | grep -o '`[^`]*`' | tr -d '`' | grep -v '^$' || true)
  if [ "${#files[@]}" -gt 0 ]; then
    stat="$(git -C "$worktree" diff --stat "$base...origin/main" -- "${files[@]}" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
    if [ -n "$stat" ]; then n="$(git -C "$worktree" diff --name-only "$base...origin/main" -- "${files[@]}" | wc -l | tr -d ' ')"; emit "STALE n=$n base=$base" 1 "$(head -n 38 <<<"$stat")"; fi
  fi
  pc_out="$("$plancheck" "$plan" --base "$base" --cwd "$worktree" 2>"$tmp")" && prc=0 || prc=$?
  [ "$prc" -ne 2 ] || { cat "$tmp" >&2; exit 2; }
  [ "$prc" -ne 1 ] || emit "PLAN-CHECK n=$(grep -c . <<<"$pc_out" || true)" 1 "$(head -n 38 <<<"$pc_out")"
  round="$(ronum)"
  [ -z "$(t get confirmed_for 2>/dev/null || true)" ] || emit "ROUND-LIMIT round=$round confirm=done" 1 "the confirm round is used; send the open lines to triage"
  [ "$round" -lt 2 ] || emit "ROUND-LIMIT round=$round" 1 "two Verifier rounds ran with no confirm; run tkt-plan confirm --edits <file>, or send the open lines to triage"
  model="$(vmodel "$model")" || exit 2
  args=(PLAN="$plan" BASE="$base" --model "$model")
  if [ -n "$extra" ]; then [ -r "$extra" ] || { echo "tkt-plan: cannot read extra file: $extra" >&2; exit 2; }; args+=(EXTRA="@$extra")
  elif ! t get extra >/dev/null 2>&1; then args+=(EXTRA=""); fi
  rep="$run/$repo-$issue-verifier-out-r$((round + 1)).md"
  runjob "verifier-r$((round + 1))" "$vbrief" "$rep" "${args[@]}"
  t set verifier_round "$((round + 1))"
  emit "$RV" "$REC" "$(head -n 38 "$rep")"
}

do_confirm() {
  edits=""
  while [ $# -gt 0 ]; do case "$1" in
    --edits) [ $# -ge 2 ] || usage; edits="$2"; shift 2;; *) usage;; esac; done
  [ -n "$edits" ] || usage; [ -r "$edits" ] || { echo "tkt-plan: cannot read edits file: $edits" >&2; exit 2; }
  [ -z "$(t get confirmed_for 2>/dev/null || true)" ] || emit "ROUND-LIMIT confirm=done" 1 "the confirm round is used; send the open lines to triage"
  load_plan
  cmodel="$(vmodel)" || exit 2
  rep="$run/$repo-$issue-confirm-out.md"
  runjob confirm "$cbrief" "$rep" PLAN="$plan" BASE="$base" EDITS="@$edits" --model "$cmodel"
  t set confirmed_for "$(ronum)"
  emit "$RV" "$REC" "$(head -n 38 "$rep")"
}

do_post() {
  part=""
  while [ $# -gt 0 ]; do case "$1" in
    --part) [ $# -ge 2 ] || usage; part="$2"; shift 2;; *) usage;; esac; done
  load_plan
  "$plangate" "$plan" >"$tmp" 2>&1 || emit "POST-FAIL reason=gate" 1 "$(head -n 10 "$tmp")"
  pargs=(); [ -z "$part" ] || pargs=(--part "$part")
  urls="$("$postplan" "$issue" "$plan" --repo "$repo" ${pargs[@]+"${pargs[@]}"} 2>"$tmp")" || emit "POST-FAIL reason=post" "$?" "$(head -n 10 "$tmp")"
  emit "POSTED urls=$(tr '\n' ',' <<<"$urls" | sed 's/,$//')" 0 "$urls"
}

do_set() {
  [ $# -eq 1 ] || usage
  case "$1" in /*) plan="$1" ;; *) plan="$PWD/$1" ;; esac
  [ -r "$plan" ] || { echo "tkt-plan: cannot read plan file: $plan" >&2; exit 2; }
  base="$(base_of "$plan")"
  pack_out="$run/$repo-$issue-pack.md"
  sweep_out="$("$plansweep" --cwd "$worktree" --base "$base" --plan "$plan" --out "$pack_out" 2>"$tmp")" || { printf '%s\n' "$sweep_out" >&2; cat "$tmp" >&2; exit 2; }
  pack="$(awk '/^PACK /{print $2; exit}' <<<"$sweep_out")"; [ -n "$pack" ] || { echo "tkt-plan: plan-sweep printed no PACK line" >&2; exit 2; }
  t set plan "$plan"; t set pack "$pack"; t set verifier_round 0; t set confirmed_for ""
  for s in verifier-r1 verifier-r2 confirm; do t set "job.$s" ""; done
  emit "SET plan=$plan" 0 "plan=$plan" "pack=$pack"
}

case "$sub" in
  verify) do_verify "$@";; confirm) do_confirm "$@";; post) do_post "$@";; set) do_set "$@";; *) usage;; esac
