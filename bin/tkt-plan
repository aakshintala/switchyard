#!/usr/bin/env bash
# tkt-plan: planning steps 3-5, one Verifier round, post or plan-path set per call.
set -euo pipefail
# A verify after a recorded stale-plan revision is exempt from the round
# limit; the exemption is derived from recorded state below.

usage() {
  printf 'usage: tkt-plan <state> verify [--extra <file>] [--model <id>]\n       tkt-plan <state> confirm --edits <file>\n       tkt-plan <state> grant-round --by <who> --comment <id> [--ruling <id>]\n       tkt-plan <state> post [--part <label>] [--no-verifier]\n       tkt-plan <state> set <plan file> [--no-verifier]\n       tkt-plan <state> replan\n' >&2
  printf '       tkt-plan <state> triaged --comment <id>\n' >&2
  printf '       tkt-plan <state> rule-ok --by <flywheel|surveyor> --ruling <RULING-id> --comment <id>\n' >&2
  printf '       tkt-plan <state> rule-questions --comment <id>\n' >&2
  exit 2
}

[ $# -ge 2 ] || usage
state="$1" sub="$2"; shift 2

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
tkt_state="$script_dir/tkt-state"; bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then echo "tkt-plan: cannot read shared lib: $namebase_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$namebase_lib"
tokens_lib="$script_dir/lib/plan-tokens.sh"
if [ ! -r "$tokens_lib" ]; then echo "tkt-plan: cannot read shared lib: $tokens_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$tokens_lib"
verdict_lib="$script_dir/lib/plan-verdict.sh"
if [ ! -r "$verdict_lib" ]; then echo "tkt-plan: cannot read shared lib: $verdict_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$verdict_lib"
tktjob="$bin_dir/tkt-job"; plancheck="$bin_dir/plan-check"; plangate="$bin_dir/plan-gate"
postplan="$bin_dir/post-plan"; plansweep="$bin_dir/plan-sweep"
vbrief="$HOME/.agents/skills/planning/briefs/verifier.md"; cbrief="$HOME/.agents/skills/planning/briefs/confirm.md"
REPORT_LINES=38
reanchor_changed_symbols=()

reanchor_has_changed_symbols() {
  [ -n "${reanchor_changed_symbols[0]+present}" ]
}

format_reanchor_symbols() {
  local item joined=""
  for item in ${reanchor_changed_symbols[@]+"${reanchor_changed_symbols[@]}"}; do
    [ -z "$joined" ] || joined="$joined, "
    joined="${joined}${item}"
  done
  printf '%s' "$joined"
}

t() { "$tkt_state" "$state" "$@"; }

lockdir="$state.lock"
require_state_file tkt-plan "$state"
if mkdir "$lockdir" 2>/dev/null; then rmdir "$lockdir"
else pid="$(cat "$lockdir/pid" 2>/dev/null || true)"; echo "tkt-plan: state locked${pid:+ by pid $pid}" >&2; exit 2; fi

t require repo issue run worktree
repo="$(t get repo)"; issue="$(t get issue)"; set_namebase "$repo" "$issue"; run="$(t get run)"; worktree="$(t get worktree)"
mkdir -p "$run"

if stored="$(t get head 2>/dev/null)"; then actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || { echo "tkt-plan: cannot read worktree HEAD: $worktree" >&2; exit 2; }; [ "$stored" = "$actual" ] || { echo "tkt-plan: head drift: state $state head=$stored worktree $worktree HEAD=$actual (after a rebase or main merge, run: tkt-state $state set head $actual)" >&2; exit 3; }; fi

tmp="$(mktemp "${TMPDIR:-/tmp}/tkt-plan.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

emit() {
  verdict="$1"; ec="$2"; shift 2
  logpath="$run/$namebase-tkt-plan-$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')-$(date +%H%M%S).log"
  { printf 'TKT tkt-plan %s log=%s\n' "$verdict" "$logpath"; [ $# -eq 0 ] || printf '%s\n' "$@"; } >"$logpath"
  cat "$logpath"; t journal "tkt-plan $verdict"; exit "$ec"
}

base_of() {
  b="$(plan_base "$1")"; [ -n "$b" ] || { echo "tkt-plan: no Base line in $1" >&2; exit 2; }
  printf '%s\n' "$b"
}

load_plan() {
  t require plan; plan="$(t get plan)"
  [ -r "$plan" ] || { echo "tkt-plan: cannot read plan file: $plan" >&2; exit 2; }
  base="$(base_of "$plan")"
}

plan_without_rulings() {
  awk '
    /^## Rulings[[:space:]]*$/ { in_rulings=1; next }
    /^## / && in_rulings { in_rulings=0 }
    !in_rulings { print }
  ' "$1"
}

plan_protected_sections() {
  awk '
    /^## (Files|Gate|Tasks)([[:space:]]|$)/ { in_protected=1; print; next }
    /^## / { in_protected=0 }
    in_protected { print }
  ' "$1"
}

plan_rulings_section() {
  awk '
    /^## Rulings[[:space:]]*$/ { in_rulings=1; found=1 }
    /^## / && in_rulings && $0 !~ /^## Rulings[[:space:]]*$/ { in_rulings=0 }
    in_rulings { print }
    END { if (!found) exit 1 }
  ' "$1"
}

plan_open_questions() {
  awk '
    /^## Open questions[[:space:]]*$/ { in_questions=1; next }
    /^## / && in_questions { in_questions=0 }
    in_questions {
      line=$0
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      answer=line
      sub(/^([-*+][[:space:]]+|[0-9]+[.)][[:space:]]+)/, "", answer)
      sub(/^[[:space:]]+/, "", answer)
      sub(/[[:space:]]+$/, "", answer)
      sub(/[.]+$/, "", answer)
      sub(/[[:space:]]+$/, "", answer)
      answer=tolower(answer)
      if (answer != "" && answer !~ /^(nothing|none|n\/a|no|-)$/) print line
    }
  ' "$1"
}

# Normalizes ruling lines on stdin for matching: drops fence lines, a diff +/- marker,
# a list marker and surrounding space; prints only non-empty lines. Plan and comment share it.
normalize_ruling_lines() {
  awk '
    {
      line=$0
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (line ~ /^(```|~~~)/) next
      sub(/^[-+]/, "", line)
      sub(/^[[:space:]]+/, "", line)
      sub(/^([-*+][[:space:]]+|[0-9]+[.)][[:space:]]+)/, "", line)
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (length(line)) print line
    }
  '
}

# gate.script, when set, is the gate script every Gate line must run; plan-gate gets it as --script.
gate_script="$(t get gate.script 2>/dev/null || true)"
gate_args=()
[ -z "$gate_script" ] || gate_args=(--script "$gate_script")

ronum() { n="$(t get verifier_round 2>/dev/null || printf '0')"; case "$n" in ''|*[!0-9]*) n=0;; esac; printf '%s\n' "$n"; }

# free_path PATH: reserve and print PATH when no file exists there, else the
# first <stem>-2.md, <stem>-3.md, ... that is free. A report is evidence, so a
# round never writes over one. The reservation is an empty file created with
# noclobber (O_EXCL), so two rounds on one state cannot pick the same name. A
# reserved file that stays empty means its job wrote no report.
free_path() {
  local p="$1" stem n=2 cand
  stem="${p%.md}"
  cand="$p"
  until ( set -C; : >"$cand" ) 2>/dev/null; do
    [ -e "$cand" ] || { echo "tkt-plan: cannot reserve report: $cand" >&2; return 1; }
    cand="$stem-$n.md"; n=$((n + 1))
  done
  printf '%s\n' "$cand"
}

# report_passed REPORT: true when REPORT is a clean pass. Line 1 that is exactly
# `PLAN OK` passes as it always has. Otherwise the verdict may sit on any line:
# it passes when at least one line is exactly `PLAN OK` and no line carries
# `PLAN OK` with other text (the brief says that records a fail).
report_passed() {
  local rep="$1" any exact
  [ "$(head -n 1 "$rep")" = "PLAN OK" ] && return 0
  any="$(grep -Fc 'PLAN OK' "$rep" || true)"
  exact="$(grep -c '^PLAN OK$' "$rep" || true)"
  [ "$exact" -ge 1 ] && [ "$any" -eq "$exact" ]
}

open_lines() {
  local report round
  report="$(t get last_report 2>/dev/null || true)"
  round="$(ronum)"
  if [ -z "$report" ] || [ ! -f "$report" ]; then
    printf 'none (no report: round %s ended without one)\n' "$round"
  elif [ ! -s "$report" ] || report_passed "$report"; then
    printf 'none\n'
  else
    head -n "$REPORT_LINES" "$report"
  fi
}

grant_pending() {
  local granted_by granted_used
  granted_by="$(t get granted_by 2>/dev/null || true)"
  granted_used="$(t get granted_used 2>/dev/null || true)"
  [ -n "$granted_by" ] && [ -z "$granted_used" ]
}

vmodel() {
  [ -n "${1:-}" ] && { printf '%s\n' "$1"; return; }
  t get model.verifier 2>/dev/null || { echo "tkt-plan: missing key: model.verifier" >&2; exit 2; }
}

ticket_fail() {
  echo "tkt-plan: cannot read ticket text for $repo#$issue" >&2
  if [ -s "$tmp" ]; then head -n 1 "$tmp" >&2; fi
  exit 2
}

# ticket_extra OUT CALLER: writes the ticket (body, then comments) to OUT, then
# CALLER's bytes when set. One leading @ on CALLER is stripped. A blank body or
# a failed read exits 2 before OUT is touched; OUT is built aside and moved in.
ticket_extra() {
  local out="$1" caller="${2#@}" body comments tf
  if [ -n "$caller" ] && [ ! -r "$caller" ]; then echo "tkt-plan: cannot read extra file: $caller" >&2; exit 2; fi
  if ! body="$(gh issue view "$issue" --repo "$repo" 2>"$tmp")" || [ -z "${body//[[:space:]]/}" ]; then ticket_fail; fi
  if ! comments="$(gh issue view "$issue" --repo "$repo" --comments 2>"$tmp")"; then ticket_fail; fi
  tf="$(mktemp "${TMPDIR:-/tmp}/tkt-ticket.XXXXXX")"
  {
    printf '## Ticket %s#%s\n%s\n' "$repo" "$issue" "$body"
    [ -z "$comments" ] || printf '## Ticket comments\n%s\n' "$comments"
    [ -z "$caller" ] || { printf '## Extra\n'; cat "$caller"; }
  } >"$tf" || { rm -f "$tf"; exit 2; }
  mv "$tf" "$out"
}

runjob() {
  slot="$1"; tmpl="$2"; rep="$3"; shift 3
  job_out="$("$tktjob" "$state" --slot "$slot" --template "$tmpl" --out-file "$rep" "$@" 2>&1)" || {
    jrc=$?; line="$(grep -m1 '^TKT tkt-job ' <<<"$job_out" || head -n 1 <<<"$job_out")"
    # DONE_WITH_CONCERNS exits 1 with its report on disk: the report is the product.
    if [ "$jrc" -ne 1 ] || [ ! -s "$rep" ] || [ "${line#"TKT tkt-job CONCERNS "}" = "$line" ]; then
      case "$line" in
        "TKT tkt-job ASK "*)
          # An asking Verifier still spent its round: count it unless the
          # verify is drift-exempt, where the retry stays exempt.
          if [ "${drift:-0}" -eq 0 ] && [ "${unresolved_fix:-0}" -eq 0 ] && [ -n "${round:-}" ]; then
            t set verifier_round "$((round + 1))"
          fi
          ;;
      esac
      extra=(); [ "$slot" != confirm ] || extra=("staleness-check: $staleness_check")
      if reanchor_has_changed_symbols; then
        extra+=("re-anchor symbols: $(format_reanchor_symbols)")
      fi
      w="${line#TKT tkt-job }"; emit "${w% log=*}" "$jrc" ${extra[@]+"${extra[@]}"} "$(head -n "$REPORT_LINES" <<<"$job_out")"
    fi
  }
  [ -s "$rep" ] || { echo "tkt-plan: tkt-job wrote no report: $rep" >&2; exit 3; }
  report_passed "$rep" && { RV="PLAN-OK out=$rep"; REC=0; } || { RV="LINES report_lines=$(wc -l <"$rep" | tr -d ' ') out=$rep"; REC=1; }
}

# A verify refusal that judges the plan (STALE, PLAN-CHECK) or reaches a job
# clears the verdict. ROUND-LIMIT is a budget refusal and keeps it: a verify
# after a granted confirm must not blank that confirm's PLAN-OK (#1491).
clear_verdict() {
  t set plan_verdict ""; t set plan_verdict_base ""; t set plan_verdict_hash ""; t set plan_triage_comment ""
  t set plan_verdict_by ""; t set plan_verdict_ruling ""; t set plan_verdict_comment ""
}

# Collect the plan's Files paths and compare them with origin/main. Callers own
# the policy and refusal output; this helper only shares the stale diff itself.
plan_stale_stat() {
  local stale_plan="$1" stale_base="$2" stale_worktree="$3" p
  plan_stale_files=()
  while IFS= read -r p; do plan_stale_files+=("$p"); done < <(plan_files_pathspecs "$stale_plan")
  plan_stale_stat_output=""
  [ "${#plan_stale_files[@]}" -gt 0 ] || return 0
  plan_stale_stat_output="$(git -C "$stale_worktree" diff --stat "$stale_base...origin/main" -- "${plan_stale_files[@]}" 2>"$tmp")" || return 1
}

# Emit only the path and symbol half of a plan's path::symbol citations.
collect_reanchor_citation() {
  case "$1" in
    path) REANCHOR_CITE_PATH="$2" ;;
    symbol)
      [ -n "${REANCHOR_CITE_PATH:-}" ] || return 0
      printf '%s\t%s\n' "$REANCHOR_CITE_PATH" "$2"
      ;;
  esac
}

plan_symbol_citations() {
  local plan_file="$1" section line new read files_entry token
  local CUR_SEC CUR_LN CUR_NEW CUR_READ CUR_FILES_ENTRY GLOBS REANCHOR_CITE_PATH
  GLOBS=""
  while IFS=$'\t' read -r section line new read files_entry token; do
    [ -n "$token" ] || continue
    CUR_SEC="$section"; CUR_LN="$line"; CUR_NEW="$new"; CUR_READ="$read"; CUR_FILES_ENTRY="$files_entry"
    REANCHOR_CITE_PATH=""
    expand_token "$token" collect_reanchor_citation
  done < <(plan_records "$plan_file" 1)
}

# Hash the plan without its Base line, so a verified plan can be compared with
# the same plan after only its base anchor changes.
plan_body_hash() {
  awk '!/^Base:[[:space:]]/' "$1" | git -C "$worktree" hash-object --stdin
}

plan_object_body_hash() {
  git -C "$worktree" cat-file blob "$1" | awk '!/^Base:[[:space:]]/' | git -C "$worktree" hash-object --stdin
}

# Extract a symbol's declaration/signature and brace-delimited body. The
# fallback retains matching lines for languages or declarations without a
# recognized block form, making the comparison conservative.
symbol_snapshot() {
  local revision="$1" path="$2" symbol="$3" name content snapshot
  name="${symbol##*::}"; name="${name%()}"
  content="$(git -C "$worktree" show "$revision:$path" 2>/dev/null)" || return 1
  snapshot="$(awk -v sym="$name" '
    function is_definition(line, decl) {
      decl = "(^|[^[:alnum:]_])(fn|func|struct|enum|trait|type|const|static|mod|def|function)[[:space:]]+" sym "([[:space:]<(;=]|$)"
      return line ~ decl || line ~ ("^[[:space:]]*" sym "[[:space:]]*\\(")
    }
    function has_single_quote_close(line, pos, j, ch, escaped) {
      escaped = 0
      for (j = pos + 1; j <= length(line) && j <= pos + 8; j++) {
        ch = substr(line, j, 1)
        if (escaped) { escaped = 0; continue }
        if (ch == "\\") { escaped = 1; continue }
        if (ch == sprintf("%c", 39)) return 1
      }
      return 0
    }
    function code_line(line, i, ch, nextch, out, j, n, single) {
      single = sprintf("%c", 39)
      out = ""
      for (i = 1; i <= length(line); i++) {
        ch = substr(line, i, 1)
        nextch = substr(line, i + 1, 1)
        if (block_comment) {
          if (ch == "*" && nextch == "/") { block_comment = 0; i++ }
          continue
        }
        if (quote == "raw") {
          if (ch == "\"") {
            j = i + 1; n = 0
            while (substr(line, j, 1) == "#") { n++; j++ }
            if (n == raw_hashes) { quote = ""; raw_hashes = 0; i = j - 1 }
          }
          continue
        }
        if (quote != "") {
          if (escaped) { escaped = 0; continue }
          if (ch == "\\") { escaped = 1; continue }
          if (triple_quote) {
            if (substr(line, i, 3) == quote quote quote) { quote = ""; triple_quote = 0; i += 2 }
          } else if (ch == quote) quote = ""
          continue
        }
        if (ch == "/" && nextch == "/") break
        if (ch == "/" && nextch == "*") { block_comment = 1; i++; continue }
        if (ch == "#" && nextch != "[" && (i == 1 || substr(line, i - 1, 1) ~ /[[:space:]]/)) break
        if (ch == "r") {
          j = i + 1; n = 0
          while (substr(line, j, 1) == "#") { n++; j++ }
          if (substr(line, j, 1) == "\"") { quote = "raw"; raw_hashes = n; i = j; continue }
        }
        if (ch == "\"" || ch == "`" || ch == single) {
          if (ch == single && !has_single_quote_close(line, i)) { out = out ch; continue }
          quote = ch
          if (substr(line, i, 3) == ch ch ch) { triple_quote = 1; i += 2 }
          else triple_quote = 0
          continue
        }
        out = out ch
      }
      if (quote != "" && quote != "raw" && !triple_quote) { quote = ""; escaped = 0 }
      return out
    }
    function brace_delta(line, rest, opens, closes) {
      rest = line; opens = gsub(/[{]/, "", rest)
      rest = line; closes = gsub(/[}]/, "", rest)
      return opens - closes
    }
    {
      code = code_line($0)
      if (!capture && is_definition(code)) { capture = 1; has_body = 0; depth = 0 }
      if (capture) {
        print
        if (index(code, "{")) has_body = 1
        if (has_body) {
          depth += brace_delta(code)
          if (depth <= 0) capture = 0
        } else if (code ~ /;/) capture = 0
      }
    }
  ' <<<"$content")"
  if [ -z "$snapshot" ]; then
    snapshot="$(grep -F -- "$name" <<<"$content" || true)"
  fi
  printf '%s' "$snapshot"
}

# Compare cited symbols from verified_base to the plan's current Base. The
# globals reanchor_has_citations, reanchor_changed_symbols and
# mechanical_reanchor describe the result; drift is set for changed symbols.
classify_reanchor() {
  local vbase old_hash old_verdict p citation_path symbol symbol_name old_tree new_tree
  local old_path new_path old_content new_content old_snapshot new_snapshot changed
  local dir="$worktree"
  reanchor_has_citations=0
  mechanical_reanchor=0
  drift=0
  reanchor_changed_symbols=()
  vbase="$(t get verified_base 2>/dev/null || true)"
  [ -n "$vbase" ] && [ "$vbase" != "$base" ] || return 0
  git -C "$worktree" merge-base --is-ancestor "$vbase" "$base" 2>/dev/null || return 0

  FILES="|"; GLOBS=""
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    case "$p" in *\**) GLOBS="$GLOBS$p"$'\n' ;; *) FILES="$FILES$p|" ;; esac
  done < <(plan_files_pathspecs "$plan")
  old_tree="$(git -C "$worktree" ls-tree -r --name-only "$vbase")"
  new_tree="$(git -C "$worktree" ls-tree -r --name-only "$base")"
  while IFS=$'\t' read -r citation_path symbol; do
    [ -n "$citation_path" ] || continue
    rev="$base"; tree="$new_tree"; resolve_path "$citation_path"
    new_path="$RES"; new_kind="$RES_KIND"
    rev="$vbase"; tree="$old_tree"; resolve_path "$citation_path"
    old_path="$RES"; old_kind="$RES_KIND"
    if [ -n "$new_path" ]; then p="$new_path"
    elif [ -n "$old_path" ]; then p="$old_path"
    else p="$citation_path"
    fi
    covered "$p" || continue
    reanchor_has_citations=1
    changed=0
    [ "$new_kind" = found ] && [ "$old_kind" = found ] || changed=1
    symbol_name="${symbol##*::}"
    symbol_name="${symbol_name%()}"
    if [ "$changed" -eq 0 ]; then
      old_content="$(git -C "$worktree" show "$vbase:$old_path" 2>/dev/null || true)"
      new_content="$(git -C "$worktree" show "$base:$new_path" 2>/dev/null || true)"
      if ! grep -Fq -- "$symbol_name" <<<"$old_content" || ! grep -Fq -- "$symbol_name" <<<"$new_content"; then
        changed=1
      else
        old_snapshot="$(symbol_snapshot "$vbase" "$old_path" "$symbol" || true)"
        new_snapshot="$(symbol_snapshot "$base" "$new_path" "$symbol" || true)"
        [ "$old_snapshot" = "$new_snapshot" ] || changed=1
      fi
    fi
    if [ "$changed" -eq 1 ]; then
      local already=0 item
      for item in ${reanchor_changed_symbols[@]+"${reanchor_changed_symbols[@]}"}; do [ "$item" = "$citation_path::$symbol" ] && already=1; done
      [ "$already" -eq 1 ] || reanchor_changed_symbols+=("$citation_path::$symbol")
    fi
  done < <(plan_symbol_citations "$plan")

  if reanchor_has_changed_symbols; then
    drift=1
    return 0
  fi
  [ "$reanchor_has_citations" -eq 1 ] || return 0
  old_hash="$(t get verified_plan_hash 2>/dev/null || true)"
  old_verdict="$(t get plan_verdict 2>/dev/null || true)"
  case "$old_verdict" in ok|triaged) ;; *) return 0 ;; esac
  [ -n "$old_hash" ] || return 0
  if old_body_hash="$(plan_object_body_hash "$old_hash" 2>/dev/null)" &&
     new_body_hash="$(plan_body_hash "$plan" 2>/dev/null)" &&
     [ "$old_body_hash" = "$new_body_hash" ]; then
    mechanical_reanchor=1
  fi
}

# During re-anchor review, plan-check diagnostics for a cited symbol that no
# longer resolves belong to the Verifier's drift review; unrelated findings
# remain blocking.
filter_reanchor_unresolved() {
  local input="$1" section=line findings="" unresolved_lines="" line item drop citation_path missing_path
  while IFS= read -r line; do
    case "$line" in
      "Findings:") section=findings; continue ;;
      "Unresolved symbols:") section=unresolved; continue ;;
    esac
    if [ "$section" = unresolved ]; then
      drop=0
      case "$line" in
        "missing symbol:"*)
          for item in ${reanchor_changed_symbols[@]+"${reanchor_changed_symbols[@]}"}; do
            case "$line" in *"$item"*) drop=1; break ;; esac
          done ;;
      esac
      [ "$drop" -eq 1 ] || unresolved_lines="${unresolved_lines}${line}"$'\n'
    else
      drop=0
      case "$line" in
        "missing path:"*)
          missing_path="${line#missing path: }"
          missing_path="${missing_path%% *}"
          for item in ${reanchor_changed_symbols[@]+"${reanchor_changed_symbols[@]}"}; do
            citation_path="${item%%::*}"
            [ "$missing_path" = "$citation_path" ] && { drop=1; break; }
          done ;;
      esac
      [ "$drop" -eq 1 ] || findings="${findings}${line}"$'\n'
    fi
  done <<<"$input"
  REANCHOR_FILTERED=""
  if [ -n "$unresolved_lines" ]; then
    if [ -n "$findings" ]; then REANCHOR_FILTERED="Findings:"$'\n'"$findings"; fi
    REANCHOR_FILTERED="${REANCHOR_FILTERED}Unresolved symbols:"$'\n'"$unresolved_lines"
  else
    REANCHOR_FILTERED="$findings"
  fi
}

unresolved_plan_lines() {
  awk '
    /^Unresolved symbols:[[:space:]]*$/ { in_unresolved = 1; next }
    /^Findings:[[:space:]]*$/ { in_unresolved = 0; next }
    in_unresolved && match($0, /plan line [0-9]+/) {
      token = substr($0, RSTART, RLENGTH)
      sub(/^plan line /, "", token)
      print token
    }
  ' <<<"$1" | sort -nu | paste -sd, -
}

record_unresolved_snapshot() {
  local output="$1" lines snapshot existing
  lines="$(unresolved_plan_lines "$output")"
  [ -n "$lines" ] || return 0
  existing="$(t get unresolved_plan_snapshot 2>/dev/null || true)"
  [ -n "$existing" ] && [ -r "$existing" ] && return 0
  snapshot="$(free_path "$run/$namebase-unresolved-plan.md")" || exit 3
  cp "$plan" "$snapshot" || { echo "tkt-plan: cannot save unresolved plan snapshot: $snapshot" >&2; exit 2; }
  t set unresolved_plan_snapshot "$snapshot"
  t set unresolved_plan_lines "$lines"
}

# True only when every changed old plan line was an unresolved-symbol line.
unresolved_plan_changed_only() {
  local snapshot lines diff_output diff_rc=0
  snapshot="$(t get unresolved_plan_snapshot 2>/dev/null || true)"
  lines="$(t get unresolved_plan_lines 2>/dev/null || true)"
  [ -n "$snapshot" ] && [ -r "$snapshot" ] && [ -n "$lines" ] || return 1
  diff_output="$(diff -U0 "$snapshot" "$plan")" || diff_rc=$?
  [ "$diff_rc" -eq 1 ] || return 1
  awk -v lines="$lines" '
    BEGIN {
      n = split(lines, a, ",")
      for (i = 1; i <= n; i++) unresolved[a[i]] = 1
    }
    /^@@ / {
      old = $2
      sub(/^-/, "", old)
      split(old, old_range, ",")
      old_start = old_range[1] + 0
      old_count = (old_range[2] == "" ? 1 : old_range[2] + 0)
      new = $3
      sub(/^\+/, "", new)
      split(new, new_range, ",")
      new_count = (new_range[2] == "" ? 1 : new_range[2] + 0)
      if (new_count != old_count || old_count == 0) bad = 1
      for (line = old_start; line < old_start + old_count; line++) if (!unresolved[line]) bad = 1
    }
    END { exit bad }
  ' <<<"$diff_output"
}

clear_unresolved_snapshot() {
  t set unresolved_plan_snapshot ""
  t set unresolved_plan_lines ""
}

# Fetch, issue-check and freshness-check a ruling comment. Callers map the
# failure kind to their own stable verdict tags and reasons.
check_ruling_comment() {
  local comment_id="$1" comment_json="$2" comment_error="$3"
  local stop_verdict_at plan_verdict_at ruling_after_verdict_at
  ruling_comment_failure=""
  if ! gh api "repos/$repo/issues/comments/$comment_id" >"$comment_json" 2>"$comment_error"; then
    rm -f "$comment_json" "$comment_error"
    ruling_comment_failure=fetch
    return 1
  fi
  if ! jq -e --arg repo "$repo" --arg issue "$issue" '
    type == "object" and (.body | type == "string")
      and (.issue_url | type == "string")
      and (.issue_url | contains("/repos/" + $repo + "/"))
      and (.issue_url | endswith("/issues/" + $issue))
  ' "$comment_json" >/dev/null 2>&1; then
    rm -f "$comment_json" "$comment_error"
    ruling_comment_failure=issue
    return 1
  fi
  stop_verdict_at="$(t get plan_stop_verdict_at 2>/dev/null || true)"
  plan_verdict_at="$(t get plan_verdict_at 2>/dev/null || true)"
  ruling_after_verdict_at="$stop_verdict_at"
  if [ -n "$plan_verdict_at" ] && { [ -z "$ruling_after_verdict_at" ] || [[ "$plan_verdict_at" > "$ruling_after_verdict_at" ]]; }; then
    ruling_after_verdict_at="$plan_verdict_at"
  fi
  if [ -z "$ruling_after_verdict_at" ] || ! jq -e --arg verdict_at "$ruling_after_verdict_at" '
    (.created_at | type == "string") and (.created_at > $verdict_at)
  ' "$comment_json" >/dev/null 2>&1; then
    rm -f "$comment_json" "$comment_error"
    ruling_comment_failure=time
    return 1
  fi
  return 0
}

record_plan_stop_verdict() {
  local kind="$1" stop_hash existing_hash existing_at
  stop_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
  stop_hash="$kind:$base:$stop_hash"
  existing_hash="$(t get plan_stop_verdict_key 2>/dev/null || true)"
  existing_at="$(t get plan_stop_verdict_at 2>/dev/null || true)"
  # ROUND-LIMIT reports a stop that already happened: keep any recorded time,
  # so a ruling posted after the LINES stop stays newer than it.
  if [ "$kind" = round-limit ] && [ -n "$existing_at" ]; then return 0; fi
  if [ "$existing_hash" != "$stop_hash" ] || [ -z "$existing_at" ]; then
    t set plan_stop_verdict_key "$stop_hash"
    t set plan_stop_verdict_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  fi
}

do_verify() {
  extra=""; model=""
  while [ $# -gt 0 ]; do case "$1" in
    --extra) [ $# -ge 2 ] || usage; extra="$2"; shift 2;;
    --model) [ $# -ge 2 ] || usage; model="$2"; shift 2;; *) usage;; esac; done
  load_plan
  unresolved_fix=0
  plan_stale_stat "$plan" "$base" "$worktree" || { cat "$tmp" >&2; exit 2; }
  if [ -n "$plan_stale_stat_output" ]; then
    n="$(git -C "$worktree" diff --name-only "$base...origin/main" -- "${plan_stale_files[@]}" | wc -l | tr -d ' ')"
    clear_verdict
    emit "STALE n=$n base=$base" 1 "$({ plan_bare_dirs "$plan" "$worktree"; head -n "$REPORT_LINES" <<<"$plan_stale_stat_output"; })"
  fi
  classify_reanchor
  pc_out="$("$plancheck" "$plan" --base "$base" --cwd "$worktree" 2>"$tmp")" && prc=0 || prc=$?
  [ "$prc" -ne 2 ] || { cat "$tmp" >&2; exit 2; }
  if [ "$prc" -eq 1 ] && reanchor_has_changed_symbols; then
    filter_reanchor_unresolved "$pc_out"
    pc_out="$REANCHOR_FILTERED"
    [ -z "$pc_out" ] && prc=0
  fi
  if [ "$prc" -eq 1 ]; then
    record_unresolved_snapshot "$pc_out"
    planner_job="$(t get job.planner 2>/dev/null || true)"
    if [ -n "$planner_job" ]; then
      resume_prompt="$(mktemp "$run/$namebase-plan-check-resume.XXXXXX")" || exit 2
      printf '%s\n' "$pc_out" >"$resume_prompt" || exit 2
      if "$tktjob" "$state" --slot planner --resume "$planner_job" --prompt "$resume_prompt" >"$tmp" 2>&1; then
        resume_rc=0
      else
        resume_rc=$?
      fi
      pc_out="$("$plancheck" "$plan" --base "$base" --cwd "$worktree" 2>"$tmp")" && prc=0 || prc=$?
      [ "$prc" -ne 2 ] || { cat "$tmp" >&2; exit 2; }
      if [ "$prc" -eq 1 ]; then record_unresolved_snapshot "$pc_out"; fi
      if [ "$prc" -eq 1 ] && reanchor_has_changed_symbols; then
        filter_reanchor_unresolved "$pc_out"
        pc_out="$REANCHOR_FILTERED"
        [ -z "$pc_out" ] && prc=0
      fi
      planner_note="planner job $planner_job resumed once (tkt-job exit=$resume_rc)"
    else
      planner_note="planner job not recorded in job.planner; not resumed"
    fi
    [ "$prc" -ne 1 ] || { record_unresolved_snapshot "$pc_out"; clear_verdict; emit "PLAN-CHECK report_lines=$(grep -c . <<<"$pc_out" || true)" 1 "$planner_note" "$(head -n "$REPORT_LINES" <<<"$pc_out")"; }
  fi
  if [ "$prc" -eq 0 ]; then
    if unresolved_plan_changed_only; then
      unresolved_fix=1
    else
      unresolved_snapshot="$(t get unresolved_plan_snapshot 2>/dev/null || true)"
      [ -z "$unresolved_snapshot" ] || clear_unresolved_snapshot
    fi
  fi
  questions="$(plan_open_questions "$plan")"
  if [ -n "$questions" ]; then
    question_hash="$(printf '%s\n' "$questions" | git -C "$worktree" hash-object --stdin 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
    recorded_hash="$(t get plan_questions_hash 2>/dev/null || true)"
    recorded_comment="$(t get plan_questions_comment 2>/dev/null || true)"
    if [ -z "$recorded_comment" ] || [ "$recorded_hash" != "$question_hash" ]; then
      clear_verdict
      plan_verdict_write "$tkt_state" "$state" questions "$base" "$plan" "$worktree"
      # Keep the first verdict time for an unchanged question list, so a rerun
      # verify does not push it past an answer already posted.
      if [ "$(t get plan_questions_verdict_hash 2>/dev/null || true)" != "$question_hash" ] \
        || [ -z "$(t get plan_questions_verdict_at 2>/dev/null || true)" ]; then
        t set plan_questions_verdict_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
        t set plan_questions_verdict_hash "$question_hash"
      fi
      emit "QUESTIONS" 1 "record one ticket comment answering every question with: tkt-plan $state rule-questions --comment <id>, then rerun verify" "## Open questions" "$questions"
    fi
  fi
  round="$(ronum)"
  classify_reanchor
  if [ "$mechanical_reanchor" -eq 1 ]; then
    plan_verdict_write "$tkt_state" "$state" ok "$base" "$plan" "$worktree"
    verified_plan_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
    t set verified_base "$base"
    t set verified_plan_hash "$verified_plan_hash"
    t set plan_stop_verdict_key ""
    t set plan_stop_verdict_at ""
    t set build_stale_recovery_base ""
    t set build_stale_recovery_plan_hash ""
    emit "REANCHORED base=$base" 0 "cited symbol bodies and signatures are unchanged; no Verifier round spent"
  fi
  # Re-anchor analysis and the task-scoped drift exemption are independent: a
  # cited plan whose body changed still receives the existing drift check.
  vbase="$(t get verified_base 2>/dev/null || true)"
  if [ -n "$vbase" ]; then
    tpaths=()
    while IFS= read -r p; do tpaths+=("$p"); done < <(plan_task_pathspecs "$plan" "$worktree" "$base")
    if [ "${#tpaths[@]}" -eq 0 ]; then
      while IFS= read -r p; do tpaths+=("$p"); done < <(plan_files_pathspecs "$plan")
    fi
    if [ "${#tpaths[@]}" -gt 0 ]; then
      if dstat="$(git -C "$worktree" diff --stat "$vbase...$base" -- "${tpaths[@]}" 2>/dev/null)"; then
        [ -n "$dstat" ] && drift=1
      fi
    fi
  fi
  # A build-phase STALE recovery carries a state marker tied to its new Base
  # and exact plan snapshot. Its stale check is Files-based, so those changed
  # Files paths remain exempt even when resolved Task paths omit them.
  if [ "$drift" -eq 0 ]; then
    recovery_base="$(t get build_stale_recovery_base 2>/dev/null || true)"
    recovery_plan_hash="$(t get build_stale_recovery_plan_hash 2>/dev/null || true)"
    if [ "$recovery_base" = "$base" ] && [ -n "$recovery_plan_hash" ] && [ -n "$vbase" ] && [ "$vbase" != "$base" ]; then
      current_plan_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
      if [ "$current_plan_hash" = "$recovery_plan_hash" ]; then
        recovery_files=()
        while IFS= read -r p; do recovery_files+=("$p"); done < <(plan_files_pathspecs "$plan")
        if [ "${#recovery_files[@]}" -gt 0 ]; then
          if recovery_stat="$(git -C "$worktree" diff --stat "$vbase...$base" -- "${recovery_files[@]}" 2>/dev/null)"; then
            [ -n "$recovery_stat" ] && drift=1
          fi
        fi
      fi
    fi
  fi
  if [ "$drift" -eq 0 ] && [ "$unresolved_fix" -eq 0 ]; then
    if [ -n "$(t get confirmed_for 2>/dev/null || true)" ]; then
      if grant_pending; then
        granted_by="$(t get granted_by 2>/dev/null || true)"
        granted_comment="$(t get granted_comment 2>/dev/null || true)"
        record_plan_stop_verdict round-limit
        emit "ROUND-LIMIT round=$round confirm=done" 1 "a grant is pending ($granted_by:$granted_comment); verify does not consume it: run tkt-plan $state confirm --edits <file>" "$(open_lines)"
      fi
      record_plan_stop_verdict round-limit
      emit "ROUND-LIMIT round=$round confirm=done" 1 "if another fully specified confirm is authorized, run tkt-plan $state grant-round --by <who> --comment <id>, then tkt-plan $state confirm --edits <file>; after a non-converging confirm, escalate to a flywheel or surveyor steward and, once its ruling comment is posted, run tkt-plan $state rule-ok --by <flywheel|surveyor> --ruling <RULING-id> --comment <id>; after triage answers every open line, run tkt-plan $state triaged --comment <id>" "$(open_lines)"
    fi
    [ "$round" -lt 2 ] || { record_plan_stop_verdict round-limit; emit "ROUND-LIMIT round=$round" 1 "two Verifier rounds ran with no confirm; run tkt-plan $state confirm --edits <file>, or after triage answers every open line run tkt-plan $state triaged --comment <id>" "$(open_lines)"; }
  fi
  clear_verdict
  model="$(vmodel "$model")" || exit 2
  args=(PLAN="$plan" BASE="$base" --model "$model")
  if [ "$drift" -eq 1 ]; then
    slot="verifier-r$((round + 1))-drift"
    rep="$(free_path "$run/$namebase-verifier-out-r$((round + 1))-drift.md")" || exit 3
    xfile="$run/$namebase-verifier-extra-r$((round + 1))-drift.md"
  elif [ "$unresolved_fix" -eq 1 ]; then
    slot="verifier-r$((round + 1))-unresolved"
    rep="$(free_path "$run/$namebase-verifier-out-r$((round + 1))-unresolved.md")" || exit 3
    xfile="$run/$namebase-verifier-extra-r$((round + 1))-unresolved.md"
  else
    slot="verifier-r$((round + 1))"
    rep="$(free_path "$run/$namebase-verifier-out-r$((round + 1)).md")" || exit 3
    xfile="$run/$namebase-verifier-extra-r$((round + 1)).md"
  fi
  # --extra wins over state extra; the ticket text goes before either.
  [ -n "$extra" ] || extra="$(t get extra 2>/dev/null || true)"
  ticket_extra "$xfile" "$extra"
  reanchor_note=""
  if reanchor_has_changed_symbols; then
    verified_plan_hash="$(t get verified_plan_hash 2>/dev/null || true)"
    if [ -n "$verified_plan_hash" ] \
      && verified_body_hash="$(plan_object_body_hash "$verified_plan_hash" 2>/dev/null)" \
      && current_body_hash="$(plan_body_hash "$plan" 2>/dev/null)" \
      && [ "$verified_body_hash" = "$current_body_hash" ]; then
      reanchor_note="Re-anchor review is limited to these cited symbols: $(format_reanchor_symbols). Check only whether their signature/body changed or they no longer resolve; do not reopen other plan claims."
      printf '\n## Mechanical re-anchor\n%s\n' "$reanchor_note" >>"$xfile"
    fi
  fi
  printf '\nWhen the plan passes, the report must start with this exact first line, with nothing before or after it on that line:\n\nPLAN OK\n' >>"$xfile"
  args+=(EXTRA="@$xfile")
  # A failed round leaves its job id behind while the round counter stays
  # put; without this reset the next verify would only re-watch the old job.
  t set "job.$slot" ""
  runjob "$slot" "$vbrief" "$rep" "${args[@]}"
  if [ "$REC" -eq 0 ]; then verdict=ok; else verdict=lines; fi
  plan_verdict_write "$tkt_state" "$state" "$verdict" "$base" "$plan" "$worktree"
  verified_plan_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
  # A verify that reaches a report records its base and plan snapshot; a failed
  # or asking job leaves the prior state so the retry stays exempt.
  t set verified_base "$base"
  t set verified_plan_hash "$verified_plan_hash"
  if [ "$unresolved_fix" -eq 1 ]; then clear_unresolved_snapshot; fi
  if [ "$drift" -eq 0 ] && [ "$unresolved_fix" -eq 0 ]; then
    t set verifier_round "$((round + 1))"
  fi
  if [ "$REC" -eq 1 ]; then
    record_plan_stop_verdict lines
  else
    t set plan_stop_verdict_key ""
    t set plan_stop_verdict_at ""
  fi
  t set build_stale_recovery_base ""
  t set build_stale_recovery_plan_hash ""
  t set last_report "$rep"
  if [ -n "$reanchor_note" ]; then
    emit "$RV" "$REC" "$reanchor_note" "$(head -n "$REPORT_LINES" "$rep")"
  fi
  emit "$RV" "$REC" "$(head -n "$REPORT_LINES" "$rep")"
}

do_confirm() {
  edits=""
  while [ $# -gt 0 ]; do case "$1" in
    --edits) [ $# -ge 2 ] || usage; edits="$2"; shift 2;; *) usage;; esac; done
  [ -n "$edits" ] || usage; [ -r "$edits" ] || { echo "tkt-plan: cannot read edits file: $edits" >&2; exit 2; }
  load_plan
  latest_edits=""
  for candidate in "$run/$namebase"-confirm-edits*.md; do
    [ -f "$candidate" ] || continue
    if [ -z "$latest_edits" ] || [ "$candidate" -nt "$latest_edits" ]; then latest_edits="$candidate"; fi
  done
  staleness_check="none (no confirm-edits file)"
  if [ -n "$latest_edits" ]; then
    verified_plan_hash="$(t get verified_plan_hash 2>/dev/null || true)"
    stale_confirm=0
    if [ -n "$verified_plan_hash" ]; then
      staleness_check=hash
      plan_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
      [ "$plan_hash" = "$verified_plan_hash" ] && stale_confirm=1
    else
      staleness_check="skipped (no verified_plan_hash)"
    fi
    if [ "$stale_confirm" -eq 1 ]; then
      emit "STALE-CONFIRM edits=$latest_edits plan=$plan" 1 "staleness-check: $staleness_check" "apply edits from $latest_edits to $plan, then rerun: tkt-plan $state confirm --edits $latest_edits"
    fi
  fi
  confirmed_for="$(t get confirmed_for 2>/dev/null || true)"
  granted=0
  confirm_limited=0
  reconfirm_free=0
  if [ -n "$confirmed_for" ]; then
    if grant_pending; then
      granted=1
    else
      reconfirm_used="$(t get confirm_reconfirm_used 2>/dev/null || true)"
      last_confirm_report="$(t get last_confirm_report 2>/dev/null || true)"
      if [ -z "$last_confirm_report" ]; then
        last_confirm_report="$(t get last_report 2>/dev/null || true)"
        case "$last_confirm_report" in *-confirm-out*.md) ;; *) last_confirm_report="";; esac
      fi
      if [ "$reconfirm_used" != 1 ] && [ -n "$latest_edits" ] && [ -n "$last_confirm_report" ] && [ -f "$last_confirm_report" ] && [ "$latest_edits" -nt "$last_confirm_report" ]; then
        reconfirm_free=1
      else
        confirm_limited=1
      fi
    fi
  fi
  pc_out="$("$plancheck" "$plan" --base "$base" --cwd "$worktree" 2>"$tmp")" && prc=0 || prc=$?
  [ "$prc" -ne 2 ] || { cat "$tmp" >&2; exit 2; }
  if [ "$prc" -eq 1 ]; then
    record_unresolved_snapshot "$pc_out"
    case "$pc_out" in
      *"Unresolved symbols:"*)
        emit "PLAN-CHECK report_lines=$(grep -c . <<<"$pc_out" || true)" 1 "staleness-check: $staleness_check" "$(head -n "$REPORT_LINES" <<<"$pc_out")" ;;
    esac
  else
    if unresolved_plan_changed_only; then
      emit "UNRESOLVED-FIX" 0 "only lines previously reported as unresolved symbols changed; rerun tkt-plan $state verify; no confirm round spent"
    fi
    unresolved_snapshot="$(t get unresolved_plan_snapshot 2>/dev/null || true)"
    [ -z "$unresolved_snapshot" ] || clear_unresolved_snapshot
  fi
  if [ "$confirm_limited" -eq 1 ]; then
    emit "ROUND-LIMIT confirm=done" 1 "staleness-check: $staleness_check" "if another fully specified confirm is authorized, run tkt-plan $state grant-round --by <who> --comment <id>, then tkt-plan $state confirm --edits <file>; after a non-converging confirm, escalate to a flywheel or surveyor steward and, once its ruling comment is posted, run tkt-plan $state rule-ok --by <flywheel|surveyor> --ruling <RULING-id> --comment <id>; after triage answers every open line, run tkt-plan $state triaged --comment <id>" "$(open_lines)"
  fi
  [ "$prc" -ne 1 ] || emit "PLAN-CHECK report_lines=$(grep -c . <<<"$pc_out" || true)" 1 "staleness-check: $staleness_check" "$(head -n "$REPORT_LINES" <<<"$pc_out")"
  cmodel="$(vmodel)" || exit 2
  rep="$(free_path "$run/$namebase-confirm-out.md")" || exit 3
  xfile="$run/$namebase-confirm-extra.md"
  # Confirm has no --extra flag: the state extra, if any, follows the ticket text.
  ticket_extra "$xfile" "$(t get extra 2>/dev/null || true)"
  if [ "$granted" -eq 1 ]; then
    t set job.confirm ""
  else
    confirm_job="$(t get job.confirm 2>/dev/null || true)"
    if [ -n "$confirm_job" ]; then
      confirm_record="$(bash "$script_dir/job-record" "$confirm_job" 2>/dev/null || true)"
      if [ -n "$confirm_record" ]; then
        confirm_status="$(jq -r '.result.status // .status // ""' "$confirm_record" 2>/dev/null || true)"
        if [ -n "$confirm_status" ] && [ "$confirm_status" != RUNNING ]; then
          t set job.confirm ""
        fi
      fi
    fi
  fi
  runjob confirm "$cbrief" "$rep" PLAN="$plan" BASE="$base" EDITS="@$edits" EXTRA="@$xfile" --model "$cmodel"
  if [ "$REC" -eq 0 ]; then verdict=ok; else verdict=lines; fi
  plan_verdict_write "$tkt_state" "$state" "$verdict" "$base" "$plan" "$worktree"
  t set plan_triage_comment ""
  if [ "$granted" -eq 1 ]; then t set granted_used 1; fi
  if [ "$reconfirm_free" -eq 1 ]; then t set confirm_reconfirm_used 1; fi
  t set last_report "$rep"
  t set last_confirm_report "$rep"
  t set confirmed_for "$(ronum)"
  emit "$RV" "$REC" "staleness-check: $staleness_check" "$(head -n "$REPORT_LINES" "$rep")"
}

do_grant() {
  who=""; comment=""; ruling=""; via=""
  while [ $# -gt 0 ]; do case "$1" in
    --by) [ $# -ge 2 ] || usage; who="$2"; shift 2;;
    --comment) [ $# -ge 2 ] || usage; comment="$2"; shift 2;;
    --ruling) [ $# -ge 2 ] && [ -n "$2" ] || usage; ruling="$2"; via="ruling"; shift 2;;
    *) usage;; esac; done
  [ -n "$who" ] && [ -n "$comment" ] || usage
  case "$who$comment$ruling" in *[[:space:]]*) usage;; esac
  confirmed_for="$(t get confirmed_for 2>/dev/null || true)"
  [ -n "$confirmed_for" ] || { echo "tkt-plan: no limit reached: the confirm round is still open; rerun: tkt-plan $state confirm --edits <file>" >&2; exit 2; }
  granted_by="$(t get granted_by 2>/dev/null || true)"
  granted_used="$(t get granted_used 2>/dev/null || true)"
  if [ -n "$granted_by" ] && [ -z "$granted_used" ]; then
    pending_comment="$(t get granted_comment 2>/dev/null || true)"
    echo "tkt-plan: grant already pending: $granted_by:$pending_comment" >&2
    exit 2
  fi
  if [ -n "$granted_by" ] && [ -z "$ruling" ]; then
    recorded_comment="$(t get granted_comment 2>/dev/null || true)"
    echo "tkt-plan: grant already recorded: $granted_by:$recorded_comment: a later grant needs a ruling: use --ruling <comment id>" >&2
    exit 2
  fi
  grant_count="$(t list grant 2>/dev/null | grep -c . || true)"
  case "$grant_count" in ''|*[!0-9]*) grant_count=0;; esac
  case "$confirmed_for" in ''|*[!0-9]*) confirmed_for=0;; esac
  grant_round=$((confirmed_for + grant_count + 1))
  t set granted_by "$who"
  t set granted_comment "$comment"
  t set granted_used ""
  t add grant "round=$grant_round by=$who via=$via comment=$comment ruling=$ruling"
  emit "SET grant=$who:$comment" 0 "next: tkt-plan $state confirm --edits <file>"
}

do_rule_ok() {
  who=""; ruling=""; comment=""
  while [ $# -gt 0 ]; do case "$1" in
    --by) [ $# -ge 2 ] || usage; who="$2"; shift 2;;
    --ruling) [ $# -ge 2 ] || usage; ruling="$2"; shift 2;;
    --comment) [ $# -ge 2 ] || usage; comment="$2"; shift 2;;
    *) usage;; esac; done
  case "$who" in
    flywheel|surveyor) ;;
    *) emit "RULE-OK-REFUSED reason=steward" 1 "--by must be flywheel or surveyor" ;;
  esac
  case "$ruling" in
    ""|*[[:space:]]*) emit "RULE-OK-REFUSED reason=ruling-id" 1 "--ruling must be a non-empty id without whitespace" ;;
  esac
  case "$comment" in
    ""|*[!0-9]*) emit "RULE-OK-REFUSED reason=comment-id" 1 "comment id must contain only digits" ;;
  esac

  plan="$(t get plan 2>/dev/null || true)"
  [ -n "$plan" ] && [ -r "$plan" ] || emit "RULE-OK-REFUSED reason=plan" 1 "no readable plan is recorded in state $state"
  base="$(plan_base "$plan")"
  [ -n "$base" ] || emit "RULE-OK-REFUSED reason=plan" 1 "plan $plan has no Base line"
  plan_verdict_read "$tkt_state" "$state" "$plan" "$worktree"
  [ "$plan_verdict" != ok ] || emit "RULE-OK-REFUSED reason=already-ok" 1 "the current plan already has plan_verdict ok"

  ferr="$(git -C "$worktree" fetch -q origin main 2>&1)" || emit "RULE-OK-REFUSED reason=stale-check" 1 "could not compare plan Files against origin/main" "$(head -n 1 <<<"$ferr")"
  if ! plan_stale_stat "$plan" "$base" "$worktree"; then
    emit "RULE-OK-REFUSED reason=stale-check" 1 "could not compare plan Files against origin/main" "$(head -n 1 "$tmp" 2>/dev/null || true)"
  fi
  if [ -n "$plan_stale_stat_output" ]; then
    emit "RULE-OK-REFUSED reason=stale" 1 "$plan_stale_stat_output" "run implement's stale-plan check, revise the plan, then tkt-plan $state set $plan, then rerun: tkt-plan $state rule-ok --by $who --ruling $ruling --comment $comment"
  fi

  comment_json="$tmp.rule-ok-comment.json"
  comment_error="$tmp.rule-ok-comment-error"
  if ! check_ruling_comment "$comment" "$comment_json" "$comment_error"; then
    case "$ruling_comment_failure" in
      fetch) emit "RULE-OK-REFUSED reason=comment-fetch" 1 "could not verify that comment $comment belongs to $repo#$issue" ;;
      issue) emit "RULE-OK-REFUSED reason=comment-issue" 1 "comment $comment is not on $repo#$issue" ;;
      time) emit "RULE-OK-REFUSED reason=comment-time" 1 "comment $comment does not postdate the latest plan or stop verdict" ;;
    esac
  fi
  if ! jq -e --arg ruling "$ruling" '.body | contains($ruling)' "$comment_json" >/dev/null 2>&1; then
    rm -f "$comment_json" "$comment_error"
    emit "RULE-OK-REFUSED reason=ruling-missing" 1 "comment $comment does not contain ruling id $ruling"
  fi
  rm -f "$comment_json" "$comment_error"

  plan_verdict_write "$tkt_state" "$state" ok "$base" "$plan" "$worktree"
  t set plan_verdict_by "$who"
  t set plan_verdict_ruling "$ruling"
  t set plan_verdict_comment "$comment"
  t journal "tkt-plan rule-ok by=$who ruling=$ruling comment=$comment"
  emit "RULE-OK by=$who ruling=$ruling comment=$comment" 0 "next: tkt-build $state"
}

do_triaged() {
  comment=""
  while [ $# -gt 0 ]; do case "$1" in
    --comment) [ $# -ge 2 ] || usage; comment="$2"; shift 2;;
    *) usage;; esac; done
  case "$comment" in
    ""|*[!0-9]*) echo "tkt-plan: comment id must contain only digits" >&2; exit 2;;
  esac
  load_plan
  comment_json="$tmp.triaged-comment.json"
  comment_error="$tmp.triaged-comment-error"
  if ! check_ruling_comment "$comment" "$comment_json" "$comment_error"; then
    case "$ruling_comment_failure" in
      fetch) emit "TRIAGED-REFUSED reason=ruling-source issue=$issue" 1 "could not verify that comment $comment belongs to $repo#$issue" ;;
      issue) emit "TRIAGED-REFUSED reason=ruling-source issue=$issue" 1 "comment $comment is not on $repo#$issue" ;;
      time) emit "TRIAGED-REFUSED reason=ruling-stale" 1 "comment $comment does not postdate the latest plan verdict" ;;
    esac
  fi
  round="$(ronum)"
  stored_verdict="$(t get plan_verdict 2>/dev/null || true)"
  stored_hash="$(t get plan_verdict_hash 2>/dev/null || true)"
  stored_base="$(t get plan_verdict_base 2>/dev/null || true)"
  current_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
  confirmed_for="$(t get confirmed_for 2>/dev/null || true)"
  ruling_revision=0
  accepted_diff=""

  if [ "$stored_verdict" = lines ] && [ -z "$stored_hash" ]; then
    emit "TRIAGED-REFUSED reason=snapshot-missing" 1 "the LINES verdict has no saved plan snapshot; run one Verifier pass: tkt-plan $state verify"
  fi
  if [ -n "$stored_hash" ] && [ "$stored_hash" != "$current_hash" ]; then
    case "$stored_hash" in *[!0123456789abcdefABCDEF]*) emit "TRIAGED-REFUSED reason=snapshot-missing" 1 "the saved plan snapshot is unavailable; run one Verifier pass: tkt-plan $state verify";; esac
    snapshot_file="$tmp.snapshot"
    before_rest="$tmp.before-rest"
    after_rest="$tmp.after-rest"
    before_rulings="$tmp.before-rulings"
    after_rulings="$tmp.after-rulings"
    raw_diff="$tmp.diff"
    outside_diff="$tmp.outside-diff"
    comment_body="$tmp.comment-body"
    normalized_comment="$tmp.comment-normalized"
    if ! git -C "$worktree" cat-file blob "$stored_hash" >"$snapshot_file" 2>/dev/null; then
      rm -f "$snapshot_file"
      emit "TRIAGED-REFUSED reason=snapshot-missing" 1 "the saved plan snapshot is unavailable; run one Verifier pass: tkt-plan $state verify"
    fi
    plan_without_rulings "$snapshot_file" >"$before_rest" || exit 2
    plan_without_rulings "$plan" >"$after_rest" || exit 2
    after_has_rulings=0
    if plan_rulings_section "$snapshot_file" >"$before_rulings"; then :; fi
    if plan_rulings_section "$plan" >"$after_rulings"; then after_has_rulings=1; fi
    diff_rc=0
    if diff -u "$snapshot_file" "$plan" >"$raw_diff"; then :; else diff_rc=$?; fi
    [ "$diff_rc" -le 1 ] || { rm -f "$snapshot_file" "$before_rest" "$after_rest" "$before_rulings" "$after_rulings" "$raw_diff"; exit 2; }
    diff_file="$(mktemp "$run/$namebase-ruling-diff.XXXXXX")" || exit 2
    {
      printf 'Plan diff after verdict %s (stored Base %s; current Base %s).\n' "$stored_hash" "${stored_base:-none}" "$base"
      printf '%s\n' "--- plan at verdict $stored_hash" "+++ current plan $plan"
      tail -n +3 "$raw_diff"
    } >"$diff_file" || { rm -f "$snapshot_file" "$before_rest" "$after_rest" "$before_rulings" "$after_rulings" "$raw_diff" "$diff_file"; exit 2; }

    if [ "$stored_base" = "$base" ] && [ "$after_has_rulings" -eq 1 ] && cmp -s "$before_rest" "$after_rest" && ! cmp -s "$before_rulings" "$after_rulings"; then
      ruling_revision=1
    elif [ "$stored_base" = "$base" ] && ! cmp -s "$before_rest" "$after_rest"; then
      # Any edit within Files, Gate or Tasks still needs a Verifier, even if quoted.
      protected_section_changed=0
      if ! cmp -s <(plan_protected_sections "$snapshot_file") <(plan_protected_sections "$plan"); then
        protected_section_changed=1
      fi
      diff_rc=0
      if diff -u "$before_rest" "$after_rest" >"$outside_diff"; then :; else diff_rc=$?; fi
      [ "$diff_rc" -le 1 ] || { rm -f "$snapshot_file" "$before_rest" "$after_rest" "$before_rulings" "$after_rulings" "$raw_diff" "$outside_diff" "$diff_file"; exit 2; }
      jq -r '.body' "$comment_json" >"$comment_body" || { rm -f "$snapshot_file" "$before_rest" "$after_rest" "$before_rulings" "$after_rulings" "$raw_diff" "$outside_diff" "$comment_json" "$comment_body" "$comment_error" "$diff_file"; exit 2; }
      normalize_ruling_lines <"$comment_body" >"$normalized_comment"
      first_unmatched=""
      while IFS= read -r changed_line; do
        normalized_line="$(printf '%s\n' "$changed_line" | normalize_ruling_lines)"
        [ -n "$normalized_line" ] || continue
        if ! grep -Fqx -- "$normalized_line" "$normalized_comment"; then
          first_unmatched="$changed_line"
          break
        fi
      done < <(awk 'NR <= 2 && /^(---|\+\+\+)/ { next } /^[+-]/ { print substr($0, 2) }' "$outside_diff")
      if [ -z "$first_unmatched" ] && [ "$protected_section_changed" -eq 0 ]; then
        ruling_revision=1
        accepted_diff="$diff_file"
      fi
    fi
    if [ "$ruling_revision" -ne 1 ]; then
      if [ "$round" -ge 2 ] || [ -n "$confirmed_for" ]; then
        printf -v repair_command 'run tkt-plan %q grant-round --by %s --comment %s, then tkt-plan %q confirm --edits %q' "$state" '<who>' '<id>' "$state" "$diff_file"
        repair_line="$repair_command"
      else
        printf -v verify_command 'tkt-plan %q verify --extra %q' "$state" "$diff_file"
        repair_line="run one scoped Verifier pass: $verify_command"
      fi
      refusal_details=("$repair_line" "EXTRA diff: $diff_file")
      [ -z "${first_unmatched:-}" ] || refusal_details+=("first unmatched line: $first_unmatched")
      rm -f "$snapshot_file" "$before_rest" "$after_rest" "$before_rulings" "$after_rulings" "$raw_diff" "$outside_diff" "$comment_json" "$comment_body" "$normalized_comment" "$comment_error"
      emit "TRIAGED-REFUSED reason=plan-changed" 1 "${refusal_details[@]}"
    fi
    rm -f "$snapshot_file" "$before_rest" "$after_rest" "$before_rulings" "$after_rulings" "$raw_diff" "$outside_diff" "$comment_json" "$comment_body" "$normalized_comment" "$comment_error"
  fi

  if [ -z "$confirmed_for" ] && [ "$round" -lt 2 ]; then
    if [ "$ruling_revision" -eq 1 ]; then
      case "$stored_verdict" in lines|ok) ;; *) emit "TRIAGED-REFUSED reason=rounds-open" 1;; esac
    else
      plan_verdict_read "$tkt_state" "$state" "$plan" "$worktree"
      [ "$plan_verdict" = lines ] || emit "TRIAGED-REFUSED reason=rounds-open" 1
    fi
  fi
  plan_verdict_write "$tkt_state" "$state" triaged "$base" "$plan" "$worktree"
  t set plan_triage_comment "$comment"
  [ -z "$accepted_diff" ] || emit "SET triaged=$comment plan-diff=$accepted_diff" 0
  emit "SET triaged=$comment" 0
}

do_rule_questions() {
  comment=""
  while [ $# -gt 0 ]; do case "$1" in
    --comment) [ $# -ge 2 ] || usage; comment="$2"; shift 2;;
    *) usage;; esac; done
  case "$comment" in
    ""|*[!0-9]*) echo "tkt-plan: comment id must contain only digits" >&2; exit 2;;
  esac
  load_plan
  questions="$(plan_open_questions "$plan")"
  [ -n "$questions" ] || emit "QUESTIONS-REFUSED reason=none" 1 "the plan has no open questions"
  comment_json="$(gh api "repos/$repo/issues/comments/$comment" 2>"$tmp")" || {
    comment_error="$(head -n 1 "$tmp" 2>/dev/null || true)"
    emit "QUESTIONS-REFUSED reason=comment" 1 "could not read ruling comment $comment${comment_error:+: $comment_error}"
  }
  if ! jq -e --arg repo "$repo" --arg issue "$issue" '
    type == "object" and (.body | type == "string") and (.body | test("[^[:space:]]"))
      and (.issue_url | type == "string")
      and (.issue_url | contains("/repos/" + $repo + "/"))
      and (.issue_url | endswith("/issues/" + $issue))
      and (.created_at | type == "string")
  ' <<<"$comment_json" >/dev/null 2>&1; then
    emit "QUESTIONS-REFUSED reason=comment" 1 "comment $comment is empty or does not belong to $repo#$issue"
  fi
  question_verdict_at="$(t get plan_questions_verdict_at 2>/dev/null || true)"
  if [ -z "$question_verdict_at" ] || ! jq -e --arg verdict_at "$question_verdict_at" '
    .created_at > $verdict_at
  ' <<<"$comment_json" >/dev/null 2>&1; then
    emit "QUESTIONS-REFUSED reason=comment-time" 1 "comment $comment predates the QUESTIONS verdict"
  fi
  question_hash="$(printf '%s\n' "$questions" | git -C "$worktree" hash-object --stdin 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
  plan_verdict_write "$tkt_state" "$state" questions "$base" "$plan" "$worktree"
  t set plan_questions_comment "$comment"
  t set plan_questions_hash "$question_hash"
  emit "QUESTIONS-RECORDED comment=$comment" 0 "next: tkt-plan $state verify"
}

do_post() {
  part=""; no_verifier=0
  while [ $# -gt 0 ]; do case "$1" in
    --part) [ $# -ge 2 ] || usage; part="$2"; shift 2;;
    --no-verifier) no_verifier=1; shift;;
    *) usage;; esac; done
  load_plan
  # Default the label from the state. An unlabelled post reuses this script's
  # own unlabelled comments oldest-first and deletes each leftover, so running
  # `post` on a part-2 state without --part overwrites part 1's posted plan in
  # place — and deletes a comment if part 1 was longer. fiber #4078 hit exactly
  # that: part=2 in the state, post without the flag, and comment 6605844496
  # stopped holding the Part 1 plan. The state knows the part; use it.
  if [ -z "$part" ]; then
    sp="$(t get part 2>/dev/null || true)"
    case "$sp" in
      ''|1) ;;
      *[!0-9]*) echo "tkt-plan: state part='$sp' is not a number; pass --part <label> explicitly" >&2; exit 2 ;;
      *) part="P$sp"; echo "tkt-plan: --part not given; using P$sp from the state's part=$sp" >&2 ;;
    esac
  fi
  files=()
  while IFS= read -r p; do files+=("$p"); done < <(plan_files_pathspecs "$plan")
  if ! plan_verdict_check build "$tkt_state" "$state" "$no_verifier" "$plan" "$base" "$worktree" ${files[@]+"${files[@]}"}; then emit "POST-FAIL reason=verdict verdict=$verdict_refusal" 1 "$verdict_digest"; fi
  "$plangate" ${gate_args[@]+"${gate_args[@]}"} "$plan" >"$tmp" 2>&1 || emit "POST-FAIL reason=gate" 1 "$(head -n 10 "$tmp")"
  post_run_id="$(t get post_run 2>/dev/null || true)"
  if [ -z "$post_run_id" ]; then
    post_run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
    t set post_run "$post_run_id"
  fi
  [[ "$post_run_id" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "tkt-plan: invalid post_run state id" >&2; exit 2; }
  pargs=(--run "$post_run_id"); [ -z "$part" ] || pargs+=(--part "$part")
  urls="$("$postplan" "$issue" "$plan" --repo "$repo" "${pargs[@]}" 2>"$tmp")" || emit "POST-FAIL reason=post" "$?" "$(head -n 10 "$tmp")"
  emit "POSTED urls=$(tr '\n' ',' <<<"$urls" | sed 's/,$//')" 0 "$urls"
}

do_set() {
  [ $# -ge 1 ] || usage
  plan_arg="$1"; shift; no_verifier=0
  if [ $# -gt 0 ]; then [ "$#" -eq 1 ] && [ "$1" = --no-verifier ] || usage; no_verifier=1; fi
  case "$plan_arg" in /*) plan="$plan_arg" ;; *) plan="$PWD/$plan_arg" ;; esac
  [ -r "$plan" ] || { echo "tkt-plan: cannot read plan file: $plan" >&2; exit 2; }
  base="$(base_of "$plan")"
  # A set with gate.script checks the Gate line before any state write.
  if [ -n "$gate_script" ]; then
    "$plangate" ${gate_args[@]+"${gate_args[@]}"} "$plan" >"$tmp" 2>&1 || emit "SET-FAIL reason=gate" 1 "$(head -n 10 "$tmp")"
  fi
  pack_out="$run/$namebase-pack.md"
  old_plan="$(t get plan 2>/dev/null || true)"
  plan_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmp")" || { cat "$tmp" >&2; exit 2; }
  stored_pack_plan_hash="$(t get pack_plan_hash 2>/dev/null || true)"
  stored_pack="$(t get pack 2>/dev/null || true)"
  if [ "$old_plan" = "$plan" ] && [ "$stored_pack_plan_hash" = "$plan_hash" ] && [ "$stored_pack" = "$pack_out" ] && [ -f "$stored_pack" ] && [ -s "$stored_pack" ]; then
    pack="$stored_pack"
  else
    sweep_out="$("$plansweep" --cwd "$worktree" --base "$base" --plan "$plan" --out "$pack_out")" || { printf '%s\n' "$sweep_out" >&2; exit 2; }
    pack="$(awk '/^PACK /{print $2; exit}' <<<"$sweep_out")"; [ -n "$pack" ] || { echo "tkt-plan: plan-sweep printed no PACK line" >&2; exit 2; }
  fi
  t set plan "$plan"; t set pack "$pack"
  # Re-setting the same plan keeps the job slots. A new path clears the
  # plan-specific verdicts, job slots, last report and pack hash. Either way the
  # planning counters (verifier_round, confirmed_for, grants) carry over: a new
  # path does not reset the planning budget. A later part of a split gets a
  # fresh budget from tkt-start --part <n>, not from a new path.
  if [ "$old_plan" != "$plan" ]; then
    clear_verdict
    t set plan_stop_verdict_key ""; t set plan_stop_verdict_at ""
    t set build_stale_recovery_base ""; t set build_stale_recovery_plan_hash ""
    t set plan_questions_comment ""; t set plan_questions_hash ""; t set plan_questions_verdict_at ""; t set plan_questions_verdict_hash ""
    t set verified_base ""; t set verified_plan_hash ""
    t set pack_plan_hash ""; t set last_report ""
    for s in verifier-r1 verifier-r2 confirm lane fix1 fix2 fix3; do t set "job.$s" ""; done
  fi
  t set pack_plan_hash "$plan_hash"
  plan_verdict_read "$tkt_state" "$state" "$plan" "$worktree"
  if [ "$old_plan" = "$plan" ] && [ "$no_verifier" -eq 0 ] && [ "$plan_verdict" = skipped ]; then
    clear_verdict
  fi
  if [ "$no_verifier" -eq 1 ] && { [ -z "$plan_verdict" ] || [ "$plan_verdict" = skipped ]; }; then
    plan_verdict_write "$tkt_state" "$state" skipped "$base" "$plan" "$worktree"
  fi
  emit "SET plan=$plan" 0 "plan=$plan" "pack=$pack"
}

do_replan() {
  [ $# -eq 0 ] || usage
  # A re-plan has a plan, so a missing key is a usage error before any write.
  plan_key="$(t get plan 2>/dev/null || true)"
  if [ -z "$plan_key" ]; then echo "tkt-plan: missing key: plan" >&2; exit 2; fi
  # Preserve PLAN-OK only for the exact plan snapshot that was checked. The
  # shared reader blanks a hash-mismatched verdict; a missing/unreadable hash
  # is not a match either, so clear the stored triple in both cases.
  plan="$plan_key"
  plan_verdict_read "$tkt_state" "$state" "$plan" "$worktree"
  if [ -z "$plan_verdict_file_hash" ] || [ "$plan_verdict_hash" != "$plan_verdict_file_hash" ]; then
    clear_verdict
  fi
  # Job slots and findings first, round last: a half-done replan leaves
  # round non-empty and tkt-build refuses loudly instead of reusing a stale slot.
  # The verdict triple is the one plan-specific record tkt-build needs; the
  # verifier snapshot, pack hash and triage comment are not part of PLAN-OK.
  t set verified_plan_hash ""
  t set pack_plan_hash ""
  t set plan_stop_verdict_key ""
  t set plan_stop_verdict_at ""
  t set build_stale_recovery_base ""
  t set build_stale_recovery_plan_hash ""
  t set plan_triage_comment ""
  t set job.lane ""
  t set job.fix1 ""
  t set job.fix2 ""
  t set job.fix3 ""
  t set job.preflight ""
  t set findings ""
  t set reviewed ""
  t set review_status ""
  t set round ""
  emit "REPLAN cleared=round,job.lane,job.fix1,job.fix2,job.fix3,job.preflight,findings,reviewed,review_status" 0
}

case "$sub" in
  verify) do_verify "$@";; confirm) do_confirm "$@";; grant-round) do_grant "$@";; rule-ok) do_rule_ok "$@";; triaged) do_triaged "$@";; rule-questions) do_rule_questions "$@";; post) do_post "$@";; set) do_set "$@";; replan) do_replan "$@";; *) usage;; esac
