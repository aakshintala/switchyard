#!/usr/bin/env bash
# plan-check: check a plan's Files paths against its base before a Verifier reads it.
# Usage: plan-check PLAN_FILE [--base REV] [--cwd DIR]
#        plan-check -h | --help
#        REV is --base, else the plan's `Base: <sha>` line. DIR is a git clone of
#        the plan's repo (default: the checkout holding the plan file, else the
#        current directory). Callers pass --base
#        origin/main to check against the fresh base.
#        Reads the single-backtick tokens outside fenced blocks and the `## Gate`
#        section. Skipped: a token with `<`, `>` or a space, a token with `*`
#        outside `## Files` (a `*` token in `## Files` is kept as a cover
#        pattern, never reported), and `/`, `.`,
#        `..` or a bare extension. A token with one `{a,b}` group is checked once
#        per alternative; with more than one group it is skipped. A `path::symbol`
#        token checks its path and symbol at REV. A file:N or file:A-B beside
#        a backticked symbol must hold it; `path`, "heading" must name a heading.
#        1. A path (a `/` or a source or doc extension) resolves at REV: by full
#           path, a directory by its trailing `/`, or by a suffix that names exactly
#           one file. A suffix naming two or more files resolves but is left out of
#           check 2. The first token in a Files list or table entry is a path
#           regardless of its shape; if it matches nothing, it is reported even
#           when its first segment is not a top-level entry. Other missing paths
#           are reported only under a top-level entry. A path on a line with the
#           word `new`, `removed`, `remove`, `deleted` or `delete` is exempt from
#           that missing report; check 2 still applies to it. A marked Files
#           entry must contain `/` or `.` and must not start with `./`. A `(new)`
#           entry must also have a parent directory at REV; `(new-confirmed)`
#           bypasses only the parent check.
#           A path on a line with the word `reads`, `read-only` or `fixture` must
#           still resolve but is left out of check 2. Marks match whole words.
#        2. Every resolved path in `## Tasks` or `## Red commit` is in `## Files`,
#           unless its line holds `reads`, `read-only` or `fixture`.
#           A directory counts as in Files when a Files path starts with it.
#           A Files entry ending in `/` covers every path under it, and a Files
#           entry holding `*` covers every path it matches.
#        Uncited prose symbols are not checked for existence. Symbols in Files,
#        Tasks and Red commit (except new or read-only lines) get a completeness
#        sweep: sites outside Files are warnings on stderr, with no exit change.
#        Exit 0, nothing printed: clean. Exit 1: one line per problem on stdout,
#        each ending with the fix it accepts.
#        Exit 2 on bad usage, an unreadable plan, no Base line and no --base, or a
#        REV that is not a commit in DIR. The token reader, path resolver and
#        Files cover rules live in lib/plan-tokens.sh, sourced below.
set -euo pipefail

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
lib="$script_dir/lib/plan-tokens.sh"
if [ ! -r "$lib" ]; then
  echo "plan-check: cannot read shared lib: $lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$lib"

usage() {
  echo "usage: plan-check PLAN_FILE [--base REV] [--cwd DIR]" >&2
  exit 2
}

# seen KEY: true when KEY was already reported; otherwise records it
seen() {
  case "$SEEN" in *"|$1|"*) return 0 ;; esac
  SEEN="$SEEN$1|"
  return 1
}

problem() {
  printf '%s\n' "$1"
  FOUND=1
}

# near_name NEW EXISTING: true when one name differs by a single run of at most
# two inserted, deleted or substituted characters.
near_name() {
  local a="$1" b="$2" prefix=0 suffix=0 a_len b_len ai bi a_mid b_mid
  a_len=${#a}
  b_len=${#b}
  while [ "$prefix" -lt "$a_len" ] && [ "$prefix" -lt "$b_len" ]; do
    [ "${a:$prefix:1}" = "${b:$prefix:1}" ] || break
    prefix=$((prefix + 1))
  done
  while [ "$suffix" -lt "$((a_len - prefix))" ] && [ "$suffix" -lt "$((b_len - prefix))" ]; do
    ai=$((a_len - suffix - 1))
    bi=$((b_len - suffix - 1))
    [ "${a:$ai:1}" = "${b:$bi:1}" ] || break
    suffix=$((suffix + 1))
  done
  a_mid=$((a_len - prefix - suffix))
  b_mid=$((b_len - prefix - suffix))
  [ "$a_mid" -le 2 ] && [ "$b_mid" -le 2 ] && { [ "$a_mid" -gt 0 ] || [ "$b_mid" -gt 0 ]; }
}

# check_new_file PATH MARK: report an existing path and close sibling names.
check_new_file() {
  local p="$1" mark="$2" base_path="$1" new_dir new_name q q_dir q_name
  case "$base_path" in */) base_path="${base_path%/}" ;; esac
  if git -C "$dir" cat-file -e "$rev:$base_path" 2>/dev/null; then
    if ! seen "e:$p"; then
      problem "new path $p already exists at base: drop the new mark"
    fi
  fi
  [ "$mark" = 2 ] && return 0
  case "$p" in */) return 0 ;; esac
  case "$p" in */*) new_dir="${p%/*}" ;; *) new_dir="" ;; esac
  new_name="${p##*/}"
  while IFS= read -r q; do
    case "$q" in */*) q_dir="${q%/*}"; q_name="${q##*/}" ;; *) q_dir=""; q_name="$q" ;; esac
    [ "$q_dir" = "$new_dir" ] || continue
    if near_name "$new_name" "$q_name" && ! seen "c:$p:$q"; then
      problem "new path $p is close to existing $q: confirm new, or correct it"
    fi
  done <<<"$tree"
}

# check_path PATH: resolve PATH at REV (resolve_path), then apply checks 1 and 2 to it
check_path() {
  local p="$1" seg parent bad_new_shape=0
  if [ "$CUR_SEC" = files ] && [ "$CUR_FILES_ENTRY" = 1 ] && { [ "$CUR_NEW" = 1 ] || [ "$CUR_NEW" = 2 ]; }; then
    case "$p" in
      ./*) bad_new_shape=1 ;;
      */*|*.*) ;;
      *) bad_new_shape=1 ;;
    esac
    if [ "$bad_new_shape" = 1 ] && ! seen "n:$p"; then
      problem "new Files entry $p must contain a slash or dot and cannot start with ./: give the full path"
    elif [ "$CUR_NEW" = 1 ]; then
      case "$p" in */*) parent="${p%/*}" ;; *) parent="" ;; esac
      if [ -n "$parent" ] && [ "$(git -C "$dir" cat-file -t "$rev:$parent" 2>/dev/null || true)" != tree ]; then
        if ! seen "n:$p"; then
          problem "new Files entry $p needs a parent directory on the base: give the full path, or, for a file in a new directory, mark it (new-confirmed)"
        fi
      fi
    fi
  fi
  case "$CUR_NEW" in
    1|2)
      if [ "$CUR_SEC" = files ]; then check_new_file "$p" "$CUR_NEW"; fi
      ;;
  esac
  resolve_path "$p"
  case "$RES_KIND" in
    ambiguous) return 0 ;;
    found)
      case "$CUR_SEC" in
        files) FILES="$FILES$RES|" ;;
        tasks|red) [ "$CUR_READ" = 1 ] || TASKS="$TASKS$RES"$'\t'"$CUR_LN"$'\n' ;;
      esac
      return 0 ;;
  esac
  if [ "$CUR_NEW" -gt 0 ]; then
    # A new or removed path is exempt from the missing report only; check 2 still applies unless the line also marks it read-only.
    case "$CUR_SEC" in
      files) FILES="$FILES$p|" ;;
      tasks|red) [ "$CUR_READ" = 1 ] || TASKS="$TASKS$p"$'\t'"$CUR_LN"$'\n' ;;
    esac
    return 0
  fi
  seg="${p%%/*}"
  if [ "$CUR_SEC" != files ] || [ "$CUR_FILES_ENTRY" != 1 ]; then
    case "$TOPLIST" in *"|$seg|"*) ;; *) return 0 ;; esac
  fi
  if ! seen "m:$p"; then
    problem "missing path: $p (line $CUR_LN): does not exist on the base; correct the path, or mark the line (new) if the plan creates it, or (removed) if it deletes it"
  fi
  return 0
}

# check_citation TOKEN: verify an adjacent quoted symbol at the cited base lines.
check_citation() {
  local citation="$1" lines symbol content heading
  [ "$RES_KIND" = found ] || return 0
  heading="$(awk -v ln="$CUR_LN" -v token="$citation" '
    NR == ln {
      n = split($0, a, "`")
      for (i = 2; i <= n; i += 2) if (a[i] == token) {
        text = a[i+1]
        if (text ~ /^[[:space:]]*,[[:space:]]*"[^"]+"/) {
          sub(/^[[:space:]]*,[[:space:]]*"/, "", text)
          sub(/".*/, "", text)
          print text
        }
        exit
      }
    }' "$plan")"
  if [ -n "$heading" ]; then
    content="$(git -C "$dir" show "$rev:$RES")"
    if ! awk -v heading="$heading" '
      /^#{1,6}[[:space:]]/ {
        sub(/^#+[[:space:]]+/, ""); sub(/[[:space:]]+#+[[:space:]]*$/, "")
        if ($0 == heading) found = 1
      }
      END { exit !found }' <<<"$content" && ! seen "h:$RES:$heading"; then
      problem "missing heading: $RES, \"$heading\": correct the citation"
    fi
  fi
  case "$citation" in
    *::*)
      symbol="${citation#*::}"
      content="$(git -C "$dir" show "$rev:$RES")"
      if ! grep -Fq -- "${symbol%()}" <<<"$content" && ! seen "s:$citation:$symbol"; then
        problem "missing symbol: $citation does not contain $symbol: correct the citation"
      fi
      return 0 ;;
  esac
  [[ $citation =~ :([0-9]+)(-([0-9]+))?$ ]] || return 0
  lines="${BASH_REMATCH[1]},${BASH_REMATCH[3]:-${BASH_REMATCH[1]}}"
  symbol="$(awk -v ln="$CUR_LN" -v token="$citation" '
    NR == ln {
      n = split($0, a, "`")
      for (i = 2; i <= n; i += 2) if (a[i] == token) {
        before = (i > 2 && a[i-2] ~ /^[A-Za-z_][A-Za-z0-9_:]*(\(\))?$/)
        after = (i + 2 <= n && a[i+2] ~ /^[A-Za-z_][A-Za-z0-9_:]*(\(\))?$/)
        if (before && (!after || length(a[i-1]) <= length(a[i+1]))) print a[i-2]
        else if (after) print a[i+2]
        exit
      }
    }' "$plan")"
  [ -n "$symbol" ] || return 0
  handle_token symbol "$symbol"
  content="$(git -C "$dir" show "$rev:$RES" | sed -n "${lines}p")"
  if ! grep -Fq -- "${symbol%()}" <<<"$content" && ! seen "s:$citation:$symbol"; then
    problem "missing symbol: $citation does not contain $symbol: correct the citation"
  fi
}

# handle_token KIND VALUE: the expand_token callback replacing check_token's dispatch.
# A glob is already recorded as a cover pattern by expand_token itself.
# Standalone symbols are collected only for the advisory completeness sweep.
handle_token() {
  case "$1" in
    glob) return 0 ;;
    symbol)
      case "$CUR_SEC:$CUR_READ:$CUR_NEW" in
        files:0:0|tasks:0:0|red:0:0|files:0:3|tasks:0:3|red:0:3) SYMBOLS="$SYMBOLS${2%()}"$'\n' ;;
      esac ;;
    path) check_path "$2"; check_citation "$tok" ;;
  esac
  return 0
}

plan=""
rev=""
dir=""
have_cwd=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    --base) [ $# -ge 2 ] && [ -n "$2" ] || usage; rev="$2"; shift 2 ;;
    --cwd) [ $# -ge 2 ] || usage; dir="$2"; have_cwd=1; shift 2 ;;
    -*) usage ;;
    *) [ -z "$plan" ] || usage; plan="$1"; shift ;;
  esac
done
[ -n "$plan" ] || usage
[ -r "$plan" ] || { echo "plan-check: cannot read plan file: $plan" >&2; exit 2; }
if [ "$have_cwd" = 0 ]; then
  if top="$(git -C "$(dirname "$plan")" rev-parse --show-toplevel 2>/dev/null)"; then
    dir="$top"
  else
    dir="."
  fi
fi
if [ "$have_cwd" = 0 ] && ! git -C "$dir" rev-parse --show-toplevel >/dev/null 2>&1; then
  echo "plan-check: $dir is not a git repository; pass --cwd <worktree>" >&2
  exit 2
fi

if [ -z "$rev" ]; then
  rev="$(plan_base "$plan")"
  if [ -z "$rev" ]; then
    echo "plan-check: no Base line in $plan and no --base" >&2
    exit 2
  fi
fi
if ! git -C "$dir" rev-parse -q --verify "$rev^{commit}" >/dev/null 2>&1; then
  echo "plan-check: $rev is not a commit in $dir; run it in the plan's repo clone, or pass --cwd DIR" >&2
  exit 2
fi

tree="$(git -C "$dir" ls-tree -r --name-only "$rev")"
TOPLIST="|$(git -C "$dir" ls-tree --name-only "$rev" | tr '\n' '|')"

# One record per token: section, line number, whether the line says `new` etc, whether it says `reads` etc, the token.
# Fenced blocks and the Gate section are skipped.
records="$(plan_records "$plan" 1)"

FOUND=0
SEEN="|"
FILES="|"
GLOBS=""
TASKS=""
SYMBOLS=""

while IFS=$'\t' read -r CUR_SEC CUR_LN CUR_NEW CUR_READ CUR_FILES_ENTRY tok; do
  [ -n "$tok" ] || continue
  expand_token "$tok" handle_token
done <<<"$records"

# Task and Red commit paths must sit under Files; Files is complete only now.
while IFS=$'\t' read -r p ln; do
  [ -n "$p" ] || continue
  if covered "$p"; then continue; fi
  if ! seen "o:$p"; then
    problem "outside Files: $p (line $ln): add it to Files, or mark the line (reads) if the task only reads it"
  fi
done <<<"$TASKS"

# Search the base for changed symbols; missing Files coverage is advisory only.
while IFS= read -r symbol; do
  [ -n "$symbol" ] || continue
  if seen "scan:$symbol"; then continue; fi
  while IFS= read -r site; do
    [ -n "$site" ] || continue
    site="${site#"$rev:"}"
    if ! covered "$site" && ! seen "w:$symbol:$site"; then
      printf 'warning: %s occurs outside Files: %s\n' "$symbol" "$site" >&2
    fi
  done <<<"$(git -C "$dir" grep -l -F -w -e "$symbol" "$rev" -- || true)"
done <<<"$SYMBOLS"

# The Outcome line names the ticket's end state: pr (the default when the line
# is absent) or measurement. Any other value is a problem on its own line.
# An empty declaration is rejected: only an absent line defaults to pr.
if grep -Eq '^Outcome:($|[[:space:]])' "$plan"; then
  outcome="$(plan_outcome "$plan")"
  case "$outcome" in
    pr|measurement) ;;
    *)
      outcome_line="$(awk '/^Outcome:($|[[:space:]])/ { print NR; exit }' "$plan")"
      problem "bad Outcome: $outcome (line $outcome_line): write Outcome: pr or Outcome: measurement" ;;
  esac
fi

if [ "$FOUND" = 1 ]; then
  exit 1
fi
exit 0
