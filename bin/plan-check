#!/usr/bin/env bash
# plan-check: check a plan's paths and symbols against its base before a Verifier reads it.
# Usage: plan-check PLAN_FILE [--base REV] [--cwd DIR]
#        plan-check -h | --help
#        REV is --base, else the plan's `Base: <sha>` line. DIR is a git clone of
#        the plan's repo (default: the current directory). Callers pass --base
#        origin/main to check against the fresh base.
#        Reads the single-backtick tokens outside fenced blocks and the `## Gate`
#        section. Skipped: a token with `<`, `>`, `*` or a space, and `/`, `.`,
#        `..` or a bare extension. A token with one `{a,b}` group is checked once
#        per alternative; with more than one group it is skipped. A `path::symbol`
#        token is split and both halves are checked.
#        1. A path (a `/` or a source or doc extension) resolves at REV: by full
#           path, a directory by its trailing `/`, or by a suffix that names exactly
#           one file. A suffix naming two or more files resolves but is left out of
#           check 2. A path that matches nothing is reported only when its first
#           segment is a top-level entry at REV. A path on a line with the word
#           `new` is exempt.
#        2. Every resolved path in `## Tasks` or `## Red commit` is in `## Files`.
#           A directory counts as in Files when a Files path starts with it.
#        3. A symbol (an identifier with `_`, `::` or an uppercase letter after its
#           first character) outside `## Tasks` occurs at REV, or a line with the
#           word `new` holds a backticked token containing its last `::` segment.
#        Exit 0, nothing printed: clean. Exit 1: one line per problem on stdout.
#        Exit 2 on bad usage, an unreadable plan, no Base line and no --base, or a
#        REV that is not a commit in DIR.
set -euo pipefail

usage() {
  echo "usage: plan-check PLAN_FILE [--base REV] [--cwd DIR]" >&2
  exit 2
}

# seen KEY: true when KEY was already reported; otherwise records it
seen() {
  case "$SEEN" in *"|$1|"*) return 0 ;; esac
  SEEN="$SEEN$1|"
  return 1
}

problem() {
  printf '%s\n' "$1"
  FOUND=1
}

# is_path TOKEN: no spaces, and a `/` or a known extension
is_path() {
  case "$1" in
    *" "*) return 1 ;;
    */*|*.rs|*.md|*.toml|*.lua|*.json|*.sh|*.yml|*.yaml|*.lock|*.txt|*.snap) return 0 ;;
  esac
  return 1
}

# is_symbol TOKEN: an identifier with `_`, `::` or an uppercase letter after its first character
is_symbol() {
  local s="$1" symre='^[A-Za-z_][A-Za-z0-9_]*(::[A-Za-z_][A-Za-z0-9_]*)*$'
  case "$s" in *"()") s="${s%??}" ;; esac
  case "$s" in *"{"*) return 1 ;; esac
  [[ $s =~ $symre ]] || return 1
  case "$s" in *_*|*::*) return 0 ;; esac
  [[ ${s:1} =~ [A-Z] ]]
}

# exempt_new NAME: true when a plan line has the whole word `new` and a backticked token holding NAME
exempt_new() {
  awk -v s="$1" '
    tolower($0) ~ /(^|[^a-z0-9_])new([^a-z0-9_]|$)/ {
      n = split($0, parts, "`")
      for (i = 2; i <= n; i += 2)
        if (parts[i] ~ ("(^|[^A-Za-z0-9_])" s "([^A-Za-z0-9_]|$)")) found = 1
    }
    END { exit (found ? 0 : 1) }' "$plan"
}

# check_path PATH: resolve PATH at REV, then apply checks 1 and 2 to it
check_path() {
  local p="$1" res="" out cnt m seg
  case "$p" in
    */) if git -C "$dir" cat-file -e "$rev:${p%/}" 2>/dev/null; then res="$p"; fi ;;
    *) if git -C "$dir" cat-file -e "$rev:$p" 2>/dev/null; then res="$p"; fi ;;
  esac
  if [ -z "$res" ]; then
    out="$(awk -v t="$p" '{
      if ($0 == t || (length($0) > length(t) && substr($0, length($0) - length(t)) == "/" t)) { c++; m = $0 }
    } END { printf "%d\t%s\n", c, m }' <<<"$tree")"
    cnt="${out%%$'\t'*}"
    m="${out#*$'\t'}"
    if [ "$cnt" = 1 ]; then
      res="$m"
    elif [ "$cnt" -ge 2 ]; then
      return 0
    fi
  fi
  if [ -z "$res" ]; then
    if [ "$CUR_NEW" = 1 ]; then
      [ "$CUR_SEC" != files ] || FILES="$FILES$p|"
      return 0
    fi
    seg="${p%%/*}"
    case "$TOPLIST" in *"|$seg|"*) ;; *) return 0 ;; esac
    if ! seen "m:$p"; then
      problem "missing path: $p (line $CUR_LN)"
    fi
    return 0
  fi
  case "$CUR_SEC" in
    files) FILES="$FILES$res|" ;;
    tasks|red) TASKS="$TASKS$res"$'\t'"$CUR_LN"$'\n' ;;
  esac
  return 0
}

# check_symbol SYMBOL: check 3, skipped inside the Tasks section
check_symbol() {
  local s="$1" last
  [ "$CUR_SEC" != tasks ] || return 0
  case "$s" in *"()") s="${s%??}" ;; esac
  last="${s##*::}"
  if git -C "$dir" grep -q -w -F -e "$last" "$rev" 2>/dev/null; then return 0; fi
  if exempt_new "$last"; then return 0; fi
  if ! seen "s:$1"; then
    problem "unknown symbol: $1 (line $CUR_LN)"
  fi
  return 0
}

# check_plain TOKEN: one token, with no brace group left to expand
check_plain() {
  local p="$1"
  if [[ $p =~ $portre ]]; then p="${p%"${BASH_REMATCH[0]}"}"; fi
  case "$p" in
    *.rs::*|*.md::*|*.toml::*|*.lua::*|*.json::*|*.sh::*|*.yml::*|*.yaml::*|*.lock::*|*.txt::*|*.snap::*)
      check_path "${p%%::*}"
      check_symbol "${p#*::}"
      return 0 ;;
  esac
  if is_path "$p"; then
    check_path "$p"
  elif is_symbol "$p"; then
    check_symbol "$p"
  fi
  return 0
}

# check_token TOKEN: skip rules, then brace expansion, then check_plain
check_token() {
  local t="$1" tmp n pre rest inner suf item
  case "$t" in *"<"*|*">"*|*"*"*|*" "*) return 0 ;; esac
  case "$t" in
    /|.|..) return 0 ;;
    .*) case "$t" in */*) ;; *) return 0 ;; esac ;;
  esac
  case "$t" in
    *"{"*)
      case "$t" in *"}"*) ;; *) return 0 ;; esac
      tmp="${t//\{/}"
      n=$(( ${#t} - ${#tmp} ))
      [ "$n" -eq 1 ] || return 0
      pre="${t%%\{*}"
      rest="${t#*\{}"
      inner="${rest%%\}*}"
      suf="${rest#*\}}"
      while IFS= read -r item; do
        check_plain "$pre$item$suf"
      done <<<"$(awk -v s="$inner" 'BEGIN { n = split(s, a, ","); for (i = 1; i <= n; i++) print a[i] }')"
      return 0 ;;
  esac
  check_plain "$t"
  return 0
}

plan=""
rev=""
dir="."
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage ;;
    --base) [ $# -ge 2 ] && [ -n "$2" ] || usage; rev="$2"; shift 2 ;;
    --cwd) [ $# -ge 2 ] || usage; dir="$2"; shift 2 ;;
    -*) usage ;;
    *) [ -z "$plan" ] || usage; plan="$1"; shift ;;
  esac
done
[ -n "$plan" ] || usage
[ -r "$plan" ] || { echo "plan-check: cannot read plan file: $plan" >&2; exit 2; }

if [ -z "$rev" ]; then
  rev="$(awk '/^Base:[[:space:]]/ { print $2; exit }' "$plan")"
  if [ -z "$rev" ]; then
    echo "plan-check: no Base line in $plan and no --base" >&2
    exit 2
  fi
fi
if ! git -C "$dir" rev-parse -q --verify "$rev^{commit}" >/dev/null 2>&1; then
  echo "plan-check: $rev is not a commit in $dir" >&2
  exit 2
fi

tree="$(git -C "$dir" ls-tree -r --name-only "$rev")"
TOPLIST="|$(git -C "$dir" ls-tree --name-only "$rev" | tr '\n' '|')"

# One record per token: section, line number, whether the line says `new`, the token.
# Fenced blocks and the Gate section are skipped.
records="$(awk '
  /^[[:space:]]*```/ { infence = !infence; next }
  infence { next }
  /^## / {
    cur = "other"
    if ($0 ~ /^## Files([[:space:]]|$)/) cur = "files"
    else if ($0 ~ /^## Tasks([[:space:]]|$)/) cur = "tasks"
    else if ($0 ~ /^## Red commit([[:space:]]|$)/) cur = "red"
    else if ($0 ~ /^## Gate([[:space:]]|$)/) cur = "gate"
    next
  }
  cur == "gate" { next }
  {
    isnew = (tolower($0) ~ /(^|[^a-z0-9_])new([^a-z0-9_]|$)/)
    n = split($0, parts, "`")
    for (i = 2; i <= n; i += 2)
      if (parts[i] != "") printf "%s\t%d\t%d\t%s\n", cur, NR, isnew, parts[i]
  }
' "$plan")"

portre=':[0-9]+(-[0-9]+)?$'
FOUND=0
SEEN="|"
FILES="|"
TASKS=""

while IFS=$'\t' read -r CUR_SEC CUR_LN CUR_NEW tok; do
  [ -n "$tok" ] || continue
  check_token "$tok"
done <<<"$records"

# Task and Red commit paths must sit under Files; Files is complete only now.
while IFS=$'\t' read -r p ln; do
  [ -n "$p" ] || continue
  case "$p" in
    */)
      d="${p%/}"
      case "$FILES" in *"|$d/"*) continue ;; esac ;;
    *)
      case "$FILES" in *"|$p|"*) continue ;; esac ;;
  esac
  if ! seen "o:$p"; then
    problem "outside Files: $p (line $ln)"
  fi
done <<<"$TASKS"

if [ "$FOUND" = 1 ]; then
  exit 1
fi
exit 0
