#!/usr/bin/env bash
# Manual performance benchmark for plan-sweep's per-symbol hit handling.
# Run with TMPDIR set to a writable, disposable directory.
set -euo pipefail

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
sweep="$script_dir/plan-sweep"

lines="${BENCH_LINES:-2000}"
case "$lines" in ''|*[!0-9]*) echo "bench-plan-sweep: BENCH_LINES must be a positive integer" >&2; exit 2 ;; esac
[ "$lines" -gt 0 ] || { echo "bench-plan-sweep: BENCH_LINES must be a positive integer" >&2; exit 2; }

work="$(mktemp -d "${TMPDIR:-/tmp}/bench-plan-sweep.XXXXXX")"
trap 'rm -rf "$work"' EXIT
repo="$work/repo"
mkdir -p "$repo/src"
git -C "$repo" init -q

# Forty distinct symbols are present on every caller line. The old per-hit
# shell path starts several command substitutions for each of the 80,000
# (default) symbol hits; the benchmark is intentionally not part of test/run.
(cd "$repo" && awk -v lines="$lines" '
  BEGIN {
    for (i = 1; i <= 40; i++) {
      names[i] = sprintf("bench_symbol_%02d", i)
      printf "pub fn %s() {}\n", names[i] >> "src/lib.rs"
    }
    for (row = 1; row <= lines; row++) {
      for (i = 1; i <= 40; i++) printf "%s(); ", names[i] >> "src/calls.rs"
      printf "\n" >> "src/calls.rs"
    }
  }')
git -C "$repo" add src/lib.rs src/calls.rs
git -C "$repo" -c user.name=benchmark -c user.email=benchmark@example.com commit -q -m fixture
base="$(git -C "$repo" rev-parse HEAD)"
plan="$work/plan.md"
{
  printf '# plan-sweep benchmark\nBase: %s\n\n## Files\n- `src/lib.rs`\n- `src/calls.rs`\n\n## Interfaces\n' "$base"
  i=1
  while [ "$i" -le 40 ]; do
    printf 'Uses `bench_symbol_%02d`.\n' "$i"
    i=$((i + 1))
  done
} >"$plan"

TIMEFORMAT='%3R'
{ time "$sweep" --cwd "$repo" --base "$base" --plan "$plan" --out "$work/pack.md" >"$work/stdout" 2>"$work/stderr"; } 2>"$work/elapsed"
elapsed="$(cat "$work/elapsed")"
[ "$(grep -c '^## Symbol ' "$work/pack.md")" -eq 40 ] || { echo "bench-plan-sweep: expected 40 Symbol sections" >&2; exit 1; }
printf 'plan-sweep: %s s for 40 symbols and %s caller lines\n' "$elapsed" "$lines"
if awk -v elapsed="$elapsed" 'BEGIN { exit !(elapsed < 30) }'; then
  echo 'PASS: under 30 s'
else
  echo 'FAIL: 30 s limit exceeded' >&2
  exit 1
fi
