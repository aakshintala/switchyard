#!/usr/bin/env bash
# tkt-start: write state, cut/reuse the worktree, run the C8 current check; on a
# miss run plan-sweep plus the preflight job. Only a sweep rc 1 listing unresolved
# tokens still preflights; any other sweep failure exits with its code. No --files
# skips the sweep. A stored head differing from the worktree or PR head exits 3.
# Usage: tkt-start --run DIR --repo R --issue N --spec PATH --branch B --worktree DIR --workflow-doc PATH --closing TEXT [--env PREFIX] [--body-has LINE]... [--extra FILE] [--merge-gate ci|gate] [--mutant-job NAME] [--model ROLE=ID]... [--files PATHS] [--no-preflight]
# PATHS are separated by commas or spaces, and repeats of --files add more paths.
set -euo pipefail
usage() {
  echo "usage: tkt-start --run DIR --repo R --issue N --spec PATH --branch B --worktree DIR --workflow-doc PATH --closing TEXT [--env PREFIX] [--body-has LINE]... [--extra FILE] [--merge-gate ci|gate] [--mutant-job NAME] [--model ROLE=ID]... [--files PATHS] [--no-preflight]" >&2
  echo "  --files PATHS: paths separated by commas or spaces" >&2
  exit 2
}
run=""; repo=""; issue=""; spec=""; branch=""; worktree=""; workflow_doc=""; closing=""
env=""; extra=""; merge_gate=""; mutant_job=""; files=""; no_preflight=0
body_has=(); models=()
while [ $# -gt 0 ]; do
  case "$1" in
    --body-has) [ $# -ge 2 ] || usage; body_has+=("$2"); shift 2 ;;
    --model) [ $# -ge 2 ] || usage; models+=("$2"); shift 2 ;;
    --files) [ $# -ge 2 ] || usage; files="${files:+$files,}${2//[[:space:]]/,}"; shift 2 ;;
    --no-preflight) no_preflight=1; shift ;;
    --run|--repo|--issue|--spec|--branch|--worktree|--closing|--env|--extra|--merge-gate|--mutant-job|--workflow-doc)
      [ $# -ge 2 ] || usage; v="${1#--}"; printf -v "${v//-/_}" '%s' "$2"; shift 2 ;;
    --help|-h|-*|*) usage ;;
  esac
done
# --files: repeats and spaces both separate paths; squeeze the commas they leave.
while [[ $files == *,,* ]]; do files="${files//,,/,}"; done
files="${files#,}"; files="${files%,}"
for v in run repo issue spec branch worktree workflow_doc closing; do [ -n "${!v}" ] || { echo "tkt-start: missing required flag: --${v//_/-}" >&2; exit 2; }; done
case "$issue" in *[!0-9]*) echo "tkt-start: --issue needs a number: $issue" >&2; exit 2 ;; esac
for m in ${models[@]+"${models[@]}"}; do case "$m" in *=*) ;; *) echo "tkt-start: --model needs ROLE=ID: $m" >&2; exit 2 ;; esac; done
case "$merge_gate" in ""|ci|gate) ;; *) echo "tkt-start: --merge-gate needs ci or gate: $merge_gate" >&2; exit 2 ;; esac
spec_part=0; grep -qiE 'part of[[:space:]]+#[0-9]+' "$spec" 2>/dev/null && spec_part=1
close_part=0; printf '%s' "$closing" | grep -qiE '^part of([[:space:]]|$)' && close_part=1
if [ "$spec_part" -ne "$close_part" ]; then
  echo "tkt-start: --closing '$closing' disagrees with the spec: a Part-of batch ticket needs a 'Part of #N' closing line, any other ticket a Resolves line" >&2
  exit 2
fi
script_dir="$(cd "$(dirname "$0")" && pwd)"; tkt_state="$script_dir/tkt-state"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then echo "tkt-start: cannot read shared lib: $namebase_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$namebase_lib"
bin_dir="${TKT_BIN:-$HOME/.agents/bin}"; sweep="$bin_dir/plan-sweep"; tktjob="$bin_dir/tkt-job"
set_namebase "$repo" "$issue"; state="$run/$namebase.state"; mkdir -p "$run"
tkt() { "$tkt_state" "$state" "$@"; }
emit() {
  local rest="$1" code="$2"; shift 2; local twelve log out
  twelve="$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf nohead)"
  log="$run/$namebase-tkt-start-$twelve-$(date +%H%M%S).log"; out="TKT tkt-start $rest log=$log"
  [ $# -eq 0 ] || out="$out
$(printf '%s\n' "$@" | head -n 40)"
  printf '%s\n' "$out" | tee "$log"; exit "$code"
}
fail_step() {
  local msg="tkt-start: $1 failed (rc=$2)"
  [ $# -ge 3 ] && [ -n "$3" ] && msg="$msg: $(printf '%s' "$3" | tail -n 20)"
  printf '%s\n' "$msg" >&2; emit "STEP-FAIL step=$1 rc=$2" "$2" "$msg"
}
deny() { printf '%s\n' "$3" >&2; emit "$1" "$2" "$3"; }
lockdir="$state.lock"; if ! mkdir "$lockdir" 2>/dev/null; then
  holder="$(cat "$lockdir/pid" 2>/dev/null || true)"; [ -n "$holder" ] || holder="unknown"
  deny "BUSY holder=$holder" 2 "tkt-start: state locked by pid $holder"
fi; rmdir "$lockdir"
if stored_head="$(tkt get head 2>/dev/null)"; then
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || printf unknown)"; pr_head=""
  if pr="$(tkt get pr 2>/dev/null)"; then
    pr_head="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq '.headRefOid' 2>/dev/null || true)"
    [ -n "$pr_head" ] || deny "PRECONDITION pr=unreadable" 2 "tkt-start: cannot read PR head: pr=$pr repo=$repo"
  fi
  if [ "$stored_head" != "$actual" ] || { [ -n "$pr_head" ] && [ "$stored_head" != "$pr_head" ]; }; then
    deny "DRIFT state=$stored_head worktree=$actual pr=${pr_head:-none}" 3 "tkt-start: head drift: state head=$stored_head worktree $worktree HEAD=$actual pr ${pr:-none} head=${pr_head:-none}"
  fi
fi
for k in repo issue spec branch worktree run workflow_doc closing; do tkt set "$k" "${!k}"; done
for k in env extra merge_gate mutant_job; do [ -n "${!k}" ] && tkt set "$k" "${!k}"; done
for b in ${body_has[@]+"${body_has[@]}"}; do tkt list body_has 2>/dev/null | grep -xF -- "$b" >/dev/null || tkt add body_has "$b"; done
for m in ${models[@]+"${models[@]}"}; do tkt list "model.${m%%=*}" 2>/dev/null | grep -xF -- "${m#*=}" >/dev/null || tkt add "model.${m%%=*}" "${m#*=}"; done
tkt journal "tkt-start state repo=$repo issue=$issue branch=$branch"
# Repo reads go through the worktree once it exists, so a rerun works from
# any directory; creating it still runs in the caller's repo.
gdir="."; [ -e "$worktree" ] && gdir="$worktree"
ferr="$(git -C "$gdir" fetch -q origin 2>&1)" || fail_step fetch "$?" "$ferr"
base="$(git -C "$gdir" rev-parse origin/main 2>&1)" || fail_step fetch "$?" "$base"
wt_note="reused"; if [ ! -e "$worktree" ]; then
  werr="$(git worktree add --no-track -b "$branch" "$worktree" origin/main 2>&1)" || fail_step worktree "$?" "$werr"
  wt_note="created"
fi; tkt journal "tkt-start worktree $worktree $wt_note"; fpaths=()
if [ -n "$files" ]; then IFS=',' read -ra parts <<<"$files"
  for p in ${parts[@]+"${parts[@]}"}; do p="$(printf '%s' "$p" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"; [ -n "$p" ] && fpaths+=("$p"); done; fi
stale=""; reason=""; filing=""; lognote="not run"; sincenote="no edit info"
for p in ${fpaths[@]+"${fpaths[@]}"}; do git -C "$worktree" cat-file -e "origin/main:$p" 2>/dev/null || { stale=1; reason="missing-file:$p"; break; }; done
if [ -z "$stale" ]; then
  body="$(gh issue view "$issue" --repo "$repo" --json body --jq '.body' 2>&1)" || fail_step github "$?" "$body"
  filing="$(printf '%s\n' "$body" | grep -oE '(Written against|filing commit:) [0-9a-f]{7,40}' | sed -n '1s/.* //p' || true)"
  { [ -n "$filing" ] && git -C "$worktree" cat-file -e "$filing^{commit}" 2>/dev/null; } || { stale=1; reason="filing-commit:unreadable"; filing=""; }
fi
if [ -z "$stale" ]; then rc=0; logout=""
  logout="$(git -C "$worktree" log --oneline "$filing..origin/main" -- ${fpaths[@]+"${fpaths[@]}"} 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then stale=1; reason="log:failed"; lognote="failed"
  elif [ -n "$logout" ]; then stale=1; reason="log:$filing..origin/main"; lognote="$(printf '%s' "$logout" | grep -c . || true) lines"
  else lognote="empty"; fi
fi
if [ -n "$filing" ]; then
  owner="${repo%%/*}"; name="${repo##*/}"
  edited="$(gh api graphql -F owner="$owner" -F name="$name" -F number="$issue" -f query='query ($owner: String!, $name: String!, $number: Int!) { repository(owner: $owner, name: $name) { issue(number: $number) { lastEditedAt } } }' --jq '.data.repository.issue.lastEditedAt' 2>&1)" || fail_step github "$?" "$edited"
  [ "$edited" = "null" ] && edited=""
  if [ -n "$edited" ] && [ -z "$(git -C "$worktree" log -1 --format=%H --since="$edited" "$filing" 2>/dev/null || true)" ]; then rc=0; sincelog=""
    sincelog="$(git -C "$worktree" log --oneline --since="$edited" "$filing..origin/main" -- ${fpaths[@]+"${fpaths[@]}"} 2>&1)" || rc=$?
    if [ "$rc" -ne 0 ]; then stale=1; reason="since:failed"; sincenote="since=$edited failed"
    elif [ -n "$sincelog" ]; then sincenote="since=$edited non-empty"; [ -n "$stale" ] || { stale=1; reason="since:$edited"; }
    else sincenote="since=$edited empty"; fi
  elif [ -n "$edited" ]; then sincenote="edited=$edited not after filing"; fi
fi
dg=("state=$state" "worktree=$worktree $wt_note" "filing=${filing:-none} base=$base" "files=${files:-none}" "log ${filing:-none}..origin/main: $lognote" "$sincenote")
if [ -n "$stale" ]; then dg=("reason=$reason" ${dg[@]+"${dg[@]}"}); tkt journal "tkt-start check STALE reason=$reason filing=${filing:-none}"
  [ "$no_preflight" -eq 1 ] && emit "STALE reason=$reason filing=${filing:-none}" 1 "${dg[@]}"
else tkt journal "tkt-start check CURRENT filing=$filing"; emit "CURRENT filing=$filing files=${files:-none}" 0 "${dg[@]}"; fi
sweep_out="none"; out="$run/$namebase-preflight-out.md"
if [ "${#fpaths[@]}" -gt 0 ]; then sweep_out="$run/$namebase-sweep.md"; rc=0; sweep_txt=""
  sweep_txt="$("$sweep" --cwd "$worktree" --base origin/main --files "$files" --out "$sweep_out" 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then if [ "$rc" -eq 1 ] && [ -n "$sweep_txt" ] && ! printf '%s\n' "$sweep_txt" | grep -qv '^unresolved '; then :; else fail_step plan-sweep "$rc" "$sweep_txt"; fi; fi; fi
jrc=0; job_txt="$("$tktjob" "$state" --slot preflight --template "$HOME/.agents/skills/planning/briefs/preflight.md" --out-file "$out" "ISSUE=$issue" "SPEC=$spec" "REPO=$repo" "BASE=$base" "WORKFLOW_DOC=$workflow_doc" "PACK=$sweep_out" 2>&1)" || jrc=$?
# DONE_WITH_CONCERNS exits 1 with its report on disk: the report is the product.
if [ "$jrc" -ne 0 ]; then
  case "$(grep -m1 '^TKT tkt-job ' <<<"$job_txt" || head -n 1 <<<"$job_txt")" in
    "TKT tkt-job CONCERNS "*) [ "$jrc" -eq 1 ] && [ -f "$out" ] || fail_step tkt-job "$jrc" "$job_txt" ;;
    *) fail_step tkt-job "$jrc" "$job_txt" ;;
  esac
fi
[ -f "$out" ] || fail_step tkt-job 1 "no out file: $out"
core="$(grep -cE '^([0-9]+\.|-) *`?\**core\b' "$out" || true)"; nb="$(grep -cE '^([0-9]+\.|-) *\**non-blocking\b' "$out" || true)"
tkt journal "tkt-start preflight core=$core out=$out"; dg+=("sweep=$sweep_out" "out=$out"); report="$(head -n 30 "$out")"
[ "$core" -eq 0 ] && emit "PREFLIGHT core=0 nonblocking=$nb out=$out" 0 "${dg[@]}" "$report" || emit "PREFLIGHT core=$core out=$out" 1 "${dg[@]}" "$report"
