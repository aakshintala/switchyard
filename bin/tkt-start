#!/usr/bin/env bash
# tkt-start: write state, cut/reuse the worktree, run the C8 current check; on a
# miss run plan-sweep plus the preflight job. Only a sweep rc 1 listing unresolved
# tokens still preflights; any other sweep failure exits with its code. No --files
# skips the sweep. A stored head differing from the worktree or PR head exits 3.
# The preflight report carries `Core items: <n>` and `Non-blocking items: <n>` field lines just before its STATUS line; tkt-start reads the last such lines. A core item a ruling already settles is not counted in the fields.
# After the currency check, merged PRs mentioning the issue stop the run on a Resolves line or note the PR and its files on a Part-of line; an OPEN issue with a comment newer than the newest Resolves merge notes the recurrence and continues instead of stopping.
# --part N archives the prior state after its PR merges; merged-PR head drift tells you the next --part.
# Usage: tkt-start --run DIR --repo R --issue N --spec FILE --branch B --worktree DIR --workflow-doc PATH --closing TEXT [--part N] [--env PREFIX] [--body-has LINE]... [--body-ends TEXT] [--spec-issue N] [--extra FILE] [--merge-gate ci|gate] [--merge-check CMD] [--mutant-job NAME] [--model ROLE=ID]... [--files PATHS] [--no-preflight] [--takeover PR-OR-BRANCH --gate CMD]
# PATHS are separated by commas or spaces, and repeats of --files add more paths.
# Words after --files run to the next word starting with '-': write such a path as ./-name.
# Example: --files a b c, the same as --files a,b,c.
set -euo pipefail
usage() {
  echo "usage: tkt-start --run DIR --repo R --issue N --spec FILE --branch B --worktree DIR --workflow-doc PATH --closing TEXT [--part N] [--env PREFIX] [--body-has LINE]... [--body-ends TEXT] [--spec-issue N] [--extra FILE] [--merge-gate ci|gate] [--merge-check CMD] [--mutant-job NAME] [--model ROLE=ID]... [--files PATHS] [--no-preflight] [--takeover PR-OR-BRANCH --gate CMD]" >&2
  echo "  --takeover PR-OR-BRANCH records plan=takeover PR-OR-BRANCH; --gate CMD records its required check command; non-blank --files PATHS is required for its file fence" >&2
  echo "  --spec FILE: a file holding the ticket body; a Part-of closing needs 'Part of #N' in it" >&2
  echo "  --spec-issue N: the issue holding the spec, when it is not this ticket; review-pr checks the spec axis against it" >&2
  echo "  --files PATHS: paths separated by commas or spaces, e.g. --files a b c or --files a,b,c; required and non-blank with --takeover" >&2
  echo "  With --takeover, --files records the takeover file fence." >&2
  exit 2
}
run=""; repo=""; issue=""; spec=""; branch=""; worktree=""; workflow_doc=""; closing=""
env=""; extra=""; merge_gate=""; merge_check=""; mutant_job=""; files=""; no_preflight=0; part=""; part_given=0
body_has=(); models=()
model_roles=(lane fix map verifier verify review overbuild preflight)
body_ends=""; body_ends_given=0; spec_issue=""; spec_issue_given=0
takeover_ref=""; takeover_given=0; takeover_gate=""; takeover_gate_given=0
while [ $# -gt 0 ]; do
  case "$1" in
    --body-has) [ $# -ge 2 ] || usage; body_has+=("$2"); shift 2 ;;
    --body-ends) [ $# -ge 2 ] || usage; body_ends="$2"; body_ends_given=1; shift 2 ;;
    --spec-issue) [ $# -ge 2 ] || usage; spec_issue="$2"; spec_issue_given=1; shift 2 ;;
    --model) [ $# -ge 2 ] || usage; models+=("$2"); shift 2 ;;
    --part) [ $# -ge 2 ] || usage; part="$2"; part_given=1; shift 2 ;;
    --takeover) [ $# -ge 2 ] || usage; takeover_ref="$2"; takeover_given=1; shift 2 ;;
    --gate) [ $# -ge 2 ] || usage; takeover_gate="$2"; takeover_gate_given=1; shift 2 ;;
    --files) [ $# -ge 2 ] && [[ $2 != -* ]] || usage; shift; while [ $# -gt 0 ] && [[ $1 != -* ]]; do files="${files:+$files,}${1//[[:space:]]/,}"; shift; done ;;
    --no-preflight) no_preflight=1; shift ;;
    --run|--repo|--issue|--spec|--branch|--worktree|--closing|--env|--extra|--merge-gate|--merge-check|--mutant-job|--workflow-doc)
      [ $# -ge 2 ] || usage; v="${1#--}"; printf -v "${v//-/_}" '%s' "$2"; shift 2 ;;
    --help|-h|-*|*) usage ;;
  esac
done
# --files: repeats and spaces both separate paths; squeeze the commas they leave.
while [[ $files == *,,* ]]; do files="${files//,,/,}"; done
files="${files#,}"; files="${files%,}"
for v in run repo issue spec branch worktree workflow_doc closing; do [ -n "${!v}" ] || { echo "tkt-start: missing required flag: --${v//_/-}" >&2; exit 2; }; done
if [ "$takeover_given" -eq 1 ]; then
  if [ -z "${takeover_ref//[[:space:]]/}" ] || [[ $takeover_ref == -* ]] || [[ $takeover_ref == *[[:space:]]* ]]; then
    echo "tkt-start: --takeover needs one PR or branch reference with no whitespace: $takeover_ref" >&2
    exit 2
  fi
  if [ -z "$files" ]; then
    echo "tkt-start: --takeover requires non-blank --files PATHS" >&2
    exit 2
  fi
  if [ "$takeover_gate_given" -ne 1 ] || [ -z "${takeover_gate//[[:space:]]/}" ]; then
    echo "tkt-start: --takeover requires a non-blank --gate CMD" >&2
    exit 2
  fi
  case "$takeover_gate" in *$'\n'*) echo "tkt-start: --gate CMD holds a newline" >&2; exit 2 ;; esac
elif [ "$takeover_gate_given" -eq 1 ]; then
  echo "tkt-start: --gate CMD requires --takeover PR-OR-BRANCH" >&2
  exit 2
fi
if [[ $env =~ (^|[[:space:]])([^[:space:]=]+)=([[:space:]]|$) ]]; then
  echo "tkt-start: --env sets ${BASH_REMATCH[2]} to an empty value; drop it or give it a value" >&2
  exit 2
fi
case "$issue" in *[!0-9]*) echo "tkt-start: --issue needs a number: $issue" >&2; exit 2 ;; esac
if [ "$part_given" -eq 1 ]; then
  case "$part" in ""|*[!0-9]*) echo "tkt-start: --part needs an integer of 2 or more: $part" >&2; exit 2 ;; esac
  part="$((10#$part))"
  if [ "$part" -lt 2 ]; then echo "tkt-start: --part needs an integer of 2 or more: $part" >&2; exit 2; fi
fi
if [ "$spec_issue_given" -eq 1 ]; then
  if [[ ! $spec_issue =~ ^0*[1-9][0-9]*$ ]]; then echo "tkt-start: --spec-issue needs a positive integer: $spec_issue" >&2; exit 2; fi
fi
for m in ${models[@]+"${models[@]}"}; do
  case "$m" in *=*) ;; *) echo "tkt-start: --model needs ROLE=ID: $m" >&2; exit 2 ;; esac
  model_role="${m%%=*}"; known_role=0
  for role in "${model_roles[@]}"; do
    if [ "$role" = "$model_role" ]; then known_role=1; break; fi
  done
  if [ "$known_role" -eq 0 ]; then
    known_roles="$(printf '%s, ' "${model_roles[@]}")"; known_roles="${known_roles%, }"
    echo "tkt-start: unknown --model role '$model_role'; known roles: $known_roles" >&2
    exit 2
  fi
done
case "$merge_gate" in ""|ci|gate) ;; *) echo "tkt-start: --merge-gate needs ci or gate: $merge_gate" >&2; exit 2 ;; esac
# A blank check line can never match a PR body, and a newline breaks the
# state line, so both exit before any state write. The given flag tells a
# repeat or an empty value apart from no flag at all.
if [ "$body_ends_given" -eq 1 ]; then
  if [ -z "${body_ends//[[:space:]]/}" ]; then echo "tkt-start: --body-ends needs a value that is not blank" >&2; exit 2; fi
  case "$body_ends" in *$'\n'*) echo "tkt-start: --body-ends value holds a newline" >&2; exit 2 ;; esac
fi
spec_part=0; spec_exists=0
if [ -f "$spec" ]; then spec_exists=1; grep -qiE 'part of[[:space:]]+#[0-9]+' "$spec" && spec_part=1; fi
close_part=0; printf '%s' "$closing" | grep -qiE '^part of([[:space:]]|$)' && close_part=1
if [ "$spec_part" -ne "$close_part" ]; then
  if [ "$spec_part" -eq 1 ]; then
    echo "tkt-start: --closing '$closing' is not a Part-of closing, but --spec '$spec' contains 'Part of #N'" >&2
  elif [ "$spec_exists" -eq 0 ]; then
    echo "tkt-start: --closing '$closing' is a Part-of closing, but --spec '$spec' does not exist (it must hold the ticket body with 'Part of #N')" >&2
  else
    echo "tkt-start: --closing '$closing' is a Part-of closing, but --spec '$spec' has no 'Part of #N'" >&2
  fi
  exit 2
fi
script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
tkt_state="$script_dir/tkt-state"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then echo "tkt-start: cannot read shared lib: $namebase_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$namebase_lib"
bin_dir="${TKT_BIN:-$HOME/.agents/bin}"; sweep="$bin_dir/plan-sweep"; tktjob="$bin_dir/tkt-job"
set_namebase "$repo" "$issue"; state="$run/$namebase.state"; mkdir -p "$run"
tkt() { "$tkt_state" "$state" "$@"; }
part_notes=()
emit() {
  local rest="$1" code="$2"; shift 2; local twelve log out note
  twelve="$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf nohead)"
  log="$run/$namebase-tkt-start-$twelve-$(date +%H%M%S).log"; out="TKT tkt-start $rest log=$log"
  [ $# -eq 0 ] || out="$out
$(printf '%s\n' "$@" | head -n 40)"
  for note in ${part_notes[@]+"${part_notes[@]}"}; do out="$out
$note"; done
  printf '%s\n' "$out" | tee "$log"; exit "$code"
}
fail_step() {
  local msg="tkt-start: $1 failed (rc=$2)"
  [ $# -ge 3 ] && [ -n "$3" ] && msg="$msg: $(printf '%s' "$3" | tail -n 20)"
  printf '%s\n' "$msg" >&2; emit "STEP-FAIL step=$1 rc=$2" "$2" "$msg"
}
if [ ! -e "$worktree" ] && ! git rev-parse --git-dir >/dev/null 2>&1; then
  fail_step repo 128 "run from inside $repo's checkout"
fi
deny() { printf '%s\n' "$3" >&2; emit "$1" "$2" "$3"; }
lockdir="$state.lock"; lock_owned=0
lock_or_busy() {
  if ! mkdir "$lockdir" 2>/dev/null; then
    holder="$(cat "$lockdir/pid" 2>/dev/null || true)"; [ -n "$holder" ] || holder="unknown"
    deny "BUSY holder=$holder" 2 "tkt-start: state locked by pid $holder"
  fi
  lock_owned=1
}
release_lock() {
  if [ "$lock_owned" -eq 1 ]; then
    rmdir "$lockdir" 2>/dev/null || return 1
    lock_owned=0
  fi
}
trap 'release_lock || true' EXIT
pr_state() { gh pr view "$1" --repo "$repo" --json state --jq '.state' 2>/dev/null; }
lock_or_busy
release_lock
if [ "$part_given" -eq 1 ]; then
  if [ -f "$state" ]; then
    lock_or_busy
    if [ -f "$state" ]; then
      locked_part="$(sed -n 's/^part=//p' "$state" | head -n1)"
      archive_candidate=1
      if [ -n "$locked_part" ] || grep -q '^part=' "$state"; then
        case "$locked_part" in
          ""|*[!0-9]*) deny "PRECONDITION part=$part" 2 "tkt-start: --part $part found non-numeric stored part '$locked_part'" ;;
          *) if [ "$locked_part" -ge "$part" ]; then archive_candidate=0; fi ;;
        esac
      fi
      if [ "$archive_candidate" -eq 1 ]; then
        if [ -z "$locked_part" ]; then
          if [ "$part" -eq 2 ]; then locked_part=1
          else deny "PRECONDITION part=$part missing" 2 "tkt-start: --part $part needs a stored part key; part is missing"; fi
        fi
        pr="$(tkt get pr 2>/dev/null)" || pr=none
        if [ "$pr" = "none" ]; then
          deny "PRECONDITION part=$part pr=none" 2 "tkt-start: --part $part needs part $((part - 1))'s PR merged: pr=none state=unreadable"
        fi
        pr_state="$(pr_state "$pr")" || pr_state=""
        pr_state="${pr_state:-unreadable}"
        if [ "$pr_state" != "MERGED" ]; then
          deny "PRECONDITION part=$part pr=$pr" 2 "tkt-start: --part $part needs part $((part - 1))'s PR merged: pr=$pr state=$pr_state"
        fi
        archive="$state.part$((part - 1))"
        if [ -e "$archive" ]; then
          deny "PRECONDITION part=$part archive=$archive" 2 "tkt-start: archive already exists: $archive"
        fi
        carried_models=()
        carried_verdict=""; carried_verdict_base=""; carried_verdict_hash=""
        verdict_seen=0; verdict_base_seen=0; verdict_hash_seen=0
        while IFS= read -r state_line || [ -n "$state_line" ]; do
          case "$state_line" in
            plan_verdict_base=*)
              carried_verdict_base="${state_line#plan_verdict_base=}"; verdict_base_seen=1
              ;;
            plan_verdict_hash=*)
              carried_verdict_hash="${state_line#plan_verdict_hash=}"; verdict_hash_seen=1
              ;;
            plan_verdict=*)
              carried_verdict="${state_line#plan_verdict=}"; verdict_seen=1
              ;;
            model.*=*)
              model_key="${state_line%%=*}"; model_role="${model_key#model.}"; model_replaced=0
              for m in ${models[@]+"${models[@]}"}; do
                if [ "${m%%=*}" = "$model_role" ]; then model_replaced=1; fi
              done
              if [ "$model_replaced" -eq 0 ]; then
                carried_models+=("$state_line")
                part_notes+=("carried $state_line from part $((part - 1)); pass --model ${state_line#model.} to change it")
              fi
              ;;
          esac
        done <"$state"
        if ! mv "$state" "$archive"; then
          deny "PRECONDITION part=$part archive=$archive" 2 "tkt-start: cannot archive state: $state -> $archive"
        fi
        release_lock
        tkt set part "$part"
        for model_line in ${carried_models[@]+"${carried_models[@]}"}; do
          tkt add "${model_line%%=*}" "${model_line#*=}"
        done
        if [ "$verdict_seen" -eq 1 ]; then tkt set plan_verdict "$carried_verdict"; fi
        if [ "$verdict_base_seen" -eq 1 ]; then tkt set plan_verdict_base "$carried_verdict_base"; fi
        if [ "$verdict_hash_seen" -eq 1 ]; then tkt set plan_verdict_hash "$carried_verdict_hash"; fi
        tkt journal "tkt-start archived state part$locked_part pr=$pr -> $archive"
      fi
    fi
    release_lock
  fi
  if [ ! -f "$state" ]; then tkt set part "$part"; fi
fi
if stored_head="$(tkt get head 2>/dev/null)"; then
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || printf unknown)"; pr_head=""
  if pr="$(tkt get pr 2>/dev/null)"; then
    pr_head="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq '.headRefOid' 2>/dev/null || true)"
    [ -n "$pr_head" ] || deny "PRECONDITION pr=unreadable" 2 "tkt-start: cannot read PR head: pr=$pr repo=$repo"
  fi
  if [ "$stored_head" != "$actual" ] || { [ -n "$pr_head" ] && [ "$stored_head" != "$pr_head" ]; }; then
    drift_message="tkt-start: head drift: state head=$stored_head worktree $worktree HEAD=$actual pr ${pr:-none} head=${pr_head:-none}; reconcile the state, worktree, and PR heads before rerunning tkt-start"
    if [ -n "${pr:-}" ]; then
      pr_state="$(pr_state "$pr")" || pr_state=""
      if [ "$pr_state" = "MERGED" ]; then
        stored_part="$(tkt get part 2>/dev/null || printf '1')"
        case "$stored_part" in
          ""|*[!0-9]*) ;;
          *) next_part=$((stored_part + 1)); drift_message="tkt-start: head drift: pr $pr is merged (state head=$stored_head worktree $worktree HEAD=$actual); start the next part with --part $next_part" ;;
        esac
      fi
    fi
    deny "DRIFT state=$stored_head worktree=$actual pr=${pr_head:-none}" 3 "$drift_message"
  fi
fi
for k in repo issue spec branch worktree run workflow_doc closing; do tkt set "$k" "${!k}"; done
for k in env extra merge_gate merge_check mutant_job; do [ -n "${!k}" ] && tkt set "$k" "${!k}"; done
if [ "$takeover_given" -eq 1 ]; then
  tkt set plan "takeover $takeover_ref"
  tkt set gate "$takeover_gate"
  if [ -n "$files" ]; then
    IFS=',' read -ra takeover_paths <<<"$files"
    for takeover_path in ${takeover_paths[@]+"${takeover_paths[@]}"}; do
      takeover_path="$(printf '%s' "$takeover_path" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
      [ -n "$takeover_path" ] || continue
      tkt list fence 2>/dev/null | grep -xF -- "$takeover_path" >/dev/null || tkt add fence "$takeover_path"
    done
  fi
fi
if [ "$body_ends_given" -eq 1 ]; then tkt set body_ends "$body_ends"; fi
if [ "$spec_issue_given" -eq 1 ]; then tkt set spec_issue "$spec_issue"; fi
for b in ${body_has[@]+"${body_has[@]}"}; do tkt list body_has 2>/dev/null | grep -xF -- "$b" >/dev/null || tkt add body_has "$b"; done
for m in ${models[@]+"${models[@]}"}; do tkt list "model.${m%%=*}" 2>/dev/null | grep -xF -- "${m#*=}" >/dev/null || tkt add "model.${m%%=*}" "${m#*=}"; done
tkt journal "tkt-start state repo=$repo issue=$issue branch=$branch"
# Repo reads go through the worktree once it exists, so a rerun works from
# any directory; creating it still runs in the caller's repo.
gdir="."; [ -e "$worktree" ] && gdir="$worktree"
ferr="$(git -C "$gdir" fetch -q origin 2>&1)" || fail_step fetch "$?" "$ferr"
base="$(git -C "$gdir" rev-parse origin/main 2>&1)" || fail_step fetch "$?" "$base"
wt_note="reused"; if [ ! -e "$worktree" ]; then
  werr="$(git worktree add --no-track -b "$branch" "$worktree" origin/main 2>&1)" || fail_step worktree "$?" "$werr"
  wt_note="created"
fi
# Seed the repo gate once so a planner cannot omit the script check in its Gate line.
if [ -z "$(tkt get gate.script 2>/dev/null || true)" ] \
  && [ -f "$worktree/scripts/check" ] && [ -x "$worktree/scripts/check" ]; then
  tkt set gate.script scripts/check
fi
tkt journal "tkt-start worktree $worktree $wt_note"; fpaths=()
if [ -n "$files" ]; then IFS=',' read -ra parts <<<"$files"
  for p in ${parts[@]+"${parts[@]}"}; do p="$(printf '%s' "$p" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"; [ -n "$p" ] && fpaths+=("$p"); done; fi
stale=""; reason=""; filing=""; lognote="not run"; sincenote="no edit info"
# --no-preflight skips the whole currency check: no issue-body read, no log.
if [ "$no_preflight" -eq 0 ]; then
for p in ${fpaths[@]+"${fpaths[@]}"}; do git -C "$worktree" cat-file -e "origin/main:$p" 2>/dev/null || { stale=1; reason="missing-file:$p"; break; }; done
if [ -z "$stale" ]; then
  body="$(gh issue view "$issue" --repo "$repo" --json body --jq '.body' 2>&1)" || fail_step github "$?" "$body"
  filing="$(printf '%s\n' "$body" | grep -oE '(Written against|filing commit:) [0-9a-f]{7,40}' | sed -n '1s/.* //p' || true)"
  { [ -n "$filing" ] && git -C "$worktree" cat-file -e "$filing^{commit}" 2>/dev/null; } || { stale=1; reason="filing-commit:unreadable"; filing=""; }
fi
if [ -z "$stale" ]; then rc=0; logout=""
  logout="$(git -C "$worktree" log --oneline "$filing..origin/main" -- ${fpaths[@]+"${fpaths[@]}"} 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then stale=1; reason="log:failed"; lognote="failed"
  elif [ -n "$logout" ]; then stale=1; reason="log:$filing..origin/main"; lognote="$(printf '%s' "$logout" | grep -c . || true) lines"
  else lognote="empty"; fi
fi
if [ -n "$filing" ]; then
  owner="${repo%%/*}"; name="${repo##*/}"
  edited="$(gh api graphql -F owner="$owner" -F name="$name" -F number="$issue" -f query='query ($owner: String!, $name: String!, $number: Int!) { repository(owner: $owner, name: $name) { issue(number: $number) { lastEditedAt } } }' --jq '.data.repository.issue.lastEditedAt' 2>&1)" || fail_step github "$?" "$edited"
  [ "$edited" = "null" ] && edited=""
  if [ -n "$edited" ] && [ -z "$(git -C "$worktree" log -1 --format=%H --since="$edited" "$filing" 2>/dev/null || true)" ]; then rc=0; sincelog=""
    sincelog="$(git -C "$worktree" log --oneline --since="$edited" "$filing..origin/main" -- ${fpaths[@]+"${fpaths[@]}"} 2>&1)" || rc=$?
    if [ "$rc" -ne 0 ]; then stale=1; reason="since:failed"; sincenote="since=$edited failed"
    elif [ -n "$sincelog" ]; then sincenote="since=$edited non-empty"; [ -n "$stale" ] || { stale=1; reason="since:$edited"; }
    else sincenote="since=$edited empty"; fi
  elif [ -n "$edited" ]; then sincenote="edited=$edited not after filing"; fi
fi
fi
dg=("state=$state" "worktree=$worktree $wt_note" "filing=${filing:-none} base=$base" "files=${files:-none}" "log ${filing:-none}..origin/main: $lognote" "$sincenote")
# Merged PRs mentioning the issue run before the CURRENT exit, the
# --no-preflight SKIPPED exit and the preflight dispatch. A Resolves line stops the
# run, unless the issue recurred: OPEN with a comment strictly newer than
# the newest Resolves merge. A recurrence only appends a NOTE naming the
# newest PR and the run continues. A Part-of line notes the PR and its
# files and the run continues. The number's boundary is a non-digit, so
# #42 never matches #421, and Resolves wins over Part-of. A Resolves merge
# without a readable timestamp blocks the inference, and a comment without
# one is ignored: neither can be called newer, so the run stops as before.
# Both stamps share one fixed-width UTC shape, ordered by jq's codepoint
# string compare, never by locale collation.
ts_re='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
merged="$(gh pr list --repo "$repo" --state merged --search "#$issue in:body" --limit 100 --json number,body,mergedAt 2>&1)" || fail_step github "$?" "$merged"
stop_pr=""; notes=(); recur_pr=""; recur_at=""; recur_ok=1; pr_count="$(printf '%s' "$merged" | jq 'if type == "array" then length else 0 end')"
idx=0; while [ "$idx" -lt "$pr_count" ]; do
  pr_num="$(printf '%s' "$merged" | jq -r ".[$idx].number")"
  pr_body="$(printf '%s' "$merged" | jq -r ".[$idx].body // \"\"")"
  if printf '%s' "$pr_body" | grep -qiE "Resolves[[:space:]]+#$issue([^0-9]|$)"; then [ -n "$stop_pr" ] || stop_pr="$pr_num"
    pr_merged="$(printf '%s' "$merged" | jq -r ".[$idx].mergedAt // \"\"")"
    if [[ "$pr_merged" =~ $ts_re ]]; then
      if [ -z "$recur_at" ] || [ "$(jq -n --arg a "$recur_at" --arg b "$pr_merged" '$a < $b')" = "true" ]; then
        recur_at="$pr_merged"; recur_pr="$pr_num"
      fi
    else recur_ok=0; fi
  elif printf '%s' "$pr_body" | grep -qiE "Part of[[:space:]]+#$issue([^0-9]|$)"; then
    pr_files="$(gh api --paginate "repos/$repo/pulls/$pr_num/files?per_page=100" -q '.[].filename' 2>&1)" || fail_step github "$?" "$pr_files"
    pr_files="$(printf '%s\n' "$pr_files" | paste -sd, -)"
    notes+=("NOTE merged Part-of PR #$pr_num files=$pr_files")
  fi
  idx=$((idx+1))
done
if [ -n "$stop_pr" ] && [ "$recur_ok" -eq 1 ]; then
  issue_json="$(gh issue view "$issue" --repo "$repo" --json state,comments 2>&1)" || fail_step github "$?" "$issue_json"
  recur_hit="$(printf '%s' "$issue_json" | jq --arg at "$recur_at" 'if type == "object" and has("state") then .state == "OPEN" and ([.comments[]? | select(type == "object") | .createdAt | select(type == "string") | select(test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) | select(. > $at)] | length > 0) else error("no issue state") end' 2>&1)" || fail_step github "$?" "$recur_hit"
  if [ "$recur_hit" = "true" ]; then notes+=("NOTE recurred after merged PR #$recur_pr"); stop_pr=""; fi
fi
[ -n "$stop_pr" ] && deny "MERGED-STOP pr=$stop_pr" 1 "tkt-start: issue #$issue already resolved by merged PR #$stop_pr"
part_notes+=(${notes[@]+"${notes[@]}"})
# With --mutant-job, the branch PR must carry the mutants label, or ship-pr
# later refuses the draft for lacking it. When the repo defines the label
# (the same labels read ship-pr checks), add it to the branch's open PR when
# missing. No PR yet still skips, but a failed lookup fails loud like a
# refused edit instead of leaving the PR unlabelled.
if [ -n "$mutant_job" ]; then
  branch_pr="$(gh pr list --head "$branch" --repo "$repo" --json number --jq '.[0].number // empty' 2>&1)" || fail_step github "$?" "$branch_pr"
  if [ -n "$branch_pr" ]; then
    repo_labels="$(gh api --paginate "repos/$repo/labels?per_page=100" --jq '.[].name' 2>&1)" || fail_step github "$?" "$repo_labels"
    if grep -qx 'mutants' <<<"$repo_labels"; then
      pr_labels="$(gh pr view "$branch_pr" --repo "$repo" --json labels --jq '.labels[].name' 2>&1)" || fail_step github "$?" "$pr_labels"
      if ! grep -qx 'mutants' <<<"$pr_labels"; then
        edit_err="$(gh pr edit "$branch_pr" --repo "$repo" --add-label mutants 2>&1)" \
          || fail_step github "$?" "$edit_err"
        tkt journal "tkt-start mutants label pr=$branch_pr"
      fi
    fi
  fi
fi
# Every deny is behind us: only a start that gets this far drops the last
# run's plan-comment id, so a refused start leaves it alone (#1517).
tkt set post_run ""
# Claim takeover files before the lane resumes; file-claim treats the same ticket holder as an existing hold.
if [ "$takeover_given" -eq 1 ] && [ -n "$files" ]; then
  file_claim="${FW_FILE_CLAIM:-$script_dir/file-claim}"
  claim_host="$(hostname -s 2>/dev/null || hostname 2>/dev/null || printf unknown)"
  claim_out="$("$file_claim" claim --lane "fiber-$issue" --paths --repo "$repo" \
    --worktree "$claim_host:$worktree" -- "${fpaths[@]}" 2>&1)" \
    || fail_step file-claim "$?" "$claim_out"
  tkt journal "tkt-start takeover claims files=${files}"
fi
if [ "$no_preflight" -eq 1 ]; then tkt journal "tkt-start check SKIPPED filing=${filing:-none}"; emit "SKIPPED filing=${filing:-none} files=${files:-none}" 0 "${dg[@]}"; fi
if [ -n "$stale" ]; then dg=("reason=$reason" ${dg[@]+"${dg[@]}"}); tkt journal "tkt-start check STALE reason=$reason filing=${filing:-none}"
else tkt journal "tkt-start check CURRENT filing=$filing"; emit "CURRENT filing=$filing files=${files:-none}" 0 "${dg[@]}"; fi
sweep_out="none"; out="$run/$namebase-preflight-out.md"
if [ "${#fpaths[@]}" -gt 0 ]; then sweep_out="$run/$namebase-sweep.md"; rc=0; sweep_txt=""
  sweep_txt="$("$sweep" --cwd "$worktree" --base origin/main --files "$files" --out "$sweep_out" 2>&1)" || rc=$?
  if [ "$rc" -ne 0 ]; then if [ "$rc" -eq 1 ] && [ -n "$sweep_txt" ] && ! printf '%s\n' "$sweep_txt" | grep -qv '^unresolved '; then :; else fail_step plan-sweep "$rc" "$sweep_txt"; fi; fi
  [ -f "$sweep_out" ] || sweep_out="none"; fi
jrc=0; job_txt="$("$tktjob" "$state" --slot preflight --template "$HOME/.agents/skills/planning/briefs/preflight.md" --out-file "$out" "ISSUE=$issue" "SPEC=$spec" "REPO=$repo" "BASE=$base" "WORKFLOW_DOC=$workflow_doc" "PACK=$sweep_out" 2>&1)" || jrc=$?
# DONE_WITH_CONCERNS exits 1 with its report on disk: the report is the product.
if [ "$jrc" -ne 0 ]; then
  case "$(grep -m1 '^TKT tkt-job ' <<<"$job_txt" || head -n 1 <<<"$job_txt")" in
    "TKT tkt-job CONCERNS "*) [ "$jrc" -eq 1 ] && [ -f "$out" ] || fail_step tkt-job "$jrc" "$job_txt" ;;
    *) fail_step tkt-job "$jrc" "$job_txt" ;;
  esac
fi
[ -f "$out" ] || fail_step tkt-job 1 "no out file: $out"
core="$(grep -E '^Core items: [0-9]+$' "$out" | tail -n 1 | sed -n 's/^Core items: \([0-9][0-9]*\)$/\1/p' || true)"
nb="$(grep -E '^Non-blocking items: [0-9]+$' "$out" | tail -n 1 | sed -n 's/^Non-blocking items: \([0-9][0-9]*\)$/\1/p' || true)"
[ -n "$nb" ] || nb=0
[ -n "$core" ] || core=unknown
tkt journal "tkt-start preflight core=$core out=$out"; dg+=("sweep=$sweep_out" "out=$out"); report="$(head -n 30 "$out")"
if [ "$core" = unknown ]; then emit "PREFLIGHT core=unknown out=$out" 1 "${dg[@]}" "tkt-start: preflight report has no 'Core items:' line" "$report"; fi
[ "$core" -eq 0 ] && emit "PREFLIGHT core=0 nonblocking=$nb out=$out" 0 "${dg[@]}" "$report" || emit "PREFLIGHT core=$core out=$out" 1 "${dg[@]}" "$report"
