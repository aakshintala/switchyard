#!/usr/bin/env bash
# tkt-build: implement steps 4-6, first round (lane, gate, mutants, review+map, findings).
# spec_issue, when set, is passed to every round-0 review-pr start as --spec.
# Usage: tkt-build <state> [--from lane|gate|review] [--no-verifier] [--lane-model <id>] [--review-model <id>] [--overbuild-model <id>]
set -euo pipefail
USAGE="usage: tkt-build <state> [--from lane|gate|review] [--no-verifier] [--lane-model <id>] [--review-model <id>] [--overbuild-model <id>]"
usage() { echo "$USAGE" >&2; exit 2; }
[ $# -ge 1 ] || usage
case "$1" in -h|--help) echo "$USAGE"; exit 0 ;; esac
state="$1"; shift
from=lane; no_verifier=0; lane_model=""; review_model=""; overbuild_model=""
while [ $# -gt 0 ]; do
  case "$1" in
    --from) [ $# -ge 2 ] || usage; from="$2"; shift 2 ;;
    --no-verifier) no_verifier=1; shift ;;
    --lane-model) [ $# -ge 2 ] || usage; lane_model="$2"; shift 2 ;;
    --review-model) [ $# -ge 2 ] || usage; review_model="$2"; shift 2 ;;
    --overbuild-model) [ $# -ge 2 ] || usage; overbuild_model="$2"; shift 2 ;;
    *) usage ;;
  esac
done
case "$from" in lane|gate|review) ;; *) usage ;; esac
script_dir="$(cd "$(dirname "$0")" && pwd)"
tkt_state="$script_dir/tkt-state"
tokens_lib="$script_dir/lib/plan-tokens.sh"
if [ ! -r "$tokens_lib" ]; then echo "tkt-build: cannot read shared lib: $tokens_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$tokens_lib"
bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
tktjob="$bin_dir/tkt-job"; tktgate="$bin_dir/tkt-gate"; ghci="$bin_dir/gh-ci"
mverd="$bin_dir/mutant-verdicts"
reviewpr="$bin_dir/review-pr"; plangate="$bin_dir/plan-gate"
delegate="${TKT_BIN:+$TKT_BIN/}delegate"
lane_brief="$HOME/.agents/skills/planning/briefs/lane.md"
map_brief="$HOME/.agents/skills/review-loop/briefs/mutant-map.md"
tkt() { "$tkt_state" "$state" "$@"; }
lockdir="$state.lock"
if mkdir "$lockdir" 2>/dev/null; then rmdir "$lockdir"
elif pid="$(cat "$lockdir/pid" 2>/dev/null)" && [ -n "${pid:-}" ]; then
  echo "tkt-build: state locked by pid $pid" >&2; exit 2
else echo "tkt-build: state locked" >&2; exit 2; fi
tmpd="$(mktemp -d "${TMPDIR:-/tmp}/tkt-build.XXXXXX")"
trap 'rm -rf "$tmpd"' EXIT
emit() {
  local verdict="$1" ec="$2"; shift 2
  local rdir="${run:-$(dirname "$state")}"; mkdir -p "$rdir" 2>/dev/null || true
  local twelve="nohead"
  [ -z "${worktree:-}" ] || twelve="$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')"
  local logpath="$rdir/${slug:-build}-${issue:-0}-tkt-build-$twelve-$(date +%H%M%S).log"
  local out="TKT tkt-build $verdict log=$logpath"
  [ $# -eq 0 ] || out="$out
$(printf '%s\n' "$@" | head -n 40)"
  printf '%s\n' "$out" | tee -a "$logpath"
  tkt journal "tkt-build $verdict" 2>/dev/null || true
  exit "$ec"
}
require_keys() {
  req_err="$(tkt require "$@" 2>&1)" || {
    printf '%s\n' "$req_err" >&2
    key="$(sed -n 's/.*missing key: //p' <<<"$req_err" | head -n 1)"
    emit "PRECONDITION missing=${key:-unknown}" 2 "$req_err"
  }
}
forward() {
  local step="$1" inner="$2" rc="$3" err="$4" first words rest
  first="$(head -n 1 <<<"$inner")"
  case "$first" in
    "TKT tkt-"*)
      words="$(sed -e 's/^TKT tkt-[^ ]* //' -e 's/ log=[^ ]*$//' <<<"$first")"
      rest="$(tail -n +2 <<<"$inner")"
      [ -n "$rest" ] && emit "$words" "$rc" "$rest" || emit "$words" "$rc" ;;
    *) cat "$err" >&2; emit "$step-ERROR" "$rc" "$(tail -n 20 "$err")" ;;
  esac
}
require_keys repo issue branch worktree run plan
repo="$(tkt get repo)"; issue="$(tkt get issue)"; branch="$(tkt get branch)"
worktree="$(tkt get worktree)"; run="$(tkt get run)"; plan="$(tkt get plan)"
slug="${repo//\//-}"; mkdir -p "$run"
# First-round tool: a state with a round already counted continues with tkt-fix or tkt-ship.
rnd="$(tkt get round 2>/dev/null || true)"
[ -z "$rnd" ] || emit "ROUND-LIMIT round=$rnd" 1 "tkt-build is the first round; continue with tkt-fix or tkt-ship"
if stored_head="$(tkt get head 2>/dev/null)"; then
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
  if [ "$from" = review ]; then pr0="$(tkt get pr 2>/dev/null || true)"; early_pr="$(gh pr view "$pr0" --repo "$repo" --json headRefOid --jq '.headRefOid' 2>/dev/null || true)"
  else early_pr="$(gh pr list --head "$branch" --repo "$repo" --json headRefOid 2>/dev/null | jq -r '.[0].headRefOid // empty' 2>/dev/null || true)"; fi
  if [ "$stored_head" != "$actual" ] || [ "$stored_head" != "$early_pr" ]; then
    msg="tkt-build: head drift: state $state head=$stored_head worktree $worktree HEAD=$actual pr ${early_pr:-unreadable}"
    printf '%s\n' "$msg" >&2; emit "DRIFT state=$stored_head worktree=$actual pr=${early_pr:-unreadable}" 3 "$msg"
  fi
fi
base="$(plan_base "$plan" 2>/dev/null || true)"
[ -n "$base" ] || emit "PRECONDITION missing=base" 2 "tkt-build: no Base line in $plan"
# debt: a copy of tkt-plan's plan_verdict_ok (and its write pair in do_verify and do_confirm).
# Ceiling: two copies plus the write pair, in tkt-plan and tkt-build. Upgrade trigger: a third
# caller of the verdict check; then move it to bin/lib/ and source it from both scripts.
verdict="$(tkt get plan_verdict 2>/dev/null || true)"
verdict_base="$(tkt get plan_verdict_base 2>/dev/null || true)"
if [ -z "$verdict" ] && [ "$no_verifier" -eq 1 ]; then
  tkt set plan_verdict skipped
  tkt set plan_verdict_base "$base"
  verdict=skipped
  verdict_base="$base"
fi
if { [ "$verdict" = ok ] || [ "$verdict" = skipped ]; } && [ "$verdict_base" = "$base" ]; then
  :
else
  case "$verdict" in
    "") verdict_refusal=none ;;
    ok|skipped) verdict_refusal=stale ;;
    *) verdict_refusal="$verdict" ;;
  esac
  [ -n "$verdict" ] || verdict=none
  [ -n "$verdict_base" ] || verdict_base=none
  emit "VERDICT-REFUSED verdict=$verdict_refusal" 1 "plan_verdict=$verdict plan_verdict_base=$verdict_base plan_base=$base"
fi
# Only the first backticked token of a Files line is its path column; later ones are
# prose (`reads`, `/reload`) that git would take as pathspecs. plan-check and plan-sweep
# read every token (lib/plan-tokens.sh) because they check coverage, not staleness.
plan_files=()
while IFS= read -r p; do plan_files+=("$p"); done < <(plan_files_pathspecs "$plan")
if [ "${#plan_files[@]}" -gt 0 ]; then
  stat_out="$(git -C "$worktree" diff --stat "$base...origin/main" -- "${plan_files[@]}" 2>"$tmpd/git-err")" || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
  if [ -n "$stat_out" ]; then
    n="$(git -C "$worktree" diff --name-only "$base...origin/main" -- "${plan_files[@]}" 2>/dev/null | wc -l | tr -d ' ')"
    emit "STALE n=$n base=$base" 1 "$stat_out"
  fi
fi
context_args=(); context_file=""
if [ "$from" = lane ]; then
  require_keys closing workflow_doc
  closing="$(tkt get closing)"
  gate_cmd="$("$plangate" "$plan" 2>"$tmpd/pg-err")" || emit "PRECONDITION missing=gate" 2 "$(cat "$tmpd/pg-err")"
  # body_ends wins; a missing or blank body_ends falls through to the body_has co-author.
  attr="$(tkt get body_ends 2>/dev/null || true)"
  if [ -z "${attr//[[:space:]]/}" ]; then
    attr="$(tkt list body_has 2>/dev/null | grep -i 'co-author' | head -n 1 || true)"
  fi
  lane_model="${lane_model:-$(tkt get model.lane 2>/dev/null || true)}"
  # A lane with no model names the missing key on stderr and stops before dispatch.
  if [ -z "$lane_model" ]; then
    printf '%s\n' "tkt-build: missing key: model.lane (no --lane-model and no state model.lane)" >&2
    emit "PRECONDITION missing=model.lane" 2 "tkt-build: no lane model: the lane slot has no id (pass --lane-model or set model.lane)"
  fi
  lane_args=(--slot lane --template "$lane_brief" --gate-from-plan --expect-commits "BASE=$base" "GATE=$gate_cmd" "CLOSING=$closing" "ATTRIBUTION=$attr" "LANE_MODEL=$lane_model")
  lane_args+=(--model "$lane_model")
  rc=0; lane_out="$("$tktjob" "$state" "${lane_args[@]}" 2>"$tmpd/lane-err")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    lane_verdict="$(head -n 1 <<<"$lane_out")"
    if [ "$rc" -eq 1 ] && [[ "$lane_verdict" == "TKT tkt-job CONCERNS "* ]]; then
      context_file="$(tkt get concerns.lane 2>/dev/null || true)"
      if [ -n "$context_file" ]; then context_args=(--context "$context_file"); fi
    else
      forward LANE "$lane_out" "$rc" "$tmpd/lane-err"
    fi
  fi
fi
if [ "$from" != lane ]; then
  context_file="$(tkt get concerns.lane 2>/dev/null || true)"
  if [ -n "$context_file" ]; then context_args=(--context "$context_file"); fi
fi
if [ "$from" != review ]; then
  pr_json="$(gh pr list --head "$branch" --repo "$repo" --json number,headRefOid 2>/dev/null || true)"
  pr="$(jq -r '.[0].number // empty' <<<"$pr_json" 2>/dev/null || true)"
  head="$(jq -r '.[0].headRefOid // empty' <<<"$pr_json" 2>/dev/null || true)"
  [ -n "${pr:-}" ] && [ -n "${head:-}" ] || emit "PRECONDITION missing=pr" 2 "tkt-build: no PR for branch $branch (gh pr list --head $branch --json number,headRefOid)"
  tkt set pr "$pr"; tkt set head "$head"
else
  require_keys pr head; pr="$(tkt get pr)"; head="$(tkt get head)"
  pr_head="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq '.headRefOid' 2>/dev/null || true)"
  if [ "$pr_head" != "$head" ]; then
    msg="tkt-build: head drift: state head=$head worktree $worktree HEAD=$head pr $pr head=${pr_head:-unreadable}"
    printf '%s\n' "$msg" >&2; emit "DRIFT state=$head worktree=$head pr=${pr_head:-unreadable}" 3 "$msg"
  fi
fi
if [ "$from" != review ]; then
  rc=0; gate_out="$("$tktgate" "$state" --expect-head "$head" 2>"$tmpd/gate-err")" || rc=$?
  [ "$rc" -eq 0 ] || forward GATE "$gate_out" "$rc" "$tmpd/gate-err"
fi
mutants_file=""; mutant_count=0; mutant_run=""; listing_note=""
if mutant_job="$(tkt get mutant_job 2>/dev/null)" && [ -n "$mutant_job" ]; then
  mutants_file="$run/$slug-$issue-mutants-${head:0:12}.txt"; : >"$mutants_file"
  listing_rc=0
  "$ghci" wait "$pr" --job "$mutant_job" --timeout 600 --repo "$repo" >/dev/null 2>"$tmpd/listing-err" || listing_rc=$?
  if [ "$listing_rc" -ne 0 ]; then
    listing_note="$(head -n 1 "$tmpd/listing-err" 2>/dev/null || true)"
    [ -n "$listing_note" ] || listing_note="gh-ci wait --job failed with exit $listing_rc"
  fi
  tmp_log="$tmpd/mutant-log"; : >"$tmp_log"
  runs="$(gh run list --repo "$repo" --commit "$head" --limit 5 --json databaseId 2>/dev/null | jq -r '.[].databaseId' 2>/dev/null || true)"
  for rid in $runs; do
    jid="$(gh run view "$rid" --repo "$repo" --json jobs 2>/dev/null | jq -r ".jobs[] | select(.name==\"$mutant_job\") | .databaseId" 2>/dev/null | tail -n 1 || true)"
    if [ -n "$jid" ]; then
      if gh run view "$rid" --repo "$repo" --job "$jid" --log >"$tmp_log" 2>"$tmpd/log-err"; then
        mutant_run="$rid"
      else
        log_rc=$?
        mutant_run="$rid"
        if [ -z "$listing_note" ]; then
          listing_note="$(head -n 1 "$tmpd/log-err" 2>/dev/null || true)"
          [ -n "$listing_note" ] || listing_note="mutant log read failed for run $rid (exit $log_rc)"
        fi
      fi
      break
    fi
  done
  esc="$(printf '\033')"
  grep -Eo '[^[:space:]]+\.rs:[0-9]+:[0-9]+: .*|mutants in the diff: .*' "$tmp_log" 2>/dev/null | tr -d '\r' | sed -E "s/${esc}\[[0-9;]*[A-Za-z]//g" >"$mutants_file" || true
  mutant_count="$(grep -c . "$mutants_file" || true)"
fi
rm="${review_model:-$(tkt get model.review 2>/dev/null || true)}"
om="${overbuild_model:-$(tkt get model.overbuild 2>/dev/null || true)}"
[ -n "$rm" ] || emit "PRECONDITION missing=model.review" 2 "tkt-state: missing key: model.review"
[ -n "$om" ] || emit "PRECONDITION missing=model.overbuild" 2 "tkt-state: missing key: model.overbuild"
map_note=""; map_id=""; map_out="$run/$slug-$issue-map-r0.md"
if [ "$mutant_count" -gt 0 ]; then
  if sm="$(tkt get job.map 2>/dev/null)" && [ -n "$sm" ]; then map_id="$sm"
  else
    mm="$(tkt get model.map 2>/dev/null || true)"
    if [ -z "$mm" ]; then map_note="map failed: missing model.map"
    else
      mbrief="$run/$slug-$issue-map-1.md"
      if "$bin_dir/fill-brief" --out "$mbrief" "$map_brief" PR="$pr" ISSUE="$issue" REPO="$repo" WORKTREE="$worktree" MUTANTS="@$mutants_file" >/dev/null 2>"$tmpd/map-brief-err"; then
        map_id="$("$delegate" run --model "$mm" --cwd "$worktree" --prompt-file "$mbrief" 2>/dev/null | head -n 1 || true)"
        if [ -n "$map_id" ]; then tkt set job.map "$map_id"; tkt journal "tkt-build map id=$map_id" 2>/dev/null || true
        else map_note="map failed: no id"; fi
      else map_note="map failed: brief $(head -n 1 "$tmpd/map-brief-err" 2>/dev/null || true)"; fi
    fi
  fi
fi
r0="$(tkt get review_ids 2>/dev/null || true)"; rh="$(tkt get review_head 2>/dev/null || true)"; rids=""; [ "$rh" = "$head" ] && rids="$r0"
spec_issue="$(tkt get spec_issue 2>/dev/null || true)"
n=0; for ax in standards spec overbuild; do n=$((n+1)); [ "$(printf '%s' "$rids" | wc -w | tr -d ' ')" -ge "$n" ] && continue
  start_args=(start "$pr" --repo "$repo" --cwd "$worktree" --head "$head" --issue "$issue" --model "$rm" --overbuild-model "$om" --axes "$ax" --full-rereview "tkt-build round-0 full review")
  if [ -n "$spec_issue" ]; then start_args+=(--spec "$spec_issue"); fi
  if [ "${#context_args[@]}" -gt 0 ]; then start_args+=("${context_args[@]}"); fi
  rc=0; one="$("$reviewpr" "${start_args[@]}" 2>"$tmpd/start-$ax-err")" || rc=$?
  [ "$rc" -eq 0 ] || { [ -n "$rids" ] && { tkt set review_ids "$rids"; tkt set review_head "$head"; }; emit "REVIEW-INCOMPLETE" "$rc" "$(tail -n 20 "$tmpd/start-$ax-err")"; }
  id="$(awk -v a="$ax" '$1==a{print $2; exit}' <<<"$one")"; [ -n "$id" ] || emit "REVIEW-INCOMPLETE" 1 "missing $ax id"
  rids="${rids:+$rids }$id"; tkt set review_ids "$rids"; tkt set review_head "$head"; done
# The shard verdicts wait overlaps review: it starts once the review pair is
# dispatched and ends before the watch, so slow shards never serialize round 1.
# The 2400 s bound counts from the start of the wait, beside the review pair.
# A finished run (even a red one) is read; anything unreadable is reported and
# review proceeds without it. Nothing unread is ever treated as caught.
# A skipped shard job holds no survivors, never unread.
shard_note=""; : >"$tmpd/shard-verdicts"
if [ -n "${mutant_job:-}" ]; then
  if [ -n "${listing_note:-}" ]; then
    shard_note="$listing_note"
  elif [ -z "${mutant_run:-}" ]; then
    shard_note="no run with $mutant_job on head"
  elif [ "$mutant_count" -gt 0 ]; then
    shard_rc=0
    "$ghci" wait --run "$mutant_run" --pr "$pr" --timeout 2400 --repo "$repo" >/dev/null 2>"$tmpd/shard-wait-err" || shard_rc=$?
    case "$shard_rc" in
      0|1)
        if "$mverd" "$mutant_run" --repo "$repo" >"$tmpd/shard-verdicts" 2>"$tmpd/shard-verdicts-err"; then
          # Ruling B: a partial artifact set is unread. Count the run's
          # non-skipped Mutants (shard N) jobs against the mutants-*
          # artifacts the verdicts read; fewer artifacts means unread.
          # Every page of the paginated artifacts list counts: slurp all
          # pages into one sum. Any jobs or artifacts request or count
          # parse failure is unread with its cause; verdicts are discarded.
          shard_count_err=""; expected_shards=""; actual_shards=""
          if ! shard_jobs_json="$(gh run view "$mutant_run" --repo "$repo" --json jobs 2>"$tmpd/shard-jobs-err")"; then
            shard_count_err="$(head -n 1 "$tmpd/shard-jobs-err" 2>/dev/null || true)"
            [ -n "$shard_count_err" ] || shard_count_err="gh run view --json jobs failed for run $mutant_run"
          elif ! expected_shards="$(printf '%s' "$shard_jobs_json" | jq -r '[.jobs[] | select(.name | startswith("Mutants (shard ")) | select(.conclusion != "skipped")] | length' 2>"$tmpd/shard-jobs-parse-err")"; then
            shard_count_err="$(head -n 1 "$tmpd/shard-jobs-parse-err" 2>/dev/null || true)"
            [ -n "$shard_count_err" ] || shard_count_err="could not count shard jobs for run $mutant_run"
            expected_shards=""
          else
            case "$expected_shards" in ''|*[!0-9]*) shard_count_err="could not count shard jobs for run $mutant_run"; expected_shards="";; esac
          fi
          if [ -z "$shard_count_err" ]; then
            if ! artifacts_json="$(gh api "repos/$repo/actions/runs/$mutant_run/artifacts" --paginate 2>"$tmpd/shard-artifacts-err")"; then
              shard_count_err="$(head -n 1 "$tmpd/shard-artifacts-err" 2>/dev/null || true)"
              [ -n "$shard_count_err" ] || shard_count_err="gh api artifacts failed for run $mutant_run"
            elif ! actual_shards="$(printf '%s' "$artifacts_json" | jq -s '[.[].artifacts[]? | select(.name | startswith("mutants-"))] | length' 2>"$tmpd/shard-artifacts-parse-err")"; then
              shard_count_err="$(head -n 1 "$tmpd/shard-artifacts-parse-err" 2>/dev/null || true)"
              [ -n "$shard_count_err" ] || shard_count_err="could not count shard artifacts for run $mutant_run"
              actual_shards=""
            else
              case "$actual_shards" in ''|*[!0-9]*) shard_count_err="could not count shard artifacts for run $mutant_run"; actual_shards="";; esac
            fi
          fi
          if [ -n "$shard_count_err" ]; then
            shard_note="$shard_count_err"
            : >"$tmpd/shard-verdicts"
          elif [ "$actual_shards" -lt "$expected_shards" ]; then
            shard_note="only $actual_shards of $expected_shards shard artifacts present for run $mutant_run"
            : >"$tmpd/shard-verdicts"
          fi
        else
          # A run whose shards all skipped holds no survivors, not unread:
          # mutant-verdicts reports no artifacts, but there is nothing to read.
          # Only when the run actually has shard jobs; a run with no shard
          # jobs listed keeps the verdicts failure as unread.
          if shard_jobs_json="$(gh run view "$mutant_run" --repo "$repo" --json jobs 2>/dev/null)"; then
            total_shards="$(printf '%s' "$shard_jobs_json" | jq -r '[.jobs[] | select(.name | startswith("Mutants (shard "))] | length' 2>/dev/null || true)"
            expected_shards="$(printf '%s' "$shard_jobs_json" | jq -r '[.jobs[] | select(.name | startswith("Mutants (shard ")) | select(.conclusion != "skipped")] | length' 2>/dev/null || true)"
          else
            total_shards=""; expected_shards=""
          fi
          case "$total_shards" in ''|*[!0-9]*) total_shards="";; esac
          case "$expected_shards" in ''|*[!0-9]*) expected_shards="";; esac
          if [ -n "$total_shards" ] && [ "$total_shards" -gt 0 ] && [ -n "$expected_shards" ] && [ "$expected_shards" -eq 0 ]; then
            shard_note=""; : >"$tmpd/shard-verdicts"
          else
            shard_note="$(head -n 1 "$tmpd/shard-verdicts-err" 2>/dev/null || true)"
            [ -n "$shard_note" ] || shard_note="mutant-verdicts failed for run $mutant_run"
            : >"$tmpd/shard-verdicts"
          fi
        fi
        ;;
      124)
        shard_note="timeout after 2400s"
        ;;
      *)
        shard_note="$(head -n 1 "$tmpd/shard-wait-err" 2>/dev/null || true)"
        [ -n "$shard_note" ] || shard_note="gh-ci wait --run failed with exit $shard_rc"
        ;;
    esac
  fi
fi
# shellcheck disable=SC2086
"$delegate" watch $rids $map_id >/dev/null 2>&1 || true
if [ -n "$map_id" ] && [ "$mutant_count" -gt 0 ]; then
  rec="$(bash "$bin_dir/job-record" "$map_id" 2>/dev/null || true)"
  mtext="$(jq -j -r '.result.text // ""' "$rec" 2>/dev/null || true)"
  mstatus="$(jq -r '.result.status // .status // ""' "$rec" 2>/dev/null || true)"
  if [ -n "$mtext" ]; then printf '%s' "$mtext" >"$map_out"; fi
  [ "$mstatus" = "DONE" ] && [ -s "$map_out" ] || map_note="map failed status=${mstatus:-unknown}: ${mtext%%$'\n'*}"
fi
findings_file="$run/$slug-$issue-findings-r0.md"
rc=0; collect_out="$("$reviewpr" collect $rids --findings-out "$findings_file" 2>"$tmpd/collect-err")" || rc=$?
# shellcheck disable=SC2086
[ "$rc" -eq 0 ] || emit "REVIEW-INCOMPLETE" "$rc" "$collect_out" "$(tail -n 5 "$tmpd/collect-err")"
merged=0
if [ -z "$map_note" ] && [ "$mutant_count" -gt 0 ] && [ -f "$map_out" ]; then
  if awk -v MF="$mutants_file" 'NR==FNR{p=index($0," => ");if(p>0){k=substr($0,1,p-1);c[k]++;if(c[k]==1){R[k]=substr($0,p+4);L[k]=$0}}next}length($0)==0{next}/^mutants in the diff:/{next}{k=$0;if(!(k in c)){print "map failed: no verdict for "k>"/dev/stderr";exit 1}if(c[k]!=1){print "map failed: duplicate verdict for "k>"/dev/stderr";exit 1}r=R[k];if(!(r=="unviable"||substr(r,1,10)=="caught by "||substr(r,1,12)=="needs-test: "||substr(r,1,9)=="removed: "||substr(r,1,10)=="exempted: ")){print "map failed: bad verdict for "k>"/dev/stderr";exit 1}if(substr(r,1,12)=="needs-test: "||substr(r,1,9)=="removed: ")print "P2 "L[k]" [mutants "MF"]"}' "$map_out" "$mutants_file" >"$tmpd/map-hits" 2>"$tmpd/map-err"; then merged=$(grep -c . "$tmpd/map-hits" || true); cat "$tmpd/map-hits" >>"$findings_file"; else map_note=$(cat "$tmpd/map-err"); merged=0; fi
fi
# Shard survivors join the findings after the map lines, compared as fixed
# strings throughout: only missed/timeout rows inside the diff list, skipping
# a survivor the map already reported or exempted. Without a usable map every
# in-diff survivor is added. An unread shard appends one P3 and never blocks.
shard_p3=""; shard_merged=0
if [ -n "$shard_note" ]; then
  shard_p3="P3 mutant shards unread: run ${mutant_run:-none} head ${head:0:12}: $shard_note"
  printf '%s\n' "$shard_p3" >>"$findings_file"
elif [ "$mutant_count" -gt 0 ] && [ -s "$tmpd/shard-verdicts" ]; then
  if [ -z "$map_note" ] && [ -f "$map_out" ]; then map_ok=1; map_src="$map_out"; else map_ok=0; map_src=/dev/null; fi
  awk -v df="$mutants_file" -v mf="$map_src" -v ff="$findings_file" -v mapok="$map_ok" -v rid="$mutant_run" -v h12="${head:0:12}" '
    FILENAME == df {
      if ($0 ~ /^mutants in the diff:/) next
      if (length($0) > 0) D[$0] = 1
      next
    }
    FILENAME == mf {
      if (mapok) { p = index($0, " => "); if (p > 0 && substr($0, p + 4, 10) == "exempted: ") EX[substr($0, 1, p - 1)] = 1 }
      next
    }
    FILENAME == ff {
      if (substr($0, 1, 3) == "P2 ") { p = index($0, " => "); if (p > 0) HAVE[substr($0, 1, p - 1)] = 1 }
      next
    }
    {
      if (!match($0, /\t[^\t]*$/)) next
      v = substr($0, RSTART + 1, RLENGTH - 1); m = substr($0, 1, RSTART - 1)
      if (v != "missed" && v != "timeout") next
      if (!(m in D)) next
      if ((m in EX) || (("P2 " m) in HAVE)) next
      printf "P2 %s => survived in CI (%s) [mutants-ci run %s head %s]\n", m, v, rid, h12
    }' "$mutants_file" "$map_src" "$findings_file" "$tmpd/shard-verdicts" >"$tmpd/shard-hits"
  shard_merged="$(grep -c . "$tmpd/shard-hits" || true)"
  cat "$tmpd/shard-hits" >>"$findings_file"
fi
merged=$((merged + shard_merged))
p1="$(grep -c '^P1 ' "$findings_file" || true)"; p2="$(grep -c '^P2 ' "$findings_file" || true)"; p3="$(grep -c '^P3 ' "$findings_file" || true)"
n_approve="$(grep -cE 'VERDICT (standards|spec|overbuild): APPROVE' <<<"$collect_out" || true)"
tkt set reviewed "$head"; tkt set findings "$findings_file"; tkt set round 0
# One bad-count sum: a P3 alone never blocks.
bad=$((3 - n_approve + p1 + p2 + merged))
[ -n "$map_note" ] && bad=$((bad + 1))
approve_digest="$collect_out"; digest="$(cat "$findings_file")"
if [ -n "$map_note" ]; then approve_digest="$map_note
$approve_digest"; digest="$map_note
$digest"; fi
if [ -n "$shard_p3" ]; then approve_digest="$shard_p3
$approve_digest"; fi
if [ -n "$context_file" ]; then
  approve_digest="concerns=$context_file
$approve_digest"
  digest="concerns=$context_file
$digest"
fi
if [ "$bad" -eq 0 ]; then emit "APPROVE pr=$pr head=$head findings=$findings_file" 0 "$approve_digest"
else emit "CHANGES p1=$p1 p2=$p2 p3=$p3 mutants=$merged findings=$findings_file" 1 "$digest"; fi
