  fi
  check_model_quota "$lane_model" "" lane
  lane_args=(--slot lane --template "$lane_brief" --gate-from-plan --expect-commits "BASE=$base" "GATE=$gate_cmd" "CLOSING=$closing" "ATTRIBUTION=$attr" "LANE_MODEL=$lane_model")
  lane_args+=(--model "$lane_model")
  rc=0; lane_out="$("$tktjob" "$state" "${lane_args[@]}" 2>"$tmpd/lane-err")" || rc=$?
  if [ "$rc" -ne 0 ]; then
    lane_verdict="$(head -n 1 <<<"$lane_out")"
    if [ "$rc" -eq 1 ] && [[ "$lane_verdict" == "TKT tkt-job CONCERNS "* ]]; then
      context_file="$(tkt get concerns.lane 2>/dev/null || true)"
      if [ -n "$context_file" ]; then context_args=(--context "$context_file"); fi
    else
      forward LANE "$lane_out" "$rc" "$tmpd/lane-err"
    fi
  fi
fi
if [ "$from" != lane ]; then
  context_file="$(tkt get concerns.lane 2>/dev/null || true)"
  if [ -n "$context_file" ]; then context_args=(--context "$context_file"); fi
fi
if [ "$outcome" = measurement ]; then
  # A measurement ends in the gate: no PR to list, so the head is the worktree.
  head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
elif [ "$from" != review ]; then
