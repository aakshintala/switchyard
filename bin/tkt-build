#!/usr/bin/env bash
# tkt-build: implement steps 4-6, first round (lane, gate, mutants, review+map, findings).
# Lane dispatch checks the selected model's QuotaBar provider before tkt-job starts.
# spec_issue, when set, is passed to every round-0 review-pr start as --spec.
# Usage: tkt-build <state> [--from lane|gate|review] [--no-verifier] [--lane-model <id>] [--review-model <id>] [--overbuild-model <id>]
set -euo pipefail
USAGE="usage: tkt-build <state> [--from lane|gate|review] [--no-verifier] [--lane-model <id>] [--review-model <id>] [--overbuild-model <id>]"
usage() { echo "$USAGE" >&2; exit 2; }
[ $# -ge 1 ] || usage
case "$1" in -h|--help) echo "$USAGE"; exit 0 ;; esac
state="$1"; shift
from=lane; from_given=0; no_verifier=0; lane_model=""; review_model=""; overbuild_model=""; haiku_exempt_pending=0
while [ $# -gt 0 ]; do
  case "$1" in
    --from) [ $# -ge 2 ] || usage; from="$2"; from_given=1; shift 2 ;;
    --no-verifier) no_verifier=1; shift ;;
    --lane-model) [ $# -ge 2 ] || usage; lane_model="$2"; shift 2 ;;
    --review-model) [ $# -ge 2 ] || usage; review_model="$2"; shift 2 ;;
    --overbuild-model) [ $# -ge 2 ] || usage; overbuild_model="$2"; shift 2 ;;
    *) usage ;;
  esac
done
case "$from" in lane|gate|review) ;; *) usage ;; esac
script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
tkt_state="$script_dir/tkt-state"
tokens_lib="$script_dir/lib/plan-tokens.sh"
if [ ! -r "$tokens_lib" ]; then echo "tkt-build: cannot read shared lib: $tokens_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$tokens_lib"
plan_gate_lib="$script_dir/lib/plan-gate-args.sh"
if [ ! -r "$plan_gate_lib" ]; then echo "tkt-build: cannot read shared lib: $plan_gate_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$plan_gate_lib"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then echo "tkt-build: cannot read shared lib: $namebase_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$namebase_lib"
verdict_lib="$script_dir/lib/plan-verdict.sh"
if [ ! -r "$verdict_lib" ]; then echo "tkt-build: cannot read shared lib: $verdict_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$verdict_lib"
claim_lib="$script_dir/lib/tkt-claims.sh"
if [ ! -r "$claim_lib" ]; then echo "tkt-build: cannot read shared lib: $claim_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$claim_lib"
bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
tktjob="$bin_dir/tkt-job"; tktgate="$bin_dir/tkt-gate"; ghci="$bin_dir/gh-ci"
quota_bin="$bin_dir/quota"; models_file="$script_dir/../delegate/config/models.json"
mverd="$bin_dir/mutant-verdicts"
reviewpr="$bin_dir/review-pr"; plangate="$bin_dir/plan-gate"
delegate="${TKT_BIN:+$TKT_BIN/}delegate"
lane_brief="$HOME/.agents/skills/planning/briefs/lane.md"
map_brief="$HOME/.agents/skills/review-loop/briefs/mutant-map.md"
tkt() { "$tkt_state" "$state" "$@"; }
lockdir="$state.lock"
if mkdir "$lockdir" 2>/dev/null; then rmdir "$lockdir"
elif pid="$(cat "$lockdir/pid" 2>/dev/null)" && [ -n "${pid:-}" ]; then
  echo "tkt-build: state locked by pid $pid" >&2; exit 2
else echo "tkt-build: state locked" >&2; exit 2; fi
tmpd="$(mktemp -d "${TMPDIR:-/tmp}/tkt-build.XXXXXX")"
trap 'rm -rf "$tmpd"' EXIT
quota_line=""
emit() {
  local verdict="$1" ec="$2"; shift 2
  local rdir="${run:-$(dirname "$state")}"; mkdir -p "$rdir" 2>/dev/null || true
  local twelve="nohead"
  [ -z "${worktree:-}" ] || twelve="$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')"
  local logpath="$rdir/${slug:-build}-${issue:-0}-tkt-build-$twelve-$(date +%H%M%S).log"
  local out="TKT tkt-build $verdict log=$logpath"
  local max_lines=40
  [ -z "${quota_line:-}" ] || max_lines=39
  [ $# -eq 0 ] || out="$out
$(printf '%s\n' "$@" | head -n "$max_lines")"
  if [ -n "${quota_line:-}" ]; then out="$out
$quota_line"; fi
  printf '%s\n' "$out" | tee -a "$logpath"
  tkt journal "tkt-build $verdict" 2>/dev/null || true
  exit "$ec"
}
repair_hint() {
  case "$1" in
    repo|issue|branch|worktree|run|closing|workflow_doc)
      printf 'Repair command: rerun tkt-start --run <run-dir> --repo <owner/name> --issue <number> --spec <ticket-body> --branch <branch> --worktree <path> --workflow-doc <path> --closing '\''Resolves #<number>'\''\n' ;;
    plan)
      printf 'Repair command: tkt-plan %s set <plan-path>, then run tkt-plan %s verify when the Verifier applies; use --no-verifier only on an approved bypass path\n' "$state" "$state" ;;
    base)
      printf 'Repair command: correct Base: in <plan-path>, run tkt-plan %s set <plan-path>, then tkt-plan %s verify when the Verifier applies\n' "$state" "$state" ;;
    gate)
      printf 'Repair command: correct the plan Gate: line to run gate.script, run tkt-plan %s set <plan-path>, then tkt-plan %s verify when the Verifier applies\n' "$state" "$state" ;;
    pr)
      printf 'Repair command: tkt-build %s --from lane (create the branch PR, then resume with --from review)\n' "$state" ;;
    model.lane)
      printf 'Repair command: tkt-build %s --lane-model <model-id>\n' "$state" ;;
    model.review|model.overbuild)
      printf 'Repair command: tkt-build %s --review-model <review-model-id> --overbuild-model <overbuild-model-id>\n' "$state" ;;
    *) printf 'Repair command: rerun tkt-start with the missing ticket metadata, or tkt-plan %s set <plan-path> as appropriate\n' "$state" ;;
  esac
}
journal_build() {
  tkt journal "$1" 2>/dev/null || true
}
stale_recovery() {
  local newbase="$1" step=4 recover
  recover="To recover past STALE and VERDICT-REFUSED, run:
1. git -C $worktree merge origin/main
2. git -C $worktree push origin $branch
3. set the Base: line in $plan to Base: $newbase"
  if [ "${head_was_stored:-0}" -eq 1 ]; then
    recover="$recover
$step. tkt-state $state set head <new-head-sha>"
    step=$((step + 1))
  fi
  recover="$recover
$step. tkt-plan $state verify"
  step=$((step + 1))
  recover="$recover
$step. tkt-build $state --from $from
Resolve any step-1 conflicts, then finish the merge with git -C $worktree commit before step 2."
  printf '%s\n' "$recover"
}
write_plan_base() {
  local path="$1" newbase="$2" tmp_plan
  tmp_plan="$(mktemp "${path}.tmp.XXXXXX")" || return 1
  if ! awk -v base="$newbase" '
    /^Base:/ && !updated { print "Base: " base; updated=1; next }
    { print }
    END { if (!updated) exit 1 }
  ' "$path" >"$tmp_plan"; then
    rm -f "$tmp_plan"
    return 1
  fi
  if ! mv "$tmp_plan" "$path"; then
    rm -f "$tmp_plan"
    return 1
  fi
}
path_in_plan_files() {
  local candidate="$1" spec touched
  for spec in "${plan_files[@]}"; do
    touched="$(git -C "$worktree" diff --name-only "$merge_base..HEAD" -- "$spec" 2>"$tmpd/git-err")" || return 2
    if grep -F -x -- "$candidate" <<<"$touched" >/dev/null 2>&1; then return 0; fi
  done
  return 1
}
require_keys() {
  req_err="$(tkt require "$@" 2>&1)" || {
    printf '%s\n' "$req_err" >&2
    key="$(sed -n 's/.*missing key: //p' <<<"$req_err" | head -n 1)"
    emit "PRECONDITION missing=${key:-unknown}" 2 "$req_err" "$(repair_hint "${key:-unknown}")"
  }
}
lookup_branch_pr() {
  local pr_json
  pr_json="$(gh pr list --head "$branch" --repo "$repo" --json number,headRefOid 2>/dev/null || true)"
  pr="$(jq -r '.[0].number // empty' <<<"$pr_json" 2>/dev/null || true)"
  head="$(jq -r '.[0].headRefOid // empty' <<<"$pr_json" 2>/dev/null || true)"
  if [ -n "${pr:-}" ] && [ -n "${head:-}" ]; then return 0; fi
  [ "${1:-}" = optional ] && return 1
  emit "PRECONDITION missing=pr" 2 "tkt-build: no PR for branch $branch (gh pr list --head $branch --json number,headRefOid)" "$(repair_hint pr)"
}
fetch_branch_pr() {
  lookup_branch_pr
  tkt set pr "$pr"; tkt set head "$head"
}
map_lane_provider() {
  local id="$1" backend=""
  case "$id" in
    fiber/*)
      backend="${id#fiber/}"; backend="${backend%%/*}"
      ;;
    codex/*|openai/*) printf 'codex\n'; return 0 ;;
    claude/*|claude-*) printf 'claude\n'; return 0 ;;
    cursor/*|cursor-*) printf 'cursor\n'; return 0 ;;
    muse/*|muse-*) printf 'muse\n'; return 0 ;;
    opencode-go/*) printf 'opencode-go\n'; return 0 ;;
    *)
      backend="$(jq -r --arg id "$id" '.models[$id].backend // empty' "$models_file" 2>/dev/null || true)"
      ;;
  esac
  case "$backend" in
    claude|codex|cursor|muse|opencode-go) printf '%s\n' "$backend" ;;
    *) return 1 ;;
  esac
}
quota_refusal() {
  local verdict="$1" model="$2" provider="$3" detail="$4" repair="$5" include_model="$6"
  if [ "$include_model" = 1 ]; then
    if [ -n "$repair" ]; then
      emit "$verdict" 2 "tkt-build: quota refusal: model=$model provider=$provider $detail" "$repair"
    else
      emit "$verdict" 2 "tkt-build: quota refusal: model=$model provider=$provider $detail"
    fi
  else
    emit "$verdict" 2 "tkt-build: quota refusal: provider=$provider $detail"
  fi
}
check_model_quota() {
  local model="$1" repair="$2" report="$3" provider row status feed weekly weekly_text include_model=0
  [ "$report" = lane ] || include_model=1
  provider="$(map_lane_provider "$model" 2>/dev/null || true)"
  if [ -z "$provider" ]; then
    if [ "$report" != lane ]; then
      quota_refusal "PRECONDITION quota=unmapped" "$model" unknown \
        "status=unmapped; cannot map the model id to a QuotaBar provider" "$repair" 1
    fi
    emit "PRECONDITION quota=unmapped" 2 "tkt-build: quota refusal: model=$model provider=unknown status=unmapped; cannot map the lane model id to a QuotaBar provider"
  fi
  if [ ! -x "$quota_bin" ] || ! feed="$("$quota_bin" --json 2>"$tmpd/quota-err")"; then
    quota_refusal "PRECONDITION quota=unavailable" "$model" "$provider" \
      "status=unavailable; QuotaBar feed did not answer" "$repair" "$include_model"
  fi
  if ! jq -e '.providers | type == "array"' >/dev/null 2>&1 <<<"$feed"; then
    quota_refusal "PRECONDITION quota=unavailable" "$model" "$provider" \
      "status=unavailable; QuotaBar feed was not valid provider JSON" "$repair" "$include_model"
  fi
  row="$(jq -c --arg id "$provider" '[.providers[] | select(.id == $id)][0] // empty' <<<"$feed")"
  if [ -z "$row" ]; then
    quota_refusal "PRECONDITION quota=missing" "$model" "$provider" \
      "status=missing; provider is absent from the QuotaBar feed" "$repair" "$include_model"
  fi
  status="$(jq -r '.status // "unknown"' <<<"$row")"
  # muse spend is not rationed (owner, 2026-11-06; RULING-1562-1): its warning is a pace signal, so it launches.
  if [ "$status" != healthy ] && { [ "$provider" != muse ] || [ "$status" != warning ]; }; then
    local need="healthy"; [ "$provider" = muse ] && need="healthy or warning"
    quota_refusal "PRECONDITION quota=refused" "$model" "$provider" \
      "status=$status; provider status must be $need" "$repair" "$include_model"
  fi
  if [ "$provider" = claude ]; then
    weekly="$(jq -r '[.quotas[]? | select((.key // "" | ascii_downcase) == "weekly" or (.label // "" | ascii_downcase) == "weekly")][0].percentRemaining // empty' <<<"$row")"
    if [ -n "$weekly" ] && jq -e --argjson weekly "$weekly" '$weekly < 40' >/dev/null 2>&1 <<<"$row"; then
      weekly_text="$(jq -r --argjson weekly "$weekly" 'if $weekly == ($weekly | floor) then "\($weekly | floor)%" else "\($weekly)%" end' <<<"null")"
      # Haiku review exempt from the floor once per PR (owner card 1112-fly-c8ba, switchyard#1622).
      # The cap covers tkt-build's review only: tkt-fix re-reviews never run this floor check.
      # The key is spent after both review checks pass (see the call sites), so a refused
      # overbuild pick does not spend it.
      local reason="weekly quota is below the launch floor"
      if [ "$report" = review ] && { [ "${model%:*}" = claude-haiku-5-5 ] || [ "${model%:*}" = fiber/claude/claude-haiku-5-5 ]; }; then
        if [ "$(tkt get quota.haiku_floor_exempt 2>/dev/null || true)" = 1 ]; then
          reason="Haiku review exemption already used for this PR (card 1112-fly-c8ba)"
        elif [ "$haiku_exempt_pending" = 1 ]; then
          reason="the Haiku review exemption covers one review per PR; pick a non-Claude overbuild model (card 1112-fly-c8ba)"
        else
          haiku_exempt_pending=1
          printf 'tkt-build: quota: claude weekly=%s floor=40%% exempt=haiku-review (owner card 1112-fly-c8ba, one per PR)\n' "$weekly_text" >&2
          reason=""
        fi
      fi
      [ -z "$reason" ] || quota_refusal "PRECONDITION quota=refused" "$model" "$provider" \
        "status=$status weekly=$weekly_text floor=40%; $reason" "$repair" "$include_model"
    fi
    if [ -n "$weekly" ] && jq -e --argjson weekly "$weekly" '($weekly | type) == "number"' >/dev/null 2>&1 <<<"$row"; then
      weekly_text="$(jq -r --argjson weekly "$weekly" 'if $weekly == ($weekly | floor) then "\($weekly | floor)%" else "\($weekly)%" end' <<<"null")"
    else
      weekly_text=unknown
    fi
    if [ "$report" = lane ]; then quota_line="quota: provider=claude status=$status weekly=$weekly_text floor=40%"; fi
  elif [ "$report" = lane ]; then
    quota_line="quota: provider=$provider status=$status"
  fi
}

forward() {
  local step="$1" inner="$2" rc="$3" err="$4" first words rest
  first="$(head -n 1 <<<"$inner")"
  if [ "$step" = GATE ]; then tkt set review_status gate-failed; fi
  case "$first" in
    "TKT tkt-"*)
      words="$(sed -e 's/^TKT tkt-[^ ]* //' -e 's/ log=[^ ]*$//' <<<"$first")"
      rest="$(tail -n +2 <<<"$inner")"
      [ -n "$rest" ] && emit "$words" "$rc" "$rest" || emit "$words" "$rc" ;;
    *) cat "$err" >&2; emit "$step-ERROR" "$rc" "$(tail -n 20 "$err")" ;;
  esac
}
require_keys repo issue branch worktree run plan
repo="$(tkt get repo)"; issue="$(tkt get issue)"; branch="$(tkt get branch)"
worktree="$(tkt get worktree)"; run="$(tkt get run)"; plan="$(tkt get plan)"
slug="${repo//\//-}"; set_namebase "$repo" "$issue"; mkdir -p "$run"
part_suffix="$(part_findings_suffix "$(tkt get part 2>/dev/null || true)")"
# First-round tool: a state with a round already counted continues with tkt-fix or tkt-ship.
# The Outcome line names the ticket's end state, read the same way as Base. A
# plan without the line ends in a PR; Outcome: measurement ends in the gate.
outcome="$(plan_outcome "$plan" 2>/dev/null || true)"
[ -n "$outcome" ] || outcome=pr
last_review_status="$(tkt get review_status 2>/dev/null || true)"
# A completed lane may have opened the branch PR before the state saved its
# keys. Refuse the default replay and name the continuation after the last
# recorded review status: gate for pending/failed or unknown, review after ready/done.
if [ "$from_given" -eq 0 ] && [ "$from" = lane ] && [ "$outcome" != measurement ] && \
  { [ -z "$(tkt get pr 2>/dev/null || true)" ] || [ -z "$(tkt get head 2>/dev/null || true)" ]; }; then
  lane_job="$(tkt get job.lane 2>/dev/null || true)"
  if [ -n "$lane_job" ]; then
    lane_record="$(bash "$bin_dir/job-record" "$lane_job" 2>/dev/null || true)"
    lane_status="$(jq -r '.status // .result.status // empty' "$lane_record" 2>/dev/null || true)"
    if [ -f "$lane_record" ] && [ "$lane_status" = DONE ] && lookup_branch_pr optional; then
      case "$last_review_status" in
        ready|done) repair_from=review ;;
        *) repair_from=gate ;;
      esac
      emit "PRECONDITION missing=pr" 2 \
        "tkt-build: lane job $lane_job is DONE and branch PR $pr is open, but state lacks pr/head; refusing to replay the lane" \
        "Repair command: tkt-build $state --from $repair_from"
    fi
  fi
fi
if [ "$outcome" = measurement ]; then
  tkt set review_status skipped
elif [ "$(tkt get review_status 2>/dev/null || true)" != done ]; then
  tkt set review_status pending
fi
# A review with a missing pr or head derives only the missing key from the
# branch PR before the drift check below, so that check never views an
# empty pr. A stored head is left exactly as stored, so the drift check
# below compares it against the PR head and reports DRIFT when they differ.
if [ "$from" = review ] && [ "$outcome" != measurement ]; then
  if [ -z "$(tkt get pr 2>/dev/null || true)" ] || [ -z "$(tkt get head 2>/dev/null || true)" ]; then
    lookup_branch_pr
    [ -n "$(tkt get pr 2>/dev/null || true)" ] || tkt set pr "$pr"
    [ -n "$(tkt get head 2>/dev/null || true)" ] || tkt set head "$head"
  fi
fi
rnd="$(tkt get round 2>/dev/null || true)"
# A build can resume until a reviewed head records the first completed review.
if [ -n "$(tkt get reviewed 2>/dev/null || true)" ]; then
  emit "ROUND-LIMIT round=$rnd" 1 "tkt-build is the wrong phase after the first round; continue with tkt-fix $state --verify [--resume <job id> --prompt <file>] or tkt-ship $state; this is not the round limit"
fi
head_was_stored=0
if stored_head="$(tkt get head 2>/dev/null)"; then
  head_was_stored=1
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
  if [ "$outcome" = measurement ]; then
    # A measurement ends in the gate: no PR exists, so only the worktree
    # head is checked and no PR is listed or viewed.
    if [ "$stored_head" != "$actual" ]; then
      msg="tkt-build: head drift: state $state head=$stored_head worktree $worktree HEAD=$actual"
      printf '%s\n' "$msg" >&2; emit "DRIFT state=$stored_head worktree=$actual pr=unreadable" 3 "$msg"
    fi
  else
    if [ "$from" = review ]; then pr0="$(tkt get pr 2>/dev/null || true)"; early_pr="$(gh pr view "$pr0" --repo "$repo" --json headRefOid --jq '.headRefOid' 2>/dev/null || true)"
    else early_pr="$(gh pr list --head "$branch" --repo "$repo" --json headRefOid 2>/dev/null | jq -r '.[0].headRefOid // empty' 2>/dev/null || true)"; fi
    if [ "$stored_head" != "$actual" ] || [ "$stored_head" != "$early_pr" ]; then
      msg="tkt-build: head drift: state $state head=$stored_head worktree $worktree HEAD=$actual pr ${early_pr:-unreadable}"
      printf '%s\n' "$msg" >&2; emit "DRIFT state=$stored_head worktree=$actual pr=${early_pr:-unreadable}" 3 "$msg"
    fi
  fi
fi
base="$(plan_base "$plan" 2>/dev/null || true)"
[ -n "$base" ] || emit "PRECONDITION missing=base" 2 "tkt-build: no Base line in $plan" "$(repair_hint base)"
# Only the first backticked token of a Files line is its path column; later ones are
# prose (`reads`, `/reload`) that git would take as pathspecs. plan-check and plan-sweep
# read every token (lib/plan-tokens.sh) because they check coverage, not staleness.
plan_files=()
while IFS= read -r p; do plan_files+=("$p"); done < <(plan_files_pathspecs "$plan")
# Verdict-base validation considers all entries; only writes can stale against main.
stale_files=()
while IFS= read -r p; do stale_files+=("$p"); done < <(plan_files_pathspecs "$plan" writes)
if ! plan_verdict_check build "$tkt_state" "$state" "$no_verifier" "$plan" "$base" "$worktree" ${plan_files[@]+"${plan_files[@]}"}; then
  emit "VERDICT-REFUSED verdict=$verdict_refusal" 1 "$verdict_digest"
fi
if [ "${#stale_files[@]}" -gt 0 ]; then
  stat_out="$(git -C "$worktree" diff --stat "$base...origin/main" -- "${stale_files[@]}" 2>"$tmpd/git-err")" || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
  if [ -n "$stat_out" ]; then
    n="$(git -C "$worktree" diff --name-only "$base...origin/main" -- "${stale_files[@]}" 2>/dev/null | wc -l | tr -d ' ')"
    if [ "$from" = gate ] || [ "$from" = review ]; then
      # Do not merge a main change that overlaps a branch edit outside the
      # plan's Files. The planned-file stale check above still controls when
      # this recovery runs; this overlap check protects the merge's full diff.
      merge_base="$(git -C "$worktree" merge-base HEAD origin/main 2>"$tmpd/git-err")" || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
      main_changes="$(git -C "$worktree" diff --name-only "$merge_base..origin/main" 2>"$tmpd/git-err")" || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
      branch_changes="$(git -C "$worktree" diff --name-only "$merge_base..HEAD" 2>"$tmpd/git-err")" || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
      outside_overlaps=""
      while IFS= read -r changed_path; do
        [ -n "$changed_path" ] || continue
        if grep -F -x -- "$changed_path" <<<"$branch_changes" >/dev/null 2>&1; then
          if path_in_plan_files "$changed_path"; then
            :
          else
            path_rc=$?
            [ "$path_rc" -ne 2 ] || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
            outside_overlaps="${outside_overlaps}${outside_overlaps:+, }$changed_path"
          fi
        fi
      done <<<"$main_changes"
      if [ -n "$outside_overlaps" ]; then
        journal_build "tkt-build stale recovery outside-files=$outside_overlaps"
        emit "STALE n=$n base=$base" 1 "$stat_out" "tkt-build: merge would change paths outside plan Files that the branch also touches: $outside_overlaps"
      fi

      old_head="$(git -C "$worktree" rev-parse HEAD 2>"$tmpd/git-err")" || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
      merge_rc=0
      git -C "$worktree" merge origin/main >"$tmpd/merge-out" 2>"$tmpd/merge-err" || merge_rc=$?
      if [ "$merge_rc" -ne 0 ]; then
        unmerged="$(git -C "$worktree" ls-files -u 2>/dev/null || true)"
        if [ -n "$unmerged" ]; then
          journal_build "tkt-build stale recovery merge-conflict base=$base"
          abort_rc=0
          git -C "$worktree" merge --abort >"$tmpd/merge-abort-out" 2>"$tmpd/merge-abort-err" || abort_rc=$?
          clean_after_abort=0
          [ -z "$(git -C "$worktree" status --porcelain 2>/dev/null || true)" ] && clean_after_abort=1
          journal_build "tkt-build stale recovery merge-abort rc=$abort_rc clean=$clean_after_abort"
          newbase="$(git -C "$worktree" rev-parse origin/main 2>/dev/null || true)"
          recover="$(stale_recovery "$newbase")"
          merge_details="$(cat "$tmpd/merge-err" "$tmpd/merge-out" 2>/dev/null || true)"
          [ "$abort_rc" -eq 0 ] || merge_details="$merge_details
$(cat "$tmpd/merge-abort-err" 2>/dev/null || true)"
          [ "$clean_after_abort" -eq 1 ] || merge_details="$merge_details
 tkt-build: merge --abort did not leave a clean worktree"
          emit "STALE n=$n base=$base" 1 "$stat_out" "$merge_details" "$recover"
        fi
        if git -C "$worktree" rev-parse --verify -q MERGE_HEAD >/dev/null 2>&1; then
          abort_rc=0
          git -C "$worktree" merge --abort >"$tmpd/merge-abort-out" 2>"$tmpd/merge-abort-err" || abort_rc=$?
          journal_build "tkt-build stale recovery merge-abort rc=$abort_rc"
        fi
        journal_build "tkt-build stale recovery merge-failed rc=$merge_rc"
        newbase="$(git -C "$worktree" rev-parse origin/main 2>/dev/null || true)"
        recover="$(stale_recovery "$newbase")"
        merge_details="$(cat "$tmpd/merge-err" "$tmpd/merge-out" 2>/dev/null || true)"
        emit "STALE n=$n base=$base" 1 "$stat_out" "$merge_details" "$recover"
      fi

      merged_head="$(git -C "$worktree" rev-parse HEAD 2>"$tmpd/git-err")" || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
      merge_parents="$(git -C "$worktree" rev-list --parents -n 1 "$merged_head" 2>"$tmpd/git-err")" || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
      parent_count="$(wc -w <<<"$merge_parents" | tr -d ' ')"
      if [ "$parent_count" -eq 3 ]; then
        newbase="$(awk '{print $3}' <<<"$merge_parents")"
      elif [ "$merged_head" != "$old_head" ]; then
        newbase="$merged_head"
      else
        newbase="$(git -C "$worktree" rev-parse origin/main 2>"$tmpd/git-err")" || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
      fi
      journal_build "tkt-build stale recovery merge origin/main head=$merged_head base=$newbase"

      push_rc=0
      git -C "$worktree" push origin "$branch" >"$tmpd/push-out" 2>"$tmpd/push-err" || push_rc=$?
      if [ "$push_rc" -ne 0 ]; then
        journal_build "tkt-build stale recovery push-failed rc=$push_rc"
        recover="$(stale_recovery "$newbase")"
        emit "STALE n=$n base=$base" 1 "$stat_out" "$(cat "$tmpd/push-err" 2>/dev/null || true)" "$recover"
      fi
      journal_build "tkt-build stale recovery push origin $branch"
      tkt_claim_pushed_hunks "$issue" "$worktree" "$repo"

      if ! write_plan_base "$plan" "$newbase"; then
        journal_build "tkt-build stale recovery plan-base-failed base=$newbase"
        recover="$(stale_recovery "$newbase")"
        emit "STALE n=$n base=$base" 1 "$stat_out" "tkt-build: could not update Base: in $plan" "$recover"
      fi
      journal_build "tkt-build stale recovery plan Base=$newbase"

      if [ "$head_was_stored" -eq 1 ]; then
        if ! tkt set head "$merged_head"; then
          journal_build "tkt-build stale recovery head-failed head=$merged_head"
          emit "PRECONDITION state=failed" 2 "tkt-build: could not set head to $merged_head"
        fi
        journal_build "tkt-build stale recovery head=$merged_head"
      fi

      recovery_plan_hash="$(git -C "$worktree" hash-object "$plan" 2>"$tmpd/git-err")" || emit "PRECONDITION git=failed" 2 "$(cat "$tmpd/git-err")"
      if ! tkt set build_stale_recovery_base "$newbase" || ! tkt set build_stale_recovery_plan_hash "$recovery_plan_hash"; then
        emit "PRECONDITION state=failed" 2 "tkt-build: could not record the stale-recovery verify exemption"
      fi
      journal_build "tkt-build stale recovery verify-exemption base=$newbase plan=$recovery_plan_hash"

      verify_rc=0
      verify_out="$("$bin_dir/tkt-plan" "$state" verify 2>"$tmpd/verify-err")" || verify_rc=$?
      verify_line="$(head -n 1 <<<"$verify_out")"
      if [ "$verify_rc" -ne 0 ] || [[ "$verify_line" != "TKT tkt-plan PLAN-OK "* ]]; then
        journal_build "tkt-build stale recovery verify failed rc=$verify_rc verdict=${verify_line:-none}"
        if [ -n "$verify_line" ]; then printf '%s\n' "$verify_line"; fi
        [ ! -s "$tmpd/verify-err" ] || cat "$tmpd/verify-err" >&2
        [ "$verify_rc" -ne 0 ] || verify_rc=1
        exit "$verify_rc"
      fi
      journal_build "tkt-build stale recovery verify PLAN-OK"
    else
      emit "STALE n=$n base=$base" 1 "$stat_out"
    fi
  fi
fi
context_args=(); context_file=""
if [ "$from" = lane ]; then
  require_keys closing workflow_doc
  closing="$(tkt get closing)"
  plan_gate_args tkt
  gate_cmd="$("$plangate" ${plan_gate_argv[@]+"${plan_gate_argv[@]}"} "$plan" 2>"$tmpd/pg-err")" || emit "PRECONDITION missing=gate" 2 "$(cat "$tmpd/pg-err")" "$(repair_hint gate)"
  # body_ends wins; a missing or blank body_ends falls through to the body_has co-author.
  attr="$(tkt get body_ends 2>/dev/null || true)"
  if [ -z "${attr//[[:space:]]/}" ]; then
    attr="$(tkt list body_has 2>/dev/null | grep -i 'co-author' | head -n 1 || true)"
  fi
  lane_model="${lane_model:-$(tkt get model.lane 2>/dev/null || true)}"
  # A lane with no model names the missing key on stderr and stops before dispatch.
  if [ -z "$lane_model" ]; then
