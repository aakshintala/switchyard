#!/usr/bin/env bash
# file-claim: lanes self-grant files via a claims ref in the claim repo.
# Claim IDs must be exactly fiber-<n> or sweep-<n>...
# Claim lanes need a ticket number; release and list accept any lane ID.
# Usage: file-claim claim --lane ID (--paths PATH... | --plan-file PLAN | --grant PATH...) [--self-pr N]... (each own PR) [--worktree HOST:DIR] [--repo R]
#        file-claim release --lane ID [--repo R] [PATH...]
#        file-claim prune --lane ID [--repo R]
#        file-claim list [--lane ID] [--repo R]
#        file-claim reap [--repo R]
# Ordinary lane and PR overlaps are advisory; sweep-* lanes hold paths exclusively.
# Claim batches are all-or-nothing only when a sweep or the grant cap refuses a path.
# Reap drops closed-ticket or closed/merged-PR claims and fence-grant files; sweep-* claims stay held.
# Without --lane, list adds one row per open-PR path: <path> pr#N pr - - N.
# FILE_CLAIM_MAX_GRANT=N sets the grant cap (default 5); N must be a positive integer.
# FILE_CLAIM_READ_WAIT=N sets the retry wait in whole seconds (default 1).
# FILE_CLAIM_PUSH_WAIT=N sets the commit_refs retry wait in whole seconds (default 1).
set -euo pipefail
REPO_DEFAULT="aakshintala/fiber"
REF="refs/claims/live"
MAX_GRANT="${FILE_CLAIM_MAX_GRANT:-5}"
READ_TRIES=3
READ_WAIT="${FILE_CLAIM_READ_WAIT:-1}"
PUSH_TRIES=3
PUSH_WAIT="${FILE_CLAIM_PUSH_WAIT:-1}"
TRIES=8
TAB=$'\t'
NL=$'\n'
usage() {
  echo "usage: file-claim claim --lane ID (--paths PATH... | --plan-file PLAN | --grant PATH...) [--self-pr N] [--worktree HOST:DIR] [--repo R]" >&2
  echo "       claim IDs must be exactly fiber-<n> or sweep-<n>..." >&2
  echo "       release and list accept any lane ID" >&2
  echo "       ordinary lane and PR holds are advisory; sweep-* lane ids hold exclusively" >&2
  echo "       sweep and grant-cap refusals are all-or-nothing; drop refused paths and rerun" >&2
  echo "       file-claim release --lane ID [--repo R] [PATH...]" >&2
  echo "       file-claim prune --lane ID [--repo R]  (release all rows for the lane)" >&2
  echo "       file-claim list [--lane ID] [--repo R]  (no --lane adds one row per open-PR path)" >&2
  echo "       file-claim reap [--repo R]  (drop closed-ticket and closed/merged-PR claims and fence-grant files)" >&2
  echo "       FILE_CLAIM_MAX_GRANT=N sets the grant cap (default 5)" >&2
  exit 2
}
die() { local c="$1"; shift; echo "file-claim: $*" >&2; exit "$c"; }
case "$MAX_GRANT" in ''|*[!0-9]*) die 2 "FILE_CLAIM_MAX_GRANT must be a positive integer" ;; esac
[ "$MAX_GRANT" -gt 0 ] || die 2 "FILE_CLAIM_MAX_GRANT must be a positive integer"
case "$READ_WAIT" in ''|*[!0-9]*) die 2 "FILE_CLAIM_READ_WAIT must be a whole number of seconds" ;; esac
case "$PUSH_WAIT" in ''|*[!0-9]*) die 2 "FILE_CLAIM_PUSH_WAIT must be a whole number of seconds" ;; esac
# plan_files_pathspecs: the plan's Files entries, the same reader tkt-gate uses.
# shellcheck disable=SC1091
script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
# shellcheck disable=SC1091
. "$script_dir/lib/lane-ticket.sh"
. "$script_dir/lib/plan-tokens.sh"
. "$script_dir/lib/ticket-state.sh"
W=""
LIST_PRMAP_PID=""
cleanup() {
  if [ -n "$LIST_PRMAP_PID" ]; then
    wait "$LIST_PRMAP_PID" 2>/dev/null || true
    LIST_PRMAP_PID=""
  fi
  if [ -n "$W" ] && [ -d "$W" ]; then rm -rf "$W"; fi
}
trap cleanup EXIT
new_workdir() { W="$(mktemp -d "${TMPDIR:-/tmp}/file-claim.XXXXXX")"; git init -q --bare "$W" || die 2 "cannot init temp dir"; }
valid_path() { case "$1" in ""|*[[:space:]]*|/*|./*|../*|*/../*|*/..|..|*//*|*/|.|*/.|*/./*) return 1;; esac; }
# valid_release_path: the pre-whitespace rule (tabs and newlines only) so rows
# already stored with a composite path stay removable.
valid_release_path() { case "$1" in ""|*"$TAB"*|*"$NL"*|/*|./*|../*|*/../*|*/..|..|*//*|*/|.|*/.|*/./*) return 1;; esac; }
valid_field() { case "$1" in ""|*"$TAB"*|*"$NL"*) return 1;; esac; }
# is_plan_file PATH: a readable regular file with Files entries that git does not
# track. Outside a repo, git fails, so the file counts as untracked.
is_plan_file() {
  [ -f "$1" ] && [ -r "$1" ] || return 1
  [ -n "$(plan_files_pathspecs "$1")" ] || return 1
  git --literal-pathspecs ls-files --error-unmatch -- "$1" >/dev/null 2>&1 && return 1
  return 0
}
default_remote() {
  printf '%s' "${FILE_CLAIM_REMOTE:-git@github.com:$1.git}"
}
read_pr_files() {
  local repo="$1" pr="$2" expected="$3" file="$4" err_file="$5" attempt=1 got
  # GitHub's PR files API returns at most 3000 entries. Above that, the count
  # never reconciles and file-claim exits 2 on every call, not as a flake.
  while [ "$attempt" -le "$READ_TRIES" ]; do
    if gh api --paginate "repos/$repo/pulls/$pr/files?per_page=100" -q '.[].filename' >"$file" 2>"$err_file"; then
      got="$(awk 'length($0) > 0 { n++ } END { print n+0 }' "$file")"
      if [ "$got" = "$expected" ]; then return 0; fi
      printf 'file list has %s files, changedFiles is %s\n' "$got" "$expected" >"$err_file"
    fi
    if [ "$attempt" -lt "$READ_TRIES" ]; then sleep "$READ_WAIT"; fi
    attempt=$((attempt + 1))
  done
  return 1
}
jitter_sleep() {
  sleep "$(awk "BEGIN { print ($RANDOM % 9 + 2) / 10 }")"
}
report() {
  printf '%s\n' "${out[@]}" "file-claim: $granted granted, $refused refused"
  exit "$1"
}
fetch_main_tip() {
  local r="$1" t
  git -C "$W" fetch -q "$r" "+refs/heads/main:refs/file-claim/main" 2>"$W/fetch-main.err" || die 2 "cannot fetch main from $r: $(cat "$W/fetch-main.err")"
  t="$(git -C "$W" rev-parse --verify --quiet 'refs/file-claim/main^{commit}' 2>/dev/null || true)"; [ -n "$t" ] || die 2 "no main branch in $r"; printf '%s' "$t"
}
fetch_claim_tip() {
  local r="$1" rc=0
  if git -C "$W" fetch -q "$r" "+$REF:refs/file-claim/claims" 2>"$W/fetch-claims.err"; then
    git -C "$W" rev-parse --verify --quiet 'refs/file-claim/claims^{commit}' 2>/dev/null || true
    return 0
  fi
  git ls-remote -q --exit-code "$r" "$REF" >/dev/null 2>&1 || rc=$?
  if [ "$rc" != "2" ]; then die 2 "cannot fetch $REF from $r: $(cat "$W/fetch-claims.err")"; fi
  return 0
}
load_claims() {
  local tip="$1" file="$2" epoch_file="${3:-}" invalid_file="$W/claims-invalid" invalid_line
  if [ -z "$tip" ]; then
    : >"$file"
    [ -z "$epoch_file" ] || : >"$epoch_file"
    return 0
  fi
  git -C "$W" cat-file -p "$tip:claims" >"$file" 2>/dev/null || die 2 "claims ref holds no claims blob"
  [ -z "$epoch_file" ] || : >"$epoch_file"
  if ! awk -v epoch_file="$epoch_file" -v bad_file="$invalid_file" '
    function date_epoch(s,    digits,y,m,d,hh,mm,ss,mdays,mp,era,yoe,doy,doe) {
      if (length(s) != 20 || substr(s, 5, 1) != "-" || substr(s, 8, 1) != "-" ||
          substr(s, 11, 1) != "T" || substr(s, 14, 1) != ":" ||
          substr(s, 17, 1) != ":" || substr(s, 20, 1) != "Z") return 0
      digits = substr(s, 1, 4) substr(s, 6, 2) substr(s, 9, 2) \
               substr(s, 12, 2) substr(s, 15, 2) substr(s, 18, 2)
      if (digits ~ /[^0-9]/) return 0
      y = substr(s, 1, 4) + 0
      m = substr(s, 6, 2) + 0
      d = substr(s, 9, 2) + 0
      hh = substr(s, 12, 2) + 0
      mm = substr(s, 15, 2) + 0
      ss = substr(s, 18, 2) + 0
      if (y < 1 || m < 1 || m > 12 || hh > 23 || mm > 59 || ss > 59) return 0
      if (m == 2) mdays = 28 + ((y % 4 == 0 && (y % 100 != 0 || y % 400 == 0)) ? 1 : 0)
      else if (m == 4 || m == 6 || m == 9 || m == 11) mdays = 30
      else mdays = 31
      if (d < 1 || d > mdays) return 0
      y -= (m <= 2)
      era = int(y / 400)
      yoe = y - era * 400
      mp = m + (m > 2 ? -3 : 9)
      doy = int((153 * mp + 2) / 5) + d - 1
      doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
      epoch = (era * 146097 + doe - 719468) * 86400 + hh * 3600 + mm * 60 + ss
      return 1
    }
    {
      rest = $0
      bad = 0
      for (i = 1; i <= 5; i++) {
        pos = index(rest, "\t")
        if (!pos) { bad = 1; break }
        field[i] = substr(rest, 1, pos - 1)
        rest = substr(rest, pos + 1)
      }
      if (!bad && index(rest, "\t")) bad = 1
      field[6] = rest
      if (bad || (field[3] != "plan" && field[3] != "grant") || !date_epoch(field[4])) {
        print NR > bad_file
        close(bad_file)
        exit 1
      }
      print $0
      if (epoch_file != "") printf "%.0f\n", epoch >> epoch_file
    }
  ' "$file" >"$file.canonical"; then
    invalid_line="$(cat "$invalid_file" 2>/dev/null || printf '1')"
    die 2 "claims line $invalid_line is corrupt"
  fi
  mv "$file.canonical" "$file"
}
store_claims() {
  local remote="$1" file="$2" tip="$3" err blob tree commit attempt=1
  blob="$(git -C "$W" hash-object -w "$file")" || die 2 "cannot hash claims"
  tree="$(printf '100644 blob %s\tclaims\n' "$blob" | git -C "$W" mktree)" || die 2 "cannot build claims tree"
  commit="$(printf 'file-claim: update claims\n' | GIT_AUTHOR_NAME=file-claim GIT_AUTHOR_EMAIL=file-claim@localhost GIT_COMMITTER_NAME=file-claim GIT_COMMITTER_EMAIL=file-claim@localhost git -C "$W" commit-tree "$tree" ${tip:+-p "$tip"})" || die 2 "cannot commit claims"
  err="$W/push.err"
  while [ "$attempt" -le "$PUSH_TRIES" ]; do
    if git -C "$W" push -q "$remote" "$commit:$REF" 2>"$err"; then return 0; fi
    # A moved ref means a raced write: the caller refetches and retries.
    if grep -qi 'non-fast-forward\|fetch first\|cannot lock ref' "$err"; then return 3; fi
    if ! grep -qi 'fatal error in commit_refs' "$err"; then die 2 "cannot push $REF to $remote: $(cat "$err")"; fi
    if [ "$attempt" -ge "$PUSH_TRIES" ]; then die 2 "cannot push $REF to $remote: $(cat "$err")"; fi
    sleep "$PUSH_WAIT"
    attempt=$((attempt + 1))
  done
}
filter_release() {
  local claims="$1" lane="$2" kept="$3" dropped="$4"; shift 4
  local line c_path c_lane c_kind c_at c_wt c_pr p drop
  : >"$kept"; : >"$dropped"
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    IFS="$TAB" read -r c_path c_lane c_kind c_at c_wt c_pr <<<"$line"
    drop=0
    if [ "$c_lane" = "$lane" ]; then if [ $# -eq 0 ]; then drop=1; else for p in "$@"; do if [ "$p" = "$c_path" ]; then drop=1; break; fi; done; fi; fi
    if [ "$drop" = "1" ]; then printf '%s\n' "$c_path" >>"$dropped"; else printf '%s\n' "$line" >>"$kept"; fi
  done <"$claims"
}
build_prmap() {
  # The open-PR path table both claim and list read. Writes "$W/prmap" lines
  # "PR<TAB>path". File reads are bounded and each PR has isolated output/errors.
  # Fail-closed: any unreadable list exits 2, as claim always did.
  local repo="$1" pr_json prmap_list pr changed_files index=0 batch=0 wait_i max_parallel=10
  local -a job_pids=() job_indexes=()
  pr_json="$(gh pr list --repo "$repo" --state open --limit 1000 --json number,changedFiles 2>"$W/gh.err")" || die 2 "cannot list open PRs for $repo: $(cat "$W/gh.err")"
  prmap_list="$W/prmap-list"; prmap="$W/prmap"
  printf '%s' "$pr_json" | jq -r '.[] | [.number, .changedFiles] | @tsv' >"$prmap_list" 2>"$W/jq.err" || die 2 "cannot parse open PRs for $repo: $(cat "$W/jq.err")"
  while IFS="$TAB" read -r pr changed_files; do
    case "$changed_files" in ''|*[!0-9]*) die 2 "invalid changedFiles for open PR #$pr for $repo: $changed_files" ;; esac
  done <"$prmap_list"
  while IFS="$TAB" read -r pr changed_files; do
    index=$((index + 1))
    read_pr_files "$repo" "$pr" "$changed_files" "$W/pr-files-$index" "$W/pr-$index.err" &
    job_pids+=("$!"); job_indexes+=("$index")
    batch=$((batch + 1))
    if [ "$batch" -ge "$max_parallel" ]; then
      for wait_i in "${!job_pids[@]}"; do
        if ! wait "${job_pids[$wait_i]}"; then : >"$W/pr-${job_indexes[$wait_i]}.failed"; fi
      done
      job_pids=(); job_indexes=(); batch=0
    fi
  done <"$prmap_list"
  if [ "$batch" -gt 0 ]; then
    for wait_i in "${!job_pids[@]}"; do
      if ! wait "${job_pids[$wait_i]}"; then : >"$W/pr-${job_indexes[$wait_i]}.failed"; fi
    done
  fi
  : >"$prmap"
  index=0
  while IFS="$TAB" read -r pr changed_files; do
    index=$((index + 1))
    if [ -f "$W/pr-$index.failed" ]; then
      die 2 "cannot list files for open PR #$pr for $repo after $READ_TRIES tries: $(cat "$W/pr-$index.err")"
    fi
    while IFS= read -r path || [ -n "$path" ]; do
      [ -n "$path" ] || continue
      printf '%s\t%s\n' "$pr" "$path" >>"$prmap"
    done <"$W/pr-files-$index"
  done <"$prmap_list"
}
pr_hunks() {
  # Old-side (main-side) line ranges of PR's hunks in PATH, comma-separated.
  # Same hunk reading as _pr_hunks in bin/fence-grant: hunk -a,b with b>0 is
  # a-(a+b-1); an insertion -a,0 is a-(a+1). A new file, a binary file or a
  # section with no hunks holds the whole file. The holder's diff is fetched
  # once per PR per run; a failed fetch, partial output included, prints
  # unknown for every path that PR holds. A sweep refusal stands either way, so
  # this always succeeds.
  local repo="$1" pr="$2" path="$3" diff="$W/diff-$pr" sec hunks r a b ranges
  [ -f "$diff.failed" ] && { printf 'unknown'; return 0; }
  if [ ! -f "$diff" ]; then
    if ! gh pr diff "$pr" -R "$repo" >"$diff.part" 2>"$W/gh-diff.err"; then : >"$diff.failed"; printf 'unknown'; return 0; fi
    mv "$diff.part" "$diff"
  fi
  sec="$(awk -v f="$path" '/^diff --git /{on = ($4 == "b/" f)} on {print}' "$diff")"
  case "$sec" in ""|*"new file mode"*|*"Binary files "*) printf 'whole'; return 0;; esac
  hunks="$(printf '%s\n' "$sec" | awk '/^@@ /{line=$0; sub(/^@@ -/, "", line); sub(/ .*/, "", line); print line}' || true)"
  [ -n "$hunks" ] || { printf 'whole'; return 0; }
  ranges=""
  while IFS= read -r r || [ -n "$r" ]; do
    [ -n "$r" ] || continue
    a="${r%%,*}"
    case "$r" in *,*) b="${r#*,}";; *) b=1;; esac
    case "$a$b" in ''|*[!0-9]*) continue;; esac
    if [ "$b" = "0" ]; then
      if [ "$a" = "0" ]; then printf 'whole'; return 0; fi
      r="$a-$((a + 1))"
    else
      r="$a-$((a + b - 1))"
    fi
    ranges="${ranges:+$ranges,}$r"
  done <<<"$hunks"
  [ -n "$ranges" ] || { printf 'whole'; return 0; }
  printf '%s' "$ranges"
}
cmd_claim() {
  local lane="$1" kind="$2" self_pr="$3" worktree="$4" repo="$5"; shift 5
  local remote now main_tip prmap tip claims attempt paths out new_lines final_out i p held granted refused unclaimed existing new_grants cap_hit reason pr holder path changed_files line saw_cap saw_prs hpr prs_for_path holders own_hold blocked
  remote="$(default_remote "$repo")"; now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  [ $# -gt 0 ] || usage
  for p in "$@"; do valid_path "$p" || die 2 "not a repo-relative path: $p"; done
  # Reap terminal ticket/PR holds before deciding whether this claim can run.
  "$script_dir/file-claim" reap --repo "$repo" || die 2 "cannot reap claims before claim"
  paths=()
  for p in "$@"; do
    held=0
    if [ "${#paths[@]}" -gt 0 ]; then for i in "${paths[@]}"; do if [ "$i" = "$p" ]; then held=1; break; fi; done; fi
    if [ "$held" = "0" ]; then paths+=("$p"); fi
  done
  new_workdir
  build_prmap "$repo"
  attempt=1
  while [ "$attempt" -le "$TRIES" ]; do
    main_tip="$(fetch_main_tip "$remote")"; tip="$(fetch_claim_tip "$remote")"; claims="$W/claims.tsv"; load_claims "$tip" "$claims"
    out=(); new_lines=(); granted=0; refused=0; saw_cap=0; saw_prs=""
    existing="$(awk -F'\t' -v l="$lane" '$2==l&&$3=="grant"{n++}END{print n+0}' "$claims")"; new_grants=0
    for p in "${paths[@]}"; do if [ "$kind" = grant ] && [ -z "$(awk -F'\t' -v q="$p" -v l="$lane" '$1==q&&$2==l{print $2;exit}' "$claims")" ]; then new_grants=$((new_grants + 1)); fi; done
    if [ "$((existing + new_grants))" -gt "$MAX_GRANT" ]; then cap_hit=1; else cap_hit=0; fi
    for p in "${paths[@]}"; do
      reason="new"
      if [ "$(git -C "$W" cat-file -t "$main_tip:$p" 2>/dev/null)" = blob ]; then reason="exists"; fi
      prs_for_path="$(awk -F'\t' -v q="$p" -v s="$self_pr" '$2==q&&index(","s",", ","$1",")==0{print $1}' "$prmap" | sort -n)"
      blocked=0; own_hold=0
      if [ -n "$prs_for_path" ]; then
        if [[ "$lane" == sweep-* ]]; then
          pr="$(printf '%s\n' "$prs_for_path" | head -1)"
          out+=("REFUSE $p pr#$pr hunks=$(pr_hunks "$repo" "$pr" "$p")")
          case " $saw_prs " in *" $pr "*) ;; *) saw_prs="$saw_prs $pr";; esac
          blocked=1
        else
          while IFS= read -r pr || [ -n "$pr" ]; do
            [ -n "$pr" ] || continue
            out+=("OVERLAP $p pr#$pr")
          done <<< "$prs_for_path"
        fi
      fi
      holders="$(awk -F'\t' -v q="$p" '$1==q{print $2}' "$claims" | sort -u)"
      while IFS= read -r holder || [ -n "$holder" ]; do
        [ -n "$holder" ] || continue
        if [ "$holder" = "$lane" ]; then
          own_hold=1
        elif [[ "$holder" == sweep-* ]]; then
          out+=("REFUSE $p exclusive lane:$holder")
          blocked=1
        elif [[ "$lane" == sweep-* ]]; then
          out+=("REFUSE $p lane:$holder")
          blocked=1
        else
          out+=("OVERLAP $p lane:$holder")
        fi
      done <<< "$holders"
      if [ "$blocked" = "1" ]; then refused=$((refused + 1)); continue; fi
      if [ "$own_hold" = "1" ]; then out+=("GRANT $p $reason"); granted=$((granted + 1)); continue; fi
      if [ "$kind" = grant ] && [ "$cap_hit" = "1" ]; then out+=("REFUSE $p cap"); refused=$((refused + 1)); saw_cap=1; continue; fi
      out+=("PENDING $p $reason"); granted=$((granted + 1)); new_lines+=("$(printf '%s\t%s\t%s\t%s\t%s\t%s' "$p" "$lane" "$kind" "$now" "$worktree" "$self_pr")")
    done
    if [ "$refused" -gt 0 ]; then
      final_out=(); unclaimed=0
      for line in "${out[@]}"; do
        case "$line" in
          PENDING\ *) path=${line#PENDING }; path=${path%% *}; final_out+=("UNCLAIMED $path batch-refused"); unclaimed=$((unclaimed + 1));;
          *) final_out+=("$line");;
        esac
      done
      printf '%s\n' "${final_out[@]}" "file-claim: no claims recorded; $refused refused, $unclaimed unclaimed because the batch was refused"
      if [ "$saw_cap" = "1" ]; then printf 'hint: grant cap of %s reached (FILE_CLAIM_MAX_GRANT=%s); this is a cap, not a collision with another holder\n' "$MAX_GRANT" "$MAX_GRANT" >&2; fi
      for hpr in $saw_prs; do printf "hint: if PR %s is this lane's own PR, rerun with --self-pr %s\n" "$hpr" "$hpr" >&2; done
      exit 1
    fi
    if [ "${#new_lines[@]}" -eq 0 ]; then report 0; fi
    { cat "$claims"; printf '%s\n' "${new_lines[@]}"; } >"$claims.new"
    if store_claims "$remote" "$claims.new" "$tip"; then
      final_out=()
      for line in "${out[@]}"; do
        case "$line" in
          PENDING\ *) final_out+=("GRANT ${line#PENDING }");;
          *) final_out+=("$line");;
        esac
      done
      out=("${final_out[@]}")
      report 0
    fi
    attempt=$((attempt + 1)); jitter_sleep
  done
  die 2 "cannot push $REF: still rejected after $TRIES tries"
}
cmd_release() {
  local lane="$1" repo="$2"; shift 2
  local remote tip claims kept dropped p line attempt
  remote="$(default_remote "$repo")"
  for p in "$@"; do valid_release_path "$p" || die 2 "not a repo-relative path: $p"; done
  new_workdir
  kept="$W/kept.tsv"; dropped="$W/dropped.txt"
  attempt=1
  while [ "$attempt" -le "$TRIES" ]; do
    fetch_main_tip "$remote" >/dev/null
    tip="$(fetch_claim_tip "$remote")"
    claims="$W/claims.tsv"
    load_claims "$tip" "$claims"
    filter_release "$claims" "$lane" "$kept" "$dropped" "$@"
    if [ ! -s "$dropped" ]; then exit 0; fi
    if store_claims "$remote" "$kept" "$tip"; then while IFS= read -r line || [ -n "$line" ]; do [ -n "$line" ] || continue; printf 'RELEASE %s\n' "$line"; done <"$dropped"; exit 0; fi
    attempt=$((attempt + 1)); jitter_sleep
  done
  die 2 "cannot push $REF: still rejected after $TRIES tries"
}
ticket_state_is_terminal() {
  local number="$1" states="$2" state
  state="$(awk -F '\t' -v n="$number" '$1 == n { print $2; exit }' "$states")"
  case "$state" in CLOSED|MERGED) return 0;; esac
  return 1
}

cmd_reap() {
  local repo="$1" remote run_dir attempt=1 tip claims numbers prefix lookup_rc expected actual
  local line c_path c_lane c_kind c_at c_wt c_pr ticket pr_number reason path
  local kept dropped dropped_files grant_prs grant_file base grant_ticket
  remote="$(default_remote "$repo")"
  run_dir="$(ticket_states_run_dir)"
  new_workdir
  while [ "$attempt" -le "$TRIES" ]; do
    fetch_main_tip "$remote" >/dev/null
    tip="$(fetch_claim_tip "$remote")"
    claims="$W/claims.tsv"
    load_claims "$tip" "$claims"
    numbers="$W/ticket-numbers.tsv"
    : >"$numbers"
    while IFS="$TAB" read -r c_path c_lane c_kind c_at c_wt c_pr || [ -n "$c_path" ]; do
      [ -n "$c_path" ] || continue
      case "$c_lane" in sweep-*) continue;; esac
      ticket="$(lane_ticket_num "$c_lane")"
      [ -z "$ticket" ] || printf '%s\n' "$ticket" >>"$numbers"
      if [ -n "$c_pr" ]; then
        IFS=',' read -r -a pr_numbers <<<"$c_pr"
        for pr_number in "${pr_numbers[@]}"; do
          case "$pr_number" in ''|*[!0-9]*) continue;; esac
          printf '%s\n' "$pr_number" >>"$numbers"
        done
      fi
    done <"$claims"
    for grant_file in "$run_dir"/fiber-*-fence-grant*.md; do
      [ -f "$grant_file" ] || continue
      base="${grant_file##*/}"
      base="${base%-fence-grant*}"
      grant_ticket="$(lane_ticket_num "$base")"
      [ -z "$grant_ticket" ] || printf '%s\n' "$grant_ticket" >>"$numbers"
    done
    if ! sort -un "$numbers" -o "$numbers" 2>"$W/ticket-sort.err"; then
      echo "file-claim: reap skipped: cannot sort ticket numbers; all holds kept" >&2
      return 0
    fi
    [ -s "$numbers" ] || return 0
    prefix="$W/ticket-state"
    lookup_rc=0
    ticket_states_lookup "$repo" "$numbers" "$prefix" || lookup_rc=$?
    if [ "$lookup_rc" -ne 0 ] || [ -s "$prefix.warnings" ]; then
      if [ "$lookup_rc" -eq 1 ]; then
        reason="$(head -c 200 "$prefix.err" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
        [ -n "$reason" ] || reason="GitHub lookup failed"
      elif [ "$lookup_rc" -eq 2 ]; then
        reason="unreadable response"
      else
        reason="partial or unknown response"
      fi
      echo "file-claim: reap skipped: ticket state lookup $reason; all holds kept" >&2
      return 0
    fi
    expected="$(awk 'NF { n++ } END { print n+0 }' "$numbers")"
    actual="$(awk 'NF { n++ } END { print n+0 }' "$prefix.states")"
    if [ "$expected" != "$actual" ]; then
      echo "file-claim: reap skipped: ticket state lookup incomplete; all holds kept" >&2
      return 0
    fi

    kept="$W/kept.tsv"; dropped="$W/dropped.tsv"; dropped_files="$W/dropped-files.tsv"; grant_prs="$W/grant-prs.tsv"
    : >"$kept"; : >"$dropped"; : >"$dropped_files"; : >"$grant_prs"
    while IFS="$TAB" read -r c_path c_lane c_kind c_at c_wt c_pr || [ -n "$c_path" ]; do
      [ -n "$c_path" ] || continue
      reason=""
      case "$c_lane" in
        sweep-*) ;;
        *)
          ticket="$(lane_ticket_num "$c_lane")"
          if [ -n "$ticket" ] && ticket_state_is_terminal "$ticket" "$prefix.states"; then
            reason="ticket #$ticket closed"
          elif [ -n "$c_pr" ]; then
            IFS=',' read -r -a pr_numbers <<<"$c_pr"
            for pr_number in "${pr_numbers[@]}"; do
              case "$pr_number" in ''|*[!0-9]*) continue;; esac
              if ticket_state_is_terminal "$pr_number" "$prefix.states"; then
                reason="PR #$pr_number closed"
                [ -z "$ticket" ] || printf '%s\t%s\n' "$ticket" "$pr_number" >>"$grant_prs"
                break
              fi
            done
          fi
          ;;
      esac
      if [ -n "$reason" ]; then
        printf '%s\t%s\t%s\n' "$c_path" "$c_lane" "$reason" >>"$dropped"
      else
        printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$c_path" "$c_lane" "$c_kind" "$c_at" "$c_wt" "$c_pr"
      fi
    done <"$claims" >"$kept"

    for grant_file in "$run_dir"/fiber-*-fence-grant*.md; do
      [ -f "$grant_file" ] || continue
      base="${grant_file##*/}"
      base="${base%-fence-grant*}"
      grant_ticket="$(lane_ticket_num "$base")"
      [ -n "$grant_ticket" ] || continue
      if ticket_state_is_terminal "$grant_ticket" "$prefix.states" || grep -q "^${grant_ticket}${TAB}" "$grant_prs"; then
        printf '%s\t%s\n' "$grant_file" "$grant_ticket" >>"$dropped_files"
      fi
    done

    if [ -s "$dropped" ]; then
      if ! store_claims "$remote" "$kept" "$tip"; then
        attempt=$((attempt + 1))
        jitter_sleep
        continue
      fi
    fi
    while IFS="$TAB" read -r path ticket reason || [ -n "$path" ]; do
      [ -n "$path" ] || continue
      printf 'REAP claim %s by %s (%s)\n' "$path" "$ticket" "$reason"
    done <"$dropped"
    while IFS="$TAB" read -r grant_file grant_ticket || [ -n "$grant_file" ]; do
      [ -n "$grant_file" ] || continue
      rm -f "$grant_file" || die 2 "cannot remove stale fence grant $grant_file"
      printf 'REAP grant %s (ticket #%s or associated PR closed)\n' "${grant_file##*/}" "$grant_ticket"
    done <"$dropped_files"
    return 0
  done
  die 2 "cannot reap claims: still rejected after $TRIES tries"
}

cmd_list() {
  local lane="$1" repo="$2"
  local remote tip claims epochs now line c_path c_lane c_kind c_at c_wt c_pr c_epoch age pr path prmap
  remote="$(default_remote "$repo")"
  new_workdir
  if [ -z "$lane" ]; then
    prmap="$W/prmap"
    build_prmap "$repo" &
    LIST_PRMAP_PID=$!
  fi
  tip="$(fetch_claim_tip "$remote")"; claims="$W/claims.tsv"; epochs="$W/claims-epochs"; load_claims "$tip" "$claims" "$epochs"; now="$(date -u +%s)"
  if [ -n "$LIST_PRMAP_PID" ]; then
    if wait "$LIST_PRMAP_PID"; then
      LIST_PRMAP_PID=""
    else
      LIST_PRMAP_PID=""
      exit 2
    fi
  fi
  {
    exec 3<"$epochs"
    while IFS= read -r line || [ -n "$line" ]; do
      [ -n "$line" ] || continue
      IFS="$TAB" read -r c_epoch <&3 || die 2 "claims epoch list is corrupt"
      IFS="$TAB" read -r c_path c_lane c_kind c_at c_wt c_pr <<<"$line"
      case "$c_path" in *[[:space:]]*) printf 'file-claim: warning: claimed path contains whitespace: %s\n' "$c_path" >&2;; esac
      if [ -n "$lane" ] && [ "$c_lane" != "$lane" ]; then continue; fi
      age=$((now - c_epoch)); if [ "$age" -lt 0 ]; then age=0; fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$c_path" "$c_lane" "$c_kind" "$age" "$c_wt" "$c_pr"
    done <"$claims"
    exec 3<&-
    if [ -z "$lane" ]; then
      while IFS="$TAB" read -r pr path || [ -n "$pr" ]; do
        [ -n "$pr" ] && [ -n "$path" ] || continue
        printf '%s\tpr#%s\tpr\t-\t-\t%s\n' "$path" "$pr" "$pr"
      done <"$prmap"
    fi
  } | LC_ALL=C sort -t "$TAB" -k1,1
}
main() {
  [ $# -ge 1 ] || usage
  local cmd="$1"; shift
  case "$cmd" in claim|release|prune|list|reap) ;; *) usage;; esac
  local lane="" mode="" self_pr="" worktree="" repo="$REPO_DEFAULT" plan_file="" ticket_num="" holder=""
  local paths line p; paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --lane) [ $# -ge 2 ] || usage; lane="$2"; shift 2;;
      --paths|--plan) [ "$cmd" = claim ] || usage; [ -z "$mode" ] || usage; mode="plan"; shift;;
      --plan-file) [ "$cmd" = claim ] || usage; [ -z "$mode" ] || usage; [ $# -ge 2 ] || usage; valid_field "$2" || usage; mode="plan"; plan_file="$2"; shift 2;;
      --grant) [ "$cmd" = claim ] || usage; [ -z "$mode" ] || usage; mode="grant"; shift;;
      --self-pr) [ "$cmd" = claim ] || usage; [ $# -ge 2 ] || usage; self_pr="${self_pr:+$self_pr,}$2"; shift 2;;
      --worktree) [ "$cmd" = claim ] || usage; [ $# -ge 2 ] || usage; worktree="$2"; shift 2;;
      --repo) [ $# -ge 2 ] || usage; repo="$2"; shift 2;;
      --) shift; while [ $# -gt 0 ]; do paths+=("$1"); shift; done;;
      --*) usage;;
      *) paths+=("$1"); shift;;
    esac
  done
  case "$self_pr" in "") ;; *[!0-9,]*|,*|*,|*,,*) usage;; esac
  [ -n "$repo" ] || usage; valid_field "$repo" || usage
  case "$cmd" in
    claim) [ -n "$lane" ] || usage; valid_field "$lane" || usage
      ticket_num="$(lane_ticket_num "$lane")"
      if [ -z "$ticket_num" ]; then
        echo "ERROR lane has no ticket number: $lane (expected fiber-<n> or sweep-<n>)" >&2
        exit 2
      fi
      case "$lane" in
        sweep-*) ;;
        *)
          holder="$(claim_holder "$ticket_num")"
          if [ "$lane" != "$holder" ]; then
            echo "RENAME-LANE $lane: no file is held or refused; rerun with --lane $holder (one holder name per ticket, so retirement releases every claim)" >&2
            exit 2
          fi
          ;;
      esac
      [ -n "$mode" ] || usage
      if [ -z "$worktree" ]; then worktree="$(hostname -s 2>/dev/null || hostname 2>/dev/null || printf 'unknown'):$(pwd)"; fi
      valid_field "$worktree" || usage
      if [ -n "$plan_file" ]; then
        # --plan-file takes exactly one plan; only its Files writes are claimed.
        [ "${#paths[@]}" -eq 0 ] || usage
        [ -f "$plan_file" ] && [ -r "$plan_file" ] || die 2 "cannot read plan file: $plan_file"
        while IFS= read -r line || [ -n "$line" ]; do paths+=("$line"); done < <(plan_files_pathspecs "$plan_file" writes)
        [ "${#paths[@]}" -gt 0 ] || die 2 "no paths in the Files section of $plan_file"
      else
        [ "${#paths[@]}" -gt 0 ] || usage
        if [ "$mode" = plan ]; then
          for p in "${paths[@]}"; do
            if is_plan_file "$p"; then die 2 "$p is a plan file, not a path to claim; pass its Files paths after --paths, or the plan with --plan-file $p"; fi
          done
        fi
      fi
      cmd_claim "$lane" "$mode" "$self_pr" "$worktree" "$repo" "${paths[@]}";;
    release) [ -n "$lane" ] || usage; valid_field "$lane" || usage; if [ "${#paths[@]}" -gt 0 ]; then cmd_release "$lane" "$repo" "${paths[@]}"; else cmd_release "$lane" "$repo"; fi;;
    prune) [ -n "$lane" ] || usage; valid_field "$lane" || usage; [ "${#paths[@]}" -eq 0 ] || usage; cmd_release "$lane" "$repo";;
    list) if [ -n "$lane" ]; then valid_field "$lane" || usage; fi; cmd_list "$lane" "$repo";;
    reap) [ -z "$lane" ] && [ -z "$mode" ] && [ "${#paths[@]}" -eq 0 ] || usage; cmd_reap "$repo";;
  esac
}
main "$@"
