#!/bin/bash
# lanewatch [--once] <run-dir> [ssh-target]: print each lane's first SETTLED
# or STALL row, so a monitor need not poll. `--once` prints the state now and
# exits; otherwise the watcher repeats every LANEWATCH_INTERVAL seconds.
# Every ssh or lanestat failure prints WATCH-ERROR: silence means no lane
# changed state, never that the watcher died. A queued prompt can return while
# its tool call continues; lanestat classifies the last tool event, not that
# trailing response. Never read a lane's fiber-<n>-pi.in: it is a FIFO.
set -u

usage() {
  printf 'usage: lanewatch [--once] <run-dir> [ssh-target]\n' >&2
  exit 2
}

once=
if [ "${1:-}" = --once ]; then
  once=yes
  shift
fi
[ "$#" -ge 1 ] && [ "$#" -le 2 ] || usage
run=$1
shift
target=
if [ "$#" -eq 1 ]; then
  target=$1
  [ -n "$target" ] || usage
fi
interval=${LANEWATCH_INTERVAL:-120}
case $interval in
  *[!0-9]*)
    printf 'lanewatch: invalid LANEWATCH_INTERVAL: %s (must be a non-negative integer)\n' "$interval" >&2
    exit 2
    ;;
esac
here=$(cd "$(dirname "$0")" && pwd)
label=local
[ -z "$target" ] || label=$target
seen=

cycle() {
  local out rc line n kind key quoted_run
  if [ -n "$target" ]; then
    printf -v quoted_run '%q' "$run"
    if out=$(ssh -o BatchMode=yes -o ConnectTimeout=20 "$target" bash -s -- "$quoted_run" \
      <"$here/lanestat" 2>&1); then
      :
    else
      rc=$?
      printf 'WATCH-ERROR %s lanestat exit %s\n' "$label" "$rc"
      return 0
    fi
  else
    if out=$(sh "$here/lanestat" "$run" 2>&1); then
      :
    else
      rc=$?
      printf 'WATCH-ERROR %s lanestat exit %s\n' "$label" "$rc"
      return 0
    fi
  fi

  while IFS= read -r line; do
    case $line in
      *SETTLED*|*STALL*) ;;
      *) continue ;;
    esac
    n=${line%% *}
    kind=stall
    case $line in *SETTLED*) kind=settled ;; esac
    key="$label-$n-$kind"
    if printf '%s\n' "$seen" | grep -Fqx "$key"; then
      continue
    fi
    seen="${seen}${key}
"
    printf '%s lane %s\n' "$label" "$line"
  done <<< "$out"
}

while :; do
  cycle
  [ -n "$once" ] && break
  sleep "$interval"
done
exit 0
