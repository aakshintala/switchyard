#!/bin/bash
# lanewatch [--once] <run-dir> [ssh-target]: print dated SETTLED, STALL and
# WEDGED lane rows once per settle minute, so a monitor need not poll.
# `--once` prints the state now and exits; otherwise the watcher repeats every
# LANEWATCH_INTERVAL seconds. Every ssh or lanestat failure prints WATCH-ERROR:
# silence means no lane changed state, never that the watcher died. Never read
# a lane's fiber-<n>-pi.in: it is a FIFO.
set -u

ts() { date "+%Y-%m-%d %H:%M:%S %Z"; }

usage() {
  printf 'usage: lanewatch [--once] <run-dir> [ssh-target]\n' >&2
  exit 2
}

once=
if [ "${1:-}" = --once ]; then
  once=yes
  shift
fi
[ "$#" -ge 1 ] && [ "$#" -le 2 ] || usage
run=$1
shift
target=
if [ "$#" -eq 1 ]; then
  target=$1
  [ -n "$target" ] || usage
fi
interval=${LANEWATCH_INTERVAL:-120}
case $interval in
  *[!0-9]*)
    printf 'lanewatch: LANEWATCH_INTERVAL must be a non-negative integer\n' >&2
    exit 2
    ;;
esac
here=$(cd "$(dirname "$0")" && pwd)
label=local
[ -z "$target" ] || label=$target
seen=

cycle() {
  local out rc line quoted_run n agev kind key at age_index state_index i state
  local fields=()
  if [ -n "$target" ]; then
    printf -v quoted_run '%q' "$run"
    if out=$(ssh -o BatchMode=yes -o ConnectTimeout=20 "$target" bash -s -- "$quoted_run" \
      <"$here/lanestat" 2>&1); then
      :
    else
      rc=$?
      printf '%s WATCH-ERROR %s lanestat exit %s\n' "$(ts)" "$label" "$rc"
      return 0
    fi
  else
    if out=$(sh "$here/lanestat" "$run" 2>&1); then
      :
    else
      rc=$?
      printf '%s WATCH-ERROR %s lanestat exit %s\n' "$(ts)" "$label" "$rc"
      return 0
    fi
  fi

  while IFS= read -r line; do
    IFS=$' \t\n' read -r -a fields <<<"$line"
    [ "${#fields[@]}" -gt 0 ] || continue
    n=${fields[0]}
    age_index=-1
    for ((i = 0; i < ${#fields[@]}; i++)); do
      case ${fields[$i]} in
        age=*) age_index=$i; break ;;
      esac
    done
    [ "$age_index" -ge 0 ] || continue
    state_index=$((age_index + 1))
    [ "$state_index" -lt "${#fields[@]}" ] || continue
    agev=${fields[$age_index]#age=}
    case $agev in ''|*[!0-9]*) agev=0 ;; esac
    state=${fields[$state_index]}
    case $state in
      SETTLED|SETTLED-OLD) kind=settled ;;
      STALL) kind=stall ;;
      WEDGED) kind=wedged ;;
      *) continue ;;
    esac
    at=$(( ($(date +%s) - agev) / 60 ))
    key="$label-$n-$kind-$at"
    if printf '%s\n' "$seen" | grep -Fqx -- "$key"; then
      continue
    fi
    seen="${seen}${key}
"
    printf '%s %s lane %s\n' "$(ts)" "$label" "$line"
  done <<< "$out"
}

while :; do
  cycle
  [ -n "$once" ] && break
  sleep "$interval"
done
exit 0
