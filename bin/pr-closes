#!/usr/bin/env bash
# pr-closes: before a merge, check that a PR closes exactly the issues it means to.
# Usage: pr-closes <pr> [--repo OWNER/NAME]
#        pr-closes --check   (reads `gh pr view --json number,title,body,commits` JSON on stdin)
#        A keyword naming the PR's own number (#N, or OWNER/REPO#N for its own repo)
#        is ignored, since GitHub closes issues only.
#        Scans the PR title, body and every commit message for a GitHub closing
#        keyword (close/closes/closed, fix/fixes/fixed, resolve/resolves/resolved,
#        any case, optional colon) before #N or OWNER/REPO#N. The issues the PR
#        means to close are its body's `Resolves #N` lines. Prints one line per
#        keyword match whose issue is not in that list, as
#        "<issue> <title|body|commit SHA>: <matched text>", and exits 1.
#        Exits 0 with one OK line when every closed issue is in the list.
#        Exit 2 on bad usage, or when the repo, the PR or its JSON cannot be read.
set -euo pipefail

usage() {
  {
    echo "usage: pr-closes <pr> [--repo OWNER/NAME]"
    echo "       pr-closes --check   (PR JSON on stdin)"
  } >&2
  exit 2
}

# One TSV row per keyword match: in-Resolves flag, issue ref (lowercased),
# source label, matched text. jq's regex works on whole strings, so no text
# is ever framed with a delimiter it could itself contain.
# shellcheck disable=SC2016  # $vars below are jq's, not the shell's
SCAN='
  def clean: (. // "") | gsub("\r"; "");
  def ref: "(?<ref>(?:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#[0-9]+)";
  if type != "object" or (.title | type) != "string" or (.body | type) != "string"
     or (.commits | type) != "array"
     or any(.commits[]; type != "object" or ([.oid, .messageHeadline, .messageBody]
                                            | map(type) != ["string", "string", "string"]))
  then error("not PR JSON") else . end
  | . as $pr | ($pr.number // "" | tostring) as $num
  | [.body | clean | split("\n")[]
     | capture("^\\s*resolves:?[ \\t]*" + ref; "i") | .ref | ascii_downcase] as $resolves
  | (["title", .title], ["body", .body],
     (.commits[] | ["commit " + .oid[0:7],
                    ((.messageHeadline | clean) + "\n\n" + (.messageBody | clean))]))
  | .[0] as $label
  | .[1] | clean
  | match("(?<![A-Za-z0-9_])(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?):?\\s*" + ref; "gi")
  | (.captures[] | select(.name == "ref") | .string | ascii_downcase) as $ref
  | select($ref != "#" + $num and $ref != ($repo | ascii_downcase) + "#" + $num)
  | [($resolves | index([$ref]) != null), $ref, $label, .string] | @tsv
'

# check [OWNER/NAME]: reads PR JSON on stdin, prints the report, returns 0, 1 or 2.
# With no repo (--check), OWNER/REPO#N refs are never treated as the PR's own.
check() {
  local json rows repo="${1:-}"
  json="$(cat)"
  [ -n "$json" ] || { echo "pr-closes: no PR JSON on stdin" >&2; return 2; }
  rows="$(jq -r --arg repo "$repo" "$SCAN" <<<"$json" 2>/dev/null)" \
    || { echo "pr-closes: input is not PR JSON" >&2; return 2; }

  local ok ref label text stray=0 total=0
  while IFS=$'\t' read -r ok ref label text; do
    total=$((total + 1))
    if [ "$ok" != "true" ]; then
      echo "$ref $label: $text"
      stray=$((stray + 1))
    fi
  done < <([ -z "$rows" ] || printf '%s\n' "$rows")

  if [ "$stray" -gt 0 ]; then
    echo "pr-closes: $stray closing reference(s) outside the Resolves list; rephrase them (\"see #N\") or add Resolves lines" >&2
    return 1
  fi
  echo "OK: all $total closing reference(s) are in the Resolves list"
}

[ $# -ge 1 ] || usage
if [ "$1" = "--check" ]; then
  [ $# -eq 1 ] || usage
  check
  exit $?
fi

pr="$1"; shift
case "$pr" in ''|*[!0-9]*) usage ;; esac
repo=""
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) [ $# -ge 2 ] || usage; repo="$2"; shift 2 ;;
    *) usage ;;
  esac
done
if [ -z "$repo" ]; then
  repo="$(gh repo view --json nameWithOwner --jq .nameWithOwner)" \
    || { echo "pr-closes: cannot find the repo; pass --repo OWNER/NAME" >&2; exit 2; }
fi

json="$(gh pr view "$pr" --repo "$repo" --json number,title,body,commits)" \
  || { echo "pr-closes: cannot read PR $pr in $repo" >&2; exit 2; }
printf '%s' "$json" | check "$repo"
