#!/usr/bin/env python3
# ci-friction --repo owner/name [--since 24h] [--state ~/.cache/switchyard/ci-friction.json]
#              [--min-lanes 2] [--json]
#
# Cross-lane CI failure classifier: the same test or cause failing in >=2
# lanes (a PR or main) within --since, and flakes recurring after their issue
# closed. Companion to ci-health. Reads `gh api` plus a state file caching
# each failed job's classification (never the raw log), branch->lane
# lookups, and per-test issue matches. Writes only its state file.
#
# Classification follows classify.py's names and order. Repeats key on test
# names (test-*, mutants-baseline-test jobs) and, for compile and
# mutants-baseline-compile jobs, on `compile <crates>: <first error line>`.
# design[] counts every other class except missed-mutant, other and cancelled.
#
# An issue search runs once per new test name; a cached open issue is re-read
# when its test is sighted again. One uncached search lists the open
# "Flaky test: <test>" issues (retry-passed flakes); a flake with 2+ sightings
# (github-actions retry comments inside the window) counts as a finding. Read-only: an open
# "blocked" issue whose named blockers (a "## Blocked by" section's #N refs,
# and "waits for #N" anywhere) are all closed is a stale-blocked finding; a
# blocker whose lookup fails counts as open. Exit codes: 0 none, 1 a
# repeat, a recurrence after close, a flaky finding, or a stale-blocked issue,
# 2 error. With --json only JSON is printed.
# CI_FRICTION_NOW (ISO UTC) pins "now"; it exists for tests only.
import json, os, re, subprocess, sys, time
from datetime import datetime, timedelta, timezone

# timeout-minutes from fiber's .github/workflows/ci.yml, as read on 2026-10-19:
# Selection 41, Linux x86_64 checks 187, Tests linux 240 (20), Tests macos 365
# (macos-26 25, else 20), Mutants 384 (shard_timeout default 40), Bug fix 468,
# Release build 493 (50 on a PR, 60 on push; the PR bound is the one kept here),
# Report a failed backstop 711, Benchmark comment 765, CI verdict 925.
BOUND = {"Selection": 5, "Linux x86_64 checks": 5, "Tests macos": 25,
         "Tests linux-x64": 20, "Tests linux-arm": 20, "Mutants": 40,
         "Release build and size (Linux x86_64)": 50,
         "Bug fix fails at the red commit": 10, "Benchmark comment": 5,
         "CI verdict": 5, "Report a failed backstop": 5}
# a::b::C -> C in compile keys, so rustc's full and short spellings match
# bump when compile-key format or the timeout rule changes; a state file
# without this one reclassifies its compile and timeout jobs
KEY_VERSION = 3
COMPILE_CLASSES = ("compile", "mutants-baseline-compile")
TYPE_PATH = re.compile(r"\b(?:[A-Za-z_]\w*::)+([A-Za-z_]\w*)")
ANSI = re.compile(r"(\x1b|\^\[)\[[0-9;]*[A-Za-z]")
TS = re.compile(r"^\S+Z ")
NX = re.compile(r"^\s*(FAIL|TIMEOUT) \[\s*[\d.]+s\]\s+"
                r"(?:\(\s*\d+/\d+\)\s+)?(\S+)\s+(\S+)", re.M)
PANIC = re.compile(r"thread '([^']+)' panicked at")
# Waits before a 5xx retry and before a search rate-limit retry when the reset
# time cannot be read. CI_FRICTION_RETRY_SLEEP lets the tests skip the wait.
try:
    RETRY_WAIT = float(os.environ.get("CI_FRICTION_RETRY_SLEEP") or 5)
except ValueError:
    RETRY_WAIT = 5.0
SERVER_ERR = re.compile(r"HTTP 5\d\d")
RATE_LIMIT = re.compile(r"rate limit exceeded", re.I)  # gh puts "(HTTP 403)" last
NO_ISSUE_TTL = timedelta(hours=6)  # a no-issue lookup is retried after this
FLAKY_PREFIX = "Flaky test: "  # title prefix of the issues flake_report files
# the flake_report bot comment body; source: fiber .github/workflows/ci.yml flake_report step
FLAKE_RETRY_PHRASE = "passed after a retry on"
RUN_URL = re.compile(r"https://github\.com/\S+/actions/runs/\d+")
# #N or owner/name#N; the lookbehind keeps a ref from starting inside a word or path
REF = re.compile(r"(?<![\w./-])(?:([\w.-]+/[\w.-]+))?#(\d+)(?!\w)")
# ATX heading: up to 3 leading spaces, 1-6 #, then text and optional closing #s
HEADING = re.compile(r"^ {0,3}#{1,6}(?:[ \t]+(.*?))?(?:[ \t]+#+)?[ \t]*$")
WAITS = re.compile(r"waits for\s+(?:([\w.-]+/[\w.-]+))?#(\d+)(?!\w)", re.I)
USAGE = ("usage: ci-friction --repo owner/name [--since 24h] [--state PATH] "
         "[--min-lanes 2] [--json]")


class Fatal(Exception):
    pass


def fail(msg):
    raise Fatal(msg)


def parse_ts(s):
    try:
        return datetime.fromisoformat(s.replace("Z", "+00:00"))
    except (ValueError, AttributeError, TypeError):
        return None


def iso(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def dur(s, what):
    m = re.fullmatch(r"(\d+(?:\.\d+)?)(m|h)?", s or "")
    if not m:
        fail("bad --%s %r (want <n>m or <n>h)" % (what, s))
    return float(m.group(1)) * (60 if m.group(2) == "h" else 1)


def group(name):
    name = name or ""
    if name.startswith("Mutants"):
        return "Mutants"
    if name.startswith("Tests ("):
        inner = name[7:-1] if name.endswith(")") else name[7:]
        return {"ubuntu-24.04": "Tests linux-x64",
                "ubuntu-24.04-arm": "Tests linux-arm",
                "macos-26": "Tests macos"}.get(inner, name)
    if name.startswith("CI"):
        return "CI verdict"
    return name


def osof(labels):
    s = " ".join(labels or [])
    if "macos" in s:
        return "macOS"
    if "arm" in s:
        return "linux-arm"
    return "linux-x64"


def is_timeout(job):
    g = group(job.get("name"))
    if g not in BOUND or not job.get("runner_name"):
        return False
    if job.get("conclusion") != "cancelled":
        return False
    s, e = parse_ts(job.get("started_at")), parse_ts(job.get("completed_at"))
    if not s or not e:
        return False
    return (e - s).total_seconds() >= BOUND[g] * 60 - 30


def superseded(r, job, allruns):
    """A cancelled job of run r is superseded when a newer run on the same
    head branch and event was created before the job completed."""
    t0 = parse_ts(r.get("created_at") or "")
    t1 = parse_ts(job.get("completed_at") or "")
    if not t0 or not t1:
        return False
    for x in allruns:
        tx = parse_ts(x.get("created_at") or "")
        if (tx and t0 < tx < t1
                and x.get("head_branch") == r.get("head_branch")
                and x.get("event") == r.get("event")):
            return True
    return False


def clean(text):
    return [TS.sub("", ANSI.sub("", l)) for l in text.splitlines()]


def classify(name, steps, text, job=None, newer_run=False):
    """Port of classify.py. Returns (class, detail, tests[]).
    job is the gh job dict (or None): a cancelled job is a timeout only
    with the exceeded-maximum-execution-time line or a full bound of
    elapsed time, else class cancelled. A cancel superseded by a newer run
    is cancelled unless the maximum-execution-time line is there."""
    step = next((s.get("name", "") for s in steps or []
                 if s.get("conclusion") == "failure"), "")
    lines = clean(text)
    body = "\n".join(lines)
    comp = [l for l in lines if re.match(r"\s*error(\[E\d+\])?: ", l)
            and "aborting" not in l and "could not compile" not in l and "warning" not in l]
    crates = re.findall(r"could not compile `([^`]+)`", body)
    nx = NX.findall(body)
    panics = sorted(set(PANIC.findall(body)))
    missed = re.findall(r"^MISSED\s+(\S+)", body, re.M)
    mtimeout = re.findall(r"^TIMEOUT\s+(\S+:\d+:\d+.*)$", body, re.M)
    bench = ([l for l in lines if l.startswith("bench-report:")
              and (" over " in l or "fail" in l.lower())]
             or [l for l in lines if l.startswith("bench-report:")])
    steptimeout = [l for l in lines if "has timed out after" in l]
    size = [l for l in lines if l.startswith("release-size:") and ("over" in l or "exceed" in l)]
    install = [l for l in lines if l.startswith("##[error]install-action")
               or ("::error::install-action" in l and not l.lstrip().startswith("printf"))]
    errs = [l for l in lines if l.startswith("##[error]")]
    exitc = re.findall(r"Process completed with exit code (\d+)", body)
    nofile = [l for l in lines if "No such file or directory" in l and "scripts/" in l]
    bugred = [l for l in lines if l.startswith("bug-red:")]
    artifact = [l for l in lines if "Artifact not found" in l]

    def tests_of(found):
        return sorted({"%s %s" % (b, c) for _, b, c in found})

    if (name or "").startswith("Mutants") and exitc and not steptimeout:
        code = exitc[-1]
        if code == "2" and missed:
            return ("missed-mutant", "%d missed, first %s" % (len(missed), missed[0]), [])
        if code == "3":
            det = "%d mutant timeouts" % len(mtimeout)
            if mtimeout:
                det += ", first %s" % mtimeout[0][:90]
            return ("mutant-timeout", det, [])
        if code == "4":
            if crates and comp:
                first = TYPE_PATH.sub(r"\1", re.sub(r"\s*-->\s*.*$", "", comp[0].strip()))
                key = "compile %s: %s" % (",".join(sorted(set(crates))), first[:120])
                return ("mutants-baseline-compile", "%s: %s" % (
                    ",".join(sorted(set(crates))), comp[0].strip()[:120]), [key])
            names = sorted(set(tests_of(NX.findall(body))) | set(PANIC.findall(body)))
            return ("mutants-baseline-test", "%d: %s" % (len(names), "; ".join(names[:3])), names)
    if nofile and "127" in exitc:
        return ("ci-script-missing-at-base", nofile[0].split(": ", 1)[-1][:120], [])
    if artifact:
        return ("bench-artifact-missing", "benchmarks artifact not found", [])
    if bugred:
        return ("bug-red", bugred[-1][:140], [])
    if any(l.startswith("Diff in ") for l in lines) or (
            (name or "").startswith("Linux x86_64 checks")
            and any(l.startswith("+") for l in lines) and "scripts/check: FAIL" in body):
        return ("fmt", "cargo fmt --check diff", [])
    if steptimeout:
        return ("infra", steptimeout[0][:140], [])
    if step == "Set up job" or not lines:
        return ("infra", "runner setup failed", [])
    if crates and comp:
        first = TYPE_PATH.sub(r"\1", re.sub(r"\s*-->\s*.*$", "", comp[0].strip()))
        key = "compile %s: %s" % (",".join(sorted(set(crates))), first[:140])
        return ("compile", "%s: %s" % (",".join(sorted(set(crates))), comp[0].strip()[:140]), [key])
    if missed:
        return ("missed-mutant", "%d missed, first %s" % (len(missed), missed[0]), [])
    if nx or panics:
        names = sorted(set(tests_of(nx)) | set(panics))
        kinds = sorted({a.lower() for a, _, _ in nx} | ({"panic"} if panics else set()))
        return ("test-" + "/".join(kinds),
                "%d: %s" % (len(names), "; ".join(names[:3])), names)
    if mtimeout:
        return ("mutant-timeout", "%d timeouts, first %s" % (len(mtimeout), mtimeout[0][:100]), [])
    if bench:
        return ("bench-budget", bench[0][:160], [])
    if size:
        return ("size-budget", size[0][:160], [])
    if "baseline" in body.lower() and re.search(
            r"Unmutated baseline.*FAILED|baseline (test|build) failed", body, re.I):
        return ("mutants-baseline", "unmutated baseline failed", [])
    if install:
        return ("infra", install[0][:140], [])
    cancelled = bool(job) and job.get("conclusion") == "cancelled"
    canceled = any("The operation was canceled" in l for l in lines)
    exceeded = any("has exceeded the maximum execution time" in l for l in lines)
    if cancelled and newer_run and not exceeded:
        return ("cancelled", "superseded by a newer run", [])
    if exceeded or (canceled and (not cancelled or is_timeout(job))):
        return ("timeout", "job hit timeout-minutes", [])
    if canceled:
        return ("cancelled", "job cancelled before its timeout bound", [])
    return ("other", (errs[-1] if errs else (lines[-1] if lines else ""))[:160], [])


def wait_for_search_reset():
    """Sleep until the search limit resets, at most 65 s."""
    try:
        reset = json.loads(subprocess.run(
            ["gh", "api", "rate_limit"], capture_output=True, text=True,
            check=True).stdout)["resources"]["search"]["reset"]
        wait = min(max(float(reset) - time.time(), 0.0), 65.0)
    except (subprocess.CalledProcessError, ValueError, KeyError, TypeError):
        wait = min(RETRY_WAIT, 65.0)
    time.sleep(wait)


def gh_api(path, escape=False, fields=()):
    """One gh api call. A 5xx is retried after a pause; a search rate limit is
    retried after the reset. Each retries once; a second failure raises."""
    cmd = ["gh", "api"] + (["--allow-escape-sequences"] if escape else [])
    cmd += [path] + [x for f in fields for x in ("-f", f)]
    p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0 and "HTTP 403" in (p.stderr or "") and RATE_LIMIT.search(p.stderr):
        wait_for_search_reset()
        p = subprocess.run(cmd, capture_output=True, text=True)
    elif p.returncode != 0 and SERVER_ERR.search(p.stderr or ""):
        time.sleep(RETRY_WAIT)
        p = subprocess.run(cmd, capture_output=True, text=True)
    if p.returncode != 0:
        err = (p.stderr or "").strip().splitlines()
        msg = "\n".join(err[-3:])
        raise Fatal("gh api %s failed: %s" % (path.split("?")[0], msg))
    return p.stdout


def gh_paged(base, key):
    """Fetch per_page=100 pages until a short page; cap 10 (cap hit warns)."""
    items = []
    for page in range(1, 11):
        sep = "&" if "?" in base else "?"
        out = gh_api("%s%sper_page=100&page=%d" % (base, sep, page))
        data = json.loads(out)
        batch = data.get(key, []) if isinstance(data, dict) else data
        if not isinstance(batch, list):
            raise Fatal("gh api %s returned no %s list"
                        % (base.split("?")[0], key or "items"))
        items.extend(batch)
        if len(batch) < 100:
            return items
    print("ci-friction: page cap hit for %s" % base.split("?")[0],
          file=sys.stderr)
    return items


# GraphQL closer of the last close: the PR's merge commit, or a direct commit.
# fix_lookup versions the cached result; bump it when the lookup changes so
# null results from older versions are looked up again.
FIX_LOOKUP = 2
CLOSER_QUERY = ('{repository(owner:"%s",name:"%s"){issue(number:%s){'
                'timelineItems(itemTypes:CLOSED_EVENT,last:1){nodes{...on ClosedEvent{'
                'closer{__typename ...on PullRequest{mergeCommit{oid}} ...on Commit{oid}}}}}}}}')


def closing_commit(repo, number):
    owner, name = repo.split("/", 1)
    out = gh_api("graphql", fields=["query=" + CLOSER_QUERY % (owner, name, number)])
    try:
        nodes = json.loads(out)["data"]["repository"]["issue"]["timelineItems"]["nodes"]
    except (ValueError, KeyError, TypeError):
        raise Fatal("gh api graphql returned no closer list for #%s" % number)
    closer = (nodes[-1] or {}).get("closer") if nodes else None
    if not isinstance(closer, dict):
        return None
    if closer.get("__typename") == "PullRequest":
        return ((closer.get("mergeCommit") or {}).get("oid")) or None
    return closer.get("oid") or None


def named_blockers(body, repo):
    """[(display, repo, n)] for each blocker the body names, deduplicated.
    A bare #N is in `repo`; owner/name#N is in owner/name."""
    section, inside = [], False
    for line in body.splitlines():
        h = HEADING.match(line)
        if h:
            inside = (h.group(1) or "").strip().lower() == "blocked by"
        elif inside:
            section.append(line)
    refs = [m for line in section for m in REF.finditer(line)]
    refs += list(WAITS.finditer(body))
    out, seen = [], set()
    for m in refs:
        other, n = m.group(1), int(m.group(2))
        target = other or repo
        if (target.lower(), n) in seen:
            continue
        seen.add((target.lower(), n))
        out.append(("%s#%d" % (other, n) if other else "#%d" % n, target, n))
    return out


def load_state(path):
    try:
        with open(path) as fh:
            st = json.load(fh)
        assert isinstance(st, dict)
        return st
    except (OSError, ValueError, AssertionError) as e:
        print("ci-friction: state unreadable (%s), starting empty" % e, file=sys.stderr)
        return {}


def save_state(path, st):
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    tmp = path + ".tmp-%d" % os.getpid()
    with open(tmp, "w") as fh:
        json.dump(st, fh)
    os.replace(tmp, path)


def recurred_after(lanes):
    # A closed issue's test recurred when main or two distinct lanes fail it
    # after close. One PR lane alone is that PR's own failure, not a
    # recurrence; its flakes go to the flaky list (see #320).
    return "main" in lanes or len(lanes) >= 2


def main(argv):
    repo = since = state_path = lanes = None
    want_json = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--json":
            want_json = True
            i += 1
        elif a in ("--repo", "--since", "--state", "--min-lanes") and i + 1 < len(argv):
            i += 1
            if a == "--repo":
                repo = argv[i]
            elif a == "--since":
                since = argv[i]
            elif a == "--state":
                state_path = argv[i]
            elif a == "--min-lanes":
                lanes = argv[i]
            i += 1
        else:
            fail("unknown or incomplete flag %r\n%s" % (a, USAGE))
    if not repo or not re.fullmatch(r"[^/\s]+/[^/\s]+", repo):
        fail("missing --repo owner/name\n%s" % USAGE)
    since_min = dur(since or "24h", "since")
    if not since_min > 0:
        fail("bad --since (want > 0)")
    try:
        min_lanes = int(lanes or "2")
    except (ValueError, TypeError):
        fail("bad --min-lanes %r" % (lanes,))
    if min_lanes < 1:
        fail("bad --min-lanes %r (want >= 1)" % (lanes,))
    if not state_path:
        state_path = os.path.join(os.path.expanduser("~"), ".cache", "switchyard",
                                  "ci-friction.json")
    try:
        now = parse_ts(os.environ.get("CI_FRICTION_NOW") or "") or datetime.now(timezone.utc)
    except ValueError:
        fail("bad CI_FRICTION_NOW")
    cutoff = now - timedelta(minutes=since_min)

    st = load_state(state_path)
    if st.get("key_version") != KEY_VERSION:
        # compile keys cached before the path-collapse change, and timeouts cached
        # before the bound and supersession rules, are stale: reclassify once
        jobs_old = st.get("jobs") if isinstance(st.get("jobs"), dict) else {}
        st["jobs"] = {k: v for k, v in jobs_old.items()
                      if not (isinstance(v, dict) and (v.get("class") in COMPILE_CLASSES
                                                       or v.get("class") == "timeout"))}
    jobs_st = st.get("jobs") if isinstance(st.get("jobs"), dict) else {}
    issues_st = st.get("issues") if isinstance(st.get("issues"), dict) else {}
    branches_st = st.get("branches") if isinstance(st.get("branches"), dict) else {}
    compares = st.get("compares") if isinstance(st.get("compares"), dict) else {}
    owner = repo.split("/")[0]
    ok = True  # becomes exit 2 after state is written

    try:
        runs = []
        for page in range(1, 11):
            out = gh_api("repos/%s/actions/runs?created=>=%s&per_page=100&page=%d"
                         % (repo, iso(cutoff), page))
            batch = json.loads(out).get("workflow_runs", [])
            runs.extend(batch)
            if len(batch) < 100:
                break
        else:
            print("ci-friction: page cap hit for repos/%s/actions/runs" % repo,
                  file=sys.stderr)
    except Fatal as e:
        fail(str(e))
    allruns = runs  # unfiltered: a newer run supersedes a cancel whatever its conclusion
    runs = [r for r in runs if ((r.get("conclusion") in ("failure", "cancelled")
                                 or (r.get("run_attempt") or 1) > 1)
                                and parse_ts(r.get("created_at") or "")
                                and parse_ts(r["created_at"]) >= cutoff)]

    def lane_of(r):
        prs = r.get("pull_requests") or []
        if r.get("event") == "push" and r.get("head_branch") == "main":
            return "main"
        if prs:
            first = prs[0]
            n = first.get("number") if isinstance(first, dict) else first
            return "#%s" % n
        br = r.get("head_branch") or ""
        if br in branches_st:
            return branches_st[br]
        out = gh_api("repos/%s/pulls?state=all&head=%s:%s&per_page=1" % (repo, owner, br))
        items = json.loads(out)
        items = items if isinstance(items, list) else items.get("items", items)
        lane = "#%s" % items[0]["number"] if items else br
        branches_st[br] = lane
        return lane

    # sightings per repeat key: {key: [(lane, os, seen_iso)]}
    seen = {}
    # design counts per class: {class: (count, set(lanes))}
    design = {}
    resight = set()  # test keys sighted again (for open-issue re-read)

    try:
        for r in sorted(runs, key=lambda r: r.get("created_at") or ""):
            lane = lane_of(r)
            try:
                jobs = gh_paged("repos/%s/actions/runs/%s/jobs?filter=all"
                                % (repo, r.get("id")), "jobs")
            except Fatal as e:
                print("ci-friction: %s" % e, file=sys.stderr)
                ok = False
                continue
            for j in jobs:
                if j.get("conclusion") not in ("failure", "cancelled"):
                    continue
                if group(j.get("name")) in ("CI verdict", "Report a failed backstop"):
                    continue
                jid = str(j.get("id"))
                done_at = j.get("completed_at") or r.get("created_at")
                ent = jobs_st.get(jid)
                if isinstance(ent, dict) and ent.get("class"):
                    cls, det, tests = ent["class"], ent.get("detail", ""), ent.get("tests", [])
                else:
                    try:
                        log = gh_api("repos/%s/actions/jobs/%s/logs" % (repo, jid), escape=True)
                    except Fatal as e:
                        if "HTTP 404" in str(e):
                            if j.get("conclusion") == "cancelled":
                                cls, det, tests = ("cancelled",
                                                   "cancelled before it started", [])
                            else:
                                cls, det, tests = "no-log", "log not found (404)", []
                        else:
                            print("ci-friction: %s" % e, file=sys.stderr)
                            ok = False
                            continue
                    else:
                        cls, det, tests = classify(
                            j.get("name"), j.get("steps"), log, j,
                            j.get("conclusion") == "cancelled" and superseded(r, j, allruns))
                    jobs_st[jid] = {"class": cls, "detail": det, "tests": tests,
                                    "lane": lane, "os": osof(j.get("labels")),
                                    "completed_at": done_at,
                                    "head_sha": r.get("head_sha")}
                ent = jobs_st[jid]
                if cls.startswith("test-") or cls in ("mutants-baseline-test", "compile",
                                                      "mutants-baseline-compile"):
                    keys = tests if cls in ("compile", "mutants-baseline-compile") \
                        else [t for t in tests if t]
                    if cls in ("compile", "mutants-baseline-compile") and not keys:
                        keys = [det]
                    for key in keys:
                        seen.setdefault(key, []).append(
                            (ent.get("lane", lane), ent.get("os", osof(j.get("labels"))),
                             ent.get("completed_at", done_at),
                             ent.get("head_sha", r.get("head_sha"))))
                        resight.add(key)
                elif cls not in ("missed-mutant", "other", "cancelled"):
                    c, laneset = design.get(cls, (0, set()))
                    laneset.add(ent.get("lane", lane))
                    design[cls] = (c + 1, laneset)
    except Fatal as e:
        print("ci-friction: %s" % e, file=sys.stderr)
        ok = False

    # issue lookup per new test name; re-read cached open issues sighted again.
    # A no-issue entry is searched again once its searched_at is over 6 h old.
    for key in sorted(seen):
        ent = issues_st.get(key)
        searched = parse_ts(ent.get("searched_at") or "") if isinstance(ent, dict) else None
        if not isinstance(ent, dict) or "issue" not in ent or (
                ent.get("issue") is None
                and (searched is None or now - searched > NO_ISSUE_TTL)):
            last = key.split()[-1]
            try:
                out = gh_api("search/issues?q=repo:%s+is:issue+\"%s\""
                             % (repo, last))
                items = json.loads(out).get("items", [])
            except Fatal as e:
                print("ci-friction: %s" % e, file=sys.stderr)
                ok = False
                continue
            items.sort(key=lambda it: it.get("updated_at") or "", reverse=True)
            if items:
                it = items[0]
                issues_st[key] = {"issue": it.get("number"), "issue_state": it.get("state"),
                                  "closed_at": it.get("closed_at"),
                                  "updated_at": it.get("updated_at"),
                                  "searched_at": iso(now)}
            else:
                issues_st[key] = {"issue": None, "issue_state": None,
                                  "closed_at": None, "updated_at": None,
                                  "searched_at": iso(now)}
        elif ent.get("issue_state") == "open" and key in resight and ent.get("issue"):
            try:
                it = json.loads(gh_api("repos/%s/issues/%s" % (repo, ent["issue"])))
                ent.update({"issue_state": it.get("state"), "closed_at": it.get("closed_at"),
                            "updated_at": it.get("updated_at")})
            except Fatal as e:
                print("ci-friction: %s" % e, file=sys.stderr)
                ok = False

    # 18g: a closed issue naming a fixing commit drops pre-fix sightings.
    # compare/<fix>...<head> ahead/identical keeps, behind/diverged drops.
    for key in sorted(seen):
        ent = issues_st.get(key, {})
        if not ent.get("issue") or ent.get("issue_state") != "closed":
            continue
        if ent.get("fix_lookup") != FIX_LOOKUP:
            try:
                fix = closing_commit(repo, ent["issue"])
            except Fatal as e:
                print("ci-friction: %s" % e, file=sys.stderr)
                ok = False
                continue
            ent["fix_commit"] = fix
            ent["fix_lookup"] = FIX_LOOKUP
        if not ent.get("fix_commit"):
            continue  # no fixing commit: closed_at fallback below
        kept = []
        for s in seen[key]:
            if not s[3]:
                kept.append(s)  # head unknown: fail open
                continue
            pair = "%s...%s" % (ent["fix_commit"], s[3])
            if pair not in compares:
                try:
                    cmpj = json.loads(gh_api("repos/%s/compare/%s" % (repo, pair)))
                    compares[pair] = cmpj.get("status")
                except Fatal as e:
                    print("ci-friction: %s" % e, file=sys.stderr)
                    ok = False
                    kept.append(s)
                    continue
            if compares[pair] in ("ahead", "identical"):
                kept.append(s)
        seen[key] = kept
    seen = {k: v for k, v in seen.items() if v}

    repeats, recurred = [], []
    for key in sorted(seen):
        sight = seen[key]
        laneset = sorted({s[0] for s in sight})
        if len(laneset) < min_lanes:
            continue
        ent = issues_st.get(key, {})
        first = min(s[2] for s in sight)
        last = max(s[2] for s in sight)
        repeats.append({"test": key, "lanes": laneset,
                        "os": sorted({s[1] for s in sight}),
                        "first_seen": first, "last_seen": last,
                        "issue": ent.get("issue"), "issue_state": ent.get("issue_state")})
        closed = ent.get("closed_at")
        if ent.get("issue") and (closed or ent.get("fix_commit")):
            if ent.get("fix_commit"):
                after = sorted({s[0] for s in sight})
            else:
                after = sorted({s[0] for s in sight if s[2] > closed})
            if recurred_after(after):
                recurred.append({"test": key, "issue": ent["issue"],
                                 "closed_at": closed, "lanes": after, "last_seen": last})
    # recurrences for keys under min_lanes still count
    for key in sorted(seen):
        if any(r["test"] == key for r in recurred) or any(r["test"] == key for r in repeats):
            continue
        ent = issues_st.get(key, {})
        closed = ent.get("closed_at")
        if ent.get("issue") and (closed or ent.get("fix_commit")):
            if ent.get("fix_commit"):
                after = sorted({s[0] for s in seen[key]})
            else:
                after = sorted({s[0] for s in seen[key] if s[2] > closed})
            if recurred_after(after):
                recurred.append({"test": key, "issue": ent["issue"], "closed_at": closed,
                                 "lanes": after,
                                 "last_seen": max(s[2] for s in seen[key])})

    # open "Flaky test: <binary> <test>" issues filed by flake_report: one search per run, no cache
    flaky = []
    try:
        found = gh_paged("search/issues?q=repo:%s+is:issue+is:open+in:title+\"Flaky+test:\""
                         "+updated:>=%s" % (repo, iso(cutoff)), "items")
    except Fatal as e:
        print("ci-friction: %s" % e, file=sys.stderr)
        ok = False
        found = []
    for it in found:
        title = it.get("title") or ""
        upd = parse_ts(it.get("updated_at") or "")
        if not title.startswith(FLAKY_PREFIX) or not upd or upd < cutoff:
            continue
        try:
            comments = gh_paged("repos/%s/issues/%s/comments" % (repo, it.get("number")), None)
        except Fatal as e:
            print("ci-friction: %s" % e, file=sys.stderr)
            ok = False
            comments = []
        sightings, runs = 0, []
        for c in comments:
            if not isinstance(c, dict) or (c.get("user") or {}).get("login") != "github-actions":
                continue
            if FLAKE_RETRY_PHRASE not in (c.get("body") or ""):
                continue
            created = parse_ts(c.get("created_at") or "")
            if not created or created < cutoff:
                continue
            sightings += 1
            m = RUN_URL.search(c.get("body") or "")
            if m:
                runs.append(m.group(0))
        flaky.append({"test": title[len(FLAKY_PREFIX):], "issue": it.get("number"),
                      "sightings": sightings, "runs": runs})
    flaky.sort(key=lambda f: f["test"])
    flaky_hot = [f for f in flaky if f["sightings"] >= 2]

    # blocked issues whose named blockers are all closed; nothing is cached or edited
    try:
        blocked = gh_paged("repos/%s/issues?state=open&labels=blocked" % repo, None)
    except Fatal as e:
        print("ci-friction: %s" % e, file=sys.stderr)
        ok = False
        blocked = []
    closed = {}  # (repo, n) -> closed?, one lookup per blocker per run
    stale = []
    for it in blocked:
        if not isinstance(it, dict) or it.get("pull_request"):
            continue
        refs = named_blockers(it.get("body") or "", repo)
        if not refs:
            continue
        names = []
        for display, target, n in refs:
            if (target.lower(), n) not in closed:
                try:
                    got = json.loads(gh_api("repos/%s/issues/%d" % (target, n)))
                    closed[(target.lower(), n)] = got.get("state") == "closed"
                except (Fatal, ValueError, AttributeError) as e:
                    print("ci-friction: %s (treated as open)" % e, file=sys.stderr)
                    closed[(target.lower(), n)] = False
            if not closed[(target.lower(), n)]:
                break
            names.append(display)
        else:
            stale.append({"issue": it.get("number"), "title": it.get("title"),
                          "blockers": names})

    design_out = [{"cause": c, "count": n, "lanes": sorted(ls)}
                  for c, (n, ls) in sorted(design.items(), key=lambda kv: (-kv[1][0], kv[0]))]

    # prune jobs older than --since, then write state
    for jid in [k for k, v in jobs_st.items()
                if not (isinstance(v, dict) and parse_ts(v.get("completed_at") or "")
                        and parse_ts(v["completed_at"]) >= cutoff)]:
        jobs_st.pop(jid, None)
    st.update({"jobs": jobs_st, "issues": issues_st, "branches": branches_st,
               "compares": compares, "key_version": KEY_VERSION})
    save_state(state_path, st)

    if not ok:
        return 2
    if want_json:
        print(json.dumps({"since": iso(cutoff), "repeats": repeats,
                          "recurred_after_close": recurred, "design": design_out,
                          "flaky": flaky, "stale_blocked": stale}))
        return 1 if (repeats or recurred or flaky_hot or stale) else 0
    if not repeats and not recurred and not flaky_hot and not stale:
        print("ci-friction %s: no repeats in the last %s" % (repo, since or "24h"))
        return 0
    for rp in repeats:
        iss = ("issue #%s %s" % (rp["issue"], rp["issue_state"]) if rp["issue"]
               else "no issue")
        print("repeat: %s lanes %s os %s %s" % (
            rp["test"], ",".join(rp["lanes"]), ",".join(rp["os"]), iss))
    for rc in recurred:
        if not any(r["test"] == rc["test"] for r in repeats):
            print("recurred: %s after #%s closed %s lanes %s" % (
                rc["test"], rc["issue"], rc["closed_at"], ",".join(rc["lanes"])))
    for f in flaky_hot:
        print("flaky: %s issue #%s sightings %s" % (f["test"], f["issue"], f["sightings"]))
        for u in f["runs"]:
            print("  run: %s" % u)
    for s_ in stale:
        print("stale-blocked: issue #%s, blockers %s all closed"
              % (s_["issue"], ", ".join(s_["blockers"])))
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Fatal as e:
        print("ci-friction: %s" % e, file=sys.stderr)
        sys.exit(2)
