#!/usr/bin/env bash
# gh-ci: quiet, low-call GitHub CI helpers for agent flywheels.
# Usage: gh-ci snapshot <pr> | failures <run> | failures --pr <n> | watch-verified <run> --pr <n>
#        gh-ci verdict <branch-or-sha> | gh-ci resample <pr> "<job name>" --until <regex> [--max <n>]
#        gh-ci wait <pr> [--timeout <s>] [--fail-fast] [--no-jobs-after <min>] [--job <name> | --run <id>] | panics [<tail-lines>] (reads log from stdin)
# verdict judges required checks against the default branch; wait <pr> reads the PR's own base.
# Exit codes: 0 ok, 1 failure (verdict prints RED on stdout; lookup errors
# print no verdict), 2 usage, 3 merge conflict (snapshot and watch-verified
# at once; wait after 30 s of DIRTY re-checks), 4 wait: a required name had no
# check run on the head after --no-jobs-after; 124: verdict means a required
# check is pending now (no wait); wait means the wait timed out with checks still pending.
# A wait with --job exits 5 when the named job was skipped: it is no answer.
# --no-jobs-after <min> (default off; 0 or unset GH_CI_NO_JOBS_AFTER): a required
# name with no check run after a positive bound exits 4. A job behind needs: may
# not get a check run until upstream jobs finish; raise the bound for such
# workflows. A required path-filtered check that never runs also exits 4 after
# the bound.
# Repo: --repo OWNER/NAME (any subcommand, any position; panics needs none), then GH_CI_REPO, then
# origin's GitHub URL (no network call), then `gh repo view`. With none, exit 2.
# GH_CI_INTERVAL the watch poll seconds (default 30). Under Claude Code
# (CLAUDECODE set, any non-empty value), wait ignores --timeout below 600 and uses 7200.
set -euo pipefail
usage() {
  echo "usage: gh-ci snapshot <pr> | failures <run> | failures --pr <n> | watch-verified <run> --pr <n>" >&2
  echo "       gh-ci verdict <branch-or-sha> | resample <pr> \"<job name>\" --until <regex> [--max <n>]" >&2
  echo "       gh-ci wait <pr> [--timeout <s>] [--fail-fast] [--no-jobs-after <min>] [--job <name> | --run <id>] | panics [<tail-lines>] (reads log from stdin)" >&2
  echo "       --no-jobs-after is off by default (GH_CI_NO_JOBS_AFTER); exit 4 needs an explicit bound" >&2
  echo "       wait --job exits 5 when the named job was skipped (no answer)" >&2
  echo "       every GitHub subcommand takes --repo OWNER/NAME (overrides GH_CI_REPO and the checkout's origin)" >&2
  echo "       verdict judges required checks against the default branch; wait <pr> reads the PR's own base" >&2
  echo "       124 from verdict means a required check is pending now (nothing waited); from wait it means the wait timed out with checks still pending" >&2
  exit 2
}

CONFLICT_RC=3
NO_START_RC=4
SKIPPED_JOB_RC=5

# head_state <pr>: prints "<full head SHA> <merge state>", the merge state in
# the upper case of the GraphQL mergeStateStatus (REST mergeable_state, upper-cased).
# Fails when the head is unreadable: returns 4 when gh's error is a 404 (the PR
# is not in this repo), else 1.
head_state() {
  local sha="" state="" out="" err="" rc=0 errf
  errf="$(mktemp)"
  out=$(gh api "repos/$REPO/pulls/$1" --jq '"\(.head.sha) \(.mergeable_state // "unknown" | ascii_upcase)"' 2>"$errf") || rc=$?
  err=$(cat "$errf"); rm -f "$errf"
  if [ "$rc" -ne 0 ] && grep -qE 'HTTP 404|Not Found' <<<"$err"; then
    echo "PR $1 not found in $REPO" >&2
    return 4
  fi
  read -r sha state <<<"$out" || true
  if [[ "$sha" =~ ^[0-9a-fA-F]{40}$ ]]; then
    echo "$sha ${state:-}"
  else
    [ -z "$err" ] || printf '%s\n' "$err" >&2
    echo "could not read the head of PR $1" >&2
    return 1
  fi
}

conflict_msg() { echo "PR $1 has merge conflicts: GitHub runs no CI on it. Update the branch from origin/main first (merge or rebase, as the workflow doc says)." >&2; }

# pr_head <pr>: prints the full head SHA. Returns 3 on a conflicting (DIRTY)
# PR, because GitHub never runs CI on one and a watch would wait forever.
pr_head() {
  local sha state
  read -r sha state < <(head_state "$1") || return 1
  if [ "$state" = "DIRTY" ]; then
    conflict_msg "$1"
    return "$CONFLICT_RC"
  fi
  echo "$sha"
}

# snapshot <pr>: head SHA + CI/flake verdicts + pending/failing counts.
# Two API calls total: one pr view, one pr checks; a third pr view for
# mergeable and mergeStateStatus happens only with no checks on the head.
cmd_snapshot() {
  local pr="${1:?missing pr number}"
  local out head ci flake pending fails merge_json merge_pair mergeable mstate
  head=$(pr_head "$pr")
  echo "head: ${head:0:8}"
  out=$(gh pr checks "$pr" --repo "$REPO" 2>&1 || true)
  ci=$(echo "$out" | awk -F'\t' 'tolower($1) == "ci" {print $2; exit}')
  flake=$(echo "$out" | awk -F'\t' '$1 ~ /^Flake watch/ {print $2; exit}')
  echo "CI: ${ci:-unknown}"
  echo "Flake: ${flake:-unknown}"
  pending=$(echo "$out" | awk -F'\t' '$2 == "pending" || $2 == "queued" {n++} END {print n+0}')
  fails=$(echo "$out" | awk -F'\t' '$2 == "fail" {n++} END {print n+0}')
  echo "pending: $pending failing: $fails"
  # no checks means gh reports "no checks reported": any other failure
  # (auth, network) has no tab either but prints no merge line
  if grep -q $'\t' <<<"$out"; then
    return 0
  fi
  if ! grep -q 'no checks reported' <<<"$out"; then
    return 0
  fi
  merge_json=""
  merge_json=$(gh pr view "$pr" --repo "$REPO" --json mergeable,mergeStateStatus 2>/dev/null) || merge_json=""
  merge_pair=""
  if [ -n "$merge_json" ]; then
    merge_pair=$(printf '%s' "$merge_json" | jq -r '"\(.mergeable // "") \(.mergeStateStatus // "")"' 2>/dev/null) || merge_pair=""
  fi
  read -r mergeable mstate <<<"$merge_pair" || true
  if [ -n "${mergeable:-}" ] && [ -n "${mstate:-}" ]; then
    echo "merge: mergeable=$mergeable state=$mstate; no checks on this head; a conflicting PR gets none: check mergeable or rebase"
  else
    echo "merge: unknown; no checks on this head; a conflicting PR gets none: check mergeable or rebase"
  fi
}

# superseded_note: after a --pr digest, one line naming the failed or
# cancelled runs --pr skipped as superseded, if it skipped any.
superseded_note() {
  [ -n "$1" ] || return 0
  local n
  n=$(wc -w <<<"$1" | tr -d ' ')
  echo "skipped $n superseded runs: $1"
}

# panics [<tail-lines>]: print panic excerpts from stdin unless already in its tail.
# Each excerpt contains the panic line and its next three lines.
cmd_panics() {
  [ "$#" -le 1 ] || usage
  local tail_lines="${1:-${GH_CI_LOG_LINES:-60}}"
  case "$tail_lines" in ''|*[!0-9]*) usage;; esac
  awk -v tail_lines="$tail_lines" '
    { full[++n] = $0 }
    END {
      tail_start = n - tail_lines + 1
      if (tail_start < 1) tail_start = 1
      for (i = 1; i <= n; i++) {
        if (!index(full[i], "panicked at")) continue
        count = n - i + 1
        if (count > 4) count = 4
        if (i < tail_start) {
          if (!printed++) printf "panic context (outside the last %d lines):\n", tail_lines
          for (j = 0; j < count; j++) print full[i + j]
        }
      }
    }'
}

# workflow_bounds: stdin is a workflow file; stdout is one
# "job-id\tname\ttimeout-minutes" line per job (timeout-minutes defaults to
# GitHub's 360 when the job sets none; a job whose timeout-minutes: value is
# anything other than an integer literal has an unknown bound, printed as an
# empty field). Reads only the jobs: mapping's two-space ids with their
# four-space timeout-minutes: and name: lines.
workflow_bounds() {
  awk '
    /^jobs:[[:space:]]*(#.*)?$/ { in_jobs = 1; job = ""; next }
    /^[^[:space:]#]/ { in_jobs = 0 }
    in_jobs && /^  [A-Za-z0-9_.\/-]+:[[:space:]]*(#.*)?$/ {
      job = $0; sub(/^  /, "", job); sub(/:[[:space:]]*(#.*)?$/, "", job)
      mins[job] = 360; nm[job] = job; next
    }
    in_jobs && job != "" && /^    timeout-minutes:/ {
      v = $0; sub(/^    timeout-minutes:[[:space:]]*/, "", v); sub(/[[:space:]#].*$/, "", v)
      if (v ~ /^[0-9]+$/) mins[job] = v + 0; else mins[job] = ""; next
    }
    in_jobs && job != "" && /^    name:[[:space:]]*[^[:space:]]/ {
      v = $0; sub(/^    name:[[:space:]]*/, "", v); sub(/[[:space:]]+$/, "", v)
      sub(/^'"'"'/, "", v); sub(/'"'"'$/, "", v); sub(/^"/, "", v); sub(/"$/, "", v)
      gsub(/\t/, " ", v); nm[job] = v; next
    }
    END { for (j in mins) printf "%s\t%s\t%s\n", j, nm[j], mins[j] }
  '
}

# run_bounds <run>: the run's workflow file at its head SHA as a
# workflow_bounds table. Fails when the run, the file, or the parse fails.
run_bounds() {
  local run="$1" info head_sha path raw
  info=$(gh api "repos/$REPO/actions/runs/$run" --jq '"\(.head_sha) \(.path)"' 2>/dev/null) || return 1
  read -r head_sha path <<<"$info"
  [ -n "${head_sha:-}" ] && [ -n "${path:-}" ] || return 1
  raw=$(gh api -H "Accept: application/vnd.github.raw" "repos/$REPO/contents/$path?ref=$head_sha" 2>/dev/null) || return 1
  [ -n "$raw" ] || return 1
  printf '%s' "$raw" | workflow_bounds
}

# job_bound <bounds-table> <display-name>: print the job's timeout-minutes.
# An exact match on the job id or the literal name: wins. Otherwise every
# name: template with each ${{ ... }} expression as a wildcard is collected
# (a matrix name such as "Tests (${{ matrix.os }})" matches
# "Tests (ubuntu-24.04)"): the bound prints when exactly one job matches, or
# when all matches share one known bound. Fails when nothing matches, when
# the matches disagree, or when any match has an unknown bound.
job_bound() {
  local table="$1" jname="$2" id template minutes glob tab
  local matched=0 bound="" disagree=0
  tab=$(printf '\t')
  while IFS="$tab" read -r id template minutes || [ -n "${id:-}" ]; do
    [ -n "${id:-}" ] || continue
    if [ "$jname" = "$id" ] || [ "$jname" = "$template" ]; then
      case "$minutes" in ''|*[!0-9]*) return 1;; esac
      printf '%s\n' "$minutes"; return 0
    fi
  done <<<"$table"
  while IFS="$tab" read -r id template minutes || [ -n "${id:-}" ]; do
    [ -n "${id:-}" ] || continue
    case "$template" in
      *'${{'*)
        glob=$(printf '%s' "$template" | sed 's/\${{[^}]*}}/*/g')
        case "$jname" in
          $glob)
            case "$minutes" in ''|*[!0-9]*) return 1;; esac
            if [ "$matched" -eq 0 ]; then bound="$minutes"
            elif [ "$minutes" != "$bound" ]; then disagree=1; fi
            matched=$((matched + 1));;
        esac;;
    esac
  done <<<"$table"
  [ "$matched" -gt 0 ] && [ "$disagree" -eq 0 ] || return 1
  printf '%s\n' "$bound"
}

# cancel_suffix <bounds-table> <job-name> <startedAt> <completedAt>: print the
# cancelled-job detail: " (elapsed M:SS, timeout-minutes N: TIMEOUT)" when the
# elapsed time reaches the bound (the same elapsed-within-grace rule
# ci-friction uses), " (elapsed M:SS, timeout-minutes N: CANCELLED
# (external))" when it does not, and " (elapsed M:SS)" when no bound matches.
# Fails when the elapsed time is unreadable.
cancel_suffix() {
  local table="$1" jname="$2" started="$3" completed="$4"
  local elapsed_s elapsed bound label
  [ -n "$started" ] && [ -n "$completed" ] || return 1
  elapsed_s=$(jq -n --arg s "$started" --arg e "$completed" '
    def norm: sub("\\.[0-9]+(Z|[+-][0-9:]+)$"; "\\1");
    try ((($e | norm) | fromdateiso8601) - (($s | norm) | fromdateiso8601)) catch empty') || return 1
  case "$elapsed_s" in ''|-*) return 1;; esac
  elapsed_s=${elapsed_s%%.*}
  case "$elapsed_s" in ''|-*) return 1;; esac
  elapsed=$(printf '%d:%02d' $((elapsed_s / 60)) $((elapsed_s % 60)))
  if [ -n "$table" ] && bound=$(job_bound "$table" "$jname"); then
    if [ "$elapsed_s" -ge "$((bound * 60 - 30))" ]; then label="TIMEOUT"; else label="CANCELLED (external)"; fi
    printf ' (elapsed %s, timeout-minutes %s: %s)' "$elapsed" "$bound" "$label"
  else
    printf ' (elapsed %s)' "$elapsed"
  fi
}

# print_failing <checks_json>: one "failing: <name>" line per failed or
# cancelled check. A cancelled check from an Actions run gains its elapsed
# time beside its timeout-minutes; where the lookup fails it prints the
# elapsed time only, and with no timestamps the plain name.
print_failing() {
  local checks="$1" lines tab jname bucket run table jobs_json line started completed suffix
  tab=$(printf '\t')
  lines=$(printf '%s' "$checks" | jq -r '.[] | select(.bucket == "fail" or .bucket == "cancel") | "\(.name | gsub("[\r\n]"; " "))\t\(.bucket)\t\(.run // "")"' 2>/dev/null) || lines=""
  while IFS="$tab" read -r jname bucket run || [ -n "${jname:-}" ]; do
    [ -n "${jname:-}" ] || continue
    suffix=""
    if [ "$bucket" = "cancel" ] && [ -n "$run" ]; then
      table=$(run_bounds "$run" 2>/dev/null) || table=""
      jobs_json=$(gh run view "$run" --repo "$REPO" --json jobs 2>/dev/null) || jobs_json=""
      if [ -n "$jobs_json" ]; then
        line=$(printf '%s' "$jobs_json" | jq -r --arg name "$jname" '.jobs[]? | select(.name == $name and .conclusion == "cancelled") | "\(.startedAt // .started_at // "")\t\(.completedAt // .completed_at // "")"' 2>/dev/null | head -n 1)
        if [ -n "$line" ]; then
          started="${line%%"$tab"*}"; completed="${line#*"$tab"}"
          suffix=$(cancel_suffix "$table" "$jname" "$started" "$completed") || suffix=""
        fi
      fi
    fi
    printf 'failing: %s%s\n' "$jname" "$suffix"
  done <<<"$lines"
}

# failures <run> | failures --pr <n>: cleaned digest of the failed and
# cancelled jobs. With --pr, every failure/cancelled/in-progress run on the PR head, ignoring superseded runs
# (named on one line at the end); with <run>, that run only. A cancelled job prints one line and no log:
# its elapsed time beside its timeout-minutes, labelled TIMEOUT when the
# elapsed time reaches the bound, else CANCELLED (external);
# a failed job prints its cleaned log digest. In-progress runs report failures
# so far and exit 1; completed runs are reports and exit 0.
# red_commit_hint <run id> <job name>: a failed "red commit" job reruns from
# the cached selection under --failed, so when the run's ticket has lost its
# bug label, say a whole-run rerun is needed. Any failed lookup prints nothing.
red_commit_hint() {
  local run="$1" jname="$2" lower ticket labels
  lower=$(printf '%s' "$jname" | tr '[:upper:]' '[:lower:]')
  case "$lower" in *"red commit"*) ;; *) return 0;; esac
  ticket=$(gh run view "$run" --repo "$REPO" --log 2>/dev/null \
    | sed -nE 's/.*ticket: ([0-9]+); bug: true.*/\1/p') || return 0
  ticket="${ticket%%$'\n'*}" # first match; sed reads the whole log, so gh never sees SIGPIPE under pipefail
  [ -n "$ticket" ] || return 0
  labels=$(gh issue view "$ticket" --repo "$REPO" --json labels -q '.labels[].name' 2>/dev/null) || return 0
  case "$(printf '\n%s\n' "$labels")" in *$'\nbug\n'*) return 0;; esac
  echo "ticket #$ticket no longer has the bug label: rerun the whole run (gh run rerun $run, not --failed) or push"
}

cmd_failures() {
  local log_lines="${GH_CI_LOG_LINES:-60}"
  case "$log_lines" in ''|*[!0-9]*) usage;; esac
  local esc tab
  esc=$(printf '\033')
  tab=$(printf '\t')
  local runs_list="" label="" head="" short="" pr="" superseded=""
  if [ "${1:-}" = "--pr" ]; then
    [ $# -eq 2 ] || usage
    case "${2:-}" in ''|*[!0-9]*) usage;; esac
    pr="$2"
    head=$(pr_head "$pr") || return 1
    short="${head:0:8}"
    local runs_json runs
    runs_json=$(gh run list --repo "$REPO" --commit "$head" --limit 100 --json databaseId,name,event,conclusion,workflowName,status) \
      || { echo "could not list runs for PR $pr head $short" >&2; return 1; }
    runs=$(printf '%s' "$runs_json" | jq -r '([.[] | {k: "\(.workflowName // .name // "")\u001f\(.event // "")", id: .databaseId}] | group_by(.k) | map(max_by(.id).id)) as $newest | .[] | select((.status != null and .status != "completed") or .conclusion=="failure" or .conclusion=="cancelled") | select(.databaseId as $id | $newest | index($id)) | "\(.databaseId)\t\(.name)"') \
      || { echo "could not parse runs for PR $pr head $short" >&2; return 1; }
    superseded=$(printf '%s' "$runs_json" | jq -r '([.[] | {k: "\(.workflowName // .name // "")\u001f\(.event // "")", id: .databaseId}] | group_by(.k) | map(max_by(.id).id)) as $newest | [.[] | select(.conclusion=="failure" or .conclusion=="cancelled") | .databaseId | select(. as $id | $newest | index($id) | not)] | sort | join(" ")') \
      || { echo "could not parse runs for PR $pr head $short" >&2; return 1; }
    if [ -z "$runs" ]; then echo "no failed jobs on $short"; superseded_note "$superseded"; return 0; fi
    runs_list="$runs"
    label="on $short"
  else
    [ $# -eq 1 ] || usage
    case "${1:-}" in ''|*[!0-9]*) usage;; esac
    local run="$1" run_name
    run_name=$(gh run view "$run" --repo "$REPO" --json name --jq .name 2>/dev/null) || run_name="$run"
    runs_list=$(printf '%s\t%s' "$run" "$run_name")
    label="in run $run"
  fi
  local found=0 still_running=0 run_id run_name jobs_json jobs
  while IFS="$tab" read -r run_id run_name || [ -n "${run_id:-}" ]; do
    [ -n "${run_id:-}" ] || continue
    case "$run_name" in ''|null) run_name="$run_id";; esac
    local run_json run_status failures_so_far
    run_json=$(gh run view "$run_id" --repo "$REPO" --json status 2>/dev/null) \
      || { echo "could not read status for run $run_id" >&2; return 1; }
    run_status=$(printf '%s' "$run_json" | jq -r '.status // ""' 2>/dev/null) \
      || { echo "could not parse status for run $run_id" >&2; return 1; }
    [ -n "$run_status" ] || { echo "could not read status for run $run_id" >&2; return 1; }
    if [ "$run_status" != "completed" ]; then
      jobs_json=$(gh run view "$run_id" --repo "$REPO" --json jobs) \
        || { echo "could not read jobs for run $run_id" >&2; return 1; }
      failures_so_far=$(printf '%s' "$jobs_json" | jq -r '[.jobs[]? | select(.conclusion=="failure" or .conclusion=="cancelled")] | length') \
        || { echo "could not parse jobs for run $run_id" >&2; return 1; }
      printf 'run %s still in progress; failures so far: %s\n' "$run_id" "$failures_so_far"
      found=1
      still_running=1
      continue
    fi
    jobs_json=$(gh run view "$run_id" --repo "$REPO" --json jobs) \
      || { echo "could not read jobs for run $run_id" >&2
           [ -n "$pr" ] || echo "if $run_id is a PR number, use: gh-ci failures --pr $run_id" >&2
           return 1; }
    jobs=$(printf '%s' "$jobs_json" | jq -r '.jobs[] | select(.conclusion=="failure" or .conclusion=="cancelled") | "\(.conclusion)\t\(.databaseId)\t\(.name)\t\(.startedAt // .started_at // "")\t\(.completedAt // .completed_at // "")"') \
      || { echo "could not parse jobs for run $run_id" >&2; return 1; }
    [ -n "$jobs" ] || continue
    local concl jid jname started completed table suffix
    table=""
    if grep -q "^cancelled$tab" <<<"$jobs"; then table=$(run_bounds "$run_id" 2>/dev/null) || table=""; fi
    while IFS="$tab" read -r concl jid jname started completed || [ -n "${concl:-}" ]; do
      [ -n "${concl:-}" ] || continue
      case "$concl" in
        cancelled)
          suffix=$(cancel_suffix "$table" "$jname" "$started" "$completed") || suffix=""
          printf '=== %s / %s: cancelled%s\n' "$run_name" "$jname" "$suffix"
          found=1;;
        failure)
          printf '=== %s / %s (%s): failure\n' "$run_name" "$jname" "$jid"
          found=1
          local failed_log
          failed_log="$(mktemp "${TMPDIR:-/tmp}/gh-ci-failed-log.XXXXXX")"
          gh run view "$run_id" --repo "$REPO" --job "$jid" --log-failed 2>&1 \
            | sed "s/^[^${tab}]*${tab}[^${tab}]*${tab}//" \
            | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^[:space:]]*[[:space:]]+//' \
            | sed -E "s/(${esc}\[|\^\[\[)[0-9;]*[A-Za-z]//g" \
            | sed '/^[[:space:]]*$/d' >"$failed_log" || true
          tail -n "$log_lines" "$failed_log" || true
          cmd_panics "$log_lines" <"$failed_log"
          # budget rows: the bench-report:/release-size: lines ci-friction
          # names bench-budget/size-budget, one row per failing line
          awk '/^bench-report:/ || (/^release-size:/ && /(over|exceed)/) {
            orig = $0
            line = $0
            sub(/^(bench-report|release-size): */, "", line)
            row = ""; val = ""; ceil = ""
            rest = line
            while (match(rest, /over [0-9][0-9.,]* [^ ]*/)) {
              ceil = substr(rest, RSTART + 5, RLENGTH - 5)
              rest = substr(rest, RSTART + RLENGTH)
            }
            tmp = line
            if (match(tmp, /median [0-9][0-9.,]* [^ ]* of [^ ]*/)) {
              m = substr(tmp, RSTART, RLENGTH)
              sub(/^median /, "", m)
              i = index(m, " of ")
              val = substr(m, 1, i - 1); row = substr(m, i + 4)
            } else if (match(tmp, /median [0-9][0-9.,]* [^ ]*/)) {
              m = substr(tmp, RSTART, RLENGTH)
              val = substr(m, 8)
              row = substr(tmp, 1, RSTART - 1)
            } else if (match(tmp, /[0-9][0-9.,]* [^ ]* over /)) {
              m = substr(tmp, RSTART, RLENGTH)
              val = substr(m, 1, length(m) - 6)
              row = substr(tmp, 1, RSTART - 1)
            }
            gsub(/[ :,;]+$/, "", row)
            if (row != "" && val != "" && ceil != "") printf "budget: %s %s > %s\n", row, val, ceil
            else printf "budget: %s\n", orig
          }' "$failed_log"
          rm -f "$failed_log"
          red_commit_hint "$run_id" "$jname";;
      esac
    done <<<"$jobs"
  done <<<"$runs_list"
  if [ "$found" -eq 0 ]; then echo "no failed jobs $label"; fi
  superseded_note "$superseded"
  return "$still_running"
}

# watch-verified <run> --pr <n>: watch, then verify via pr checks.
# Exit 0 only when CI passes with zero pending on the PR head. A watch
# firing means "look", never "it's green" — this is the look.
cmd_watch_verified() {
  local run="${1:?missing run id}"; shift
  local pr=""
  while [ $# -gt 0 ]; do case "$1" in --pr) pr="${2:?}"; shift 2;; *) usage;; esac; done
  [ -n "$pr" ] || usage
  local head run_sha
  head=$(pr_head "$pr")
  run_sha=$(gh run view "$run" --repo "$REPO" --json headSha --jq .headSha)
  if [ "$run_sha" != "$head" ]; then
    echo "run $run is on ${run_sha:0:8}, PR head is ${head:0:8}: stale run" >&2
    return 1
  fi
  # gh run watch polls every 3s by default; several concurrent watchers
  # trip GitHub's secondary rate limit on the Actions API.
  gh run watch "$run" --repo "$REPO" --exit-status --interval "${GH_CI_INTERVAL:-30}" >/dev/null || true
  local out ci pending
  out=$(gh pr checks "$pr" --repo "$REPO" 2>&1 || true)
  ci=$(echo "$out" | awk -F'\t' 'tolower($1) == "ci" {print $2; exit}')
  pending=$(echo "$out" | awk -F'\t' '$2 == "pending" || $2 == "queued" {n++} END {print n+0}')
  echo "head: ${head:0:8} CI: ${ci:-unknown} pending: $pending"
  echo "$out" | grep -E "fail" | head -5 || true
  [ "$ci" = "pass" ] && [ "$pending" = "0" ]
}

# resample <pr> "<job name>" --until <regex> [--max <n>]: rerun the PR's latest
# run until the named job's log matches the regex (a flake caught in a net).
# Logs land in $GH_CI_OUT (default /tmp/gh-ci-resample-<pr>). Waits on the
# whole run, because a rerun is refused while any job is still in progress,
# and fetches the job log through the API, because `gh run view --log`
# refuses while the run is in progress.
cmd_resample() {
  local pr="${1:?missing pr number}"; local job="${2:?missing job name}"; shift 2
  local until_re="" max=12
  while [ $# -gt 0 ]; do case "$1" in
    --until) until_re="${2:?}"; shift 2;;
    --max) max="${2:?}"; shift 2;;
    *) usage;; esac; done
  [ -n "$until_re" ] || usage
  local out="${GH_CI_OUT:-/tmp/gh-ci-resample-$pr}"; mkdir -p "$out"
  local branch run
  branch=$(gh pr view "$pr" --repo "$REPO" --json headRefName --jq .headRefName)
  run=$(gh run list --repo "$REPO" --branch "$branch" --workflow ci.yml --limit 1 --json databaseId --jq '.[0].databaseId')
  [ -n "$run" ] || { echo "no run on $branch (unmergeable PRs get none)" >&2; return 1; }
  echo "run: $run"
  local attempt jid concl log
  for attempt in $(seq 1 "$max"); do
    while [ "$(gh run view "$run" --repo "$REPO" --json status --jq .status)" != "completed" ]; do
      sleep "${GH_CI_INTERVAL:-60}"
    done
    jid=$(gh run view "$run" --repo "$REPO" --json jobs --jq ".jobs[] | select(.name==\"$job\") | .databaseId" | tail -1)
    concl=$(gh run view "$run" --repo "$REPO" --json jobs --jq ".jobs[] | select(.name==\"$job\") | .conclusion" | tail -1)
    log="$out/attempt-$attempt.log"
    gh api --allow-escape-sequences "repos/$REPO/actions/jobs/$jid/logs" > "$log" 2>&1 || true
    echo "attempt: $attempt job: $jid conclusion: ${concl:-unknown} log: $log"
    if grep -aqE "$until_re" "$log"; then echo "caught: $log"; return 0; fi
    gh run rerun "$run" --repo "$REPO" >/dev/null
    sleep 90
  done
  echo "no match in $max attempts"; return 1
}

# required_names_for_base <base>: the required check names from rulesets and
# classic protection (a classic 404 means none), one per line.
required_names_for_base() {
  local base="$1" rules classic
  rules=$(gh api "repos/$REPO/rules/branches/$base" \
    --jq '.[] | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context') || return 1
  if ! classic=$(gh api "repos/$REPO/branches/$base/protection/required_status_checks" --jq '.contexts[]?' 2>&1); then
    case "$classic" in *"HTTP 404"*) classic="" ;; *) return 1 ;; esac
  fi
  printf '%s\n' "$rules" "$classic" | grep -v '^$' | sort -u || true
}

# required_names <pr>: the required check names on the PR's base branch.
required_names() {
  local base
  base=$(gh api "repos/$REPO/pulls/$1" --jq .base.ref) && [ -n "$base" ] || return 1
  required_names_for_base "$base"
}

# head_checks <sha>: the head's check runs as {name, bucket, run}, over REST: the
# latest attempt of each check (filter=latest, so a rerun replaces its failed
# first attempt), and the head's workflow runs for the workflow, event,
# status and attempt of each check's run ID. The authoritative run of a head's
# (workflow, event) group is the newest run by ID, whatever its status: its
# checks count, and every older run's checks in the group are ignored (a
# draft run marked ready starts a newer attempt-1 run on the same SHA, and
# that newer run replaces it, even before it has checks of its own). Prints
# {checks, dropped}: dropped lists the superseded run IDs, which the caller
# reports on stderr once per wait (report_dropped). Checks without an Actions run ID are kept with run null. A check whose run
# is a rerun (attempt greater than 1) that has not completed counts as pending,
# so a rerun's old failure never settles the wait; a rerun keeps the run ID of
# the run it re-runs, so it stays authoritative.
# run counts as an Actions job only for a github-actions check whose run ID is
# one of the head's own workflow runs; anything else is kept with run null, so
# the --job caller never trusts the URL alone. The failing printers read run to
# annotate a cancelled check with its elapsed time beside its
# timeout-minutes. Fails when a call fails.
head_checks() {
  local sha="$1" runs payload
  runs=$(gh api --paginate "repos/$REPO/actions/runs?head_sha=$sha&per_page=100" \
    | jq -cs '[.[].workflow_runs[]? | {key: (.id | tostring), value: {workflow: (.name // ""), event: (.event // ""), status: (.status // "completed"), attempt: (.run_attempt // 1)}}] | from_entries') || return 1
  payload=$(gh api --paginate "repos/$REPO/commits/$sha/check-runs?per_page=100&filter=latest" \
    | jq -cs --argjson runs "$runs" '
      [.[].check_runs[]? | (.details_url // .html_url // "") as $link
        | {name: .name,
           bucket: (if .status != "completed" then "pending"
                    elif .conclusion == "success" or .conclusion == "neutral" then "pass"
                    elif .conclusion == "skipped" or .conclusion == "stale" then "skipping"
                    elif .conclusion == "cancelled" then "cancel"
                    elif .conclusion == null then "pending"
                    else "fail" end),
           run: (first($link | capture("/actions/runs/(?<r>[0-9]+)/") | .r | tonumber) // null),
           app_slug: (.app.slug // "")}
        | . + {key: (if .run == null then null else "\($runs[(.run | tostring)].workflow // "")\u001f\($runs[(.run | tostring)].event // "")" end)}
      ] as $recs
      | ([$recs[] | select(.run != null) | {k: .key, r: .run}]
          + [$runs | to_entries[] | {k: "\(.value.workflow)\u001f\(.value.event)", r: (.key | tonumber)}]
         | group_by(.k) | map({key: .[0].k, value: (map(.r) | max)}) | from_entries) as $auth
      | ([$recs[] | select(.run != null and .run != $auth[.key]) | .run] | unique) as $dropped
      | {checks: [$recs[] | select(.run == null or .run == $auth[.key])
          | .run as $r | .app_slug as $a
          | {name: .name, bucket: (if (($runs[(.run | tostring)].status // "completed") != "completed"
                                       and ($runs[(.run | tostring)].attempt // 1) > 1)
                                      then "pending" else .bucket end),
             run: (if $r == null then null
                   elif $a != "github-actions" then null
                   elif ($runs | has(($r | tostring))) then $r
                   else null end)}],
         dropped: $dropped}' ) || return 1
  printf '%s' "$payload"
}

# report_dropped <head_checks payload>: print one stderr line for each superseded
# run not yet in $reported (a space-delimited list the caller declares local, with
# " " to start), and add it. The caller decides how long a list lasts: a wait
# keeps it for the whole wait, so each run is named once.
report_dropped() {
  local id
  while IFS= read -r id || [ -n "$id" ]; do
    [ -n "$id" ] || continue
    case " $reported " in *" $id "*) continue;; esac
    reported="$reported$id "
    echo "gh-ci: ignoring run $id: a newer run on this head supersedes it" >&2
  done < <(printf '%s' "$1" | jq -r '.dropped[]?' 2>/dev/null)
}

# jobless_runs <sha>: print head workflow run IDs with no jobs. Only the first
# 100 runs are checked; list or jobs API failures and missing total_count name
# nothing. This helper runs only when a required check reaches the no-start bound.
jobless_runs() {
  local sha="$1" runs_json run_ids run_id jobs_json
  runs_json=$(gh api "repos/$REPO/actions/runs?head_sha=$sha&per_page=100" 2>/dev/null) || return 0
  run_ids=$(printf '%s' "$runs_json" | jq -r '.workflow_runs[]?.id | select(type == "number" or type == "string")' 2>/dev/null) || return 0
  while IFS= read -r run_id || [ -n "$run_id" ]; do
    [ -n "$run_id" ] || continue
    jobs_json=$(gh api "repos/$REPO/actions/runs/$run_id/jobs?per_page=1" 2>/dev/null) || continue
    if jq -e 'type == "object" and .total_count == 0' <<<"$jobs_json" >/dev/null 2>&1; then
      printf '%s\n' "$run_id"
    fi
  done <<<"$run_ids"
  return 0
}

# verdict <branch-or-sha>: judge this commit's checks against the default
# branch's required names. Failed checks are tagged REQUIRED or NON-BLOCKING.
cmd_verdict() {
  [ "$#" -eq 1 ] || usage
  local ref="$1" sha="" err="" errf base names req checks judged payload rc=0 reported=" "
  case "$ref" in
    ''|-*|/*|*/|*..*|*\?*|*\#*|*\%*) usage;;
  esac
  [[ ! "$ref" =~ [[:space:]] ]] || usage

  errf="$(mktemp)"
  sha=$(gh api "repos/$REPO/commits/$ref" --jq .sha 2>"$errf") || rc=$?
  err=$(cat "$errf"); rm -f "$errf"
  if [ "$rc" -ne 0 ]; then
    case "$err" in
      *"HTTP 404"*|*"HTTP 422"*|*"Not Found"*|*"No commit found"*)
        echo "gh-ci: ref $ref not found in $REPO" >&2
        return 2;;
      *)
        [ -z "$err" ] || printf '%s\n' "$err" >&2
        echo "gh-ci: cannot resolve ref $ref in $REPO" >&2
        return 1;;
    esac
  fi
  if [[ ! "$sha" =~ ^[0-9a-fA-F]{40}$ ]]; then
    echo "gh-ci: cannot resolve ref $ref in $REPO to a commit SHA" >&2
    return 1
  fi

  base=$(gh api "repos/$REPO" --jq .default_branch) \
    || { echo "gh-ci: cannot read default branch for $REPO" >&2; return 1; }
  if [ -z "$base" ]; then
    echo "gh-ci: cannot read default branch for $REPO" >&2
    return 1
  fi
  if ! names=$(required_names_for_base "$base"); then
    echo "gh-ci: cannot read required checks for $base in $REPO" >&2
    return 1
  fi
  if ! req=$(printf '%s\n' "$names" | jq -Rsc 'split("\n") | map(select(. != ""))'); then
    echo "gh-ci: cannot parse required checks for $base in $REPO" >&2
    return 1
  fi
  if ! payload=$(head_checks "$sha"); then
    echo "gh-ci: cannot read checks for $sha in $REPO" >&2
    return 1
  fi
  report_dropped "$payload"
  checks=$(printf '%s' "$payload" | jq -c '.checks') || return 1
  if ! judged=$(jq -nr --argjson checks "$checks" --argjson req "$req" '
    {checks: $checks, req: $req}
    | .checks as $checks
    | .req as $required
    | if ($checks | type) != "array" or ($required | type) != "array" then
        error("checks and required names must be arrays")
      else
        ([$checks[]
          | select(.bucket == "fail" or .bucket == "cancel")
          | .name as $name
          | select(($required | index($name)) != null)
          | $name | gsub("[\\r\\n]"; " ")] | unique | sort) as $required_failures
        | ([$checks[]
          | select(.bucket == "fail" or .bucket == "cancel")
          | .name as $name
          | select(($required | index($name)) == null)
          | $name | gsub("[\\r\\n]"; " ")] | unique | sort) as $other_failures
        | any($required[];
            . as $name
            | ([$checks[] | select(.name == $name)] as $named
               | ($named | length) == 0
                 or any($named[]; .bucket != "pass" and .bucket != "skipping"
                                    and .bucket != "fail" and .bucket != "cancel"))) as $pending
        | (if ($required_failures | length) > 0 then "RED"
           elif $pending then "NOT YET"
           elif ($other_failures | length) > 0 then "NOT RED"
           else "GREEN" end) as $verdict
        | ([$verdict]
           + ($required_failures | map("REQUIRED: " + .))
           + ($other_failures | map("NON-BLOCKING: " + .)))[]
      end
  '); then
    echo "gh-ci: cannot judge checks for $sha in $REPO" >&2
    return 1
  fi
  [ "$checks" != "[]" ] || echo "gh-ci: no checks on $sha" >&2
  printf '%s\n' "$judged"
  case "${judged%%$'\n'*}" in
    RED) return 1 ;;
    "NOT YET") return 124 ;;
    *) return 0 ;;
  esac
}

# wait <pr> [--timeout <s>]: block until no required check on the PR's
# current head is pending. Exit 0 when all green, 1 on failing checks,
# 2 on usage, 3 on a merge conflict, 124 on timeout. The timeout counts
# seconds slept, not wall-clock time. A verdict is reported only for a
# head read both before and after its checks call. A conflict is reported
# only after the same head reads DIRTY for 30 s of 5 s polls (GitHub
# recomputes mergeability late after a push), or once the timeout budget
# is spent while DIRTY.
# An unreadable head (a failed API read) is pending: the wait sleeps and reads
# again, and times out with 124 if the head stays unreadable. A 404 on the head
# read is not pending: the PR number is wrong, so the wait returns 1 at once.
# On a draft PR (isDraft read once at the start), the base branch's
# required names are skipped and the checks call drops --required: the
# wait settles on the checks the head actually has, an empty list stays
# pending, and the pass line notes required checks run once ready.
# A required check on the head counts whenever it ran. A required name of
# the base branch with no check on the head counts as pending. When the
# required names were read and there are none, the verdict is pass without
# calling the checks API. Checks from any run older than the head's newest run of the same workflow and event are
# ignored, whatever that newest run's status; the newest-run map comes from every check on the head, read in the same call.
# --fail-fast: a failed or cancelled required check returns 1 at once, even while
# another required check is still pending (the failing lines are the same).
# --job <name>: wait on the newest run's job of exactly that name instead
# of the required set. The draft read and the required names are skipped;
# checks_json is the head's checks filtered to that exact name, so an empty
# list stays pending until the job appears and concludes. The verdict lines
# name the job: "head: <head8> job: <name> pass" or "head: <head8> job:
# <name> fail" plus the failing line. Combines with --fail-fast and --timeout.
# --run <id> [--pr <n>]: wait on ONE workflow run by id and return that run's
# own conclusion. With --pr, the run's headSha must equal the PR head, else
# a stale-run exit 1; without --pr there is no head lookup and no head check.
# Polls the run's status to completed with the same
# sleep/timeout accounting as the other waits (timeout exit 124). Prints
# "head: <head8> run: <id> pass" or "head: <head8> run: <id> fail" plus
# one "failing: <job>" line per failed job of that run, and per cancelled job
# with its elapsed time beside its timeout-minutes. --fail-fast is
# accepted but ignored (one run has nothing else to outrun). Combines with
# --timeout. Never reads required names, head checks, or the draft state.
# Progress: each poll that reads the checks prints one stderr line,
# "gh-ci: <head8> pending=<n> passed=<n> failing=<n>", when those counts differ
# from the last line printed (the first readable poll always prints). Passed
# counts passing and skipped required checks only, not every check on the head,
# and is not a merge gate (the exit code is); failing counts fail and cancel.
# Stdout is unchanged.
# wait_run <pr> <run> <timeout> <interval>: the --run path. With a non-empty
# <pr> verifies the run is on the PR head, then polls the run's status to
# completed. Prints
# "head: <head8> run: <id> pass" on success/skipped/neutral, else
# "head: <head8> run: <id> fail" plus one failing line per failed or
# cancelled job of that run. Without a PR prints "run: <id> pass" or
# "run: <id> fail" and "run <id> timeout after <n>s". Timeout exit 124
# with the usual header.
wait_run() {
  local pr="$1" run="$2" timeout="$3" interval="$4"
  local head="" run_sha slept=0 run_json status concl jobs_json jobs_lines
  local table jname jconcl started completed suffix tab
  tab=$(printf '\t')
  if [ -n "$pr" ]; then
    head=$(pr_head "$pr") || return $?
    run_sha=$(gh run view "$run" --repo "$REPO" --json headSha --jq .headSha) \
      || { echo "could not read run $run" >&2; return 1; }
    if [ "$run_sha" != "$head" ]; then
      echo "run $run is on ${run_sha:0:8}, PR head is ${head:0:8}: stale run" >&2
      return 1
    fi
  fi
  while true; do
    run_json=$(gh run view "$run" --repo "$REPO" --json status,conclusion 2>/dev/null) || run_json=""
    status=$(printf '%s' "$run_json" | jq -r '.status // ""' 2>/dev/null) || status=""
    concl=$(printf '%s' "$run_json" | jq -r '.conclusion // ""' 2>/dev/null) || concl=""
    if [ "$status" != "completed" ]; then
      if [ "$slept" -ge "$timeout" ]; then
        if [ -n "$head" ]; then
          echo "head: ${head:0:8} timeout after ${timeout}s"
        else
          echo "run $run timeout after ${timeout}s"
        fi
        return 124
      fi
      sleep "$interval"
      slept=$((slept + interval))
      continue
    fi
    case "$concl" in success|skipped|neutral)
      if [ -n "$head" ]; then
        echo "head: ${head:0:8} run: $run pass"
      else
        echo "run: $run pass"
      fi
      return 0;;
    esac
    if [ -n "$head" ]; then
      echo "head: ${head:0:8} run: $run fail"
    else
      echo "run: $run fail"
    fi
    jobs_json=$(gh run view "$run" --repo "$REPO" --json jobs 2>/dev/null) || jobs_json=""
    jobs_lines=$(printf '%s' "$jobs_json" | jq -r '.jobs[]? | select(.conclusion=="failure" or .conclusion=="cancelled") | "\(.name)\t\(.conclusion)\t\(.startedAt // .started_at // "")\t\(.completedAt // .completed_at // "")"' 2>/dev/null) || jobs_lines=""
    table=""
    if grep -q "${tab}cancelled$tab" <<<"$jobs_lines"; then table=$(run_bounds "$run" 2>/dev/null) || table=""; fi
    while IFS="$tab" read -r jname jconcl started completed || [ -n "${jname:-}" ]; do
      [ -n "${jname:-}" ] || continue
      suffix=""
      if [ "$jconcl" = "cancelled" ]; then suffix=$(cancel_suffix "$table" "$jname" "$started" "$completed") || suffix=""; fi
      printf 'failing: %s%s\n' "$jname" "$suffix"
    done <<<"$jobs_lines"
    return 1
  done
}
cmd_wait() {
  local pr="" pr_opt="" timeout=7200 req="[]" empty_ok=false names fail_fast=false last_progress="" job="" run=""
  local no_jobs_after=0 ns_head="" ns_from=0 ns_missing='[]'
  [ "${GH_CI_NO_JOBS_AFTER+x}" != x ] || no_jobs_after="$GH_CI_NO_JOBS_AFTER"
  while [ $# -gt 0 ]; do case "$1" in
    --timeout)
      [ $# -ge 2 ] || usage
      timeout="$2"; shift 2;;
    --no-jobs-after)
      [ $# -ge 2 ] || usage
      no_jobs_after="$2"; shift 2;;
    --job)
      [ $# -ge 2 ] || usage
      [ -n "${2:-}" ] || usage
      job="$2"; shift 2;;
    --pr)
      [ $# -ge 2 ] || usage
      case "${2:-}" in ''|*[!0-9]*) usage;; esac
      pr_opt="$2"; shift 2;;
    --run)
      [ $# -ge 2 ] || usage
      case "${2:-}" in ''|*[!0-9]*) usage;; esac
      run="$2"; shift 2;;
    --fail-fast) fail_fast=true; shift;;
    --*) usage;;
    *) [ -z "$pr" ] || usage; pr="$1"; shift;;
  esac; done
  [ -z "$run" ] || [ -z "$job" ] || usage
  if [ -n "$pr_opt" ] && [ -z "$run" ]; then usage; fi
  if [ -n "$pr" ] && [ -n "$pr_opt" ]; then usage; fi
  if [ -z "$run" ] && [ -z "$pr" ]; then usage; fi
  case "$timeout" in ''|*[!0-9]*) usage;; esac
  case "$no_jobs_after" in ''|*[!0-9]*) usage;; esac
  if [ -n "${CLAUDECODE:-}" ] && [ "$timeout" -lt 600 ]; then
    echo "gh-ci: --timeout $timeout ignored under Claude Code (waits run in the background); using 7200" >&2
    timeout=7200
  fi
  local interval="${GH_CI_INTERVAL:-30}"
  if [ -n "$run" ]; then
    wait_run "${pr_opt:-$pr}" "$run" "$timeout" "$interval"
    return $?
  fi
  local slept=0 head head2 state state2 checks_json payload reported=" " max_src max_map filtered padded verdict hs hs_rc missing_count missing_name run_id
  local dirty_head="" dirty_for=0 draft=false progress p_pend p_pass p_fail
  if [ -z "$job" ]; then
    if [ "$(gh api "repos/$REPO/pulls/$pr" --jq .draft 2>/dev/null)" = "true" ]; then
      draft=true
    fi
    if [ "$draft" = true ]; then
      :
    elif names=$(required_names "$pr" 2>/dev/null); then
      req=$(printf '%s' "$names" | jq -Rsc 'split("\n") | map(select(. != ""))')
      empty_ok=true
    else
      echo "gh-ci: cannot read required checks; judging every check on the head" >&2
    fi
  fi
  while true; do
    hs_rc=0; hs=$(head_state "$pr") || hs_rc=$?
    [ "$hs_rc" -ne 4 ] || return 1
    if [ "$hs_rc" -ne 0 ]; then
      [ "$slept" -lt "$timeout" ] || { echo "head: unreadable timeout after ${timeout}s"; return 124; }
      sleep "$interval"
      slept=$((slept + interval))
      continue
    fi
    read -r head state <<<"$hs"
    if [ "$state" = "DIRTY" ]; then
      [ "$head" = "$dirty_head" ] || { dirty_head="$head"; dirty_for=0; }
      if [ "$dirty_for" -ge 30 ] || [ "$slept" -ge "$timeout" ]; then
        conflict_msg "$pr"
        return "$CONFLICT_RC"
      fi
      sleep 5
      slept=$((slept + 5))
      dirty_for=$((dirty_for + 5))
      continue
    fi
    dirty_head=""
    if [ -z "$ns_head" ]; then
      ns_head="$head"
    elif [ "$head" != "$ns_head" ]; then
      ns_head="$head"
      ns_from="$slept"
    fi
    ns_missing='[]'
    if [ -n "$job" ]; then
      # the named job only: only an Actions job of the newest run counts;
      # a non-Actions check-run with the same name stays pending
      payload=$(head_checks "$head") || payload='{}'
      report_dropped "$payload"
      checks_json=$(printf '%s' "$payload" | jq -c '.checks // {}' 2>/dev/null) || checks_json='{}'
      checks_json=$(printf '%s' "$checks_json" | jq -c --arg name "$job" '
        if type != "array" then . else map(select(.name == $name and .run != null) | {name, bucket, run}) end' 2>/dev/null) \
        || checks_json='{}'
    elif [ "$empty_ok" = true ] && [ "$req" = "[]" ]; then
      checks_json='[]'
    else
      payload=$(head_checks "$head") || payload='{}'
      report_dropped "$payload"
      checks_json=$(printf '%s' "$payload" | jq -c '.checks // {}' 2>/dev/null) || checks_json='{}'
      # keep the run id: a failing cancelled check annotates its elapsed
      # time beside its timeout-minutes from its run's jobs
      checks_json=$(printf '%s' "$checks_json" | jq -c 'if type != "array" then . else map({name, bucket, run}) end' 2>/dev/null) \
        || checks_json='{}'
      if [ "$draft" != true ] && [ "$empty_ok" = true ] && [ "$req" != "[]" ]; then
        ns_missing=$(printf '%s' "$checks_json" | jq -c --argjson req "$req" '
          if type != "array" then [] else
            [$req[] as $name | select(all(.[]; .name != $name)) | $name] end' 2>/dev/null) \
          || ns_missing='[]'
      fi
      if [ "$draft" != true ] && [ "$empty_ok" = true ]; then
        # the required set, then a pending record for each required name with no check
        checks_json=$(printf '%s' "$checks_json" | jq -c --argjson req "$req" '
          if type != "array" then . else
            map(select(.name as $n | any($req[]; . == $n))) as $f
            | $f + [$req[] | select(. as $n | all($f[]; .name != $n)) | {name: ., bucket: "pending"}] end' 2>/dev/null) \
          || checks_json='{}'
      fi
    fi
    progress=$(printf '%s' "$checks_json" | jq -r --arg job "$job" 'if type != "array" then empty else
      "\([.[] | select(.bucket != "pass" and .bucket != "skipping" and .bucket != "fail" and .bucket != "cancel")] | length) \([.[] | select(.bucket == "pass" or (.bucket == "skipping" and $job == ""))] | length) \([.[] | select(.bucket == "fail" or .bucket == "cancel")] | length)" end' 2>/dev/null) || progress=""
    if [ -n "$progress" ] && [ "$progress" != "$last_progress" ]; then
      read -r p_pend p_pass p_fail <<<"$progress"
      echo "gh-ci: ${head:0:8} pending=$p_pend passed=$p_pass failing=$p_fail" >&2
      last_progress="$progress"
    fi
    verdict=$(printf '%s' "$checks_json" | jq -r --arg job "$job" --argjson empty_ok "$empty_ok" --argjson fail_fast "$fail_fast" '
      if type == "array" and length == 0 and $empty_ok then "pass"
      elif type != "array" or length == 0 then "pending"
      elif $fail_fast and any(.[]; .bucket == "fail" or .bucket == "cancel") then "fail"
      elif any(.[]; .bucket != "pass" and .bucket != "skipping" and .bucket != "fail" and .bucket != "cancel") then "pending"
      elif $job != "" and any(.[]; .bucket == "skipping") then "skipped"
      elif any(.[]; .bucket == "fail" or .bucket == "cancel") then "fail"
      else "pass" end' 2>/dev/null) || verdict=pending
    case "$verdict" in pass|fail|skipped) ;; *) verdict="pending";; esac
    if [ "$verdict" = "pending" ]; then
      missing_count=$(printf '%s' "$ns_missing" | jq -r 'length' 2>/dev/null) || missing_count=0
      if [ "$((10#$no_jobs_after))" -gt 0 ] && [ "$((slept - ns_from))" -ge "$((10#$no_jobs_after * 60))" ] && [ "$missing_count" -gt 0 ]; then
        while IFS= read -r missing_name || [ -n "$missing_name" ]; do
          [ -n "$missing_name" ] || continue
          printf 'gh-ci: check %s has no check run after %s min; it never started\n' "$missing_name" "$no_jobs_after"
        done < <(printf '%s' "$ns_missing" | jq -r '.[] | gsub("[\\r\\n]"; " ")')
        while IFS= read -r run_id || [ -n "$run_id" ]; do
          [ -n "$run_id" ] || continue
          printf 'gh-ci: run %s has no jobs after %s min; it never started\n' "$run_id" "$no_jobs_after"
        done < <(jobless_runs "$head")
        print_failing "$checks_json"
        return "$NO_START_RC"
      fi
      if [ "$slept" -ge "$timeout" ]; then
        echo "head: ${head:0:8} timeout after ${timeout}s"
        printf '%s' "$checks_json" | jq -r '.[] | select(.bucket != "pass" and .bucket != "skipping" and .bucket != "fail" and .bucket != "cancel") | "pending: \(.name)"' 2>/dev/null || true
        return 124
      fi
      sleep "$interval"
      slept=$((slept + interval))
      continue
    fi
    hs_rc=0; hs=$(head_state "$pr") || hs_rc=$?
    [ "$hs_rc" -ne 4 ] || return 1
    if [ "$hs_rc" -ne 0 ]; then
      [ "$slept" -lt "$timeout" ] || { echo "head: unreadable timeout after ${timeout}s"; return 124; }
      sleep "$interval"
      slept=$((slept + interval))
      continue
    fi
    read -r head2 state2 <<<"$hs"
    if [ "$head2" != "$head" ] || [ "$state2" = "DIRTY" ]; then
      continue
    fi
    if [ "$verdict" = "skipped" ]; then
      echo "head: ${head:0:8} job: $job skipped"
      return "$SKIPPED_JOB_RC"
    fi
    if [ "$verdict" = "fail" ]; then
      if [ -n "$job" ]; then
        echo "head: ${head:0:8} job: $job fail"
      else
        echo "head: ${head:0:8} CI: fail"
      fi
      print_failing "$checks_json"
      return 1
    fi
    if [ -n "$job" ]; then
      echo "head: ${head:0:8} job: $job pass"
    elif [ "$draft" = true ]; then
      echo "head: ${head:0:8} CI: pass (draft: required checks run once ready)"
    else
      echo "head: ${head:0:8} CI: pass"
    fi
    return 0
  done
}

# --repo is global: strip it from anywhere in argv so each subcommand parses the rest as before.
REPO_FLAG=""
ARGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) [ $# -ge 2 ] || usage; REPO_FLAG="$2"; shift 2;;
    *) ARGS+=("$1"); shift;;
  esac
done
set -- ${ARGS[@]+"${ARGS[@]}"}
if [ -n "$REPO_FLAG" ]; then
  [[ "$REPO_FLAG" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] || usage
fi
[ $# -ge 1 ] || usage
cmd="$1"; shift
case "$cmd" in snapshot|failures|watch-verified|verdict|resample|wait|panics) ;; *) usage ;; esac
if [ "$cmd" = panics ]; then
  cmd_panics "$@"
  exit 0
fi
if [ -n "$REPO_FLAG" ]; then
  REPO="$REPO_FLAG"
elif [ -n "${GH_CI_REPO:-}" ]; then
  REPO="$GH_CI_REPO"
else
  # origin's GitHub URL first: no network call. gh repo view only when that fails.
  origin="$(git remote get-url origin 2>/dev/null || true)"
  last=""
  if [[ "$origin" =~ ^(git@github\.com:|ssh://git@github\.com/|https://github\.com/)([^/]+)/([^/]+)$ ]]; then
    REPO="${BASH_REMATCH[2]}/${BASH_REMATCH[3]%.git}"
  else
    REPO=""
    if out="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>&1)"; then
      REPO="$out"
    else
      last="$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | tail -n 1 || true)"
    fi
  fi
  if [ -z "$REPO" ]; then
    echo "gh-ci: no repo: pass --repo OWNER/NAME, set GH_CI_REPO, or run in a checkout whose origin is on GitHub${last:+ (gh: $last)}" >&2
    exit 2
  fi
fi
case "$cmd" in
  snapshot) cmd_snapshot "$@" ;;
  failures) cmd_failures "$@" ;;
  watch-verified) cmd_watch_verified "$@" ;;
  verdict) cmd_verdict "$@" ;;
  resample) cmd_resample "$@" ;;
  wait) cmd_wait "$@" ;;
  *) usage ;;
esac
