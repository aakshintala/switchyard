#!/usr/bin/env bash
# roles-restart: relaunch missing Claude role sessions after a reboot.
# Install manually only when approved:
#   cp claude-code/launchd/com.aakshintala.roles-restart.plist ~/Library/LaunchAgents/ && launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.aakshintala.roles-restart.plist
# The plist is a template; this script never installs or bootstraps it.
# ROLES_RESTART_ROLES may override defaults as newline-separated role|home|handoff[|extra-args] rows.
# Fourth-column extra args are split on whitespace and passed before --agent.
# ROLES_RESTART_AGENTS_JSON may provide a fixture instead of running claude agents --json.
# ROLES_RESTART_WAIT_TIMEOUT bounds the gh auth status network/auth wait (seconds).
set -euo pipefail

log_file="${ROLES_RESTART_LOG:-$HOME/.cache/agents/roles-restart.log}"
lock_dir="${ROLES_RESTART_LOCK_DIR:-$HOME/.cache/agents/roles-restart.lock}"
wait_timeout="${ROLES_RESTART_WAIT_TIMEOUT:-120}"

log() {
  mkdir -p "$(dirname "$log_file")"
  printf '%s %s\n' "$(date '+%F %T')" "$1" >>"$log_file"
}

# The trap invokes this handler at process exit.
# shellcheck disable=SC2329
cleanup() {
  rmdir "$lock_dir" 2>/dev/null || true
}

if [[ ! "$wait_timeout" =~ ^[0-9]+$ ]]; then
  echo "roles-restart: ROLES_RESTART_WAIT_TIMEOUT must be a non-negative integer" >&2
  exit 2
fi
mkdir -p "$(dirname "$lock_dir")"
if ! mkdir "$lock_dir" 2>/dev/null; then
  if [ -e "$lock_dir" ]; then
    log "another run holds the lock; skipping"
    exit 0
  fi
  log "could not create lock $lock_dir"
  exit 1
fi
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

wait_for_auth() {
  local started="$SECONDS"
  while :; do
    if gh auth status >/dev/null 2>&1; then
      return 0
    fi
    if [ "$((SECONDS - started))" -ge "$wait_timeout" ]; then
      log "timed out waiting for network and gh auth status after ${wait_timeout}s"
      return 1
    fi
    sleep 1
  done
}

if ! wait_for_auth; then
  exit 1
fi

if [ -n "${ROLES_RESTART_AGENTS_JSON:-}" ]; then
  if ! agents_json="$(cat "$ROLES_RESTART_AGENTS_JSON")"; then
    log "could not read agents JSON file $ROLES_RESTART_AGENTS_JSON"
    exit 1
  fi
else
  if agents_json="$(claude agents --json)"; then
    :
  else
    status=$?
    log "claude agents --json failed (exit $status)"
    exit 1
  fi
fi

if agents_error="$(printf '%s\n' "$agents_json" | python3 -I -c '
import json
import sys

try:
    agents = json.load(sys.stdin)
except (json.JSONDecodeError, UnicodeDecodeError) as error:
    print(error)
    raise SystemExit(1)
if not isinstance(agents, list):
    print("expected a JSON array")
    raise SystemExit(1)
')"; then
  :
else
  log "could not parse claude agents --json: $agents_error"
  exit 1
fi

role_is_live() {
  local role_name="$1" matching_pids pid
  if ! matching_pids="$(printf '%s\n' "$agents_json" | python3 -I -c '
import json
import sys

role = sys.argv[1]
for row in json.load(sys.stdin):
    if not isinstance(row, dict) or row.get("name") != role:
        continue
    pid = row.get("pid")
    if isinstance(pid, int) and not isinstance(pid, bool) and pid > 0:
        print(pid)
' "$role_name")"; then
    return 2
  fi
  while IFS= read -r pid; do
    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      return 0
    fi
  done <<<"$matching_pids"
  return 1
}

launch_role() {
  local role_name="$1" role_home="$2" role_prompt="$3" extra_args_text="$4"
  if [ -n "$extra_args_text" ]; then
    local -a extra_args
    IFS=$' \t\n' read -r -a extra_args <<<"$extra_args_text"
    if [ -n "${extra_args[0]:-}" ]; then
      (cd "$role_home" && claude --bg "${extra_args[@]}" --name "$role_name" --agent "$role_name" "$role_prompt")
      return $?
    fi
  fi
  (cd "$role_home" && claude --bg --name "$role_name" --agent "$role_name" "$role_prompt")
}

if [ -n "${ROLES_RESTART_ROLES:-}" ]; then
  roles="$ROLES_RESTART_ROLES"
else
  # Absolute path: launchd does not expand ~. The directory comes from PR #1488.
  role_inbox="--plugin-dir /Users/aakshintala/.agents/claude-code/plugins/role-inbox"
  roles="$(printf '%s\n' \
    "surveyor|$HOME/work/fiber-worktrees/surveyor/home|$HOME/work/wiki/state/surveyor.md|$role_inbox" \
    "switchyard|$HOME/work/sy-wt/main|$HOME/work/wiki/state/switchyard.md|$role_inbox" \
    "flywheel|$HOME/work/fiber|$HOME/work/wiki/state/flywheel.md|$role_inbox")"
fi

failed=0
while IFS= read -r entry || [ -n "$entry" ]; do
  [ -n "$entry" ] || continue
  role=""; home=""; handoff=""; extra_args_text=""
  columns=1
  remaining="$entry"
  while [[ "$remaining" == *'|'* ]]; do
    columns=$((columns + 1))
    remaining="${remaining#*|}"
  done
  IFS='|' read -r role home handoff extra_args_text <<<"$entry"
  if [ "$columns" -gt 4 ] || [ -z "$role" ] || [ -z "$home" ] || [ -z "$handoff" ]; then
    log "invalid role table row; expected role|home|handoff[|extra-args]: $entry"
    failed=1
    continue
  fi
  if [ ! -f "$handoff" ]; then
    log "skipping $role: missing handoff $handoff"
    owner-ask log --from switchyard --kind note --title "roles-restart missing handoff $role" \
      || log "owner-ask note failed for missing handoff: $role"
    continue
  fi

  if role_is_live "$role"; then
    log "skipping $role: live session found"
    continue
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      log "could not check claude agents JSON for $role"
      exit 1
    fi
  fi

  if [ ! -d "$home" ]; then
    log "could not relaunch $role: missing home $home"
    failed=1
    continue
  fi
  prompt="Read your handoff at $handoff. Follow its instructions, re-create the crons listed in its ## Crons section, restart your inbox wait, and carry on. If it has no ## Crons section, say so on owner-ask and carry on."
  if launch_role "$role" "$home" "$prompt" "$extra_args_text"; then
    log "roles-restart relaunched $role"
    owner-ask log --from switchyard --kind process --title "roles-restart relaunched $role" \
      || { log "owner-ask process line failed for $role"; failed=1; }
  else
    status=$?
    log "failed to launch $role (exit $status)"
    failed=1
  fi
done <<<"$roles"

exit "$failed"
