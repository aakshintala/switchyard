#!/usr/bin/env bash
# plan-gate: print the command under `## Gate`, or the optional `## Fix gate` with --fix.
# Usage: plan-gate [--fix] [--script CMD] PLAN_FILE
#        plan-gate -h | --help
#        The selected gate is the text under the first matching heading (`## Gate`,
#        or `## Fix gate` with --fix), up to the next `# ` or `## ` heading
#        line or the end of the file. `###` and deeper headings are part of
#        the section and are skipped, not command lines. It must hold exactly
#        one non-blank command line, written bare, wrapped in single
#        backticks, or as the only line inside a ``` fence. Prints that
#        command on stdout and exits 0. After one wrapping backtick pair is
#        stripped, the command must hold no backtick: an
#        annotation such as `cmd` → PASS is rejected, since /bin/sh would run
#        it as command substitution. A gate that needs substitution uses $(...).
#        With --fix, the selected heading is `## Fix gate`, and its command
#        must contain the literal token `<since>`. With --fix and no such
#        heading, the command exits 3 with nothing on stdout; other invalid
#        sections exit 1. The default heading is `## Gate` and keeps its
#        existing exit codes.
#        With --script CMD, the command must run the repo's gate script CMD as
#        its workflow doc writes it. Leading NAME=VALUE assignments are allowed
#        only for CARGO_BUILD_JOBS, CARGO_INCREMENTAL, CARGO_TARGET_DIR,
#        NEXTEST_TEST_THREADS, RUSTC_WRAPPER, SCCACHE_*, KACHE_* and TMPDIR.
#        Each such VALUE must be an
#        unquoted plain word of [A-Za-z0-9_./:@%+,=-]: a quoted value or one
#        with a shell metacharacter (such as `1||` or `1;`) is rejected, since
#        it can hide an operator from the word check. Then the command must
#        start with CMD (or ./CMD, or bash CMD or bash ./CMD) at a word
#        boundary. Any other command exits 1 with the same stdout and stderr
#        rules.
#        Exit 2 on bad usage or an unreadable plan file.
set -euo pipefail

usage() {
  echo "usage: plan-gate [--fix] [--script CMD] PLAN_FILE" >&2
  exit 2
}

fix=0
script=""
while [ $# -gt 0 ]; do
  case "$1" in
    --fix) fix=1; shift ;;
    --script)
      [ $# -ge 2 ] && [ -n "$2" ] || usage
      script="$2"
      shift 2 ;;
    *) break ;;
  esac
done
[ $# -eq 1 ] || usage
case "$1" in -h|--help) usage ;; esac
plan="$1"
[ -r "$plan" ] || { echo "plan-gate: cannot read plan file: $plan" >&2; exit 2; }

section_heading="Gate"
heading_regex='^## Gate([[:space:]]|$)'
if [ "$fix" -eq 1 ]; then
  section_heading="Fix gate"
  heading_regex='^## Fix gate([[:space:]]|$)'
fi
if ! grep -Eq "$heading_regex" "$plan"; then
  if [ "$fix" -eq 1 ]; then
    echo "plan-gate: no '## Fix gate' heading in $plan" >&2
    exit 3
  fi
  echo "plan-gate: no '## Gate' heading in $plan" >&2
  exit 1
fi

section="$(awk -v heading="$section_heading" '
  !in_gate && $0 ~ ("^## " heading "([[:space:]]|$)") { in_gate = 1; next }
  in_gate && /^##? / { exit }
  in_gate && /^###/ { next }
  in_gate { print }
' "$plan")"

count=0
cmd=""
while IFS= read -r line; do
  # trim both ends
  t="${line#"${line%%[![:space:]]*}"}"
  t="${t%"${t##*[![:space:]]}"}"
  case "$t" in
    "") continue ;;
    '```'*) continue ;;
  esac
  count=$((count + 1))
  cmd="$t"
done <<<"$section"

if [ "$count" -eq 0 ]; then
  echo "plan-gate: the '## $section_heading' section holds no command: $plan" >&2
  exit 1
fi
if [ "$count" -gt 1 ]; then
  echo "plan-gate: the '## $section_heading' section holds more than one command line: $plan" >&2
  exit 1
fi

# single backticks wrap the command: strip them
if [ "${#cmd}" -ge 2 ] && [ "${cmd:0:1}" = '`' ] && [ "${cmd: -1}" = '`' ]; then
  cmd="${cmd:1:${#cmd}-2}"
fi
# a backticked blank (`   `) is no command either: trim what the backticks held
cmd="${cmd#"${cmd%%[![:space:]]*}"}"
cmd="${cmd%"${cmd##*[![:space:]]}"}"
if [ -z "$cmd" ]; then
  echo "plan-gate: the '## $section_heading' section holds no command: $plan" >&2
  exit 1
fi

if [ "$fix" -eq 1 ]; then
  case "$cmd" in
    *'<since>'*) ;;
    *)
      echo "plan-gate: the '## Fix gate' command must contain <since>: $plan" >&2
      exit 1 ;;
  esac
fi

case "$cmd" in
  *'`'*)
    echo "plan-gate: the '## $section_heading' command holds a backtick: $plan: $cmd" >&2
    exit 1 ;;
esac

if [ -n "$script" ]; then
  # starts_with_cmd STR: STR begins with CMD or ./CMD at a word boundary.
  starts_with_cmd() {
    case "$1" in
      "$script"|"$script"[[:space:]]*|"./$script"|"./$script"[[:space:]]*) return 0 ;;
    esac
    return 1
  }
  rest="$cmd"
  while :; do
    first="${rest%%[[:space:]]*}"
    case "$first" in
      [A-Za-z_]*=*) ;;
      *) break ;;
    esac
    case "${first%%=*}" in
      CARGO_BUILD_JOBS|CARGO_INCREMENTAL|CARGO_TARGET_DIR|NEXTEST_TEST_THREADS|RUSTC_WRAPPER|SCCACHE_*|KACHE_*|TMPDIR) ;;
      *)
        echo "plan-gate: the $section_heading line sets ${first%%=*}, which is not in the allowed variable list (CARGO_BUILD_JOBS, CARGO_INCREMENTAL, CARGO_TARGET_DIR, NEXTEST_TEST_THREADS, RUSTC_WRAPPER, SCCACHE_*, KACHE_*, TMPDIR): $cmd" >&2
        exit 1 ;;
    esac
    case "${first#*=}" in
      *[!A-Za-z0-9_./:@%+,=-]*) rest="" ; break ;;
    esac
    rest="${rest#"$first"}"
    rest="${rest#"${rest%%[![:space:]]*}"}"
  done
  ok=0
  if starts_with_cmd "$rest"; then
    ok=1
  else
    case "$rest" in
      bash[[:space:]]*)
        b="${rest#bash}"
        b="${b#"${b%%[![:space:]]*}"}"
        starts_with_cmd "$b" && ok=1 ;;
    esac
  fi
  if [ "$ok" -eq 0 ]; then
    echo "plan-gate: the $section_heading line must run the gate script $script as the workflow doc writes it, not its steps by hand: $cmd" >&2
    exit 1
  fi
fi

printf '%s\n' "$cmd"
