#!/usr/bin/env bash
# plan-gate: print a plan's gate command, the content under its `## Gate` heading.
# Usage: plan-gate [--script CMD] PLAN_FILE
#        plan-gate -h | --help
#        The gate is the text under the first line starting `## Gate` (whatever
#        follows on that heading line), up to the next `# ` or `## ` heading
#        line or the end of the file. `###` and deeper headings are part of
#        the section and are skipped, not command lines. It must hold exactly
#        one non-blank command line, written bare, wrapped in single
#        backticks, or as the only line inside a ``` fence. Prints that
#        command on stdout and exits 0. After one wrapping backtick pair is
#        stripped, the command must hold no backtick: an
#        annotation such as `cmd` → PASS is rejected, since /bin/sh would run
#        it as command substitution. A gate that needs substitution uses $(...).
#        Exit 1 (nothing on stdout, one line on stderr) when the heading is
#        missing, holds no command, or holds more than one command line.
#        With --script CMD, the command must run the repo's gate script CMD as
#        its workflow doc writes it. Leading NAME=VALUE assignments are allowed
#        only for CARGO_BUILD_JOBS, CARGO_INCREMENTAL, NEXTEST_TEST_THREADS,
#        RUSTC_WRAPPER, SCCACHE_* and KACHE_*. Then the command must start with
#        CMD (or ./CMD, or bash CMD or bash ./CMD) at a word boundary. Any
#        other command exits 1 with the same stdout and stderr rules.
#        Exit 2 on bad usage or an unreadable plan file.
set -euo pipefail

usage() {
  echo "usage: plan-gate [--script CMD] PLAN_FILE" >&2
  exit 2
}

script=""
if [ "${1:-}" = --script ]; then
  [ $# -ge 2 ] && [ -n "$2" ] || usage
  script="$2"
  shift 2
fi
[ $# -eq 1 ] || usage
case "$1" in -h|--help) usage ;; esac
plan="$1"
[ -r "$plan" ] || { echo "plan-gate: cannot read plan file: $plan" >&2; exit 2; }

grep -Eq '^## Gate([[:space:]]|$)' "$plan" || { echo "plan-gate: no '## Gate' heading in $plan" >&2; exit 1; }

section="$(awk '
  !in_gate && /^## Gate([[:space:]]|$)/ { in_gate = 1; next }
  in_gate && /^##? / { exit }
  in_gate && /^###/ { next }
  in_gate { print }
' "$plan")"

count=0
cmd=""
while IFS= read -r line; do
  # trim both ends
  t="${line#"${line%%[![:space:]]*}"}"
  t="${t%"${t##*[![:space:]]}"}"
  case "$t" in
    "") continue ;;
    '```'*) continue ;;
  esac
  count=$((count + 1))
  cmd="$t"
done <<<"$section"

if [ "$count" -eq 0 ]; then
  echo "plan-gate: the '## Gate' section holds no command: $plan" >&2
  exit 1
fi
if [ "$count" -gt 1 ]; then
  echo "plan-gate: the '## Gate' section holds more than one command line: $plan" >&2
  exit 1
fi

# single backticks wrap the command: strip them
if [ "${#cmd}" -ge 2 ] && [ "${cmd:0:1}" = '`' ] && [ "${cmd: -1}" = '`' ]; then
  cmd="${cmd:1:${#cmd}-2}"
fi
# a backticked blank (`   `) is no command either: trim what the backticks held
cmd="${cmd#"${cmd%%[![:space:]]*}"}"
cmd="${cmd%"${cmd##*[![:space:]]}"}"
if [ -z "$cmd" ]; then
  echo "plan-gate: the '## Gate' section holds no command: $plan" >&2
  exit 1
fi

case "$cmd" in
  *'`'*)
    echo "plan-gate: the '## Gate' command holds a backtick: $plan: $cmd" >&2
    exit 1 ;;
esac

if [ -n "$script" ]; then
  # starts_with_cmd STR: STR begins with CMD or ./CMD at a word boundary.
  starts_with_cmd() {
    case "$1" in
      "$script"|"$script"[[:space:]]*|"./$script"|"./$script"[[:space:]]*) return 0 ;;
    esac
    return 1
  }
  rest="$cmd"
  while :; do
    first="${rest%%[[:space:]]*}"
    case "$first" in
      [A-Za-z_]*=*) ;;
      *) break ;;
    esac
    case "${first%%=*}" in
      CARGO_BUILD_JOBS|CARGO_INCREMENTAL|NEXTEST_TEST_THREADS|RUSTC_WRAPPER|SCCACHE_*|KACHE_*) ;;
      *) rest="" ; break ;;
    esac
    rest="${rest#"$first"}"
    rest="${rest#"${rest%%[![:space:]]*}"}"
  done
  ok=0
  if starts_with_cmd "$rest"; then
    ok=1
  else
    case "$rest" in
      bash[[:space:]]*)
        b="${rest#bash}"
        b="${b#"${b%%[![:space:]]*}"}"
        starts_with_cmd "$b" && ok=1 ;;
    esac
  fi
  if [ "$ok" -eq 0 ]; then
    echo "plan-gate: the Gate line must run the gate script $script as the workflow doc writes it, not its steps by hand: $cmd" >&2
    exit 1
  fi
fi

printf '%s\n' "$cmd"
