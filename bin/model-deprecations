#!/usr/bin/env bash
# model-deprecations: ask one delegate job to report vendor model lifecycle changes.
# Usage: model-deprecations run
#        model-deprecations install [--print] [--at DOW HH:MM]
# MODEL_CATALOG_INBOX defaults to the surveyor box inbox.
set -euo pipefail

usage() {
  echo "usage: model-deprecations run" >&2
  echo "       model-deprecations install [--print] [--at DOW HH:MM]" >&2
  exit 2
}

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$script_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
script_path="$script_dir/$(basename "$script_path")"
helper="$script_dir/lib/model-deprecations.py"
brief="$script_dir/lib/model-deprecations-brief.md"
repo_root="$(cd "$script_dir/.." && pwd)"
RUN_TMP_DIR=""

cleanup_run() {
  if [ -n "$RUN_TMP_DIR" ]; then
    rm -rf "$RUN_TMP_DIR" "${RUN_TMP_DIR}.delegate-run.err" "${RUN_TMP_DIR}.delegate-watch.err"
  fi
}

render_units() {
  local day="$1" at="$2" exec_path="$3" quoted_path
  quoted_path="${exec_path//\\/\\\\}"
  quoted_path="${quoted_path//\"/\\\"}"
  quoted_path="${quoted_path//%/%%}"
  service_unit="$(cat <<UNIT
[Unit]
Description=Weekly vendor model deprecations report

[Service]
Type=oneshot
# A systemd user unit gets a PATH without ~/.local/bin, where delegate lives.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart="$quoted_path" run
TimeoutStartSec=4h
UNIT
)"
  timer_unit="$(cat <<UNIT
[Unit]
Description=Weekly vendor model deprecations report timer

[Timer]
OnCalendar=$day *-*-* $at:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
UNIT
)"
}

print_install() {
  local day="$1" at="$2" unit_dir="$3" exec_path="$4" service_unit timer_unit
  render_units "$day" "$at" "$exec_path"
  printf '# %s/model-deprecations.service\n' "$unit_dir"
  printf '%s\n' "$service_unit"
  printf '\n# %s/model-deprecations.timer\n' "$unit_dir"
  printf '%s\n' "$timer_unit"
  printf '\n# Commands (not run):\n'
  printf 'mkdir -p %q\n' "$unit_dir"
  echo 'systemctl --user daemon-reload'
  echo 'systemctl --user enable --now model-deprecations.timer'
  echo 'loginctl show-user "${USER}" -p Linger'
}

install_weekly() {
  local print_only=0 day=Mon at=08:45 unit_dir config_home user linger service_unit timer_unit
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --print) print_only=1; shift ;;
      --at)
        [ "$#" -ge 3 ] || usage
        day="$2"
        at="$3"
        shift 3
        ;;
      *) usage ;;
    esac
  done
  case "$day" in Mon|Tue|Wed|Thu|Fri|Sat|Sun) ;; *) usage ;; esac
  [[ "$at" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || usage
  config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  unit_dir="$config_home/systemd/user"
  if [ "$print_only" -eq 1 ]; then
    print_install "$day" "$at" "$unit_dir" "$script_path"
    return 0
  fi

  mkdir -p "$unit_dir"
  render_units "$day" "$at" "$script_path"
  printf '%s\n' "$service_unit" >"$unit_dir/model-deprecations.service"
  printf '%s\n' "$timer_unit" >"$unit_dir/model-deprecations.timer"
  systemctl --user daemon-reload
  systemctl --user enable --now model-deprecations.timer
  user="${USER:-$(id -un)}"
  if linger="$(loginctl show-user "$user" -p Linger 2>/dev/null)" && [ "$linger" = "Linger=yes" ]; then
    :
  else
    echo "model-deprecations: warning: user lingering is not enabled; the timer may not run while logged out" >&2
  fi
}

run_deprecations() {
  local model today source_sha scratch delegate_output job_id rc inbox status_output delegate_status
  RUN_TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/model-deprecations.XXXXXX")"
  trap cleanup_run EXIT
  scratch="$RUN_TMP_DIR/report.md"
  today="${MODEL_DEPRECATIONS_TODAY:-$(date -u +%F)}"
  source_sha="$(git -C "$repo_root" rev-parse --short HEAD 2>/dev/null || printf unknown)"
  model="${MODEL_DEPRECATIONS_MODEL:-openai/gpt-6-luna:medium}"
  inbox="${MODEL_CATALOG_INBOX:-/srv/lanes/fiber-worktrees/surveyor/run/inbox}"

  set +e
  delegate_output="$(
    {
      cat "$brief"
      printf '\nReport date: %s\n' "$today"
      printf 'Source line: source: model-deprecations %s\n' "$source_sha"
      printf 'Scratch report path (write only the report here): %s\n' "$scratch"
    } | delegate run --model "$model" --cwd "$RUN_TMP_DIR" 2>"${RUN_TMP_DIR}.delegate-run.err"
  )"
  rc=$?
  set -e
  job_id="$(printf '%s\n' "$delegate_output" | grep -Eo '[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}' | tail -n 1 || true)"
  if [ -n "$job_id" ]; then
    if status_output="$(delegate status "$job_id" 2>/dev/null)"; then
      delegate_status="$(printf '%s\n' "$status_output" | sed -nE 's/^[^:]+: ([A-Z][A-Z_]*)( .*)?$/\1/p' | head -n 1)"
    else
      delegate_status=""
    fi
  else
    delegate_status=""
  fi
  if [ "$rc" -ne 0 ]; then
    echo "model-deprecations: delegate run failed" >&2
    python3 -I "$helper" failure "$inbox" "$today" "$source_sha" "$delegate_status"
    return 1
  fi
  if [ -z "$job_id" ]; then
    echo "model-deprecations: delegate run returned no job id" >&2
    python3 -I "$helper" failure "$inbox" "$today" "$source_sha"
    return 1
  fi

  set +e
  delegate watch "$job_id" >/dev/null 2>"${RUN_TMP_DIR}.delegate-watch.err"
  rc=$?
  set -e
  if status_output="$(delegate status "$job_id" 2>/dev/null)"; then
    delegate_status="$(printf '%s\n' "$status_output" | sed -nE 's/^[^:]+: ([A-Z][A-Z_]*)( .*)?$/\1/p' | head -n 1)"
  else
    delegate_status=""
  fi
  if [ "$rc" -ne 0 ] || [ "$delegate_status" != DONE ]; then
    echo "model-deprecations: delegate job did not finish with DONE" >&2
    python3 -I "$helper" failure "$inbox" "$today" "$source_sha" "$delegate_status"
    return 1
  fi
  if [ ! -s "$scratch" ]; then
    echo "model-deprecations: delegate produced no scratch report" >&2
    python3 -I "$helper" failure "$inbox" "$today" "$source_sha" "$delegate_status"
    return 1
  fi
  python3 -I "$helper" publish "$scratch" "$inbox" "$today" "$source_sha"
}

[ "$#" -ge 1 ] || usage
command_name="$1"
shift
case "$command_name" in
  run)
    [ "$#" -eq 0 ] || usage
    run_deprecations
    ;;
  install) install_weekly "$@" ;;
  *) usage ;;
esac
