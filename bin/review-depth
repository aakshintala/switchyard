#!/usr/bin/env python3
# review-depth: choose one review round or the full review loop from a unified diff.
# Usage: review-depth [diff-file] [--pr <n> --repo <owner/name>] [--repo-root <dir>]
# A local git toplevel is the default repo root; use --threshold or
# REVIEW_DEPTH_THRESHOLD to override the default 700 non-test changed lines.
from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path, PurePosixPath


# Keep the persistence and process-lifetime signals together for auditability.
PERSISTED_PATTERNS = [
    (re.compile(r"#\s*\[\s*derive\s*\([^]]*\b(?:Serialize|Deserialize)\b", re.I), "serde derive"),
    (re.compile(r"#\s*\[\s*serde\s*(?:\(|\])", re.I), "serde attribute"),
    (re.compile(r"\b(?:Serialize|Deserialize)\b"), "serde type"),
    (re.compile(r"(?:^|/)(?:schema|schemas|migration|migrations)(?:/|\.|$)", re.I), "schema or migration file"),
    (re.compile(r"\.(?:proto|sql)$", re.I), "wire or schema file"),
    (re.compile(r"\b(?:serde_json|json\.(?:dump|dumps)|JSON\.stringify|jsonl|JSONL|to_json|write_json)\b", re.I), "JSON record writer"),
]
LOCKING_PATTERNS = [
    (re.compile(r"\bMutex\b"), "Mutex"),
    (re.compile(r"\bRwLock\b"), "RwLock"),
    (re.compile(r"\bflock\b", re.I), "flock"),
    (re.compile(r"\block\s*\("), "lock("),
    (re.compile(r"\bspawn\b", re.I), "spawn"),
    (re.compile(r"\bCommand\s*::\s*new\b"), "Command::new"),
    (re.compile(r"\bfork\s*\("), "fork"),
    (re.compile(r"\bkill\s*\("), "kill"),
    (re.compile(r"\bsignal\b", re.I), "signal"),
    (re.compile(r"\bwait\s*\("), "wait"),
    (re.compile(r"\bsetsid\b", re.I), "setsid"),
    (re.compile(r"\bnohup\b", re.I), "nohup"),
    (re.compile(r"\btrap\b", re.I), "trap"),
    (re.compile(r"&\s*(?:#.*)?$"), "shell backgrounding (&)"),
]
PUB_ITEM = re.compile(
    r"^\s*pub\s+(?:(?:async|unsafe|const|extern\s+\"[^\"]+\")\s+)*(fn|struct|enum|trait|type|const)\s+([A-Za-z_][A-Za-z_0-9]*)\b"
)
PUB_FIELD = re.compile(r"\bpub\s+([A-Za-z_][A-Za-z_0-9]*)\s*:")
HUNK_HEADER = re.compile(r"^@@")
HUNK_NEW_START = re.compile(r"^@@ -\d+(?:,\d+)? \+(\d+)(?:,\d+)? @@")
RUST_TYPE_ITEM = re.compile(
    r"^\s*(?P<visibility>pub(?:\s*\([^)]*\))?\s+)?(?P<kind>struct|enum)\s+(?P<name>[A-Za-z_][A-Za-z_0-9]*)\b"
)
RUST_TEST_CFG = re.compile(r"#\s*\[\s*cfg\s*\(\s*test\s*\)\s*\]")
TEST_NAME = re.compile(r"(?:^|/)test[^/]*\.py$|(?:^|/)[^/]*_test\.[^/]+$|(?:^|/)[^/]*\.test\.[^/]+$")


@dataclass
class Hunk:
    lines: list[str] = field(default_factory=list)
    new_start: int = 1


@dataclass
class FileDiff:
    path: str
    hunks: list[Hunk] = field(default_factory=list)


def parse_diff(text: str) -> list[FileDiff]:
    files: list[FileDiff] = []
    current: FileDiff | None = None
    hunk: Hunk | None = None
    old_path = ""
    for line in text.splitlines():
        if line.startswith("--- "):
            old_path = line[4:].split("\t", 1)[0]
            continue
        if line.startswith("+++ "):
            raw = line[4:].split("\t", 1)[0]
            path = raw[2:] if raw.startswith(("a/", "b/")) else raw
            if path == "/dev/null":
                path = old_path[2:] if old_path.startswith("a/") else old_path
            path = path.strip('"')
            current = FileDiff(path=path)
            files.append(current)
            hunk = None
            continue
        if HUNK_HEADER.match(line):
            if current is not None:
                match = HUNK_NEW_START.match(line)
                hunk = Hunk(new_start=int(match.group(1)) if match else 1)
                current.hunks.append(hunk)
            else:
                hunk = None
            continue
        if hunk is not None:
            hunk.lines.append(line)
    return files


def changed_lines(file_diff: FileDiff):
    for hunk in file_diff.hunks:
        for line in hunk.lines:
            if line.startswith(("+", "-")) and not line.startswith(("+++", "---")):
                yield hunk, line[1:]


def changed_locations(hunk: Hunk):
    new_line = hunk.new_start
    for index, line in enumerate(hunk.lines):
        if line.startswith(("+++", "---")):
            continue
        if line.startswith("+"):
            yield index, line[1:], new_line
            new_line += 1
        elif line.startswith("-"):
            yield index, line[1:], new_line
        elif line.startswith(" "):
            new_line += 1


def hunk_current_lines(hunk: Hunk):
    lines = []
    positions = {}
    for index, line in enumerate(hunk.lines):
        if line.startswith(("+++", "---")):
            continue
        if line.startswith("-"):
            positions[index] = len(lines)
        elif line.startswith("+"):
            positions[index] = len(lines)
            lines.append(line[1:])
        elif line.startswith(" "):
            positions[index] = len(lines)
            lines.append(line[1:])
    return lines, positions


def find_type_body(lines: list[str], start: int, match):
    angle_depth = 0
    where_clause = False
    kind = match.group("kind")
    for line_index in range(start, len(lines)):
        line = lines[line_index]
        offset = match.end() if line_index == start else 0
        for position in range(offset, len(line)):
            char = line[position]
            if angle_depth:
                if char == "<":
                    angle_depth += 1
                elif char == ">":
                    angle_depth -= 1
                continue
            if line.startswith("where", position) and (
                position == 0 or not (line[position - 1].isalnum() or line[position - 1] == "_")
            ) and (position + 5 == len(line) or not (line[position + 5].isalnum() or line[position + 5] == "_")):
                where_clause = True
            if char == "<":
                angle_depth = 1
            elif kind == "enum" and char == "{":
                return line_index, position, "{"
            elif kind == "struct":
                if char == "{":
                    return line_index, position, "{"
                if char == "(" and not where_clause:
                    return line_index, position, "("
    return None


def type_contains_line(lines: list[str], start: int, target: int, match) -> bool:
    if start == target:
        return True
    opening = find_type_body(lines, start, match)
    if not opening:
        return False
    open_line, open_column, delimiter = opening
    if target < open_line or target == open_line:
        return True
    close = "}" if delimiter == "{" else ")"
    depth = 0
    for line_index in range(open_line, target):
        text = lines[line_index][open_column:] if line_index == open_line else lines[line_index]
        for char in text:
            if char == delimiter:
                depth += 1
            elif char == close:
                depth -= 1
                if depth == 0:
                    return False
    return depth > 0


def enclosing_rust_type(lines: list[str], target_index: int):
    if target_index < 0 or target_index > len(lines):
        return None
    for start in range(min(target_index, len(lines) - 1), -1, -1):
        match = RUST_TYPE_ITEM.match(lines[start])
        if match and type_contains_line(lines, start, target_index, match):
            return match.group("name"), bool(match.group("visibility")), start
    return None


def attribute_start(lines: list[str], end: int) -> int | None:
    depth = 0
    for index in range(end, -1, -1):
        line = re.sub(r'"(?:\\.|[^"\\])*"', '""', lines[index])
        for char in reversed(line):
            if char == "]":
                depth += 1
            elif char == "[":
                depth -= 1
                if depth == 0 and re.match(r"^\s*#\s*!?\s*\[", lines[index]):
                    return index
            if depth < 0:
                return None
    return None


def doc_comment_line(line: str) -> bool:
    text = line.strip()
    return text.startswith(("///", "//!", "/**", "/*!", "*", "*/"))


def serde_marker_in_type(lines: list[str], declaration: int, target: int) -> str | None:
    prefix = []
    prior = declaration - 1
    while prior >= 0:
        text = lines[prior].strip()
        if not text or doc_comment_line(text):
            prefix.insert(0, lines[prior])
            prior -= 1
            continue
        start = attribute_start(lines, prior)
        if start is None:
            break
        prefix = lines[start:prior + 1] + prefix
        prior = start - 1
    context = "\n".join(prefix + lines[declaration:target + 1])
    for pattern, label in PERSISTED_PATTERNS[:3]:
        if pattern.search(context):
            return label
    return None


def source_lines_for(root: Path, file_diff: FileDiff) -> list[str]:
    path = (root / file_diff.path).resolve()
    try:
        path.relative_to(root)
        return path.read_text(errors="replace").splitlines()
    except (OSError, ValueError):
        return []


def type_context_for_change(file_diff: FileDiff, hunk: Hunk, index: int, new_line: int, root: Path | None, source_lines: list[str], hunk_lines: list[str], hunk_positions: dict[int, int]):
    if source_lines:
        context = enclosing_rust_type(source_lines, new_line - 1)
        if context:
            return source_lines, context, new_line - 1
    target = hunk_positions.get(index, len(hunk_lines))
    context = enclosing_rust_type(hunk_lines, target)
    if context:
        return hunk_lines, context, target
    return None


def enclosing_serde_signal(files: list[FileDiff], root: Path | None) -> str | None:
    for file_diff in files:
        source_lines = source_lines_for(root, file_diff) if root else []
        for hunk in file_diff.hunks:
            hunk_lines, hunk_positions = hunk_current_lines(hunk)
            for index, _, new_line in changed_locations(hunk):
                found = type_context_for_change(
                    file_diff, hunk, index, new_line, root, source_lines, hunk_lines, hunk_positions
                )
                if found:
                    lines, context, target = found
                    marker = serde_marker_in_type(lines, context[2], target)
                    if marker:
                        return f"persisted/wire-format signal={marker} file={file_diff.path}"
    return None


def rust_public_names(file_diff: FileDiff, root: Path | None) -> list[str]:
    if not file_diff.path.endswith(".rs") or is_test_path(file_diff.path):
        return []
    names = []
    source_lines = source_lines_for(root, file_diff) if root else []
    for hunk in file_diff.hunks:
        if is_test_hunk(file_diff.path, hunk):
            continue
        hunk_lines, hunk_positions = hunk_current_lines(hunk)
        for index, changed_text, new_line in changed_locations(hunk):
            if PUB_FIELD.search(changed_text) or PUB_ITEM.match(changed_text):
                continue
            found = type_context_for_change(
                file_diff, hunk, index, new_line, root, source_lines, hunk_lines, hunk_positions
            )
            if found:
                _, context, _ = found
                if context[1]:
                    names.append(context[0])
        in_signature: str | None = None
        for line in hunk.lines:
            changed = line.startswith(("+", "-")) and not line.startswith(("+++", "---"))
            content = line[1:] if changed else line[1:] if line.startswith(" ") else line
            if changed:
                field = PUB_FIELD.search(content)
                if field:
                    names.append(field.group(1))
            match = PUB_ITEM.match(content)
            if match:
                name = match.group(2)
                if changed:
                    names.append(name)
                in_signature = name if not re.search(r"[;{]", content) else None
                continue
            if changed and in_signature:
                names.append(in_signature)
            if in_signature and re.search(r"[;{]", content):
                in_signature = None
    return names


def is_test_path(path: str) -> bool:
    parts = PurePosixPath(path).parts
    if any(part in ("test", "tests") for part in parts):
        return True
    return bool(TEST_NAME.search(path))


def is_test_hunk(path: str, hunk: Hunk) -> bool:
    return path.endswith(".rs") and any(RUST_TEST_CFG.search(line.lstrip(" +-")) for line in hunk.lines)


def default_repo_root() -> Path | None:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            check=True,
            capture_output=True,
            text=True,
        )
    except (OSError, subprocess.CalledProcessError):
        return None
    return Path(result.stdout.strip()).resolve()


def crate_root_for(path: Path, root: Path) -> Path | None:
    current = path if path.is_dir() else path.parent
    try:
        current.relative_to(root)
    except ValueError:
        return None
    while True:
        if (current / "Cargo.toml").is_file():
            return current
        if current == root:
            return None
        current = current.parent


def crates_under(root: Path) -> list[Path]:
    crates = []
    for manifest in root.rglob("Cargo.toml"):
        if any(part in (".git", "target", "node_modules", "vendor") for part in manifest.parts):
            continue
        crates.append(manifest.parent)
    return crates


def name_used_in_other_crate(name: str, file_path: str, root: Path) -> bool:
    changed = (root / file_path).resolve()
    changed_crate = crate_root_for(changed, root)
    pattern = re.compile(rf"\b{re.escape(name)}\b")
    for crate in crates_under(root):
        if changed_crate == crate:
            continue
        for source in crate.rglob("*.rs"):
            if any(part in (".git", "target", "node_modules", "vendor") for part in source.parts):
                continue
            try:
                if pattern.search(source.read_text(errors="replace")):
                    return True
            except OSError:
                continue
    return False


def rust_signature_signal(files: list[FileDiff], root: Path | None) -> str | None:
    for file_diff in files:
        for name in rust_public_names(file_diff, root):
            if root is None:
                return f"pub signature {name} (diff-only; no repo root)"
            if name_used_in_other_crate(name, file_diff.path, root):
                return f"pub signature {name} used by another crate"
    return None


def content_signal(files: list[FileDiff], patterns, category: str) -> str | None:
    for file_diff in files:
        for _, line in changed_lines(file_diff):
            for pattern, label in patterns:
                if pattern.search(file_diff.path) or pattern.search(line):
                    return f"{category} signal={label} file={file_diff.path}"
    return None


def non_test_line_count(files: list[FileDiff]) -> int:
    count = 0
    for file_diff in files:
        for hunk in file_diff.hunks:
            if is_test_path(file_diff.path) or is_test_hunk(file_diff.path, hunk):
                continue
            count += sum(
                1 for line in hunk.lines
                if line.startswith(("+", "-")) and not line.startswith(("+++", "---"))
            )
    return count


def choose_depth(text: str, root: Path | None, threshold: int) -> tuple[str, str]:
    files = parse_diff(text)
    signal = rust_signature_signal(files, root)
    if signal:
        return "full", signal
    signal = content_signal(files, PERSISTED_PATTERNS, "persisted/wire-format")
    if signal:
        return "full", signal
    signal = enclosing_serde_signal(files, root)
    if signal:
        return "full", signal
    signal = content_signal(files, LOCKING_PATTERNS, "locking/process-lifetime")
    if signal:
        return "full", signal
    count = non_test_line_count(files)
    if count > threshold:
        return "full", f"non-test lines={count} threshold={threshold}"
    return "single", f"non-test lines={count} threshold={threshold}"


def parse_threshold(value: str, source: str) -> int:
    try:
        threshold = int(value)
    except ValueError as exc:
        raise ValueError(f"{source} must be a non-negative integer") from exc
    if threshold < 0:
        raise ValueError(f"{source} must be a non-negative integer")
    return threshold


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="choose review depth from a unified diff")
    parser.add_argument("diff_file", nargs="?", help="diff file; read stdin when omitted or '-' is used")
    parser.add_argument("--pr", help="fetch the diff for a pull request")
    parser.add_argument("--repo", help="repository in owner/name form; required with --pr")
    parser.add_argument("--repo-root", help="repository root used to find cross-crate Rust callers")
    parser.add_argument("--threshold", help="non-test added+removed line threshold (default: 700)")
    args = parser.parse_args(argv)

    if bool(args.pr) != bool(args.repo):
        parser.error("--pr and --repo must be used together")
    if args.pr and args.diff_file:
        parser.error("choose a diff file/stdin or --pr, not both")
    threshold_text = args.threshold if args.threshold is not None else os.environ.get("REVIEW_DEPTH_THRESHOLD", "700")
    try:
        threshold = parse_threshold(threshold_text, "--threshold" if args.threshold is not None else "REVIEW_DEPTH_THRESHOLD")
    except ValueError as exc:
        parser.error(str(exc))

    if args.pr:
        try:
            result = subprocess.run(
                ["gh", "pr", "diff", args.pr, "--repo", args.repo],
                capture_output=True,
                text=True,
                check=True,
            )
        except (OSError, subprocess.CalledProcessError) as exc:
            message = getattr(exc, "stderr", None) or str(exc)
            print(f"review-depth: cannot fetch PR diff: {message.strip()}", file=sys.stderr)
            return 2
        diff_text = result.stdout
    elif args.diff_file and args.diff_file != "-":
        try:
            diff_text = Path(args.diff_file).read_text()
        except OSError as exc:
            print(f"review-depth: cannot read diff file {args.diff_file}: {exc}", file=sys.stderr)
            return 2
    else:
        diff_text = sys.stdin.read()

    if args.repo_root:
        root = Path(args.repo_root).resolve()
        if not root.is_dir():
            parser.error(f"--repo-root is not a directory: {args.repo_root}")
    else:
        root = default_repo_root()
    depth, reason = choose_depth(diff_text, root, threshold)
    print(f"{depth} {reason}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
