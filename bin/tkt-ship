#!/usr/bin/env bash
# tkt-ship: run ship-pr from state, rerun on 124, digest red CI.
# Longest wait: four ship-pr attempts x five CI waits x 7200 s, plus the gate.
# Usage: tkt-ship <state>
# State key no_mutants_label: reason passed to ship-pr as --no-mutants-label.
# State key mutant_job opts ship-pr into its --mutants-gate check.
# State key merge_check: command passed to ship-pr as --merge-check unless merge_gate is gate.
# State key body_ends: text passed to ship-pr as --body-ends; absent, unreadable,
# empty or blank passes no flag and asks for no check.
# State key unverified: path passed to ship-pr as --unverified-fixes.
set -euo pipefail

usage() {
  echo "usage: tkt-ship <state>" >&2
  echo "       longest wait 144000 s (40 h): 4 ship-pr attempts x 5 CI waits x 7200 s, plus the gate; run it in the background with no shell timeout" >&2
  echo "       state keys: no_mutants_label passes --no-mutants-label, mutant_job passes --mutants-gate, body_ends passes --body-ends, unverified passes --unverified-fixes, merge_check passes --merge-check unless merge_gate is gate" >&2
  exit 2
}
[ $# -eq 1 ] || usage
state="$1"
script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
tkt_state="$script_dir/tkt-state"
bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
tkt() { "$tkt_state" "$state" "$@"; }
verdict_lib="$script_dir/lib/plan-verdict.sh"
if [ ! -r "$verdict_lib" ]; then echo "tkt-ship: cannot read shared lib: $verdict_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$verdict_lib"
tokens_lib="$script_dir/lib/plan-tokens.sh"
if [ ! -r "$tokens_lib" ]; then echo "tkt-ship: cannot read shared lib: $tokens_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$tokens_lib"
plan_gate_lib="$script_dir/lib/plan-gate-args.sh"
if [ ! -r "$plan_gate_lib" ]; then echo "tkt-ship: cannot read shared lib: $plan_gate_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$plan_gate_lib"
local_gate_body_lib="$script_dir/lib/local-gate-body.sh"
if [ ! -r "$local_gate_body_lib" ]; then echo "tkt-ship: cannot read shared lib: $local_gate_body_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$local_gate_body_lib"

# Command lock: <state>.lock, the same path tkt-state takes for every write.
# Held only around the ship-pr run and its log work; released (pid file
# removed, then rmdir) before any tkt journal or tkt write, including the one
# inside emit. Released on every exit path via trap; command-substitution
# subshells inherit the trap, so only the top shell (BASH_SUBSHELL 0) may
# release it.
locked=0
lockdir="$state.lock"
cleanup_lock() {
  if [ "$locked" = "1" ] && [ "${BASH_SUBSHELL:-0}" = "0" ]; then
    rm -f "$lockdir/pid"
    rmdir "$lockdir" 2>/dev/null || rm -rf "$lockdir"
  fi
}
release_lock() {
  if [ "$locked" = "1" ] && [ "${BASH_SUBSHELL:-0}" = "0" ]; then
    rm -f "$lockdir/pid"
    rmdir "$lockdir" 2>/dev/null || rm -rf "$lockdir"
    locked=0
  fi
}
trap cleanup_lock EXIT

# Verdict on line 1 plus at most 40 digest lines, to stdout and the run log.
emit() {
  local verdict="$1" code="$2" out
  shift 2
  out="TKT tkt-ship $verdict log=$runlog"
  if [ $# -gt 0 ]; then
    out="$out
$(printf '%s\n' "$@" | head -n 40)"
  fi
  printf '%s\n' "$out" | tee -a "$runlog"
  release_lock
  tkt journal "tkt-ship $verdict"
  exit "$code"
}

# Run log path for failures before the ship loop assigns one per attempt.
# tee creates it on first emit; the success path never touches it.
rdir="$(tkt get run 2>/dev/null || true)"
[ -n "$rdir" ] || rdir="$(dirname "$state")"
mkdir -p "$rdir" 2>/dev/null || true
runlog="$rdir/tkt-ship-early-$(date +%H%M%S)-$$.log"

ship_repair_hint() {
  case "$1" in
    repo|issue|worktree|run)
      printf 'Repair command: rerun tkt-start --run <run-dir> --repo <owner/name> --issue <number> --spec <ticket-body> --branch <branch> --worktree <path> --workflow-doc <path> --closing '\''Resolves #<number>'\''\n' ;;
    pr|head)
      printf 'Repair command: tkt-build %s --from review (recover PR identity from the branch PR)\n' "$state" ;;
    plan)
      printf 'Repair command: tkt-plan %s set <plan-path>, then run tkt-plan %s verify when the Verifier applies; use --no-verifier only on an approved bypass path\n' "$state" "$state" ;;
    reviewed)
      status="$(tkt get review_status 2>/dev/null || true)"
      case "$status" in
        gate-failed) printf 'review_status=gate-failed\nRepair command: tkt-build %s --from gate\n' "$state" ;;
        ready|done|skipped) printf 'review_status=%s\nRepair command: tkt-build %s --from review (run or reconstruct the PR review before shipping)\n' "$status" "$state" ;;
        *) printf 'review_status=%s\nRepair command: tkt-build %s --from gate (finish the gate and PR review before shipping)\n' "${status:-missing}" "$state" ;;
      esac ;;
    *) printf 'Repair command: rerun tkt-start with the missing ticket metadata, or tkt-build %s --from review as appropriate\n' "$state" ;;
  esac
}

if ! req_err="$(tkt require repo issue pr worktree run head 2>&1)"; then
  printf '%s\n' "$req_err" >&2
  key="$(printf '%s\n' "$req_err" | sed -n 's/.*missing key: //p' | head -n 1)"
  [ -n "$key" ] || key="unknown"
  emit "PRECONDITION missing=$key" 2 "$req_err" "$(ship_repair_hint "$key")"
fi
repo="$(tkt get repo)"
issue="$(tkt get issue)"
pr="$(tkt get pr)"
reviewed="$(tkt get reviewed 2>/dev/null || true)"
if [ -z "$reviewed" ]; then
  emit "PRECONDITION missing=reviewed" 2 "tkt-state: missing key: reviewed" "$(ship_repair_hint reviewed)"
fi
worktree="$(tkt get worktree)"
run="$(tkt get run)"

# ship-pr runs with the run dir as its cwd, so the worktree and unverified
# paths it receives must be absolute: resolve a relative value against this
# cwd (the one the state was written from). Prints the absolute path; a
# relative value that exists nowhere as given prints nothing and returns 1.
abspath() {
  case "$1" in
    /*) printf '%s\n' "$1"; return 0 ;;
  esac
  [ -e "$1" ] || return 1
  (cd "$1" 2>/dev/null && pwd) || {
    local d b
    d="$(dirname "$1")"; b="$(basename "$1")"
    printf '%s/%s\n' "$(cd "$d" && pwd)" "$b"
  }
}
worktree="$(abspath "$worktree")" || {
  msg="tkt-ship: relative path does not exist as given: $worktree"
  printf '%s\n' "$msg" >&2
  emit "PRECONDITION relative=$worktree" 2 "$msg"
}
mkdir -p "$run"

plan="$(tkt get plan 2>/dev/null || true)"
base=""
if [ -n "$plan" ]; then base="$(plan_base "$plan" 2>/dev/null || true)"; fi
if ! plan_verdict_check ship "$tkt_state" "$state" 0 "$plan" "$base" "$worktree"; then
  emit "VERDICT-REFUSED verdict=$verdict_refusal" 1 "$verdict_digest" \
    "tkt-plan $state triaged --comment <id>, or edit the plan and use --no-verifier"
fi

stored_head="$(tkt get head)"
actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || {
  msg="tkt-ship: cannot read worktree HEAD: $worktree"
  printf '%s\n' "$msg" >&2
  emit "PRECONDITION worktree=unreadable" 2 "$msg"
}
pr_head="$(gh pr view "$pr" --repo "$repo" --json headRefOid --jq '.headRefOid' 2>/dev/null || true)"
if [ -z "$pr_head" ]; then
  msg="tkt-ship: cannot read PR head: pr=$pr repo=$repo"
  printf '%s\n' "$msg" >&2
  emit "PRECONDITION pr=unreadable" 2 "$msg"
fi
if [ "$stored_head" != "$actual" ] || [ "$stored_head" != "$pr_head" ]; then
  msg="tkt-ship: head drift: state head=$stored_head worktree $worktree HEAD=$actual pr $pr head=$pr_head"
  printf '%s\n' "$msg" >&2
  emit "DRIFT state=$stored_head worktree=$actual pr=$pr_head" 3 "$msg"
fi

# Compare the patch each gate covered with the PR head's patch against
# origin/main. A main-only merge keeps the patch-id; changed content or an
# unavailable comparison refuses ship. tkt-ship already uses origin/main and
# deliberately does not fetch it here.
gate_diff_patch_id() {
  local sha="$1" side="$2" merge_base patch
  merge_base="$(git -C "$worktree" merge-base origin/main "$sha" 2>/dev/null)" || {
    gate_diff_error="$side diff comparison failed: merge-base with origin/main is unavailable for sha=$sha"
    return 1
  }
  if ! patch="$(git -C "$worktree" diff --no-ext-diff "$merge_base" "$sha" | git patch-id --stable 2>/dev/null | awk '{print $1}')"; then
    gate_diff_error="$side diff comparison failed: patch-id --stable failed for sha=$sha relative to merge-base=$merge_base"
    return 1
  fi
  gate_diff_id="$patch"
}

gate_diff_comparison() {
  local gated_sha="$1" head_sha="$2" gated_patch head_patch
  gate_diff_error=""
  gate_diff_patch_id "$gated_sha" gated || return 2
  gated_patch="$gate_diff_id"
  gate_diff_patch_id "$head_sha" head || return 2
  head_patch="$gate_diff_id"
  if [ "$gated_patch" != "$head_patch" ]; then
    gate_diff_error="origin/main diff patch-id differs: gated sha=$gated_sha patch-id=$gated_patch; head sha=$head_sha patch-id=$head_patch"
    return 1
  fi
  return 0
}

# The journal is the source of truth for full-gate coverage. A stale journal
# PASS refuses even if the body line is absent; a current PASS replaces a
# missing or stale body line. A stale body line refuses only when no full PASS
# exists in the journal. Current-PASS body writes remain best effort.
last_pass="$(grep -o 'tkt-gate PASS head=[0-9a-fA-F]\{40\}$' "${state%.state}.journal" 2>/dev/null | tail -n 1 || true)"
last_pass_head="${last_pass#tkt-gate PASS head=}"
local_gate_cmd=""
if [ -n "$last_pass" ]; then
  plan_gate_args tkt
  if plan_path="$(tkt get plan 2>/dev/null)" && [ -n "$plan_path" ]; then
    local_gate_cmd="$("$bin_dir/plan-gate" ${plan_gate_argv[@]+"${plan_gate_argv[@]}"} "$plan_path" 2>/dev/null || true)"
  fi
fi
if [ -n "$last_pass" ] && [ "$last_pass_head" != "$pr_head" ]; then
  if ! gate_diff_comparison "$last_pass_head" "$pr_head"; then
    msg="tkt-ship: tkt-gate last passed at $last_pass_head but PR head is $pr_head; $gate_diff_error (gate: $local_gate_cmd)"
    printf '%s\n' "$msg" >&2
    emit "GATE-STALE gate=$last_pass_head head=$pr_head" 1 "$msg"
  fi
fi
if pr_body_text="$(gh pr view "$pr" --repo "$repo" --json body --jq '.body // ""' 2>/dev/null)"; then
  gate_line_sha="$(printf '%s\n' "$pr_body_text" | sed -n 's/^Local gate: pass at \([0-9a-fA-F]\{40\}\).*/\1/p' | head -n 1)"
  if [ -z "$last_pass" ] && [ -n "$gate_line_sha" ] && [ "$gate_line_sha" != "$pr_head" ]; then
    if ! gate_diff_comparison "$gate_line_sha" "$pr_head"; then
      gate_line_full="$(printf '%s\n' "$pr_body_text" | grep -m1 '^Local gate:' || true)"
      case "$gate_line_full" in
        *\(*\)) gate_line_cmd="${gate_line_full#*\(}"; gate_line_cmd="${gate_line_cmd%\)*}" ;;
        *) gate_line_cmd="" ;;
      esac
      msg="tkt-ship: Local gate sha $gate_line_sha is not PR head $pr_head; $gate_diff_error (gate: $gate_line_cmd)"
      printf '%s\n' "$msg" >&2
      emit "GATE-STALE gate=$gate_line_sha head=$pr_head" 1 "$msg"
    fi
  elif [ -n "$last_pass" ] && [ "$last_pass_head" = "$pr_head" ] \
    && [ "$gate_line_sha" != "$pr_head" ]; then
    gate_line="Local gate: pass at $last_pass_head ($local_gate_cmd)"
    attr="$(tkt get body_ends 2>/dev/null || true)"
    attr_mode="exact"
    if [ -z "${attr//[[:space:]]/}" ]; then
      attr="$(tkt list body_has 2>/dev/null | grep -i 'co-author' | head -n 1 || true)"
      attr_mode="prefix"
    fi
    new_body="$(tkt_local_gate_body_insert "$pr_body_text" "$gate_line" "$attr" "$attr_mode")"
    if tmp_body="$(mktemp "${TMPDIR:-/tmp}/tkt-ship-body.XXXXXX" 2>/dev/null)"; then
      if printf '%s\n' "$new_body" >"$tmp_body" \
        && gh pr edit "$pr" --repo "$repo" --body-file "$tmp_body" 2>/dev/null; then
        :
      else
        printf 'tkt-ship: warning: cannot update PR %s body; leaving it unchanged\n' "$pr" >&2
      fi
      rm -f "$tmp_body"
    else
      printf 'tkt-ship: warning: cannot update PR %s body; leaving it unchanged\n' "$pr" >&2
    fi
  fi
else
  printf 'tkt-ship: warning: cannot read PR %s body; skipping the Local gate check\n' "$pr" >&2
fi

args=("$pr" --repo "$repo" --reviewed "$reviewed" --worktree "$worktree")
# The check is opt-in: only a stored non-blank line asks ship-pr for it.
# A missing key or failed read counts as absent and never fails the ship.
if be="$(tkt get body_ends 2>/dev/null)"; then
  if [ -n "${be//[[:space:]]/}" ]; then
    args+=(--body-ends "$be")
  fi
fi
while IFS= read -r b; do
  [ -n "$b" ] || continue
  args+=(--body-has "$b")
done <<<"$(tkt list body_has 2>/dev/null || true)"
if mutant_job="$(tkt get mutant_job 2>/dev/null)" && [ -n "$mutant_job" ]; then
  args+=(--mutants-gate)
fi
if u="$(tkt get unverified 2>/dev/null)" && [ -n "$u" ]; then
  u="$(abspath "$u")" || {
    msg="tkt-ship: relative path does not exist as given: $u"
    printf '%s\n' "$msg" >&2
    emit "PRECONDITION relative=$u" 2 "$msg"
  }
  args+=(--unverified-fixes "$u")
fi
if nm="$(tkt get no_mutants_label 2>/dev/null)" && [ -n "$nm" ]; then
  args+=(--no-mutants-label "$nm")
fi
if [ "$(tkt get merge_gate 2>/dev/null || true)" = "gate" ]; then
  if ! plan_err="$(tkt require plan 2>&1)"; then
    printf '%s\n' "$plan_err" >&2
    emit "PRECONDITION missing=plan" 2 "$plan_err" "$(ship_repair_hint plan)"
  fi
  plan_gate_args tkt
  gate_cmd="$("$bin_dir/plan-gate" ${plan_gate_argv[@]+"${plan_gate_argv[@]}"} "$(tkt get plan)")" || emit "PRECONDITION gate=failed" 2 "plan-gate rejected $(tkt get plan)"
  e="$(tkt get env 2>/dev/null || true)"
  args+=(--gate "${e:+$e }$gate_cmd")
else
  # A CI-gated ship runs no local gate, but a Gate line that skips gate.script
  # still stops it: the plan's Gate line is checked on every read.
  plan_gate_args tkt
  if [ -n "${plan_gate_argv[*]+x}" ] && plan="$(tkt get plan 2>/dev/null)" && [ -n "$plan" ]; then
    "$bin_dir/plan-gate" "${plan_gate_argv[@]}" "$plan" >/dev/null || emit "PRECONDITION gate=failed" 2 "plan-gate rejected $plan"
  fi
  if merge_check="$(tkt get merge_check 2>/dev/null)" && [ -n "$merge_check" ]; then
    e="$(tkt get env 2>/dev/null || true)"
    args+=(--merge-check "${e:+$e }$merge_check")
  fi
fi

longest_wait=144000
longest_hours=$((longest_wait / 3600))
echo "tkt-ship: no shell timeout: waits are bounded at ${longest_wait} s (${longest_hours} h), worst case; a clean run takes minutes" >&2

if mkdir "$lockdir" 2>/dev/null; then
  locked=1
  printf '%s\n' "$$" >"$lockdir/pid"
else
  holder="$(cat "$lockdir/pid" 2>/dev/null || true)"
  [ -n "$holder" ] || holder="unknown"
  msg="tkt-ship: ship already running (pid $holder): $lockdir"
  printf '%s\n' "$msg" >&2
  # BUSY bypasses emit: the lock is held by someone else, so a journal
  # write (which takes the same lock) cannot succeed. Same stdout shape
  # as emit, without the journal.
  out="TKT tkt-ship BUSY holder=$holder log=$runlog
$msg"
  printf '%s\n' "$out" | tee -a "$runlog"
  exit 2
fi

# Digest the gh-ci failures section of the run log: per failed job its name,
# first failing-step line, panic lines flagged against origin/main...head, and
# mutant MISSED/TIMEOUT lines. Last line is SUMMARY with the verdict counts.
ci_digest() {
  local href difflist
  href="$(tkt get head 2>/dev/null || git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
  difflist=""
  [ -z "$href" ] || difflist="$(git -C "$worktree" diff --name-only "origin/main...$href" 2>/dev/null || true)"
  awk '/--- gh-ci failures ---/{f=1;next} f' "$runlog" | TKT_DIFF="$difflist" awk '
    BEGIN { n=split(ENVIRON["TKT_DIFF"], d, "\n"); for (i in d) ind[d[i]]=1 }
    /^=== / { sub(/^=== /, ""); nj++; step=0; print "job: " $0; next }
    /MISSED|TIMEOUT/ { nm++; print "mutant: " $0; next }
    /panicked at [^ :]+/ { p=$0; sub(/.*panicked at /, "", p); sub(/[: ].*/, "", p)
      flag="outside"; if (p in ind) { flag="in-diff"; ni++ }
      print "panic [" flag "]: " $0; next }
    !step && (/##\[error\]/ || /--- FAIL/ || /failing step:/) { step=1; print "step: " $0; next }
    END { if (!nj) print "gh-ci reported no failed jobs"
      printf "SUMMARY jobs=%d inside-diff=%d mutants=%d\n", nj+0, ni+0, nm+0 }'
}

slug="${repo//\//-}"
twelve="$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf '%s' "${stored_head:0:12}")"
[ -n "$twelve" ] || twelve="nohead"
attempt=0; rc=0; runlog=""
while [ "$attempt" -lt 4 ]; do
  attempt=$((attempt + 1))
  runlog="$run/$slug-$issue-tkt-ship-$twelve-$(date +%H%M%S).log"
  rc=0
  (cd "$run" && "$bin_dir/ship-pr" "${args[@]}") >"$runlog" 2>&1 || rc=$?
  if [ "$rc" -eq 124 ] && [ "$attempt" -lt 4 ]; then
    sleep 1
    continue
  fi
  break
done

if [ "$rc" -eq 0 ]; then
  sha="$(grep -m1 '^merged ' "$runlog" | awk '{print $2}' || true)"
  note=""
  if grep -q 'file the flake' "$runlog"; then
    note=" FLAKE-NOTE"
  fi
  emit "MERGED sha=${sha:-unknown}$note" 0
fi
if [ "$rc" -eq 124 ]; then
  emit "PENDING attempts=$attempt" 1
fi
case "$rc" in
  3) emit "CONFLICT" 1 "$(tail -n 20 "$runlog")" ;;
  4) emit "PATCH-CHANGED head=$(git -C "$worktree" rev-parse HEAD 2>/dev/null || printf unknown)" 1 "$(tail -n 20 "$runlog")" ;;
  5)
    family="$(sed -n 's/^ship-pr: refused //p' "$runlog" | tail -n 1)"
    case "$family" in BODY|LABEL|REVIEW|MUTANTS) ;; *) family=SHIP ;; esac
    if [ "$family" = BODY ]; then
      detail="$(grep -h 'missing body line' "$runlog" || tail -n 20 "$runlog")"
    else
      detail="$(tail -n 20 "$runlog")"
    fi
    emit "$family" 1 "$detail" ;;
  2) emit "PRECONDITION" 2 "$(tail -n 20 "$runlog")" ;;
  1) ;;
  *) emit "UNKNOWN rc=$rc" 3 "$(tail -n 20 "$runlog")" ;;
esac

if grep -Eq 'gh pr merge failed|merge status could not be confirmed' "$runlog"; then
  st="$(gh pr view "$pr" --repo "$repo" --json state --jq '.state' 2>/dev/null || true)"
  if [ "$st" = "MERGED" ]; then
    emit "MERGED" 0 "$(tail -n 20 "$runlog")"
  fi
  emit "MERGE-FAIL" 1 "$(tail -n 20 "$runlog")"
elif grep -Eq 'gate failed|fails the gate' "$runlog"; then
  emit "GATE-FAIL" 1 "$(tail -n 20 "$runlog")"
else
  printf '\n--- gh-ci failures ---\n' >>"$runlog"
  (cd "$worktree" && GH_CI_LOG_LINES=300 "$bin_dir/gh-ci" failures --pr "$pr" --repo "$repo" >>"$runlog" 2>&1) || true
  digest="$(ci_digest)"
  never_started="$(grep -h 'never started' "$runlog" | head -n 10 || true)"
  if [ -n "$never_started" ]; then
    summary="$(tail -n 1 <<<"$digest")"
    details="$(printf '%s\n' "$digest" | sed '$d' | grep -Fvx 'gh-ci reported no failed jobs' || true)"
    if [ -n "$details" ]; then
      digest="${details}
${never_started}
${summary}"
    else
      digest="${never_started}
${summary}"
    fi
  fi
  emit "CI-FAIL $(tail -n 1 <<<"$digest" | sed 's/^SUMMARY //')" 1 "$(sed '$d' <<<"$digest")"
fi
