#!/usr/bin/env bash
# tkt-ship: run ship-pr from state, rerun on 124, digest red CI.
# Usage: tkt-ship <state>
set -euo pipefail

usage() { echo "usage: tkt-ship <state>" >&2; exit 2; }
[ $# -eq 1 ] || usage
state="$1"
script_dir="$(cd "$(dirname "$0")" && pwd)"
tkt_state="$script_dir/tkt-state"
bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
tkt() { "$tkt_state" "$state" "$@"; }

tkt require repo issue pr reviewed worktree run
repo="$(tkt get repo)"
issue="$(tkt get issue)"
pr="$(tkt get pr)"
reviewed="$(tkt get reviewed)"
worktree="$(tkt get worktree)"
run="$(tkt get run)"
mkdir -p "$run"

stored_head="$(tkt get head 2>/dev/null || true)"
if [ -n "$stored_head" ]; then
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || { echo "tkt-ship: cannot read worktree HEAD: $worktree" >&2; exit 2; }
  if [ "$stored_head" != "$actual" ]; then
    echo "tkt-ship: head drift: state head=$stored_head worktree $worktree HEAD=$actual" >&2
    exit 3
  fi
fi

args=("$pr" --repo "$repo" --reviewed "$reviewed" --worktree "$worktree")
while IFS= read -r b; do
  [ -n "$b" ] || continue
  args+=(--body-has "$b")
done <<<"$(tkt list body_has 2>/dev/null || true)"
if u="$(tkt get unverified 2>/dev/null)" && [ -n "$u" ]; then
  args+=(--unverified-fixes "$u")
fi
if [ "$(tkt get merge_gate 2>/dev/null || true)" = "gate" ]; then
  tkt require plan
  gate_cmd="$("$bin_dir/plan-gate" "$(tkt get plan)")" || exit 2
  e="$(tkt get env 2>/dev/null || true)"
  args+=(--gate "${e:+$e }$gate_cmd")
fi

# Verdict on line 1 plus at most 40 digest lines, to stdout and the run log.
emit() {
  local verdict="$1" code="$2" out
  shift 2
  out="TKT tkt-ship $verdict log=$runlog"
  if [ $# -gt 0 ]; then
    out="$out
$(printf '%s\n' "$@" | head -n 40)"
  fi
  printf '%s\n' "$out" | tee -a "$runlog"
  tkt journal "tkt-ship $verdict"
  exit "$code"
}

# Digest the gh-ci failures section of the run log: per failed job its name,
# first failing-step line, panic lines flagged against origin/main...head, and
# mutant MISSED/TIMEOUT lines. Last line is SUMMARY with the verdict counts.
ci_digest() {
  local href difflist
  href="$(tkt get head 2>/dev/null || git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
  difflist=""
  [ -z "$href" ] || difflist="$(git -C "$worktree" diff --name-only "origin/main...$href" 2>/dev/null || true)"
  awk '/--- gh-ci failures ---/{f=1;next} f' "$runlog" | awk -v diff="$difflist" '
    BEGIN { n=split(diff, d, "\n"); for (i in d) ind[d[i]]=1 }
    /^=== / { sub(/^=== /, ""); nj++; step=0; print "job: " $0; next }
    /MISSED|TIMEOUT/ { nm++; print "mutant: " $0; next }
    /panicked at [^ :]+/ { p=$0; sub(/.*panicked at /, "", p); sub(/[: ].*/, "", p)
      flag="outside"; if (p in ind) { flag="in-diff"; ni++ }
      print "panic [" flag "]: " $0; next }
    !step && (/##\[error\]/ || /--- FAIL/ || /failing step:/) { step=1; print "step: " $0; next }
    END { if (!nj) print "gh-ci reported no failed jobs"
      printf "SUMMARY jobs=%d inside-diff=%d mutants=%d\n", nj+0, ni+0, nm+0 }'
}

slug="${repo//\//-}"
twelve="$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf '%s' "${stored_head:0:12}")"
[ -n "$twelve" ] || twelve="nohead"
attempt=0; rc=0; runlog=""
while [ "$attempt" -lt 4 ]; do
  attempt=$((attempt + 1))
  runlog="$run/$slug-$issue-tkt-ship-$twelve-$(date +%H%M%S).log"
  rc=0
  "$bin_dir/ship-pr" "${args[@]}" >"$runlog" 2>&1 || rc=$?
  if [ "$rc" -eq 124 ] && [ "$attempt" -lt 4 ]; then
    sleep 1
    continue
  fi
  break
done

if [ "$rc" -eq 0 ]; then
  sha="$(grep -m1 '^merged ' "$runlog" | awk '{print $2}' || true)"
  note=""
  if grep -q 'file the flake' "$runlog"; then
    note=" FLAKE-NOTE"
  fi
  emit "MERGED sha=${sha:-unknown}$note" 0
fi
if [ "$rc" -eq 124 ]; then
  emit "PENDING attempts=$attempt" 1
fi
case "$rc" in
  3) emit "CONFLICT" 1 "$(tail -n 20 "$runlog")" ;;
  4) emit "PATCH-CHANGED head=$(git -C "$worktree" rev-parse HEAD 2>/dev/null || printf unknown)" 1 "$(tail -n 20 "$runlog")" ;;
  5) emit "BODY" 1 "$(grep -h 'missing body line' "$runlog" || tail -n 20 "$runlog")" ;;
  2) emit "PRECONDITION" 2 "$(tail -n 20 "$runlog")" ;;
  1) ;;
  *) emit "UNKNOWN rc=$rc" 3 "$(tail -n 20 "$runlog")" ;;
esac

if grep -Eq 'gh pr merge failed|merge status could not be confirmed' "$runlog"; then
  st="$(gh pr view "$pr" --repo "$repo" --json state --jq '.state' 2>/dev/null || true)"
  if [ "$st" = "MERGED" ]; then
    emit "MERGED" 0 "$(tail -n 20 "$runlog")"
  fi
  emit "MERGE-FAIL" 1 "$(tail -n 20 "$runlog")"
elif grep -Eq 'gate failed|fails the gate' "$runlog"; then
  emit "GATE-FAIL" 1 "$(tail -n 20 "$runlog")"
else
  printf '\n--- gh-ci failures ---\n' >>"$runlog"
  GH_CI_LOG_LINES=300 "$bin_dir/gh-ci" failures --pr "$pr" >>"$runlog" 2>&1 || true
  digest="$(ci_digest)"
  emit "CI-FAIL $(tail -n 1 <<<"$digest" | sed 's/^SUMMARY //')" 1 "$(sed '$d' <<<"$digest")"
fi
