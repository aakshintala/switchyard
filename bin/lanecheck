#!/bin/bash
# lanecheck — which lanes in run/roster are no longer live sessions.
#
#   bash bin/lanecheck            # print LIVE/MISSING per roster entry, exit 1 if any MISSING
#   bash bin/lanecheck done 3890  # retire ticket 3890's roster entries (it reported)
#   bash bin/lanecheck done 3954:fiber-3954-plan   # retire one session only
#
# Retire by ticket when the whole ticket is finished. Retire by
# <ticket>:<session> when one of a ticket's sessions has finished and another
# is still live: a plan session that has reported while its build session runs
# otherwise prints MISSING on every run and cannot be silenced without also
# silencing the live lane, which is how MISSING stops meaning anything
# (2026-11-03: 15 MISSING lines, most of them finished plan sessions).
#
# Retiring is not permanent. A roster entry launched after its retirement line
# is a relaunch and is checked again, so parking a blocked ticket here does not
# hide the lane that later picks it up under the same session name.
#
# Liveness comes from `claude agents --json` on each host, not from the lane
# writing anything: a lane waiting on a background job is alive and silent for
# long stretches, so a lane-written heartbeat flags healthy lanes as dead.
set -u
script_path=$0
while [ -L "$script_path" ]; do
  script_dir=$(cd "$(dirname "$script_path")" && pwd)
  link=$(readlink "$script_path")
  case "$link" in /*) script_path=$link;; *) script_path=$script_dir/$link;; esac
done
script_dir=$(cd "$(dirname "$script_path")" && pwd)
check_delegate_build() {
  local delegate_bin=${FW_DELEGATE:-$HOME/.local/bin/delegate} output warning
  [ -x "$delegate_bin" ] || return 0
  if output=$("$delegate_bin" version 2>/dev/null); then
    warning=$(printf '%s\n' "$output" | grep '^warn  delegate binary is stale:' || true)
    [ -z "$warning" ] || printf '%s\n' "$warning"
  fi
}
check_delegate_build
run_claude_agents() {
  local json_file="$1" err_file="$2" status
  shift 2
  if bash "$script_dir/claude-agents-timeout" "${FW_CLAUDE_AGENTS_TIMEOUT:-30}" "$@" </dev/null >"$json_file" 2>"$err_file"; then
    return 0
  else
    status=$?
  fi
  : >"$json_file"
  if [ "$status" -ne 124 ] && [ ! -s "$err_file" ]; then
    printf 'claude agents exited with status %s\n' "$status" >"$err_file"
  fi
  return "$status"
}
R=${FW_RUN:-${RUN_DIR:-$HOME/work/fiber-worktrees/flywheel/run}}
BOX=${FW_BOX_HOST:-roundhouse-7010-plus-1.local}
FW_LOCAL_BOX=${FW_LOCAL_BOX:-}
if [ -z "$FW_LOCAL_BOX" ]; then
  FW_LOCAL_BOX=0
  if [ -z "${BOX_SSH:-${FW_SSH:-}}" ] && [ "$(uname -s)" != Darwin ]; then FW_LOCAL_BOX=1; fi
fi
roster="$R/roster"
retired="$R/roster-done"

write_retirement_helper() {
  cat >"$1" <<'PY'
def read_retirements(path):
    done = {}
    done_sess = {}
    for line in open(path):
        p = [x.strip() for x in line.split("\t")]
        if len(p) > 2 and p[2]:
            key = (p[1], p[2])
            done_sess[key] = max(p[0], done_sess.get(key, ""))
        elif len(p) > 1:
            done[p[1]] = max(p[0], done.get(p[1], ""))
    return done, done_sess


def entry_is_retired(ticket, sess, jid, ts, done, done_sess):
    cut = done.get(ticket, "")
    for (done_ticket, key), done_at in done_sess.items():
        if done_ticket == ticket and (key == sess or key == jid or
                (jid not in ("", "?") and (jid.startswith(key) or key.startswith(jid)))):
            cut = max(cut, done_at)
    return bool(cut and ts.split()[0] <= cut)
PY
}

already_retired_targets() {
  [ -f "$roster" ] && [ -f "$retired" ] || return 1
  local check_tmp result
  check_tmp=$(mktemp -d "${TMPDIR:-/tmp}/lanecheck-done-check.XXXXXX") || return 1
  write_retirement_helper "$check_tmp/roster-retirement.py"
  result=$(python3 -I - "$roster" "$retired" "$check_tmp/roster-retirement.py" "$@" <<'PY'
import sys
roster, retired, helper, *requested = sys.argv[1:]
exec(compile(open(helper).read(), helper, "exec"), globals())
done, done_sess = read_retirements(retired)
rows = []
for line in open(roster):
    fields = line.rstrip("\n").split("\t")
    if len(fields) < 4:
        continue
    ts, ticket, host, name = fields[:4]
    jid = fields[4] if len(fields) > 4 else "?"
    rows.append((ticket, name, jid, ts))
selected = []
for arg in requested:
    target, sep, key = arg.partition(":")
    matches = [row for row in rows if row[0] == target and
               (not sep or key == row[1] or key == row[2] or
                (row[2] not in ("", "?") and
                 (row[2].startswith(key) or key.startswith(row[2]))))]
    if not matches:
        raise SystemExit(1)
    selected.extend(matches)
if not selected or not all(entry_is_retired(ticket, name, jid, ts, done, done_sess)
                           for ticket, name, jid, ts in selected):
    raise SystemExit(1)
targets = sorted({f"#{ticket}:{name}" for ticket, name, _, _ in selected})
print("already retired: " + ", ".join(targets))
PY
  ) || { rm -rf "$check_tmp"; return 1; }
  rm -rf "$check_tmp"
  [ -n "$result" ] || return 1
  printf '%s\n' "$result"
}

stop_retired_sessions() {
  _lanecheck_done_tmp=$(mktemp -d "${TMPDIR:-/tmp}/lanecheck-done.XXXXXX") || return 2
  trap 'rm -rf "$_lanecheck_done_tmp"' EXIT
  local done_tmp=$_lanecheck_done_tmp targets need_box need_muse need_mac h sess jid
  if ! targets=$(python3 -I - "$roster" "$@" <<'PY'
import sys
roster, *requested = sys.argv[1:]
selected = set()
for line in open(roster):
    fields = line.rstrip("\n").split("\t")
    if len(fields) < 4:
        continue
    _, ticket, host, name = fields[:4]
    sid = fields[4] if len(fields) > 4 else "?"
    for arg in requested:
        target, sep, key = arg.partition(":")
        if ticket != target:
            continue
        if not sep or key == name or key == sid or (sid not in ("", "?") and
                (sid.startswith(key) or key.startswith(sid))):
            selected.add((host, name, sid))
for row in sorted(selected):
    print("\t".join(row))
PY
); then
    echo "cannot resolve lanecheck done arguments against $roster" >&2
    return 2
  fi
  printf '%s\n' "$targets" >"$done_tmp/targets.tsv"
  printf '[]\n' >"$done_tmp/box-claude.json"
  printf '[]\n' >"$done_tmp/mac-claude.json"
  printf '{"sessions":[]}\n' >"$done_tmp/box-delegate.json"
  printf '{"sessions":[]}\n' >"$done_tmp/mac-delegate.json"
  need_box=0; need_muse=0; need_mac=0
  while IFS=$'\t' read -r h sess jid; do
    [ -n "$h" ] || continue
    case "$h" in
      box) need_box=1;;
      muse) need_muse=1;;
      mac) need_mac=1;;
      *) echo "cannot stop lane on unknown roster host '$h'" >&2; return 2;;
    esac
  done <"$done_tmp/targets.tsv"
  if [ "$need_box" = 1 ] || [ "$need_muse" = 1 ]; then
    if [ "$FW_LOCAL_BOX" = 1 ]; then
      done_boxssh=${FW_BOX_LOCAL:-$script_dir/box-local.sh}
    else
      done_boxssh=${BOX_SSH:-${FW_SSH:-ssh}}
    fi
  fi
  if [ "$need_box" = 1 ]; then
    if ! run_claude_agents "$done_tmp/box-claude.json" "$done_tmp/box-claude.err" \
        "$done_boxssh" -o BatchMode=yes "$BOX" 'claude agents --json'; then
      echo "cannot check Box Claude sessions; no lane retired" >&2
      return 2
    fi
  fi
  if [ "$need_muse" = 1 ]; then
    if ! "$done_boxssh" -o BatchMode=yes "$BOX" 'delegate session list --json' </dev/null >"$done_tmp/box-delegate.json" 2>"$done_tmp/box-delegate.err"; then
      echo "cannot check Box delegate sessions; no lane retired" >&2
      return 2
    fi
  fi
  if [ "$need_mac" = 1 ]; then
    if ! run_claude_agents "$done_tmp/mac-claude.json" "$done_tmp/mac-claude.err" \
        claude agents --json; then
      echo "cannot check Mac Claude sessions; no lane retired" >&2
      return 2
    fi
    if ! "${FW_DELEGATE:-$HOME/.local/bin/delegate}" session list --json >"$done_tmp/mac-delegate.json" 2>"$done_tmp/mac-delegate.err"; then
      echo "cannot check Mac delegate sessions; no lane retired" >&2
      return 2
    fi
  fi
  cat >"$done_tmp/plan.py" <<'PY'
import json, re, sys

targets, boxc, mac_c, boxd, mac_d = sys.argv[1:]
def load(path):
    try:
        data = json.load(open(path))
    except Exception as exc:
        raise SystemExit(f"cannot parse session list {path}: {exc}")
    return data if isinstance(data, list) else data.get("agents") or data.get("sessions") or []

box_claude, mac_claude = load(boxc), load(mac_c)
box_delegate, mac_delegate = load(boxd), load(mac_d)
ops, refusals = set(), []

def claude_rows(rows, name):
    return [r for r in rows if isinstance(r, dict) and r.get("name") == name]

def delegate_rows(rows, sid):
    if sid in ("", "?"):
        return []
    return [r for r in rows if isinstance(r, dict) and r.get("id") and
            (r["id"] == sid or r["id"].startswith(sid) or sid.startswith(r["id"]))]

for line in open(targets):
    if not line.strip():
        continue
    host, name, sid = line.rstrip("\n").split("\t")
    if host == "box":
        kind, rows = "claude", claude_rows(box_claude, name)
    elif host == "muse":
        kind, rows = "delegate", delegate_rows(box_delegate, sid)
    else:
        rows = claude_rows(mac_claude, name)
        kind = "claude"
        if not rows:
            kind, rows = "delegate", delegate_rows(mac_delegate, sid)
    if kind == "delegate" and len(rows) > 1:
        refusals.append(f"{name}: delegate session id {sid} is ambiguous")
        continue
    if not rows:
        # The session is already absent from its host's live-session list.
        continue
    for row in rows:
        if kind == "claude":
            session_id = row.get("id") or row.get("sessionId") or ""
            status = row.get("status")
            if status is None:
                refusals.append(f"{name}: Claude status unavailable (id {session_id or '?'})")
            elif status == "busy":
                refusals.append(f"{name}: Claude session {session_id or '?'} is mid-turn")
        else:
            session_id = row.get("id") or ""
            if row.get("status") == "dead":
                continue
            if "activeTurnId" not in row:
                refusals.append(f"{name}: delegate activeTurnId unavailable (id {session_id or '?'})")
            elif row.get("activeTurnId") is not None:
                refusals.append(f"{name}: delegate session {session_id or '?'} is mid-turn")
        if not session_id or not re.fullmatch(r"[A-Za-z0-9_-]+", str(session_id)):
            refusals.append(f"{name}: no safe stop id")
        elif kind == "claude":
            ops.add(("claude", host, str(session_id), name))
        else:
            ops.add(("delegate", "box" if host == "muse" else host, str(session_id), name))
if refusals:
    for refusal in sorted(set(refusals)):
        print(f"REFUSING to retire — {refusal}")
    raise SystemExit(2)
for op in sorted(ops):
    print("\t".join(op))
PY
  if ! plan=$(python3 -I "$done_tmp/plan.py" "$done_tmp/targets.tsv" \
      "$done_tmp/box-claude.json" "$done_tmp/mac-claude.json" \
      "$done_tmp/box-delegate.json" "$done_tmp/mac-delegate.json" 2>&1); then
    printf '%s\n' "$plan" >&2
    return 2
  fi
  while IFS=$'\t' read -r kind host sid name; do
    [ -n "$kind" ] || continue
    case "$kind:$host" in
      claude:box)
        if ! stop_out=$("$done_boxssh" -o BatchMode=yes "$BOX" "claude stop $sid" </dev/null 2>&1); then
          echo "could not stop Box Claude session $sid ($name); no lane retired" >&2
          printf '%s\n' "$stop_out" | sed 's/^/  /' >&2
          return 2
        fi;;
      claude:mac)
        if ! stop_out=$(claude stop "$sid" 2>&1); then
          echo "could not stop Mac Claude session $sid ($name); no lane retired" >&2
          printf '%s\n' "$stop_out" | sed 's/^/  /' >&2
          return 2
        fi;;
      delegate:box)
        if ! stop_out=$("$done_boxssh" -o BatchMode=yes "$BOX" \
            "PATH=\$HOME/.local/bin:\$PATH delegate session stop $sid" </dev/null 2>&1); then
          echo "could not stop Box delegate session $sid ($name); no lane retired" >&2
          printf '%s\n' "$stop_out" | sed 's/^/  /' >&2
          return 2
        fi;;
      delegate:mac)
        if ! stop_out=$("${FW_DELEGATE:-$HOME/.local/bin/delegate}" session stop "$sid" 2>&1); then
          echo "could not stop Mac delegate session $sid ($name); no lane retired" >&2
          printf '%s\n' "$stop_out" | sed 's/^/  /' >&2
          return 2
        fi;;
      *) echo "cannot stop $kind session on $host" >&2; return 2;;
    esac
    echo "stopped retired session $sid ($name)"
  done <<<"$plan"
}

retire_pi_pidfiles() (
  local pi_tmp action n pi_args boxssh box_run_arg pi_command output_file error_file
  local -a pi_tickets=()
  pi_tmp=$(mktemp -d "${TMPDIR:-/tmp}/lanecheck-pi-done.XXXXXX") || return 2
  trap 'rm -rf "$pi_tmp"' EXIT
  for n in "$@"; do
    case "$n" in *:*) continue;; esac
    case "$n" in ""|*[!0-9]*) continue;; esac
    pi_tickets+=("$n")
  done
  [ "${#pi_tickets[@]}" -gt 0 ] || return 0

  cat >"$pi_tmp/retire.py" <<'PY'
import os, sys

mode, host, *tickets = sys.argv[1:]
run = (os.environ.get("FW_RUN") or os.environ.get("FW_BOX_RUN") or
       os.path.expanduser("~/work/fiber-worktrees/flywheel/run"))
done = os.path.join(run, "done")
failed = False
for ticket in tickets:
    name = f"fiber-{ticket}-pi.pid"
    path = os.path.join(run, name)
    if not os.path.isfile(path):
        continue
    pid_text = "?"
    try:
        pid_text = open(path).read().strip()
        if not pid_text.isdigit() or int(pid_text) <= 0:
            raise ValueError("invalid pid")
        os.kill(int(pid_text), 0)
        alive = True
    except PermissionError:
        alive = True
    except (OSError, ValueError):
        alive = False
    if alive:
        print(f"REFUSING to retire {host} pidfile {name} — pid {pid_text} is alive")
        failed = True
        continue
    if mode == "move":
        try:
            os.makedirs(done, exist_ok=True)
            os.replace(path, os.path.join(done, name))
        except OSError as exc:
            print(f"cannot move {host} PI pidfile {name}: {exc}")
            failed = True
        else:
            print(f"moved PI pidfile ({host}): {name}")
if mode not in ("check", "move"):
    raise SystemExit(f"unknown pidfile action: {mode}")
raise SystemExit(2 if failed else 0)
PY
  if [ "$FW_LOCAL_BOX" = 1 ]; then
    boxssh=${FW_BOX_LOCAL:-$script_dir/box-local.sh}
  else
    boxssh=${BOX_SSH:-${FW_SSH:-ssh}}
  fi
  pi_args=""
  for n in "${pi_tickets[@]}"; do
    printf -v _pi_ticket_arg '%q' "$n"
    pi_args="$pi_args $_pi_ticket_arg"
  done
  for action in check move; do
    output_file="$pi_tmp/mac-$action.out"
    error_file="$pi_tmp/mac-$action.err"
    if ! FW_RUN="$R" python3 -I "$pi_tmp/retire.py" "$action" PI-MAC "${pi_tickets[@]}" \
        >"$output_file" 2>"$error_file"; then
      echo "cannot $action Mac PI pidfiles; no lane retired" >&2
      sed 's/^/  /' "$output_file" "$error_file" >&2
      return 2
    fi
    cat "$output_file"
    if [ -n "${FW_BOX_RUN:-}" ]; then
      printf -v box_run_arg '%q' "$FW_BOX_RUN"
      pi_command="FW_RUN=$box_run_arg python3 -I - $action PI-BOX$pi_args"
    else
      pi_command="env -u FW_RUN -u RUN_DIR python3 -I - $action PI-BOX$pi_args"
    fi
    output_file="$pi_tmp/box-$action.out"
    error_file="$pi_tmp/box-$action.err"
    if ! "$boxssh" -o BatchMode=yes -o ConnectTimeout=10 "$BOX" "$pi_command" \
        <"$pi_tmp/retire.py" >"$output_file" 2>"$error_file"; then
      echo "cannot $action Box PI pidfiles; no lane retired" >&2
      sed 's/^/  /' "$output_file" "$error_file" >&2
      return 2
    fi
    cat "$output_file"
  done
)

if [ "${1:-}" = done ]; then
  shift
  done_args=()
  have_done_arg=0
  handed_card=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --handed-to-owner)
        [ $# -ge 2 ] || { echo "usage: lanecheck done <ticket>[:<session-name-or-id>] [...] [--handed-to-owner <card-id>]" >&2; exit 2; }
        [ -z "$handed_card" ] || { echo "lanecheck done: --handed-to-owner may be used once" >&2; exit 2; }
        handed_card="$2"
        shift 2
        ;;
      *) done_args+=("$1"); have_done_arg=1; shift ;;
    esac
  done
  [ "$have_done_arg" = 1 ] || { echo "usage: lanecheck done <ticket>[:<session-name-or-id>] [...] [--handed-to-owner <card-id>]" >&2; exit 2; }
  set -- "${done_args[@]}"
  if already_retired_targets "$@"; then
    exit 0
  fi
  if [ -n "$handed_card" ]; then
    if [ "${FW_OWNER_ASK+x}" = x ]; then
      echo "REFUSING --handed-to-owner: FW_OWNER_ASK is not honoured for --handed-to-owner" >&2
      exit 2
    fi
    case "$handed_card" in ""|*[!A-Za-z0-9_-]*) echo "lanecheck done: invalid owner-ask card id: $handed_card" >&2; exit 2 ;; esac
    if [ ! -f "$HOME/.local/bin/owner-ask" ] || [ ! -x "$HOME/.local/bin/owner-ask" ]; then
      echo "REFUSING --handed-to-owner: owner-ask not found at $HOME/.local/bin/owner-ask; --handed-to-owner needs the Mac's owner-ask" >&2
      exit 2
    fi
    owner_ask_list_rc=0
    owner_ask_list=$("$HOME/.local/bin/owner-ask" list 2>/dev/null) || owner_ask_list_rc=$?
    owner_ask_open=0
    if [ "$owner_ask_list_rc" -eq 0 ] && printf '%s\n' "$owner_ask_list" | awk -v id="$handed_card" '$1 == id { found=1 } END { exit !found }'; then
      owner_ask_open=1
      owner_ask_text=$(python3 -I - "$HOME/.local/bin/owner-ask" "$handed_card" <<'PY'
import json, os, sys
path, card_id = sys.argv[1:]
try:
    real_owner_ask = os.path.realpath(path)
    cards = os.path.join(os.path.dirname(real_owner_ask), "cards")
    card = json.load(open(os.path.join(cards, card_id + ".json")))
    if card.get("id") != card_id:
        raise ValueError("card id mismatch")
    print(str(card.get("title", "")) + "\n" + str(card.get("context", "")))
except Exception:
    sys.exit(1)
PY
      )
      owner_ask_text_rc=$?
    else
      owner_ask_text_rc=1
    fi
  fi
  # Retiring a ticket whose lane was launched minutes ago is always a mistake, never an intent, and because retirement is time-ordered it hides that live lane from every later check. On 2026-11-03 `lanecheck done 3857 3975` ran ten minutes after fiber-3975-build was launched and dropped it from the roster view: 14 LIVE instead of 16, with no 3975 row and no warning. Refuse instead.
  # FW_DONE_MIN seconds (default 1800) is the floor; FW_DONE_FORCE=1 overrides it
  # for the real case of a lane that started and died inside the window.
  young=0
  # One open-PR list for every ticket being retired, matched by head branch.
  # The body search this replaced matched any pull request whose body merely
  # mentioned the number: on 2026-11-04 retiring 4042 was refused by PR #4116
  # (head `feat/3890-keeper-shell-path`), whose only mention of 4042 is a doc
  # paragraph saying another ticket owns a passage. A false refusal teaches the
  # operator to reach for FW_DONE_FORCE by reflex, which disarms the guard for
  # the #4125 case it exists for. A lane's own pull request is the one on this
  # ticket's branch, by mkbrief's `<area>/<n>-<slug>` convention.
  _prs_ok=0
  if _prs=$(gh pr list --repo aakshintala/fiber --state open --limit 200 --json number,headRefName --jq '.[] | "\(.number) \(.headRefName)"' 2>/dev/null); then
    _prs_ok=1
  fi
  _merged_prs=""
  _merged_prs_ok=0
  _merged_prs_loaded=0
  handed_tickets=()
  handed_prs=()
  handoff_problem_for() {
    local open_pr="$1" handoff_ok p
    handoff_problem=""
    if [ "$owner_ask_list_rc" -ne 0 ]; then
      handoff_problem="owner-ask list failed for card $handed_card"
    elif [ "$owner_ask_open" != 1 ]; then
      handoff_problem="card $handed_card is not open"
    elif [ "$_prs_ok" != 1 ]; then
      handoff_problem="open-PR lookup failed, so the PR cannot be verified"
    elif [ -z "$open_pr" ]; then
      handoff_problem="no open PR for lane #$tn to hand to the owner"
    elif [ "$owner_ask_text_rc" -ne 0 ]; then
      handoff_problem="card $handed_card title/body could not be read"
    else
      handoff_match=$(python3 -I -c 'import re,sys
text, ticket, prs = sys.argv[1:]
if re.search(r"(?<![A-Za-z0-9_])#" + re.escape(ticket) + r"(?![0-9])", text):
    print("ticket")
else:
    print(" ".join(pr for pr in prs.split() if re.search(r"\bPR\s+#" + re.escape(pr) + r"(?![0-9])", text)))' \
        "$owner_ask_text" "$tn" "$open_pr")
      if [ "$handoff_match" != ticket ]; then
        handoff_ok=1
        for p in $open_pr; do
          case " $handoff_match " in *" $p "*) ;; *) handoff_ok=0 ;; esac
        done
        if [ "$handoff_ok" = 0 ]; then handoff_problem="card $handed_card title/body does not name open PR(s) $(printf '%s ' $open_pr)or ticket #$tn"; fi
      fi
    fi
  }
  handoff_pr_for() {
    local wanted_ticket="$1" i
    for i in "${!handed_tickets[@]}"; do
      if [ "${handed_tickets[$i]}" = "$wanted_ticket" ]; then
        printf '%s' "${handed_prs[$i]}"
        return 0
      fi
    done
  }
  for n in "$@"; do
    tn=${n%%:*}
    # A session-scoped retirement asks about that session only. Reading the
    # ticket's newest entry instead refuses the very case this form exists for:
    # a plan session that has reported while the build session it handed off to
    # was launched seconds ago (2026-11-03, #4097). Scope the age check the same
    # way the retirement line is scoped.
    sn=""
    case "$n" in *:*) sn=${n#*:} ;; esac
    newest=$(awk -F'\t' -v t="$tn" -v s="$sn" '$2==t && (s=="" || $4==s){print $1}' "$roster" 2>/dev/null | sort | tail -1)
    [ -n "$newest" ] || continue
    if [ "$(uname -s)" = Darwin ]; then
      when=$(date -ju -f '%Y-%m-%dT%H:%M:%SZ' "$newest" +%s 2>/dev/null) || continue
    else
      when=$(date -u -d "$newest" +%s 2>/dev/null) || continue
    fi
    age=$(( $(date +%s) - when ))
    if [ "$age" -lt "${FW_DONE_MIN:-1800}" ]; then
      merged_pr=""
      if [ -n "$sn" ] && [ "${FW_DONE_FORCE:-0}" != 1 ]; then
        if [ "$_merged_prs_loaded" = 0 ]; then
          _merged_prs_loaded=1
          if _merged_prs=$(gh pr list --repo aakshintala/fiber --state merged --limit 200 --json number,headRefName,mergedAt 2>/dev/null); then
            _merged_prs_ok=1
          fi
        fi
        if [ "$_merged_prs_ok" = 1 ]; then
          state_branch=""
          for state_file in "$R"/*-"$tn".state "$R/fiber-$tn.state"; do
            [ -f "$state_file" ] || continue
            state_branch=$(sed -n 's/^branch=//p' "$state_file" | head -n 1)
            [ -z "$state_branch" ] || break
          done
          merged_pr=$(python3 -I -c 'import json,re,sys

ticket,newest,state_branch=sys.argv[1:]
try:
    prs=json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(prs,list):
    sys.exit(0)
valid=re.compile(r"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")
for pr in prs:
    if not isinstance(pr,dict):
        continue
    head=pr.get("headRefName")
    merged=pr.get("mergedAt")
    number=pr.get("number")
    if not isinstance(head,str) or not isinstance(merged,str) or not valid.fullmatch(merged) or merged <= newest:
        continue
    if head == "fiber-" + ticket or head.startswith("fiber-" + ticket + "-") or (state_branch and head == state_branch):
        if isinstance(number,(int,str)):
            print(number)
            break' "$tn" "$newest" "$state_branch" <<<"$_merged_prs" 2>/dev/null) || merged_pr=""
        fi
      fi
      if [ -n "$merged_pr" ]; then
        echo "age guard skipped for $n — PR #$merged_pr merged"
      # Say which way it is going in the same line. Printing REFUSING and then
      # `retired:` two lines later, as this did under FW_DONE_FORCE=1, leaves a
      # log a later reader cannot tell apart from a refusal that held.
      # Name the argument, not the ticket: this guard is session-scoped when the
      # argument is, and printing `4275` for `4275:prep-4275` on 2026-11-06 read
      # as the ticket being held when only its finished prep session was young.
      elif [ "${FW_DONE_FORCE:-0}" = 1 ]; then
        echo "FORCING retire of $n — newest roster entry is ${age}s old ($newest), under ${FW_DONE_MIN:-1800}s; FW_DONE_FORCE=1 overrides." >&2
        young=1
      else
        echo "REFUSING to retire $n — its newest roster entry is ${age}s old ($newest), under ${FW_DONE_MIN:-1800}s." >&2
        young=1
      fi
    fi
    # A lane's last step is the ship, not the green PR: bin/lib/template-tkt.md:110 has
    # it run ship-pr as soon as its gate passes. Retiring on "PR green and
    # reviewed" takes the slot back one step early and leaves the merge to
    # whoever notices, which is how #4125 sat unmerged from 23:47Z (this ticket
    # retired at roster-done:60 with no fiber-4084-ship log anywhere) until the
    # owner asked why the flywheel was shipping instead of the lane.
    # Fails open on a gh error: a network blip must not wedge retirement, but
    # the line says the guard did not run so the log cannot be misread.
    if [ "$_prs_ok" = 1 ]; then
      open_pr=$(printf '%s\n' "$_prs" | awk -v t="$tn" '$2 ~ ("^[^/]+/" t "-") || $2 ~ ("^" t "-") { print $1 }')
    else
      open_pr=""
    fi
    if [ -n "$handed_card" ] && [ "${FW_DONE_FORCE:-0}" != 1 ]; then
      handoff_problem_for "$open_pr"
      if [ -n "$handoff_problem" ]; then
        echo "REFUSING to retire $n — handed-to-owner check failed: $handoff_problem." >&2
        young=1
      elif [ -n "$open_pr" ]; then
        handoff_pr=$(printf '%s\n' "$open_pr" | head -1)
        handed_tickets+=("$tn")
        handed_prs+=("$handoff_pr")
      fi
    elif [ "$_prs_ok" = 1 ]; then
      if [ -n "$open_pr" ]; then
        if [ "${FW_DONE_FORCE:-0}" = 1 ]; then
          echo "FORCING retire of $tn — PR(s) $(echo "$open_pr" | tr '\n' ' ')still open and unmerged; FW_DONE_FORCE=1 overrides." >&2
        else
          echo "REFUSING to retire $tn — PR(s) $(echo "$open_pr" | tr '\n' ' ')still open and unmerged. The lane's last step is the ship; let it run ship-pr, or merge first." >&2
          young=1
        fi
      fi
    else
      echo "note: open-PR guard did not run for $tn (gh pr list failed); age guard only." >&2
    fi
  done
  if [ "$young" = 1 ] && [ "${FW_DONE_FORCE:-0}" != 1 ]; then
    # Two guards share this exit, so the summary stays cause-neutral: the
    # refusal line above names which one fired. Naming only the age cause here
    # told a reader the lane was young when its real sin was an unmerged PR.
    echo "Nothing retired — see the REFUSING line above for which guard fired. Check with 'bash bin/lanecheck' first. Override with FW_DONE_FORCE=1." >&2
    exit 2
  fi
  retire_pi_pidfiles "$@" || exit $?
  stop_retired_sessions "$@" || exit $?
  retirement_helper=$_lanecheck_done_tmp/roster-retirement.py
  write_retirement_helper "$retirement_helper"
  for n in "$@"; do
    tn=${n%%:*}
    handoff_pr=$(handoff_pr_for "$tn")
    case "$n" in
      *:*) retire_line="$(printf '%s\t%s\t%s' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tn" "${n#*:}")" ;;
      *)   retire_line="$(printf '%s\t%s' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$tn")" ;;
    esac
    if [ -n "$handoff_pr" ]; then
      if [[ "$n" == *:* ]]; then retire_line="$retire_line$(printf '\t%s' "handed-to-owner $handed_card PR #$handoff_pr")"; else retire_line="$retire_line$(printf '\t\t%s' "handed-to-owner $handed_card PR #$handoff_pr")"; fi
    fi
    printf '%s\n' "$retire_line" >>"$retired"
  done
  retire_log="retired: $*"
  for i in "${!handed_tickets[@]}"; do
    retire_log="$retire_log handed-to-owner $handed_card PR #${handed_prs[$i]}"
  done
  echo "$retire_log"

  # Retire a ticket's fence grants once its LAST session retires. This is the
  # one place that knows a lane is finished, and it used to leave the grants in
  # run/, where fence-grant holds them for 360m with no live lane behind them.
  # On 2026-11-04 that blocked two dispatches in five minutes: #4111's grants
  # (PR #4146, merged) held panel_look.rs against #4089's build, and #4029's
  # (PR #4147, merged) held notices_tests.rs against #4161. fence-grant was
  # printing the right remedy both times; nothing was running it.
  #
  # Keyed on the ticket having no live session left, not on one session
  # retiring. The first cut keyed on the session and pulled the fences out from
  # under two running builds the same minute it shipped: retiring the finished
  # fiber-4089-plan and fiber-4152-plan rows dropped the grants that
  # fiber-4089-build and fiber-4152-build were working behind. A ticket runs
  # several sessions across its phases and the fence belongs to the ticket.
  for n in "$@"; do
    t=${n%%:*}
    live=$(python3 -I - "$roster" "$retired" "$t" "$retirement_helper" <<'PY'
import sys
roster, retired, ticket, helper = sys.argv[1:]
exec(compile(open(helper).read(), helper, "exec"), globals())
done, done_sess = read_retirements(retired)
entries = {}
for line in open(roster):
    f = line.rstrip("\n").split("\t")
    if len(f) >= 4 and f[1] == ticket:
        jid = f[4] if len(f) > 4 else "?"
        entries[f[3]] = (f[0], jid)
live = sum(
    not entry_is_retired(ticket, name, jid, ts, done, done_sess)
    for name, (ts, jid) in entries.items()
)
print(live)
PY
)
    if [ "${live:-1}" != 0 ]; then
      echo "fence kept for #$t: $live session(s) still live"
      continue
    fi
    handoff_pr=$(handoff_pr_for "$t")
    if [ -n "$handoff_pr" ]; then
      echo "fence kept for #$t: handed-to-owner $handed_card PR #$handoff_pr"
      continue
    fi
    for g in "$R"/fiber-"$t"-fence-grant-*.md; do
      [ -e "$g" ] || continue
      mv "$g" "$R/done/" && echo "fence retired: $(basename "$g")"
    done
    # Retiring the roster line and the grant records released nothing in
    # file-claim, so the claims outlived the lane: 17 of them across three
    # closed tickets on 2026-11-06, and `fence-grant` called every one HELD
    # because the holder's session was still resident (switchyard#1313). A
    # claim's liveness cannot be read off a process -- those sessions were
    # `idle` with live supervisor pids -- so the release has to happen where
    # the ticket ends, which is here.
    #
    # Release every holder shape this roster knows: the bare `fiber-<n>` the
    # claim is usually written under, plus each session name, since a lane
    # launched by phase claims as `fiber-<n>-plan` or `-build`. A holder named
    # by branch (`arch/4276-log-diag-leaf`) stays for switchyard#1272's
    # canonical holder id; it is reported, not hidden -- and the report now
    # names it exactly, see below.
    fc=${FW_FILE_CLAIM:-$HOME/.agents/bin/file-claim}
    holders=$(awk -F'\t' -v t="$t" '$2 == t && $4 != "" { print $4 }' "$roster" | sort -u)
    for h in "fiber-$t" $holders; do
      if out=$("$fc" release --lane "$h" --repo "${FW_REPO:-aakshintala/fiber}" 2>&1); then
        # One `RELEASE <path>` line per claim dropped, and no output at all when
        # the holder held nothing -- which is the common case for two of the
        # three shapes tried, so stay quiet rather than printing three zeroes.
        nrel=$(printf '%s\n' "$out" | grep -c '^RELEASE ')
        [ "$nrel" -gt 0 ] && echo "claims released: $h ($nrel)"
      else
        echo "CLAIMS NOT RELEASED for $h -- release by hand: $fc release --lane $h --repo ${FW_REPO:-aakshintala/fiber}"
        echo "  $out"
      fi
    done
    # Name the holders this ticket leaves behind that the loop above cannot
    # release, with the command that clears each. Reporting, not releasing, and
    # the distinction is the point: a `--lane` that is not `fiber-<n>` is
    # classifier-denied to an orchestrator session, so a lanecheck that released
    # them would be this session doing through a script what it may not do
    # directly. The owner's hands or switchyard#1272's canonical holder id are
    # the two legitimate routes.
    #
    # Detection costs nothing and was the whole gap: on 2026-11-06 retiring
    # #4271 printed "claims released: fiber-4271 (2)" and said nothing about
    # `docs/4271-needs-plan-label` keeping two more, so the leak was found days
    # later by a lane hitting an OVERLAP against a closed ticket. Six paths
    # across two closed tickets had accumulated by then. Silence was the defect;
    # a named holder and a paste-ready command is the fix available from here.
    #
    # THREE holder shapes, not two, and the third was found by running the
    # standing check rather than recalling it (cycle 22). Beside `fiber-<n>` and
    # the branch, `file-claim` also holds claims under `pr#<number>`: on
    # 2026-11-06 #4162 held 35 paths under `contract/4162-kind-private` and 36
    # under `pr#4328`, the larger group. The first version of this report
    # searched for the ticket number inside the holder name, which can never
    # find a `pr#` holder, because that name carries the PR number and not the
    # ticket's. So a `pr#` holder is resolved through its PR's head branch,
    # which does carry the ticket. `gh pr view` is used rather than the open-PR
    # list built at the top of this script: by the time a ticket retires its PR
    # has usually merged, and a merged PR is not in that list.
    claims=$("$fc" list --repo "${FW_REPO:-aakshintala/fiber}" 2>/dev/null) || claims=""
    for h in $(printf '%s\n' "$claims" |
      awk -F'\t' -v t="$t" '$2 ~ ("^[A-Za-z0-9_.-]+/" t "-") { print $2 }' | sort -u); do
      n=$(printf '%s\n' "$claims" | awk -F'\t' -v h="$h" '$2 == h' | wc -l | tr -d ' ')
      echo "BRANCH-SHAPED CLAIMS LEFT for $h ($n path(s)) -- release them:"
      if [ "$FW_LOCAL_BOX" = 1 ]; then
        echo "  PATH=\$HOME/.agents/bin:\$PATH file-claim release --lane $h --repo ${FW_REPO:-aakshintala/fiber}"
      else
        echo "  ssh roundhouse-7010-plus-1.local 'PATH=\$HOME/.agents/bin:\$PATH file-claim release --lane $h --repo ${FW_REPO:-aakshintala/fiber}'"
      fi
    done
    for h in $(printf '%s\n' "$claims" |
      awk -F'\t' '$2 ~ /^pr#[0-9]+$/ { print $2 }' | sort -u); do
      n=$(printf '%s\n' "$claims" | awk -F'\t' -v h="$h" '$2 == h' | wc -l | tr -d ' ')
      br=$(gh pr view "${h#pr\#}" --repo "${FW_REPO:-aakshintala/fiber}" \
        --json headRefName --jq .headRefName 2>/dev/null) || br=""
      if [ -z "$br" ]; then
        # An unresolved holder is reported, never skipped. Silence is the defect
        # this whole block exists to fix, and a gh failure here would otherwise
        # reintroduce it for exactly the shape that holds the most paths.
        echo "PR-SHAPED HOLDER UNRESOLVED: $h ($n path(s)) -- gh could not read its head branch,"
        echo "  so whether it belongs to #$t is unknown. Check it by hand:"
        echo "  gh pr view ${h#pr\#} --repo ${FW_REPO:-aakshintala/fiber} --json headRefName"
        continue
      fi
      case "$br" in
        */"$t"-*) ;;
        *) continue ;;
      esac
      echo "PR-SHAPED CLAIMS LEFT for $h on $br ($n path(s)) -- release them:"
      if [ "$FW_LOCAL_BOX" = 1 ]; then
        echo "  PATH=\$HOME/.agents/bin:\$PATH file-claim release --lane $h --repo ${FW_REPO:-aakshintala/fiber}"
      else
        echo "  ssh roundhouse-7010-plus-1.local 'PATH=\$HOME/.agents/bin:\$PATH file-claim release --lane $h --repo ${FW_REPO:-aakshintala/fiber}'"
      fi
    done
  done
  exit 0
fi

[ -f "$roster" ] || { echo "no roster at $roster"; exit 0; }
touch "$retired"

tmp=$(mktemp -d "${TMPDIR:-/tmp}/lanecheck.XXXXXX") || exit 3
trap 'rm -rf "$tmp"' EXIT
write_retirement_helper "$tmp/roster-retirement.py"

log="$R/lane-liveness.log"
if [ "${FW_SKIP_SAMPLER_CHECK:-0}" != 1 ]; then
  if [ -f "$log" ]; then
    if [ "$(uname -s)" = Darwin ]; then
      age=$(( $(date +%s) - $(stat -f %m "$log") ))
    else
      age=$(( $(date +%s) - $(stat -c %Y "$log") ))
    fi
    if [ "$age" -gt 900 ]; then
      echo "SAMPLER STALE — $log last written ${age}s ago (over 900); restart: bash bin/lanesample.sh"
    fi
  else
    echo "SAMPLER ABSENT — no $log; start it: bash bin/lanesample.sh"
  fi
fi

# When the liveness snapshots were taken. A lane launched after this cannot
# appear in them, and reporting it MISSING is a false positive: on 2026-11-05
# the sampler printed `MISSING 3895 ... launched 2026-11-05T15:07:06Z` from a
# sample that started at 15:07:00Z, so the line carried its own refutation.
if [ "$FW_LOCAL_BOX" = 1 ]; then
  boxssh=${FW_BOX_LOCAL:-$script_dir/box-local.sh}
else
  boxssh=${BOX_SSH:-${FW_SSH:-ssh}}
fi
export FW_LOCAL_BOX
FW_SNAP_AT=$(date -u +%s)
export FW_SNAP_AT
# A fixed epoch makes the shared rolling-hour wake cap deterministic in tests.
FW_LANECHECK_NOW=${FW_LANECHECK_NOW:-$(date +%s)}
export FW_LANECHECK_NOW
# pi lanes have no Claude session row. Probe their pidfiles on each host, where
# kill(pid, 0) has the same process-namespace semantics as `kill -0`.
cat >"$tmp/pi-snapshot.py" <<'PY'
import glob, os, re, sys, subprocess


def file_mtime(path):
    # GNU stat first, with the BSD/macOS form as the fallback.
    for args in (("-c", "%Y"), ("-f", "%m")):
        try:
            return int(subprocess.check_output(
                ["stat", *args, path], stderr=subprocess.DEVNULL).strip())
        except Exception:
            pass
    return os.path.getmtime(path)


def report_status(run, ticket):
    paths = (glob.glob(os.path.join(run, "inbox", "*.md"))
             + glob.glob(os.path.join(run, "inbox", "read", "*.md"))
             + glob.glob(os.path.join(run, "fiber-*-report.md")))
    candidates = []
    for path in paths:
        name = os.path.basename(path)
        match = (re.match(r"^fiber-(\d+)-report\.md$", name)
                 or re.match(r"^(?:[a-z]+-[a-z]+|box)-(\d+)-", name))
        if match and match.group(1) == ticket:
            try:
                candidates.append((os.path.getmtime(path), path))
            except OSError:
                pass
    if not candidates:
        return "no report"
    path = max(candidates)[1]
    try:
        lines = [line.strip() for line in open(path, errors="replace") if line.strip()]
    except OSError:
        return "report unreadable"
    for key in ("STATUS", "ASKING"):
        statuses = [line for line in lines if line.startswith(key)]
        if statuses:
            return " ".join(statuses[-1].split())[:110]
    return " ".join((lines[-1] if lines else "no report").split())[:110]


run = (sys.argv[1] if len(sys.argv) > 1 else
       os.environ.get("FW_RUN") or os.environ.get("FW_BOX_RUN") or
       os.path.expanduser("~/work/fiber-worktrees/flywheel/run"))
if not os.path.isdir(run):
    print("ERROR\tpi run directory unavailable")
    raise SystemExit(0)
for path in sorted(glob.glob(os.path.join(run, "fiber-*-pi.pid"))):
    match = re.fullmatch(r"fiber-(\d+)-pi\.pid", os.path.basename(path))
    if not match:
        continue
    ticket = match.group(1)
    try:
        pid = open(path).read().strip()
        if not pid.isdigit() or int(pid) <= 0:
            raise ValueError("invalid pid")
        os.kill(int(pid), 0)
        state = "LIVE"
    except PermissionError:
        state = "LIVE"  # kill -0 reports an existing but inaccessible process
    except (OSError, ValueError):
        state = "DEAD"
    print(f"{ticket}\t{state}\t{int(file_mtime(path))}\t{report_status(run, ticket)}")
PY
python3 "$tmp/pi-snapshot.py" "$R" >"$tmp/mac-pi.tsv" 2>/dev/null
if [ -n "${FW_BOX_RUN:-}" ]; then
  printf -v _box_run_arg '%q' "$FW_BOX_RUN"
  _box_pi_command="FW_RUN=$_box_run_arg python3 -"
else
  _box_pi_command='python3 -'
fi
if "$boxssh" -o BatchMode=yes -o ConnectTimeout=10 "$BOX" "$_box_pi_command" \
     <"$tmp/pi-snapshot.py" >"$tmp/box-pi.tsv" 2>"$tmp/box-pi.err"; then
  :
else
  _box_pi_rc=$?
  if [ "$_box_pi_rc" = 255 ]; then
    printf 'UNREACHABLE\t%s\n' "$BOX" >"$tmp/box-pi.tsv"
  else
    printf 'UNKNOWN\tBox pi pidfile probe failed (exit %s)\n' "$_box_pi_rc" >"$tmp/box-pi.tsv"
  fi
fi
run_claude_agents "$tmp/mac.json" "$tmp/mac.err" claude agents --json
run_claude_agents "$tmp/box.json" "$tmp/box.err" \
  "$boxssh" -o BatchMode=yes -o ConnectTimeout=10 "$BOX" 'claude agents --json'
# A muse lane (muselaunch.sh, host column `muse`) is a delegate session, not a
# Claude session, so `claude agents` never lists it and it would print MISSING
# for its whole life. Its liveness is keyed by the delegate session id the
# roster's 5th column holds, not by a session name.
"$boxssh" -o BatchMode=yes -o ConnectTimeout=10 "$BOX" 'delegate session list --json' </dev/null >"$tmp/muse.json" 2>"$tmp/muse.err"
# maclaunch.sh starts a muse lane too, so a `mac` roster line is a delegate
# session as often as a Claude one, and only this list can tell them apart. On
# 2026-11-06 #4272 (running) and #4273 (idle, its PR pushed 25 minutes earlier)
# both printed MISSING, because `mac` was looked up in `claude agents` alone
# (switchyard #1069). A false MISSING invites a second lane on the same fence.
"${FW_DELEGATE:-$HOME/.local/bin/delegate}" session list --json >"$tmp/macmuse.json" 2>"$tmp/macmuse.err"
# Blind delivery: a ruling scp'd into a lane's inbox is only read by the
# `inbox-wait` watcher the lane arms, and a lane that ends a turn without
# re-arming one leaves every later file inert. On 2026-11-03 three live lanes
# sat on unread rulings that way while ruled.sh reported "delivered". Ask
# inbox-watchers, the one primitive ruled.sh also uses, so the two cannot drift
# apart; it prints NO-WATCHER only for an inbox with no watcher, and the report
# below pairs that with the live lanes. One ssh, for every box ticket at once.
inbox_dirs=()
while IFS= read -r t; do
  if [ "$FW_LOCAL_BOX" = 1 ]; then inbox_dirs+=("$HOME/lane-inbox/$t"); else inbox_dirs+=("~/lane-inbox/$t"); fi
done < <(awk -F'\t' '($3 == "box" || $3 == "muse") && $2 != "" { print $2 }' "$roster" | sort -u)
if [ "${#inbox_dirs[@]}" -gt 0 ]; then
  if [ "$FW_LOCAL_BOX" = 1 ]; then
    "${FW_INBOX_WATCHERS:-$HOME/.agents/bin/inbox-watchers}" "${inbox_dirs[@]}" >"$tmp/inbox.txt" 2>/dev/null
  else
    "${FW_INBOX_WATCHERS:-$HOME/.agents/bin/inbox-watchers}" --host "$BOX" "${inbox_dirs[@]}" >"$tmp/inbox.txt" 2>/dev/null
  fi
fi

# Pending work, for the STALL/ABANDONED lines below: selected live commands on
# the box. Python keys a line only by its fiber-<n>.state path; bare numbers in
# notes, PRs and ports do not identify work. A wait/watch with no state path can
# be attributed through the lane-specific PID/PPID probe below, or not at all.
"$boxssh" -o BatchMode=yes -o ConnectTimeout=10 "$BOX" \
  "ps -eo args= | grep -E 'tkt-(plan|build|ship|fix|gate)|gh-ci wait|delegate watch' | grep -v grep" \
  </dev/null >"$tmp/pending.txt" 2>/dev/null

# One portable process snapshot per host. The lane-specific descendant probe
# below uses PID/PPID rather than treating any ticket-named process as its job.
if ps -A -o pid=,ppid=,etime=,args= >"$tmp/mac-procs.txt" 2>/dev/null; then
  : >"$tmp/mac-procs.ok"
fi
if "$boxssh" -o BatchMode=yes -o ConnectTimeout=10 "$BOX" \
    "ps -A -o pid=,ppid=,etime=,args=" </dev/null >"$tmp/box-procs.txt" 2>/dev/null; then
  : >"$tmp/box-procs.ok"
fi

# Pending work with no process: a delegate job in NEEDS_CONTEXT has asked a
# question and is waiting on an answer. The ps probe above cannot see it, so
# #4099 read as a STALL on 2026-11-04 and both remedies the STALL line offers
# were wrong. The ticket comes from the lane worktree in resume.cwd; a
# superseded job's question is stale.
"$boxssh" -o BatchMode=yes -o ConnectTimeout=10 "$BOX" </dev/null \
  "python3 -c \"
import json, glob, re, os, time
cut = time.time() - 7 * 86400
for p in glob.glob('/srv/lanes/tmp/delegate-jobs/*.json'):
    try:
        # The directory keeps every job ever run and nothing prunes it. A
        # question older than any lane's life cannot be reported anyway.
        if os.path.getmtime(p) < cut:
            continue
        d = json.load(open(p))
    except Exception:
        continue
    if d.get('status') != 'NEEDS_CONTEXT' or d.get('supersededBy'):
        continue
    r = d.get('resume') or {}
    m = re.findall(r'/(\d{3,5})-', (r.get('cwd') or '') + ' ' + (r.get('gate') or ''))
    print((m[-1] if m else '?') + '\t' + os.path.basename(p)[:-5] + '\t' + str(int(os.path.getmtime(p))))
\"" >"$tmp/asking.txt" 2>/dev/null

# A third kind of waiting, with neither a process nor a question: a lane that
# finished its leg and waits on a named external event. Both probes above are
# blind to it, which is how #4099 read as a STALL at 11:25Z on 2026-11-04 --
# it had not been abandoned and had asked nothing, it was waiting for PR #4153
# to merge, and the STALL line's two remedies (retire it, or wake it) were both
# wrong. The lane declares the wait in run/fiber-<n>-waiting-on.md. This list
# resolves a `pr <N>` condition: a PR absent from the open list has merged or
# closed either way, so the wait is over.
#
# The marker file is the difference between "no PRs are open" and "the fetch
# failed". Without it an empty list reads as every waited-on PR having closed,
# which turns a network blip into a WAKE for every waiting lane -- the one
# direction that costs a wasted wake and a confused lane.
if gh pr list --repo aakshintala/fiber --state open --limit 200 \
     --json number,headRefName --jq '.[] | "\(.number) \(.headRefName)"' \
     >"$tmp/openprs.txt" 2>/dev/null; then
  : >"$tmp/openprs.ok"
else
  : >"$tmp/openprs.txt"
  rm -f "$tmp/openprs.ok"
fi

python3 -I - "$tmp" "$roster" "$retired" "$R" "$BOX" "$boxssh" "$FW_LOCAL_BOX" "$script_dir/job-record" "$tmp/roster-retirement.py" <<'PY'
import glob, json, sys, os, re, shlex, subprocess, tempfile, time, fcntl

tmp, roster, retired, R, BOX, BOXSSH, LOCAL_BOX, JOB_RECORD, RETIREMENT_HELPER = sys.argv[1:10]
exec(compile(open(RETIREMENT_HELPER).read(), RETIREMENT_HELPER, "exec"), globals())

def onbox(cmd, msg=False, where="box"):
    """A `delegate` line for a delegate lane, in the form that runs from here.

    `where` is the machine whose delegate store holds the session: "box" for a
    muse lane, "mac" for one maclaunch.sh started here. The box form needs the
    ssh wrapper, the local form needs the absolute binary, because a bare
    `delegate` is refused over the runtime $HOME.

    Every muse lane's session lives on the box, so a bare `delegate session
    send <id> -` printed in this report fails from the orchestrator's session
    with "no such session" — the local session store holds none of them. On
    2026-11-04 the #4099 wake was printed bare, run bare, and failed; the
    remedy had to be re-derived before the lane could be woken. A remedy that
    does not run as printed is the same defect as a line that points at the
    wrong state: it costs the reader a failed command and a re-derivation.

    `msg=True` for a command that takes a message on stdin (`session send`,
    `resume`), which needs the redirect to be a complete command.
    """
    if where == "mac":
        line = f"{os.path.expanduser('~')}/.local/bin/delegate {cmd}"
    elif os.environ.get("FW_LOCAL_BOX") == "1":
        line = f"PATH=$HOME/.local/bin:$PATH delegate {cmd}"
    else:
        line = f"ssh {BOX} 'PATH=$HOME/.local/bin:$PATH delegate {cmd}'"
    return f"{line} < <file>" if msg else line

def live(path):
    names = {}
    try:
        data = json.load(open(path))
    except Exception as e:
        return None, str(e)
    rows = data if isinstance(data, list) else data.get("agents") or data.get("sessions") or []
    for r in rows:
        if isinstance(r, dict) and r.get("name"):
            names[r["name"]] = (r.get("state") or "?", r.get("status") or "?",
                                r.get("pid") or r.get("processId"))
    return names, None

def live_muse(path):
    """delegate ids -> status, terminal, working, turns, last turn, host pid, supervisor pid.
    a muse lane has no session name. `dead` is reported as dead rather than
    omitted, so a lane that exited is MISSING with its reason instead of
    silently absent.

    `working` is activeTurnId being set. A muse lane with no active turn is not
    doing anything and nothing will wake it: that is the #4097 stall, and it is
    invisible from `status` alone, which cannot tell "finished" from "stalled"
    from "waiting for a ruling" (switchyard #1086). The rest of the tuple keeps
    the durable turn text and process roots alongside the already-read state."""
    ids = {}
    try:
        data = json.load(open(path))
    except Exception as e:
        return None, str(e)
    for r in data.get("sessions") or []:
        if not isinstance(r, dict) or not r.get("id"):
            continue
        status = r.get("status") or "?"
        if status == "dead":
            continue
        last_turn = r.get("lastTurn") if isinstance(r.get("lastTurn"), dict) else {}
        ids[r["id"]] = (status, (last_turn.get("terminal") or "?"),
                        bool(r.get("activeTurnId")), r.get("turnCount"), last_turn,
                        r.get("hostPid"), r.get("supervisorPid"))
    return ids, None

# ticket -> pending command line, keyed only by a fiber-<n>.state path in its
# argv, regardless of command. Bare numbers do not identify a ticket; a line
# with no state path adds no entry. A failed or empty probe remains unknown.
pending = {}
try:
    for line in open(os.path.join(tmp, "pending.txt")):
        line = line.strip()
        for ticket in re.findall(r"\bfiber-(\d+)(?:-p\d+)?\.state\b", line):
            pending.setdefault(ticket, line)
except OSError:
    pass

# ticket -> the job id of a NEEDS_CONTEXT job, from the box probe. Same
# fail-open rule as `pending`: an unreadable probe is not evidence that nobody
# is waiting on an answer.
asking = {}
try:
    for line in open(os.path.join(tmp, "asking.txt")):
        f = line.strip().split("\t")
        if len(f) >= 2 and f[0] != "?":
            when = int(f[2]) if len(f) > 2 and f[2].isdigit() else None
            # Newest question per ticket: an older one for the same ticket is
            # from a previous round either way. An unstamped question sorts
            # newest, so it survives to be reported rather than dropped.
            rank = (when is None, when or 0)
            if f[0] not in asking or rank > asking[f[0]][2]:
                asking[f[0]] = (f[1], when, rank)
except OSError:
    pass


# A lane waiting on a named external event declares it in the first line of
# run/fiber-<n>-waiting-on.md. The flag is the orchestrator's to write when it
# parks a lane and to remove when it wakes it; a lane cannot be trusted to
# retract its own, which is why the staleness bound below keys on the lane's
# launch rather than on the lane clearing the file.
waiting = {}
for p in glob.glob(os.path.join(R, "fiber-*-waiting-on.md")):
    m = re.search(r"fiber-(\d{3,5})-waiting-on\.md$", p)
    if not m:
        continue
    try:
        first = open(p).readline().strip()
        when = os.path.getmtime(p)
    except OSError:
        continue
    if first:
        waiting[m.group(1)] = (first, when)

# ticket -> (mtime, status line, wants something) for its newest lane report,
# and ticket -> mtime of its newest archived ruling. Together these answer the
# fourth waiting state: a lane that reported a block or a question through the
# inbox and then ended its turn. Such a lane has no NEEDS_CONTEXT job (nothing
# of its own is running), no running command (so not ABANDONED) and no
# waiting-on flag (I never parked it), so before this it fell through to STALL
# — whose remedy, "retire it if its report landed", is exactly wrong here: the
# report landed and asked for something.
#
# debt: bin/pending.sh derives the same two facts for every ticket and prints
# them as a table. The duplication ceiling is a third reader: when something
# else needs "newest report, newest ruling", the pair moves out of both
# scripts into one helper. Two readers do not earn the indirection.
# 2026-11-04 12:00Z: bin/ruled.sh's first archived ruling. Before it, rulings
# were delivered by hand and never filed, so an empty `ruled` entry for an
# older report is unknown, not unanswered. FW_RULING_ARCHIVE_FROM lets the
# suite pin it: a case for this branch needs a report both newer than its lane
# and older than the cutoff, and with the cutoff fixed in the past that window
# closes as real time passes, so the case rotted rather than failed.
RULING_ARCHIVE_FROM = float(os.environ.get("FW_RULING_ARCHIVE_FROM") or 1793793600.0)
# When the liveness snapshots were taken, set by the shell above. 0 when unset,
# which keeps the old behaviour rather than silencing every MISSING.
SNAP_AT = float(os.environ.get("FW_SNAP_AT") or 0.0)
reported = {}
inbox_reports = {}
# Three sources, not two. A lane's report reaches me either as an inbox message
# or as `run/fiber-<n>-report.md` written in place, and which one depends on the
# machine: a box lane sends, a Mac delegate lane has no inbox to send to and only
# writes the file. Scanning the inbox alone made every Mac lane's report
# invisible here, so its row printed the bare STALL remedy "retire it if its
# report landed" -- with the report sitting unread in run/. On 2026-11-06 #4040
# cost nine hours that way: REVIEWED, CI green, PR #4298 ready to ship, and
# nothing looking. The file is the same shape as the message, so it goes through
# the same status precedence below rather than getting a branch of its own.
_srcs = [
    (glob.glob(os.path.join(R, "inbox", "*.md")), True),
    (glob.glob(os.path.join(R, "inbox", "read", "*.md")), True),
    (glob.glob(os.path.join(R, "fiber-*-report.md")), False),
]
for _d, _is_inbox in _srcs:
    for p in _d:
        base = os.path.basename(p)
        m = (re.match(r"^(?:[a-z]+-[a-z]+|box)-(\d{3,5})-", base)
             or re.match(r"^fiber-(\d{3,5})-report\.md$", base))
        if not m:
            continue
        try:
            when = os.path.getmtime(p)
            text = open(p, errors="replace").read()
        except OSError:
            continue
        t = m.group(1)
        if _is_inbox:
            inbox_reports.setdefault(t, []).append((when, text))
        if t in reported and reported[t][0] >= when:
            continue
        lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
        # Same precedence as bin/pending.sh: the last STATUS line, else the
        # last ASKING line, else the report's last line.
        status = ""
        for key in ("STATUS", "ASKING"):
            hits = [ln for ln in lines if ln.startswith(key)]
            if hits:
                status = hits[-1]
                break
        if not status and lines:
            status = lines[-1]
        # Whether the lane wants something, read from the whole report and not
        # only from the line the precedence above picked. On 2026-11-06 #3635
        # ended its turn on `STATUS: REVIEWED head=... last=FIX-OK PR #4308.
        # ASKING: merge-term call on the new sandbox notice code, and a fence
        # for the crates/hub follow-up` -- two asks, in the status line itself.
        # None of BLOCKED, READY, AWAIT or `?` appears in it (REVIEWED is not
        # READY), so wants came out false and the row read as a finished lane
        # for 2.5 hours while both asks sat unread.
        #
        # An ASKING line is the lane saying it is asking, so it counts wherever
        # it appears. Only its content can retire it: a lane that writes
        # `ASKING: nothing` has answered the question, which is why the filter
        # is on the text after the colon rather than on the keyword.
        def _asks(ln):
            body = ln.split(":", 1)[1].strip().rstrip(".").lower() if ":" in ln else ""
            return body not in ("", "nothing", "none", "n/a", "no", "-")
        # QUESTIONS is the planner's explicit stop before granting the fence;
        # do not mistake it for a completed plan merely because its prose has
        # no ordinary ask keyword.
        wants = (bool(re.search(r"BLOCKED|READY|AWAIT|await|QUESTIONS|\?", status))
                 or any(_asks(ln) for ln in lines if "ASKING" in ln))
        # Both the basename and a path that resolves. The basename is what the
        # ruling trailers record, so the answered/unanswered match below must
        # keep comparing on it; the row I read is a command I act on, and a
        # bare basename is not. On 2026-11-06 #4318's row named
        # box-prep-4318-....md and I ran `cat` on it from the flywheel dir,
        # where no such file exists -- the file was under run/inbox/. The
        # absolute path, not one relative to the flywheel dir: a relative path
        # is only true for a reader standing in that directory, and the row is
        # also read from a sandbox and over ssh.
        reported[t] = (when, " ".join(status.split())[:110], wants,
                       os.path.basename(p), os.path.abspath(p))

# Two facts about a ticket's rulings, because one of them is not enough.
#
# `ruled` is the newest ruling's time, which was the whole test until #4131 on
# 2026-11-05. Its report landed 16:04:33Z and RULING-4131-3 was archived
# 16:08:37Z, four minutes later -- so the time rule called the lane answered,
# while that ruling in fact answered an earlier question and said nothing about
# the harness defect the new report raised. The ask read as a settled lane and
# sat unseen while it held up PR #4205, and #3891 behind that.
#
# `answers` is which report each ruling says it answered, stamped by
# bin/ruled.sh at archive time. A newest report that no trailer names is
# unanswered however new the rulings are. Time cannot stand in for identity:
# that substitution is the same shape as every other probe that inferred a fact
# from a weaker signal, and it is the one that costs a lost question.
ruled = {}
answers = {}
for p in glob.glob(os.path.join(R, "rulings", "ruling-*.md")):
    m = re.search(r"ruling-(\d{3,5})-", os.path.basename(p))
    if not m:
        continue
    try:
        when = os.path.getmtime(p)
        text = open(p, errors="replace").read()
    except OSError:
        continue
    if ruled.get(m.group(1), 0.0) < when:
        ruled[m.group(1)] = when
    for named in re.findall(r"<!--\s*answers-report:\s*(\S+)\s*-->", text):
        answers.setdefault(m.group(1), set()).add(named)

# prs_ok says the fetch succeeded, so an empty set means nothing is open rather
# than nothing is known. Only a successful fetch may resolve a wait as over.
open_prs = set()
prs_ok = os.path.exists(os.path.join(tmp, "openprs.ok"))
try:
    for line in open(os.path.join(tmp, "openprs.txt")):
        f = line.split()
        if f and f[0].isdigit():
            open_prs.add(f[0])
except OSError:
    prs_ok = False


def launched(ts):
    """Roster stamp -> epoch, or None when it cannot be read. None fails open:
    an unparseable stamp must not swallow a live question."""
    import datetime
    try:
        d = datetime.datetime.fromisoformat(ts.split()[0].rstrip("Z"))
        return d.replace(tzinfo=datetime.timezone.utc).timestamp()
    except Exception:
        return None


def parse_elapsed(value):
    try:
        days = 0
        if "-" in value:
            day, value = value.split("-", 1)
            days = int(day)
        parts = [int(x) for x in value.split(":")]
        if len(parts) == 3:
            hours, minutes, seconds = parts
        elif len(parts) == 2:
            hours, minutes, seconds = 0, parts[0], parts[1]
        elif len(parts) == 1:
            hours, minutes, seconds = 0, 0, parts[0]
        else:
            return 0
        return days * 86400 + hours * 3600 + minutes * 60 + seconds
    except (TypeError, ValueError):
        return 0


def read_processes(path, ok_path):
    rows = {}
    if not os.path.exists(ok_path):
        return rows, False
    try:
        for line in open(path, errors="replace"):
            fields = line.strip().split(None, 3)
            if len(fields) < 4:
                continue
            try:
                pid, ppid = int(fields[0]), int(fields[1])
            except ValueError:
                continue
            rows[pid] = {"pid": pid, "ppid": ppid, "elapsed": parse_elapsed(fields[2]),
                         "args": fields[3]}
    except OSError:
        return {}, False
    return rows, True


def job_command(args):
    match = re.search(r"(?<![\w-])(tkt-[A-Za-z0-9-]+)(?:\s|$)", args)
    if match:
        return match.group(1)
    if re.search(r"(?<![\w-])delegate\s+watch(?:\s|$)", args):
        return "delegate watch"
    if re.search(r"(?<![\w-])gh-ci\s+wait(?:\s|$)", args):
        return "gh-ci wait"
    return None


def process_tokens(args):
    try:
        return shlex.split(args)
    except ValueError:
        return args.split()


def root_pids(processes, identifiers, explicit=()):
    roots = set()
    for value in explicit:
        try:
            pid = int(value)
            if pid > 1:
                roots.add(pid)
        except (TypeError, ValueError):
            pass
    tokens = {str(x) for x in identifiers if x not in (None, "", "?")}
    for pid, row in processes.items():
        argv = process_tokens(row["args"])
        if tokens.intersection(argv):
            roots.add(pid)
    return roots


def descendant_jobs(processes, roots):
    children = {}
    for pid, row in processes.items():
        children.setdefault(row["ppid"], []).append(pid)
    descendants = set()
    todo = list(roots)
    while todo:
        parent = todo.pop()
        for child in children.get(parent, []):
            if child not in descendants and child not in roots:
                descendants.add(child)
                todo.append(child)
    jobs = []
    for pid in descendants:
        row = processes.get(pid)
        command = job_command(row["args"]) if row else None
        if command:
            jobs.append({"pid": pid, "cmd": command, "args": row["args"],
                         "elapsed": row["elapsed"]})
    return sorted(jobs, key=lambda job: (job["elapsed"], job["pid"]))


try:
    NOW = float(os.environ.get("FW_LANECHECK_NOW", ""))
except ValueError:
    NOW = time.time()
if not NOW:
    NOW = time.time()
WAKE_STATE = os.path.join(R, "lanecheck-wake.json")
wake_lock = open(os.path.join(R, "lanecheck-wake.lock"), "a")
fcntl.flock(wake_lock.fileno(), fcntl.LOCK_EX)
try:
    with open(WAKE_STATE) as f:
        wake_state = json.load(f)
    if not isinstance(wake_state, dict) or not isinstance(wake_state.get("lanes"), dict):
        raise ValueError("bad wake state")
except (OSError, ValueError, TypeError):
    wake_state = {"version": 1, "lanes": {}}


def save_wake_state():
    fd, path = tempfile.mkstemp(prefix=".lanecheck-wake.", dir=R)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(wake_state, f, sort_keys=True)
            f.write("\n")
        os.replace(path, WAKE_STATE)
    finally:
        if os.path.exists(path):
            os.unlink(path)


def lane_state(key):
    value = wake_state["lanes"].setdefault(key, {})
    value.setdefault("running", [])
    value.setdefault("finished", [])
    value.setdefault("actions", [])
    value.setdefault("handled", [])
    return value


def lane_key(ticket, host, session, jid):
    return "\t".join((ticket, host, session, jid if jid not in ("", "?") else "-"))


def elapsed_label(seconds):
    seconds = max(0, int(seconds))
    if seconds >= 3600:
        return f"{seconds // 3600}h{(seconds % 3600) // 60}m"
    if seconds >= 60:
        return f"{seconds // 60}m{seconds % 60}s"
    return f"{seconds}s"


def action_status(entry, action_id):
    entry["actions"] = [item for item in entry["actions"]
                        if isinstance(item, dict) and NOW - float(item.get("at", 0)) < 3600]
    if action_id in entry["handled"]:
        return "handled", len(entry["actions"])
    if len(entry["actions"]) >= 2:
        return "capped", len(entry["actions"])
    entry["actions"].append({"at": NOW, "id": action_id})
    entry["handled"].append(action_id)
    try:
        save_wake_state()
    except OSError:
        entry["actions"].pop()
        entry["handled"].pop()
        return "unrecorded", len(entry["actions"])
    return "ready", len(entry["actions"])


def send_action(entry, action_id, store, jid, message):
    status, count = action_status(entry, action_id)
    if status != "ready":
        return status, count
    result = delegate_tool(store, "send", jid, message)
    if result is not None and result.returncode == 0:
        return "sent", count
    if result is not None and result.returncode == 5:
        # `busy` is a definite rejection, not an accepted send. Release the
        # dedupe claim so the same source can be retried on the next lanecheck.
        entry["handled"] = [item for item in entry["handled"] if item != action_id]
        entry["actions"] = [item for item in entry["actions"]
                            if not isinstance(item, dict) or item.get("id") != action_id]
        try:
            save_wake_state()
        except OSError:
            return "unrecorded", count
        return "busy", count
    return "failed", count


def state_path_for(ticket, args=""):
    for token in process_tokens(args):
        if token.endswith(".state"):
            candidate = os.path.abspath(token)
            if os.path.isfile(candidate) or os.path.isfile(candidate[:-6] + ".journal"):
                return candidate
    candidates = sorted(glob.glob(os.path.join(R, "*-" + ticket + ".state")))
    for candidate in candidates:
        try:
            values = {}
            for line in open(candidate, errors="replace"):
                key, sep, value = line.rstrip("\n").partition("=")
                if sep:
                    values.setdefault(key, value)
            if values.get("issue") == ticket:
                return os.path.abspath(candidate)
        except OSError:
            pass
    if candidates:
        return os.path.abspath(candidates[0])
    return os.path.abspath(os.path.join(R, "fiber-" + ticket + ".state"))


def job_exit_code(command, args, ticket, store):
    if command == "delegate watch":
        match = re.search(r"\bdelegate\s+watch\s+([A-Za-z0-9-]+)", args)
        if match:
            try:
                job_id = match.group(1)
                if store == "mac" or LOCAL_BOX == "1":
                    result = subprocess.run([JOB_RECORD, job_id], text=True,
                                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                            timeout=10)
                    record_path = result.stdout.strip() if result.returncode == 0 else ""
                    record = json.load(open(record_path)) if record_path else {}
                else:
                    remote = (f'record=$(bash "$HOME/.agents/bin/job-record" '
                              f'{shlex.quote(job_id)}) || exit; cat "$record"')
                    result = subprocess.run([BOXSSH, "-o", "BatchMode=yes", "-o",
                                             "ConnectTimeout=10", BOX, remote], text=True,
                                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                            timeout=10)
                    record = json.loads(result.stdout) if result.returncode == 0 else {}
                for key in ("exitCode", "exit_code"):
                    code = record.get(key)
                    if type(code) is int:
                        return str(code)
                result_record = record.get("result") or {}
                for key in ("exitCode", "exit_code"):
                    code = result_record.get(key)
                    if type(code) is int:
                        return str(code)
                gate_result = result_record.get("gateResult") or {}
                for key in ("exitCode", "exit_code"):
                    code = gate_result.get(key)
                    if type(code) is int:
                        return str(code)
            except Exception:
                pass
        return "unknown"
    state_path = state_path_for(ticket, args)
    journal = state_path[:-6] + ".journal" if state_path.endswith(".state") else state_path + ".journal"
    try:
        for line in reversed(open(journal, errors="replace").read().splitlines()):
            if re.search(r"\b" + re.escape(command) + r"\b", line):
                match = re.search(r"\b(?:rc|exit(?:\s+code)?)\s*[=:]?\s*(-?\d+)\b", line)
                return match.group(1) if match else "unknown"
    except OSError:
        pass
    return "unknown"


def delegate_tool(store, verb, jid, text=None):
    binary = os.environ.get("FW_DELEGATE") or os.path.expanduser("~/.local/bin/delegate")
    if store == "mac" or LOCAL_BOX == "1":
        command = [binary, "session", verb, jid]
        if verb == "send":
            command.append("-")
        else:
            command.append("--json")
    else:
        quoted = shlex.quote(jid)
        if verb == "send":
            remote = f"TMPDIR=/srv/lanes/tmp PATH=$HOME/.local/bin:$PATH delegate session send {quoted} -"
        else:
            remote = f"PATH=$HOME/.local/bin:$PATH delegate session logs {quoted} --json"
        command = [BOXSSH, "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", BOX, remote]
    try:
        return subprocess.run(command, input=text, text=True, stdout=subprocess.PIPE,
                              stderr=subprocess.PIPE, timeout=30)
    except Exception as e:
        return None


def turn_log(store, jid):
    result = delegate_tool(store, "logs", jid)
    if result is None or result.returncode != 0:
        return None
    try:
        data = json.loads(result.stdout)
        lines = data.get("lines") if isinstance(data, dict) else data
        return lines if isinstance(lines, list) else None
    except Exception:
        return None


def turn_details(lines, turn_id, ended_at):
    events = [line for line in lines if isinstance(line, dict)
              and line.get("turnId") == turn_id]
    started = next((line.get("at") for line in events if line.get("kind") == "turn.started"
                    and isinstance(line.get("at"), (int, float))), None)
    statuses = []
    user_messages = []
    assistant_messages = []
    for event in events:
        if event.get("kind") == "user" and isinstance(event.get("text"), str):
            at = event.get("at")
            user_messages.append((at if isinstance(at, (int, float)) else None,
                                  event["text"]))
    for event in lines:
        if not isinstance(event, dict) or event.get("kind") != "message" \
                or not isinstance(event.get("text"), str):
            continue
        at = event.get("at")
        timestamp = at if isinstance(at, (int, float)) else None
        assistant_messages.append((timestamp, event["text"]))
        if event.get("turnId") != turn_id:
            continue
        for status in re.findall(r"(?im)^\s*STATUS\s*:[^\n]*", event["text"]):
            statuses.append((timestamp, status))
    return (started, (ended_at if isinstance(ended_at, (int, float)) else None),
            statuses, user_messages, assistant_messages)


def missed_answers(ticket, start_ms, end_ms, user_messages, assistant_messages, inbox_reports):
    if start_ms is None or end_ms is None:
        return []
    pending_answers = []
    paths = sorted(glob.glob(os.path.join(R, "rulings", f"ruling-{ticket}-*.md")),
                   key=lambda path: os.path.getmtime(path))
    for path in paths:
        try:
            mtime_ms = os.path.getmtime(path) * 1000
            content = open(path, errors="replace", newline="").read()
        except OSError:
            continue
        ids = set(re.findall(r"\b(?:(?:ADMIT|RULING)-[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*|WAKE)\b",
                             content + " " + os.path.basename(path)))
        # Flywheel rulings use the `RULING FW<n>` header rather than the
        # `RULING-...` token format used by other answer archives. Read only
        # the header so references to earlier FW rulings do not become answers.
        ids.update(re.findall(r"(?im)^\s*RULING\s+(FW[0-9]+)\b", content))
        for answer_id in sorted(ids):
            delivered = [at for at, text in user_messages
                         if at is not None and start_ms <= at <= end_ms and answer_id in text]
            if delivered:
                delivered_at = min(delivered)
            elif start_ms <= mtime_ms <= end_ms:
                delivered_at = mtime_ms
            else:
                continue
            acknowledged = any(at is not None and at >= delivered_at and answer_id in text
                               for at, text in assistant_messages)
            acknowledged = acknowledged or any(
                report_at * 1000 >= delivered_at and answer_id in text
                for report_at, text in inbox_reports)
            if not acknowledged:
                pending_answers.append((delivered_at, answer_id, path, content))
    return sorted(pending_answers, key=lambda answer: (answer[0], answer[1]))


mac_processes, mac_ps_ok = read_processes(os.path.join(tmp, "mac-procs.txt"),
                                           os.path.join(tmp, "mac-procs.ok"))
box_processes, box_ps_ok = read_processes(os.path.join(tmp, "box-procs.txt"),
                                           os.path.join(tmp, "box-procs.ok"))
process_hosts = {"mac": (mac_processes, mac_ps_ok), "box": (box_processes, box_ps_ok)}

mac, mac_err = live(os.path.join(tmp, "mac.json"))
box, box_err = live(os.path.join(tmp, "box.json"))
muse, muse_err = live_muse(os.path.join(tmp, "muse.json"))
macmuse, macmuse_err = live_muse(os.path.join(tmp, "macmuse.json"))
for host, err, f in (("mac", mac_err, "mac.err"), ("box", box_err, "box.err"),
                     ("muse", muse_err, "muse.err"),
                     ("mac delegate", macmuse_err, "macmuse.err")):
    if err is not None:
        stderr = open(os.path.join(tmp, f)).read().strip().splitlines()
        timeout_reason = next((line for line in stderr
                               if line.startswith("claude agents timed out after ")), None)
        reason = timeout_reason or (stderr[0] if stderr else err)
        print(f"UNKNOWN {host} — cannot list sessions: {reason}")

# `NO-WATCHER ~/lane-inbox/<ticket> unread=<n>` lines from inbox-watchers. Absent
# file or failed ssh (WATCH-ERROR) means no pairing rather than a false all-clear,
# so start empty; only unread > 0 is blind, an empty unwatched inbox is fine.
inbox = {}
try:
    for line in open(os.path.join(tmp, "inbox.txt")):
        p = line.split()
        if len(p) == 3 and p[0] == "NO-WATCHER" and p[2].startswith("unread="):
            inbox[p[1].rsplit("/", 1)[-1]] = int(p[2][7:])
        elif p and p[0] == "WATCH-ERROR":
            print("UNKNOWN box inbox — watcher state unreadable: " + line.strip())
except Exception:
    pass

# Retirement is time-ordered: a roster entry launched after its retirement line
# is a relaunch and is checked again. Without this, retiring a parked ticket
# hides the lane that later picks it up, under its usual session name.
# frontier.sh holds a second copy of this rule, which drifted from this one and
# cost a double-launch. De-duplication is #4336; until it lands, change both.
done, done_sess = read_retirements(retired)

# last roster line per (ticket, session) wins
entries = {}
for line in open(roster):
    p = line.rstrip("\n").split("\t")
    if len(p) < 4:
        continue
    ts, n, host, sess = p[0], p[1], p[2], p[3]
    jid = p[4] if len(p) > 4 else "?"
    entries[(n, sess)] = (ts, host, jid)

# A pending command names a ticket state file, not the session running it. Keep
# the newest non-retired roster entry so a reported plan is not blamed for work
# handed to a live newer phase on that shared state file.
newest_roster = {}
for (n, sess), (ts, host, jid) in entries.items():
    if entry_is_retired(n, sess, jid, ts, done, done_sess):
        continue
    started = launched(ts)
    current = newest_roster.get(n)
    if started is not None and (current is None or started > current[0]):
        newest_roster[n] = (started, host, sess)

missing = 0
active_roster_tickets = set()
live_roster_starts = {}
for (n, sess), (ts, host, jid) in sorted(entries.items()):
    if entry_is_retired(n, sess, jid, ts, done, done_sess):
        continue
    active_roster_tickets.add(n)
    # A delegate lane is looked up by its session id (column 5), a Claude lane
    # by its session name (column 4). `deleg` holds which machine's delegate
    # store the id lives in, or None for a Claude session, and every branch
    # below keys on that rather than on the host word: `mac` names both kinds,
    # because maclaunch.sh starts a muse session and bglaunch.sh a Claude one.
    deleg = None
    if host == "muse":
        names, key, deleg = muse, jid, "box"
    elif host == "mac":
        if mac is not None and sess in mac:
            names, key = mac, sess
        else:
            names, key, deleg = macmuse, jid, "mac"
    else:
        names, key = box, sess
    if names is None:
        print(f"UNCHECKED {n} {host} {sess} (launched {ts}) — host list unavailable")
        continue
    # A `mac` line reaches the delegate store only because the Claude list did
    # not name it, so an unreadable Claude list makes that fall-through
    # meaningless: absent from the delegate store then says nothing about a
    # Claude lane. UNCHECKED, not MISSING — MISSING is the reading that invites
    # a second lane onto the same fence.
    if host == "mac" and mac is None and key not in names:
        print(f"UNCHECKED {n} {host} {sess} (launched {ts}) — not in the local "
              "delegate store, and `claude agents` is unreadable")
        continue
    if deleg and key in ("", "?"):
        missing += 1
        print(f"MISSING {n} {host} {sess} launched {ts} — no delegate session id in the roster line, so liveness cannot be checked")
        continue
    # Accept a shortened session id. muselaunch.sh writes the full uuid, but a
    # roster line repaired by hand carries the 8-char form, and reading a live
    # lane as MISSING invites a second lane on the same fence — the one failure
    # here that costs more than a stale line. Only an unambiguous prefix counts.
    if deleg and key not in names:
        hits = [k for k in names if k.startswith(key)]
        if len(hits) == 1:
            key = hits[0]
    if key in names:
        working, turns, last_turn = True, None, {}
        explicit_roots = ()
        if deleg:
            state, status, working, turns, last_turn, host_pid, supervisor_pid = names[key]
            explicit_roots = (host_pid, supervisor_pid)
        else:
            state, status, pid = names[key]
            explicit_roots = (pid,)
            # A Claude lane's "no active turn" is `status == "busy"` being
            # false, exactly what `activeTurnId` says for a muse lane.
            working = status == "busy"
        # Which delegate store a wake for this lane would run against. `deleg`
        # is None for a Claude lane but its jobs still live on its own host, so
        # the remedy lines below cannot key on `deleg` alone without printing
        # the ssh form for a mac lane.
        store = deleg or ("mac" if host == "mac" else "box")
        # The wake for a lane with no active turn. A delegate lane takes a
        # message on stdin; a Claude lane has a SendMessage address and no
        # delegate session at all, so `delegate session send` against it fails
        # with "no such session" -- the same defect as the bare-delegate line
        # #4099 cost a re-derivation to.
        sendline = ("`" + onbox(f"session send {jid} -", msg=True, where=store) + "`"
                    if deleg else f"SendMessage to '{sess}'")
        lane_record = lane_state(lane_key(n, host, sess, jid))
        processes, ps_ok = process_hosts[store]
        roots = root_pids(processes, (jid, sess), explicit_roots)
        tree_known = ps_ok and any(pid in processes for pid in roots)
        current_jobs = descendant_jobs(processes, roots) if tree_known else []
        current_ids = {f"{job['pid']}:{job['cmd']}" for job in current_jobs}
        # A lane job whose parent changed since launch (backgrounded, then
        # re-parented when the turn ended) falls out of the descendant walk
        # but still names its ticket, which is how ABANDONED finds it (#1465).
        # Track it by the same pid:command identity; PPID is not in the key.
        for pid, row in processes.items():
            command = job_command(row["args"])
            if (command and f"{pid}:{command}" not in current_ids
                    and n in re.findall(r"\b\d{3,5}\b", row["args"])):
                current_jobs.append({"pid": pid, "cmd": command, "args": row["args"],
                                     "elapsed": row["elapsed"]})
                current_ids.add(f"{pid}:{command}")
        # A job already tracked for this lane stays running while its pid
        # still runs the same command, wherever its parent is now.
        for job in lane_record["running"]:
            row = processes.get(job.get("pid"))
            identity = f"{job.get('pid')}:{job.get('cmd')}"
            if (row and identity not in current_ids
                    and job_command(row["args"]) == job.get("cmd")):
                current_jobs.append({"pid": row["pid"], "cmd": job["cmd"],
                                     "args": row["args"], "elapsed": row["elapsed"]})
                current_ids.add(identity)
        current_jobs.sort(key=lambda job: (job["elapsed"], job["pid"]))
        if ps_ok:
            finished = lane_record["finished"]
            finished_ids = {f"{job.get('pid')}:{job.get('cmd')}" for job in finished}
            for job in lane_record["running"]:
                identity = f"{job.get('pid')}:{job.get('cmd')}"
                if identity not in current_ids and identity not in finished_ids:
                    completed_job = dict(job)
                    completed_job["finishedAt"] = NOW
                    completed_job["rc"] = job_exit_code(job["cmd"], job.get("args", ""), n, store)
                    finished.append(completed_job)
                    finished_ids.add(identity)
            lane_record["finished"] = [job for job in finished
                                       if f"{job.get('pid')}:{job.get('cmd')}" not in current_ids]
            lane_record["running"] = current_jobs
        finished_jobs = lane_record["finished"]
        turn_lines = None
        turn_started_ms = turn_ended_ms = None
        status_lines = []
        user_messages = []
        assistant_messages = []
        last_turn_id = last_turn.get("turnId") if isinstance(last_turn, dict) else None
        terminal = last_turn.get("terminal") if isinstance(last_turn, dict) else None
        if deleg and not working and terminal == "completed" and last_turn_id:
            turn_lines = turn_log(store, jid)
            if turn_lines is not None:
                (turn_started_ms, turn_ended_ms, status_lines, user_messages,
                 assistant_messages) = turn_details(
                    turn_lines, last_turn_id, last_turn.get("endedAt"))
        blind = ""
        # A lane reads an inbox file only while it has a watcher armed. Unread
        # files with no watcher means a ruling is sitting where nothing will
        # read it: say so here rather than let "delivered" stand. The remedy
        # differs by host, so name it. A muse lane is a `delegate session`, not
        # a Claude session: it has no SendMessage address, and once it reports
        # idle or completed it never polls again, so unread mail there waits on
        # a relaunch. On 2026-11-04 #4077 and #3899 both sat that way.
        if (host == "box" or deleg == "box") and n in inbox:
            unread = inbox[n]
            if unread > 0:
                # A muse lane has no SendMessage address, but it is not
                # unreachable: `delegate session send <full-uuid> -` takes a
                # message on stdin and starts a turn on an idle session. Proved
                # 2026-11-04 on #4026's lane and #4077's (switchyard #1086); it
                # prints `started` on an idle session, `steered` on a busy one.
                # Relaunching instead throws away the lane's whole turn.
                fix = (f"deliver by SendMessage to {sess}" if host == "box"
                       else "wake with: " + onbox(f"session send {jid} -", msg=True, where=deleg))
                blind = f"  BLIND-INBOX {unread} unread, no inbox-wait armed — {fix}"
        # A lane holding no active turn has stopped and nothing wakes it.
        # Either it reported and wants retiring, or it is the #4097 stall and
        # wants a nudge. Both need the orchestrator, so say so rather than let
        # LIVE stand for a lane doing nothing. This covers a Claude lane as
        # well as a delegate one since 2026-11-06; it was `deleg and not
        # working` before, which exempted every box Claude lane from the whole
        # block.
        # Whether this lane's newest report asks for something no ruling has
        # answered. Computed for every lane, not only a stopped one, because a
        # lane can be mid-turn and still waiting on me: #4250 reported "Round 3
        # cannot call the live fold from loop. Rule where the pure fold lives"
        # at 14:49Z on 2026-11-06 and printed `LIVE 4250 box fiber-4250-plan
        # working/busy` for five hours. Its session had an active turn, so the
        # whole waiting block below was skipped, and NEEDS-ANSWER keys on a
        # NEEDS_CONTEXT job, which a lane that reports in a file does not have.
        # The report was in run/inbox/ the whole time with nothing reading it.
        #
        # A busy lane is not a stopped one and must not print a stopped lane's
        # state, so this rides the LIVE row as a note rather than becoming a
        # fifth waiting state. What it says is the only thing that matters:
        # something on this lane is waiting on a ruling even though the lane
        # itself is working.
        lane_started = launched(ts)
        rep = reported.get(n)
        fresh = rep and (lane_started is None or rep[0] >= lane_started - 60)
        # Which report the rulings say they answered, when any of this ticket's
        # rulings says so at all. A ticket whose rulings are all older than
        # bin/ruled.sh's stamping carries no trailer, and for those the time
        # rule is still the best available answer -- so the fallback is the old
        # behaviour, not a flip to unanswered, which would turn every
        # historical lane into a question.
        named = answers.get(n)
        if named is not None and rep is not None:
            unanswered = rep[3] not in named
            why = ("no archived ruling names that report (the newest "
                   "ruling answers a different one)")
        else:
            unanswered = ruled.get(n, 0.0) <= rep[0] if fresh else False
            why = "no archived ruling postdates that report"
        open_ask = bool(fresh and rep[2] and unanswered)
        newest_lane = newest_roster.get(n)
        planned_handoff = bool(
            n in pending and fresh and rep is not None
            and re.match(r"^STATUS\s*:\s*PLANNED\b", rep[1], re.I)
            and not open_ask and lane_started is not None
            and newest_lane is not None and newest_lane[0] > lane_started)
        if open_ask:
            blind += (f"  ASK-OPEN it reported \"{rep[1]}\" and {why} — read "
                      f"{rep[4]}, then `bash bin/ruled.sh {n} <file>`. The lane "
                      f"is working, so this is not a stall: part of its work is "
                      f"waiting on me")
        jobq = asking.get(n)
        if (jobq and lane_started is not None and jobq[1] is not None
                and jobq[1] < lane_started - 60):
            jobq = None
        parked = n in waiting and (lane_started is None or waiting[n][1] >= lane_started - 60)
        wake_done = False
        if current_jobs and not parked and not jobq:
            job = current_jobs[0]
            print(f"WAITING {n} {host} {sess} {job['cmd']} {elapsed_label(job['elapsed'])}{blind}")
            wake_done = True
        elif not working and finished_jobs and deleg and not parked and not jobq:
            job = finished_jobs[0]
            action_id = f"job:{job['pid']}:{job['cmd']}"
            rc_text = job.get("rc") or "unknown"
            reason = f"tracked {job['cmd']} finished (exit {rc_text})"
            message = (f"WAKE (lanecheck): {job['cmd']} finished (exit {rc_text}). "
                       "Read its output and continue from your brief. End with STATUS.")
            result, count = send_action(lane_record, action_id, store, jid, message)
            if result in ("sent", "failed"):
                label = "WAKE" if result == "sent" else "WAKE-FAILED"
                print(f"{label} {n} {host} {sess} — {reason} ({count}/2 this rolling hour)")
                lane_record["finished"] = [saved for saved in lane_record["finished"]
                                            if saved is not job]
                save_wake_state()
                wake_done = True
            elif result == "busy":
                print(f"WAKE-DEFERRED {n} {host} {sess} — {reason}; action remains pending for the next lanecheck")
                wake_done = True
            elif result == "capped":
                print(f"STALL {n} {host} {sess} {state}/{status} turns={turns} — "
                      f"{reason}; wake cap reached ({count}/2 this rolling hour), "
                      "so no message was sent")
                wake_done = True
            elif result == "unrecorded":
                print(f"STALL {n} {host} {sess} {state}/{status} turns={turns} — "
                      "could not record the wake cap, so no message was sent")
                wake_done = True
        elif (not working and deleg and not parked and not jobq and not current_jobs
              and not finished_jobs and n not in pending and turn_lines is not None
              and tree_known and terminal == "completed" and last_turn_id):
            answers_to_resend = missed_answers(n, turn_started_ms, turn_ended_ms,
                                                user_messages, assistant_messages,
                                                inbox_reports.get(n, []))
            if answers_to_resend:
                _, answer_id, answer_path, answer_text = answers_to_resend[0]
                action_id = "answer:" + os.path.basename(answer_path)
                reason = f"missed steer {answer_id}"
                result, count = send_action(lane_record, action_id, store, jid, answer_text)
                if result in ("sent", "failed"):
                    label = "WAKE" if result == "sent" else "WAKE-FAILED"
                    print(f"{label} {n} {host} {sess} — {reason} ({count}/2 this rolling hour)")
                    wake_done = True
                elif result == "busy":
                    print(f"WAKE-DEFERRED {n} {host} {sess} — {reason}; missed answer remains pending for the next lanecheck")
                    wake_done = True
                elif result == "capped":
                    print(f"STALL {n} {host} {sess} {state}/{status} turns={turns} — "
                          f"{reason}; wake cap reached ({count}/2 this rolling hour), "
                          "so no message was sent")
                    wake_done = True
                elif result == "unrecorded":
                    print(f"STALL {n} {host} {sess} {state}/{status} turns={turns} — "
                          "could not record the re-send cap, so no message was sent")
                    wake_done = True
            elif not status_lines:
                action_id = "silent:" + str(last_turn_id)
                state_path = state_path_for(n)
                reason = f"silent idle turn {last_turn_id}"
                message = ("WAKE (lanecheck): your last turn ended with no STATUS line and no job running. "
                           f"Read {state_path} and your journal, take the next step your brief names, "
                           "and end every turn with a STATUS line. Never background a wait: run tkt-* "
                           "and delegate watch in the foreground.")
                result, count = send_action(lane_record, action_id, store, jid, message)
                if result in ("sent", "failed"):
                    label = "WAKE" if result == "sent" else "WAKE-FAILED"
                    print(f"{label} {n} {host} {sess} — {reason} ({count}/2 this rolling hour)")
                    wake_done = True
                elif result == "busy":
                    print(f"WAKE-DEFERRED {n} {host} {sess} — {reason}; action remains pending for the next lanecheck")
                    wake_done = True
                elif result == "capped":
                    print(f"STALL {n} {host} {sess} {state}/{status} turns={turns} — "
                          f"{reason}; wake cap reached ({count}/2 this rolling hour), "
                          "so no message was sent")
                    wake_done = True
                elif result == "unrecorded":
                    print(f"STALL {n} {host} {sess} {state}/{status} turns={turns} — "
                          "could not record the wake cap, so no message was sent")
                    wake_done = True
        if not working and not wake_done:
            # The abandoned wait: work still running for a lane that has
            # stopped. Nothing will wake it when the work finishes, so this is
            # the line that needs acting on today, not a retirement candidate.
            # A job older than this lane's launch is a previous lane's
            # question. Job records never expire, so without this every stall
            # on a ticket that once asked something would point at a dead job.
            jobq = asking.get(n)
            if (jobq and lane_started is not None and jobq[1] is not None
                    and jobq[1] < lane_started - 60):
                jobq = None
            # Precedence: the park flag first, then NEEDS-ANSWER, then
            # ABANDONED, then the fourth state. The flag is the orchestrator's
            # own declaration that this lane is not to be acted on, and a line
            # that nudges me to do the thing I just deferred is a line I learn
            # to ignore — #4161 was parked on 2026-11-04 and went on printing
            # NEEDS-ANSWER. Nothing is lost by putting it first, because the
            # park line carries whatever the state it outranks would have
            # said: the open question with its resume command, or the running
            # work with its command line. A verdict is not lost while parked
            # either; the work writes it to the ticket's state file and the
            # lane reads it on waking, which is what parking is for.
            # NEEDS-ANSWER stays above ABANDONED (cycle 13): when a job sits
            # in NEEDS_CONTEXT the process `ps` sees is that same stuck work,
            # so re-attaching to it is the wrong remedy.
            if n in waiting and (lane_started is None
                                 or waiting[n][1] >= lane_started - 60):
                # A flag older than this lane's launch belongs to a previous
                # lane for the ticket, the same bound the question probe uses:
                # run/ files outlive the lanes that wrote them.
                # Capped like the ABANDONED line's command: the flag's first
                # line is prose a lane or I wrote, and an uncapped echo of it
                # pushed the remedy off the end of the terminal on its first
                # real run.
                cond = " ".join(waiting[n][0].split())[:110]
                flag = os.path.join(R, f"fiber-{n}-waiting-on.md")
                # A parked lane may also hold an open question, and then the
                # wake is `delegate resume <job>`, not a session send: a park
                # that printed the session remedy would send the lane a turn
                # with its question still unanswered. Both the question and any
                # running work are named on the line, so parking cannot hide
                # either.
                wake = ("`" + onbox(f"resume {jobq[0]} -", msg=True, where=store) + "`" if jobq
                        else sendline)
                asknote = (f", and its job {jobq[0]} is still NEEDS_CONTEXT, so "
                           f"the wake answers that question" if jobq else "")
                if n in pending and not planned_handoff:
                    asknote += (", and work is still running for it: "
                                + " ".join(pending[n].split())[:110])
                pr = re.match(r"pr\s*#?(\d+)", cond, re.I)
                if pr and prs_ok and pr.group(1) not in open_prs:
                    print(f"WAKE {n} {host} {sess} {state}/{status} turns={turns} — "
                          f"it reported and parked on \"{cond}\", and PR "
                          f"#{pr.group(1)} is no longer open, so the wait is over"
                          f"{asknote}: wake it with {wake} and "
                          f"remove {flag}")
                else:
                    blind_note = "" if prs_ok else \
                        " (the open-PR list could not be fetched, so this condition was not resolved)"
                    print(f"WAITING {n} {host} {sess} {state}/{status} turns={turns} — "
                          f"no active turn because it reported and parked on "
                          f"\"{cond}\"{blind_note}: it is neither stalled nor "
                          f"abandoned, so leave it until that holds{asknote}, then "
                          f"wake it with {wake} and remove {flag}")
            elif jobq:
                print(f"NEEDS-ANSWER {n} {host} {sess} {state}/{status} turns={turns} — "
                      f"no active turn because its job {jobq[0]} is NEEDS_CONTEXT: "
                      f"it asked a question and is waiting on an answer, so it is "
                      f"neither finished nor running. Read it with `"
                      + onbox(f"status {jobq[0]}", where=store) + "`, then rule and have the "
                      f"lane answer it with `"
                      + onbox(f"resume {jobq[0]} -", msg=True, where=store) + "`")
            elif n in pending and not planned_handoff:
                cmd = " ".join(pending[n].split())[:110]
                print(f"ABANDONED {n} {host} {sess} {state}/{status} turns={turns} — "
                      f"no active turn, but work is still running for it: {cmd} — "
                      f"wake it with " + sendline
                      + " so it waits on that work itself")
            elif planned_handoff:
                newer_host, newer_sess = newest_lane[1], newest_lane[2]
                cmd = " ".join(pending[n].split())[:110]
                print(f"STALL {n} {host} {sess} {state}/{status} turns={turns} — "
                      f"it reported \"{rep[1]}\" before newer roster entry "
                      f"{newer_host}/{newer_sess}; retire it if its report landed. "
                      f"The shared-state pending work is credited to that newer session: {cmd}")
            else:
                # The fourth waiting state: it reported a block or a question
                # and ended its turn. Bounded by the lane's launch, like the
                # question and flag probes above, because run/ and inbox files
                # outlive the lanes that wrote them.
                # rep, fresh, named, unanswered and why are computed above the
                # `working` split, so a busy lane's open ask is visible too.
                if open_ask:
                    unknown = ("" if rep[0] >= RULING_ARCHIVE_FROM or n in ruled else
                               " (its report predates the ruling archive, so an"
                               " off-archive ruling would not show here —"
                               " confirm before ruling again)")
                    print(f"NEEDS-RULING {n} {host} {sess} {state}/{status} turns={turns} — "
                          f"no active turn because it reported \"{rep[1]}\" and ended its "
                          f"turn, and {why}{unknown}: it "
                          f"is waiting on me, not stalled, so do not retire it. Rule it and "
                          f"deliver with `bash bin/ruled.sh {n} <file>`, which archives the "
                          f"ruling and wakes the lane in one step")
                else:
                    settled = ("" if not fresh or not rep[2] else
                               " — its report asked for something and a ruling already "
                               + ("names it" if named is not None else "postdates it")
                               + ", so this is a lane that stopped after being "
                               "answered")
                    # "Retire it if its report landed" is a question, and until
                    # 2026-11-06 this line asked it without answering it -- so
                    # #4040's row looked the same whether its report existed or
                    # not. It existed, said REVIEWED with CI green and a
                    # shippable PR in it, and sat nine hours. A report that is
                    # on the record and does not ask for anything is the
                    # commonest reason a lane goes quiet, so name the file and
                    # quote its status here: the answer costs one line and the
                    # question cost a working day.
                    landed = ("" if not fresh else
                              f" — its report landed in {rep[4]} and says \"{rep[1]}\","
                              " so read that before retiring")
                    print(f"STALL {n} {host} {sess} {state}/{status} turns={turns} — no active turn "
                          f"and no work running for it{settled or landed}: retire it if its report "
                          f"landed, else wake it with "
                          + sendline)
        elif working and not wake_done:
            started = launched(ts)
            if started is not None:
                live_roster_starts[n] = max(started, live_roster_starts.get(n, 0))
            print(f"LIVE {n} {host} {sess} {state}/{status}{blind}")
    else:
        # A lane launched after the snapshots were taken cannot be in them, so
        # it is new, not missing. Five seconds of slack covers the roster write
        # racing the snapshot in the other direction.
        started = launched(ts)
        if SNAP_AT and started is not None and started >= SNAP_AT - 5:
            print(f"NEW {n} {host} {sess} id={jid} launched {ts} — launched after this "
                  f"run's liveness snapshot, so its liveness is unknown until the next run")
        else:
            missing += 1
            print(f"MISSING {n} {host} {sess} id={jid} launched {ts} — relaunch or park with a reason")

recorded_retirements = set(done)
recorded_retirements.update(n for n, _ in done_sess)
retired_tickets = recorded_retirements - active_roster_tickets
for host, path in (("PI-MAC", os.path.join(tmp, "mac-pi.tsv")),
                   ("PI-BOX", os.path.join(tmp, "box-pi.tsv"))):
    try:
        with open(path) as pi_rows:
            for row in pi_rows:
                fields = row.rstrip("\n").split("\t", 3)
                if fields[0] == "UNREACHABLE":
                    print(f"UNREACHABLE {host} — cannot read pidfiles from {fields[1]}")
                elif fields[0] == "UNKNOWN":
                    print(f"UNKNOWN {host} — {fields[1]}")
                elif fields[0] == "ERROR":
                    print(f"UNKNOWN {host} — {fields[1]}")
                elif len(fields) == 4:
                    ticket, state, pid_mtime, status = fields
                    if ticket in retired_tickets:
                        continue
                    try:
                        pid_mtime = float(pid_mtime)
                    except ValueError:
                        pid_mtime = None
                    started = live_roster_starts.get(ticket)
                    if pid_mtime is not None and started is not None and started > pid_mtime:
                        continue
                    print(f"{state} {host} {ticket} {status}")
    except OSError:
        pass

try:
    save_wake_state()
except OSError as error:
    print(f"UNKNOWN lanecheck wake state — cannot persist {WAKE_STATE}: {error}")

print(f"-- {len(entries)} roster entries, {len(done)} tickets and {len(done_sess)} sessions retired, {missing} missing")
sys.exit(1 if missing else 0)
PY
rc=$?

# Box tool skew, printed in the footer I read every cycle.
#
# boxstale.sh already answers this question, and on 2026-11-06 I still ruled on a
# box lane's tkt-plan failure by reading the Mac's copy of the script -- a copy
# the lane never executed, because the box was 10 hours behind. The check was not
# missing; nothing put its answer where I would see it. A tool that has to be
# remembered is a tool that gets skipped, so it prints itself here.
#
# Never fails the report: the roster verdict above is what callers key on, so the
# exit status is restored either way.
boxstale=${FW_BOXSTALE:-$script_dir/boxstale.sh}
[ ! -r "$boxstale" ] || bash "$boxstale" || true
exit "$rc"
