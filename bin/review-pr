#!/usr/bin/env bash
# review-pr: run a PR's reviews through the delegate CLI, post one PR comment,
# and print a verdict digest for the orchestrator.
# A bare second review on a PR that already carries a review-pr comment for an
# earlier head at a different patch-id refuses with exit 2 before starting any
# job, and prints the scoped verify command with --since set to the last
# reviewed head. A rerun with the same patch-id is allowed, as is a retry of
# the same head. --full-rereview <reason> overrides the refusal for a re-plan
# or take-back, or a verify whose new findings show the repair needs a full
# review; the reason is printed and stored in the posted comment header. A
# comment fetch failure exits 1; rerun once the API is reachable.
# Usage:
#   review-pr start <pr> --repo OWNER/NAME --cwd CLONE [--issue N]... [--spec N] --model M [--overbuild-model M2] [--axes LIST] [--context PATH]... [--workflow-doc PATH] [--head SHA] [--full-rereview REASON]
#     LIST is standards[,spec][,overbuild], default all three: one job per
#     axis. Review mode fetches the diff and tickets into each review worktree.
#     --overbuild-model is required only when overbuild is listed.
#     --full-rereview is review mode only; it skips the comment check.
#   review-pr start <pr> --repo OWNER/NAME --cwd CLONE --model M --verify FINDINGS_FILE --since SHA [--context PATH]... [--workflow-doc PATH] [--head SHA]
#     --since is the reviewed head; verify diffs from its repair base on current base.
#     launches one job per review role, prints "<role> <job-id>" per job, then
#     "watch: delegate watch <id>..." and "collect: review-pr collect <id>..."
#     with every id spelled out, and returns at once. Wait for the ids with the
#     delegation tool's wait command (delegate watch), in the wait mode your
#     harness instructions prescribe.
#     --verify ignores --issue, --spec and --overbuild-model, one stderr note each
#     (--axes too, when passed).
#   review-pr collect <job-id>... [--findings-out PATH]
#     posts the one PR comment with the patch-id, prints the verdict digest,
#     writes the open findings (or "no open findings") to PATH when asked,
#     removes finished worktrees, keeps each UNFINISHED job's worktree and
#     state file, and prints its "resume: delegate resume <id>" command. It
#     exits 1 when any job is unfinished or wrote a verdict outside the shared
#     vocabulary below. An already-collected job id reprints its verdict and
#     finding lines from the job record, writes --findings-out the same way,
#     and posts nothing.
#   review-pr run <same args as start>
#     start, then delegate watch on every job id start launched, then collect on
#     those ids. Prints start's lines, then collect's output, and exits with
#     collect's code. If the watch times out or fails it exits non-zero after
#     printing the ids and the "collect: review-pr collect <id>..." line, so the
#     caller can resume with collect. Use start and collect instead when the
#     caller must do other work while the reviews run.
set -euo pipefail

# Verdict vocabulary. This block is the one place every verdict line the
# parser accepts is defined; the review briefs and the review skills state
# the same lines.
#   standards role: VERDICT standards: APPROVE|CHANGES
#   spec role:      VERDICT spec: APPROVE|CHANGES
#   overbuild role: VERDICT: APPROVE|CHANGES
# (collect prints the overbuild verdict as VERDICT overbuild: APPROVE|CHANGES.)
#   verify role:    FIX-OK | FIX-INCOMPLETE (trailing detail allowed)
# Verdict lines must start with the form below (after normalisation).
# Matching tolerates decoration: leading/trailing whitespace, **bold**, `code`.
# A line that starts with VERDICT or FIX- but matches none of these is a bad
# verdict: loud failure, never UNFINISHED.

usage() {
  echo "usage: review-pr start <pr> --repo OWNER/NAME --cwd CLONE [--issue N]... [--spec N] --model M [--overbuild-model M2] [--axes standards[,spec][,overbuild]] [--context PATH]... [--workflow-doc PATH] [--head SHA] [--full-rereview REASON]" >&2
  echo "       review-pr start <pr> --repo OWNER/NAME --cwd CLONE --model M --verify FINDINGS_FILE --since SHA [--context PATH]... [--workflow-doc PATH] [--head SHA]" >&2
  echo "       review-pr run <same args as start>" >&2
  echo "       review-pr collect <job-id>... [--findings-out PATH]" >&2
  exit 2
}

script_dir="$(cd "$(dirname "$0")" && pwd)"
skills_dir="$(dirname "$script_dir")/skills"
briefs_dir="$skills_dir/review-loop/briefs"
fill_brief="$script_dir/fill-brief"
# job_rec ID: print the winning job-record path, or nothing; it never fails,
# so a missing record reads as "no record" under set -e.
job_rec() {
  bash "$script_dir/job-record" "$1" 2>/dev/null || true
}
state_dir="${TMPDIR:-/tmp}/review-pr"
run_root="${REVIEW_PR_RUN_ROOT:-${XDG_CACHE_HOME:-$HOME/.cache}/review-pr-runs}"

# A finished run nobody collected is pruned an hour after its jobs end; a run
# with no job records falls back to the state-file age below. The state file's
# mtime is the run's start time, the job record's mtime is when the job
# finished.
stale_run_mins=360
finished_run_mins=60

brief_for() {
  case "$1" in
    standards) printf '%s' "$briefs_dir/standards.md";;
    spec) printf '%s' "$briefs_dir/spec.md";;
    overbuild) printf '%s' "$briefs_dir/over-engineering-review.md";;
    verify) printf '%s' "$briefs_dir/verify.md";;
  esac
}

# norm_line: strip verdict decoration (asterisks, backticks) and trim
# surrounding whitespace, so decorated verdicts match the vocabulary.
norm_line() {
  printf '%s' "$1" | tr -d '*`' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}

# is_verdict ROLE NORMALISED_LINE: the line starts with a recognised verdict
# form (verify may have trailing detail after whitespace).
is_verdict() {
  case "$1" in
    standards)
      case "$2" in
        "VERDICT standards: APPROVE"|"VERDICT standards: CHANGES") return 0;;
      esac
      return 1;;
    spec)
      case "$2" in
        "VERDICT spec: APPROVE"|"VERDICT spec: CHANGES") return 0;;
      esac
      return 1;;
    overbuild)
      case "$2" in
        "VERDICT: APPROVE"|"VERDICT: CHANGES") return 0;;
      esac
      return 1;;
    verify)
      case "$2" in
        FIX-OK|FIX-OK[[:space:]]*|\
        FIX-INCOMPLETE|FIX-INCOMPLETE[[:space:]]*) return 0;;
      esac
      return 1;;
  esac
  return 1
}

# looks_like_verdict NORMALISED_LINE: the line starts with a verdict shape
# that does not match a recognised form. Shape is VERDICT with an optional
# single word, then a colon and a value (VERDICT: X, VERDICT spec: X), or
# FIX- followed by an uppercase word.
looks_like_verdict() {
  printf '%s' "$1" | grep -Eq '^VERDICT([[:space:]]+[A-Za-z0-9_*-]+)?[[:space:]]*:[[:space:]]*[^[:space:]]|^FIX-[A-Z]+'
}

state_get() {
  # state_get FILE KEY: print the value of a KEY=VALUE line in a state file.
  sed -n "s/^$2=//p" "$1" | head -1
}

ci_state() {
  # ci_state REPO SHA: fail, pending, cancelled, pass or none, from the check
  # runs on commit SHA (the reviewed head, not the PR's current one). Each check
  # name counts its latest run (started_at, then id). Precedence: fail >
  # pending > cancelled > pass. An empty SHA, no runs or an API error is none.
  local runs
  [ -n "$2" ] || { printf 'none'; return 0; }
  runs="$(gh api --paginate --jq '.check_runs[] | [.name, .status, (.conclusion // ""), (.started_at // ""), (.id | tostring)] | @tsv' "repos/$1/commits/$2/check-runs" 2>/dev/null)" || { printf 'none'; return 0; }
  printf '%s\n' "$runs" | awk -F'\t' '
    NF >= 5 && (!($1 in ts) || $4 > ts[$1] || ($4 == ts[$1] && $5 + 0 > id[$1] + 0)) {
      ts[$1] = $4; id[$1] = $5; stt[$1] = $2; concl[$1] = $3
    }
    END {
      found = 0; best = 0
      for (n in ts) {
        found = 1
        if (stt[n] != "completed") r = 3
        else if (concl[n] == "failure" || concl[n] == "timed_out" || concl[n] == "action_required") r = 4
        else if (concl[n] == "cancelled") r = 2
        else if (concl[n] == "success" || concl[n] == "skipped" || concl[n] == "neutral") r = 1
        else r = 3
        if (r > best) best = r
      }
      if (!found) printf "none"
      else if (best == 4) printf "fail"
      else if (best == 3) printf "pending"
      else if (best == 2) printf "cancelled"
      else printf "pass"
    }'
}

last_review_header() {
  # last_review_header REPO PR: print "<head> <patch-id>" for the newest
  # review-pr comment header, or nothing when no comment matches. Newest is by
  # created_at, then numeric id, never by output order. A first line that does
  # not match the review-pr header shape is skipped, so a malformed newest
  # falls back to the next valid one. Non-zero only when gh api itself fails,
  # so an empty history or a history with no valid header is not an error.
  local repo="$1" pr="$2"
  local rows api_rc=0
  rows="$(gh api --paginate --jq '.[] | select(.body | startswith("review-pr: patch-id")) | [.created_at, (.id | tostring), (.body | split("\n")[0])] | @tsv' "repos/$repo/issues/$pr/comments")" || api_rc=$?
  if [ "$api_rc" -ne 0 ]; then return 1; fi
  [ -n "$rows" ] || return 0
  local last
  last="$(printf '%s\n' "$rows" | sort -t "$(printf '\t')" -k1,1 -k2,2n | { grep -E 'review-pr: patch-id ([0-9a-f]+|none), head [0-9a-f]{40}(,.*)?$' || true; } | tail -n 1)"
  [ -n "$last" ] || return 0
  local header
  header="$(printf '%s' "$last" | cut -f3-)"
  [ -n "$header" ] || return 0
  local pid headv
  pid="$(printf '%s' "$header" | sed -n 's/^review-pr: patch-id \([^,]*\), head .*/\1/p')"
  headv="$(printf '%s' "$header" | sed -n 's/^review-pr: patch-id [^,]*, head \([0-9a-f]\{40\}\).*/\1/p')"
  [ -n "$pid" ] && [ -n "$headv" ] || return 0
  printf '%s %s' "$headv" "$pid"
}

ci_display() {
  # ci_display REPO PR SHA: ci_state, but a draft PR never prints a bare pass.
  # A draft prints draft, or draft-fail when a check run failed. A failed
  # isDraft lookup reports none when ci_state would otherwise report pass.
  local ci draft
  ci="$(ci_state "$1" "$3")"
  draft="$(gh pr view "$2" --repo "$1" --json isDraft --jq .isDraft 2>/dev/null)"
  if [ "$draft" = true ]; then
    if [ "$ci" = fail ]; then ci=draft-fail; else ci=draft; fi
  elif [ "$draft" != false ] && [ "$ci" = pass ]; then
    ci=none
  fi
  printf '%s' "$ci"
}

# remove_state_worktree STATE_FILE: remove the worktree recorded in a state
# file and prune its registration. Callers silence output and tolerate failure.
remove_state_worktree() {
  local sf_rm wt wclone
  sf_rm="$1"
  wt="$(state_get "$sf_rm" worktree)"
  wclone="$(state_get "$sf_rm" clone)"
  [ -n "$wt" ] || return 0
  # Remove through the worktree itself, so its registration goes even
  # when the clone start ran in is gone.
  git -C "$wt" worktree remove --force "$wt" || rm -rf "$wt"
  if [ -n "$wclone" ] && [ -d "$wclone" ]; then
    git -C "$wclone" worktree prune
  fi
}

# prune_stale_runs: remove worktrees, run dirs and state files for runs nobody
# collected. A run is every state file sharing one run dir; it is pruned only
# when none of its jobs is RUNNING and each of its state files meets one of
# these: its job record exists with a non-RUNNING status and was last modified
# more than $finished_run_mins ago, or it has no job record and the state file
# was last modified more than $stale_run_mins ago. One live or young sibling
# spares the whole run. Best-effort: the call silences output and ignores
# failure, so nothing here silences itself.
# In collect's order: gather the stale state files, then remove every worktree,
# then the guarded run dirs, then the state files.
prune_stale_runs() {
  local sf all_list old_list stale_list done_list rd sib sib_rd sib_rec sib_status run_ok
  [ -d "$state_dir" ] || return 0
  all_list="$(mktemp "${TMPDIR:-/tmp}/review-pr.prune-all.XXXXXX")"
  old_list="$(mktemp "${TMPDIR:-/tmp}/review-pr.prune-old.XXXXXX")"
  stale_list="$(mktemp "${TMPDIR:-/tmp}/review-pr.prune.XXXXXX")"
  done_list="$(mktemp "${TMPDIR:-/tmp}/review-pr.prune-done.XXXXXX")"
  find "$state_dir" -type f >"$all_list"
  find "$state_dir" -type f -mmin "+$stale_run_mins" >"$old_list"
  # sib_stale SIB: the sibling meets one prunable arm (its winning record has
  # a non-RUNNING status and is older than $finished_run_mins, or no record
  # and a state file older than $stale_run_mins).
  sib_stale() {
    sib_rec="$(job_rec "${1##*/}")"
    if [ -n "$sib_rec" ]; then
      sib_status="$(jq -r '.status // "MISSING"' "$sib_rec" || echo MISSING)"
      [ "$sib_status" = "RUNNING" ] && return 1
      [ -n "$(find "$sib_rec" -type f -mmin "+$finished_run_mins" 2>/dev/null || true)" ] || return 1
      return 0
    fi
    grep -Fxq "$1" "$old_list" || return 1
    return 0
  }
  while IFS= read -r sf; do
    [ -n "$sf" ] || continue
    rd="$(state_get "$sf" run_dir)"
    if [ -z "$rd" ]; then
      sib_stale "$sf" || continue
      grep -Fxq "$sf" "$stale_list" || printf '%s\n' "$sf" >>"$stale_list"
      continue
    fi
    grep -Fxq "$rd" "$done_list" && continue
    printf '%s\n' "$rd" >>"$done_list"
    run_ok=1
    while IFS= read -r sib; do
      [ -n "$sib" ] || continue
      sib_rd="$(state_get "$sib" run_dir)"
      [ "$sib_rd" = "$rd" ] || continue
      sib_stale "$sib" || { run_ok=0; break; }
    done <"$all_list"
    [ "$run_ok" -eq 1 ] || continue
    while IFS= read -r sib; do
      [ -n "$sib" ] || continue
      [ "$(state_get "$sib" run_dir)" = "$rd" ] || continue
      grep -Fxq "$sib" "$stale_list" || printf '%s\n' "$sib" >>"$stale_list"
    done <"$all_list"
  done <"$all_list"
  while IFS= read -r sf; do
    [ -n "$sf" ] || continue
    remove_state_worktree "$sf"
  done <"$stale_list"
  while IFS= read -r sf; do
    [ -n "$sf" ] || continue
    rd="$(state_get "$sf" run_dir)"
    case "$rd" in "$run_root"/review-pr.run.*) rm -rf "$rd";; esac
  done <"$stale_list"
  while IFS= read -r sf; do
    [ -n "$sf" ] || continue
    rm -f "$sf"
  done <"$stale_list"
  rm -f "$stale_list" "$all_list" "$old_list" "$done_list"
  return 0
}

cmd_start() {
  [ $# -ge 1 ] || usage
  pr="$1"; shift
  case "$pr" in -*|"") usage;; esac

  repo=""; clone=""; issues=(); issue_count=0; specn=""; model=""; omodel=""
  verify=""; since=""; wdoc=""; head=""; axes=""; axes_given=""; context_files=()
  full_rereview=""; full_rereview_given=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) [ $# -ge 2 ] || usage; repo="$2"; shift 2;;
      --cwd) [ $# -ge 2 ] || usage; clone="$2"; shift 2;;
      --issue)
        [ $# -ge 2 ] || usage
        issue_value="$2"
        case "$issue_value" in ""|*[!0-9]*) usage;; esac
        issue_found=""
        issue_index=0
        while [ "$issue_index" -lt "$issue_count" ]; do
          if [ "${issues[$issue_index]}" = "$issue_value" ]; then
            issue_found="1"
            break
          fi
          issue_index=$((issue_index + 1))
        done
        if [ -z "$issue_found" ]; then
          issues[$issue_count]="$issue_value"
          issue_count=$((issue_count + 1))
        fi
        shift 2;;
      --spec) [ $# -ge 2 ] || usage; specn="$2"; shift 2;;
      --model) [ $# -ge 2 ] || usage; model="$2"; shift 2;;
      --overbuild-model) [ $# -ge 2 ] || usage; omodel="$2"; shift 2;;
      --axes) [ $# -ge 2 ] || usage; axes="$2"; axes_given="1"; shift 2;;
      --verify) [ $# -ge 2 ] || usage; verify="$2"; shift 2;;
      --since) [ $# -ge 2 ] || usage; since="$2"; shift 2;;
      --context) [ $# -ge 2 ] || usage; context_files[${#context_files[@]}]="$2"; shift 2;;
      --workflow-doc) [ $# -ge 2 ] || usage; wdoc="$2"; shift 2;;
      --head) [ $# -ge 2 ] || usage; head="$2"; shift 2;;
      --full-rereview) [ $# -ge 2 ] || usage; full_rereview="$2"; full_rereview_given="1"; shift 2;;
      *) usage;;
    esac
  done

  [ -n "$repo" ] || usage
  [ -n "$clone" ] && [ -d "$clone" ] || usage
  [ -n "$model" ] || usage
  if [ -n "$full_rereview_given" ]; then
    if ! printf '%s' "$full_rereview" | grep -q '[^[:space:]]'; then usage; fi
    case "$full_rereview" in
      *$'\n'*|*$'\r'*) usage;;
    esac
    case "$full_rereview" in -*) usage;; esac
    if [ -n "$verify" ]; then usage; fi
    echo "review-pr: full re-review: $full_rereview" >&2
  fi
  if [ -z "$axes" ]; then axes="standards,spec,overbuild"; fi
  # One job starts per listed axis; an unknown name is a usage error.
  axes_rest="$axes,"
  while [ -n "$axes_rest" ]; do
    ax="${axes_rest%%,*}"; axes_rest="${axes_rest#*,}"
    case "$ax" in
      standards|spec|overbuild) ;;
      *) echo "review-pr: unknown axis: $ax (standards, spec, overbuild)" >&2; exit 2;;
    esac
  done
  # Context files live outside the checkout, so each must exist before any worktree is created.
  for context_path in ${context_files[@]+"${context_files[@]}"}; do
    if [ ! -f "$context_path" ]; then
      echo "review-pr: --context file not found: $context_path" >&2
      exit 1
    fi
  done
  if [ -n "$verify" ]; then
    mode="verify"
    [ -n "$since" ] || usage
    # A short sha the clone holds is fine; one it lacks would fail late,
    # after fetches, so reject it now, before fetching.
    if ! printf '%s' "$since" | grep -Eq '^[0-9a-f]{40}$'; then
      if ! git -C "$clone" rev-parse --verify "$since^{commit}" >/dev/null 2>&1; then
        echo "review-pr: --since needs the full 40-character sha ($since is not in the clone)" >&2
        exit 2
      fi
    fi
    [ -f "$verify" ] || usage
    if ! grep -q '[^[:space:]]' "$verify"; then
      echo "review-pr: findings file $verify is empty; write the open findings, or \"no open findings\"" >&2
      exit 2
    fi
    # Start-only flags are ignored in verify mode, one note per flag.
    if [ "$issue_count" -gt 0 ]; then
      echo "review-pr: --issue is not used with --verify; ignored" >&2
    fi
    if [ -n "$specn" ]; then
      echo "review-pr: --spec is not used with --verify; ignored" >&2
    fi
    if [ -n "$omodel" ]; then
      echo "review-pr: --overbuild-model is not used with --verify; ignored" >&2
    fi
    if [ -n "$axes_given" ]; then
      echo "review-pr: --axes is not used with --verify; ignored" >&2
    fi
  else
    mode="review"
    # --overbuild-model is required only when the overbuild axis runs.
    case ",$axes," in
      *,overbuild,*) [ -n "$omodel" ] || usage;;
    esac
    # A PR with no ticket is its own spec: gh issue view accepts a PR number.
    # Otherwise SPEC defaults to the first --issue, never the PR number.
    if [ "$issue_count" -eq 0 ]; then
      issue="$pr"
      specn="${specn:-$pr}"
    else
      specn="${specn:-${issues[0]}}"
      issue="${issues[0]}"
      issue_index=1
      while [ "$issue_index" -lt "$issue_count" ]; do
        issue_value="${issues[$issue_index]}"
        if [ "$issue_index" -eq "$((issue_count - 1))" ]; then
          issue="$issue and #$issue_value"
        else
          issue="$issue, #$issue_value"
        fi
        issue_index=$((issue_index + 1))
      done
    fi
    [ -z "$since" ] || usage
  fi
  if [ -z "$wdoc" ]; then wdoc="none"; fi
  if [ -n "$head" ]; then
    if ! printf '%s' "$head" | grep -Eq '^[0-9a-f]{40}$'; then
      echo 'review-pr: --head needs the full 40-character SHA (git rev-parse <sha>)' >&2
      exit 2
    fi
  fi
  # An issue number would otherwise wait out the --head loop below.
  if ! pr_err="$(gh pr view "$pr" --repo "$repo" --json number 2>&1 >/dev/null)"; then
    case "$pr_err" in
      *"Could not resolve to a PullRequest"*)
        echo "review-pr: #$pr is not a pull request in $repo (an issue number?)" >&2
        exit 2;;
    esac
  fi

  if [ "$mode" = "review" ]; then
    roles=""
    axes_rest="$axes,"
    while [ -n "$axes_rest" ]; do
      ax="${axes_rest%%,*}"; axes_rest="${axes_rest#*,}"
      case " $roles " in *" $ax "*) ;; *) roles="$roles $ax";; esac
    done
    roles="${roles# }"
  else
    roles="verify"
  fi
  model_for() {
    case "$1" in
      standards|spec|verify) printf '%s' "$model";;
      overbuild) printf '%s' "$omodel";;
    esac
  }

  if [ -n "$head" ]; then
    # Wait for the API to report the head the caller pushed; create nothing
    # until it does.
    sha="$head"
    waited=0
    while :; do
      api_head="$(gh pr view "$pr" --repo "$repo" --json headRefOid 2>/dev/null | jq -r '.headRefOid // empty' 2>/dev/null)" || api_head=""
      [ "$api_head" = "$head" ] && break
      if [ "$waited" -ge 30 ]; then
        echo "review-pr: PR $pr head is ${api_head:-none}, expected $head; gave up after 60s" >&2
        exit 1
      fi
      sleep 2
      waited=$((waited + 1))
    done
  else
    sha="$(gh pr view "$pr" --repo "$repo" --json headRefOid | jq -r .headRefOid)"
    if [ -z "$sha" ] || [ "$sha" = "null" ]; then
      echo "review-pr: no head SHA for PR $pr in $repo" >&2
      exit 1
    fi

    # Patch-id of the diff the reviews will see, taken before they start.
    patch_id="$(gh pr diff "$pr" --repo "$repo" | git patch-id --stable | awk '{print $1}')"
    if [ -z "$patch_id" ]; then patch_id="none"; fi
  fi

  prune_stale_runs >/dev/null 2>&1 || true

  mkdir -p "$state_dir"
  mkdir -p "$run_root"
  run_dir="$(mktemp -d "$run_root/review-pr.run.XXXXXX")"

  started_ok=""
  wt_list=()
  launched=()
  cleanup_on_fail() {
    if [ -z "$started_ok" ]; then
      for wt in ${wt_list[@]+"${wt_list[@]}"}; do
        skip=""
        for l in ${launched[@]+"${launched[@]}"}; do
          [ "$l" = "$wt" ] && skip="1"
        done
        [ -n "$skip" ] && continue
        git -C "$clone" worktree remove --force "$wt" >/dev/null 2>&1 || rm -rf "$wt"
      done
      if [ "${#launched[@]}" -eq 0 ]; then rm -rf "$run_dir"; fi
    fi
  }
  trap cleanup_on_fail EXIT

  git -C "$clone" fetch origin "pull/$pr/head" >&2

  if [ -n "$head" ]; then
    if ! git -C "$clone" cat-file -e "$head^{commit}" 2>/dev/null; then
      git -C "$clone" fetch origin "$head" >&2 || true
    fi
    if ! git -C "$clone" cat-file -e "$head^{commit}" 2>/dev/null; then
      echo "review-pr: expected head $head is not fetchable for PR $pr" >&2
      exit 1
    fi
    # Patch-id from the same state the reviews check out: the merge-base diff
    # against a freshly fetched base tip, as GitHub shows it.
    base="$(gh pr view "$pr" --repo "$repo" --json baseRefName | jq -r .baseRefName)"
    git -C "$clone" fetch origin "$base" >&2
    base_tip="$(git -C "$clone" rev-parse FETCH_HEAD)"
    patch_id="$(git -C "$clone" diff "$base_tip...$head" | git patch-id --stable | awk '{print $1}')"
    if [ -z "$patch_id" ]; then patch_id="none"; fi
  elif [ "$mode" = "verify" ]; then
    base="$(gh pr view "$pr" --repo "$repo" --json baseRefName | jq -r .baseRefName)"
    if [ -z "$base" ] || [ "$base" = "null" ]; then
      echo "review-pr: no base branch for PR $pr in $repo" >&2
      exit 1
    fi
    git -C "$clone" fetch origin "$base" >&2
    base_tip="$(git -C "$clone" rev-parse FETCH_HEAD)"
  fi

  if [ "$mode" = "review" ] && [ -z "$full_rereview_given" ]; then
    prior=""
    if ! prior="$(last_review_header "$repo" "$pr")"; then
      echo "review-pr: could not read PR comments (gh api failed); not starting a review. Rerun once the API is reachable." >&2
      exit 1
    fi
    if [ -n "$prior" ]; then
      prior_head="${prior%% *}"
      prior_pid="${prior#* }"
      if [ "$prior_head" != "$sha" ]; then
        refuse=""
        if [ "$prior_pid" = "none" ] || [ "$patch_id" = "none" ]; then
          refuse="1"
        elif [ "$prior_pid" != "$patch_id" ]; then
          refuse="1"
        fi
        if [ -n "$refuse" ]; then
          echo "review-pr: PR $pr already has a review for head $prior_head (patch-id $prior_pid); a bare re-run reviews the whole PR again. Run the scoped verify: review-pr run $pr --repo $repo --cwd $clone --model $model --verify <findings file> --since $prior_head   (a re-plan or take-back may override with --full-rereview <reason>)" >&2
          exit 2
        fi
      fi
    fi
  fi

  if [ "$mode" = "review" ]; then
    review_context="$run_dir/review-context"
    mkdir -p "$review_context"
    if ! gh pr diff "$pr" --repo "$repo" >"$review_context/pr.diff"; then
      echo "review-pr: could not fetch the diff of PR $pr" >&2
      exit 1
    fi
    if [ ! -s "$review_context/pr.diff" ]; then
      echo "review-pr: could not fetch the diff of PR $pr" >&2
      exit 1
    fi
    if ! gh pr view "$pr" --repo "$repo" --json body -q .body >"$review_context/pr-body.md"; then
      echo "review-pr: could not fetch the body of PR $pr" >&2
      exit 1
    fi
    if ! grep -q '[^[:space:]]' "$review_context/pr-body.md"; then
      rm -f "$review_context/pr-body.md"
    fi

    ticket_numbers=()
    if [ "$issue_count" -eq 0 ]; then
      ticket_numbers[0]="$pr"
    else
      issue_index=0
      while [ "$issue_index" -lt "$issue_count" ]; do
        ticket_numbers[${#ticket_numbers[@]}]="${issues[$issue_index]}"
        issue_index=$((issue_index + 1))
      done
    fi
    case " ${ticket_numbers[*]} " in
      *" $specn "*) ;;
      *) ticket_numbers[${#ticket_numbers[@]}]="$specn";;
    esac
    case ",$axes," in
      *,spec,*|*,overbuild,*)
        for ticket_n in "${ticket_numbers[@]}"; do
          ticket_file="$review_context/issue-$ticket_n.md"
          if ! gh issue view "$ticket_n" --repo "$repo" >"$ticket_file"; then
            echo "review-pr: could not fetch ticket #$ticket_n body" >&2
            exit 1
          fi
          if ! gh issue view "$ticket_n" --repo "$repo" --comments >>"$ticket_file"; then
            echo "review-pr: could not fetch ticket #$ticket_n comments" >&2
            exit 1
          fi
        done
        ;;
    esac
  fi

  if [ "$mode" = "verify" ]; then
    if ! git -C "$clone" cat-file -e "$since^{commit}" 2>/dev/null; then
      git -C "$clone" fetch origin "$since" >&2 || true
    fi
    if ! git -C "$clone" cat-file -e "$since^{commit}" 2>/dev/null; then
      echo "review-pr: --since $since is not fetchable for PR $pr" >&2
      exit 1
    fi
    since_full="$(git -C "$clone" rev-parse --verify "$since^{commit}")"
    if ! old_mb="$(git -C "$clone" merge-base "$since_full" "$base_tip")"; then
      echo "review-pr: cannot find the old merge-base for --since $since_full and $base_tip" >&2
      exit 1
    fi
    if ! new_mb="$(git -C "$clone" merge-base "$sha" "$base_tip")"; then
      echo "review-pr: cannot find the new merge-base for $sha and $base_tip" >&2
      exit 1
    fi
    if [ "$old_mb" = "$new_mb" ]; then
      repair_base="$since_full"
    else
      if merge_output="$(git -C "$clone" merge-tree --write-tree --no-messages \
        --merge-base="$old_mb" "$new_mb" "$since_full")"; then
        merge_status=0
      else
        merge_status=$?
      fi
      if [ "$merge_status" -gt 1 ]; then
        echo "review-pr: could not replay --since $since_full onto $new_mb" >&2
        exit 1
      fi
      replay_tree="${merge_output%%$'\n'*}"
      if ! git -C "$clone" cat-file -e "$replay_tree^{tree}" 2>/dev/null; then
        echo "review-pr: git merge-tree returned no replay tree for --since $since_full" >&2
        exit 1
      fi
      repair_base="$(printf '%s\n' 'review-pr repair base' | \
        GIT_AUTHOR_NAME=review-pr GIT_AUTHOR_EMAIL=review-pr@localhost \
        GIT_COMMITTER_NAME=review-pr GIT_COMMITTER_EMAIL=review-pr@localhost \
        git -C "$clone" commit-tree "$replay_tree" -p "$new_mb" -p "$since_full")"
      if [ "$merge_status" -eq 1 ]; then
        echo "review-pr: $since_full does not replay cleanly onto $new_mb; the repair diff includes the rebase's conflict resolution" >&2
      fi
    fi
    echo "review-pr: repair base $repair_base ($since_full replayed onto $new_mb)" >&2
    since="$repair_base"
  fi

  jids=""
  started_ids=()
  for role in $roles; do
    wt="$run_dir/wt-$role"
    git -C "$clone" worktree add --detach "$wt" "$sha" >&2
    wt_list[${#wt_list[@]}]="$wt"

    brief_src="$(brief_for "$role")"
    brief="$run_dir/brief-$role.md"
    case "$role" in
      standards)
        bash "$fill_brief" "$brief_src" "PR=$pr" "REPO=$repo" \
          "DIFF_FILE=.review-context/pr.diff" "SKILLS=$skills_dir" "WORKFLOW_DOC=$wdoc" >"$brief"
        ;;
      spec)
        ticket_files=""
        for ticket_n in "${ticket_numbers[@]}"; do
          ticket_files="${ticket_files}${ticket_files:+ }.review-context/issue-$ticket_n.md"
        done
        bash "$fill_brief" "$brief_src" "PR=$pr" "REPO=$repo" "ISSUE=$issue" \
          "SPEC=$specn" "DIFF_FILE=.review-context/pr.diff" "TICKET_FILES=$ticket_files" \
          "SKILLS=$skills_dir" "WORKFLOW_DOC=$wdoc" >"$brief"
        ;;
      overbuild)
        ticket_files=""
        for ticket_n in "${ticket_numbers[@]}"; do
          ticket_files="${ticket_files}${ticket_files:+ }.review-context/issue-$ticket_n.md"
        done
        bash "$fill_brief" "$brief_src" "PR=$pr" "REPO=$repo" \
          "DIFF_FILE=.review-context/pr.diff" "TICKET_FILES=$ticket_files" \
          "SKILLS=$skills_dir" >"$brief"
        ;;
      verify)
        bash "$fill_brief" "$brief_src" "PR=$pr" "REPO=$repo" "SKILLS=$skills_dir" \
          "SINCE=$since" "FINDINGS=@$verify" >"$brief"
        ;;
    esac
    if [ "$mode" = "review" ] && [ -f "$review_context/pr-body.md" ]; then
      printf "\nThe PR body is the lane's claim, not ground truth. Check evidence it cites; do not trust it.\nRead it at .review-context/pr-body.md.\n" >>"$brief"
    fi

    if [ "$mode" = "review" ]; then
      rm -rf "$wt/.review-context"
      mkdir -p "$wt/.review-context"
      cp "$review_context/pr.diff" "$wt/.review-context/pr.diff"
      if [ -f "$review_context/pr-body.md" ]; then
        cp "$review_context/pr-body.md" "$wt/.review-context/pr-body.md"
      fi
      case "$role" in
        spec|overbuild)
          for ticket_n in "${ticket_numbers[@]}"; do
            cp "$review_context/issue-$ticket_n.md" "$wt/.review-context/issue-$ticket_n.md"
          done
          ;;
      esac
    fi
    # Context files live outside the checkout; copy them into each reviewer
    # worktree and list their paths in the brief.
    if [ "${#context_files[@]}" -gt 0 ]; then
      mkdir -p "$wt/.review-context"
      {
        printf '\nContext files outside the checkout, copied into your working directory (read them as needed):\n'
        for context_path in ${context_files[@]+"${context_files[@]}"}; do
          context_base="$(basename "$context_path")"
          context_dest="$context_base"
          context_n=1
          while [ -e "$wt/.review-context/$context_dest" ]; do
            context_dest="$context_n-$context_base"
            context_n=$((context_n + 1))
          done
          cp "$context_path" "$wt/.review-context/$context_dest"
          printf '.review-context/%s\n' "$context_dest"
        done
      } >>"$brief"
    fi

    echo "review-pr: starting $role job ($(model_for "$role"))" >&2
    jid="$(delegate run --model "$(model_for "$role")" --cwd "$wt" --prompt-file "$brief")"
    jid="${jid%%$'\n'*}"

    {
      printf 'role=%s\n' "$role"
      printf 'repo=%s\n' "$repo"
      printf 'pr=%s\n' "$pr"
      printf 'sha=%s\n' "$sha"
      printf 'patch_id=%s\n' "$patch_id"
      if [ -n "$full_rereview_given" ]; then
        printf 'full_rereview=%s\n' "$full_rereview"
      fi
      printf 'model=%s\n' "$(model_for "$role")"
      printf 'axes=%s\n' "$axes"
      printf 'clone=%s\n' "$clone"
      printf 'worktree=%s\n' "$wt"
      printf 'run_dir=%s\n' "$run_dir"
    } >"$state_dir/$jid"
    launched[${#launched[@]}]="$wt"

    printf '%s %s\n' "$role" "$jid"
    jids="$jids $jid"
    started_ids[${#started_ids[@]}]="$jid"
  done
  printf 'watch: delegate watch%s\n' "$jids"
  printf 'collect: review-pr collect%s\n' "$jids"

  started_ok="1"
  trap - EXIT
}

# cmd_run: start, wait on the ids start launched, then collect them. Calls
# start and collect in-process; the ids come from started_ids, not from
# start's stdout.
cmd_run() {
  cmd_start "$@"
  local watch_rc=0 ids
  delegate watch ${started_ids[@]+"${started_ids[@]}"} >/dev/null || watch_rc=$?
  if [ "$watch_rc" -ne 0 ]; then
    ids="${started_ids[*]}"
    echo "review-pr: delegate watch did not finish (exit $watch_rc); the jobs may still be running. Resume with:" >&2
    echo "collect: review-pr collect $ids" >&2
    exit "$watch_rc"
  fi
  cmd_collect ${started_ids[@]+"${started_ids[@]}"}
}

# write_findings PATH SRC: write the open findings to PATH: the P1-P3 lines of
# SRC, one per line, or "no open findings". Shared by collect's main path and
# its reprint of collected jobs, so both write the same shape.
write_findings() {
  findings_dir="$(dirname "$1")"
  case "$findings_dir" in ""|".") ;; *) mkdir -p "$findings_dir";; esac
  if grep -q '^P[123] ' "$2" 2>/dev/null; then
    grep '^P[123] ' "$2" >"$1"
  else
    printf 'no open findings\n' >"$1"
  fi
}

# reprint_collected SRC JOB_ID...: an id with no state file but a job record was
# collected before. Reprint its verdict and finding lines from the record, in
# argument order, and append its P1-P3 lines to SRC for write_findings. Posts
# and removes nothing.
reprint_collected() {
  src_f="$1"; shift
  for jid in "$@"; do
    rec="$(job_rec "$jid")"
    if [ -f "$state_dir/$jid" ] || [ ! -f "$rec" ]; then
      continue
    fi
    printf 'COLLECTED %s %s: already posted to the PR; findings reprinted from the job record, nothing posted\n' "$jid" "$rec"
    text="$(jq -r '.result.text // empty' "$rec" 2>/dev/null || true)"
    while IFS= read -r line; do
      norm="$(norm_line "$line")"
      case "$norm" in
        VERDICT*|FIX-*) printf '%s\n' "$line";;
      esac
      case "$line" in
        P1\ *|P2\ *|P3\ *) printf '%s\n' "$line"; printf '%s\n' "$line" >>"$src_f";;
      esac
    done <<<"$text"
  done
}

cmd_collect() {
  findings_out=""
  ids=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --findings-out)
        [ $# -ge 2 ] || usage
        [ -z "$findings_out" ] || usage
        findings_out="$2"; shift 2
        case "$findings_out" in ""|-*) usage;; esac;;
      -*|"") usage;;
      *) ids[${#ids[@]}]="$1"; shift;;
    esac
  done
  [ "${#ids[@]}" -ge 1 ] || usage
  set -- "${ids[@]}"

  tmp="$(mktemp -d "${TMPDIR:-/tmp}/review-pr.collect.XXXXXX")"
  state_rm=()
  kept_state=()
  cleanup_keep=()
  group_dirs=()
  group_ids=()
  group_state_ids=()
  group_first_state=()
  group_posted=()
  posted_ok=""
  collect_complete=""
  cleanup() {
    if [ -n "$collect_complete" ]; then
      for sf in ${state_rm[@]+"${state_rm[@]}"}; do
        keep=""
        for ksf in ${cleanup_keep[@]+"${cleanup_keep[@]}"}; do
          [ "$sf" = "$ksf" ] && { keep="1"; break; }
        done
        [ -n "$keep" ] || remove_state_worktree "$sf" || true
      done
      for rd in ${group_dirs[@]+"${group_dirs[@]}"}; do
        [ -n "$rd" ] || continue
        has_kept=""
        for ksf in ${cleanup_keep[@]+"${cleanup_keep[@]}"}; do
          [ "$(state_get "$ksf" run_dir 2>/dev/null || true)" = "$rd" ] && has_kept="1"
        done
        case "$rd" in
          "$run_root"/review-pr.run.*)
            if [ -z "$has_kept" ]; then
              rm -rf "$rd"
            else
              for entry in "$rd"/* "$rd"/.[!.]* "$rd"/..?*; do
                [ -e "$entry" ] || [ -L "$entry" ] || continue
                entry_kept=""
                for ksf in ${cleanup_keep[@]+"${cleanup_keep[@]}"}; do
                  [ "$entry" = "$(state_get "$ksf" worktree 2>/dev/null || true)" ] && entry_kept="1"
                done
                [ -n "$entry_kept" ] || rm -rf "$entry"
              done
            fi
            ;;
        esac
      done
      for sf in ${state_rm[@]+"${state_rm[@]}"}; do
        keep=""
        for ksf in ${cleanup_keep[@]+"${cleanup_keep[@]}"}; do
          [ "$sf" = "$ksf" ] && { keep="1"; break; }
        done
        [ -n "$keep" ] || rm -f "$sf"
      done
    else
      for sf in ${state_rm[@]+"${state_rm[@]}"}; do
        remove_state_worktree "$sf" || true
      done
      for sf in ${state_rm[@]+"${state_rm[@]}"}; do
        rd="$(state_get "$sf" run_dir 2>/dev/null || true)"
        case "$rd" in "$run_root"/review-pr.run.*) rm -rf "$rd";; esac
      done
      if [ -n "$posted_ok" ]; then
        for sf in ${state_rm[@]+"${state_rm[@]}"}; do
          rm -f "$sf"
        done
      fi
    fi
    rm -rf "$tmp"
  }
  trap cleanup EXIT

  # Collect groups are kept separate so a mixed call posts once per run.
  repo=""; pr=""; sha=""; patch_id=""; full_rereview=""
  group_keys=()
  id_list=()
  unknown_f="$tmp/unknown.txt"
  : >"$unknown_f"
  recollect=0
  reprint_f="$tmp/reprint.txt"
  : >"$reprint_f"
  for jid in "$@"; do
    case "$jid" in ""|-*) usage;; esac
    sf="$state_dir/$jid"
    if [ ! -f "$sf" ]; then
      rec="$(job_rec "$jid")"
      if [ -f "$rec" ]; then
        recollect=$((recollect + 1))
        continue
      fi
      printf 'UNFINISHED %s MISSING gate=none %s\n' "$jid" "$sf" >>"$unknown_f"
      continue
    fi
    state_rm[${#state_rm[@]}]="$sf"
    rd="$(state_get "$sf" run_dir)"
    group_key="$rd"
    [ -n "$group_key" ] || group_key="state:$jid"
    group_index=""
    gi=0
    while [ "$gi" -lt "${#group_keys[@]}" ]; do
      if [ "${group_keys[$gi]}" = "$group_key" ]; then
        group_index="$gi"
        break
      fi
      gi=$((gi + 1))
    done
    if [ -z "$group_index" ]; then
      group_index="${#group_keys[@]}"
      group_keys[$group_index]="$group_key"
      group_dirs[$group_index]="$rd"
      group_ids[$group_index]="$jid"
      group_state_ids[$group_index]="$jid"
      group_first_state[$group_index]="$sf"
      group_posted[$group_index]=""
      if [ -z "$pr" ]; then
        repo="$(state_get "$sf" repo)"
        pr="$(state_get "$sf" pr)"
        sha="$(state_get "$sf" sha)"
        patch_id="$(state_get "$sf" patch_id)"
        full_rereview="$(state_get "$sf" full_rereview)"
      fi
    else
      group_ids[$group_index]="${group_ids[$group_index]} $jid"
      group_state_ids[$group_index]="${group_state_ids[$group_index]} $jid"
    fi
    if [ "$(state_get "$sf" posted 2>/dev/null || true)" = "1" ]; then
      group_posted[$group_index]="1"
    fi
    id_list[${#id_list[@]}]="$jid"
  done

  if [ "$recollect" -gt 0 ]; then
    reprint_collected "$reprint_f" "$@"
    # Nothing left to post or remove: every id was collected before.
    if [ "${#id_list[@]}" -eq 0 ] && [ ! -s "$unknown_f" ]; then
      if [ -n "$findings_out" ]; then write_findings "$findings_out" "$reprint_f"; fi
      exit 0
    fi
  fi

  missing_axes_f="$tmp/missing-axes.txt"
  : >"$missing_axes_f"
  roles_ok=""
  expected_axes="standards,spec,overbuild"
  if [ "${#group_dirs[@]}" -gt 0 ]; then
    roles_ok="1"
    expected_axes="$(state_get "${group_first_state[0]}" axes)"
    [ -n "$expected_axes" ] || expected_axes="standards,spec,overbuild"
    for gi in ${!group_dirs[@]}; do
      g_standards=""; g_spec=""; g_overbuild=""; g_verify=""
      for jid in ${group_ids[$gi]}; do
        r="$(state_get "$state_dir/$jid" role)"
        case "$r" in
          standards) g_standards="1";;
          spec) g_spec="1";;
          overbuild) g_overbuild="1";;
          verify) g_verify="1";;
        esac
      done
      [ "${group_posted[$gi]}" = "1" ] && continue
      g_expected="$(state_get "${group_first_state[$gi]}" axes)"
      [ -n "$g_expected" ] || g_expected="standards,spec,overbuild"
      if [ -n "$g_verify" ] && [ -z "$g_standards" ] && [ -z "$g_spec" ] && [ -z "$g_overbuild" ]; then
        continue
      elif [ -z "$g_verify" ] && { [ -n "$g_standards" ] || [ -n "$g_spec" ] || [ -n "$g_overbuild" ]; }; then
        axes_rest="$g_expected,"
        while [ -n "$axes_rest" ]; do
          ax="${axes_rest%%,*}"; axes_rest="${axes_rest#*,}"
          have=""
          case "$ax" in
            standards) have="$g_standards";;
            spec) have="$g_spec";;
            overbuild) have="$g_overbuild";;
          esac
          if [ -z "$have" ]; then
            roles_ok=""
            printf 'UNFINISHED %s MISSING gate=none collect needs every role job id\n' "$ax" >>"$missing_axes_f"
          fi
        done
      else
        roles_ok=""
        printf 'UNFINISHED verify MIXED gate=none collect needs every role job id\n' >>"$missing_axes_f"
      fi
    done
  else
    printf 'UNFINISHED standards MISSING gate=none collect needs every role job id\n' >>"$missing_axes_f"
    printf 'UNFINISHED spec MISSING gate=none collect needs every role job id\n' >>"$missing_axes_f"
    printf 'UNFINISHED overbuild MISSING gate=none collect needs every role job id\n' >>"$missing_axes_f"
  fi
  short="unknown"
  if [ -n "$sha" ]; then short="${sha:0:8}"; fi
  if [ -z "$roles_ok" ]; then
    if [ -n "$pr" ] && [ -n "$repo" ]; then
      ci="$(ci_display "$repo" "$pr" "$sha")"
    else
      ci="none"
    fi
    printf 'patch-id %s\n' "${patch_id:-none}"
    printf 'CI %s %s\n' "$short" "$ci"
    cat "$unknown_f"
    cat "$missing_axes_f"
    # Caller error, not a finished run: keep every state file, worktree and
    # run dir (a sibling worktree lives in the same run dir) for the retry
    # with the full role set; only the scratch dir is removed by the trap.
    state_rm=()
    exit 1
  fi

  # A RUNNING role job has no verdict yet: say how to wait, post nothing
  # and remove nothing, so a later collect sees the finished verdicts.
  running=""
  for jid in ${id_list[@]+"${id_list[@]}"}; do
    rec="$(job_rec "$jid")"
    [ -f "$rec" ] || continue
    status="$(jq -r '.status // "MISSING"' "$rec" 2>/dev/null || echo MISSING)"
    if [ "$status" = "RUNNING" ]; then
      role="$(state_get "$state_dir/$jid" role)"
      printf 'RUNNING %s %s: wait with delegate watch %s\n' "$role" "$jid" "$*"
      running="1"
    fi
  done
  if [ -n "$running" ]; then
    # Readiness, not a finished run: keep every state file, worktree and
    # run dir for the retry; only the scratch dir is removed by the trap.
    state_rm=()
    exit 1
  fi

  for gi in ${!group_dirs[@]}; do
    if [ "${group_posted[$gi]}" = "1" ]; then
      for jid in ${group_state_ids[$gi]}; do
        sf="$state_dir/$jid"
        if [ "$(state_get "$sf" posted 2>/dev/null || true)" != "1" ]; then
          printf 'posted=1\n' >>"$sf"
        fi
      done
      continue
    fi
    first_state="${group_first_state[$gi]}"
    group_repo="$(state_get "$first_state" repo)"
    group_pr="$(state_get "$first_state" pr)"
    group_sha="$(state_get "$first_state" sha)"
    group_patch_id="$(state_get "$first_state" patch_id)"
    group_full_rereview="$(state_get "$first_state" full_rereview)"
    body="$tmp/comment-$gi.md"
    {
      if [ -n "$group_full_rereview" ]; then
        printf 'review-pr: patch-id %s, head %s, full-rereview: %s\n' \
          "${group_patch_id:-none}" "${group_sha:-unknown}" "$group_full_rereview"
      else
        printf 'review-pr: patch-id %s, head %s\n' "${group_patch_id:-none}" "${group_sha:-unknown}"
      fi
      for jid in ${group_state_ids[$gi]}; do
        role="$(state_get "$state_dir/$jid" role)"
        rmodel="$(state_get "$state_dir/$jid" model)"
        rec="$(job_rec "$jid")"
        text=""
        if [ -f "$rec" ]; then
          text="$(jq -r '.result.text // empty' "$rec" 2>/dev/null || true)"
        fi
        printf '\n## %s (%s)\n\n%s\n' "$role" "$rmodel" "$text"
      done
    } >"$body"
    if [ -n "$group_pr" ] && [ -n "$group_repo" ]; then
      gh pr comment "$group_pr" --repo "$group_repo" --body-file "$body" >&2
      for jid in ${group_state_ids[$gi]}; do
        sf="$state_dir/$jid"
        if [ "$(state_get "$sf" posted 2>/dev/null || true)" != "1" ]; then
          printf 'posted=1\n' >>"$sf"
        fi
      done
      group_posted[$gi]="1"
    else
      echo "review-pr: no saved state for these jobs, no comment posted" >&2
    fi
  done
  posted_ok="1"
  collect_complete="1"

  head_line="patch-id ${patch_id:-none}"

  verdicts_f="$tmp/verdicts.txt"
  bad_f="$tmp/bad.txt"
  unfinished_f="$tmp/unfinished.txt"
  : >"$verdicts_f"
  : >"$bad_f"
  : >"$unfinished_f"
  cat "$unknown_f" >>"$unfinished_f"
  unfinished="$(wc -l <"$unknown_f" | tr -d ' ')"
  bad=0
  for jid in ${id_list[@]+"${id_list[@]}"}; do
    sf="$state_dir/$jid"
    role="$(state_get "$sf" role)"
    rec="$(job_rec "$jid")"
    status="MISSING"; gate="none"; text=""
    if [ -f "$rec" ]; then
      status="$(jq -r '.status // "MISSING"' "$rec" 2>/dev/null || echo MISSING)"
      gate="$(jq -r '.result.gateResult.exitCode // "none"' "$rec" 2>/dev/null || echo none)"
      text="$(jq -r '.result.text // empty' "$rec" 2>/dev/null || true)"
    fi
    std_ok=""; spec_ok=""; ob_ok=""; fix_ok=""; role_bad=""
    if [ -n "$text" ]; then
      while IFS= read -r line; do
        norm="$(norm_line "$line")"
        [ -n "$norm" ] || continue
        if is_verdict "$role" "$norm"; then
          # Collect labels the overbuild verdict; the job still writes the
          # bare form above, and the PR comment keeps the job's full text.
          if [ "$role" = "overbuild" ]; then
            printf 'VERDICT overbuild:%s\n' "${norm#VERDICT:}" >>"$verdicts_f"
          else
            printf '%s\n' "$norm" >>"$verdicts_f"
          fi
          case "$role:$norm" in
            standards:"VERDICT standards: "*) std_ok="1";;
            spec:"VERDICT spec: "*) spec_ok="1";;
            overbuild:*) ob_ok="1";;
            verify:*) fix_ok="1";;
          esac
          continue
        fi
        if looks_like_verdict "$norm"; then
          printf 'BAD-VERDICT %s %s\n' "$role" "$norm" >>"$bad_f"
          role_bad="1"
          bad=$((bad + 1))
          continue
        fi
        case "$line" in
          P1\ *|P2\ *|P3\ *) printf '%s\n' "$line" >>"$verdicts_f";;
        esac
      done <<<"$text"
    fi
    # A reviewer with findings may end DONE_WITH_CONCERNS; its verdict still stands.
    if [ -n "$role_bad" ]; then
      : # a bad verdict fails loudly as BAD-VERDICT, never UNFINISHED
    elif [ "$status" != "DONE" ] && [ "$status" != "DONE_WITH_CONCERNS" ]; then
      reason_suffix=""
      if [ "$status" = "ERROR" ]; then
        reason="$(printf '%s\n' "$text" | sed -n 's/^[[:space:]]*//; /./{s/[[:space:]]*$//;p;q;}')"
        reason="$(printf '%.200s' "$reason")"
        if [ -n "$reason" ]; then
          reason_suffix=" reason: $reason"
        fi
      fi
      printf 'UNFINISHED %s %s gate=%s %s%s\n' "$role" "$status" "$gate" "$rec" "$reason_suffix" >>"$unfinished_f"
      kept_state[${#kept_state[@]}]="$sf"
      cleanup_keep[${#cleanup_keep[@]}]="$sf"
      unfinished=$((unfinished + 1))
    else
      complete=""
      case "$role" in
        standards) [ -n "$std_ok" ] && complete="1";;
        spec) [ -n "$spec_ok" ] && complete="1";;
        overbuild) [ -n "$ob_ok" ] && complete="1";;
        verify) [ -n "$fix_ok" ] && complete="1";;
      esac
      if [ -z "$complete" ]; then
        printf 'UNFINISHED %s %s gate=%s %s\n' "$role" "$status" "$gate" "$rec" >>"$unfinished_f"
        kept_state[${#kept_state[@]}]="$sf"
        cleanup_keep[${#cleanup_keep[@]}]="$sf"
        unfinished=$((unfinished + 1))
      fi
    fi
  done
  # Preserve unrequested siblings' state and worktrees while cleaning their
  # shared run directory. They are cleanup-only: comment groups and posted
  # markers above use requested ids only.
  all_state_files="$tmp/state-files.txt"
  find "$state_dir" -type f >"$all_state_files"
  for gi in ${!group_dirs[@]}; do
    rd="${group_dirs[$gi]}"
    [ -n "$rd" ] || continue
    while IFS= read -r sibling_sf; do
      [ -n "$sibling_sf" ] || continue
      [ "$(state_get "$sibling_sf" run_dir 2>/dev/null || true)" = "$rd" ] || continue
      requested=""
      for jid in ${id_list[@]+"${id_list[@]}"}; do
        [ "$sibling_sf" = "$state_dir/$jid" ] && requested="1"
      done
      [ -n "$requested" ] || cleanup_keep[${#cleanup_keep[@]}]="$sibling_sf"
    done <"$all_state_files"
  done

  if [ -n "$pr" ] && [ -n "$repo" ]; then
    ci="$(ci_display "$repo" "$pr" "$sha")"
  else
    ci="none"
  fi

  printf '%s\n' "$head_line"
  cat "$verdicts_f"
  printf 'CI %s %s\n' "$short" "$ci"
  cat "$bad_f"
  cat "$unfinished_f"
  for ksf in ${kept_state[@]+"${kept_state[@]}"}; do
    printf 'resume: delegate resume %s (on %s)\n' "${ksf##*/}" "$(hostname -s)"
  done

  # --findings-out feeds run --verify: the open findings, one per line, or
  # the no-findings line its empty-file check names.
  if [ -n "$findings_out" ]; then
    cat "$reprint_f" "$verdicts_f" >"$tmp/findings-src.txt"
    write_findings "$findings_out" "$tmp/findings-src.txt"
  fi

  if [ "$unfinished" -gt 0 ] || [ "$bad" -gt 0 ]; then exit 1; fi
  exit 0
}

[ $# -ge 1 ] || usage
sub="$1"; shift
case "$sub" in
  start) cmd_start "$@";;
  run) cmd_run "$@";;
  collect) cmd_collect "$@";;
  *) usage;;
esac
