#!/usr/bin/env bash
# tkt-verify: review an already-pushed head without starting a fix job.
# Usage: tkt-verify <state> --findings <file> [--verify-model <id>] [--ruling <comment id>]
set -euo pipefail

usage() {
  echo "usage: tkt-verify <state> --findings <file> [--verify-model <id>] [--ruling <comment id>]" >&2
  exit 2
}

[ $# -ge 3 ] || usage
state="$1"; shift
findings=""; verifymodel=""; ruling_id=""
while [ $# -gt 0 ]; do
  case "$1" in
    --findings) [ $# -ge 2 ] && [ -n "$2" ] || usage; findings="$2"; shift 2 ;;
    --verify-model) [ $# -ge 2 ] && [ -n "$2" ] || usage; verifymodel="$2"; shift 2 ;;
    --ruling) [ $# -ge 2 ] && [ -n "$2" ] && [ -z "$ruling_id" ] || usage; ruling_id="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[ -n "$findings" ] || usage

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
tkt_state="$script_dir/tkt-state"; bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then echo "tkt-verify: cannot read shared lib: $namebase_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$namebase_lib"
history_lib="$script_dir/lib/findings-history.sh"
if [ ! -r "$history_lib" ]; then echo "tkt-verify: cannot read shared lib: $history_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$history_lib"
ruling_comment_lib="$script_dir/lib/ruling-comment.sh"
if [ ! -r "$ruling_comment_lib" ]; then echo "tkt-verify: cannot read shared lib: $ruling_comment_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$ruling_comment_lib"
verify_section_lib="$script_dir/lib/verify-section.sh"
if [ ! -r "$verify_section_lib" ]; then echo "tkt-verify: cannot read shared lib: $verify_section_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$verify_section_lib"
review_verdict_lib="$script_dir/lib/review-verdict.sh"
if [ ! -r "$review_verdict_lib" ]; then echo "tkt-verify: cannot read shared lib: $review_verdict_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$review_verdict_lib"
reviewpr="$bin_dir/review-pr"
t() { "$tkt_state" "$state" "$@"; }

emit() {
  local message="$1" status="$2"
  shift 2
  printf 'TKT tkt-verify %s\n' "$message"
  [ "$#" -eq 0 ] || printf '%s\n' "$@"
  if [ -n "${grant_url:-}" ]; then
    printf 'Recorded ruling: %s\n' "$grant_url"
    printf 'add this line to the PR body.\n'
  fi
  exit "$status"
}

lockdir="$state.lock"
require_state_file tkt-verify "$state"
take_state_lock tkt-verify "$lockdir"
rmdir "$lockdir"

t require repo pr branch worktree run reviewed
repo="$(t get repo)"; pr="$(t get pr)"; branch="$(t get branch)"
worktree="$(t get worktree)"; run="$(t get run)"; reviewed="$(t get reviewed)"
[ -n "$verifymodel" ] || verifymodel="$(t get model.verify 2>/dev/null)" || {
  echo 'tkt-verify: missing key: model.verify (no --verify-model and no state model.verify)' >&2
  exit 2
}
[ -r "$findings" ] || { echo "tkt-verify: cannot read findings: $findings" >&2; exit 2; }

fixopen="$(t get fixopen 2>/dev/null || printf '0')"
case "$fixopen" in *[!0]*) emit "FIX-OPEN" 1 "finish the open fix job with tkt-fix before verifying" ;; esac

head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || emit "VERIFY-FAIL" 1 "cannot read worktree HEAD: $worktree"
state_head="$(t get head 2>/dev/null || true)"
if ! git -C "$worktree" fetch origin >/dev/null 2>&1; then
  emit "NOT-PUSHED" 1 "fetch failed; cannot confirm origin/$branch"
fi
origin_head="$(git -C "$worktree" rev-parse --verify "refs/remotes/origin/$branch" 2>/dev/null || true)"
[ "$head" = "$origin_head" ] || emit "NOT-PUSHED" 1 "worktree HEAD=$head origin/$branch=$origin_head"

pr_json="$(gh pr view "$pr" --repo "$repo" --json headRefOid 2>/dev/null)" || emit "VERIFY-FAIL" 1 "cannot read PR head: pr=$pr"
pr_head="$(jq -r '.headRefOid // empty' <<<"$pr_json" 2>/dev/null || true)"
[ "$head" = "$pr_head" ] || emit "PR-HEAD-MISMATCH" 1 "worktree HEAD=$head PR head=$pr_head"
[ "$head" != "$reviewed" ] || emit "NOTHING-TO-VERIFY" 1 "HEAD=$head is already reviewed"
if ! git -C "$worktree" merge-base --is-ancestor "$reviewed" "$head" 2>/dev/null; then
  emit "SINCE-NOT-ANCESTOR" 1 "reviewed=$reviewed HEAD=$head"
fi

round="$(t get round 2>/dev/null || printf '0')"
case "$round" in ''|*[!0-9]*) round=0 ;; esac
has_p_lines=0
if grep -qE '^P[123] ' "$findings"; then has_p_lines=1; fi
issue="$(t get issue 2>/dev/null || true)"
mkdir -p "$run"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/tkt-verify.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
round_grant_limited=0
if [ "$has_p_lines" -eq 1 ] && [ "$round" -ge 2 ]; then round_grant_limited=1; fi
grant_comment_count=0
grant_accepted=0
grant_url=""
if [ -n "$ruling_id" ]; then
  grant_comment_count=1
  ruling_json="$tmp/ruling-comment.json"
  if ! check_round_grant "$ruling_json" "$ruling_id" "$round" t; then
    if [ -n "$ruling_comment_hint" ]; then
      emit "RULING-REFUSED reason=$ruling_comment_failure comment=$ruling_id" 2 "$ruling_comment_hint"
    fi
    emit "RULING-REFUSED reason=$ruling_comment_failure comment=$ruling_id" 2
  fi
  grant_accepted=1
  record_round_grant "$ruling_id" "$grant_url" "$grant_round" t
fi
if [ "$has_p_lines" -eq 1 ] && [ "$round" -ge 2 ] && [ "$grant_accepted" -ne 1 ]; then
  emit "ROUND-LIMIT" 1 "round=$round; otherwise post an owner ruling with a column-0 grants: round $((round + 1)) line and retry with --ruling <comment id>; send the open findings to triage"
fi
fixslot="$(t get fixslot 2>/dev/null || printf '0')"
case "$fixslot" in ''|*[!0-9]*) fixslot=0 ;; esac
if [ "$fixslot" -gt 0 ] \
  && [ "$(t get "fix_round.$fixslot.start" 2>/dev/null || true)" = "$reviewed" ] \
  && [ "$(t get "fix_round.$fixslot.head" 2>/dev/null || true)" = "$head" ]; then
  knum="$fixslot"
elif [ "$round" -gt "$fixslot" ]; then knum=$((round + 1)); else knum=$((fixslot + 1)); fi

if [ -n "$issue" ]; then set_namebase "$repo" "$issue"; else namebase="${repo##*/}"; fi
part_suffix="$(part_findings_suffix "$(t get part 2>/dev/null || true)")"
history_file="$(history_path "$knum")"
vargs=(run "$pr" --repo "$repo" --cwd "$worktree" --head "$head" --model "$verifymodel" --verify "$findings" --since "$reviewed")
verify_ruling="$(t get ruling.verify 2>/dev/null || true)"
if [ -n "$verify_ruling" ]; then vargs+=(--model-ruling "$verify_ruling"); fi

advance_round() {
  if [ "$has_p_lines" -eq 1 ]; then
    round=$((round + 1))
    t set round "$round"
    stamp_verdict_at t
  fi
}

slot_start_key="fix_round.$knum.start"
slot_head_key="fix_round.$knum.head"
slot_findings_key="fix_round.$knum.findings"
record_fix_ok() {
  local adoption_since="${1:-}" adoption_comment="${2:-}"
  # Recheck every head after either a fresh or adopted FIX-OK before
  # acknowledging it in ticket state.
  post_fetch_rc=0
  git -C "$worktree" fetch origin >/dev/null 2>&1 || post_fetch_rc=$?
  post_worktree_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
  post_origin_head="$(git -C "$worktree" rev-parse --verify "refs/remotes/origin/$branch" 2>/dev/null || true)"
  post_pr_json=""
  post_pr_rc=0
  post_pr_json="$(gh pr view "$pr" --repo "$repo" --json headRefOid 2>/dev/null)" || post_pr_rc=$?
  post_pr_head="$(jq -r '.headRefOid // empty' <<<"$post_pr_json" 2>/dev/null || true)"
  if [ "$post_fetch_rc" -ne 0 ] || [ "$post_pr_rc" -ne 0 ] \
    || [ "$post_worktree_head" != "$head" ] \
    || [ "$post_origin_head" != "$head" ] \
    || [ "$post_pr_head" != "$head" ]; then
    # The slot stays recorded: it names the reviewed..head range that review-pr read.
    advance_round
    emit "HEAD-MOVED head=$head worktree=$post_worktree_head origin/$branch=$post_origin_head pr=$post_pr_head" 1
  fi
  advance_round
  t set reviewed "$head"
  t set head "$head"
  stamp_verdict_at t
  write_findings_history verified "$tmp/verify.out" "$tmp/verify-rounds"
  if [ -n "$adoption_comment" ]; then
    t journal "tkt-verify ADOPT FIX-OK head=$head since=$adoption_since comment=$adoption_comment"
  else
    t journal "tkt-verify FIX-OK reviewed=$head"
  fi
  emit "FIX-OK reviewed=$head" 0
}

refuse_adoption() {
  local failed_check="$1" refused_head="$2" next_command
  next_command="$(printf '%q ' "$reviewpr" run "$pr" --repo "$repo" --cwd "$worktree" --model "$verifymodel" --verify "$findings" --since "$refused_head" --head "$head")"
  next_command="${next_command% }"
  emit "VERIFY-FAIL rc=2" 1 "FIX-OK adoption refused: failed check: $failed_check" "next command: $next_command"
}

adopt_posted_fix_ok() {
  local refusal_head="$1" rows row created comment_id header body64 comment_head comment_pid comment_since verdict expected_pid
  local latest_comment_id="" latest_comment_head="" newer_verdict=""
  local patch_mismatch="" verdict_failure="" since_gap="" since_missing="" adopted=0
  local -a candidate_rows=()
  [ "$refusal_head" = "$head" ] && [ "$refusal_head" = "$state_head" ] \
    || refuse_adoption "header head $refusal_head does not equal state head $state_head and validated worktree/origin/PR head $head" "$refusal_head"
  expected_pid="$(git -C "$worktree" diff "origin/main...$head" | git patch-id --stable | awk '{print $1}')"
  expected_pid="${expected_pid:-none}"
  rows="$(review_comment_rows "$repo" "$pr")" || refuse_adoption "could not read trusted review-pr comments" "$refusal_head"
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    IFS=$'\t' read -r created comment_id header body64 <<<"$row"
    comment_pid="$(review_header_value patch-id "$header")"
    comment_head="$(review_header_value head "$header")"
    if [ "$comment_pid" = "$expected_pid" ]; then
      latest_comment_id="$comment_id"
      latest_comment_head="$comment_head"
    fi
    if [ "$comment_head" = "$refusal_head" ]; then candidate_rows+=("$row"); fi
  done <<<"$rows"
  verdict="$(review_verdict "$repo" "$pr" "$expected_pid")" \
    || refuse_adoption "could not parse newest verdict for patch-id $expected_pid" "$refusal_head"
  for row in ${candidate_rows[@]+"${candidate_rows[@]}"}; do
    IFS=$'\t' read -r created comment_id header body64 <<<"$row"
    comment_head="$(review_header_value head "$header")"
    [ "$comment_head" = "$refusal_head" ] || continue
    comment_pid="$(review_header_value patch-id "$header")"
    if [ "$comment_pid" != "$expected_pid" ]; then
      patch_mismatch="comment $comment_id patch-id $comment_pid does not equal head $head patch-id $expected_pid"
      continue
    fi
    if [ "$comment_id" != "$latest_comment_id" ]; then
      newer_verdict="newest trusted comment $latest_comment_id at head ${latest_comment_head:-unknown} has verdict $verdict"
      continue
    fi
    comment_since="$(review_header_value since "$header")"
    if [ -z "$comment_since" ]; then
      since_missing="comment $comment_id header has no since field with a full SHA"
      continue
    fi
    if [ "$verdict" != approved ]; then
      verdict_failure="non-FIX-OK verdict: comment $comment_id parsed verdict is $verdict, not approved FIX-OK"
      continue
    fi
    if [ "$comment_since" != "$reviewed" ]; then
      recorded_since=0
      for ((slot=1; slot<=fixslot; slot++)); do
        slot_head="$(t get "fix_round.$slot.head" 2>/dev/null || true)"
        slot_history="$(t get "fix_round.$slot.history" 2>/dev/null || true)"
        if [ "$slot_head" = "$comment_since" ] && [ -n "$slot_history" ]; then recorded_since=1; break; fi
      done
      if [ "$recorded_since" -ne 1 ]; then
        since_gap="comment $comment_id since $comment_since is neither reviewed=$reviewed nor a head with a recorded fix_round.<n>.history verdict"
        continue
      fi
    fi
    printf 'FIX-OK adopted from comment %s\n' "$comment_id" >"$tmp/verify.out"
    adopted=1
    record_fix_ok "$comment_since" "$comment_id"
  done
  [ "$adopted" -eq 1 ] && return 0
  if [ -n "$newer_verdict" ]; then refuse_adoption "newer verdict at head: $newer_verdict" "$refusal_head"; fi
  if [ -n "$patch_mismatch" ]; then refuse_adoption "patch-id mismatch: $patch_mismatch" "$refusal_head"; fi
  if [ -n "$since_missing" ]; then refuse_adoption "header has no since: $since_missing" "$refusal_head"; fi
  if [ -n "$verdict_failure" ]; then refuse_adoption "$verdict_failure" "$refusal_head"; fi
  if [ -n "$since_gap" ]; then refuse_adoption "since-base gap: $since_gap" "$refusal_head"; fi
  refuse_adoption "no FIX-OK comment at header head $refusal_head with since provenance" "$refusal_head"
}

# Record the reviewed..HEAD range before review-pr so a later tkt-fix --verify
# can account for the commits using its standard fix-round coverage rules.
t set "$slot_start_key" "$reviewed"
t set "$slot_head_key" "$head"
t set "$slot_findings_key" "$findings"
t set fixslot "$knum"
printf '%s\n' "$knum" >"$tmp/verify-rounds"

vrc=0
"$reviewpr" "${vargs[@]}" >"$tmp/verify.out" 2>"$tmp/verify.err" || vrc=$?
fixline="$(grep -m 1 '^FIX-' "$tmp/verify.out" || true)"

if [ "$vrc" -ne 0 ]; then
  if [ "$vrc" -eq 2 ]; then
    refusal_line="$(grep -m 1 '^review-pr: --since .* is behind FIX-OK verify at head ' "$tmp/verify.err" || true)"
    refusal_head="$(printf '%s\n' "$refusal_line" | sed -n 's/^review-pr: --since .* is behind FIX-OK verify at head \([0-9a-f]\{40\}\); pass --since .*$/\1/p')"
    if [ -n "$refusal_head" ]; then adopt_posted_fix_ok "$refusal_head"; fi
  fi
  [ ! -s "$tmp/verify.err" ] || cat "$tmp/verify.err" >&2
  emit "VERIFY-FAIL rc=$vrc" 1 "$(head -n 40 "$tmp/verify.out")"
fi

case "$fixline" in
  FIX-INCOMPLETE*)
    open="$(grep '^P[0123] ' "$tmp/verify.out" | head -n 30 || true)"
    [ -n "$open" ] || emit "VERIFY-FAIL reason=no-finding-rows" 1 \
      "FIX-INCOMPLETE verify output contains no bare P0/P1/P2/P3 finding rows; rerun verification with finding rows"
    short_head="$(git -C "$worktree" rev-parse --short=12 "$head")"
    verify_output="$run/$namebase-tkt-verify-$short_head.md"
    cp "$tmp/verify.out" "$verify_output"
    write_findings_history verified "$tmp/verify.out" "$tmp/verify-rounds"
    t set findings "$verify_output"
    if ! grep -q '^P[012] ' "$tmp/verify.out"; then t set reviewed "$head"; fi
    advance_round
    stamp_verdict_at t
    t journal "tkt-verify FIX-INCOMPLETE"
    emit "FIX-INCOMPLETE" 1 "$open"
    ;;
  FIX-OK*)
    record_fix_ok "" ""
    ;;
  *)
    [ ! -s "$tmp/verify.err" ] || cat "$tmp/verify.err" >&2
    emit "VERIFY-FAIL" 1 "$(head -n 40 "$tmp/verify.out")"
    ;;
esac
