#!/usr/bin/env bash
# tkt-gate: pre-push checks and the gate on the remote tip.
# Fetches, checks the branch tip against origin/<branch> (and --expect-head),
# checks git diff --name-only --no-renames origin/main...HEAD against the
# plan's Files or the state's fence list, records the history, then runs the
# gate script from the plan's Gate section to a per-run log and sets state
# head. Prints one verdict line plus a digest of at most 40 lines.
# An uncovered path still passes when it exists on origin/main and the branch
# only adds lines to it (no deleted line, not binary), so additive edits at
# registration points stay open; only rewritten and new paths are fenced.
# Every state read and write goes through tkt-state. The Files cover rule is
# covered() from lib/plan-tokens.sh; the gate script writer is
# write_gate_script() from lib/gate-script.sh. Neither is copied here.
# Usage: tkt-gate <state> [--expect-head <sha>] [--checks-only]
# Tools: TKT_BIN holds plan-gate (default ~/.agents/bin); tkt-state and lib/
# sit next to this script. The gate runs with the worktree as its directory.
set -euo pipefail

usage() {
  echo "usage: tkt-gate <state> [--expect-head <sha>] [--checks-only]" >&2
  exit 2
}

[ $# -ge 1 ] || usage
state="$1"
shift

expect_head=""
checks_only=0
while [ $# -gt 0 ]; do
  case "$1" in
    --expect-head) [ $# -ge 2 ] && [ -n "$2" ] || usage; expect_head="$2"; shift 2 ;;
    --checks-only) checks_only=1; shift ;;
    --help|-h) usage ;;
    -* ) usage ;;
    *) usage ;;
  esac
done

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
tkt_state="$script_dir/tkt-state"
tokens_lib="$script_dir/lib/plan-tokens.sh"
if [ ! -r "$tokens_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $tokens_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$tokens_lib"
gate_lib="$script_dir/lib/gate-script.sh"
if [ ! -r "$gate_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $gate_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$gate_lib"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $namebase_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$namebase_lib"
plan_gate_lib="$script_dir/lib/plan-gate-args.sh"
if [ ! -r "$plan_gate_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $plan_gate_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$plan_gate_lib"
bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
plangate="$bin_dir/plan-gate"

tkt() {
  "$tkt_state" "$state" "$@"
}

# emit VERDICT EXIT: write the verdict plus the digest (and the history, when
# read) to the per-run log, print verdict plus digest, journal, and exit.
emit() {
  local verdict="$1" code="$2" twelve logpath output
  twelve="$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')"
  logpath="$(mktemp "$run/$namebase-tkt-gate-$twelve-XXXXXX")"
  mv "$logpath" "$logpath.log"
  logpath="$logpath.log"
  output="TKT tkt-gate $verdict log=$logpath
$digest"
  printf '%s\n' "$output" >"$logpath"
  if [ -n "$hist" ]; then
    printf '%s\n' "$hist" >>"$logpath"
  fi
  printf '%s\n' "$output"
  tkt journal "tkt-gate $verdict"
  exit "$code"
}

# Hold the phase lock for the whole command: a second run exits 2 naming the
# holder's pid. Separate from <state>.lock, which tkt-state takes per write.
phasedir="$state.phase"
if ! mkdir "$phasedir" 2>/dev/null; then
  pid="$(cat "$phasedir/pid" 2>/dev/null || true)"
  if [ -n "$pid" ]; then
    echo "tkt-gate: state locked by pid $pid" >&2
  else
    echo "tkt-gate: state locked" >&2
  fi
  exit 2
fi
printf '%s\n' "$$" >"$phasedir/pid"
cargo_slot_dir=""
release_phase() {
  rm -rf "$phasedir"
  [ -z "$cargo_slot_dir" ] || rm -rf "$cargo_slot_dir"
}
trap release_phase EXIT

tkt require repo issue branch worktree run
repo="$(tkt get repo)"
issue="$(tkt get issue)"
set_namebase "$repo" "$issue"
branch="$(tkt get branch)"
worktree="$(tkt get worktree)"
run="$(tkt get run)"
mkdir -p "$run"

# The fence comes from the plan's Files, the state's fence list, or both.
plan="$(tkt get plan 2>/dev/null || true)"
fence_list="$(tkt list fence 2>/dev/null || true)"
if [ -z "$plan" ] && [ -z "$fence_list" ]; then
  tkt require plan
fi
if [ -n "$plan" ] && [ ! -r "$plan" ]; then
  echo "tkt-gate: cannot read plan: $plan" >&2
  exit 2
fi

# A stored head the worktree left behind stops the run before it acts. With
# a PR number in state, the PR's head must agree with both.
if stored_head="$(tkt get head 2>/dev/null)"; then
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || {
    echo "tkt-gate: cannot read worktree HEAD: $worktree" >&2
    exit 2
  }
  if pr="$(tkt get pr 2>/dev/null)"; then
    # gh resolves the PR against the caller's directory, so name the
    # worktree's repo explicitly.
    pr_repo="$(git -C "$worktree" config --get remote.origin.url)" || {
      echo "tkt-gate: cannot read origin URL in $worktree" >&2
      exit 2
    }
    pr_head="$(gh pr view "$pr" --repo "$pr_repo" --json headRefOid --jq .headRefOid)" || {
      echo "tkt-gate: cannot read PR $pr head" >&2
      exit 2
    }
    if [ "$stored_head" != "$actual" ] || [ "$stored_head" != "$pr_head" ]; then
      echo "tkt-gate: head drift: state $state head=$stored_head worktree $worktree HEAD=$actual pr $pr head=$pr_head" >&2
      exit 3
    fi
  elif [ "$stored_head" != "$actual" ]; then
    echo "tkt-gate: head drift: state $state head=$stored_head worktree $worktree HEAD=$actual" >&2
    exit 3
  fi
fi

git -C "$worktree" fetch origin >/dev/null 2>&1 || {
  echo "tkt-gate: fetch failed in $worktree" >&2
  exit 2
}

hist=""
digest=""

# Tip: origin/<branch> equals the local HEAD, and equals --expect-head.
local_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || {
  echo "tkt-gate: cannot read worktree HEAD: $worktree" >&2
  exit 2
}
remote_head="$(git -C "$worktree" rev-parse --verify "origin/$branch" 2>/dev/null || true)"
tip_detail=""
if [ -z "$remote_head" ]; then
  tip_detail="origin/$branch missing head=$local_head"
elif [ "$remote_head" != "$local_head" ]; then
  tip_detail="origin/$branch=$remote_head head=$local_head"
elif [ -n "$expect_head" ] && [ "$remote_head" != "$expect_head" ]; then
  tip_detail="origin/$branch=$remote_head expect=$expect_head head=$local_head"
fi
if [ -n "$tip_detail" ]; then
  digest="$tip_detail"
  emit "TIP $tip_detail" 1
fi

# Fence: every changed path is covered by Files or the fence list. Renamed
# files stay under their old path, so a cover on the old name still holds.
FILES="|"
GLOBS=""
collect_fence() {
  case "$1" in
    glob) return 0 ;;
    path) FILES="$FILES$2|" ;;
    symbol) return 0 ;;
  esac
  return 0
}
if [ -n "$plan" ]; then
  while IFS=$'\t' read -r sec _ln isnew _read tok; do
    # Files covers its paths; a path marked new in Tasks, Interfaces or Red
    # commit is a file the plan creates, so it is covered too.
    case "$sec" in
      files) ;;
      tasks|interfaces|red) [ "$isnew" = 1 ] || continue ;;
      *) continue ;;
    esac
    [ -n "$tok" ] || continue
    CUR_SEC="files"
    expand_token "$tok" collect_fence
  done <<<"$(plan_records "$plan")"
fi
if [ -n "$fence_list" ]; then
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    case "$e" in
      *"*"*) GLOBS="$GLOBS$e"$'\n' ;;
      *) FILES="$FILES$e|" ;;
    esac
  done <<<"$fence_list"
fi
changed="$(git -C "$worktree" diff --name-only --no-renames "origin/main...HEAD" 2>/dev/null)" || {
  echo "tkt-gate: cannot diff origin/main...HEAD in $worktree" >&2
  exit 2
}
additive_only() {
  local p="$1" line
  git -C "$worktree" cat-file -e "origin/main:$p" 2>/dev/null || return 1
  line="$(git -C "$worktree" diff --numstat --no-renames "origin/main...HEAD" -- "$p" 2>/dev/null)" || return 1
  case "$line" in
    # numstat: <added>\t<deleted>\t<path>; a binary file prints "-" for both counts
    [0-9]*$'\t'0$'\t'*) return 0 ;;
  esac
  return 1
}
n=0
shown=0
digest=""
while IFS= read -r p; do
  [ -n "$p" ] || continue
  if covered "$p"; then continue; fi
  if additive_only "$p"; then continue; fi
  n=$((n + 1))
  if [ "$shown" -lt 30 ]; then
    digest="$digest$p"$'\n'
    shown=$((shown + 1))
  fi
done <<<"$changed"
if [ "$n" -gt 0 ]; then
  rest=$((n - shown))
  if [ "$rest" -gt 0 ]; then
    digest="$digest... and $rest more"
  else
    digest="${digest%$'\n'}"
  fi
  emit "FENCE n=$n" 1
fi

# History: the oneline list goes into the log, the counts into the digest.
hist="$(git -C "$worktree" log --oneline "origin/main..HEAD" 2>/dev/null)" || {
  echo "tkt-gate: cannot read history origin/main..HEAD in $worktree" >&2
  exit 2
}
commits="$(git -C "$worktree" rev-list --count "origin/main..HEAD" 2>/dev/null || echo 0)"
merges="$(git -C "$worktree" rev-list --count --merges "origin/main..HEAD" 2>/dev/null || echo 0)"

gate_word="skipped"
if [ "$checks_only" -eq 0 ]; then
  [ -n "$plan" ] || tkt require plan
  plan_gate_args tkt
  gate_cmd="$("$plangate" ${plan_gate_argv[@]+"${plan_gate_argv[@]}"} "$plan")" || exit 2
  env_prefix=""
  if e="$(tkt get env 2>/dev/null)" && [ -n "$e" ]; then
    env_prefix="$e "
  fi
  # Session gates do not inherit a lane's cargo shim PATH.
  cargo_slot_dir="$(mktemp -d "$run/$namebase-tkt-gate-cargo.XXXXXX")"
  ln -s "$script_dir/cargo-slot" "$cargo_slot_dir/cargo"
  env_prefix="${env_prefix}PATH=$(printf '%q' "$cargo_slot_dir"):\$PATH "
  script="$(mktemp "$run/$namebase-tkt-gate-XXXXXX")"
  mv "$script" "$script.sh"
  script="$script.sh"
  gatelog="$(mktemp "$run/$namebase-tkt-gate-XXXXXX")"
  mv "$gatelog" "$gatelog.log"
  gatelog="$gatelog.log"
  write_gate_script "$script" "$gatelog" "$env_prefix" "$gate_cmd" "tkt-gate: the pre-push gate on the remote tip"
  rc=0
  (cd "$worktree" && bash "$script") >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    gate_word="PASS"
  else
    digest="commits=$commits merges=$merges
gatelog=$gatelog
$(gate_failure_blocks "$gatelog")
$(tail -n 20 "$gatelog")"
    gerr="$(grep -i -m 5 -E 'error|panick' "$gatelog" || true)"
    if [ -n "$gerr" ]; then
      digest="$digest
$gerr"
    fi
    emit "FAIL rc=$rc" 1
  fi
fi

digest="commits=$commits merges=$merges
gate=$gate_word"
tkt set head "$local_head"
# On PASS the gate records `Local gate: pass at <sha> (<command>)` in the
# PR body, replacing any earlier Local gate line. The line goes directly
# above the first Implemented by line, else above the attribution line
# (state body_ends, else the body_has co-author line), else at the end. A
# --checks-only PASS ran no gate, so it writes nothing. A failed read or
# write only warns.
if [ "$checks_only" -eq 0 ] && gate_pr="$(tkt get pr 2>/dev/null)"; then
  gate_pr_repo="$(git -C "$worktree" config --get remote.origin.url 2>/dev/null || true)"
  if [ -z "$gate_pr_repo" ]; then
    echo "tkt-gate: warning: cannot read origin URL in $worktree; leaving the PR body unchanged" >&2
  elif pr_body="$(gh pr view "$gate_pr" --repo "$gate_pr_repo" --json body --jq '.body // ""' 2>/dev/null)"; then
    gate_line="Local gate: pass at $local_head ($gate_cmd)"
    if [ -z "$pr_body" ]; then
      new_body="$gate_line"
    else
      # body_ends wins; a missing or blank body_ends falls through to the body_has co-author.
      attr="$(tkt get body_ends 2>/dev/null || true)"
      attr_mode="exact"
      if [ -z "${attr//[[:space:]]/}" ]; then
        attr="$(tkt list body_has 2>/dev/null | grep -i 'co-author' | head -n 1 || true)"
        attr_mode="prefix"
      fi
      new_body="$(TKT_GATE_LINE="$gate_line" TKT_GATE_ATTR="$attr" TKT_GATE_ATTR_MODE="$attr_mode" awk '
        /^Local gate:/ { next }
        { l[++n] = $0 }
        END {
          anchor = 0
          for (i = 1; i <= n; i++) if (l[i] ~ /^Implemented by:/) { anchor = i; break }
          if (!anchor && ENVIRON["TKT_GATE_ATTR"] != "") {
            if (ENVIRON["TKT_GATE_ATTR_MODE"] == "prefix") {
              for (i = 1; i <= n; i++) if (index(l[i], ENVIRON["TKT_GATE_ATTR"]) == 1) { anchor = i; break }
            } else {
              for (i = 1; i <= n; i++) if (l[i] == ENVIRON["TKT_GATE_ATTR"]) { anchor = i; break }
            }
          }
          if (!anchor) anchor = n + 1
          for (i = 1; i <= n; i++) { if (i == anchor) print ENVIRON["TKT_GATE_LINE"]; print l[i] }
          if (anchor == n + 1) print ENVIRON["TKT_GATE_LINE"]
        }' <<<"$pr_body")"
    fi
    tmp_body="$(mktemp "${TMPDIR:-/tmp}/tkt-gate-body.XXXXXX")"
    printf '%s\n' "$new_body" >"$tmp_body"
    if ! gh pr edit "$gate_pr" --repo "$gate_pr_repo" --body-file "$tmp_body" 2>/dev/null; then
      echo "tkt-gate: warning: cannot update PR $gate_pr body; leaving it unchanged" >&2
    fi
    rm -f "$tmp_body"
  else
    echo "tkt-gate: warning: cannot read PR $gate_pr body; leaving it unchanged" >&2
  fi
fi
emit "PASS head=$local_head" 0
