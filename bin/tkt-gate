#!/usr/bin/env bash
# tkt-gate: pre-push checks and the gate on the remote tip, or validate a
# delegate job's gate evidence after the same stored-head, fetch, tip, fence
# and history checks. From-job matches command and ticket env, then shares the
# normal head update and PASS journal path.
# against origin/<branch> (and --expect-head), checks git diff --name-only
# --no-renames origin/main...HEAD against the plan's Files or the state's fence
# list, records the history, then runs the gate script from the plan's Gate
# section, or from state key `gate` when the plan value is `takeover <ref>`, to
# a per-run log and sets state head. For takeovers, the file fence comes from
# the state's `fence` list.
# An uncovered path still passes when it exists on origin/main and the branch
# only adds lines to it (no deleted line, not binary), so additive edits at
# registration points stay open; only rewritten and new paths are fenced.
# Every state read and write goes through tkt-state. The Files cover rule is
# covered() from lib/plan-tokens.sh; the gate script writer is
# write_gate_script() from lib/gate-script.sh. Neither is copied here.
# Usage: tkt-gate <state> [--expect-head <sha>] [--checks-only | --from-job <job id>]
# Tools: TKT_BIN holds plan-gate (default ~/.agents/bin); tkt-state and lib/
# sit next to this script. The gate runs with the worktree as its directory.
set -euo pipefail

usage() {
  echo "usage: tkt-gate <state> [--expect-head <sha>] [--checks-only | --from-job <job id>]" >&2
  exit 2
}

[ $# -ge 1 ] || usage
state="$1"
shift

expect_head=""
checks_only=0
from_job=""
while [ $# -gt 0 ]; do
  case "$1" in
    --expect-head) [ $# -ge 2 ] && [ -n "$2" ] || usage; expect_head="$2"; shift 2 ;;
    --checks-only) checks_only=1; shift ;;
    --from-job) [ $# -ge 2 ] && [ -n "$2" ] || usage; from_job="$2"; shift 2 ;;
    --help|-h) usage ;;
    -* ) usage ;;
    *) usage ;;
  esac
done
[ -z "$from_job" ] || { [ "$checks_only" -eq 0 ] && [ -z "$expect_head" ]; } || usage

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
tkt_state="$script_dir/tkt-state"
tokens_lib="$script_dir/lib/plan-tokens.sh"
if [ ! -r "$tokens_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $tokens_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$tokens_lib"
fence_grant_lib="$script_dir/lib/fence-grant-paths.sh"
if [ ! -r "$fence_grant_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $fence_grant_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$fence_grant_lib"
gate_lib="$script_dir/lib/gate-script.sh"
if [ ! -r "$gate_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $gate_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$gate_lib"
job_walk_lib="$script_dir/lib/job-walk.sh"
if [ ! -r "$job_walk_lib" ]; then echo "tkt-gate: cannot read shared lib: $job_walk_lib" >&2; exit 2; fi
. "$job_walk_lib"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $namebase_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$namebase_lib"
plan_gate_lib="$script_dir/lib/plan-gate-args.sh"
if [ ! -r "$plan_gate_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $plan_gate_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$plan_gate_lib"
takeover_lib="$script_dir/lib/takeover-plan-gate.sh"
if [ ! -r "$takeover_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $takeover_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$takeover_lib"
local_gate_body_lib="$script_dir/lib/local-gate-body.sh"
if [ ! -r "$local_gate_body_lib" ]; then
  echo "tkt-gate: cannot read shared lib: $local_gate_body_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$local_gate_body_lib"
bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
plangate="$bin_dir/plan-gate"

tkt() {
  "$tkt_state" "$state" "$@"
}

from_job_refuse() {
  printf 'tkt-gate: --from-job check failed: %s\n' "$*" >&2
  exit 1
}

# Validate delegate evidence before writing either the source marker or PASS.
# job-record uses delegate's lookup order; resumed jobs follow the same
# supersededBy chain that tkt-job watches.
from_job_pass() {
  local jobid record next prior gate_exit expected_gate
  local journal_path journal_line journal_payload rest recorded_slot recorded_id recorded_cmd recorded_env current_env
  local command_match head_after pr pr_repo pr_head dirty candidate_id chain chain_id chain_record
  local -a seen=()
  chain="$(job_walk_superseded "$from_job")" || from_job_refuse "job record supersededBy cycle in chain starting at id=$from_job"
  while IFS=$'\t' read -r candidate_id record; do
    [ -n "$candidate_id" ] || continue
    seen+=("$candidate_id")
    jobid="$candidate_id"
  done <<<"$chain"
  record="$(bash "$script_dir/job-record" "$jobid" 2>/dev/null)" || from_job_refuse "job record not found for id=$jobid"
  [ -f "$record" ] || from_job_refuse "job record not found for id=$jobid"
  jq -e . "$record" >/dev/null 2>&1 || from_job_refuse "job record is not valid JSON for id=$jobid"

  if ! jq -e '
    (.result.gateResult | type) == "object"
    and (.result.gateResult.exitCode | type) == "number"
    and (.result.gateResult.exitCode | floor) == .result.gateResult.exitCode
  ' "$record" >/dev/null 2>&1; then
    from_job_refuse "delegate gateResult check failed: record id=$jobid has no integer exitCode"
  fi

  if [ "$takeover" -eq 1 ]; then
    expected_gate="$takeover_gate"
  else
    [ -n "$plan" ] || from_job_refuse "gate command check failed: current plan is missing"
    [ -r "$plan" ] || from_job_refuse "gate command check failed: cannot read current plan: $plan"
    plan_gate_args tkt
    expected_gate="$("$plangate" ${plan_gate_argv[@]+"${plan_gate_argv[@]}"} "$plan" 2>/dev/null)" || from_job_refuse "gate command check failed: cannot resolve the current plan gate"
  fi
  [ -n "$expected_gate" ] || from_job_refuse "gate command check failed: current plan gate is empty"
  gate_exit="$(jq -r '.result.gateResult.exitCode | tostring' "$record")" || from_job_refuse "delegate gateResult check failed: cannot read exitCode for id=$jobid"

  journal_path="${state%.state}.journal"
  command_match=0
  if [ -r "$journal_path" ]; then
    while IFS= read -r journal_line || [ -n "$journal_line" ]; do
      journal_payload="${journal_line#* }"
      case "$journal_payload" in
        "tkt-job gate slot="*)
          rest="${journal_payload#tkt-job gate slot=}"
          case "$rest" in *" job="*) ;; *) continue ;; esac
          recorded_slot="${rest%% job=*}"
          rest="${rest#* job=}"
          case "$rest" in *" cmd="*) ;; *) continue ;; esac
          recorded_id="${rest%% cmd=*}"
          rest="${rest#* cmd=}"
          case "$rest" in *" env64="*) ;; *) continue ;; esac
          recorded_cmd="${rest%% env64=*}"
          recorded_env="$(printf '%s' "${rest#* env64=}" | jq -Rrs '@base64d' 2>/dev/null || true)"
          current_env="$(tkt get env 2>/dev/null || true)"
          for candidate_id in ${seen[@]+"${seen[@]}"}; do
            if [ -n "$recorded_slot" ] && [ "$recorded_id" = "$candidate_id" ] && [ "$recorded_cmd" = "$expected_gate" ] && [ "$recorded_env" = "$current_env" ]; then
              command_match=1
              break
            fi
          done
          ;;
      esac
    done <"$journal_path"
  fi
  [ "$command_match" -eq 1 ] || from_job_refuse "gate command/environment check failed: no tkt-job gate journal line for the job chain matches the current plan gate and ticket env"
  [ "$gate_exit" = 0 ] || from_job_refuse "gate exit code check failed: delegate gateResult exitCode=$gate_exit for id=$jobid"

  head_after="$(jq -r '.result.changeSet.headAfter // empty' "$record" 2>/dev/null)" || from_job_refuse "head check failed: cannot read changeSet.headAfter for id=$jobid"
  [ -n "$head_after" ] || from_job_refuse "head check failed: job record is missing changeSet.headAfter for id=$jobid"
  local_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || from_job_refuse "head check failed: cannot read worktree HEAD in $worktree"
  pr="$(tkt get pr 2>/dev/null)" || from_job_refuse "PR head check failed: state has no PR"
  pr_repo="$(git -C "$worktree" config --get remote.origin.url 2>/dev/null)" || from_job_refuse "PR head check failed: cannot read origin URL in $worktree"
  pr_head="$(gh pr view "$pr" --repo "$pr_repo" --json headRefOid --jq .headRefOid 2>/dev/null)" || from_job_refuse "PR head check failed: cannot read PR $pr head"
  [ -n "$pr_head" ] || from_job_refuse "PR head check failed: PR $pr has no head SHA"
  if [ "$head_after" != "$local_head" ] || [ "$head_after" != "$pr_head" ]; then
    from_job_refuse "head check failed: job head=$head_after worktree HEAD=$local_head PR head=$pr_head"
  fi

  if ! jq -e '
    (.result.changeSet.dirtyAfter | type) == "boolean"
    and .result.changeSet.dirtyAfter == false
  ' "$record" >/dev/null 2>&1; then
    from_job_refuse "dirty tree check failed: record id=$jobid is missing dirtyAfter=false"
  fi
  dirty="$(git -C "$worktree" status --porcelain --untracked-files=all 2>/dev/null)" || from_job_refuse "dirty tree check failed: cannot read worktree status in $worktree"
  [ -z "$dirty" ] || from_job_refuse "dirty tree check failed: worktree has uncommitted changes"

  digest="commits=delegate gate=PASS id=$jobid"
  from_job_id="$jobid"
  from_job_head="$head_after"
  gate_cmd="$expected_gate"
  gate_word="PASS"
}

# emit VERDICT EXIT: write the verdict plus the digest (and the history, when
# read) to the per-run log, print verdict plus digest, journal, and exit.
emit() {
  local verdict="$1" code="$2" twelve logpath output journal_line
  twelve="$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')"
  logpath="$(mktemp "$run/$namebase-tkt-gate-$twelve-XXXXXX")"
  mv "$logpath" "$logpath.log"
  logpath="$logpath.log"
  output="TKT tkt-gate $verdict log=$logpath
$digest"
  printf '%s\n' "$output" >"$logpath"
  if [ -n "$hist" ]; then
    printf '%s\n' "$hist" >>"$logpath"
  fi
  printf '%s\n' "$output"
  journal_line="tkt-gate $verdict"
  if [ -n "${3:-}" ]; then journal_line="$journal_line $3"; fi
  tkt journal "$journal_line"
  exit "$code"
}

# Hold the phase lock for the whole command: a second run exits 2 naming the
# holder's pid. Separate from <state>.lock, which tkt-state takes per write.
phasedir="$state.phase"
if ! mkdir "$phasedir" 2>/dev/null; then
  pid="$(cat "$phasedir/pid" 2>/dev/null || true)"
  if [ -n "$pid" ]; then
    echo "tkt-gate: state locked by pid $pid" >&2
  else
    echo "tkt-gate: state locked" >&2
  fi
  exit 2
fi
printf '%s\n' "$$" >"$phasedir/pid"
cargo_slot_dir=""
release_phase() {
  rm -rf "$phasedir"
  [ -z "$cargo_slot_dir" ] || rm -rf "$cargo_slot_dir"
}
trap release_phase EXIT

tkt require repo issue branch worktree run
repo="$(tkt get repo)"
issue="$(tkt get issue)"
set_namebase "$repo" "$issue"
branch="$(tkt get branch)"
worktree="$(tkt get worktree)"
run="$(tkt get run)"
mkdir -p "$run"

# The fence comes from the plan's Files, the state's fence list, or both.
plan="$(tkt get plan 2>/dev/null || true)"
takeover=0
takeover_gate=""
if ! takeover_plan_gate tkt-gate "$plan" tkt; then exit 2; fi
if [ "$takeover" -eq 1 ]; then plan=""; fi
fence_list="$(tkt list fence 2>/dev/null || true)"
if [ -z "$plan" ] && [ -z "$fence_list" ] && [ "$takeover" -eq 0 ]; then
  tkt require plan
fi
if [ -n "$plan" ] && [ ! -r "$plan" ]; then
  echo "tkt-gate: cannot read plan: $plan" >&2
  exit 2
fi

# A stored head the worktree left behind stops the run before it acts. With
# a PR number in state, the PR's head must agree with both.
if stored_head="$(tkt get head 2>/dev/null)"; then
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || {
    echo "tkt-gate: cannot read worktree HEAD: $worktree" >&2
    exit 2
  }
  if pr="$(tkt get pr 2>/dev/null)"; then
    # gh resolves the PR against the caller's directory, so name the
    # worktree's repo explicitly.
    pr_repo="$(git -C "$worktree" config --get remote.origin.url)" || {
      echo "tkt-gate: cannot read origin URL in $worktree" >&2
      exit 2
    }
    pr_head="$(gh pr view "$pr" --repo "$pr_repo" --json headRefOid --jq .headRefOid)" || {
      echo "tkt-gate: cannot read PR $pr head" >&2
      exit 2
    }
    if [ "$stored_head" != "$actual" ] || [ "$stored_head" != "$pr_head" ]; then
      if [ "$actual" = "$pr_head" ] && git -C "$worktree" merge-base --is-ancestor "$stored_head" "$actual" >/dev/null 2>&1; then
        echo "tkt-gate: accepted pushed head drift: state head=$stored_head worktree $worktree HEAD=$actual PR head=$pr_head" >&2
        tkt set head "$pr_head"
      else
        echo "tkt-gate: head drift: state $state head=$stored_head worktree $worktree HEAD=$actual pr $pr head=$pr_head" >&2
        exit 3
      fi
    fi
  elif [ "$stored_head" != "$actual" ]; then
    echo "tkt-gate: head drift: state $state head=$stored_head worktree $worktree HEAD=$actual" >&2
    exit 3
  fi
fi

git -C "$worktree" fetch origin >/dev/null 2>&1 || {
  echo "tkt-gate: fetch failed in $worktree" >&2
  exit 2
}

hist=""
digest=""

# Tip: origin/<branch> equals the local HEAD, and equals --expect-head.
local_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || {
  echo "tkt-gate: cannot read worktree HEAD: $worktree" >&2
  exit 2
}
remote_head="$(git -C "$worktree" rev-parse --verify "origin/$branch" 2>/dev/null || true)"
tip_detail=""
if [ -z "$remote_head" ]; then
  tip_detail="origin/$branch missing head=$local_head"
elif [ "$remote_head" != "$local_head" ]; then
  tip_detail="origin/$branch=$remote_head head=$local_head"
elif [ -n "$expect_head" ] && [ "$remote_head" != "$expect_head" ]; then
  tip_detail="origin/$branch=$remote_head expect=$expect_head head=$local_head"
fi
if [ -n "$tip_detail" ]; then
  digest="$tip_detail"
  emit "TIP $tip_detail" 1
fi

# Fence: every changed path is covered by Files or the fence list. Renamed
# files stay under their old path, so a cover on the old name still holds.
FILES="|"
GLOBS=""
collect_fence() {
  case "$1" in
    glob) return 0 ;;
    path) FILES="$FILES$2|" ;;
    symbol) return 0 ;;
  esac
  return 0
}
if [ -n "$plan" ]; then
  while IFS=$'\t' read -r sec _ln isnew _read tok; do
    # Files covers its paths; a path marked new in Tasks, Interfaces or Red
    # commit is a file the plan creates, so it is covered too.
    case "$sec" in
      files) ;;
      tasks|interfaces|red) [ "$isnew" = 1 ] || continue ;;
      *) continue ;;
    esac
    [ -n "$tok" ] || continue
    CUR_SEC="files"
    expand_token "$tok" collect_fence
  done <<<"$(plan_records "$plan")"
fi
if [ -n "$fence_list" ]; then
  while IFS= read -r e; do
    [ -n "$e" ] || continue
    case "$e" in
      *"*"*) GLOBS="$GLOBS$e"$'\n' ;;
      *) FILES="$FILES$e|" ;;
    esac
  done <<<"$fence_list"
fi

# fence-grant --require resolves the run directory from FW_RUN or the same
# HOME fallback. Only files belonging to this exact ticket number count.
grant_run="${FW_RUN:-$HOME/work/fiber-worktrees/flywheel/run}"
for grant_file in "$grant_run"/fiber-"$issue"-fence-grant*.md; do
  [ -f "$grant_file" ] || continue
  while IFS= read -r grant_path; do
    [ -n "$grant_path" ] || continue
    while :; do case "$grant_path" in ./*) grant_path=${grant_path#./};; *) break;; esac; done
    case "$grant_path" in
      */\*\*) grant_path="${grant_path%/\*\*}/" ;;
      */\*) grant_path="${grant_path%/\*}/" ;;
    esac
    case "$grant_path" in
      */) FILES="$FILES$grant_path|" ;;
      *\**|*\?*|*\[*|*\{*) GLOBS="$GLOBS$grant_path"$'\n' ;;
      *)
        case "${grant_path##*/}" in
          *.*) FILES="$FILES$grant_path|" ;;
          # An extensionless name (bin/<script>, Makefile) may be a file or a directory.
          *) FILES="$FILES$grant_path|$grant_path/|" ;;
        esac
        ;;
    esac
  done < <(fence_grant_pathspecs "$grant_file")
done
changed="$(git -C "$worktree" diff --name-only --no-renames "origin/main...HEAD" 2>/dev/null)" || {
  echo "tkt-gate: cannot diff origin/main...HEAD in $worktree" >&2
  exit 2
}
additive_only() {
  local p="$1" line
  git -C "$worktree" cat-file -e "origin/main:$p" 2>/dev/null || return 1
  line="$(git -C "$worktree" diff --numstat --no-renames "origin/main...HEAD" -- "$p" 2>/dev/null)" || return 1
  case "$line" in
    # numstat: <added>\t<deleted>\t<path>; a binary file prints "-" for both counts
    [0-9]*$'\t'0$'\t'*) return 0 ;;
  esac
  return 1
}
n=0
shown=0
digest=""
while IFS= read -r p; do
  [ -n "$p" ] || continue
  if covered "$p"; then continue; fi
  if additive_only "$p"; then continue; fi
  n=$((n + 1))
  if [ "$shown" -lt 30 ]; then
    digest="$digest$p"$'\n'
    shown=$((shown + 1))
  fi
done <<<"$changed"
if [ "$n" -gt 0 ]; then
  rest=$((n - shown))
  if [ "$rest" -gt 0 ]; then
    digest="$digest... and $rest more"
  else
    digest="${digest%$'\n'}"
  fi
  # Name the plan, state fence and matching grant routes; the check itself is unchanged.
  digest="$digest
the fence is read from the plan's Files, the state's fence list, or a matching fence-grant Paths block in this ticket's grant file
for a path a merge of main moved, run per path: tkt-state $state add fence <path>
for scope the plan never covered, add it to the plan's Files and re-confirm with tkt-plan"
  emit "FENCE n=$n" 1
fi

# History: the oneline list goes into the log, the counts into the digest.
hist="$(git -C "$worktree" log --oneline "origin/main..HEAD" 2>/dev/null)" || {
  echo "tkt-gate: cannot read history origin/main..HEAD in $worktree" >&2
  exit 2
}
commits="$(git -C "$worktree" rev-list --count "origin/main..HEAD" 2>/dev/null || echo 0)"
merges="$(git -C "$worktree" rev-list --count --merges "origin/main..HEAD" 2>/dev/null || echo 0)"

gate_word="skipped"
if [ "$checks_only" -eq 0 ]; then
  if [ -n "$from_job" ]; then
    from_job_pass
  else
  if [ "$takeover" -eq 1 ]; then
    gate_cmd="$takeover_gate"
  else
    [ -n "$plan" ] || tkt require plan
    plan_gate_args tkt
    gate_cmd="$("$plangate" ${plan_gate_argv[@]+"${plan_gate_argv[@]}"} "$plan")" || exit 2
  fi
  env_prefix=""
  if e="$(tkt get env 2>/dev/null)" && [ -n "$e" ]; then
    env_prefix="$e "
  fi
  cargo_slot_real="$(command -v cargo || true)"
  if [ -n "$cargo_slot_real" ]; then
    case "$cargo_slot_real" in
      /*) ;;
      *) cargo_slot_real="$(cd "$(dirname "$cargo_slot_real")" && pwd)/$(basename "$cargo_slot_real")" ;;
    esac
    env_prefix="${env_prefix}CARGO_SLOT_REAL=$(printf '%q' "$cargo_slot_real") "
  else
    # Before the ticket env: an assignment ahead of `unset` would apply to it alone.
    env_prefix="unset CARGO_SLOT_REAL; ${env_prefix}"
  fi
  # Session gates do not inherit a lane's cargo shim PATH.
  cargo_slot_dir="$(mktemp -d "$run/$namebase-tkt-gate-cargo.XXXXXX")"
  ln -s "$script_dir/cargo-slot" "$cargo_slot_dir/cargo"
  env_prefix="${env_prefix}PATH=$(printf '%q' "$cargo_slot_dir"):\$PATH "
  script="$(mktemp "$run/$namebase-tkt-gate-XXXXXX")"
  mv "$script" "$script.sh"
  script="$script.sh"
  gatelog="$(mktemp "$run/$namebase-tkt-gate-XXXXXX")"
  mv "$gatelog" "$gatelog.log"
  gatelog="$gatelog.log"
  write_gate_script "$script" "$gatelog" "$env_prefix" "$gate_cmd" "tkt-gate: the pre-push gate on the remote tip"
  rc=0
  (cd "$worktree" && bash "$script") >/dev/null 2>&1 || rc=$?
  if [ "$rc" -eq 0 ]; then
    gate_word="PASS"
  else
    digest="commits=$commits merges=$merges
gatelog=$gatelog
$(gate_failure_blocks "$gatelog")
$(tail -n 20 "$gatelog")"
    gerr="$(grep -i -m 5 -E 'error|panick' "$gatelog" || true)"
    if [ -n "$gerr" ]; then
      digest="$digest
$gerr"
    fi
    emit "FAIL rc=$rc" 1
  fi
  fi
fi

digest="commits=$commits merges=$merges
gate=$gate_word"
tkt set head "$local_head"
# On PASS the gate records `Local gate: pass at <sha> (<command>)` in the
# PR body, replacing any earlier Local gate line. The line goes directly
# above the first Implemented by line, else above the attribution line
# (state body_ends, else the body_has co-author line), else at the end. A
# --checks-only PASS ran no gate, so it writes nothing. A failed read or
# write only warns.
if [ "$checks_only" -eq 0 ] && gate_pr="$(tkt get pr 2>/dev/null)"; then
  gate_pr_repo="$(git -C "$worktree" config --get remote.origin.url 2>/dev/null || true)"
  if [ -z "$gate_pr_repo" ]; then
    echo "tkt-gate: warning: cannot read origin URL in $worktree; leaving the PR body unchanged" >&2
  elif pr_body="$(gh pr view "$gate_pr" --repo "$gate_pr_repo" --json body --jq '.body // ""' 2>/dev/null)"; then
    gate_line="Local gate: pass at $local_head ($gate_cmd)"
    if [ -z "$pr_body" ]; then
      new_body="$gate_line"
    else
      # body_ends wins; a missing or blank body_ends falls through to the body_has co-author.
      attr="$(tkt get body_ends 2>/dev/null || true)"
      attr_mode="exact"
      if [ -z "${attr//[[:space:]]/}" ]; then
        attr="$(tkt list body_has 2>/dev/null | grep -i 'co-author' | head -n 1 || true)"
        attr_mode="prefix"
      fi
      new_body="$(tkt_local_gate_body_insert "$pr_body" "$gate_line" "$attr" "$attr_mode")"
    fi
    tmp_body="$(mktemp "${TMPDIR:-/tmp}/tkt-gate-body.XXXXXX")"
    printf '%s\n' "$new_body" >"$tmp_body"
    if ! gh pr edit "$gate_pr" --repo "$gate_pr_repo" --body-file "$tmp_body" 2>/dev/null; then
      echo "tkt-gate: warning: cannot update PR $gate_pr body; leaving it unchanged" >&2
    fi
    rm -f "$tmp_body"
  else
    echo "tkt-gate: warning: cannot read PR $gate_pr body; leaving it unchanged" >&2
  fi
fi
if [ -n "$from_job" ]; then
  tkt journal "tkt-gate from-job id=$from_job_id head=$from_job_head"
fi
if [ "$checks_only" -eq 1 ]; then
  emit "PASS head=$local_head" 0 checks-only
fi
emit "PASS head=$local_head" 0
