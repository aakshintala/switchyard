  if m and m.group(1) == want:
    out.append(str(x.get("number", "")))
print(" ".join(out))' "$ticket" 2>/dev/null) || { echo "ERROR gh pr list branches"; exit 3; }
# The list may be truncated at the limit: fail closed instead of granting.
