    continue
  if not path or not lane or kind not in ("plan", "grant") or not age.isdigit() or not worktree:
    sys.exit(1)
  if pr and any(not item.isdigit() for item in pr.split(",")):
    sys.exit(1)
  print(path + "\t" + lane + "\t" + age)' <"$claims_out" >"$tmp/claims.tsv" 2>/dev/null || {
    echo "ERROR file-claim list unparseable claims"
    exit 3
  }
else
  g=$(head -c 200 "$claims_err" 2>/dev/null | tr '\n' ' ')
  echo "ERROR file-claim list $g"
  exit 3
fi

# Refusal logs are evidence only: an append failure must never change the
# grant decision or its output. Claim ages are already expressed in minutes;
# holders without an age source are recorded with a literal `-`.
_refusal_age() {
  _ra_path=$1; _ra_holder=$2; _ra_lane=""
  case "$_ra_holder" in
    'lane #'*) _ra_lane="fiber-${_ra_holder#lane #}" ;;
    'lane '*) _ra_lane=${_ra_holder#lane } ;;
    *) printf '%s' '-'; return 0;;
  esac
  _ra_age=$(awk -F '\t' -v requested="$_ra_path" -v lane="$_ra_lane" '
function norm(path) {
  sub(/^\.\//, "", path)
  sub(/\/+$/, "", path)
  return path
}
BEGIN { requested = norm(requested) }
{
  claim = norm($1)
  if ($2 != lane || claim == "") next
  if (requested == claim) {
    if (!exact) { exact = 1; exact_age = $3 }
    next
  }
  if (index(requested, claim "/") == 1 && length(claim) > parent_len) {
    parent_len = length(claim)
    parent_age = $3
  }
}
END {
  if (exact) print exact_age
  else if (parent_len) print parent_age
}' "$tmp/claims.tsv" 2>/dev/null) || _ra_age=""
  case "$_ra_age" in ''|*[!0-9]*) printf '%s' '-';; *) printf '%s' "$_ra_age";; esac
  return 0
}

_log_refusal() {
  _lr_path=$1; _lr_holder=$2; _lr_age=$3
  _lr_action=REFUSE
  [ "$dry" -eq 0 ] || _lr_action=DRY-REFUSE
  _lr_time=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || return 0
  case "$_lr_time" in ????-??-??T??:??:??Z) :;; *) return 0;; esac
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$_lr_time" "$ticket" "$_lr_action" "$_lr_path" "$_lr_holder" "$_lr_age" \
    2>/dev/null >>"$run/fence-grant-refusals.tsv" || :
  return 0
}

# A dry run does not reap persisted state. It still uses the shared lookup so
# its report labels closed-ticket claims as STALE. Real grants already reaped
# before reading claims above, so they need no second GraphQL lookup.
: >"$tmp/ticket-numbers.tsv"
: >"$tmp/ticket-states.states"
if [ "$dry" -eq 1 ]; then
  while IFS="$(printf '\t')" read -r claim_path claim_lane claim_age; do
    [ -n "$claim_path" ] || continue
    [[ "$claim_lane" == sweep-* ]] && continue
    claim_num=$(lane_ticket_num "$claim_lane")
    [ -n "$claim_num" ] || continue
    [ "$claim_num" = "$ticket" ] && continue
    case " $ignoreticket " in *" $claim_num "*) continue;; esac
    printf '%s\n' "$claim_num" >>"$tmp/ticket-numbers.tsv"
  done <"$tmp/claims.tsv"
  if ! sort -un "$tmp/ticket-numbers.tsv" -o "$tmp/ticket-numbers.tsv" 2>"$tmp/ticket-sort.err"; then
    g=$(head -c 200 "$tmp/ticket-sort.err" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')
    [ -n "$g" ] || g="ticket list sort failed"
    echo "WARN ticket state lookup $g; claims held by lane liveness"
  elif [ -s "$tmp/ticket-numbers.tsv" ]; then
    ticket_state_prefix="$tmp/ticket-states"
    ticket_lookup_rc=0
    ticket_states_lookup "$repo" "$tmp/ticket-numbers.tsv" "$ticket_state_prefix" || ticket_lookup_rc=$?
    if [ "$ticket_lookup_rc" -eq 1 ]; then
      g=$(head -c 200 "$ticket_state_prefix.err" 2>/dev/null | tr '\n' ' ' | sed 's/[[:space:]]*$//')
      [ -n "$g" ] || g="gh api graphql failed"
      echo "WARN ticket state lookup $g; claims held by lane liveness"
    elif [ "$ticket_lookup_rc" -eq 2 ]; then
      echo "WARN ticket state lookup unreadable response; claims held by lane liveness"
    else
      while IFS= read -r warning; do
        echo "WARN ticket state lookup $warning; claims held by lane liveness"
      done <"$ticket_state_prefix.warnings"
    fi
  fi
fi

_claim_holders() {
  while IFS="$(printf '\t')" read -r claim_path claim_lane claim_age; do
    [ -n "$claim_path" ] || continue
    claim_num=$(lane_ticket_num "$claim_lane")
    if [ -n "$claim_num" ] && [ "$claim_num" = "$ticket" ] && [[ "$claim_lane" != sweep-* ]]; then continue; fi
    if [[ "$claim_lane" != sweep-* ]] && [ -n "$claim_num" ]; then
      case " $ignoreticket " in *" $claim_num "*) continue;; esac
    fi
    if [[ "$claim_lane" != sweep-* ]] && [ -n "$claim_num" ]; then
      claim_state=$(awk -F '\t' -v number="$claim_num" '$1 == number { print $2; exit }' "$tmp/ticket-states.states")
      case "$claim_state" in
        CLOSED|MERGED)
          echo "STALE $claim_path by $claim_lane (ticket #$claim_num closed)"
          continue
          ;;
      esac
    fi
    live=0
    for ln in $lanes; do
      if [ -n "$claim_num" ]; then
        [ "$(_lane_num "${ln#fiber-}")" = "$claim_num" ] && { live=1; break; }
      else
        [ "$ln" = "$claim_lane" ] && { live=1; break; }
      fi
    done
    [[ "$claim_lane" == sweep-* ]] && live=1
    if [ "$live" -eq 0 ]; then
      echo "STALE $claim_path by $claim_lane"
      continue
    fi
    normalized=$(_norm_tok "$claim_path")
    : >"$tmp/claim-entries"
    printf '%s\n' "$normalized" >"$tmp/claim-entries"
    if [[ "$claim_lane" == sweep-* ]]; then
      claim_label="lane $claim_lane"
    elif [ -n "$claim_num" ]; then
      claim_label="lane #$claim_num"
    else
      claim_label="lane $claim_lane"
    fi
    if [[ "$claim_lane" == sweep-* ]]; then
      _check_entries "$tmp/claim-entries" "$claim_num" "$claim_label" exclusive "$claim_age"
    else
      _check_entries "$tmp/claim-entries" "$claim_num" "$claim_label" "" "$claim_age"
    fi
  done <"$tmp/claims.tsv"
}

_lane_claim_count() {
  _lc_lane="$(claim_holder "$1")"
  _lc_out="$tmp/claims-$_lc_lane.out"
  _lc_err="$tmp/claims-$_lc_lane.err"
  if ! "$file_claim" list --lane "$_lc_lane" --repo "$repo" >"$_lc_out" 2>"$_lc_err"; then
    g=$(head -c 200 "$_lc_err" 2>/dev/null | tr '\n' ' ')
    echo "ERROR file-claim list $g"
    return 3
  fi
  _lc_count=$(python3 -c 'import sys
lane = sys.argv[1]
n = 0
for line in sys.stdin:
  fields = line.rstrip("\n").split("\t")
  if len(fields) != 6:
    sys.exit(1)
  path, holder, kind, age, worktree, pr = fields
  if not path or holder != lane or kind not in ("plan", "grant") or not age.isdigit() or not worktree:
    sys.exit(1)
  if pr and any(not item.isdigit() for item in pr.split(",")):
    sys.exit(1)
  n += 1
print(n)' "$_lc_lane" <"$_lc_out" 2>/dev/null) || {
    echo "ERROR file-claim list unparseable claims"
    return 3
  }
}

# --- PR side: a rename holds old and new; created/binary/hunkless hold all ---
_pr_expected_files() {
  printf '%s' "$prjson" | python3 -c 'import json,sys
try:
  data = json.load(sys.stdin)
except Exception:
  sys.exit(1)
want = sys.argv[1]
for row in data:
  if isinstance(row, dict) and str(row.get("number", "")) == want:
    count = row.get("changedFiles")
    if count is None:
      print("")
    elif isinstance(count, int) and count >= 0:
      print(count)
    else:
      sys.exit(1)
    sys.exit(0)
sys.exit(1)' "$1" 2>/dev/null
}
_pr_touched() {
  # $1 = PR number. Writes touched "normbase|sectionbase" lines to $tmp/touched-$1.
  _expected=$(_pr_expected_files "$1") || { echo "ERROR gh pr list changedFiles for PR #$1"; exit 3; }
  nf=$(pr_diff_fetch "${FW_GH:-gh}" "$repo" "$1" "$_expected" --name-only 2>"$tmp/gderr-$1") || { g=$(head -c 200 "$tmp/gderr-$1" 2>/dev/null | tr '\n' ' '); echo "ERROR gh pr diff $1 $g"; exit 3; }
  printf '%s\n' "$nf" | grep . | while IFS= read -r f; do
    b=$(_norm_base "$f")
    [ -n "$b" ] || continue
    printf '%s|%s\n' "$b" "$b"
  done > "$tmp/touched-$1"
  if [ -s "$tmp/touched-$1" ]; then
    pr_diff_fetch "${FW_GH:-gh}" "$repo" "$1" "$_expected" --allow-escape-sequences > "$tmp/full-$1.diff" 2>"$tmp/gderr-$1" || { g=$(head -c 200 "$tmp/gderr-$1" 2>/dev/null | tr '\n' ' '); echo "ERROR gh pr diff $1 $g"; exit 3; }
    [ -s "$tmp/full-$1.diff" ] || { g=$(head -c 200 "$tmp/gderr-$1" 2>/dev/null | tr '\n' ' '); echo "ERROR gh pr diff $1 $g"; exit 3; }
    grep '^rename from ' "$tmp/full-$1.diff" 2>/dev/null | sed 's/^rename from //' | while IFS= read -r o; do
      b=$(_norm_base "$o")
      [ -n "$b" ] || continue
      printf '%s|\n' "$b"
    done >> "$tmp/touched-$1"
  fi
  return 0
}

# Whole-file hold for section of $2 in $1: created, binary, or no hunks.
_pr_whole_hold() {
  sec=$(awk -v f="$2" '/^diff --git /{on = ($4 == "b/" f)} on {print}' "$1")
  [ -n "$sec" ] || return 0
  case "$sec" in *"new file mode"*) return 0;; *"Binary files "*) return 0;; esac
  printf '%s' "$sec" | grep -q '^@@ ' || return 0
  printf '%s' "$sec" | grep -q '^@@ -0,0 ' && return 0
  return 1
}

# Hunk old ranges for section of $2 in $1: "A B" lines; insertion -N,0 -> "N 2".
_pr_hunks() {
  awk -v f="$2" '/^diff --git /{on = ($4 == "b/" f)} on && /^\@\@ / {line = $0; sub(/^\@\@ -/, "", line); sub(/ .*/, "", line); print line}' "$1" | while IFS= read -r o; do
    a=${o%%,*}; b=${o#*,}
    [ "$b" = "$o" ] && b=1
    case "$a$b" in *[!0-9]*) continue;; esac
    if [ "$b" -eq 0 ]; then
      if [ "$a" -eq 0 ]; then echo "NEWHUNK"; else echo "$a 2"; fi
    else
      echo "$a $b"
    fi
  done
  return 0
}

# Overlap of requested [$3,$4] with old ranges of section $2 in $1.
_pr_overlap() {
  _os=$3; _oe=$4
  _pr_hunks "$1" "$2" > "$tmp/h" || true
  while IFS= read -r line; do
    a=${line%% *}; b=${line##* }
    [ "$a" = "NEWHUNK" ] && [ "$b" = "NEWHUNK" ] && return 0
    case "$a$b" in *[!0-9]*) continue;; esac
    he=$((a + b))
    if [ "$_os" -lt "$he" ] && [ "$a" -le "$_oe" ]; then return 0; fi
  done < "$tmp/h"
  return 1
}

_pr_touches_doc_heading() {
  _pth_want=$(printf '%s\n' "$3" | _normalize_doc_heading)
  awk -v f="$2" '
    /^diff --git / { on = ($4 == "b/" f); in_hunk = 0 }
    on && /^@@ / {
      in_hunk = 1
      line = $0
      sub(/^@@[^@]*@@[[:space:]]*/, "", line)
      if (line != "") print line
    }
    on && in_hunk && /^[ +-]/ { print substr($0, 2) }
  ' "$1" | _normalize_doc_heading | grep -qxF -- "$_pth_want"
}

for pr in $prs; do
  case " $ignore " in *" $pr "*) continue;; esac
  case " $ownprs " in *" $pr "*) echo "OWN skipping PR #$pr: its branch names ticket $ticket"; continue;; esac
  _pr_touched "$pr"
  [ -s "$tmp/touched-$pr" ] || continue
  while IFS= read -r p; do
    nn=$(_norm_tok "$p")
    pd=${nn%%|*}; rest=${nn#*|}; pb=${rest%%|*}
    [ -n "$pb" ] || continue
    while IFS='|' read -r fb sb; do
      [ -n "$fb" ] || continue
      if _conflict "$pd" "$pb" 0 "$fb" "" ""; then
        secbase=$sb
        [ -n "$secbase" ] || secbase=$fb
        rr=$(_req_ranges "$pb")
        if [ -z "$rr" ]; then
          overlaps="${overlaps}${p}|PR #${pr}
"
        else
          if _pr_whole_hold "$tmp/full-$pr.diff" "$secbase"; then
            overlaps="${overlaps}${p}|PR #${pr}
"
          else
            ov=0
            printf '%s\n' "$rr" > "$tmp/rr-$pr"
            while IFS= read -r line; do
              s=${line%% *}; e=${line##* }
              case "$s$e" in *[!0-9]*) continue;; esac
              if _pr_overlap "$tmp/full-$pr.diff" "$secbase" "$s" "$e"; then ov=1; break; fi
            done < "$tmp/rr-$pr"
            if [ "$ov" -eq 1 ]; then
              overlaps="${overlaps}${p}|PR #${pr}
"
            fi
          fi
        fi
        break
      fi
    done < "$tmp/touched-$pr"
  done < "$tmp/plist"
done

# Doc heading citations are a review warning only; they never enter `held`.
if [ -n "$docheadings" ]; then
  while IFS= read -r _cited; do
    [ -n "$_cited" ] || continue
    case "$_cited" in docs/*\#*) :;; *) continue;; esac
    _doc=${_cited%%#*}; _heading=${_cited#*#}
    [ -n "$_heading" ] || continue
    for pr in $prs; do
      case " $ignore " in *" $pr "*) continue;; esac
      [ -s "$tmp/full-$pr.diff" ] || _pr_touched "$pr"
      [ -s "$tmp/full-$pr.diff" ] || continue
      if _pr_touches_doc_heading "$tmp/full-$pr.diff" "$_doc" "$_heading"; then
        echo "WARN PR #$pr touches cited doc heading $_cited"
      fi
    done
  done <<< "$docheadings"
fi

# --- lane side helpers ---
_lane_num() {
  lane_ticket_num "$(claim_holder "$1")"
}

# Brace-expand each input line; held-entry text in, expanded lines out.
_expand_braces_lines() {
  while IFS= read -r line; do
    case "$line" in
      *{*) _expand_braces "$line" || printf '%s' "$line"
        printf '\n';;
      *) printf '%s\n' "$line";;
    esac
  done
  return 0
}

# Drop only the path a reason is about: in each clause (split on
# newlines, ";" and ". ") the token immediately before a reason phrase
# ("X stays out", "Y stays untouched", ...) is removed, and only when it
# is path-like (holds "/" or ".") and does not end in ":" or ",".
# Every other path in the clause stays held. Clauses are joined with a
# __CLAUSE__ marker so the entry collector can bound its file lists.
_strip_reason_paths() {
  python3 -c 'import sys, re
pat = re.compile(r"(?i)\b(stays out|stays untouched|not touched)\b")
def clean(cl):
  out = []
  pos = 0
  for m in pat.finditer(cl):
    pre = cl[pos:m.start()]
    mt = re.search(r"(\S+)\s*$", pre)
    if mt:
      tok = mt.group(1)
      if ("/" in tok or "." in tok) and not tok.endswith(":") and not tok.endswith(","):
        pre = pre[:mt.start(1)] + pre[mt.end(1):]
    out.append(pre)
    out.append(m.group(0))
    pos = m.end()
  out.append(cl[pos:])
  return "".join(out)
text = sys.stdin.read()
text = re.sub(r"\(\s*(?:\+|and)\s*(?:(?:their|its)\s+)?(?:\*?_tests(?:\.rs)?|tests|test files)\b", "(+tests", text)
sys.stdout.write(" __CLAUSE__ ".join(clean(c) for c in re.split(r"(?<=\.)\s+|[\n;]+", text)))' || cat
  return 0
}

# Free text on stdin -> candidate entries "ed|eb|ers|ere" on stdout.
# A token with a rooted directory part (two or more "/" levels, such as
# crates/main/src/theme_setting.rs) is a complete path from the repo root
# and resets the relative base to its own directory. A token with one
# relative level (host/fs.rs, case/run.rs) is read against the base as well
# as on its own, without moving the base. Only a bare filename (no "/")
# resolves purely against the base. "(+tests)" takes the directory of the
# file it follows, not the stale base.
# Tests file for every file in $1 (newline-separated full paths) on stdout.
_emit_list_tests() {
  printf '%s\n' "$1" | grep . | while IFS= read -r rp; do
    rf=${rp##*/}
    case "$rp" in */*) rd=${rp%/*};; *) rd="";; esac
    case "$rf" in *.*) : ;; *) continue;; esac
    rb=${rf%.*}; rx=${rf##*.}
    [ -n "$rb" ] && [ -n "$rx" ] && [ "$rb" != "$rf" ] || continue
    if [ -n "$rd" ]; then eb="$rd/${rb}_tests.$rx"; else eb="${rb}_tests.$rx"; fi
    printf '0|%s||\n' "$eb"
  done
  return 0
}

_collect_entries() {
  lastdir=""; lastbase=""; lastext=""; lastfiledir=""; recent=""; their=0
  _strip_reason_paths | tr ' \t,;' '\n\n\n\n' | grep . > "$tmp/toks"
  while IFS= read -r tok; do
    ctok=$(printf '%s' "$tok" | tr -d '`' | sed "s/^[(\[\"']*//" | sed "s/[],;:()\"']*$//")
    if [ "$ctok" = "__CLAUSE__" ]; then recent=""; their=0; continue; fi
    case "$ctok" in *[A-Za-z0-9]*) ;; *) continue;; esac
    if [ "$their" = "1" ]; then
      their=0
      case "$ctok" in _tests|tests)
        if [ -n "$recent" ]; then
          _emit_list_tests "$recent"
        elif [ -n "$lastbase" ] && [ -n "$lastext" ]; then
          if [ -n "$lastfiledir" ]; then eb="$lastfiledir/${lastbase}_tests.$lastext"; else eb="${lastbase}_tests.$lastext"; fi
          printf '0|%s||\n' "$eb"
        fi
        continue;;
      esac
    fi
    if [ "$ctok" = "+their" ]; then their=1; continue; fi
    if [ "$ctok" = "+tests" ]; then
      if [ -n "$recent" ]; then
        _emit_list_tests "$recent"
      elif [ -n "$lastbase" ] && [ -n "$lastext" ]; then
        if [ -n "$lastfiledir" ]; then eb="$lastfiledir/${lastbase}_tests.$lastext"; else eb="${lastbase}_tests.$lastext"; fi
        printf '0|%s||\n' "$eb"
      fi
      continue
    fi
    case "$ctok" in */*) : ;; *.*) : ;; *) continue;; esac
    case "$ctok" in *{*) ex=$(_expand_braces "$ctok") || continue;; *) ex=$ctok;; esac
    printf '%s\n' "$ex" > "$tmp/ex"
    while IFS= read -r e; do
      case "$e" in *[A-Za-z0-9]*) ;; *) continue;; esac
      case "$e" in */*) : ;; *.*) : ;; *) continue;; esac
      nn=$(_norm_tok "$e")
      ed=${nn%%|*}; rest=${nn#*|}; eb=${rest%%|*}; r2=${rest#*|}; ers=${r2%%|*}; ere=${r2#*|}
      [ -n "$eb" ] || continue
      case "$eb" in
        */*/*)
          printf '%s|%s|%s|%s\n' "$ed" "$eb" "$ers" "$ere"
          if [ "$ed" -eq 0 ]; then printf -v recent '%s%s\n' "$recent" "$eb"; fi
          lastdir=${eb%/*}
          if [ "$ed" -eq 0 ]; then
            lastfiledir=$lastdir
            fseg=${eb##*/}
            case "$fseg" in
              *.*) lastbase=${fseg%.*}; lastext=${fseg##*.}; [ "$lastbase" = "$fseg" ] && { lastbase=""; lastext=""; };;
              *) lastbase=""; lastext="";;
            esac
          fi;;
        */*)
          printf '%s|%s|%s|%s\n' "$ed" "$eb" "$ers" "$ere"
          if [ "$ed" -eq 0 ]; then printf -v recent '%s%s\n' "$recent" "$eb"; fi
          if [ -n "$lastdir" ]; then
            case "$lastdir/$eb" in "$eb") : ;; *) printf '%s|%s|%s|%s\n' "$ed" "$lastdir/$eb" "$ers" "$ere"
              if [ "$ed" -eq 0 ]; then printf -v recent '%s%s\n' "$recent" "$lastdir/$eb"; fi;;
            esac
          fi
          if [ "$ed" -eq 0 ]; then
            if [ -n "$lastdir" ]; then lastfiledir="$lastdir/${eb%/*}"; else lastfiledir=${eb%/*}; fi
            fseg=${eb##*/}
            case "$fseg" in
              *.*) lastbase=${fseg%.*}; lastext=${fseg##*.}; [ "$lastbase" = "$fseg" ] && { lastbase=""; lastext=""; };;
              *) lastbase=""; lastext="";;
            esac
          fi;;
        *)
          if [ -n "$lastdir" ]; then
            printf '%s|%s|%s|%s\n' "$ed" "$lastdir/$eb" "$ers" "$ere"
            if [ "$ed" -eq 0 ]; then printf -v recent '%s%s\n' "$recent" "$lastdir/$eb"; fi
          else
            printf '%s|%s|%s|%s\n' "$ed" "$eb" "$ers" "$ere"
            if [ "$ed" -eq 0 ]; then printf -v recent '%s%s\n' "$recent" "$eb"; fi
          fi
          if [ "$ed" -eq 0 ]; then
            lastfiledir=$lastdir
            case "$eb" in
              *.*) lastbase=${eb%.*}; lastext=${eb##*.}; [ "$lastbase" = "$eb" ] && { lastbase=""; lastext=""; };;
              *) lastbase=""; lastext="";;
            esac
          fi;;
      esac
    done < "$tmp/ex"
  done < "$tmp/toks"
  return 0
}

_ng_re='[Nn][Oo][Tt] [Gg][Rr][Aa][Nn][Tt][Ee][Dd]'

_lane_notes_entries() {
  # $1 = notes file. Prints candidate entry lines.
  [ -f "$1" ] || return 0
  {
    grep -i 'files granted:' "$1" 2>/dev/null | sed -e "s/$_ng_re.*//" | sed 's/.*files granted: *//' | sed -e 's/\.$//'
    grep -i fence "$1" 2>/dev/null | grep -vi 'files granted:' 2>/dev/null | sed -e "s/$_ng_re.*//"
  } | _expand_braces_lines | _collect_entries | _drop_bare_dirs
  return 0
}

# A notes entry holds a file, never a bare directory.
#
# A notes file's prose names whole areas constantly, and the `fence` grep above
# takes any line carrying the word. On 2026-10-31 lane #3743's sentence "#3770,
# #3654 and others are live in `crates/tui`. Parallel TUI lanes are the owner's
# standing call; the fence is what keeps them apart" put `crates/tui` in as an
# entry, and every file under the crate read HELD by #3743 -- which held no
# TUI file at all and had no grant file. It blocked lanes #3654 and #3774.
#
# A real whole-directory hold is written in a grant file, which `_grant_entries`
# builds and this does not filter.
_drop_bare_dirs() {
  while IFS= read -r _dbd; do
    _dbdp=${_dbd#*|}; _dbdp=${_dbdp%%|*}
    case "${_dbdp##*/}" in *.*) printf '%s\n' "$_dbd";; esac
  done
  return 0
}

# Drop sentences that describe someone ELSE's hold.
#
# A grant file explains its reasoning in prose, and that reasoning quotes the
# paths of other tickets' PRs and lanes. Those quotes were coming back as
# entries, so a path nobody held read HELD. The indent rule below catches the
# reasoning written under a bullet; this catches it written at column zero.
#
# The unit is the sentence, not the line, because one line can both grant a
# path and clear another in the next sentence:
#   "... add `crates/config/src/layout.rs` and `crates/config/src/lib.rs` ...
#    Neither file is held by an open PR. PR #3372 holds other config files only."
# Dropping that whole line would lose two real grants (2026-10-31).
#
# A sentence that grants a path never says the path is held by someone else,
# so these phrases are safe to cut.
_strip_foreign_hold() {
  python3 -I -c '
import re, sys
ph = re.compile(r"held by|held whole-file|reported held|does not touch|only doc changes", re.I)
for line in sys.stdin:
    parts = re.split(r"(?<=\.)\s+", line.rstrip("\n"))
    sys.stdout.write(" ".join(p for p in parts if not ph.search(p)) + "\n")
' 2>/dev/null
  return 0
}

_grant_entries() {
  # $1 = grant file. Prints candidate entry lines from its Paths block, or
  # scrapes a hand-written grant without Paths for compatibility. `Reads:`
  # latches the probe off for the rest of the file.
  #
  # An indented line is prose, not an entry. Every granted path in every grant
  # file written so far starts at column zero, as a `- <path>` bullet or a
  # `Ranges:` line; the indented lines under a bullet are the reasoning, and
  # that reasoning quotes other tickets' paths. Reading them as entries froze
  # three paths for lane #3634 that nobody held: `fiber-3771-fence-grant-B.md`
  # explains a release by quoting PR #3813's file list, so
  # `crates/main/tests/sandbox.rs`, `docs/permissions.md` and `docs/sandbox.md`
  # came back HELD by lane #3771, which never asked for any of them
  # (2026-10-31). `fiber-2413-plan-fence-grant.md` carries 700 lines of the
  # same shape.
  if grep -q '^Paths:[[:space:]]*$' "$1" 2>/dev/null; then
    awk '/^Reads:[[:space:]]*$/ {stop = 1} /^##([[:space:]]|$)/ {stop = 1} stop {next} /^Paths:[[:space:]]*$/ {paths = 1; next} paths {print}' "$1" 2>/dev/null
  else
    awk '/^Reads:[[:space:]]*$/ {stop = 1} stop {next} {if (tolower($0) ~ /grant/) f = 1} f && /^[[:space:]]/ {next} f {print}' "$1" 2>/dev/null
  fi | _strip_foreign_hold | sed -e "s/$_ng_re.*//" | _expand_braces_lines | _collect_entries | _narrow_grant_entries
  return 0
}

_grant_part() {
  awk '/^Paths:[[:space:]]*$/ { exit } /^Part: [0-9][0-9]*$/ { sub(/^Part: /, ""); print; exit }' "$1" 2>/dev/null
}

# Parts advance monotonically; the highest tagged grant identifies the lane's
# current part. A legacy grant without a part stays conservative and holds.
_lane_current_part() {
  _lcp=""
  for _lcp_file in "$run"/fiber-"$1"*-fence-grant*.md; do
    [ -f "$_lcp_file" ] || continue
    _lcp_base=$(basename "$_lcp_file")
    _lcp_rest=${_lcp_base#fiber-}
    case "$_lcp_rest" in "$1"-*|"$1"[a-z]*-*) : ;; *) continue;; esac
    _lcp_part=$(_grant_part "$_lcp_file")
    case "$_lcp_part" in ''|*[!0-9]*) continue;; esac
    [ "$_lcp_part" -gt 0 ] || continue
    if [ -z "$_lcp" ] || [ "$_lcp_part" -gt "$_lcp" ]; then _lcp=$_lcp_part; fi
  done
  printf '%s' "$_lcp"
}

# A grant file carrying both a bullet for a path and ranges for the same path
# holds only the ranges; the bullet is their label (#1107: every ranged grant
# read as a whole-file hold, so a window its holder had excluded still refused).
# A path with no ranges stays a whole-file hold. Per-file: the caller feeds one
# grant file at a time, so ranges in one file never narrow another file.
_narrow_grant_entries() {
  awk -F'|' '
    { n++; line[n] = $0; ed[n] = $1; eb[n] = $2; ers[n] = $3
      if ($1 == "0" && $3 != "") ranged[$2] = 1 }
    END { for (i = 1; i <= n; i++) {
      if (ed[i] == "0" && ers[i] == "" && (eb[i] in ranged)) continue
      print line[i] } }
  ' 2>/dev/null
  return 0
}

# Check candidate entries in $1 against the plist, attributing to lane $2.
_check_entries() {
  while IFS='|' read -r ed eb ers ere; do
    [ -n "$eb" ] || continue
    case "$ed" in 0|1) : ;; *) continue;; esac
    while IFS= read -r p; do
      nn=$(_norm_tok "$p")
      pd=${nn%%|*}; r1=${nn#*|}; pb=${r1%%|*}
      [ -n "$pb" ] || continue
      if _conflict "$pd" "$pb" "$ed" "$eb" "$ers" "$ere"; then
        if [ "${4:-}" = exclusive ]; then
          held="${held}${p}|${3:-lane #${2}}|${5:--}
"
        else
          overlaps="${overlaps}${p}|${3:-lane #${2}}
"
        fi
      fi
    done < "$tmp/plist"
  done < "$1"
  return 0
}

_claim_holders

# live lanes: notes + their grant files
for ln in $lanes; do
  case "$ln" in fiber-*) suf=${ln#fiber-};; *) continue;; esac
  n=$(_lane_num "$suf")
  [ -n "$n" ] || continue
  [ "$n" = "$ticket" ] && continue
  case " $ignoreticket " in *" $n "*) continue;; esac
  : > "$tmp/notes-entries"
  if [ -f "$run/fiber-$n-notes.md" ]; then
    _lane_notes_entries "$run/fiber-$n-notes.md" >> "$tmp/notes-entries"
  fi
  if [ "$suf" != "$n" ] && [ -f "$run/fiber-$suf-notes.md" ]; then
    _lane_notes_entries "$run/fiber-$suf-notes.md" >> "$tmp/notes-entries"
  fi
  set +f
  lane_part=$(_lane_current_part "$n")
  for gf in "$run"/fiber-"$n"*-fence-grant*.md; do
    [ -f "$gf" ] || continue
    b=$(basename "$gf")
    rest=${b#fiber-}
    case "$rest" in "$n"-*|"$n"[a-z]*-*) : ;; *) continue;; esac
    grant_part=$(_grant_part "$gf")
    if [ -n "$grant_part" ] && [ -n "$lane_part" ] && [ "$grant_part" != "$lane_part" ]; then continue; fi
    set -f
    : > "$tmp/grant-entries"
    _grant_entries "$gf" >> "$tmp/grant-entries"
    [ -s "$tmp/grant-entries" ] && _check_entries "$tmp/grant-entries" "$n" "lane #${n} (grant ${b})"
    set +f
  done
  set -f
  [ -s "$tmp/notes-entries" ] && _check_entries "$tmp/notes-entries" "$n" "lane #${n} (notes, no grant file names it)"
done

# fresh grant files hold even without a live lane (skip the ticket itself)
now=$(date +%s)
set +f
for gf in "$run"/fiber-*-fence-grant*.md; do
  [ -f "$gf" ] || continue
  b=$(basename "$gf")
  set -f
  x=${b#fiber-}
  x=${x%-fence-grant*}
  case "$x" in *fence-grant*) set +f; continue;; esac
  n=$(_lane_num "$x")
  [ -n "$n" ] || { set +f; continue; }
  [ "$n" = "$ticket" ] && { set +f; continue; }
  case " $ignoreticket " in *" $n "*) set +f; continue;; esac
  skip=0
  for ln in $lanes; do
    case "$ln" in fiber-*) s2=${ln#fiber-};; *) continue;; esac
    if [ "$(_lane_num "$s2")" = "$n" ]; then skip=1; break; fi
  done
  if [ "$skip" -eq 0 ]; then
    m=$(fw_mtime "$gf")
    case "$m" in ''|*[!0-9]*) : ;; *) [ $((now - m)) -lt 21600 ] && {
      : > "$tmp/fentries"
      _grant_entries "$gf" >> "$tmp/fentries"
      _age=$(( (now - m) / 60 ))
      if ! _lane_claim_count "$n"; then exit 3; fi
      _claim_count=$_lc_count
      if [ "$_claim_count" -gt 0 ]; then
        _lbl="lane #${n} no running session seen, holds ${_claim_count} claims; check file-claim before treating this grant as dead (grant ${b})"
      else
        _lbl="lane #${n} NO LIVE LANE: ${b} is ${_age}m old, holds until 360m (grant ${b})"
      fi
      [ -s "$tmp/fentries" ] && _check_entries "$tmp/fentries" "$n" "$_lbl"
    };; esac
  fi
  set +f
done
set -f

# A whole-file hold by a pull request is the pessimistic answer: the thing that
# actually collides is a hunk. Print the holder's hunk windows and the
# complement as a ready --ranges argument, so granting the rest of the file is a
# choice rather than the default. Twice in one round a lane waited on a hold
# whose holder had changed a single line in the file.
_suggest() {
  _spr=$1; _sfile=$2
  [ -s "$tmp/full-$_spr.diff" ] || return 0
  _pr_hunks "$tmp/full-$_spr.diff" "$_sfile" > "$tmp/sh" || return 0
  [ -s "$tmp/sh" ] || return 0
  grep -q '^NEWHUNK$' "$tmp/sh" && { echo "  the pull request adds this file whole, so there is no complement"; return 0; }
  _len=$("${FW_GH:-gh}" api "repos/$repo/contents/$_sfile?ref=main" -H 'Accept: application/vnd.github.raw' 2>/dev/null | wc -l | tr -d ' ')
  case "$_len" in ''|0|*[!0-9]*) _len=END;; esac
  awk '{ a = $1 + 0; b = $2 + 0; e = a + b; if (e <= a) e = a + 1; print a "\t  held window " a "-" (e - 1) }' "$tmp/sh" | sort -n -u | cut -f2-
  sort -n "$tmp/sh" | awk -v len="$_len" -v f="$_sfile" '
    BEGIN { nxt = 1; sep = ""; out = "" }
    { a = $1 + 0; e = a + $2; if (e <= a) e = a + 1
      if (a > nxt) { out = out sep f ":" nxt "-" (a - 1); sep = "," }
      if (e > nxt) nxt = e }
    END { if (len == "END") { out = out sep f ":" nxt "-END" }
          else if (len + 0 >= nxt) { out = out sep f ":" nxt "-" len }
          if (out != "") print "  --ranges " out }'
  [ "$_len" = "END" ] && echo "  (could not read the file length on main; replace END with it)"
  return 0
}

if [ -n "$(printf '%s' "$held" | grep .)" ]; then
  printf '%s' "$held" | grep . | awk -F'|' '
    function rank(label) {
      if (label ~ / \(grant [^)]*\)$/) return 3
      if (label ~ / \(notes, no grant file names it\)$/) return 2
      return 1
    }
    {
      holder = $2
      sub(/ \((grant [^)]*|notes, no grant file names it)\)$/, "", holder)
      key = $1 "|" holder
      if (!(key in slot)) { slot[key] = ++n; keys[n] = key; ages[key] = $3; suggestions[key] = $4 }
      if (rank($2) > ranks[key]) { ranks[key] = rank($2); paths[key] = $1; labels[key] = $2; ages[key] = $3; suggestions[key] = $4 }
    }
    END { for (i = 1; i <= n; i++) { key = keys[i]; line = "HELD " paths[key] " by " labels[key]; if (suggestions[key] != "") line = line "\t" suggestions[key]; print line "\034" suggestions[key] "\034" ages[key] } }
  ' > "$tmp/heldout"
  while IFS=$'\034' read -r line sug _ref_age; do
    case "$line" in
      HELD\ *\ by\ *)
        _ref_path=${line#HELD }
        _ref_holder=${_ref_path#* by }
        _ref_path=${_ref_path%% by *}
        [ -n "$_ref_age" ] || _ref_age="-"
        _log_refusal "$_ref_path" "$_ref_holder" "$_ref_age" ;;
    esac
    echo "$line"
    [ -n "$sug" ] || continue
    _suggest "${sug%% *}" "${sug#* }"
  done < "$tmp/heldout"
  exit 1
fi

# --- the grant records itself in the claims ledger ---
# A file claim holds each granted path whole. --plan, not --grant: the grant cap
# counts grants, and a lane's whole path set must claim as one; re-claiming the
# same lane and kind is an idempotent no-op. Reads hold nothing and are never
# claimed. A dry run probes only and claims nothing.
if [ "$dry" -eq 0 ]; then
  fc_args=(); fc_ranges=""
  while IFS='|' read -r _rf _rs _re; do
    [ -n "$_rf" ] || continue
    fc_ranges="${fc_ranges:+$fc_ranges,}$_rf:$_rs-$_re"
  done <"$tmp/rspec"
  while IFS= read -r _cp; do
    [ -n "$_cp" ] || continue
    _cp=${_cp#./}
    _cp=${_cp%/}
    [ -n "$_cp" ] || continue
    fc_args+=("$_cp")
  done < "$tmp/plist"
  if [ "${#fc_args[@]}" -gt 0 ]; then
    : > "$tmp/fc-overlaps"
    fc_cmd=("$file_claim" claim --lane "$(claim_holder "$ticket")" --plan --repo "$repo")
    # Every PR skipped above as this ticket's own, plus --ignore-pr, must
    # exempt the claim too, or the ledger refuses a path the own PR holds.
    # file-claim takes one --self-pr per flag; each exempt PR gets its own.
    _seen_self=""
    # shellcheck disable=SC2086
    for _op in $ownprs $ignore; do
      [ -n "$_op" ] || continue
      case " $_seen_self " in *" $_op "*) continue;; esac
      _seen_self="$_seen_self $_op"
      fc_cmd+=(--self-pr "$_op")
    done
    if [ -n "$fc_ranges" ]; then
      # The fence probe checked these PRs by hunk; exempt them from the
      # file-level PR check before recording the whole-file claim.
      for _op in $prs; do
        [ -n "$_op" ] || continue
        case " $_seen_self " in *" $_op "*) continue;; esac
        _seen_self="$_seen_self $_op"
        fc_cmd+=(--self-pr "$_op")
      done
    fi
    fc_cmd+=(-- "${fc_args[@]}")
    if "${fc_cmd[@]}" >"$tmp/fc-out" 2>"$tmp/fc-err"; then
      awk '$1 == "OVERLAP" && NF >= 3 { print $2 "|" $3 }' "$tmp/fc-out" >> "$tmp/fc-overlaps"
      while IFS='|' read -r _ofp _ofh; do
        [ -n "$_ofp" ] || continue
        case "$_ofh" in
          pr\#*) overlaps="${overlaps}${_ofp}|PR #${_ofh#pr#}
";;
          lane:fiber-*)
            _ofn=${_ofh#lane:fiber-}
            case " $ignoreticket " in *" $_ofn "*) continue;; esac
            overlaps="${overlaps}${_ofp}|lane #${_ofn}
";;
          lane:*) overlaps="${overlaps}${_ofp}|lane ${_ofh#lane:}
";;
          *) overlaps="${overlaps}${_ofp}|${_ofh}
";;
        esac
      done < "$tmp/fc-overlaps"
    else
      fc_rc=$?
      if [ "$fc_rc" -eq 1 ]; then
        awk -v ignored="$ignoreticket" '
$1 == "OVERLAP" && NF >= 3 {
  p = $2; h = $3; line = ""
  if (h ~ /^pr#[0-9][0-9]*$/) line = "OVERLAP " p " PR #" substr(h, 4)
  else if (h ~ /^lane:fiber-[0-9][0-9]*$/) {
    n = h; sub(/^lane:fiber-/, "", n)
    if (index(" " ignored " ", " " n " ")) next
    line = "OVERLAP " p " lane #" n
  }
  else if (h ~ /^lane:/) line = "OVERLAP " p " lane " substr(h, 6)
  else line = "OVERLAP " p " " h
  if (!seen[line]++) print line
  next
}
$1 == "REFUSE" && NF >= 4 && $3 == "exclusive" && $4 ~ /^lane:/ {
  p = $2; lane = $4; sub(/^lane:/, "", lane)
  line = "HELD " p " by lane " lane
  if (!seen[line]++) print line
  next
}
$1 == "REFUSE" && NF >= 3 {
  p = $2; h = $3; line = ""
  if (h ~ /^pr#[0-9][0-9]*$/) line = "HELD " p " by PR #" substr(h, 4)
  else if (h ~ /^lane:fiber-[0-9][0-9]*$/) { n = h; sub(/^lane:fiber-/, "", n); line = "HELD " p " by lane #" n }
  else if (h ~ /^lane:/) line = "HELD " p " by lane " substr(h, 6)
  else if (h == "cap") line = "HELD " p " by file-claim grant cap"
  else line = "HELD " p " by file-claim " h
  if (!seen[line]++) print line
  next
}
$1 == "GRANT" || $1 == "UNCLAIMED" || $1 == "file-claim:" || NF == 0 { next }
{ if (!seen[$0]++) print }' "$tmp/fc-out" > "$tmp/fc-held"
        awk '
$1 == "REFUSE" && NF >= 3 {
  path = $2; holder = $3
  if (holder == "exclusive" && $4 ~ /^lane:/) holder = $4
  if (holder ~ /^pr#[0-9][0-9]*$/) holder = "PR #" substr(holder, 4)
  else if (holder ~ /^lane:fiber-[0-9][0-9]*$/) { sub(/^lane:fiber-/, "lane #", holder) }
  else if (holder ~ /^lane:/) { sub(/^lane:/, "lane ", holder) }
  else holder = "-"
  key = path SUBSEP holder
  if (!seen[key]++) print path "\t" holder
}' "$tmp/fc-out" > "$tmp/fc-refusals"
        while IFS="$(printf '\t')" read -r _ref_path _ref_holder; do
          [ -n "$_ref_path" ] || continue
          _ref_age=$(_refusal_age "$_ref_path" "$_ref_holder")
          _log_refusal "$_ref_path" "$_ref_holder" "$_ref_age"
        done < "$tmp/fc-refusals"
        if [ -s "$tmp/fc-held" ]; then cat "$tmp/fc-held"; else cat "$tmp/fc-out"; fi
        exit 1
      else
        g=$(head -c 200 "$tmp/fc-err" 2>/dev/null | tr '\n' ' ')
        echo "ERROR file-claim claim $g"
        exit 3
      fi
    fi
  fi
fi

# --- grant: locked numbering over existing files (unnumbered counts as 1) ---
if [ -n "$(printf '%s' "$overlaps" | grep .)" ]; then
  printf '%s' "$overlaps" | awk -F'|' '
    {
      path = $1; holder = $2
      if (holder ~ /^lane #[0-9]+/) {
        number = holder
        sub(/^lane #/, "", number)
        sub(/[^0-9].*$/, "", number)
        holder = "lane #" number
      }
      key = path "|" holder
      if (!seen[key]++) printf "%s\t%s\n", path, holder
    }
  ' > "$tmp/overlapout"
else
  : > "$tmp/overlapout"
fi
if [ "$dry" -eq 0 ]; then
  lock_tries=${FW_LOCK_TRIES:-50}
  lock_poll=${FW_LOCK_POLL:-0.2}
  i=0
  while ! mkdir "$lockdir" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -ge "$lock_tries" ] && { echo "ERROR cannot lock $lockdir"; exit 3; }
    sleep "$lock_poll"
  done
  locked=1
  max=0
  set +f
  for gf in "$run"/fiber-"$ticket"-fence-grant*.md; do
    [ -e "$gf" ] || continue
    b=$(basename "$gf")
    set -f
    rest=${b#fiber-$ticket-fence-grant}
    case "$rest" in
      .md) n=1;;
      -*.md) n=${rest#-}; n=${n%.md}; case "$n" in ''|*[!0-9]*) set +f; continue;; esac;;
      *) set +f; continue;;
    esac
    [ "$n" -gt "$max" ] && max=$n
    set +f
  done
  set -f
  k=$((max + 1))
  gf="$run/fiber-$ticket-fence-grant-$k.md"
  nowd=$(date '+%a %b %d %T %Z %Y')
  {
    printf 'Grant %s (fence-grant, %s)\n\nTicket: %s\nPart: %s\n' "$k" "$nowd" "$ticket" "$part"
    [ -z "$sweptto" ] || printf 'Swept to comment %s\n' "$sweptto"
    printf 'Paths:\n'
    sed 's/^/- /' < "$tmp/plist"
    if [ -s "$tmp/newnorm" ]; then
      printf '\n## New (do not exist on origin/main):\n'
      sed 's/^/- /' < "$tmp/newnorm"
    fi
    while IFS="$(printf '\t')" read -r _ovp _ovh; do
      [ -n "$_ovp" ] || continue
      printf 'overlap: %s %s\n' "$_ovp" "$_ovh"
    done < "$tmp/overlapout"
    if [ -n "$ranges" ]; then printf 'Ranges: %s\n' "$ranges"; else printf 'Ranges: none\n'; fi
    printf '\nNo exclusive hold blocks these paths (checked open PRs:%s; live lanes:%s; claims).\n' " $prs" " $lanes"
    # An `&&` here would be the group's last command and would fail it when there is nothing to skip.
    if [ -n "$ownprs" ]; then printf 'Skipped this ticket own open PRs:%s.\n' " $ownprs"; fi
    # Last in the file, and nothing may follow: `Reads:` latches the lane hold
    # probe off, so these paths hold nothing against the next lane.
    if [ -n "$readpaths" ]; then
      printf '\nReads:\n'
      printf '%s\n' "$readpaths" | tr ',' '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e 's/^/- /'
    fi
  } > "$gf" 2>/dev/null || { echo "ERROR cannot write $gf"; exit 3; }
  host=$(hostname) || { echo 'ERROR cannot determine host name'; exit 3; }
  grant_path="$(_fw_abs_path "$run")/${gf##*/}"
  printf 'GRANT FILE host=%s path=%s\n' "$host" "$grant_path" >&2
fi
while IFS="$(printf '\t')" read -r _ovp _ovh; do
  [ -n "$_ovp" ] || continue
  printf 'OVERLAP %s %s\n' "$_ovp" "$_ovh"
done < "$tmp/overlapout"
# A path granted with no --ranges entry is a whole-file hold by definition:
# warn, non-blocking, before the grant lines. A dry run prefixes each with
# WOULD-GRANT so its output cannot be mistaken for an applied grant.
while IFS= read -r _wp; do
  [ -n "$_wp" ] || continue
  _wb=$(_norm_base "$_wp") || continue
  [ -n "$_wb" ] || continue
  if ! cut -d'|' -f1 < "$tmp/rspec" | grep -qxF "$_wb"; then
    echo "WIDE $_wp is granted whole (no --ranges): a lane needing one line of it will see an OVERLAP."
  fi
done < "$tmp/plist"
repo_root="$(cd "$self_dir/.." 2>/dev/null && pwd)"
docs_dir="$repo_root/docs"
if [ -n "$removes" ] && [ -d "$repo_root/test" ]; then
  printf '%s\n' "$removes" | tr ',' '\n' | while IFS= read -r _symbol; do
    _symbol=$(printf '%s' "$_symbol" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    [ -n "$_symbol" ] || continue
    _testpaths=$(grep -RIlF -- "$_symbol" "$repo_root/test" 2>/dev/null | sed "s#^$repo_root/##" | sort | paste -sd, -)
    [ -n "$_testpaths" ] || continue
    printf 'TEST %s\n  suggested --paths %s\n' "$_symbol" "$_testpaths"
  done
fi
if [ -d "$docs_dir" ]; then
  while IFS= read -r _wp; do
    [ -n "$_wp" ] || continue
    _matches=$(grep -RInF -- "$_wp" "$docs_dir" 2>/dev/null | sed "s#^$repo_root/##")
    [ -n "$_matches" ] || continue
    printf 'DOC %s\n%s\n' "$_wp" "$_matches"
  done < "$tmp/plist"
fi
if [ "$dry" -eq 1 ]; then sed 's/^/WOULD-GRANT /' < "$tmp/plist"; else sed 's/^/GRANT /' < "$tmp/plist"; fi
if [ -n "$readpaths" ]; then
  printf '%s\n' "$readpaths" | tr ',' '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e 's/^/READ /'
fi
if [ "$dry" -eq 1 ]; then echo "WOULD-GRANT"; else echo "GRANT"; fi
exit 0
