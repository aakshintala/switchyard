  cp "$cache/$treesha.tree" "$tmp/tree" || { echo "ERROR cannot read tree cache"; exit 3; }
else
  treejson=$("${FW_GH:-gh}" api "repos/$repo/git/trees/$treesha?recursive=1" 2>"$tmp/treeerr") || { g=$(head -c 200 "$tmp/treeerr" 2>/dev/null | tr '\n' ' '); echo "ERROR gh trees main $g"; exit 3; }
  printf '%s' "$treejson" | python3 -I -c 'import json,sys
try:
  d = json.load(sys.stdin)
except Exception:
  sys.exit(1)
if d.get("truncated"):
  sys.exit(1)
t = d.get("tree")
if not isinstance(t, list):
  sys.exit(1)
for e in t:
  if isinstance(e, dict) and e.get("type") == "blob" and e.get("path"):
    print(e["path"])' > "$tmp/tree" || { echo "ERROR tree of main unreadable or truncated"; exit 3; }
  [ -s "$tmp/tree" ] || { echo "ERROR tree of main is empty"; exit 3; }
  mkdir -p "$cache" || { echo "ERROR cannot create tree cache"; exit 3; }
  cachetmp=$(mktemp "$cache/.tree.XXXXXX") || { echo "ERROR cannot make tree cache temp file"; exit 3; }
  cp "$tmp/tree" "$cachetmp" && mv "$cachetmp" "$cache/$treesha.tree" || { echo "ERROR cannot write tree cache"; exit 3; }
  cachetmp=""
fi

python3 -I -c 'import sys
pn, tr, nw = sys.argv[1], sys.argv[2], sys.argv[3]
tree = [l.rstrip("\n") for l in open(tr) if l.strip()]
tset = set(tree)
dirs = set()
for p in tree:
  parts = p.split("/")
  for i in range(1, len(parts)):
    dirs.add("/".join(parts[:i]))
new = set(l.strip() for l in open(nw) if l.strip())
def suggest(b):
  base = b.split("/")[-1]
  out = [p for p in tree if p.split("/")[-1] == base and p != b]
  alts = set()
  if "/" in b:
    i = b.rfind("/")
    alts.add(b[:i] + "_" + b[i + 1:])
  if "_" in base:
    i = b.rfind("_")
    alts.add(b[:i] + "/" + b[i + 1:])
  out += [a for a in sorted(alts) if a in tset and a not in out]
  return out[:5]
bad = 0
for line in open(pn):
  line = line.rstrip("\n")
  if not line:
    continue
  d, b, raw = line.split("|", 2)
  if b in new:
    continue
  ok = (b in tset or b in dirs) if d == "1" else (b in tset)
  if ok:
    continue
  bad = 1
  print("MISSING %s" % raw)
  s = suggest(b)
  if s:
    print("  did you mean: %s" % ", ".join(s))
sys.exit(4 if bad else 0)' "$tmp/pnorm" "$tmp/tree" "$tmp/newnorm" > "$tmp/pathcheck"
_pathrc=$?
cat "$tmp/pathcheck"
case "$_pathrc" in
  0) : ;;
  4)
    _missing_count=$(grep -c '^MISSING ' "$tmp/pathcheck")
    _path_plural=s
    [ "$_missing_count" -eq 1 ] && _path_plural=
    echo "NO PROBE: $_missing_count path$_path_plural missing, no hold check ran; move them to --new"
    exit 4
    ;;
  *) echo "ERROR path existence check"; exit 3;;
esac

# --expect <file:line:symbol>: existence is not enough when a grant names lines.
# #3666's grant named a real file that holds no `envelope_line` at all.
# Hash, not a slug: `tr / _` maps process/tests.rs and process_tests.rs to one
# cache file, so the sibling check read the file it was comparing against.
_blob_path() { printf '%s/blob-%s' "$tmp" "$(printf '%s' "$1" | shasum | cut -c1-16)"; }
_fetch_blob() {
  _bf=$(_blob_path "$1")
  [ -f "$_bf" ] && return 0
  # `gh` reads stdin, and these calls run inside `while read` loops fed by a
  # file: without this the first call swallows the rest of the loop's input.
  "${FW_GH:-gh}" api "repos/$repo/contents/$1?ref=main" -H "Accept: application/vnd.github.raw" > "$_bf" 2>"$tmp/bloberr" < /dev/null || { g=$(head -c 200 "$tmp/bloberr" 2>/dev/null | tr '\n' ' '); echo "ERROR gh contents $1 $g"; return 1; }
  return 0
}
_line_has() { sed -n "${2}p" "$(_blob_path "$1")" 2>/dev/null | grep -Fq -- "$3"; }
_normalize_doc_heading() {
  sed -E 's/^#+[[:space:]]*//; s/[[:space:]]*#+[[:space:]]*$//; s/`//g'
}
_doc_has_heading() {
  _dh_want=$(printf '%s\n' "$2" | _normalize_doc_heading)
  grep '^#' "$(_blob_path "$1")" | _normalize_doc_heading | grep -qxF -- "$_dh_want"
}

if [ -n "$docheadings" ]; then
  while IFS= read -r _cited; do
    [ -n "$_cited" ] || continue
    case "$_cited" in docs/*\#*) ;; *) echo "ERROR doc heading not found: $_cited"; exit 2;; esac
    _doc=${_cited%%#*}; _heading=${_cited#*#}
    [ -n "$_heading" ] || { echo "ERROR doc heading not found: $_cited"; exit 2; }
    if ! grep -qxF -- "$_doc" "$tmp/tree"; then
      echo "ERROR doc heading not found: $_cited"
      exit 2
    fi
    _fetch_blob "$_doc" || exit 3
    if ! _doc_has_heading "$_doc" "$_heading"; then
      echo "ERROR doc heading not found: $_cited"
      exit 2
    fi
  done <<< "$docheadings"
fi

if [ -n "$expects" ]; then
  : > "$tmp/nosym"
  _expand_braces "$expects" > "$tmp/eexp" || { echo "ERROR brace expansion"; exit 3; }
  tr ',' '\n' < "$tmp/eexp" | sed 's/^ *//; s/ *$//' | grep . > "$tmp/eitems" || true
  while IFS= read -r _ei; do
    _ef=${_ei%%:*}; _erest=${_ei#*:}
    _el=${_erest%%:*}; _esym=${_erest#*:}
    [ "$_ef" != "$_ei" ] && [ "$_el" != "$_erest" ] && [ -n "$_esym" ] || { _usage; exit 2; }
    case "$_el" in ''|*[!0-9]*) _usage; exit 2;; esac
    _ef=$(_norm_base "$_ef")
    [ -n "$_ef" ] || { _usage; exit 2; }
    if ! grep -qxF -- "$_ef" "$tmp/tree"; then
      echo "MISSING $_ef" >> "$tmp/nosym"
      continue
    fi
    _fetch_blob "$_ef" || exit 3
    if _line_has "$_ef" "$_el" "$_esym"; then continue; fi
    echo "NOSYMBOL $_ef:$_el does not hold $_esym" >> "$tmp/nosym"
    _ebase=${_ef##*/}
    # Same-basename siblings, plus the two spellings that keep tripping this up:
    # the last "/" written as "_" and back (process/tests.rs vs process_tests.rs).
    # The spelling alternates come first: a basename like `tests.rs` matches
    # dozens of files, and they would crowd out the one answer that matters.
    { python3 -I -c 'import sys
b = sys.argv[1]
out = []
if "/" in b:
  i = b.rfind("/")
  out.append(b[:i] + "_" + b[i + 1:])
if "_" in b.split("/")[-1]:
  i = b.rfind("_")
  out.append(b[:i] + "/" + b[i + 1:])
print("\n".join(out))' "$_ef"
      awk -v b="$_ebase" -F/ '$NF == b' "$tmp/tree"
    } | grep . | awk '!s[$0]++' | grep -vxF -- "$_ef" > "$tmp/cands" || true
    awk 'NR==FNR {t[$0]=1; next} ($0 in t)' "$tmp/tree" "$tmp/cands" | head -6 > "$tmp/sibs" || true
    while IFS= read -r _sb; do
      [ -n "$_sb" ] || continue
      _fetch_blob "$_sb" || exit 3
      if _line_has "$_sb" "$_el" "$_esym"; then
        echo "  did you mean: $_sb:$_el" >> "$tmp/nosym"
      fi
    done < "$tmp/sibs"
  done < "$tmp/eitems"
  if [ -s "$tmp/nosym" ]; then
    cat "$tmp/nosym"
    _missing_count=$(grep -cE '^(MISSING|NOSYMBOL) ' "$tmp/nosym")
    _missing_plural=s
    [ "$_missing_count" -eq 1 ] && _missing_plural=
    echo "NO PROBE: $_missing_count path$_missing_plural or symbol$_missing_plural missing, no hold check ran; correct missing --paths/--expect entries"
    exit 4
  fi
fi

# --- open PRs (fail closed) ---
prjson=$("${FW_GH:-gh}" pr list -R "$repo" --state open --limit 200 --json number,headRefName,changedFiles 2>"$tmp/gherr") || { g=$(head -c 200 "$tmp/gherr" 2>/dev/null | tr '\n' ' '); echo "ERROR gh pr list $g"; exit 3; }
