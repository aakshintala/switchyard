[ "$msess_ok" -eq 1 ] || { echo "ERROR mac delegate sessions: delegate session list failed, or the roster mapper refused the JSON"; exit 3; }
# A lane is a Claude session, a pi lane or a delegate job; each holds its
# fence. A pi lane launched by delegate shows up twice, so the list is
# deduplicated to keep one HELD line per lane.
lanes=$(printf '%s\n' $mac_names $box_names $pimac_names $pibox_names $dmac_names $dbox_names $dsess_names $msess_names | grep . | sort -u | tr '\n' ' ')

held=""
overlaps=""

# file-claim is a holder source too. Validate the complete list before using
# any row; a failed or partial read must never turn into an empty fence.
# Before a real grant, remove closed-ticket claims and fence-grant files so
# they cannot survive into this guard's holder checks.
if [ "$dry" -eq 0 ]; then
  "$file_claim" reap --repo "$repo" || { echo "ERROR file-claim reap failed"; exit 3; }
fi
claims_out="$tmp/claims.out"
claims_err="$tmp/claims.err"
if "$file_claim" list --repo "$repo" >"$claims_out" 2>"$claims_err"; then
  python3 -c 'import sys
for line in sys.stdin:
  fields = line.rstrip("\n").split("\t")
  if len(fields) != 6:
    sys.exit(1)
  path, lane, kind, age, worktree, pr = fields
  # file-claim list also reports open-PR paths; the PR side below holds those.
