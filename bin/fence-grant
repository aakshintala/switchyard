#!/bin/bash
# fence-grant <ticket> --paths <comma list> [--ranges <file:start-end,...>]
#   [--reads <comma list>] [--new <comma list>] [--expect <file:line:symbol,...>]
#   [--repo <owner/name>] [--part <n>] [--ignore-pr <n>] [--ignore-ticket <n>]
#   [--swept-to <comment id>] [--removes <symbol,...>]
#   [--doc-heading <docs/file.md#heading> (review warning, not a grant)] [--pre-plan <path-shape>] [--dry]
# The script owns grant numbering; hand-written grants take a letter suffix.
# Grants requested paths despite overlaps with open PRs and ordinary lanes.
# A sweep-* file claim or grant cap still blocks; unreadable probes fail closed.
#
# The claim's ticket state, not a process or holder name, decides whether a
# non-sweep claim is stale: a retired lane's session can stay alive (#1313,
# inverse of #1272). A failed or incomplete lookup leaves the state unknown, so
# the claim is held by the live-lane check instead of refusing the grant.
#
# Before any hold probe it checks that the grant can mean what it says, against
# `main`: every requested path exists unless --new declares it, and every
# --expect <file:line:symbol> finds that symbol on that line. Either check
# failing prints MISSING or NOSYMBOL with same-basename suggestions plus a NO
# PROBE line, and exits 4,
# writing no grant file. Three times a grant named a path that could not hold it
# (2026-10-17 #3753: `crates/turn/src/group.rs` for `crates/tui/src/turn/group.rs`;
# 2026-10-31 #3666: `process/tests.rs:3154` for `process_tests.rs:3154`, where
# both files exist, so existence alone passed it and a lane lost two
# round-trips). A clean GRANT on a path like that reads as launchable.
#
# A fence is about writes. --reads records the files the lane only reads: they
# are probed for nothing, and they land under a `Reads:` label that the lane
# hold probe stops at, so they hold nothing against the next lane. Record a read
# under --paths and the file freezes for the lane's whole life for no reason
# (2026-10-31 #3771: `docs/events.md` came back HELD by lane #3459, whose own
# admit calls the file a read and whose PR #3813 does not touch it; the hold
# would have blocked the one doc row surveyor had just ordered into #3771).
# When a grant has `Paths:`, only that block through the first `##` heading is
# probed, with `Reads:` still ending it. A hand-written grant without `Paths:`
# keeps the older scrape through `Reads:` for compatibility.
#
# Two consequences of that, both paid for on 2026-10-31:
#
#   1. A grant written only into a lane's admit file holds nothing. The probe
#      reads `run/fiber-<n>*-fence-grant*.md` files and open PRs, nothing else,
#      so the next sweep hands the same path to a second lane. Every grant
#      lands as both: the admit block the lane reads, and this file.
#   2. A hand-written grant without `Paths:` still scrapes prose through
#      `Reads:`. Put granted paths in `Paths:` and explanatory prose below a
#      `##` heading so it cannot add another hold.
set -u
set -f
_fw_run() { printf '%s' "${FW_RUN:-$HOME/work/fiber-worktrees/flywheel/run}"; }
_fw_box_host() { printf '%s' "${FW_BOX_HOST:-roundhouse-7010-plus-1.local}"; }
_fw_is_box() {
  local box_host box_short host_full host_short
  box_host=$(_fw_box_host)
  box_short=${box_host%%.*}
  host_full=$(hostname 2>/dev/null) || host_full=""
  host_short=$(hostname -s 2>/dev/null) || host_short=${host_full%%.*}
  [ "$host_full" = "$box_host" ] || [ "$host_full" = "$box_short" ] ||
    [ "$host_short" = "$box_host" ] || [ "$host_short" = "$box_short" ]
}
_fw_box_exec() {
  local cmd="$1"
  if [ -n "${FW_SSH:-}" ]; then
    "$FW_SSH" "$(_fw_box_host)" "$cmd" 2>"${FW_SSH_ERR:-/dev/null}"
  elif _fw_is_box; then
    sh -c "$cmd" 2>"${FW_SSH_ERR:-/dev/null}"
  else
    ssh "$(_fw_box_host)" "$cmd" 2>"${FW_SSH_ERR:-/dev/null}"
  fi
}
_fw_abs_path() {
  local path="$1"
  case "$path" in
    /*) printf '%s' "$path" ;;
    *) printf '%s/%s' "$PWD" "$path" ;;
  esac
}

# Read `claude agents --json` on stdin; print live lane names (fiber-*,
# busy/idle). Exits 1 when stdin is not parseable JSON (fail closed).
_fw_lane_names_json() {
  python3 -c 'import json,sys
try:
  data = json.load(sys.stdin)
except Exception:
  sys.exit(1)
if not isinstance(data, list):
  sys.exit(1)
out = []
for a in data:
  try:
    n = a.get("name", "")
    s = a.get("status", "")
  except Exception:
    continue
  if n.startswith("fiber-") and s in ("busy", "idle"):
    out.append(n)
print(" ".join(out))' 2>/dev/null
}

# Prints Mac lane names; exit 1 when the command fails or output is unparseable.
# Stderr of the claude command goes to ${FW_CLAUDE_ERR:-/dev/null}.
fw_lane_names_mac() {
  _fw_out=$("${FW_CLAUDE:-claude}" agents --json 2>"${FW_CLAUDE_ERR:-/dev/null}") || return 1
  printf '%s' "$_fw_out" | _fw_lane_names_json || return 1
  return 0
}

# One box round trip gathering every box fact, cached in FW_BOX_*.
# Runs locally when already on the box.
# FW_BOX_RC holds the command's exit code; FW_BOX_OK is 1 only with intact markers.
# The DELEGATE section prints its marker even when no job directory exists:
# a box that has never run `delegate` has no delegate lanes, as before.
_fw_box_probe() {
  if [ -n "${FW_BOX_PROBED:-}" ]; then return 0; fi
  FW_BOX_PROBED=1
  FW_BOX_OK=0
  FW_BOX_RC=0
  FW_BOX_RAW=""
  _fw_raw=$(_fw_box_exec 'printf "\\nFWSEC=UPTIME\\n"; uptime; printf "\\nFWSEC=FREE\\n"; free -g; printf "\\nFWSEC=DF\\n"; df -BG /; printf "\\nFWSEC=AGENTS\\n"; if bash -o pipefail -c "claude agents --json | cat"; then :; else _fw_rc=$?; printf "\\nFWSEC=AGENTS_STATUS=%s\\n" "$_fw_rc"; fi; printf "\\nFWSEC=DELEGATE\\n"; (case "${XDG_CACHE_HOME:-}" in /*) r=$XDG_CACHE_HOME;; *) r=$HOME/.cache;; esac; for d in "${DELEGATE_JOBS_DIR:-$r/delegate/jobs}" /tmp/delegate-jobs; do cd "$d" 2>/dev/null || continue; for f in *.json; do [ -f "$f" ] || continue; case "$(head -c 40 "$f")" in *RUNNING*) : ;; *) continue;; esac; p=$(grep -o "\"supervisorPid\":[0-9]*" "$f" | head -1 | tr -dc 0-9); case "$p" in ""|*[!0-9]*) continue;; esac; kill -0 "$p" 2>/dev/null || continue; c=$(grep -o "\"cwd\":\"[^\"]*\"" "$f" | head -1); c=${c#*:\"}; c=${c%\"}; b=${c##*/}; n=${b%%-*}; case "$n" in ""|*[!0-9]*) continue;; esac; echo "fiber-$n"; done; done; echo DELEGATEOK); printf "\\nFWSEC=DSESS\\n"; (bash -o pipefail -c "~/.local/bin/delegate session list --json 2>/dev/null | cat" && echo DSESSJSONOK); printf "\\nFWSEC=PILANES\\n"; (cd ~/work/fiber-worktrees/flywheel/run && for f in fiber-*-pi.pid; do [ -f "$f" ] || continue; p=$(cat "$f" 2>/dev/null); case "$p" in ""|*[!0-9]*) continue;; esac; kill -0 "$p" 2>/dev/null || continue; n=${f#fiber-}; n=${n%-pi.pid}; echo "fiber-$n"; done; echo PILANESOK); printf "\\nFWSEC=END\\n"') || FW_BOX_RC=$?
  case "$_fw_raw" in
    *FWSEC=UPTIME*FWSEC=END*) FW_BOX_OK=1; FW_BOX_RAW="$_fw_raw" ;;
  esac
  return 0
}

_fw_box_section() {
  _fw_box_probe
  if [ "${FW_BOX_OK:-0}" != 1 ]; then return 1; fi
  printf '%s\n' "$FW_BOX_RAW" | awk -v s="FWSEC=$1" '$0 == s {on = 1; next} /^FWSEC=/ {on = 0} on {print}'
  return 0
}

# Prints box lane names; exit 1 when ssh failed or output is unparseable.
fw_box_lane_names() {
  _fw_box_probe
  if [ "${FW_BOX_OK:-0}" != 1 ]; then return 1; fi
  case "$FW_BOX_RAW" in *FWSEC=AGENTS_STATUS=*) return 1;; esac
  _fw_s=$(_fw_box_section AGENTS) || return 1
  [ -n "$_fw_s" ] || return 1
  printf '%s' "$_fw_s" | _fw_lane_names_json || return 1
  return 0
}

# Prints live Mac delegate session-lane names, `fiber-<n>` per live `delegate session`
# the roster maps to a ticket. The Mac's sessions are local, not present in the
# box probe's DSESS section, so probe them directly. Exit 1 when the command
# fails, the roster is missing, or the mapper refuses the JSON (fail closed).
fw_mac_delegate_session_lane_names() {
  _fw_out=$("${FW_DELEGATE:-delegate}" session list --json 2>/dev/null) || return 1
  _fw_roster=$(_fw_run)/roster
  [ -f "$_fw_roster" ] || return 1
  _fw_names=$(printf '%s' "$_fw_out" | python3 -I "$self_dir/fw-sess-lanes" "$_fw_roster") || return 1
  printf '%s' "$_fw_names" | tr '\n' ' '
  return 0
}

# Prints live Mac pi-lane names, `fiber-<n>` per live `fiber-<n>-pi.pid`.
# A pi lane is invisible to `claude agents`, so a fence probe that reads only
# that command loses every pi lane's hold once its grant files age out of the
# six-hour window (2026-10-31: a sweep printed "live lanes:" empty with 14 pi
# lanes running). Exit 1 when the run directory is missing (fail closed).
fw_pi_lane_names_mac() {
  _fw_rd=$(_fw_run)
  [ -d "$_fw_rd" ] || return 1
  case "$-" in *f*) _fw_hadf=1;; *) _fw_hadf=0;; esac
  set +f
  _fw_names=""
  for _fw_f in "$_fw_rd"/fiber-*-pi.pid; do
    [ -f "$_fw_f" ] || continue
    _fw_p=$(cat "$_fw_f" 2>/dev/null)
    case "$_fw_p" in ''|*[!0-9]*) continue;; esac
    kill -0 "$_fw_p" 2>/dev/null || continue
    _fw_n=${_fw_f##*/fiber-}
    _fw_n=${_fw_n%-pi.pid}
    _fw_names="$_fw_names fiber-$_fw_n"
  done
  [ "$_fw_hadf" -eq 1 ] && set -f
  printf '%s' "${_fw_names# }"
  return 0
}

# Prints the ticket number of one live `delegate` registry record, or exits 1.
# The record is one line of JSON whose first key is the top-level status, so
# reading the head is the precise test for it. The ticket number is the leading
# digits of the worktree directory name (`<area>/<ticket>-<slug>`).
_fw_delegate_lane_name() {
  _fw_st=$(head -c 40 "$1" 2>/dev/null) || return 1
  case "$_fw_st" in *'"status":"RUNNING"'*) : ;; *) return 1;; esac
  _fw_p=$(grep -o '"supervisorPid":[0-9]*' "$1" 2>/dev/null | head -1 | tr -dc 0-9)
  case "$_fw_p" in ''|*[!0-9]*) return 1;; esac
  kill -0 "$_fw_p" 2>/dev/null || return 1
  _fw_c=$(grep -o '"cwd":"[^"]*"' "$1" 2>/dev/null | head -1)
  [ -n "$_fw_c" ] || return 1
  _fw_c=${_fw_c#*:\"}
  _fw_c=${_fw_c%\"}
  _fw_b=${_fw_c##*/}
  _fw_t=${_fw_b%%-*}
  case "$_fw_t" in ''|*[!0-9]*) return 1;; esac
  printf '%s' "$_fw_t"
  return 0
}

# Prints live Mac delegate-lane names, `fiber-<n>` per RUNNING registry record
# whose supervisor is alive. A `delegate`-run lane is neither a `claude agents`
# session nor a `fiber-<n>-pi.pid` file, so a probe reading only those two
# loses the lane's hold once its grant files age out of the six-hour window --
# the same defect the pi-lane probe below was added for. Reads delegate's
# writer directory (`DELEGATE_JOBS_DIR` when non-empty, else
# `${XDG_CACHE_HOME:-$HOME/.cache}/delegate/jobs`, as in
# delegate/src/status_record.rs) and the legacy `${TMPDIR:-/tmp}/delegate-jobs`,
# where jobs started before #1374 still run. `FW_DELEGATE_DIR` replaces both
# with one directory. Exit 1 when none of them exists (fail closed). A lane
# found in both is listed twice; the caller deduplicates.
fw_delegate_lane_names_mac() {
  if [ -n "${FW_DELEGATE_DIR:-}" ]; then
    _fw_dds=$FW_DELEGATE_DIR
  else
    case "${XDG_CACHE_HOME:-}" in
      /*) _fw_cr=$XDG_CACHE_HOME ;;
      *) _fw_cr=${HOME:-}/.cache ;;
    esac
    _fw_wd=${DELEGATE_JOBS_DIR:-$_fw_cr/delegate/jobs}
    case "$_fw_wd" in /*) ;; *) _fw_wd=$PWD/$_fw_wd ;; esac
    _fw_dds="$_fw_wd
${TMPDIR:-/tmp}/delegate-jobs"
  fi
  case "$-" in *f*) _fw_hadf=1;; *) _fw_hadf=0;; esac
  set +f
  _fw_names=""
  _fw_any=0
  while IFS= read -r _fw_dd; do
    [ -d "$_fw_dd" ] || continue
    _fw_any=1
    for _fw_f in "$_fw_dd"/*.json; do
      [ -f "$_fw_f" ] || continue
      _fw_n=$(_fw_delegate_lane_name "$_fw_f") || continue
      [ -n "$_fw_n" ] || continue
      _fw_names="$_fw_names fiber-$_fw_n"
    done
  done <<EOF_DDS
$_fw_dds
EOF_DDS
  [ "$_fw_hadf" -eq 1 ] && set -f
  [ "$_fw_any" -eq 1 ] || return 1
  printf '%s' "${_fw_names# }"
  return 0
}

# Prints live box delegate-lane names from the one box probe. Exit 1 when ssh
# failed or the section's end marker is missing (fail closed).
fw_delegate_lane_names_box() {
  _fw_box_probe
  if [ "${FW_BOX_OK:-0}" != 1 ]; then return 1; fi
  _fw_s=$(_fw_box_section DELEGATE) || return 1
  case "$_fw_s" in *DELEGATEOK*) : ;; *) return 1;; esac
  printf '%s' "$_fw_s" | grep '^fiber-' | tr '\n' ' '
  return 0
}

# Prints live muse session-lane names, `fiber-<n>` per live `delegate session`
# the roster maps to a ticket. Exit 1 when ssh failed, the section's end marker
# is missing, or the mapper refused the JSON (fail closed).
#
# Without this a muse lane held nothing: fw_delegate_lane_names_box reads
# the delegate job directories, which hold `delegate run` jobs and not sessions, and a
# session's cwd is the shared checkout so its ticket cannot be read off the
# path. 2026-11-04: a sweep for #3635 printed NO LIVE LANE for #4026 and #4029
# with both lanes running. See bin/fw-sess-lanes.
fw_delegate_session_lane_names() {
  _fw_box_probe
  if [ "${FW_BOX_OK:-0}" != 1 ]; then return 1; fi
  _fw_s=$(_fw_box_section DSESS) || return 1
  # The marker is proof the remote delegate command exited successfully; only
  # a marked response reaches the roster mapper and can trigger a parse retry.
  case "$_fw_s" in *DSESSJSONOK*) : ;; *) return 1;; esac
  _fw_roster=$(_fw_run)/roster
  [ -f "$_fw_roster" ] || return 1
  _fw_parse_dsess() {
    _fw_out=$(printf '%s\n' "$1" | grep -v '^DSESSJSONOK$' | python3 -I "$self_dir/fw-sess-lanes" "$_fw_roster") || return 1
    printf '%s' "$_fw_out"
    return 0
  }
  if _fw_names=$(_fw_parse_dsess "$_fw_s"); then
    printf '%s' "$_fw_names" | tr '\n' ' '
    return 0
  fi
  _fw_attempt=0
  while [ "$_fw_attempt" -lt 2 ]; do
    _fw_attempt=$((_fw_attempt + 1))
    _fw_s=$(_fw_box_exec '~/.local/bin/delegate session list --json 2>/dev/null && echo DSESSJSONOK') || continue
    case "$_fw_s" in *DSESSJSONOK*) : ;; *) continue;; esac
    if _fw_names=$(_fw_parse_dsess "$_fw_s"); then
      printf '%s' "$_fw_names" | tr '\n' ' '
      return 0
    fi
  done
  return 1
}

# Prints live box pi-lane names from the one box probe. Exit 1 when ssh failed
# or the section's end marker is missing (fail closed).
fw_pi_lane_names_box() {
  _fw_box_probe
  if [ "${FW_BOX_OK:-0}" != 1 ]; then return 1; fi
  _fw_s=$(_fw_box_section PILANES) || return 1
  case "$_fw_s" in *PILANESOK*) : ;; *) return 1;; esac
  printf '%s' "$_fw_s" | grep '^fiber-' | tr '\n' ' '
  return 0
}

# Epoch mtime of a file; empty when unknown. Portable (macOS/Linux stat).
fw_mtime() {
  _fw_m=$(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null) || _fw_m=""
  case "$_fw_m" in *[!0-9]*|'') printf '';; *) printf '%s' "$_fw_m";; esac
  return 0
}

_usage() {
  echo "usage: fence-grant <ticket> --paths <comma list> [--ranges <file:start-end,...>] [--reads <comma list>] [--new <comma list>] [--expect <file:line:symbol,...>] [--repo <owner/name>] [--part <n>] [--ignore-pr <n>] [--ignore-ticket <n>] [--swept-to <comment id>] [--removes <symbol,...>] [--doc-heading <docs/file.md#heading> (review warning, not a grant)] [--pre-plan <path-shape>] [--dry] | --require <ticket> --phase plan|build|ship" >&2
  echo "       non-sweep holds are advisory overlaps; sweep-* file claims remain exclusive" >&2
}

if [ "${1:-}" = --require ]; then
  [ "$#" -eq 4 ] || { _usage; exit 2; }
  ticket="$2"
  phase="$4"
  case "$ticket" in ''|*[!0-9]*) _usage; exit 2;; esac
  [ "$3" = --phase ] || { _usage; exit 2; }
  case "$phase" in plan|build|ship) ;; *) _usage; exit 2;; esac
  if [ -n "${FW_NO_FENCE:-}" ]; then
    printf 'FW_NO_FENCE: %s\n' "$FW_NO_FENCE"
    exit 0
  fi
  run=$(_fw_run)
  run_abs=$(_fw_abs_path "$run")
  set +f
  for grant in "$run"/fiber-"$ticket"*-fence-grant*.md; do
    [ -f "$grant" ] && exit 0
  done
  host=$(hostname) || { echo 'fence-grant: cannot determine host name' >&2; exit 3; }
  echo "fence-grant: issue $ticket needs a fence grant matching $run_abs/fiber-$ticket*-fence-grant*.md on host $host; a grant written on another machine is invisible here; create one or set FW_NO_FENCE=<reason>" >&2
  exit 2
fi

ticket="${1:-}"
case "$ticket" in ''|*[!0-9]*) _usage; exit 2;; esac
shift
paths=""; ranges=""; readpaths=""; newpaths=""; expects=""; ignore=""; ignoreticket=""; sweptto=""; removes=""; docheadings=""; preplan=""; repo="aakshintala/fiber"; part=1; dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --paths) [ $# -ge 2 ] || { _usage; exit 2; }; paths="$2"; shift 2;;
    --paths=*) paths="${1#--paths=}"; shift;;
    --reads) [ $# -ge 2 ] || { _usage; exit 2; }; readpaths="$2"; shift 2;;
    --reads=*) readpaths="${1#--reads=}"; shift;;
    --ranges) [ $# -ge 2 ] || { _usage; exit 2; }; ranges="$2"; shift 2;;
    --ranges=*) ranges="${1#--ranges=}"; shift;;
    --new) [ $# -ge 2 ] || { _usage; exit 2; }; newpaths="$2"; shift 2;;
    --new=*) newpaths="${1#--new=}"; shift;;
    --expect) [ $# -ge 2 ] || { _usage; exit 2; }; expects="$2"; shift 2;;
    --expect=*) expects="${1#--expect=}"; shift;;
    --repo) [ $# -ge 2 ] || { _usage; exit 2; }; repo="$2"; shift 2;;
    --repo=*) repo="${1#--repo=}"; shift;;
    --part) [ $# -ge 2 ] || { _usage; exit 2; }; part="$2"; shift 2;;
    --part=*) part="${1#--part=}"; shift;;
    --ignore-pr) [ $# -ge 2 ] || { _usage; exit 2; }; case "$2" in ''|*[!0-9]*|0*) _usage; exit 2;; esac; ignore="${ignore}${ignore:+ }$2"; shift 2;;
    --ignore-pr=*) _ignored_pr="${1#--ignore-pr=}"; case "$_ignored_pr" in ''|*[!0-9]*|0*) _usage; exit 2;; esac; ignore="${ignore}${ignore:+ }$_ignored_pr"; shift;;
    --ignore-ticket) [ $# -ge 2 ] || { _usage; exit 2; }; case "$2" in ''|*[!0-9]*) _usage; exit 2;; esac; ignoreticket="${ignoreticket}${ignoreticket:+ }$2"; shift 2;;
    --ignore-ticket=*) _ignored_ticket="${1#--ignore-ticket=}"; case "$_ignored_ticket" in ''|*[!0-9]*) _usage; exit 2;; esac; ignoreticket="${ignoreticket}${ignoreticket:+ }$_ignored_ticket"; shift;;
    --swept-to) [ $# -ge 2 ] || { _usage; exit 2; }; sweptto="$2"; shift 2;;
    --swept-to=*) sweptto="${1#--swept-to=}"; shift;;
    --removes) [ $# -ge 2 ] || { _usage; exit 2; }; removes="$2"; shift 2;;
    --removes=*) removes="${1#--removes=}"; shift;;
    --doc-heading) [ $# -ge 2 ] || { _usage; exit 2; }; docheadings="${docheadings}${docheadings:+$'\n'}$2"; shift 2;;
    --pre-plan) [ $# -ge 2 ] || { _usage; exit 2; }; preplan="$2"; shift 2;;
    --pre-plan=*) preplan="${1#--pre-plan=}"; shift;;
    --dry) dry=1; shift;;
    *) _usage; exit 2;;
  esac
done
case "$part" in ''|*[!0-9]*) _usage; exit 2;; esac
part=$((10#$part))
[ "$part" -gt 0 ] || { _usage; exit 2; }
case "$sweptto" in *[!0-9]*) _usage; exit 2;; esac
case "$repo" in
  */*/*) _usage; exit 2;;
  [!/]*/[!/]*) ;;
  *) _usage; exit 2;;
esac
# Siblings resolve from the script's real path: callers such as flywheel's
# bin/fence-grant reach it through a symlink in a directory with no file-claim.
self="$0"
case "$self" in */*) ;; *) self="$(command -v "$self")" ;; esac
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(cd "$(dirname "$self")" && pwd)/$link" ;; esac
done
self_dir="$(cd "$(dirname "$self")" && pwd)"
# shellcheck disable=SC1091
. "$self_dir/lib/pr-diff.sh"
if [ -n "$preplan" ]; then
  prjson=$("${FW_GH:-gh}" pr list -R "$repo" --state open --limit 200 --json number,changedFiles 2>/dev/null) || { echo "ERROR gh pr list"; exit 3; }
  preplan_prs=$(printf '%s' "$prjson" | python3 -I -c 'import json,sys
try:
  data = json.load(sys.stdin)
except Exception:
  sys.exit(1)
if not isinstance(data, list):
  sys.exit(1)
for row in data:
  if not isinstance(row, dict) or not isinstance(row.get("number"), int) or row["number"] < 1:
    sys.exit(1)
  count = row.get("changedFiles", "")
  if count is None:
    count = ""
  if count != "" and (not isinstance(count, int) or count < 0):
    sys.exit(1)
  print("%s\t%s" % (row["number"], count))' 2>/dev/null) || { echo "ERROR gh pr list unreadable"; exit 3; }
  preplan_n=$(printf '%s\n' "$preplan_prs" | grep -c .)
  case "$preplan_n" in ''|*[!0-9]*) echo "ERROR gh pr list count"; exit 3;; esac
  [ "$preplan_n" -lt 200 ] || { echo "ERROR gh pr list truncated at 200"; exit 3; }
  preplan_rows=""
  while IFS=$'\t' read -r _pr _expected; do
    [ -n "$_pr" ] || continue
    _preplan_err=$(mktemp "${TMPDIR:-/tmp}/fence-pr-diff.XXXXXX") || { echo "ERROR cannot make temp file"; exit 3; }
    if _files=$(pr_diff_fetch "${FW_GH:-gh}" "$repo" "$_pr" "$_expected" --name-only 2>"$_preplan_err"); then
      :
    else
      g=$(head -c 200 "$_preplan_err" 2>/dev/null | tr '\n' ' ')
      rm -f "$_preplan_err"
      echo "ERROR gh pr diff $_pr $g"
      exit 3
    fi
    rm -f "$_preplan_err"
    _count=0
    while IFS= read -r _file; do
      [ -n "$_file" ] || continue
      case "$_file" in $preplan) _count=$((_count + 1));; esac
    done <<< "$_files"
    preplan_rows="${preplan_rows}${preplan_rows:+$'\n'}$_count $_pr"
  done <<< "$preplan_prs"
  if [ -n "$preplan_rows" ]; then
    printf '%s\n' "$preplan_rows" | sort -k1,1nr -k2,2n | while read -r _count _pr; do
      printf 'WARN PRE-PLAN PR #%s: %s files under %s\n' "$_pr" "$_count" "$preplan"
    done
  fi
  exit 0
fi
[ -n "$paths" ] || { _usage; exit 2; }
case "$paths" in
  *:[0-9]*) echo "ERROR a line range belongs in --ranges, not --paths: $paths" >&2; exit 2;;
esac

run=$(_fw_run)
# shellcheck disable=SC1091
. "$self_dir/lib/lane-ticket.sh"
. "$self_dir/lib/ticket-state.sh"
file_claim="${FW_FILE_CLAIM:-$self_dir/file-claim}"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/fence-grant.XXXXXX") || { echo "ERROR cannot make temp dir"; exit 3; }
lockdir="$run/.fence-grant.lock"
locked=0
cachetmp=""
trap '[ -z "$cachetmp" ] || rm -f "$cachetmp"; rm -rf "$tmp"; if [ "$locked" -eq 1 ]; then rmdir "$lockdir" 2>/dev/null || true; fi' EXIT
trap 'exit 130' INT TERM

# Brace-expand whole text ({a,b}, nested, empty, spaced and slashed members).
_expand_braces() {
  python3 -c 'import sys
def split_top(s):
  parts = []
  d = 0
  cur = ""
  for ch in s:
    if ch == "{":
      d += 1
      cur += ch
    elif ch == "}":
      d -= 1
      cur += ch
    elif ch == "," and d == 0:
      parts.append(cur)
      cur = ""
    else:
      cur += ch
  parts.append(cur)
  return parts
def ex(s):
  i = s.find("{")
  if i < 0:
    return [s]
  d = 0
  for j in range(i, len(s)):
    if s[j] == "{":
      d += 1
    elif s[j] == "}":
      d -= 1
      if d == 0:
        break
  else:
    return [s]
  return [r for p in split_top(s[i + 1:j]) for r in ex(s[:i] + p.strip() + s[j + 1:])]
sys.stdout.write("\n".join(ex(sys.argv[1])))' "$1" 2>/dev/null
}

# Normalize one path token; prints "dir|base|rs|re" (rs/re empty if none).
_norm_tok() {
  t=$1
  while :; do case "$t" in ./*) t=${t#./};; *) break;; esac; done
  rs=""; re=""
  suff=$(printf '%s' "$t" | sed -n 's/.*:\([0-9][0-9]*\)-\([0-9][0-9]*\)$/\1 \2/p')
  if [ -n "$suff" ]; then
    rs=${suff%% *}; re=${suff#* }
    t=$(printf '%s' "$t" | sed 's/:[0-9][0-9]*-[0-9][0-9]*$//')
  fi
  t=$(printf '%s' "$t" | sed "s/[\`.,;()\"']*$//" | sed "s/^[(\[\"']*//")
  dir=0; base=$t
  case "$t" in
    */\*\*) dir=1; base=${t%/\*\*};;
    */\*) dir=1; base=${t%/\*};;
    */) dir=1; base=${t%/};;
  esac
  if [ "$dir" -eq 0 ]; then
    case "$t" in
      *\**|*\?*|*\[*|*\{*) : ;;
      *)
        seg=${t##*/}
        case "$seg" in *.*) : ;; *) dir=1; base=$t;; esac;;
    esac
  fi
  printf '%s|%s|%s|%s\n' "$dir" "$base" "$rs" "$re"
  return 0
}

_norm_base() {
  _norm_tok "$1" | awk -F'|' '{print $2}'
}

# Overlap of inclusive [s,e] with inclusive [hs,he].
_range_overlap() { [ "$1" -le "$4" ] && [ "$3" -le "$2" ]; }

# Requested --ranges lines for normalized base $1 -> "s e" lines on stdout.
_req_ranges() {
  awk -F'|' -v k="$1" '$1 == k {print $2" "$3}' "$tmp/rspec"
}

# Request (pd,pb) vs entry (ed,eb[,ers-ere]): 0 on conflict.
_conflict() {
  pd=$1; pb=$2; ed=$3; eb=$4; ers=$5; ere=$6
  hit=0
  case "$eb" in *\**|*\?*|*\[*)
    case "$pb" in $eb) hit=1;; esac;;
  esac
  if [ "$hit" -eq 0 ]; then
    case "$pb" in *\**|*\?*|*\[*)
      case "$eb" in $pb) hit=1;; esac;;
    esac
  fi
  if [ "$hit" -eq 0 ]; then
    if [ "$pd" -eq 1 ] && [ "$ed" -eq 1 ]; then
      case "$pb" in "$eb"|"$eb"/*) hit=1;; esac
      case "$eb" in "$pb"/*) hit=1;; esac
    elif [ "$pd" -eq 1 ]; then
      case "$eb" in "$pb"|"$pb"/*) hit=1;; esac
    elif [ "$ed" -eq 1 ]; then
      case "$pb" in "$eb"|"$eb"/*) hit=1;; esac
    else
      [ "$pb" = "$eb" ] && hit=1
    fi
  fi
  [ "$hit" -eq 1 ] || return 1
  # A held range narrows an exact-file hold: no overlapping request, no hold.
  if [ -n "$ers" ] && [ "$pd" -eq 0 ] && [ "$ed" -eq 0 ] && [ "$pb" = "$eb" ]; then
    case "$pb$eb" in *\**|*\?*|*\[*) return 0;; esac
    prr=$(_req_ranges "$pb")
    [ -n "$prr" ] || return 0
    printf '%s\n' "$prr" > "$tmp/qrr"
    while IFS= read -r line; do
      s=${line%% *}; e=${line##* }
      case "$s$e" in *[!0-9]*) continue;; esac
      if _range_overlap "$s" "$e" "$ers" "$ere"; then return 0; fi
    done < "$tmp/qrr"
    return 1
  fi
  return 0
}

# --- requested paths: brace-expand first, then split on commas only ---
_expanded=$(_expand_braces "$paths") || { echo "ERROR brace expansion"; exit 3; }
printf '%s' "$_expanded" | tr ',' '\n' | sed 's/^ *//; s/ *$//' | grep . > "$tmp/plist" || true
[ -s "$tmp/plist" ] || { _usage; exit 2; }

# --- requested ranges: lines "normfile|s|e" ---
: > "$tmp/rspec"
if [ -n "$ranges" ]; then
  _expand_braces "$ranges" > "$tmp/rexp" || { echo "ERROR brace expansion"; exit 3; }
  tr ',' '\n' < "$tmp/rexp" | grep . > "$tmp/ritems" || true
  while IFS= read -r ri; do
    rf=${ri%%:*}; rr=${ri#*:}
    [ -n "$rf" ] && [ "$rr" != "$ri" ] || { _usage; exit 2; }
    rs=${rr%-*}; re=${rr#*-}
    case "$rs" in ''|*[!0-9]*) _usage; exit 2;; esac
    case "$re" in ''|*[!0-9]*) _usage; exit 2;; esac
    [ "$rs" -le "$re" ] || { _usage; exit 2; }
    nrf=$(_norm_base "$rf")
    [ -n "$nrf" ] || { _usage; exit 2; }
    printf '%s|%s|%s\n' "$nrf" "$rs" "$re" >> "$tmp/rspec"
  done < "$tmp/ritems"
fi

# --- the grant can mean what it says (fail closed, before any hold probe) ---
# Normalized requests: "dir|base|raw" lines.
: > "$tmp/pnorm"
while IFS= read -r _pt; do
  [ -n "$_pt" ] || continue
  _nt=$(_norm_tok "$_pt") || { echo "ERROR cannot read path $_pt"; exit 3; }
  _pd=${_nt%%|*}; _rest=${_nt#*|}; _pb=${_rest%%|*}
  [ -n "$_pb" ] || { _usage; exit 2; }
  printf '%s|%s|%s\n' "$_pd" "$_pb" "$_pt" >> "$tmp/pnorm"
done < "$tmp/plist"

# A --ranges entry naming a file the grant does not hold is refused. The field
# is ignored for this grant's own hold test but IS binding when another probe
# reads this grant file, so an unheld range silently creates a hold on a path
# the grant never claimed (seen 2026-10-31: a GLOSSARY.md grant whose stray
# range made crates/extensions/src read as held).
if [ -s "$tmp/rspec" ]; then
  while IFS='|' read -r _rf _rs _re; do
    [ -n "$_rf" ] || continue
    _cov=0
    while IFS='|' read -r _pd _pb _praw; do
      [ -n "$_pb" ] || continue
      case "$_rf" in
        "$_pb") _cov=1; break;;
        "$_pb"/*) _cov=1; break;;
      esac
    done < "$tmp/pnorm"
    [ "$_cov" -eq 1 ] || { echo "ERROR --ranges names $_rf which is not under --paths"; exit 2; }
  done < "$tmp/rspec"
fi

# Paths the grant declares new, which are absent from main on purpose.
: > "$tmp/newnorm"
if [ -n "$newpaths" ]; then
  _expand_braces "$newpaths" > "$tmp/nexp" || { echo "ERROR brace expansion"; exit 3; }
  tr ',' '\n' < "$tmp/nexp" | sed 's/^ *//; s/ *$//' | grep . > "$tmp/nitems" || true
  while IFS= read -r _ni; do
    _nb=$(_norm_base "$_ni") || { echo "ERROR cannot read new path $_ni"; exit 3; }
    [ -n "$_nb" ] || { _usage; exit 2; }
    printf '%s\n' "$_nb" >> "$tmp/newnorm"
  done < "$tmp/nitems"
fi

# Cache the validated path list by immutable tree SHA, never by moving main.
treesha=$("${FW_GH:-gh}" api "repos/$repo/commits/main" --jq .commit.tree.sha 2>"$tmp/treeerr") || { g=$(head -c 200 "$tmp/treeerr" 2>/dev/null | tr '\n' ' '); echo "ERROR gh tree SHA main $g"; exit 3; }
case "$treesha" in ''|*[!0-9a-fA-F]*) echo "ERROR tree SHA of main unreadable"; exit 3;; esac
