[ "${FW_BOX_OK:-0}" = 1 ] || { echo "ERROR ssh box exit $FW_BOX_RC: ${boxerr:-no stderr; output lacks the FWSEC markers}"; exit 3; }
[ "$box_ok" -eq 1 ] || { echo "ERROR box claude agents: unparseable output ${boxerr}"; exit 3; }
