#!/usr/bin/env bash
# model-catalog-diff: compare vendor model lists with models.dev.
# Usage: model-catalog-diff run
#        model-catalog-diff install [--print] [--at HH:MM]
# MODEL_CATALOG_INBOX defaults to the surveyor box inbox.
set -euo pipefail

usage() {
  echo "usage: model-catalog-diff run" >&2
  echo "       model-catalog-diff install [--print] [--at HH:MM]" >&2
  exit 2
}

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  script_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$script_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
script_path="$script_dir/$(basename "$script_path")"
helper="$script_dir/lib/model-catalog-diff.py"

render_units() {
  local at="$1" exec_path="$2" quoted_path
  quoted_path="${exec_path//\\/\\\\}"
  quoted_path="${quoted_path//\"/\\\"}"
  quoted_path="${quoted_path//%/%%}"
  service_unit="$(cat <<UNIT
[Unit]
Description=Daily vendor model catalog diff

[Service]
Type=oneshot
ExecStart="$quoted_path" run
TimeoutStartSec=1h
UNIT
)"
  timer_unit="$(cat <<UNIT
[Unit]
Description=Daily vendor model catalog diff timer

[Timer]
OnCalendar=*-*-* $at:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
UNIT
)"
}

print_install() {
  local at="$1" unit_dir="$2" exec_path="$3" service_unit timer_unit
  render_units "$at" "$exec_path"
  printf '# %s/model-catalog-diff.service\n' "$unit_dir"
  printf '%s\n' "$service_unit"
  printf '\n# %s/model-catalog-diff.timer\n' "$unit_dir"
  printf '%s\n' "$timer_unit"
  printf '\n# Commands (not run):\n'
  printf 'mkdir -p %q\n' "$unit_dir"
  echo 'systemctl --user daemon-reload'
  echo 'systemctl --user enable --now model-catalog-diff.timer'
  echo 'loginctl show-user "${USER}" -p Linger'
}

install_daily() {
  local print_only=0 at=08:30 unit_dir config_home user linger service_unit timer_unit
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --print) print_only=1; shift ;;
      --at)
        [ "$#" -ge 2 ] || usage
        at="$2"
        shift 2
        ;;
      *) usage ;;
    esac
  done
  [[ "$at" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || usage
  config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
  unit_dir="$config_home/systemd/user"
  if [ "$print_only" -eq 1 ]; then
    print_install "$at" "$unit_dir" "$script_path"
    return 0
  fi

  mkdir -p "$unit_dir"
  render_units "$at" "$script_path"
  printf '%s\n' "$service_unit" >"$unit_dir/model-catalog-diff.service"
  printf '%s\n' "$timer_unit" >"$unit_dir/model-catalog-diff.timer"
  systemctl --user daemon-reload
  systemctl --user enable --now model-catalog-diff.timer
  user="${USER:-$(id -un)}"
  if linger="$(loginctl show-user "$user" -p Linger 2>/dev/null)" && [ "$linger" = "Linger=yes" ]; then
    :
  else
    echo "model-catalog-diff: warning: user lingering is not enabled; the timer may not run while logged out" >&2
  fi
}

[ "$#" -ge 1 ] || usage
command_name="$1"
shift
case "$command_name" in
  run)
    [ "$#" -eq 0 ] || usage
    python3 -I "$helper" run "$script_path"
    ;;
  install) install_daily "$@" ;;
  *) usage ;;
esac
