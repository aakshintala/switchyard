#!/usr/bin/env bash
# tkt-job: fill a brief, run one delegated job, wait for it and digest its record.
# The ticket-orchestrator job engine (orch-tools-spec section 5, C2): probe the
# shared lock, drift-check state head against the worktree, reuse a stored job
# id, fill the brief from flags then state, write the gate script, dispatch
# through delegate, watch with no timeout, follow supersededBy through shared
# job-walk.sh, and print one verdict line plus a digest of at most 40 lines. A
# dispatched job gets one JSON line per id in jobs.log beside the state file;
# gated dispatches journal the base64-encoded inner command and ticket env as
# cmd64=<base64> env64=<base64> for gate verification.
# Reruns recover a missing jobs.log line without duplicating an existing entry.
# A verifier-r* slot's wall cap travels on the run call (--wall-ms); watch
# only reads the record.
# Every state read and write goes through tkt-state; the model comes from
# --model or state model.<slot> and is never picked here. Rulings come from
# state ruling.<slot> and reach delegate run/resume only as --model-ruling.
# A --resume passes --model to delegate resume only when given (delegate refuses
# a backend switch); without it, the resumed job keeps its stored model.
# Usage: tkt-job <state> --slot <name> (--template <path> [KEY=VALUE...] |
#   --brief <file> | --resume <job id> --prompt <file>) [--model <id>]
#   [--gate-from-plan | --gate '<cmd>'] [--expect-commits] [--out-file <path>]
# Every gate built from the plan first absorbs untracked root run/ files.
# Tools: TKT_BIN holds fill-brief and plan-gate (default ~/.agents/bin) and delegate
# when set; without TKT_BIN, delegate comes from PATH. tkt-state still sits next to
# the script. TKT_IDLE_MS sets the --idle-ms every delegate run gets (default
# 1800000; a resume keeps the stored value). No --timeout ever reaches delegate
# watch: the driver's wait owns the bound.
set -euo pipefail

usage() {
  echo "usage: tkt-job <state> --slot <name> (--template <path> [KEY=VALUE...] | --brief <file> | --resume <job id> --prompt <file>) [--model <id>] [--gate-from-plan | --gate '<cmd>'] [--expect-commits] [--out-file <path>]" >&2
  echo "If a slot has a prompt hash, a different supplied prompt replaces it only when the stored job has finished; otherwise it refuses." >&2
  echo "With --resume, --model is passed to delegate resume; without it the resumed job keeps its stored model." >&2
  exit 2
}

[ $# -ge 1 ] || usage
state="$1"
shift

slot=""
template=""
brief=""
resume=""
prompt=""
model=""
gate=""
inner_gate_cmd=""
inner_gate_cmd64=""
inner_gate_env64=""
inherited_gate=0
gate_from_plan=0
expect_commits=0
out_file=""
fills=()
while [ $# -gt 0 ]; do
  case "$1" in
    --slot) [ $# -ge 2 ] || usage; slot="$2"; shift 2 ;;
    --template) [ $# -ge 2 ] || usage; template="$2"; shift 2 ;;
    --brief) [ $# -ge 2 ] || usage; brief="$2"; shift 2 ;;
    --resume) [ $# -ge 2 ] || usage; resume="$2"; shift 2 ;;
    --prompt) [ $# -ge 2 ] || usage; prompt="$2"; shift 2 ;;
    --model) [ $# -ge 2 ] || usage; model="$2"; shift 2 ;;
    --gate) [ $# -ge 2 ] || usage; gate="$2"; shift 2 ;;
    --gate-from-plan) gate_from_plan=1; shift ;;
    --expect-commits) expect_commits=1; shift ;;
    --out-file) [ $# -ge 2 ] || usage; out_file="$2"; shift 2 ;;
    --help|-h) usage ;;
    -* ) usage ;;
    *=*) fills+=("$1"); shift ;;
    *) usage ;;
  esac
done
inner_gate_cmd="$gate"
[ -n "$slot" ] || usage
case "$slot" in
  fix[0-9]*)
    if [ "${TKT_FIX_DISPATCH:-}" != "1" ]; then
      printf 'tkt-job: dispatch fix slots through: tkt-fix %s (--verify|--no-verify) --findings <file>; resume a fix job with: tkt-fix %s (--verify|--no-verify) --resume <job id> --prompt <file>\n' "$state" "$state" >&2
      printf "Clear an existing orphan with: tkt-state %s set job.%s ''; tkt-state %s set job.%s.prompt ''\n" "$state" "$slot" "$state" "$slot" >&2
      exit 2
    fi
    ;;
esac
fix_dispatch=0
[ "${TKT_FIX_DISPATCH:-}" != "1" ] || fix_dispatch=1
unset TKT_FIX_DISPATCH
# A prompt file only resumes; a resume needs its prompt and takes no fresh
# brief. A resume may carry a gate; the two gate sources never combine.
{ [ -z "$prompt" ] || [ -n "$resume" ]; } || usage
{ [ -z "$resume" ] || [ -n "$prompt" ]; } || usage
{ [ -z "$resume" ] || { [ -z "$template" ] && [ -z "$brief" ]; }; } || usage
{ [ "$gate_from_plan" -eq 0 ] || [ -z "$gate" ]; } || usage

script_path="$0"
case "$script_path" in */*) ;; *) script_path="$(command -v "$script_path")" ;; esac
while [ -L "$script_path" ]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd)"
  link="$(readlink "$script_path")"
  case "$link" in /*) script_path="$link" ;; *) script_path="$link_dir/$link" ;; esac
done
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
# shellcheck disable=SC1090
. "$script_dir/lib/job-refusal.sh"
tkt_refuse_inside_delegate tkt-job
tkt_state="$script_dir/tkt-state"
gate_lib="$script_dir/lib/gate-script.sh"
if [ ! -r "$gate_lib" ]; then
  echo "tkt-job: cannot read shared lib: $gate_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$gate_lib"
job_walk_lib="$script_dir/lib/job-walk.sh"
if [ ! -r "$job_walk_lib" ]; then echo "tkt-job: cannot read shared lib: $job_walk_lib" >&2; exit 2; fi
. "$job_walk_lib"
namebase_lib="$script_dir/lib/namebase.sh"
if [ ! -r "$namebase_lib" ]; then
  echo "tkt-job: cannot read shared lib: $namebase_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$namebase_lib"
plan_gate_lib="$script_dir/lib/plan-gate-args.sh"
plan_tokens_lib="$script_dir/lib/plan-tokens.sh"
if [ ! -r "$plan_tokens_lib" ]; then echo "tkt-job: cannot read shared lib: $plan_tokens_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$plan_tokens_lib"
if [ ! -r "$plan_gate_lib" ]; then
  echo "tkt-job: cannot read shared lib: $plan_gate_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$plan_gate_lib"
lane_ticket_lib="$script_dir/lib/lane-ticket.sh"
if [ ! -r "$lane_ticket_lib" ]; then
  echo "tkt-job: cannot read shared lib: $lane_ticket_lib" >&2
  exit 2
fi
# shellcheck disable=SC1090
. "$lane_ticket_lib"
fw_lib="$script_dir/lib/fw-lib.sh"
if [ ! -r "$fw_lib" ]; then echo "tkt-job: cannot read shared lib: $fw_lib" >&2; exit 2; fi
. "$fw_lib"
stop_report_lib="$script_dir/lib/stop-report.sh"
if [ ! -r "$stop_report_lib" ]; then echo "tkt-job: cannot read shared lib: $stop_report_lib" >&2; exit 2; fi
# shellcheck disable=SC1090
. "$stop_report_lib"
bin_dir="${TKT_BIN:-$HOME/.agents/bin}"
if [ -n "${TKT_BIN:-}" ]; then delegate="$TKT_BIN/delegate"; else delegate=delegate; fi
fillbrief="$bin_dir/fill-brief"
plangate="$bin_dir/plan-gate"
# TKT_IDLE_MS overrides the 30 min --idle-ms every delegate run gets; set but empty is refused.
idle_ms=1800000
if [ -n "${TKT_IDLE_MS+x}" ]; then
  bad=0
  case "$TKT_IDLE_MS" in ''|*[!0-9]*) bad=1 ;; esac
  case "$TKT_IDLE_MS" in *[1-9]*) ;; *) bad=1 ;; esac
  if [ "$bad" -eq 1 ]; then
    echo "tkt-job: TKT_IDLE_MS must be a positive integer of milliseconds, got '$TKT_IDLE_MS'" >&2
    exit 2
  fi
  idle_ms="$TKT_IDLE_MS"
fi

# rec_of ID: print the winning job-record path, or nothing; it never fails,
# so a missing record reads as "no record" under set -e.
rec_of() {
  bash "$script_dir/job-record" "$1" 2>/dev/null || true
}

tkt() {
  "$tkt_state" "$state" "$@"
}

validate_gate_journal_command() {
  case "$inner_gate_cmd" in
    *$'\n'*)
      echo "tkt-job: gate command must be one line to journal it" >&2
      exit 2
      ;;
  esac
}

journal_gate_command() {
  [ -n "$inner_gate_cmd" ] || return 0
  local cmd64 env64 env_value
  if [ "$inherited_gate" -eq 1 ]; then
    cmd64="$inner_gate_cmd64"
    env64="$inner_gate_env64"
  else
    cmd64="$(printf '%s' "$inner_gate_cmd" | jq -Rrs '@base64')" || return 0
    env_value="$(tkt get env 2>/dev/null || true)"
    env64="$(printf '%s' "$env_value" | jq -Rrs '@base64')" || return 0
  fi
  tkt journal "tkt-job gate slot=$slot job=$jobid cmd64=$cmd64 env64=$env64"
}

# Probe the shared lock and release it at once: the delegate wait below
# outlives any lock, and tkt-state locks each write itself.
lockdir="$state.lock"
require_state_file tkt-job "$state"
take_state_lock tkt-job "$lockdir"
rmdir "$lockdir"

tkt require repo issue run worktree
repo="$(tkt get repo)"
issue="$(tkt get issue)"
set_namebase "$repo" "$issue"
run="$(tkt get run)"
grant_run=$(ticket_states_shared_run_dir "$run")
worktree="$(tkt get worktree)"
mkdir -p "$run"

# Writing slots need a non-empty fence. If a planning phase left only an empty
# Paths block, refresh from the posted plan now; if the plan still has no writes,
# keep that grant instead of appending another empty part. --require remains the
# final check, with FW_NO_FENCE as the explicit override.
phase=plan
case "$slot" in
  lane|fix[0-9]*)
    phase=build
    if ! fw_has_nonempty_grant "$issue" "$run" && [ -z "${FW_NO_FENCE:-}" ]; then
      fw_self_grant tkt-job "$issue" "$run" 1 build || {
        echo "tkt-job: could not self-grant a fence for #$issue" >&2
        exit 2
      }
    fi
    FW_RUN="$grant_run" "$bin_dir/fence-grant" --require "$issue" --phase "$phase" >&2
    ;;
esac
# Guard output goes to stderr: tkt-job's stdout is the job's output.
if [ -n "${TKT_LAUNCH_GUARD:-}" ]; then
  "$TKT_LAUNCH_GUARD" "$issue" "$phase" >&2
fi

# Descendant commits can be the previous turn's work, including a BLOCKED
# lane's commits. Only a head outside that history stops the run.
if stored_head="$(tkt get head 2>/dev/null)"; then
  actual="$(git -C "$worktree" rev-parse HEAD 2>/dev/null)" || {
    echo "tkt-job: cannot read worktree HEAD: $worktree" >&2
    exit 2
  }
  if [ "$stored_head" != "$actual" ] \
    && ! git -C "$worktree" merge-base --is-ancestor "$stored_head" "$actual" 2>/dev/null; then
    echo "tkt-job: head drift: state $state head=$stored_head worktree $worktree HEAD=$actual" >&2
    exit 3
  fi
fi

# The plan's Files section as a fence list: one path per line, bullets and
# backticks stripped, notes kept as brief prose.
fence_from_plan() {
  awk 'BEGIN{in_f=0} /^## Files([[:space:]]|$)/{in_f=1;next} in_f&&/^## /{exit} in_f{print}' "$1" \
    | sed -e 's/^[[:space:]]*[-*][[:space:]]*//' -e 's/`//g' \
    -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' \
    | grep -v '^$' || true
}

# build_gate_from_plan: set gate to 'bash <script>' from the plan Gate section.
# The gate comes from the plan and is never invented: a missing plan or a
# gateless plan names the key and the setter on one line.
build_gate_from_plan() {
  gate_cmd=""
  plan="$(tkt get plan 2>/dev/null || true)"
  if [ -z "$plan" ]; then
    echo "tkt-job: missing key: plan (the gate comes from the plan Gate section); set it with: tkt-plan $state set <plan file>" >&2
    exit 2
  fi
  plan_gate_args tkt
  gate_cmd="$("$plangate" ${plan_gate_argv[@]+"${plan_gate_argv[@]}"} "$plan" 2>&1)" || {
    echo "tkt-job: missing gate: no Gate command in plan $plan (key: plan); set it with: tkt-plan $state set <plan file>: $gate_cmd" >&2
    exit 2
  }
  inner_gate_cmd="$gate_cmd"
  case "$state" in
    /*) state_for_gate="$state" ;;
    *) state_for_gate="$PWD/$state" ;;
  esac
  case "$run" in
    /*) run_for_gate="$run" ;;
    *) run_for_gate="$PWD/$run" ;;
  esac
  printf -v stray_run_command 'bash %q %q %q' \
    "$script_dir/lib/tkt-stray-run.sh" "$state_for_gate" "$run_for_gate"
  # The journal keeps the bare plan Gate: gate-credit and tkt-gate --from-job
  # compare it with the plan. Only the script runs the stray-run step first.
  gate_cmd="$stray_run_command && $inner_gate_cmd"
  validate_gate_journal_command
  # The gate script keeps the whole chain inside the redirected block and is
  # judged by its exit code, never the log line (see bin/lib/gate-script.sh).
  env_prefix=""
  if e="$(tkt get env 2>/dev/null)" && [ -n "$e" ]; then
    env_prefix="$e "
  fi
  # One unique stem per call: two lanes of a ticket never share a script or log.
  stem="$(mktemp "$run/$namebase-$slot-gate-XXXXXX")"
  script="$stem.sh"
  mv "$stem" "$script"
  write_gate_script "$script" "$stem.log" "$env_prefix" "$gate_cmd" "tkt-job: delegate runs it as the job-end gate"
  gate="bash $script"
}

# Recheck a failed collected fix gate with tkt-gate when the job head is already
# pushed. An unpushed head is deferred to tkt-fix, which pushes it before running
# the same remote-tip gate. The independent job/worktree safety checks remain here.
retry_failed_fix_gate() {
  local record_file="$1" head_after current_head dirty commits retry_branch remote_head record_cwd record_worktree worktree_real
  retry_gate_attempted=0
  retry_gate_deferred=0
  retry_gate_reason=""
  retry_gate_rc=0
  retry_gate_log=""
  retry_gate_output=""

  record_cwd="$(jq -r '.resume.cwd // ""' "$record_file" 2>/dev/null || true)"
  record_worktree="$(cd "$record_cwd" 2>/dev/null && pwd -P)" || {
    retry_gate_reason="cannot resolve the finished job worktree"; return 1;
  }
  worktree_real="$(cd "$worktree" 2>/dev/null && pwd -P)" || {
    retry_gate_reason="cannot resolve the state worktree"; return 1;
  }
  [ "$record_worktree" = "$worktree_real" ] || {
    retry_gate_reason="finished job worktree does not match the state worktree"; return 1;
  }
  head_after="$(jq -r '.result.changeSet.headAfter // ""' "$record_file" 2>/dev/null || true)"
  current_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || true)"
  [ -n "$head_after" ] && [ "$head_after" = "$current_head" ] || {
    retry_gate_reason="worktree HEAD does not match the finished job head"; return 1;
  }
  dirty="$(git -C "$worktree" status --porcelain --untracked-files=all 2>/dev/null || printf '?')"
  [ -z "$dirty" ] || {
    retry_gate_reason="worktree is not clean at the finished job head"; return 1;
  }
  commits="$(jq -r '.result.changeSet.newCommits // [] | length' "$record_file" 2>/dev/null || printf '0')"
  [ "$commits" -gt 0 ] || {
    retry_gate_reason="finished job has no recorded commits"; return 1;
  }

  retry_branch="$(tkt get branch 2>/dev/null || true)"
  remote_head=""
  [ -z "$retry_branch" ] || remote_head="$(git -C "$worktree" rev-parse --verify "origin/$retry_branch" 2>/dev/null || true)"
  if [ "$remote_head" != "$head_after" ]; then
    retry_gate_deferred=1
    retry_gate_reason="finished job head is not the fetched origin branch tip"
    return 0
  fi

  retry_gate_output="$(mktemp "$run/$namebase-$slot-gate-retry-XXXXXX.out")" || {
    retry_gate_reason="cannot allocate a tkt-gate retry output"; return 1;
  }
  retry_gate_attempted=1
  "$bin_dir/tkt-gate" "$state" --expect-head "$head_after" >"$retry_gate_output" 2>&1 || retry_gate_rc=$?
  retry_gate_log="$(sed -n '1s/.* log=//p' "$retry_gate_output")"
  [ -n "$retry_gate_log" ] || retry_gate_log="$retry_gate_output"
  return 0
}

# Prepare the current prompt only when a dispatch needs it (or when comparing a
# supplied prompt with a stored job). Stored ids without prompt metadata retain
# the legacy watch-only path without needing a brief.
prepare_brief() {
  { [ -n "$template" ] || [ -n "$brief" ]; } || usage
  { [ -z "$template" ] || [ -z "$brief" ]; } || usage
  if [ -n "$template" ]; then
    [ -r "$template" ] || {
      echo "tkt-job: cannot read template: $template" >&2
      exit 2
    }
    keys="$(grep -oE '__[A-Z][A-Z0-9_]*__' "$template" | sort -u | sed -e 's/^__//' -e 's/__$//' || true)"
    args=()
    missing=""
    for k in $keys; do
      v=""
      found=0
      if [ "$k" = "CLAIM_HOLDER" ]; then
        v="$(claim_holder "$issue")"
        args+=("$k=$v")
        continue
      fi
      for f in ${fills[@]+"${fills[@]}"}; do
        if [ "${f%%=*}" = "$k" ]; then
          v="${f#*=}"
          found=1
          break
        fi
      done
      # Flags win; FENCE falls back to the plan's Files, EXTRA to empty, the rest to state.
      # EXTRA names a file, so the state value travels with an @ prefix.
      if [ "$found" -eq 0 ] && [ "$k" = "FENCE" ]; then
        if plan="$(tkt get plan 2>/dev/null)" && [ -r "$plan" ]; then
          derived="$(fence_from_plan "$plan")"
          if [ -n "$derived" ]; then
            v="$derived"
            found=1
          fi
        fi
      fi
      if [ "$found" -eq 0 ] && [ "$k" = "EXTRA" ]; then
        if e="$(tkt get extra 2>/dev/null)"; then
          case "$e" in
            @*) v="$e" ;;
            *) v="@$e" ;;
          esac
          found=1
        else
          v=""
          found=1
        fi
      fi
      if [ "$found" -eq 0 ]; then
        lower="$(printf '%s' "$k" | tr 'A-Z' 'a-z')"
        if sv="$(tkt get "$lower" 2>/dev/null)"; then
          v="$sv"
          found=1
        fi
      fi
      if [ "$found" -eq 0 ]; then
        if [ -z "$missing" ]; then missing="$k"; else missing="$missing, $k"; fi
        continue
      fi
      args+=("$k=$v")
    done
    if [ -n "$missing" ]; then
      echo "tkt-job: template needs $missing: no flag and no state value" >&2
      exit 2
    fi
    # Only keys the template names reach fill-brief; stray flags stay out.
    k=1
    while [ -e "$run/$namebase-$slot-$k.md" ]; do
      k=$((k + 1))
    done
    brief="$run/$namebase-$slot-$k.md"
    "$fillbrief" --out "$brief" "$template" ${args[@]+"${args[@]}"} >&2
  else
    [ -r "$brief" ] || {
      echo "tkt-job: cannot read brief: $brief" >&2
      exit 2
    }
  fi
}

# Defence in depth: `delegate run` sets both DELEGATE_JOB_ID and
# DELEGATE_JOB_CHAIN (delegate/src/cli.rs), so the refusal at the top of this
# script fires first. This chain check catches a caller that sets only the chain.
job_chain_contains() {
  local target="$1" candidate
  [ -n "$target" ] || return 1
  local -a chain_ids=()
  IFS=$' \t\n' read -r -a chain_ids <<<"${DELEGATE_JOB_CHAIN:-}"
  for candidate in "${chain_ids[@]+"${chain_ids[@]}"}"; do
    [ "$candidate" = "$target" ] && return 0
  done
  return 1
}

resume_hint() {
  local id="$1"
  case "$slot" in
    fix[0-9]*) printf 'tkt-fix %s (--verify|--no-verify) --resume %s --prompt <file>' "$state" "$id" ;;
    *) printf 'tkt-job %s --slot %s --resume %s --prompt <file>' "$state" "$slot" "$id" ;;
  esac
}

stored="$(tkt get "job.$slot" 2>/dev/null || true)"
# A slot cleared to whitespace (a retyped or ssh-quoted '') holds no job.
case "$stored" in *[![:space:]]*) ;; *) stored="" ;; esac
if [ -n "$resume" ] && job_chain_contains "$resume"; then
  echo "tkt-job: refusing to resume $resume: it is the job this process runs inside (DELEGATE_JOB_ID/DELEGATE_JOB_CHAIN); report to your orchestrator instead" >&2
  exit 2
fi
if [ -z "$resume" ] && [ -n "$stored" ] && job_chain_contains "$stored"; then
  echo "tkt-job: refusing to watch $stored: it is the job this process runs inside (DELEGATE_JOB_ID/DELEGATE_JOB_CHAIN); report to your orchestrator instead" >&2
  exit 2
fi
stored_prompt_hash=""
brief_prepared=0
if [ -n "$stored" ] && [ -z "$resume" ]; then
  stored_prompt_hash="$(tkt get "job.$slot.prompt" 2>/dev/null || true)"
  if [ -n "$stored_prompt_hash" ] && { [ -n "$template" ] || [ -n "$brief" ]; }; then
    prepare_brief
    brief_prepared=1
    prompt_hash="$(shasum -a 256 <"$brief" | awk '{print $1}')"
    if [ "$prompt_hash" != "$stored_prompt_hash" ]; then
      stored_record="$(rec_of "$stored")"
      newest_record=""
      chain_broken=0
      if [ -n "$stored_record" ] && [ -r "$stored_record" ]; then
        replaced_chain="$(job_walk_superseded "$stored")" || chain_broken=1
        if [ "$chain_broken" -eq 0 ]; then
          while IFS=$'\t' read -r chain_id chain_record; do
            [ -n "$chain_id" ] || continue
            newest_record="$chain_record"
          done <<<"$replaced_chain"
        fi
      else
        chain_broken=1
      fi
      changed_status=""
      if [ "$chain_broken" -eq 0 ] && [ -n "$newest_record" ] && [ -r "$newest_record" ]; then
        changed_status="$(jq -er 'if type == "object" then .status | select(type == "string") else empty end' "$newest_record" 2>/dev/null || true)"
      fi
      case "$changed_status" in
        DONE|DONE_WITH_CONCERNS|BLOCKED|NEEDS_CONTEXT|ERROR|STALLED|CANCELLED)
          tkt journal "tkt-job slot $slot replaced job=$stored prompt=$stored_prompt_hash: finished job, prompt changed"
          tkt set "job.$slot" ""
          tkt set "job.$slot.prompt" ""
          stored=""
          stored_prompt_hash=""
          ;;
        *)
          echo "ERROR slot $slot holds job $stored from a different prompt; clear it (tkt-state $state set job.$slot '') or use a new slot" >&2
          exit 2
          ;;
      esac
    fi
  fi
fi
fresh=0
reused=0
jobid=""

if [ -n "$resume" ]; then
  [ -r "$prompt" ] || {
    echo "tkt-job: cannot read prompt: $prompt" >&2
    exit 2
  }
  if [ "$gate_from_plan" -eq 1 ]; then
    build_gate_from_plan
  fi
  if [ -z "$inner_gate_cmd" ]; then
    inherited_line="$(grep -F "tkt-job gate " "${state%.state}.journal" 2>/dev/null | grep -F "job=$resume " | tail -n 1 || true)"
    inherited_payload="${inherited_line#* tkt-job gate }"
    case "$inherited_payload" in
      *" cmd64="*" env64="*)
        inherited_rest="${inherited_payload#* cmd64=}"
        inner_gate_cmd64="${inherited_rest%% env64=*}"
        inner_gate_env64="${inherited_rest#* env64=}"
        inner_gate_cmd="$(printf '%s' "$inner_gate_cmd64" | jq -Rrs '@base64d' 2>/dev/null)" || inner_gate_cmd=""
        if [ -n "$inner_gate_cmd" ]; then inherited_gate=1; fi
        ;;
    esac
  fi
  validate_gate_journal_command
  gate_args=()
  if [ -n "$gate" ]; then gate_args=(--gate "$gate"); fi
  # No --model keeps the stored model; delegate itself refuses a backend switch.
  model_args=()
  if [ -n "$model" ]; then model_args=(--model "$model"); fi
  model_ruling="$(tkt get "ruling.$slot" 2>/dev/null || true)"
  model_ruling_args=()
  if [ -n "$model_ruling" ]; then model_ruling_args=(--model-ruling "$model_ruling"); fi
  prompt_hash="$(shasum -a 256 <"$prompt" | awk '{print $1}')"
  jobid="$("$delegate" resume "$resume" --prompt-file "$prompt" ${model_args[@]+"${model_args[@]}"} ${model_ruling_args[@]+"${model_ruling_args[@]}"} ${gate_args[@]+"${gate_args[@]}"} | head -n 1)"
  tkt set "job.$slot" "$jobid"
  # A resume continues the slot's job, so it keeps the slot's prompt identity:
  # the brief the slot was dispatched from still matches on the next call.
  # Only a legacy slot with no stored hash takes the resume prompt's.
  if [ -z "$(tkt get "job.$slot.prompt" 2>/dev/null || true)" ]; then
    tkt set "job.$slot.prompt" "$prompt_hash"
  fi
  tkt journal "tkt-job dispatch slot=$slot id=$jobid resume=$resume"
  journal_gate_command
  fresh=1
elif [ -n "$stored" ]; then
  # A stored id never dispatches again: a matching or legacy prompt only watches.
  jobid="$stored"
  reused=1
else
  # The gate comes from the plan before any brief is filled, so a missing
  # plan or gateless plan reports in one line without a brief on disk.
  if [ "$gate_from_plan" -eq 1 ]; then
    build_gate_from_plan
  fi
  validate_gate_journal_command
  if [ "$brief_prepared" -eq 0 ]; then
    prepare_brief
  fi
  prompt_hash="$(shasum -a 256 <"$brief" | awk '{print $1}')"
  if [ -z "$model" ]; then
    model="$(tkt get "model.$slot" 2>/dev/null)" || {
      echo "tkt-job: missing key: model.$slot (no --model and no state model.$slot)" >&2
      exit 2
    }
  fi
  # The tool-idle window bounds one silent tool call and the job-end gate, on every model: a full
  # gate on a loaded box can run past 30 min, so every job gets 2 h. For muse it is also the
  # whole-run wall cap. --idle-ms (30 min, or TKT_IDLE_MS) bounds a silent model stream between
  # tool calls on every model; delegate leaves it off while the phase is running_tool, and muse
  # reports no running_tool phase, so there it also bounds a silent bash call.
  tool_idle=(--tool-idle-ms 7200000 --idle-ms "$idle_ms")
  # Only a Verifier gets a wall cap: a lane legitimately runs for hours.
  wall=()
  case "$slot" in verifier-r*) wall=(--wall-ms 10800000) ;; esac
  gate_args=()
  if [ -n "$gate" ]; then gate_args=(--gate "$gate"); fi
  model_ruling="$(tkt get "ruling.$slot" 2>/dev/null || true)"
  model_ruling_args=()
  if [ -n "$model_ruling" ]; then model_ruling_args=(--model-ruling "$model_ruling"); fi
  jobid="$("$delegate" run --model "$model" --cwd "$worktree" ${gate_args[@]+"${gate_args[@]}"} ${tool_idle[@]+"${tool_idle[@]}"} ${wall[@]+"${wall[@]}"} ${model_ruling_args[@]+"${model_ruling_args[@]}"} --prompt-file "$brief" | head -n 1)"
  tkt set "job.$slot" "$jobid"
  tkt set "job.$slot.prompt" "$prompt_hash"
  tkt journal "tkt-job dispatch slot=$slot id=$jobid"
  journal_gate_command
  fresh=1
fi

watch_rc=0
"$delegate" watch "$jobid" >&2 || watch_rc=$?
if [ "$watch_rc" -ne 0 ]; then
  echo "tkt-job: delegate watch failed (exit $watch_rc); checking the job record" >&2
fi
record="$(rec_of "$jobid")"

# Keep one jobs.log line per job id. If watch failed or a rerun finds a missing
# entry, write it from the record when available, otherwise preserve the id.
jobs_log="$(dirname "$state")/jobs.log"
if [ ! -f "$jobs_log" ] || ! jq -e -s --arg jobId "$jobid" 'any(.[]; .jobId == $jobId)' "$jobs_log" >/dev/null 2>&1; then
  log_entry=""
  if [ -n "$record" ] && [ -f "$record" ]; then
    log_entry="$(jq -c --arg phase "$phase" --arg jobId "$jobid" '
      {phase: $phase, jobId: $jobId,
       startedAtMs: (.startedAtMs // null), endedAtMs: (.endedAtMs // null),
       usage: (if .result.usage == null then "none" else .result.usage end),
       costUsd: (if .result.costUsd == null then "none" else .result.costUsd end)}' \
      "$record" 2>/dev/null || true)"
  fi
  if [ -z "$log_entry" ]; then
    log_entry="$(jq -cn --arg phase "$phase" --arg jobId "$jobid" \
      '{phase: $phase, jobId: $jobId, startedAtMs: null, endedAtMs: null, usage: "none", costUsd: "none"}')"
  fi
  printf '%s\n' "$log_entry" >>"$jobs_log"
fi

# Follow supersededBy to the newest record; a loop is unrecognised, not a hang.
# Each link resolves through the lookup, so a chain may span directories.
broken=0
chain="$(job_walk_superseded "$jobid")" || broken=1
if [ -n "$chain" ]; then
  while IFS=$'\t' read -r chain_id chain_record; do
    [ -n "$chain_id" ] || continue
    jobid="$chain_id"
    record="$chain_record"
  done <<<"$chain"
fi

verdict=""
digest="id=$jobid"
ec=0
retry_gate_attempted=0
retry_gate_deferred=0
retry_gate_rc=0
retry_gate_log=""
retry_gate_output=""
if [ "$broken" -eq 1 ] || [ ! -f "$record" ]; then
  verdict="UNKNOWN id=$jobid"
  ec=3
else
  status="$(jq -r '.result.status // .status // ""' "$record" 2>/dev/null || true)"
  text="$(jq -j -r '.result.text // ""' "$record" 2>/dev/null || true)"
  gate_exit="$(jq -r '.result.gateResult | if . == null then "none" elif .exitCode != null then (.exitCode | tostring) elif .passed == true then "0" else "1" end' "$record" 2>/dev/null || true)"
  gate_refused="$(jq -r '.result.gateResult.refused == true' "$record" 2>/dev/null || true)"
  [ -n "$gate_exit" ] || gate_exit="none"
  gate_path="$(jq -r '.result.gateResult.outputPath // ""' "$record" 2>/dev/null || true)"
  gate_tail="$(jq -r '.result.gateResult.outputTail // ""' "$record" 2>/dev/null || true)"
  ncommits="$(jq -r '.result.changeSet.newCommits // [] | length' "$record" 2>/dev/null || true)"
  [ -n "$ncommits" ] || ncommits=0
  nuncomm="$(jq -r '.result.changeSet.uncommittedFiles // [] | length' "$record" 2>/dev/null || true)"
  [ -n "$nuncomm" ] || nuncomm=0
  head_after="$(jq -r '.result.changeSet.headAfter // ""' "$record" 2>/dev/null || true)"
  concerns="$(jq -j -r 'if .result.concerns == null then "" elif (.result.concerns | type) == "array" then ((.result.concerns | map(tostring)) | join("\n")) else (.result.concerns | tostring) end' "$record" 2>/dev/null || true)"
  gate_word="none"
  [ "$gate_exit" = "none" ] || gate_word="PASS"
  gate_failed=0
  if [ "$gate_refused" = "true" ]; then
    gate_word="REFUSED"
  elif [ "$gate_exit" != "none" ] && [ "$gate_exit" != "0" ]; then
    gate_failed=1
    gate_word="FAIL"
  fi
  retry_gate_attempted=0
  if [ "$fix_dispatch" -eq 1 ] && [ "$expect_commits" -eq 1 ] && [ "$reused" -eq 1 ] \
    && [[ "$slot" =~ ^fix[1-9][0-9]*$ ]] && [ "$gate_failed" -eq 1 ] \
    && [ "$gate_refused" != "true" ]; then
    case "$status" in
      DONE|DONE_WITH_CONCERNS)
        if retry_failed_fix_gate "$record"; then
          if [ "$retry_gate_deferred" -eq 0 ]; then
            gate_exit="$retry_gate_rc"
            gate_path="$retry_gate_log"
            if [ -r "$retry_gate_output" ]; then
              gate_tail="$(tail -n 20 "$retry_gate_output")"
            fi
            if [ "$retry_gate_rc" -eq 0 ]; then
              gate_word="PASS"
              gate_failed=0
            else
              gate_word="FAIL"
              gate_failed=1
            fi
          fi
        else
          echo "tkt-job: failed fix gate was not rerun: $retry_gate_reason" >&2
        fi
        ;;
    esac
  fi
  case "$status" in
    NEEDS_CONTEXT) verdict="ASK id=$jobid"; ec=1 ;;
    BLOCKED) verdict="BLOCKED id=$jobid"; ec=1 ;;
    ERROR|STALLED|CANCELLED)
      # A wall-budget expiry is a CANCELLED whose text starts with the wall
      # wording; any other CANCELLED (a user cancel, a later mention) is a
      # plain job error.
      case "$status:$text" in
        "CANCELLED:Cancelled: wall budget of "*)
          verdict="WALL-CAP id=$jobid"; ec=1 ;;
        *) verdict="JOB-ERROR status=$status id=$jobid"; ec=1 ;;
      esac
      ;;
    DONE|DONE_WITH_CONCERNS)
      # A lane DONE supersedes its concerns even when a gate or commit check
      # below stops the job. Concerns for other slots belong to other steps.
      if [ "$status" = "DONE" ] && [ "$slot" = lane ]; then
        tkt set concerns.lane ""
      fi
      if [ "$retry_gate_deferred" -eq 1 ]; then
        verdict="GATE-RETRY-PENDING id=$jobid"
        ec=1
        if [ "$status" = "DONE_WITH_CONCERNS" ]; then
          concerns_file="$run/$namebase-concerns-$slot.md"
          if [ -n "$concerns" ]; then concern_text="$concerns"; else concern_text="$text"; fi
          printf '%s\n' "$concern_text" >"$concerns_file"
          tkt set "concerns.$slot" "$concerns_file"
        fi
      # A refused or failed gate script rules over the status word.
      elif [ "$gate_refused" = "true" ]; then
        verdict="GATE-REFUSED rc=$gate_exit gatelog=${gate_path:--}"
        ec=1
      elif [ "$gate_failed" -eq 1 ]; then
        verdict="GATE-FAIL rc=$gate_exit gatelog=${gate_path:--}"
        ec=1
      elif [ "$status" = "DONE_WITH_CONCERNS" ]; then
        verdict="CONCERNS id=$jobid"
        concerns_file="$run/$namebase-concerns-$slot.md"
        if [ -n "$concerns" ]; then concern_text="$concerns"; else concern_text="$text"; fi
        printf '%s\n' "$concern_text" >"$concerns_file"
        tkt set "concerns.$slot" "$concerns_file"
        ec=1
      elif [ "$expect_commits" -eq 1 ] && [ "$ncommits" -eq 0 ]; then
        verdict="NO-COMMITS id=$jobid gate=$gate_word"
        ec=1
      else
        verdict="DONE id=$jobid head=$head_after commits=$ncommits gate=$gate_word"
        ec=0
      fi
      ;;
    *) verdict="UNKNOWN id=$jobid status=${status:-?}"; ec=3 ;;
  esac

  # The report goes through jq straight to the file, so it keeps the record's
  # exact bytes; the shell variable below cannot hold trailing newlines.
  if [ -n "$out_file" ]; then
    jq -j -r '.result.text // ""' "$record" >"$out_file"
    if [ -n "$text" ]; then
      first="${text%%$'\n'*}"
      verdict="$verdict report=$first"
    fi
  fi

  # Headers, then the gate tail, concerns, and the newest text lines: the
  # digest never passes 40 lines, so the verdict stays decidable in one read.
  # ERROR and STALLED name the winning record path after the id, so lane
  # briefs never hard-code where the record lives.
  digest="status=$status
id=$jobid
commits=$ncommits uncommitted=$nuncomm"
  case "$status" in
    ERROR|STALLED)
      digest="status=$status
id=$jobid record=$record
commits=$ncommits uncommitted=$nuncomm" ;;
  esac
  if [ "$ncommits" -gt 0 ]; then
    shas="$(jq -r '[.result.changeSet.newCommits[]? | tostring] | join(" ")' "$record" 2>/dev/null || true)"
    digest="$digest
newCommits: $shas"
  fi
  if [ "$nuncomm" -gt 0 ]; then
    dirty="$(jq -r '[.result.changeSet.uncommittedFiles[]? | tostring] | join(" ")' "$record" 2>/dev/null || true)"
    digest="$digest
uncommittedFiles: $dirty"
  fi
  if [ "$gate_exit" != "none" ]; then
    if [ "$gate_refused" = "true" ]; then
      digest="$digest
gate=refused (nothing tested) exit=$gate_exit log=${gate_path:- -}"
    else
      digest="$digest
gate=exit=$gate_exit log=${gate_path:- -}"
    fi
    if [ -n "$gate_tail" ]; then
      digest="$digest
$(tail -n 10 <<<"$gate_tail")"
    fi
  fi
  if [ "$retry_gate_deferred" -eq 1 ]; then
    digest="$digest
gateRetry=pending reason=$retry_gate_reason"
  elif [ "$retry_gate_attempted" -eq 1 ]; then
    # A STOP-LIST red is not the lane's round; tkt-fix counts only exit=<n>.
    case "$(head -n 1 "$retry_gate_output" 2>/dev/null)" in
      "TKT tkt-gate STOP-LIST "*) retry_gate_word=stop-list ;;
      *) retry_gate_word="exit=$retry_gate_rc" ;;
    esac
    digest="$digest
gateRetry=$retry_gate_word log=$retry_gate_log"
  fi
  if [ -n "$concerns" ]; then
    digest="$digest
$concerns"
  fi
  # A dead run with a session can be resumed; the caller decides whether to.
  case "$status" in
    ERROR|STALLED)
      resume_sid="$(jq -r '.resume.sessionId // ""' "$record" 2>/dev/null || true)"
      if [ -n "$resume_sid" ]; then
        hint_route="$(resume_hint "$jobid")"
        digest="$digest
session=$resume_sid
hint: this job ended $status with a resumable session; its text is below. Continue it with: $hint_route; start a fresh job only when the session is not worth keeping."
      fi
      ;;
  esac
  if [ -n "$text" ]; then
    used="$(printf '%s\n' "$digest" | wc -l | tr -d ' ')"
    take=$((40 - used))
    [ "$take" -gt 25 ] && take=25
    [ "$take" -lt 0 ] && take=0
    if [ "$take" -gt 0 ]; then
      digest="$digest
$(tail -n "$take" <<<"$text")"
    fi
  fi
fi

twelve="$(git -C "$worktree" rev-parse --short=12 HEAD 2>/dev/null || printf 'nohead')"
if [ "$reused" -eq 1 ]; then
  verdict="$verdict reused=$jobid"
  current_head="$(git -C "$worktree" rev-parse HEAD 2>/dev/null || printf 'nohead')"
  if [ -n "${head_after:-}" ] && [ "$head_after" != "$current_head" ]; then
    verdict="$verdict stale-head=$head_after now=$twelve"
  fi
  case "$verdict" in
    ASK*) digest="hint: this job asked and has finished; a rerun only re-watches it. Answer with: $(resume_hint "$jobid")
$digest" ;;
    *)
      if [ "$ec" -ne 0 ]; then
        if [ "$slot" = lane ]; then
          plan_for_hint="$(tkt get plan 2>/dev/null || true)"
          hint_base=""
          [ -z "$plan_for_hint" ] || hint_base="$(plan_base "$plan_for_hint" 2>/dev/null || true)"
        else
          hint_base=""
        fi
        push_only=0
        case "$verdict" in
          "NO-COMMITS "*" gate=PASS"*) [ "$slot" = lane ] && push_only=1 ;;
        esac
        if [ "$push_only" -eq 1 ] && plan_has_commits_beyond_base "$worktree" "${hint_base:-}"; then
          digest="hint: this job has finished; a rerun only re-watches it. This verdict is about ${head_after:-unknown}, you are on $twelve; resume the push step with: tkt-job $state --slot $slot --resume $jobid --prompt <file> --gate-from-plan ($(plan_push_only_hint)); journal the reason and continue.
$digest"
        else
          digest="hint: this job has finished; a rerun only re-watches it. This verdict is about ${head_after:-unknown}, you are on $twelve; clear the slot with: tkt-state $state set job.$slot ''; journal the reason and re-dispatch.
$digest"
        fi
      fi
      ;;
  esac
fi

logpath="$run/$namebase-tkt-job-$twelve-$(date +%H%M%S).log"
output="TKT tkt-job $verdict log=$logpath
$digest"
printf '%s\n' "$output" >"$logpath"
printf '%s\n' "$output"
if [ "$fresh" -eq 1 ]; then
  tkt journal "tkt-job $verdict"
  stop_status="${verdict%% *}"
  if stop_report_is_stop "$stop_status"; then
    if [ -n "$out_file" ] && [ -s "$out_file" ]; then
      stop_report_notify "$state" "$issue" tkt-job "$jobid" "$stop_status" <"$out_file"
    else
      stop_report_notify "$state" "$issue" tkt-job "$jobid" "$stop_status" <<<"$digest"
    fi
  fi
fi
exit "$ec"
