#!/usr/bin/env bash
# Manual plan-sweep benchmark. Can use the default synthetic fixture or a real
# repository/plan with --repo DIR --base REV --plan FILE.
set -euo pipefail

script_dir="$(cd "$(dirname "$0")/../.." && pwd)"
sweep="$script_dir/bin/plan-sweep"
repo_arg=""
base_arg=""
plan_arg=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo) [ "$#" -ge 2 ] || { echo "usage: $0 [--repo DIR --base REV --plan FILE]" >&2; exit 2; }; repo_arg="$2"; shift 2 ;;
    --base) [ "$#" -ge 2 ] || { echo "usage: $0 [--repo DIR --base REV --plan FILE]" >&2; exit 2; }; base_arg="$2"; shift 2 ;;
    --plan) [ "$#" -ge 2 ] || { echo "usage: $0 [--repo DIR --base REV --plan FILE]" >&2; exit 2; }; plan_arg="$2"; shift 2 ;;
    -h|--help) echo "usage: $0 [--repo DIR --base REV --plan FILE]"; exit 0 ;;
    *) echo "usage: $0 [--repo DIR --base REV --plan FILE]" >&2; exit 2 ;;
  esac
done

work="$(mktemp -d "${TMPDIR:-/tmp}/bench-plan-sweep.XXXXXX")"
trap 'rm -rf "$work"' EXIT

if [ -n "$repo_arg$base_arg$plan_arg" ]; then
  [ -n "$repo_arg" ] && [ -n "$base_arg" ] && [ -n "$plan_arg" ] || { echo "bench-plan-sweep: --repo, --base, and --plan must be supplied together" >&2; exit 2; }
  repo="$repo_arg"
  base="$base_arg"
  plan="$plan_arg"
  expected="${BENCH_SYMBOLS:-40}"
  [ -d "$repo" ] && [ -r "$plan" ] || { echo "bench-plan-sweep: repository or plan is not readable" >&2; exit 2; }
else
  lines="${BENCH_LINES:-2000}"
  case "$lines" in ''|*[!0-9]*) echo "bench-plan-sweep: BENCH_LINES must be a positive integer" >&2; exit 2 ;; esac
  [ "$lines" -gt 0 ] || { echo "bench-plan-sweep: BENCH_LINES must be a positive integer" >&2; exit 2; }
  repo="$work/repo"
  mkdir -p "$repo/src"
  git -C "$repo" init -q
  (cd "$repo" && awk -v lines="$lines" '
    BEGIN {
      for (i = 1; i <= 40; i++) {
        names[i] = sprintf("bench_symbol_%02d", i)
        printf "pub fn %s() {}\n", names[i] >> "src/lib.rs"
      }
      for (row = 1; row <= lines; row++) {
        for (i = 1; i <= 40; i++) printf "%s(); ", names[i] >> "src/calls.rs"
        printf "\n" >> "src/calls.rs"
      }
    }')
  git -C "$repo" add src/lib.rs src/calls.rs
  git -C "$repo" -c user.name=benchmark -c user.email=benchmark@example.com commit -q -m fixture
  base="$(git -C "$repo" rev-parse HEAD)"
  plan="$work/plan.md"
  {
    printf '# plan-sweep benchmark\nBase: %s\n\n## Files\n- `src/lib.rs`\n- `src/calls.rs`\n\n## Interfaces\n' "$base"
    i=1
    while [ "$i" -le 40 ]; do
      printf 'Uses `bench_symbol_%02d`.\n' "$i"
      i=$((i + 1))
    done
  } >"$plan"
  expected=40
fi

# This is the exact plan-sweep invocation used by tkt-plan's do_set: it avoids
# faking tkt-plan state while exercising its complete expensive operation.
TIMEFORMAT='%3R'
{ time "$sweep" --cwd "$repo" --base "$base" --plan "$plan" --out "$work/pack.md" >"$work/stdout" 2>"$work/stderr"; } 2>"$work/elapsed"
elapsed="$(cat "$work/elapsed")"
actual="$(grep -c '^## Symbol ' "$work/pack.md")"
printf 'plan-sweep (tkt-plan set invocation): %s s; expected_symbols=%s actual_symbols=%s repo=%s\n' "$elapsed" "$expected" "$actual" "$repo"
[ "$actual" -eq "$expected" ] || { echo "bench-plan-sweep: expected $expected Symbol sections, got $actual" >&2; exit 1; }
if awk -v elapsed="$elapsed" 'BEGIN { exit !(elapsed < 30) }'; then
  echo 'PASS: under 30 s'
else
  echo 'FAIL: 30 s limit exceeded' >&2
  exit 1
fi
