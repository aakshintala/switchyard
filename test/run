#!/usr/bin/env bash
# test/run: run every test file in this directory.
# Usage: test/run [--self-test-parallel-failure|--self-test-serial-failure]; internal: test/run --run-parallel <paths...>
set -uo pipefail

# Keep the local gate on the same Bash major version as CI. Prefer the
# Homebrew installation on macOS, then search PATH for any Bash 5 executable.
# The override and re-exec marker keep this discovery testable and loop-safe.
_test_run_bash5_is_valid() {
  # shellcheck disable=SC2016
  [ -x "$1" ] && "$1" -c 'test "${BASH_VERSINFO[0]}" -ge 5' >/dev/null 2>&1
}

if [ "${BASH_VERSINFO[0]}" -lt 5 ]; then
  _test_run_bash5=""
  if [ "${SWITCHYARD_TEST_RUN_BASH5_REEXEC:-0}" != 1 ]; then
    _test_run_homebrew_bash="${TEST_RUN_HOMEBREW_BASH-/opt/homebrew/bin/bash}"
    if [ -n "$_test_run_homebrew_bash" ] && _test_run_bash5_is_valid "$_test_run_homebrew_bash"; then
      _test_run_bash5="$_test_run_homebrew_bash"
    fi
    if [ -z "$_test_run_bash5" ]; then
      _test_run_search_path="${PATH:-}:"
      while [ -n "$_test_run_search_path" ]; do
        _test_run_dir="${_test_run_search_path%%:*}"
        _test_run_search_path="${_test_run_search_path#*:}"
        [ -n "$_test_run_dir" ] || _test_run_dir=.
        _test_run_candidate="$_test_run_dir/bash"
        if _test_run_bash5_is_valid "$_test_run_candidate"; then
          _test_run_bash5="$_test_run_candidate"
          break
        fi
      done
    fi
    if [ -n "$_test_run_bash5" ]; then
      case "$_test_run_bash5" in
        */*) _test_run_bash5_dir="${_test_run_bash5%/*}" ;;
        *) _test_run_bash5_dir=. ;;
      esac
      [ -n "$_test_run_bash5_dir" ] || _test_run_bash5_dir=/
      PATH="$_test_run_bash5_dir${PATH:+:$PATH}"
      export PATH
      SWITCHYARD_TEST_RUN_BASH5_REEXEC=1
      export SWITCHYARD_TEST_RUN_BASH5_REEXEC
      exec "$_test_run_bash5" "$0" "$@"
    fi
  fi
  printf 'test/run: Bash 5 unavailable; continuing with Bash %s\n' "$BASH_VERSION" >&2
fi
# The marker guards only this process's re-exec; a nested test/run (as in
# bash5-runner.sh) must do its own discovery.
unset SWITCHYARD_TEST_RUN_BASH5_REEXEC

# CLAUDECODE must not change gh-ci wait timeouts under test: suites that need
# it set it per case, so start unset however the gate is invoked.
unset CLAUDECODE

D="$(cd "$(dirname "$0")" && pwd)"

# --- parallel helper: run suites at most 3 at once from one pool (xargs -P),
# so a slot frees as soon as any suite ends rather than when its batch of
# three does. Each suite's output, exit code and wall seconds go to files
# under $PAR_T (a temp dir created with mktemp -d); once all have ended,
# each log is printed without interleaving in allowlist order. Put the
# longest suites first. Any failure sets failed=1.
run_parallel() {
  # shellcheck disable=SC2016
  printf '%s\n' "$@" | xargs -P 3 -I{} bash -c '
    _b="$(basename "$1")"; _s=$SECONDS
    bash "$1" >"$2/$_b.log" 2>&1; _r=$?
    echo $((SECONDS - _s)) >"$2/$_b.secs"; echo "$_r" >"$2/$_b.rc"' _ {} "$PAR_T"
  for _t in "$@"; do
    _name="$(basename "$_t")"
    cat "$PAR_T/$_name.log" 2>/dev/null
    _rc="$(cat "$PAR_T/$_name.rc" 2>/dev/null || echo 'none')"
    _secs="$(cat "$PAR_T/$_name.secs" 2>/dev/null || echo '?')"
    if [ "$_rc" = "0" ]; then
      echo "PASS: $_name (${_secs}s)"
    else
      echo "FAIL: $_name (exit $_rc, ${_secs}s)" >&2
      failed=1
    fi
  done
}

# --- serial helper: run every suite with the same exit-code reporting, including
# the single cargo-slot suite. Any failure sets failed=1.
run_serial() {
  for t in "$@"; do
    _s=$SECONDS
    bash "$t"; _rc=$?
    if [ "$_rc" = "0" ]; then
      echo "PASS: $(basename "$t") ($((SECONDS - _s))s)"
    else
      echo "FAIL: $(basename "$t") (exit $_rc, $((SECONDS - _s))s)" >&2
      failed=1
    fi
  done
}

# --- controlled internal mode: run the given paths through run_parallel
# with the same final failure exit logic. The temp output dir is cleaned
# by its own scoped trap. Used by deterministic_parallel_failure_case so
# the proof asserts the actual test/run process exit code.
if [ "${1:-}" = "--run-parallel" ]; then
  shift
  RP_T="$(mktemp -d "${TMPDIR:-/tmp}/test-run-parallel-inner.XXXXXX")"
  trap 'rm -rf "$RP_T"' EXIT
  PAR_T="$RP_T"
  failed=0
  run_parallel "$@"
  [ "$failed" = "0" ] || exit 1
  echo "all suites passed"
  exit 0
fi

# --- deterministic parallel-failure proof (embedded: no new files). Uses
# controlled stubs (not real suites): runs them through run_parallel,
# asserts the inner run exits 1 and shows the stub failure output plus the
# failing suite name. The case itself exits 0 on success. Temp dirs are
# cleaned by traps scoped to this subshell.
deterministic_parallel_failure_case() (
  ST="$(mktemp -d "${TMPDIR:-/tmp}/test-run-deterministic.XXXXXX")"
  trap 'rm -rf "$ST"' EXIT
  printf '#!/usr/bin/env bash\necho "deterministic stub pass"\nexit 0\n' >"$ST/deterministic-stub-pass.sh"
  printf '#!/usr/bin/env bash\necho "UNIQUE-FAIL-MARKER-936 parallel failure output"\nexit 1\n' >"$ST/deterministic-stub-fail.sh"
  chmod +x "$ST"/deterministic-stub-pass.sh "$ST"/deterministic-stub-fail.sh
  out="$ST/combined.log"
  bash "$0" --run-parallel "$ST/deterministic-stub-pass.sh" "$ST/deterministic-stub-fail.sh" >"$out" 2>&1
  rc=$?
  [ "$rc" -eq 1 ] || return 1
  grep -q "UNIQUE-FAIL-MARKER-936" "$out" || return 1
  grep -q "deterministic-stub-fail.sh" "$out" || return 1
  grep -h "UNIQUE-FAIL-MARKER-936\|FAIL: deterministic-stub-fail.sh" "$out"
  return 0
)

deterministic_serial_failure_case() (
  ST="$(mktemp -d "${TMPDIR:-/tmp}/test-run-serial-deterministic.XXXXXX")"
  trap 'rm -rf "$ST"' EXIT
  printf '#!/usr/bin/env bash\necho "deterministic serial failure output"\nexit 3\n' >"$ST/deterministic-serial-fail.sh"
  chmod +x "$ST/deterministic-serial-fail.sh"
  out="$ST/combined.log"
  failed=0
  run_serial "$ST/deterministic-serial-fail.sh" >"$out" 2>&1
  [ "$failed" -eq 1 ] || return 1
  grep -q 'FAIL: deterministic-serial-fail.sh (exit 3,' "$out" || return 1
  cat "$out"
  return 0
)

if [ "${1:-}" = "--self-test-serial-failure" ]; then
  if deterministic_serial_failure_case; then
    echo "PASS: deterministic-serial-failure (${SECONDS}s)"
    exit 0
  else
    echo "FAIL: deterministic-serial-failure (${SECONDS}s)" >&2
    exit 1
  fi
fi

if [ "${1:-}" = "--self-test-parallel-failure" ]; then
  if deterministic_parallel_failure_case; then
    echo "PASS: deterministic-parallel-failure (${SECONDS}s)"
    exit 0
  else
    echo "FAIL: deterministic-parallel-failure (${SECONDS}s)" >&2
    exit 1
  fi
fi

failed=0
run_serial "$D"/agents-ff.sh "$D"/binbox-move.sh "$D"/boxlaunch-reuse.sh "$D"/boxstale.sh "$D"/fw-lib-move.sh "$D"/fw-selftest-stale.sh "$D"/lanecheck-pi.sh "$D"/claude-agents-timeout.sh "$D"/lanecheck.sh "$D"/lanecheck-wake.sh "$D"/tkt-drive.sh
run_serial "$D"/tkt-state.sh "$D"/job-record.sh "$D"/fill-brief.sh "$D"/check-pack.sh "$D"/pr-closes.sh "$D"/agent-cost.sh "$D"/post-plan.sh "$D"/plan-gate.sh "$D"/plan-check.sh "$D"/delegate-replay.sh "$D"/inbox.sh "$D"/inbox-watchers.sh "$D"/role-inbox.sh "$D"/roles-restart.sh "$D"/wired-check.sh "$D"/lanewatch.sh "$D"/post-ruling.sh "$D"/mutant-verdicts.sh "$D"/tkt-verdicts.sh "$D"/bin-modes.sh "$D"/ctx-hook.sh "$D"/gh-label-guard.sh "$D"/merge-audit.sh "$D"/target-reap.sh "$D"/canary-daily.sh "$D"/bash5-runner.sh "$D"/quota.sh "$D"/red-main.sh "$D"/brief-lint.sh "$D"/flake-loop.sh
# Allowlist (exactly these 18 isolated suites run in parallel, at most 3),
# longest first by the 2026-11-07 profile: ship-pr.sh, tkt-build.sh,
# tkt-start.sh, tkt-plan.sh, tkt-fix.sh, file-claim.sh, review-pr.sh,
# fence-grant.sh, tkt-job.sh, delegate-canary.sh, tkt-gate.sh, gh-ci.sh,
# tkt-ship.sh, lanestat.sh, plan-sweep.sh, ci-friction.sh,
# git-hook-guard.sh, ci-health.sh.
PAR_T="$(mktemp -d "${TMPDIR:-/tmp}/test-run-parallel.XXXXXX")"
trap 'rm -rf "$PAR_T"' EXIT
run_parallel "$D"/ship-pr.sh "$D"/tkt-build.sh "$D"/tkt-start.sh "$D"/tkt-plan.sh \
  "$D"/tkt-fix.sh "$D"/file-claim.sh "$D"/review-pr.sh "$D"/fence-grant.sh \
  "$D"/tkt-job.sh "$D"/delegate-canary.sh "$D"/tkt-gate.sh "$D"/gh-ci.sh \
  "$D"/tkt-ship.sh "$D"/lanestat.sh "$D"/plan-sweep.sh "$D"/ci-friction.sh \
  "$D"/git-hook-guard.sh "$D"/ci-health.sh
run_serial "$D"/cargo-slot.sh
_s=$SECONDS
if deterministic_parallel_failure_case; then
  echo "PASS: deterministic-parallel-failure ($((SECONDS - _s))s)"
else
  echo "FAIL: deterministic-parallel-failure (expected parallel failure not proven, $((SECONDS - _s))s)" >&2
  failed=1
fi
_s=$SECONDS
if deterministic_serial_failure_case; then
  echo "PASS: deterministic-serial-failure ($((SECONDS - _s))s)"
else
  echo "FAIL: deterministic-serial-failure (expected serial failure not proven, $((SECONDS - _s))s)" >&2
  failed=1
fi
echo "test/run wall time: ${SECONDS}s"
[ "$failed" = "0" ] || exit 1
echo "all suites passed"
