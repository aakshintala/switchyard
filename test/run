#!/usr/bin/env bash
# test/run: run every test file in this directory.
# Usage: test/run
set -uo pipefail
# CLAUDECODE must not change gh-ci wait timeouts under test: suites that need
# it set it per case, so start unset however the gate is invoked.
unset CLAUDECODE

D="$(cd "$(dirname "$0")" && pwd)"
failed=0
for t in "$D"/tkt-state.sh "$D"/tkt-job.sh "$D"/job-record.sh "$D"/tkt-plan.sh "$D"/tkt-gate.sh "$D"/fill-brief.sh "$D"/review-pr.sh "$D"/check-pack.sh "$D"/pr-closes.sh "$D"/gh-ci.sh "$D"/ci-health.sh "$D"/ci-friction.sh "$D"/ship-pr.sh "$D"/agent-cost.sh "$D"/post-plan.sh "$D"/plan-gate.sh "$D"/plan-check.sh "$D"/plan-sweep.sh "$D"/delegate-replay.sh "$D"/delegate-canary.sh "$D"/inbox.sh "$D"/post-ruling.sh "$D"/tkt-ship.sh "$D"/tkt-start.sh "$D"/tkt-fix.sh "$D"/tkt-build.sh "$D"/file-claim.sh "$D"/mutant-verdicts.sh "$D"/bin-modes.sh "$D"/ctx-hook.sh; do
  if bash "$t"; then
    echo "PASS: $(basename "$t")"
  else
    echo "FAIL: $(basename "$t") (exit $?)" >&2
    failed=1
  fi
done
if bash "$D"/cargo-slot.sh; then
  echo "PASS: cargo-slot.sh"
else
  echo "FAIL: cargo-slot.sh (exit $?)" >&2
  failed=1
fi
[ "$failed" = "0" ] || exit 1
echo "all suites passed"
